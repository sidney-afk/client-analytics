# Keep source files LF on Windows. Some unit tests string-extract snippets and
# expect LF line endings, especially from index.html.
index.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.toml text eol=lf
# YAML too. Without these, a Windows checkout with core.autocrlf=true
# materializes .github/workflows/*.yml as CRLF while `git status` stays clean.
# test/ef-deploy-provenance.js and test/f42-card-comment-apply.js read those
# workflow files with LF-literal regexes, so they report seven false failures
# that look exactly like a real regression -- which is what happened during the
# PR #992 review on 2026-07-29 and cost a round trip to attribute.
*.yml text eol=lf
*.yaml text eol=lf

# This authenticated row contract is hashed as exact bytes across checkouts.
docs/independence/LINEAR_EXIT_PRIORITY_ROW_SCHEMA_20260910.json text eol=lf

# Exact-byte observed catalog contract for the isolated PG17 baseline.
docs/independence/LINEAR_EXIT_BACKUP_TABLE_BASELINE_20260911.json text eol=lf

# Exact-byte credential row contract for the isolated companion.
docs/independence/LINEAR_EXIT_CREDENTIAL_ROW_SCHEMA_20260911.json text eol=lf
