
# Linear reconcile runtime ledger (persisted via Actions cache in CI)
.sync-ledger/

# Node / Playwright (CI installs these; never commit them)
node_modules/
# Also match a bare `node_modules` entry, not just a directory. A trailing slash
# ignores directories ONLY, so the symlink pattern used to share one install
# across git worktrees (`ln -s ../node_modules`) slips past `node_modules/` and
# gets picked up by `git add -A`. That has twice landed a committed symlink and
# turned `test/repo-map-sync.js` red with
# "FAIL top-level file `node_modules` is documented in REPO_MAP.md".
node_modules
package-lock.json
.playwright/

# Supabase CLI local link metadata
supabase/.temp/

# Master tester — per-run artifacts (regenerated every run)
qa/visual/
qa/MASTER_REPORT.md

# Overnight runner — live runtime log (churns constantly; curated results go
# into qa/OVERNIGHT_TEST_REPORT.md instead). Per-run master JSON reports too.
qa/overnight_runner.log
qa/overnight-output/
qa/reports/

# Ad-hoc screenshot output (proof snapshots live in PRs/Argos, not git)
qa/shots/
.codex-tmp/
/artifacts/
