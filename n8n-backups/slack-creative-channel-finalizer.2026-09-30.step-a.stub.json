  "nodes_added_by_step_a": [
    {
      "name": "Finalize Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "detail": "POST /webhook/slack-creative-finalize, responds on receipt"
    },
    {
      "name": "Every Day Safety Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "detail": "daily 15:07 instance time"
    },
    {
      "name": "List Pending Clients",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "detail": "reads pending rows of the Slack Creative Channel Queue table"
    },
    {
      "name": "One Item Per Pending Client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "name": "Trigger Finalizer For Client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "detail": "POSTs the webhook above once per pending client, 20 s apart, continue on error"
    }
  ],
  "node_changed_by_step_a": {
    "name": "Pick One Pending Job",
    "change": "when the run came from the webhook and the body has client_name, pick only that client's pending row; otherwise the oldest pending row as before"
  },
  "timer_status": "Every 15 Minutes is still ON (owner decision 2026-09-30); a follow-up PR removes it after the next real client is created through the webhook"
