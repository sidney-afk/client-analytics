            --sv-shadow-rgba-162-28-230-0_38: rgba(0,0,0,0.56);
            --sv-shadow-rgba-17-17-16-0_06: rgba(0,0,0,0.24);
            --sv-shadow-rgba-17-17-16-0_07: rgba(0,0,0,0.25);
            --sv-shadow-rgba-17-17-16-0_16: rgba(0,0,0,0.34);
            --sv-shadow-rgba-22-101-52-0_10: rgba(0,0,0,0.28);
            --sv-shadow-rgba-22-101-52-0_16: rgba(0,0,0,0.34);
            --sv-shadow-rgba-22-101-52-0_22: rgba(0,0,0,0.4);
            --sv-shadow-rgba-22-101-52-0_28: rgba(0,0,0,0.46);
            --sv-shadow-rgba-22-101-52-0_3: rgba(0,0,0,0.48);
            --sv-shadow-rgba-22-101-52-0_36: rgba(0,0,0,0.54);
            --sv-shadow-rgba-22-163-74-0_3: rgba(0,0,0,0.48);
            --sv-shadow-rgba-22-163-74-0_35: rgba(0,0,0,0.53);
            --sv-shadow-rgba-255-255-255-0_5: rgba(0,0,0,0.68);
            --sv-shadow-rgba-255-255-255-0_55: rgba(0,0,0,0.68);
            --sv-shadow-rgba-37-99-235-0_42: rgba(0,0,0,0.6);
            --sv-shadow-rgba-6-78-59-0_28: rgba(0,0,0,0.46);
            --sv-shadow-rgba-92-68-38-0_10: rgba(0,0,0,0.28);
            --sv-shadow-rgba-94-106-210-_12: rgba(174,181,242,.12);
            --sv-shadow-rgba-94-106-210-0: rgba(94,106,210,0);
            --sv-shadow-rgba-94-106-210-0_18: rgba(174,181,242,0.18);
            --sv-shadow-rgba-94-106-210-0_45: rgba(174,181,242,0.45);
            --sv-shadow-rgba-94-106-210-0_55: rgba(174,181,242,0.55);
            --sv-shadow-rgba-94-106-210-0_6: rgba(174,181,242,0.6);
            --sv-shadow-rgba-99-102-241-0_22: rgba(0,0,0,0.4);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html[data-theme="dark"] ::selection { background: var(--selection-bg); color: var(--text-primary); }
        html[data-theme="dark"] ::-webkit-scrollbar { width: 10px; height: 10px; }
        html[data-theme="dark"] ::-webkit-scrollbar-track { background: var(--bg); }
        html[data-theme="dark"] ::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border: 2px solid var(--bg); border-radius: 999px; }
        html[data-theme="dark"] ::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover); }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; -webkit-font-smoothing: antialiased; }
        .header { background: var(--white); border-bottom: 1px solid var(--border); padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
        .logo { display: flex; align-items: center; gap: 9px; }
        .logo img { width: 25px; height: 25px; border-radius: 6px; }
        .logo-text { font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; }
        .header-meta { font-size: 0.77rem; color: var(--text-muted); }
        .header-actions { display: inline-flex; align-items: center; justify-content: flex-end; gap: 10px; min-width: 0; }
        .staff-identity-wrap { position: relative; display: inline-flex; }
        .staff-identity-btn { position: relative; }
        .staff-identity-btn.is-checking svg { animation: staff-identity-check 1s ease-in-out infinite; }
        .staff-identity-btn.is-valid { color: var(--up); border-color: var(--up); background: var(--up-bg); }
        .staff-identity-btn.is-valid::after { content: ''; position: absolute; right: 4px; bottom: 4px; width: 6px; height: 6px; border-radius: 50%; background: var(--up); box-shadow: 0 0 0 2px var(--white); }
        .staff-account-popover { position: absolute; z-index: 9997; top: calc(100% + 10px); right: 0; width: min(286px, calc(100vw - 28px)); border: 1px solid var(--border); border-radius: 14px; background: var(--white); box-shadow: 0 18px 48px var(--sv-shadow-rgba-17-17-16-0_16); padding: 8px; transform-origin: top right; }
        .staff-account-popover.is-open { animation: staff-popover-in 0.16s ease-out; }
        .staff-account-summary { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 10px 10px 11px; }
        .staff-account-avatar { width: 34px; height: 34px; flex: 0 0 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: var(--up-bg); color: var(--up); font-size: 0.76rem; font-weight: 800; letter-spacing: -0.02em; }
        .staff-account-copy { min-width: 0; }
        .staff-account-line { color: var(--text-primary); font-size: 0.78rem; font-weight: 720; line-height: 1.45; overflow-wrap: anywhere; }
        .staff-account-note { margin-top: 2px; color: var(--text-muted); font-size: 0.68rem; line-height: 1.35; }
        .staff-account-sep { height: 1px; margin: 0 4px 5px; background: var(--border-light); }
        .staff-account-action { width: 100%; min-height: 38px; border: 0; border-radius: 10px; padding: 9px 10px; display: flex; align-items: center; gap: 9px; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.76rem; font-weight: 700; text-align: left; cursor: pointer; transition: background 0.14s, color 0.14s, transform 0.14s; }
        .staff-account-action:hover { background: var(--bg); color: var(--text-primary); }
        .staff-account-action:active { transform: scale(0.985); }
        .staff-account-action:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
        .staff-account-action svg { width: 15px; height: 15px; flex: 0 0 auto; }
        .staff-account-action .theme-icon-sun { display: none; }
        html[data-theme="dark"] .staff-account-action .theme-icon-moon { display: none; }
        html[data-theme="dark"] .staff-account-action .theme-icon-sun { display: block; }
        .staff-account-action[hidden] { display: none; }
        .staff-account-action-copy { min-width: 0; display: grid; gap: 1px; }
        .staff-account-action-copy > span:first-child { color: inherit; }
        .staff-account-action-note { color: var(--text-muted); font-size: 0.64rem; font-weight: 550; line-height: 1.3; }
        .staff-account-action-state { margin-left: auto; color: var(--text-muted); font-size: 0.64rem; font-weight: 700; }
        .staff-auth-overlay { z-index: 9998; padding: 18px; box-sizing: border-box; background: var(--sv-bg-rgba-0-0-0-0_5); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); animation: staff-backdrop-in 0.18s ease-out; }
        .staff-auth-card { width: min(420px, 100%); border: 1px solid var(--border); border-radius: 16px; background: var(--white); box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_28); padding: 24px; animation: staff-card-in 0.2s ease-out; }
        .staff-auth-head { display: flex; align-items: center; gap: 11px; margin-bottom: 8px; }
        .staff-auth-mark { width: 36px; height: 36px; flex: 0 0 36px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); background: var(--bg); color: var(--text-primary); }
        .staff-auth-mark svg { width: 17px; height: 17px; }
        .staff-auth-title-wrap { min-width: 0; }
        .staff-auth-eyebrow { margin-bottom: 2px; color: var(--text-muted); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
        .staff-auth-card h2 { margin: 0; color: var(--text-primary); font-size: 1.08rem; letter-spacing: -0.02em; }
        .staff-auth-intro { margin: 0 0 19px; color: var(--text-secondary); font-size: 0.78rem; line-height: 1.55; }
        .staff-auth-fields { display: grid; gap: 14px; }
        .staff-auth-field { display: grid; gap: 7px; }
        .staff-auth-field label { color: var(--text-secondary); font-size: 0.7rem; font-weight: 750; }
        .staff-auth-field input:not([type="hidden"]) { width: 100%; min-height: 43px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 11px; background: var(--white); color: var(--text-primary); padding: 10px 12px; font: inherit; font-size: 0.84rem; outline: 0; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .staff-auth-field input:not([type="hidden"]):hover { border-color: var(--sv-border-b9b9b4); }
        .staff-auth-field input:not([type="hidden"]):focus { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .staff-auth-field input[aria-invalid="true"] { border-color: var(--dn); box-shadow: 0 0 0 3px var(--dn-bg); }
        .staff-auth-field input:disabled, .staff-auth-field button:disabled { cursor: wait; opacity: 0.68; }
        .staff-auth-error { min-height: 17px; margin-top: 9px; color: var(--dn); font-size: 0.72rem; font-weight: 650; line-height: 1.45; }
        .staff-auth-error:not(:empty) { padding: 8px 10px; border: 1px solid var(--dn); border-radius: 9px; background: var(--dn-bg); animation: staff-error-in 0.14s ease-out both; }
        .staff-auth-status { min-height: 17px; margin-top: 9px; color: var(--text-secondary); font-size: 0.72rem; font-weight: 650; line-height: 1.45; }
        .staff-auth-status:empty { display: none; }
        .staff-auth-secure { display: flex; align-items: flex-start; gap: 7px; margin-top: 12px; color: var(--text-muted); font-size: 0.66rem; line-height: 1.45; }
        .staff-auth-secure svg { width: 13px; height: 13px; flex: 0 0 auto; margin-top: 1px; }
        .staff-auth-actions { display: flex; align-items: center; justify-content: flex-end; gap: 9px; margin-top: 17px; }
        .staff-auth-actions .cal-import-btn-primary, .staff-auth-actions .cal-import-btn-ghost { min-height: 39px; transition: transform 0.14s, box-shadow 0.14s, background 0.14s, color 0.14s; }
        .staff-auth-actions .cal-import-btn-primary:not(:disabled):hover { box-shadow: 0 6px 16px var(--sv-shadow-rgba-17-17-16-0_16); transform: translateY(-1px); }
        .staff-auth-actions .cal-import-btn-primary:not(:disabled):active, .staff-auth-actions .cal-import-btn-ghost:active { transform: translateY(0) scale(0.985); }
        .staff-auth-actions button:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .staff-auth-spinner { width: 14px; height: 14px; display: inline-block; margin-right: 7px; vertical-align: -2px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: staff-spin 0.7s linear infinite; }
        .staff-auth-loading { display: grid; justify-items: center; gap: 11px; padding: 18px 4px 4px; text-align: center; }
        .staff-auth-loading .staff-auth-spinner { width: 20px; height: 20px; margin: 0; color: var(--text-primary); }
        .staff-auth-loading strong { color: var(--text-primary); font-size: 0.82rem; }
        .staff-auth-loading span { color: var(--text-muted); font-size: 0.7rem; line-height: 1.45; }
        @keyframes staff-popover-in { from { opacity: 0; } to { opacity: 1; } }
        @keyframes staff-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
        @keyframes staff-card-in { from { opacity: 0; } to { opacity: 1; } }
        @keyframes staff-error-in { from { opacity: 0; transform: translateY(-2px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes staff-spin { to { transform: rotate(360deg); } }
        @keyframes staff-identity-check { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
        @media (max-width: 520px) {
            .staff-account-popover { position: absolute; top: calc(100% + 10px); right: 0; width: min(286px, calc(100vw - 28px)); }
            .staff-auth-overlay { align-items: flex-end; padding: 12px; }
            .staff-auth-card { width: 100%; max-height: calc(100dvh - 24px); overflow-y: auto; border-radius: 18px; padding: 21px 18px calc(18px + env(safe-area-inset-bottom)); }
            .staff-auth-actions { display: grid; grid-template-columns: 1fr 1.25fr; }
            .staff-auth-actions button { width: 100%; }
        }
        @media (prefers-reduced-motion: reduce) {
            .staff-account-popover.is-open, .staff-auth-overlay, .staff-auth-card, .staff-auth-error:not(:empty), .staff-identity-btn.is-checking svg { animation: none; }
        }
        .theme-toggle { width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--theme-toggle-border); background: var(--theme-toggle-bg); color: var(--theme-toggle-color); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s; }
        .theme-toggle:hover { border-color: var(--focus-ring); color: var(--text-primary); box-shadow: 0 0 0 3px var(--theme-toggle-ring); }
        .theme-toggle:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .theme-toggle .theme-icon-sun { display: none; }
        html[data-theme="dark"] .theme-toggle .theme-icon-moon { display: none; }
        html[data-theme="dark"] .theme-toggle .theme-icon-sun { display: block; }
        html[data-status-palette="classic"] .palette-toggle { background: var(--theme-toggle-active-bg); color: var(--theme-toggle-active-color); border-color: var(--theme-toggle-active-bg); }
        html[data-status-palette="classic"] .palette-toggle:hover { color: var(--theme-toggle-active-color); }
        .main { padding: 32px 32px 80px; }
        .page-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 24px; }
        .page-title-row { display: flex; align-items: center; gap: 12px; }
        .back-btn { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; background: var(--white); border: 1px solid var(--border); border-radius: 7px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; text-decoration: none; }
        .back-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .page-title { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
        .page-sub { font-size: 0.82rem; color: var(--text-secondary); margin-top: 3px; }
        #pageTop.overview-mode { flex-direction: column; align-items: center; text-align: center; gap: 10px; }
        #pageTop.overview-mode .page-title { font-size: 2.4rem; }
        #pageTop.overview-mode .page-sub { font-size: 0.86rem; margin-top: 4px; }
        #pageTop.overview-mode #selectorWrap { margin-top: 2px; }
        .pins-area { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 10px; }
        .pins-row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; justify-content: center; min-height: 32px; }
        .pins-add-row { position: relative; display: flex; justify-content: center; }
        .pin-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: 99px; background: var(--white); border: 1.5px solid var(--border); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--text-primary); cursor: pointer; transition: all 0.15s; box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_07); user-select: none; }
        .pin-pill:hover { border-color: var(--sv-border-bbb); box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_12); }
        .pin-pill .pin-remove { display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; border-radius: 50%; background: var(--border); color: var(--text-muted); font-size: 0.6rem; line-height: 1; transition: all 0.13s; flex-shrink: 0; }
        .pin-pill .pin-remove:hover { background: var(--dn); color: var(--sv-fg-fff); }
        .pin-add-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 99px; background: transparent; border: 1.5px dashed var(--border); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.72rem; font-weight: 600; color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
        .pin-add-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-secondary); background: var(--white); }
        .pin-edit-btn { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
        .pin-edit-btn:hover { color: var(--text-primary); background: var(--border-light); }
        .pin-edit-btn.active { color: var(--text-primary); background: var(--bg); }
        .pins-add-row { position: relative; }
        .pin-selector-dropdown { position: absolute; top: calc(100% + 6px); left: 50%; transform: translateX(-50%) translateY(-4px) scale(0.98); background: var(--white); border-radius: 14px; box-shadow: 0 8px 32px var(--sv-shadow-rgba-0-0-0-0_13); padding: 8px; z-index: 70; min-width: 220px; opacity: 0; pointer-events: none; transition: all 0.16s ease; transform-origin: top center; }
        .pin-selector-dropdown.open { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); pointer-events: auto; }
        .pin-selector-header { display: flex; align-items: center; justify-content: space-between; padding: 4px 10px 8px; }
        .pin-selector-title { font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
        .pin-selector-count { font-size: 0.65rem; font-weight: 700; color: var(--text-muted); background: var(--bg); border-radius: 6px; padding: 2px 7px; }
        .pin-selector-item { display: flex; align-items: center; justify-content: space-between; padding: 7px 10px; border-radius: 8px; cursor: pointer; font-size: 0.8rem; font-weight: 500; color: var(--text-secondary); transition: background 0.1s; }
        .pin-selector-item:hover { background: var(--bg); color: var(--text-primary); }
        .pin-selector-item.pinned { color: var(--text-primary); font-weight: 700; }
        .pin-selector-item .pin-check { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border); flex-shrink: 0; transition: all 0.13s; }
        .pin-selector-item.pinned .pin-check { background: var(--text-primary); border-color: var(--text-primary); display: flex; align-items: center; justify-content: center; }
        .pin-selector-list { max-height: 240px; overflow-y: auto; }
        .pin-selector-list::-webkit-scrollbar { width: 4px; }
        .pin-selector-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        .card-client-link { cursor: pointer; transition: color 0.15s; text-decoration: none; color: inherit; }
        .card-client-link:hover { color: var(--text-secondary); }
        .card-eye-btn { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 5px; background: transparent; border: none; cursor: pointer; color: var(--text-muted); transition: color 0.15s; flex-shrink: 0; }
        .card-eye-btn:hover { color: var(--text-primary); }
        .selector-wrap { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }
        .search-bar-wrap { position: relative; }
        .search-bar-pill { display: flex; align-items: center; background: var(--white); border: 1.5px solid var(--border); border-radius: 99px; padding: 0 14px 0 20px; gap: 10px; width: 440px; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_07); transition: border-color 0.18s, box-shadow 0.18s; }
        .search-bar-pill:focus-within { border-color: var(--sv-border-aaa); box-shadow: 0 4px 18px var(--sv-shadow-rgba-0-0-0-0_11); }
        .search-bar-input { flex: 1; border: none; outline: none; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--text-primary); padding: 11px 0; min-width: 0; }
        .search-bar-input::placeholder { color: var(--text-muted); font-weight: 400; }
        .search-bar-icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; border: none; background: var(--text-primary); color: var(--white); cursor: pointer; flex-shrink: 0; transition: background 0.15s; }
        .search-bar-icon:hover { background: var(--sv-bg-333); }
        .search-ghost-overlay { position: absolute; top: 0; left: 20px; right: 54px; pointer-events: none; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 500; white-space: nowrap; overflow: hidden; display: flex; align-items: center; height: 100%; color: transparent; }
        .search-dropdown { position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--white); border-radius: 16px; box-shadow: 0 8px 32px var(--sv-shadow-rgba-0-0-0-0_13); padding: 6px; z-index: 60; opacity: 0; transform: translateY(-6px) scale(0.99); pointer-events: none; transition: all 0.16s ease; transform-origin: top center; }
        .search-dropdown.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
        .search-section-label { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-muted); padding: 8px 12px 4px; }
        .search-suggestion { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; cursor: pointer; transition: background 0.1s; font-size: 0.82rem; font-weight: 500; color: var(--text-secondary); }
        .search-suggestion:hover { background: var(--bg); color: var(--text-primary); }
        .search-suggestion .s-icon { color: var(--text-muted); flex-shrink: 0; }
        .search-suggestion .s-match { color: var(--text-primary); font-weight: 700; }
        .search-empty { padding: 12px; font-size: 0.78rem; color: var(--text-muted); font-style: italic; text-align: center; }
        .selector-label { font-size: 0.67rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 700; }
        .overview-wrap { background: transparent; border: none; overflow: visible; }
        .overview-controls { display: flex; align-items: center; justify-content: space-between; padding: 0 0 16px; gap: 12px; }
        .controls-left { display: flex; align-items: center; gap: 10px; }
        .custom-dropdown { position: relative; user-select: none; }
        .dropdown-trigger { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; background: var(--white); border: none; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.74rem; font-weight: 600; color: var(--text-secondary); transition: all 0.15s; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
        .dropdown-trigger:hover { color: var(--text-primary); box-shadow: 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_1); }
        .dropdown-trigger .dd-arrow { font-size: 0.6rem; opacity: 0.5; transition: transform 0.2s; }
        .dropdown-trigger.open .dd-arrow { transform: rotate(180deg); }
        .dropdown-menu { position: absolute; top: calc(100% + 6px); left: 0; background: var(--white); border-radius: 12px; box-shadow: 0 8px 30px var(--sv-shadow-rgba-0-0-0-0_12); padding: 6px; min-width: 160px; z-index: 50; opacity: 0; pointer-events: none; visibility: hidden; transition: opacity 0.1s ease, visibility 0s linear 0.1s; will-change: opacity; }
        .dropdown-menu.open { opacity: 1; pointer-events: auto; visibility: visible; transition: opacity 0.1s ease, visibility 0s linear 0s; }
        .dropdown-item { display: block; width: 100%; padding: 7px 12px; border: none; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.74rem; font-weight: 500; color: var(--text-secondary); text-align: left; cursor: pointer; border-radius: 8px; transition: all 0.1s; }
        .dropdown-item:hover { background: var(--bg); color: var(--text-primary); }
        .dropdown-item.active { background: var(--bg); color: var(--text-primary); font-weight: 700; }
        .client-drop-menu { max-height: 320px; overflow-y: auto; min-width: 200px; right: 0; left: auto; }
        .client-drop-menu::-webkit-scrollbar { width: 4px; }
        .client-drop-menu::-webkit-scrollbar-track { background: transparent; }
        .client-drop-menu::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        .sort-dir-btn { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; border: none; background: var(--white); cursor: pointer; font-size: 0.72rem; color: var(--text-muted); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; transition: all 0.13s; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
        .sort-dir-btn:hover { color: var(--text-primary); box-shadow: 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_1); }
        .view-toggle { display: inline-flex; align-items: center; gap: 0; border-radius: 8px; overflow: hidden; background: var(--white); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
        .view-toggle-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 30px; border: none; background: transparent; cursor: pointer; color: var(--text-muted); transition: all 0.13s; }
        .view-toggle-btn:hover { color: var(--text-secondary); }
        .view-toggle-btn.active { background: var(--text-primary); color: var(--white); }
        .overview-table { width: 100%; border-collapse: separate; border-spacing: 0 16px; table-layout: fixed; }
        .overview-table th { padding: 8px 10px; font-size: 0.63rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; text-align: center; vertical-align: middle; line-height: 1.3; overflow: hidden; background: transparent; border: none; color: var(--text-muted); user-select: none; -webkit-user-select: none; }
        .overview-table th.group-ig { color: var(--ig-dark); background: transparent; font-size: 0.7rem; letter-spacing: 0.08em; padding: 9px 10px 4px; }
        .overview-table th.group-tt { color: var(--tt-dark); background: transparent; font-size: 0.7rem; letter-spacing: 0.08em; padding: 9px 10px 4px; }
        .overview-table th.group-yt { color: var(--yt-dark); background: transparent; font-size: 0.7rem; letter-spacing: 0.08em; padding: 9px 10px 4px; }
        .overview-table th.ig-h { color: var(--ig-dark); background: transparent; padding: 4px 10px 8px; border-radius: 0; border-bottom: 2px solid var(--ig-mid); }
        .overview-table th.tt-h { color: var(--tt-dark); background: transparent; padding: 4px 10px 8px; border-radius: 0; border-bottom: 2px solid var(--tt-mid); }
        .overview-table th.yt-h { color: var(--yt-dark); background: transparent; padding: 4px 10px 8px; border-radius: 0; border-bottom: 2px solid var(--yt-mid); }
        .overview-table td { padding: 18px 10px; font-size: 0.83rem; font-variant-numeric: tabular-nums; text-align: center; vertical-align: middle; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--white); color: var(--text-secondary); }
        .overview-table td:first-child { text-align: left; font-weight: 600; border-radius: 10px 0 0 10px; color: var(--text-primary); padding: 0 10px 0 14px; position: relative; overflow: hidden; }
        .overview-table td:first-child .cell-inner { display: flex; align-items: center; gap: 0; height: 100%; min-height: 54px; }
        .overview-table td:last-child { border-radius: 0 10px 10px 0; position: relative; overflow: hidden; }
        .overview-table td:last-child::after { content: none; }
        .overview-table td:first-child::after { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; background: var(--sv-bg-6c5ce7); border-radius: 3px; }
        .overview-table tbody tr { filter: drop-shadow(0 2px 4px var(--sv-shadow-rgba-0-0-0-0_07)); }
        .overview-table tbody tr:hover td { cursor: default; background: var(--sv-bg-f8f8f6); }
        .overview-table tbody tr:hover td.col-ig, .overview-table tbody tr:hover td.col-ig.num.has, .overview-table tbody tr:hover td.col-ig.main-metric { background: var(--sv-bg-f9eef4); }
        .overview-table tbody tr:hover td.col-tt, .overview-table tbody tr:hover td.col-tt.num.has, .overview-table tbody tr:hover td.col-tt.main-metric { background: var(--sv-bg-f0f0f0); }
        .overview-table tbody tr:hover td.col-yt, .overview-table tbody tr:hover td.col-yt.num.has, .overview-table tbody tr:hover td.col-yt.main-metric { background: var(--sv-bg-fceef0); }
        .top-rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; font-size: 0.58rem; font-weight: 800; margin-right: 6px; flex-shrink: 0; }
        .top-1 .top-rank-badge { background: var(--sv-bg-fef3c7); color: var(--sv-fg-b45309); }
        .top-2 .top-rank-badge { background: var(--sv-bg-f1f1f1); color: var(--sv-fg-6b6b67); }
        .top-3 .top-rank-badge { background: var(--sv-bg-fde8d8); color: var(--sv-fg-c2410c); }
        .overview-table td.col-ig { color: var(--text-secondary); background: var(--sv-bg-fdf6f9); }
        .overview-table td.col-ig.num.has { color: var(--text-primary); font-weight: 500; background: var(--sv-bg-fdf6f9); }
        .overview-table td.col-ig.main-metric { color: var(--ig-dark); font-weight: 700; font-size: 0.87rem; background: var(--sv-bg-fdf6f9); border-left: 2px solid var(--sv-border-f4c2d5); }
        .overview-table td.col-tt { color: var(--text-secondary); background: var(--sv-bg-f7f7f7); }
        .overview-table td.col-tt.num.has { color: var(--text-primary); font-weight: 500; background: var(--sv-bg-f7f7f7); }
        .overview-table td.col-tt.main-metric { color: var(--tt-dark); font-weight: 700; font-size: 0.87rem; background: var(--sv-bg-f7f7f7); border-left: 2px solid var(--sv-border-d0d0d0); }
        .overview-table td.col-yt { color: var(--text-secondary); background: var(--sv-bg-fff7f7); }
        .overview-table td.col-yt.num.has { color: var(--text-primary); font-weight: 500; background: var(--sv-bg-fff7f7); }
        .overview-table td.col-yt.main-metric { color: var(--yt-dark); font-weight: 700; font-size: 0.87rem; background: var(--sv-bg-fff7f7); border-left: 2px solid var(--sv-border-ffbebe); }
        .num { color: var(--text-muted); }
        .num.has { font-weight: 500; }
        .g-up { color: var(--up); font-size: 0.73rem; font-weight: 600; }
        .g-down { color: var(--dn); font-size: 0.73rem; font-weight: 600; }
        .g-none { color: var(--sv-fg-d8d8d3); font-size: 0.73rem; }
        .client-name-link { color: var(--text-primary); text-decoration: none; font-weight: 600; cursor: pointer; transition: color 0.15s; }
        .client-name-link:hover { color: var(--text-secondary); }
        .client-view-btn { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 4px; background: transparent; border: none; cursor: pointer; transition: all 0.15s; flex-shrink: 0; margin-left: 0; margin-right: 6px; color: var(--text-muted); }
        .client-view-btn:hover { color: var(--text-primary); }
        .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
        .client-card { background: var(--white); border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_06); position: relative; }
        .client-card::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--sv-bg-6c5ce7); border-radius: 0 0 14px 14px; }
        .card-head { padding: 14px 16px 10px; display: flex; align-items: center; justify-content: space-between; }
        .card-client-name { font-size: 0.92rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
        .card-date { font-size: 0.68rem; color: var(--text-muted); }
        .card-rank { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; font-size: 0.6rem; font-weight: 800; margin-right: 7px; flex-shrink: 0; }
        .card-rank-1 { background: var(--sv-bg-fef3c7); color: var(--sv-fg-b45309); }
        .card-rank-2 { background: var(--sv-bg-f1f1f1); color: var(--sv-fg-6b6b67); }
        .card-rank-3 { background: var(--sv-bg-fde8d8); color: var(--sv-fg-c2410c); }
        .card-platforms { padding: 0 16px 14px; display: flex; flex-direction: column; gap: 8px; }
        .card-platform { border-radius: 10px; padding: 10px 14px; display: flex; flex-wrap: wrap; gap: 4px 16px; }
        .card-platform.cp-ig { background: linear-gradient(135deg, var(--sv-bg-c9006a) 0%, var(--sv-bg-e8510a) 100%); }
        .card-platform.cp-tt { background: linear-gradient(135deg, var(--sv-bg-0a0a1a) 0%, var(--sv-bg-1a1a4a) 60%, var(--sv-bg-0d1a3a) 100%); }
        .card-platform.cp-yt { background: linear-gradient(135deg, var(--sv-bg-7a0000) 0%, var(--sv-bg-cc0000) 60%, var(--sv-bg-a00000) 100%); }
        .card-platform-label { width: 100%; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 2px; color: var(--sv-fg-rgba-255-255-255-0_65); }
        .card-metric { display: flex; flex-direction: column; gap: 1px; }
        .card-metric-label { font-size: 0.57rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sv-fg-rgba-255-255-255-0_55); }
        .card-metric-val { font-size: 0.88rem; font-weight: 700; color: var(--sv-fg-fff); font-variant-numeric: tabular-nums; }
        .card-metric-val.empty { color: var(--sv-fg-rgba-255-255-255-0_3); font-weight: 400; font-size: 0.76rem; }
        .card-metric-gain { font-size: 0.65rem; font-weight: 700; padding: 0; }
        .card-metric-gain.up { background: transparent; color: var(--sv-fg-a8ffb0); }
        .card-metric-gain.down { background: transparent; color: var(--sv-fg-ffb0b0); }
        .card-metric-gain.flat { background: transparent; color: var(--sv-fg-rgba-255-255-255-0_35); }
        .col-name { width: 130px; } .col-date { width: 80px; } .col-num { width: 80px; } .col-gain { width: 60px; }
        .client-view { animation: fadeIn 0.15s ease; max-width: 980px; margin: 0 auto; }
        @keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
        .detail-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
        .detail-name { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
        .detail-meta { font-size: 0.76rem; color: var(--text-muted); margin-top: 5px; }
        .detail-meta em { font-style: italic; }
        .detail-info-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 20px; height: 20px; border-radius: 50%;
            border: 1.5px solid var(--border); background: var(--white);
            font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.68rem;
            font-weight: 700; color: var(--text-muted); cursor: pointer;
            transition: all 0.15s; flex-shrink: 0;
            margin-left: 8px; vertical-align: middle;
        }
        .detail-info-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .detail-info-overlay {
            display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: var(--sv-bg-rgba-0-0-0-0_25); z-index: 200;
            align-items: center; justify-content: center;
        }
        .detail-info-overlay.open { display: flex; }
        .detail-info-modal {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 16px; padding: 24px 28px; width: 480px; max-width: 92vw;
            max-height: 60vh; overflow-y: auto;
            box-shadow: 0 12px 40px var(--sv-shadow-rgba-0-0-0-0_15);
            animation: fadeIn 0.15s ease;
        }
        .detail-info-modal-head {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 14px;
        }
        .detail-info-modal-title {
            font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--text-muted);
        }
        .detail-info-modal-close {
            display: inline-flex; align-items: center; justify-content: center;
            width: 26px; height: 26px; border-radius: 50%; border: none;
            background: var(--bg); color: var(--text-muted); cursor: pointer;
            transition: all 0.13s;
        }
        .detail-info-modal-close:hover { background: var(--border); color: var(--text-primary); }
        .detail-info-modal-body {
            font-size: 0.85rem; font-weight: 400; color: var(--text-secondary);
            line-height: 1.65;
        }
        .share-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.81rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
        .share-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .share-btn.copied { background: var(--up-bg); border-color: var(--sv-border-86efac); color: var(--up); }
        .slack-update-btn { color: var(--sv-fg-611f69); border-color: var(--sv-border-611f6933); }
        .slack-update-btn:hover { color: var(--sv-fg-4a154b); border-color: var(--sv-border-611f69); }
        .gains-bar { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 14px 18px; margin-bottom: 12px; display: flex; align-items: stretch; gap: 10px; flex-wrap: wrap; }
        .gains-bar-label { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); white-space: nowrap; flex-shrink: 0; display: flex; align-items: center; padding-right: 14px; border-right: 1px solid var(--border-light); margin-right: 4px; }
        .gains-platform-card { display: flex; flex-direction: column; gap: 7px; flex: 1; min-width: 150px; padding: 10px 14px; border-radius: 10px; }
        .gains-platform-card.gp-ig { background: var(--ig-light); }
        .gains-platform-card.gp-tt { background: var(--tt-light); }
        .gains-platform-card.gp-yt { background: var(--yt-light); }
        .gains-platform-header { display: flex; align-items: center; gap: 6px; }
        .gains-platform-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
        .gp-ig .gains-platform-dot { background: var(--ig); }
        .gp-tt .gains-platform-dot { background: var(--sv-bg-555); }
        .gp-yt .gains-platform-dot { background: var(--yt); }
        .gains-platform-name { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
        .gp-ig .gains-platform-name { color: var(--ig-dark); }
        .gp-tt .gains-platform-name { color: var(--tt-dark); }
        .gp-yt .gains-platform-name { color: var(--yt-dark); }
        .analytics-state-badge { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--sv-border-f59e0b); border-radius: 999px; padding: 2px 7px; color: var(--sv-fg-f59e0b); background: var(--white); font-size: 0.56rem; font-weight: 800; letter-spacing: 0.04em; line-height: 1.2; white-space: nowrap; }
        .gains-platform-card.is-degraded { border: 1px dashed var(--sv-border-f59e0b); }
        .gains-platform-card.is-degraded .gains-platform-header { justify-content: space-between; flex-wrap: wrap; }
        .platform-section .analytics-state-badge, .card-platform .analytics-state-badge { color: var(--sv-fg-rgba-255-255-255-0_9); background: var(--sv-bg-rgba-0-0-0-0_25); border-color: var(--sv-border-rgba-255-255-255-0_18); }
        .card-platform.is-degraded { border: 1px dashed var(--sv-border-rgba-255-255-255-0_18); }
        .overview-table .analytics-state-badge { margin-left: 6px; vertical-align: middle; }
        .analytics-degraded-note { padding: 0 20px 15px; color: var(--sv-fg-rgba-255-255-255-0_7); font-size: 0.72rem; font-weight: 600; }
        .gains-metrics-row { display: flex; gap: 10px; flex-wrap: wrap; }
        .gain-chip { display: inline-flex; flex-direction: column; gap: 2px; }
        .gain-chip-label { font-size: 0.56rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .gain-chip-val { display: inline-flex; align-items: center; gap: 4px; }
        .gain-chip-num { font-size: 0.82rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-primary); }
        .gain-chip-num.empty { color: var(--text-muted); font-weight: 400; font-size: 0.74rem; }
        .gain-delta { display: inline-flex; align-items: center; font-size: 0.67rem; font-weight: 700; padding: 1px 6px; border-radius: 20px; font-variant-numeric: tabular-nums; }
        .gain-delta.up { background: var(--sv-bg-dcfce7); color: var(--up); }
        .gain-delta.down { background: var(--dn-bg); color: var(--dn); }
        .gain-delta.flat { background: transparent; color: var(--text-muted); }
        .gain-delta.none { background: transparent; color: var(--text-muted); font-weight: 400; font-style: italic; font-size: 0.65rem; }
        .gains-no-data-note { font-size: 0.68rem; color: var(--text-muted); font-style: italic; display: flex; align-items: center; padding-left: 4px; }
        .platform-section { margin-bottom: 11px; border-radius: 14px; overflow: hidden; border: none; }
        .platform-section.ig { background: linear-gradient(135deg, var(--sv-bg-c9006a) 0%, var(--sv-bg-e8510a) 100%); }
        .platform-section.tt { background: linear-gradient(135deg, var(--sv-bg-0a0a1a) 0%, var(--sv-bg-1a1a4a) 60%, var(--sv-bg-0d1a3a) 100%); }
        .platform-section.yt { background: linear-gradient(135deg, var(--sv-bg-7a0000) 0%, var(--sv-bg-cc0000) 60%, var(--sv-bg-a00000) 100%); }
        .platform-section-header { padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--sv-border-rgba-255-255-255-0_12); }
        .platform-name { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.82rem; color: var(--sv-fg-fff); }
        .platform-pill { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--sv-bg-rgba-255-255-255-0_7); }
        .platform-handle-link { font-size: 0.71rem; color: var(--sv-fg-rgba-255-255-255-0_6); font-weight: 400; text-decoration: none; transition: color 0.15s; }
        .platform-handle-link:hover { color: var(--sv-fg-fff); }
        .metrics-row { display: grid; padding: 18px 20px 20px; background: transparent; }
        .ig .metrics-row { grid-template-columns: repeat(4, 1fr); }
        .tt .metrics-row { grid-template-columns: repeat(3, 1fr); }
        .yt .metrics-row { grid-template-columns: repeat(2, 1fr); }
        .metric-block { padding: 0 18px 0 0; border-right: 1px solid var(--sv-border-rgba-255-255-255-0_15); }
        .metric-block:last-child { border-right: none; padding-right: 0; }
        .metric-block:not(:first-child) { padding-left: 18px; }
        .m-label { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--sv-fg-rgba-255-255-255-0_6); margin-bottom: 7px; }
        .m-value { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.025em; line-height: 1; color: var(--sv-fg-fff); font-variant-numeric: tabular-nums; }
        .m-value.empty { color: var(--sv-fg-rgba-255-255-255-0_25); font-size: 1.1rem; font-weight: 400; }
        .m-delta { display: inline-flex; align-items: center; gap: 3px; font-size: 0.71rem; font-weight: 600; margin-top: 6px; padding: 2px 7px; border-radius: 20px; }
        .m-delta.up { background: var(--sv-bg-rgba-255-255-255-0_2); color: var(--sv-fg-a8ffb0); }
        .m-delta.down { background: var(--sv-bg-rgba-0-0-0-0_2); color: var(--sv-fg-ffb0b0); }
        .m-delta.flat { background: var(--sv-bg-rgba-255-255-255-0_1); color: var(--sv-fg-rgba-255-255-255-0_5); }
        .m-delta.none { color: var(--sv-fg-rgba-255-255-255-0_4); font-size: 0.68rem; margin-top: 6px; display: block; font-weight: 400; font-style: italic; background: none; padding: 0; }
        .content-summary-section { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 16px 20px; margin-bottom: 12px; }
        .cs-header { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
        .cs-title { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text); }
        .cs-subtitle { font-size: 0.65rem; color: var(--text-muted); }
        .cs-generate-btn { background: linear-gradient(135deg,var(--sv-bg-6c63ff),var(--sv-bg-a78bfa)); color: var(--sv-fg-fff); border: none; border-radius: 8px; padding: 9px 18px; font-family: 'Plus Jakarta Sans',sans-serif; font-size: 0.73rem; font-weight: 700; cursor: pointer; transition: opacity 0.15s; }
        .cs-generate-btn:hover { opacity: 0.88; }
        .cs-regen-btn { background: none; border: 1px solid var(--border); border-radius: 6px; padding: 5px 12px; font-family: 'Plus Jakarta Sans',sans-serif; font-size: 0.65rem; font-weight: 600; color: var(--text-muted); cursor: pointer; margin-top: 10px; }
        .cs-regen-btn:hover { border-color: var(--text-muted); color: var(--text); }
        .cs-loading { display: flex; align-items: center; gap: 10px; font-size: 0.75rem; color: var(--text-muted); }
        .cs-spinner { width: 14px; height: 14px; border: 2px solid var(--border); border-top-color: var(--sv-border-6c63ff); border-radius: 50%; animation: spin 0.8s linear infinite; flex-shrink: 0; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .cs-error { font-size: 0.72rem; color: var(--sv-fg-e05); margin-bottom: 8px; }
        .cs-bullets { margin: 0 0 4px 0; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 7px; }
        .cs-bullets li { font-size: 0.78rem; line-height: 1.5; color: var(--text); }
        .top-videos-section { border-top: 1px solid var(--sv-border-rgba-255-255-255-0_1); padding: 16px 20px 20px; }
        .top-videos-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 10px; }
        .top-videos-title { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--sv-fg-rgba-255-255-255-0_55); }
        .period-toggle { display: flex; gap: 0; border-radius: 8px; overflow: hidden; border: 1px solid var(--sv-border-rgba-255-255-255-0_15); }
        .period-btn { padding: 5px 14px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.68rem; font-weight: 600; cursor: pointer; border: none; background: var(--sv-bg-rgba-255-255-255-0_06); color: var(--sv-fg-rgba-255-255-255-0_45); transition: all 0.15s; }
        .period-btn:hover { background: var(--sv-bg-rgba-255-255-255-0_1); color: var(--sv-fg-rgba-255-255-255-0_7); }
        .period-btn.active { background: var(--sv-bg-rgba-255-255-255-0_2); color: var(--sv-fg-fff); }
        .video-cards-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 4px; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
        .video-cards-scroll::-webkit-scrollbar { height: 4px; }
        .video-cards-scroll::-webkit-scrollbar-track { background: var(--sv-bg-rgba-255-255-255-0_05); border-radius: 4px; }
        .video-cards-scroll::-webkit-scrollbar-thumb { background: var(--sv-bg-rgba-255-255-255-0_15); border-radius: 4px; }
        .video-cards-scroll::-webkit-scrollbar-thumb:hover { background: var(--sv-bg-rgba-255-255-255-0_25); }
        .video-card-tt { flex: 0 0 220px; background: var(--sv-bg-rgba-255-255-255-0_07); border: 1px solid var(--sv-border-rgba-255-255-255-0_1); border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; scroll-snap-align: start; transition: background 0.15s, border-color 0.15s; text-decoration: none; position: relative; }
        .video-card-tt:hover { background: var(--sv-bg-rgba-255-255-255-0_12); border-color: var(--sv-border-rgba-255-255-255-0_2); }
        .tt-rank-badge { display: inline-flex; align-items: center; gap: 4px; background: var(--sv-bg-rgba-255-255-255-0_1); color: var(--sv-fg-rgba-255-255-255-0_6); font-size: 0.6rem; font-weight: 800; padding: 3px 8px; border-radius: 5px; letter-spacing: 0.02em; margin-bottom: 8px; width: fit-content; }
        .tt-caption { font-size: 0.72rem; font-weight: 500; color: var(--sv-fg-rgba-255-255-255-0_8); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 10px; flex: 1; }
        .tt-caption-full { -webkit-line-clamp: unset; }
        .read-more-btn { background: none; border: none; color: var(--sv-fg-rgba-255-255-255-0_45); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.64rem; font-weight: 600; cursor: pointer; padding: 0; margin-bottom: 8px; text-align: left; transition: color 0.15s; }
        .read-more-btn:hover { color: var(--sv-fg-rgba-255-255-255-0_7); }
        .tt-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 8px; padding-top: 10px; border-top: 1px solid var(--sv-border-rgba-255-255-255-0_08); }
        .tt-stat { display: flex; align-items: center; gap: 4px; }
        .tt-stat-icon { flex-shrink: 0; opacity: 0.4; }
        .tt-stat-val { font-size: 0.69rem; font-weight: 700; color: var(--sv-fg-rgba-255-255-255-0_85); font-variant-numeric: tabular-nums; }
        .top-videos-empty { padding: 18px 0; text-align: center; color: var(--sv-fg-rgba-255-255-255-0_35); font-size: 0.78rem; font-style: italic; }
        .chart-section { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-top: 14px; box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_04); }
        .chart-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
        .chart-title { font-weight: 700; color: var(--text-secondary); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.07em; }
        .chart-legend { display: flex; gap: 16px; }
        .leg-item { display: flex; align-items: center; gap: 6px; font-size: 0.74rem; color: var(--text-secondary); font-weight: 500; }
        .leg-dot { width: 8px; height: 8px; border-radius: 50%; }
        .chart-wrap { position: relative; height: 240px; }
        .chart-plat-toggle { display: flex; gap: 5px; flex-wrap: wrap; }
        .chart-plat-btn { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border: 1px solid var(--border); border-radius: 20px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.71rem; font-weight: 600; background: transparent; color: var(--text-secondary); cursor: pointer; transition: border-color 0.15s, background 0.15s, color 0.15s; }
        .cpb-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .chart-plat-btn.active { background: var(--bg); border-color: transparent; color: var(--text); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_07); }
        .chart-plat-btn:hover:not(.active) { border-color: var(--sv-border-bbb); color: var(--text); }
        .chart-mode-toggle { display: inline-flex; background: var(--bg); border: 1px solid var(--border); border-radius: 20px; padding: 2px; gap: 1px; }
        .chart-mode-btn { padding: 3px 10px; border: none; border-radius: 18px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.68rem; font-weight: 600; background: transparent; color: var(--text-secondary); cursor: pointer; transition: background 0.15s, color 0.15s; }
        .chart-mode-btn.active { background: var(--white); color: var(--text); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_08); }
        .client-only-badge { display: inline-flex; align-items: center; gap: 7px; background: var(--ig-light); border: 1px solid var(--ig-mid); border-radius: 20px; padding: 4px 12px; font-size: 0.71rem; font-weight: 600; color: var(--ig-dark); margin-bottom: 18px; }
        .loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100px 20px; gap: 14px; }
        .spinner { width: 26px; height: 26px; border: 2px solid var(--border); border-top-color: var(--sv-border-777); border-radius: 50%; animation: spin 0.75s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loading-text { font-size: 0.83rem; color: var(--text-muted); }
        .sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
        .sv-skeleton { --sv-skel-base: var(--bg); --sv-skel-sheen: var(--border-light); position: relative; overflow: hidden; background: var(--sv-skel-base); border-radius: 8px; }
        /* The sheen animates `transform` on a pseudo-element, not `background-position`
           on the box: transform runs on the compositor thread, so the shimmer keeps
           moving through the long main-thread task of the first board render instead
           of freezing mid-sweep (measured on the Workload cold boot, 2026-09-14). */
        .sv-skeleton::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 0%, var(--sv-skel-sheen) 50%, transparent 100%); transform: translateX(-100%); animation: sv-shimmer-sweep 1.35s ease-in-out infinite; will-change: transform; pointer-events: none; }
        @media (prefers-reduced-motion: reduce) { .sv-skeleton::after { animation: none; } }
        html[data-theme="dark"] .sv-skeleton, html[data-theme="dark"] .tpl-skeleton { --sv-skel-base: var(--surface-subtle); --sv-skel-sheen: var(--field-bg-hover); }
        @keyframes sv-shimmer { 0% { background-position: 220% 0; } 100% { background-position: -220% 0; } }
        /* Legacy consumers (.prod-skeleton, .tpl-skeleton) still animate background-position
           via sv-shimmer; the compositor sweep has its own keyframe so the two never collide. */
        @keyframes sv-shimmer-sweep { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
        .sv-skeleton-pill { border-radius: 999px; }
        .sv-skeleton-line { height: 14px; border-radius: 6px; }
        .sv-skeleton-dot { width: 18px; height: 18px; border-radius: 50%; flex: none; }
        .sv-skeleton-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_04); }
        .sv-skeleton-stack { display: flex; flex-direction: column; gap: 12px; }
        .sv-skeleton-row { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .sv-skeleton-grid { display: grid; gap: 12px; }
        .boot-skeleton { width: min(780px, calc(100vw - 48px)); align-items: stretch; padding-top: 56px; }
        .boot-skeleton .sv-skeleton-card { padding: 22px; }
        .boot-skeleton-row { display: grid; grid-template-columns: 1fr 0.85fr 0.7fr; gap: 12px; }
        @media (max-width: 700px) { .boot-skeleton-row { grid-template-columns: 1fr; } }
        .boot-skeleton-variant { display: none; }
        html:not([data-boot-nav]) .boot-skeleton-analytics,
        html[data-boot-nav="analytics"] .boot-skeleton-analytics,
        html[data-boot-nav="linear"] .boot-skeleton-linear,
        html[data-boot-nav="workload"] .boot-skeleton-workload,
        html[data-boot-nav="calendar"] .boot-skeleton-calendar,
        html[data-boot-nav="samples"] .boot-skeleton-samples,
        html[data-boot-nav="sample-reviews"] .boot-skeleton-review,
        html[data-boot-nav="production"] .boot-skeleton-production,
        html[data-boot-nav="templates"] .boot-skeleton-templates,
        html[data-boot-nav="filming-plans"] .boot-skeleton-filming,
        html[data-boot-nav="tiktok-upload"] .boot-skeleton-tiktok,
        html[data-boot-nav="time-off"] .boot-skeleton-analytics,
        html[data-boot-nav="smm-weekly-report"] .boot-skeleton-sales-intake,
        html[data-boot-nav="smm-weekly-reports"] .boot-skeleton-kasper,
        html[data-boot-nav="client"][data-boot-subtab="verify"] .boot-skeleton-client-verify,
        html[data-boot-nav="client"][data-boot-subtab="analytics"] .boot-skeleton-client-profile,
        html[data-boot-nav="client"][data-boot-subtab="calendar"] .boot-skeleton-calendar,
        html[data-boot-nav="client"][data-boot-subtab="brief"] .boot-skeleton-client-brief,
        html[data-boot-nav="kasper"]:not([data-boot-subtab="sales-intake"]) .boot-skeleton-kasper,
        html[data-boot-nav="kasper"][data-boot-subtab="sales-intake"] .boot-skeleton-sales-intake { display: block; }
        .boot-page-skeleton { width: min(1080px, calc(100vw - 48px)); margin: 42px auto 0; }
        .boot-shell-head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
        .boot-tab-skeleton-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
        .boot-form-skeleton .si-card { max-width: 720px; }
        .boot-form-skeleton .si-grid { align-items: start; }
        .boot-input-skeleton { height: 39px; border-radius: 9px; }
        .boot-radio-skeleton { height: 33px; border-radius: 99px; }
        .boot-template-skeleton .tpl-section { min-height: 88px; }
        .boot-tiktok-skeleton .si-card { max-width: 760px; }
        @media (max-width: 760px) { .boot-page-skeleton { width: calc(100vw - 28px); margin-top: 28px; } }
        .analytics-overview-skeleton { width: 100%; margin: 48px 0 0; }
        .analytics-overview-skeleton .overview-controls { padding-bottom: 12px; }
        .analytics-overview-skeleton .controls-left { display: flex; gap: 6px; }
        .analytics-overview-table .sv-skeleton { margin: 0 auto; }
        .analytics-overview-table td:first-child .sv-skeleton { margin: 0; }
        .analytics-overview-table td:first-child .cell-inner { gap: 8px; }
        .analytics-overview-table .client-view-btn { background: var(--bg); border-radius: 4px; }
        .analytics-overview-table .col-ig .sv-skeleton { --sv-skel-base: var(--ig-light); --sv-skel-sheen: var(--ig-mid); }
        .analytics-overview-table .col-tt .sv-skeleton { --sv-skel-base: var(--tt-light); --sv-skel-sheen: var(--tt-mid); }
        .analytics-overview-table .col-yt .sv-skeleton { --sv-skel-base: var(--yt-light); --sv-skel-sheen: var(--yt-mid); }
        @media (max-width: 900px) { .analytics-overview-skeleton { margin-top: 32px; overflow-x: auto; } .analytics-overview-table { min-width: 960px; } }
        .analytics-detail-skeleton { max-width: 980px; margin: 0 auto; }
        .analytics-detail-skeleton .detail-hero { margin-bottom: 20px; }
        .analytics-skel-actions { display: flex; gap: 8px; align-items: center; }
        .analytics-detail-skeleton .gains-bar { margin-bottom: 12px; }
        .analytics-detail-skeleton .gains-platform-card .sv-skeleton { --sv-skel-base: var(--sv-bg-rgba-255-255-255-0_32); --sv-skel-sheen: var(--sv-bg-rgba-255-255-255-0_5); }
        .analytics-skel-platform { border-radius: 14px; overflow: hidden; margin-bottom: 11px; }
        .analytics-skel-platform .sv-skeleton { --sv-skel-base: var(--sv-bg-rgba-255-255-255-0_12); --sv-skel-sheen: var(--sv-bg-rgba-255-255-255-0_25); }
        .analytics-skel-platform-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--sv-border-rgba-255-255-255-0_12); gap: 16px; }
        .analytics-skel-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
        .analytics-skel-metric { min-width: 0; display: flex; flex-direction: column; gap: 10px; }
        .analytics-skel-platform .analytics-skel-metrics { padding: 18px 20px 20px; }
        .analytics-skel-top-videos { border-top: 1px solid var(--sv-border-rgba-255-255-255-0_1); padding: 16px 20px 20px; }
        .analytics-skel-video-row { display: flex; gap: 10px; overflow: hidden; }
        .analytics-skel-video-card { flex: 0 0 220px; background: var(--sv-bg-rgba-255-255-255-0_07); border: 1px solid var(--sv-border-rgba-255-255-255-0_1); border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 9px; }
        .analytics-skel-chart { height: 240px; display: flex; flex-direction: column; gap: 18px; }
        .analytics-skel-chart-bars { flex: 1; display: grid; grid-template-columns: repeat(9, 1fr); align-items: end; gap: 9px; border-bottom: 1px solid var(--border-light); padding-top: 12px; }
        .analytics-skel-chart-bars .sv-skeleton { width: 100%; border-radius: 6px 6px 0 0; }
        @media (max-width: 720px) { .analytics-skel-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } .analytics-skel-actions { width: 100%; } }
        .client-link-verify-skeleton { min-height: 58vh; display: flex; align-items: center; justify-content: center; }
        .client-link-verify-card { width: min(440px, calc(100vw - 40px)); background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; align-items: center; gap: 13px; text-align: center; box-shadow: 0 10px 34px var(--sv-shadow-rgba-0-0-0-0_08); }
        .client-link-verify-mark { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--border); }
        .client-profile-boot-skeleton { display: flex; flex-direction: column; gap: 16px; }
        .client-profile-boot-skeleton .detail-hero { min-height: 112px; margin-bottom: 0; }
        .client-brief-boot-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr); gap: 14px; }
        .client-brief-boot-card { min-height: 210px; display: flex; flex-direction: column; gap: 14px; }
        @media (max-width: 760px) { .client-brief-boot-grid { grid-template-columns: 1fr; } }
        .cs-skeleton { display: flex; flex-direction: column; gap: 9px; }
        .linear-search-skeleton { padding: 6px 10px 10px; display: flex; flex-direction: column; gap: 8px; }
        .linear-plan-skeleton { width: 62%; height: 16px; }
        .wl-search-loading { padding: 9px 12px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
        .workload-skeleton-grid { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 10px; display: grid; gap: 4px; }
        .workload-skeleton-grid.month { grid-template-columns: repeat(7, minmax(0, 1fr)); }
        .workload-skeleton-grid.week { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .workload-skeleton-day { min-height: 140px; background: var(--bg); border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; gap: 9px; }
        .workload-skeleton-grid.week .workload-skeleton-day { min-height: 420px; }
        .workload-skeleton-card { background: var(--white); border-radius: 6px; padding: 8px; display: flex; flex-direction: column; gap: 7px; }
        .cal-skeleton-loader { align-items: stretch; justify-content: flex-start; padding: 20px 0; min-height: 220px; width: 100%; box-sizing: border-box; }
        .cal-skeleton-sheet { width: 100%; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
        .boot-skeleton-calendar .boot-page-skeleton { width: 100%; max-width: none; margin: 0; padding: 8px 16px 20px; --cal-card-w: 268px; --cal-thumb-h: 178px; }
        .cal-skeleton-toolbar { display: flex; align-items: center; gap: 16px; padding: 12px 14px; background: var(--white); border: 1px solid var(--border); border-radius: 12px; flex-wrap: wrap; }
        .cal-skeleton-toolbar-left, .cal-skeleton-toolbar-mid, .cal-skeleton-toolbar-right { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .cal-skeleton-toolbar-left { flex: 1 1 380px; }
        .cal-skeleton-toolbar-mid, .cal-skeleton-toolbar-right { flex: 0 0 auto; }
        .cal-skeleton-strip { display: flex; gap: 14px; overflow: hidden; padding: 10px 4px 8px; align-items: flex-start; min-height: 620px; }
        .cal-skeleton-card { position: relative; flex: 0 0 var(--cal-card-w, 320px); background: var(--white); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
        .cal-skeleton-thumb { height: calc(var(--cal-thumb-h, 240px) + 16px); border-radius: 0; flex-shrink: 0; }
        .cal-skeleton-card-body { padding: 13px 14px 12px; display: flex; flex-direction: column; gap: 9px; }
        .cal-skeleton-field { height: 31px; border-radius: 8px; }
        .cal-skeleton-chip { height: 22px; border-radius: 99px; }
        .cal-skeleton-copy { height: 106px; border-radius: 8px; }
        .cal-skeleton-status { height: 22px; border-radius: 6px; }
        .cal-skeleton-status.is-video { --sv-skel-base: var(--cal-status-client-approval-bg); --sv-skel-sheen: var(--sv-bg-rgba-255-255-255-0_5); }
        .cal-skeleton-status.is-thumb { --sv-skel-base: var(--cal-status-for-smm-approval-bg); --sv-skel-sheen: var(--sv-bg-rgba-255-255-255-0_5); }
        .cal-skeleton-status.is-caption { --sv-skel-base: var(--cal-status-approved-bg); --sv-skel-sheen: var(--sv-bg-rgba-255-255-255-0_5); }
        @media (max-width: 760px) { .boot-skeleton-calendar .boot-page-skeleton { padding: 6px 10px 16px; } .cal-skeleton-toolbar { gap: 10px; } .cal-skeleton-toolbar-mid { order: 3; width: 100%; justify-content: flex-start; overflow: hidden; } .cal-skeleton-strip { min-height: 560px; } }
        .cal-skeleton-review { display: flex; flex-direction: column; gap: 12px; }
        .cal-skeleton-review-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 14px; align-items: center; }
        .cal-skeleton-review-thumb { width: 96px; height: 96px; border-radius: 10px; }
        @media (max-width: 760px) { .cal-skeleton-review-card { grid-template-columns: 76px minmax(0, 1fr); } .cal-skeleton-review-thumb { width: 76px; height: 76px; } }
        .sm-skeleton-strip { display: flex; gap: 14px; overflow: hidden; padding: 18px 0; }
        .sm-skeleton-card { flex: 0 0 var(--sm-card-w, 296px); background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
        .sm-skeleton-thumb { aspect-ratio: 9 / 14; border-radius: 12px; }
        .table-skeleton { width: min(920px, 100%); margin: 0 auto; display: flex; flex-direction: column; gap: 8px; padding: 12px 0; }
        .table-skeleton-row { background: var(--white); border: 1px solid var(--border-light); border-radius: 10px; padding: 12px 14px; display: grid; grid-template-columns: 1.2fr 1fr 1fr 80px; gap: 10px; align-items: center; }
        @media (max-width: 760px) { .table-skeleton-row { grid-template-columns: 1fr; } }
        .onboarding-skeleton { display: flex; flex-direction: column; gap: 12px; padding: 10px 0; }
        .onboarding-skeleton-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
        .kasper-skeleton-list { display: flex; flex-direction: column; gap: 12px; padding: 8px 0; }
        .kasper-skeleton-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 12px; display: grid; grid-template-columns: 96px minmax(0, 1fr) 120px; gap: 14px; align-items: center; }
        .kasper-skeleton-thumb { width: 96px; height: 96px; border-radius: 10px; }
        @media (max-width: 760px) { .kasper-skeleton-card { grid-template-columns: 80px minmax(0, 1fr); } .kasper-skeleton-thumb { width: 80px; height: 80px; } }
        .prod-detail-skeleton { max-width: 760px; margin: 0 auto; padding: 28px 24px; width: 100%; }
        .prod-skeleton { --sv-skel-base: var(--prod-column); --sv-skel-sheen: var(--prod-hover); background: linear-gradient(90deg, var(--sv-skel-base) 0%, var(--sv-skel-sheen) 48%, var(--sv-skel-base) 100%); background-size: 220% 100%; border-radius: 6px; animation: sv-shimmer 1.35s ease-in-out infinite; }
        .prod-loading-skeleton { flex: 1; min-width: 0; display: flex; width: 100%; min-height: 0; }
        .prod-loading-list { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .prod-loading-row { height: 44px; border-bottom: 1px solid var(--prod-divider); display: grid; grid-template-columns: 16px 76px minmax(0, 1fr) 140px 96px; gap: 8px; align-items: center; padding: 0 12px; }
        .prod-loading-detail { width: 286px; flex: 0 0 286px; border-left: 1px solid var(--prod-divider); padding: 18px 14px; display: flex; flex-direction: column; gap: 14px; }
        .error-state { background: var(--white); border: 1px solid var(--sv-border-fecaca); border-radius: 12px; padding: 32px; text-align: center; color: var(--dn); font-size: 0.88rem; }
        @media (max-width: 700px) { .video-card-tt { flex: 0 0 200px; } }

        .view-tab-toggle {
            display: inline-flex; align-items: center;
            background: var(--bg); border: 1px solid var(--border);
            border-radius: 11px; padding: 3px; gap: 2px;
            margin-bottom: 22px;
        }
        /* Client intake link (?intake=1): expose only the Linear submission
           flow — hide the workspace header and the now-backend-driven filming
           plan field. JS also hides these; these rules keep them hidden if any
           later code toggles display. */
        body.intake-mode .header { display: none !important; }
        body.intake-mode #linearFilmingPlansField { display: none !important; }
        body.onboarding-mode .header { display: none !important; }
        body.onboarding-mode #pageTop { display: none !important; }
        /* Pre-paint boot gate (tags set on <html> by the tiny script in
           <head> before any body markup exists — see the comment there).
           Together with the .onboarding-mode/.intake-mode rules above, these
           keep the wrong view from ever painting on special entries. */
        /* Onboarding forms are dark; the full theme is injected at mount
           (_obInjectStyles, var(--sv-misc-101216)) — pre-paint the same bg (on <html> so
           the canvas is dark even before <body> parses) so the light
           dashboard canvas never flashes behind the form. */
        html.boot-onboarding, html.boot-onboarding body { background: var(--sv-bg-101216); }
        html.boot-onboarding .header { display: none !important; }
        html.boot-onboarding #pageTop { display: none !important; }
        html.boot-onboarding-view .header, html.boot-onboarding-view #pageTop { display: none !important; }
        /* Intake is locked to the Linear page, which never shows the header
           and always hides #pageTop. */
        html.boot-intake .header { display: none !important; }
        html.boot-intake #pageTop { display: none !important; }
        /* Client share links (?c=): staff chrome must never paint. boot-client
           is a permanent document-owner lock, not a transient loader flag;
           verified client routing swaps only client-owned surfaces beneath it.
           (.header needs !important because its markup has inline display:grid.) */
        html.boot-client .header { display: none !important; }
        html.boot-client #pageTop { display: none; }
        /* Signed-out staff visit: the opaque sign-in gate covers from first
           paint instead of popping in after the app script evaluates
           (!important beats the overlay's inline display:none; the gate is
           lifted only once a staff identity is admitted). */
        html.boot-gate #staffGateOverlay { display: flex !important; }
        /* Below .staff-auth-overlay (9998): the sign-in card sits ON the cover. */
        #staffGateOverlay { position: fixed; inset: 0; z-index: 9990; display: none; align-items: center; justify-content: center; background: var(--bg, var(--sv-bg-f5f5f3)); }
        .staff-gate-inner { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding: 0 24px; }
        .staff-gate-inner img { width: 36px; height: 36px; border-radius: 8px; }
        .staff-gate-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--sv-fg-111); }
        .staff-gate-note { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.82rem; color: var(--sv-fg-888); max-width: 300px; line-height: 1.5; }
        .staff-gate-retry { margin-top: 4px; }
        /* Entry mode is the whole page, not a dialog over a page: the card sits
           directly on the gate's own ground, with no dimming and no second
           welcome line competing with it. */
        .staff-auth-overlay.is-entry { background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
        #staffGateOverlay.is-carded .staff-gate-inner { display: none; }
        /* Staff refresh landing on a non-home tab: suppress the hardcoded
           Analytics-active pill and the "Client Analytics" overview header,
           and pre-light the pill of the tab actually being restored.
           navTo()/render() remove the attribute when routing takes over. */
        html[data-boot-nav] #pageTop { display: none; }
        html[data-boot-nav] #headerNav .header-nav-btn.active { background: var(--white); color: var(--text-secondary); border-color: var(--border); }
        html[data-boot-nav="linear"] #navLinear, html[data-boot-nav="production"] #navProd,
        html[data-boot-nav="workload"] #navWorkload,
        html[data-boot-nav="calendar"] #navCalendar,
        html[data-boot-nav="templates"] #navTemplates, html[data-boot-nav="filming-plans"] #navFilmingPlans,
        html[data-boot-nav="tiktok-upload"] #navTiktokUpload,
        html[data-boot-nav="kasper"] #navKasper,
        html[data-boot-nav="sample-reviews"] #navSxr { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
        .view-tab-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 7px 20px; border: none; border-radius: 8px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem; font-weight: 600;
            cursor: pointer; color: var(--text-muted);
            background: transparent; transition: all 0.15s;
        }
        .view-tab-btn:hover { color: var(--text-secondary); }
        .view-tab-btn.active {
            background: var(--white); color: var(--text-primary);
            box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_1);
        }
        .brief-indicator {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--sv-bg-16a34a); display: inline-block; flex-shrink: 0;
        }

        .brief-cat-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--sv-bg-7c3aed); display: inline-block; flex-shrink: 0;
        }

        /* MR Brief: Overview */
        .mr-overview-wrap { display: flex; flex-direction: column; gap: 16px; }
        .mr-summary-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 14px; padding: 24px 28px;
            border-left: 3px solid var(--sv-border-7c3aed);
        }
        .mr-summary-eyebrow {
            display: flex; align-items: center; gap: 7px;
            font-size: 0.6rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.12em; color: var(--sv-fg-7c3aed); margin-bottom: 14px;
        }
        .mr-summary-body {
            font-size: 0.88rem; color: var(--text-secondary); line-height: 1.8;
            margin: 0;
        }

        /* MR Brief: shared elements */
        .mr-for-client {
            display: flex; flex-direction: column; gap: 5px;
            background: var(--sv-bg-faf5ff); border: 1px solid var(--sv-border-e9d5ff);
            border-left: 3px solid var(--sv-border-7c3aed);
            border-radius: 8px; padding: 10px 12px;
            font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55;
        }
        .mr-for-client-label {
            font-size: 0.58rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.1em; color: var(--sv-fg-6d28d9); display: block;
        }
        .mr-info-btn { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--border); background: var(--white); cursor: pointer; font-size: 0.65rem; font-weight: 800; color: var(--text-muted); transition: all 0.15s; flex-shrink: 0; font-family: 'Plus Jakarta Sans', serif; }
        .mr-info-btn:hover { border-color: var(--sv-border-7c3aed); color: var(--sv-fg-7c3aed); background: var(--sv-bg-faf5ff); }
        .mr-info-overlay { position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_45); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .mr-info-modal { background: var(--white); border-radius: 14px; max-width: 520px; width: 100%; max-height: 80vh; overflow-y: auto; box-shadow: 0 20px 60px var(--sv-shadow-rgba-0-0-0-0_2); }
        .mr-info-modal-head { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: var(--white); border-radius: 14px 14px 0 0; z-index: 1; }
        .mr-info-modal-title { font-size: 0.82rem; font-weight: 700; color: var(--text-primary); }
        .mr-info-modal-close { background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px; display: inline-flex; transition: color 0.15s; }
        .mr-info-modal-close:hover { color: var(--text-primary); }
        .mr-info-modal-body { padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; }
        .mr-info-reel { display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: var(--bg); border-radius: 8px; border: 1px solid var(--border); font-size: 0.78rem; }
        .mr-info-reel-handle { font-weight: 700; color: var(--text-primary); white-space: nowrap; }
        .mr-info-reel-views { font-size: 0.72rem; color: var(--text-muted); white-space: nowrap; }
        .mr-info-reel-link { margin-left: auto; flex-shrink: 0; }
        .mr-count-chip {
            font-size: 0.68rem; font-weight: 700; color: var(--text-muted);
            background: var(--bg); border-radius: 5px; padding: 2px 8px;
        }
        .mr-hook-type-badge {
            display: inline-flex; align-items: center;
            background: var(--sv-bg-eff6ff); border: 1px solid var(--sv-border-bfdbfe);
            border-radius: 5px; padding: 3px 9px;
            font-size: 0.61rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.06em;
            color: var(--sv-fg-1d4ed8); width: fit-content;
        }

        /* MR Brief: Filming Angles / Content Directions */
        .mr-angle-hook {
            font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);
            line-height: 1.5; font-style: italic; padding: 8px 12px;
            background: var(--bg); border-radius: 8px; border-left: 2px solid var(--sv-border-6c5ce7);
        }
        .mr-angle-based {
            font-size: 0.7rem; color: var(--text-muted); line-height: 1.5;
            margin-top: 2px;
        }
        .mr-angle-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 10px; padding: 14px 16px;
            display: flex; gap: 12px; align-items: flex-start;
        }
        .mr-angle-num {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 22px; height: 22px; border-radius: 6px;
            background: var(--text-primary); color: var(--white);
            font-size: 0.62rem; font-weight: 800; flex-shrink: 0; margin-top: 1px;
        }
        .mr-angle-content { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
        .mr-angle-title { font-size: 0.88rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
        .mr-why-now {
            font-size: 0.77rem; color: var(--text-muted); line-height: 1.5;
            border-top: 1px solid var(--border-light); padding-top: 10px;
        }
        .mr-why-now strong { color: var(--text-secondary); font-weight: 700; }

        /* MR Brief: The Gap */
        .mr-gap-card { border-left: 3px solid var(--sv-border-f59e0b); }
        .mr-gap-badge {
            display: inline-flex; align-items: center;
            background: var(--sv-bg-fffbeb); border: 1px solid var(--sv-border-fde68a);
            border-radius: 6px; padding: 3px 9px;
            font-size: 0.62rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.07em; color: var(--sv-fg-92400e); width: fit-content;
        }
        .mr-opportunity {
            background: var(--sv-bg-f0fdf4); border: 1px solid var(--sv-border-bbf7d0);
            border-left: 3px solid var(--sv-border-10b981);
            border-radius: 8px; padding: 10px 12px;
            font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55;
        }
        .mr-opportunity strong { color: var(--sv-fg-065f46); font-weight: 700; }

        /* MR generating spinner icon */
        .mr-generating-icon {
            width: 56px; height: 56px; display: flex; align-items: center;
            justify-content: center; background: var(--sv-bg-f5f3ff);
            border-radius: 50%; margin-bottom: 4px;
        }

        /* MR keyword panel */
        .mr-kw-panel {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 16px; padding: 24px; display: flex;
            flex-direction: column; gap: 16px;
            animation: fadeIn 0.15s ease;
        }
        .mr-kw-panel-header {
            display: flex; align-items: flex-start;
            justify-content: space-between; gap: 12px;
        }
        .mr-kw-panel-title {
            font-size: 0.96rem; font-weight: 700; color: var(--text-primary);
            letter-spacing: -0.01em;
        }
        .mr-kw-panel-sub {
            font-size: 0.78rem; color: var(--text-muted); margin-top: 3px;
        }
        .mr-kw-close {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--border);
            background: var(--bg); cursor: pointer; flex-shrink: 0;
            color: var(--text-muted); transition: all 0.12s;
        }
        .mr-kw-close:hover { border-color: var(--sv-border-bbb); color: var(--text-primary); }
        .mr-kw-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
        }
        @media (max-width: 520px) { .mr-kw-grid { grid-template-columns: 1fr; } }
        .mr-kw-field {
            display: flex; align-items: center; gap: 0;
            border: 1px solid var(--border); border-radius: 9px;
            background: var(--bg); overflow: hidden;
            transition: border-color 0.12s;
        }
        .mr-kw-field:focus-within {
            border-color: var(--sv-border-7c3aed);
            box-shadow: 0 0 0 3px var(--sv-shadow-rgba-124-58-237-0_08);
            background: var(--white);
        }
        .mr-kw-input {
            flex: 1; border: none; background: transparent; outline: none;
            padding: 9px 10px 9px 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem; color: var(--text-primary);
        }
        .mr-kw-input::placeholder { color: var(--text-muted); }
        .mr-kw-remove {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; flex-shrink: 0; border: none;
            background: transparent; cursor: pointer; color: var(--text-muted);
            transition: color 0.12s;
        }
        .mr-kw-remove:hover { color: var(--dn); }
        .mr-kw-add {
            display: inline-flex; align-items: center; gap: 6px;
            border: none; background: transparent; cursor: pointer;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem; font-weight: 600; color: var(--text-muted);
            padding: 0; transition: color 0.12s; width: fit-content;
        }
        .mr-kw-add:hover { color: var(--sv-fg-7c3aed); }
        .mr-kw-count {
            font-size: 0.68rem; font-weight: 700;
            background: var(--bg); border: 1px solid var(--border);
            border-radius: 4px; padding: 1px 5px;
        }
        .mr-kw-count-note {
            font-size: 0.72rem; color: var(--text-muted);
        }
        .mr-kw-actions {
            display: flex; align-items: center; justify-content: flex-end;
            gap: 8px; padding-top: 4px; border-top: 1px solid var(--border-light);
        }
        .mr-kw-submit {
            min-width: 160px; justify-content: center;
        }

        .brief-wrap { animation: fadeIn 0.15s ease; }
        .brief-meta-bar {
            display: flex; align-items: flex-start; justify-content: space-between;
            gap: 12px; margin-bottom: 20px;
            background: var(--white); border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 18px;
        }
        .brief-meta-left { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
        .brief-meta-eyebrow {
            font-size: 0.6rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.12em; color: var(--text-muted);
        }
        .brief-meta-date { font-size: 0.9rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
        .brief-meta-sub { font-size: 0.74rem; color: var(--text-muted); margin-top: 1px; }
        .brief-meta-subtle { font-size: 0.68rem; color: var(--text-muted); font-weight: 500; opacity: 0.7; }
        .brief-regen-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 32px; height: 32px; border-radius: 8px;
            border: 1px solid var(--border); background: var(--white);
            color: var(--text-muted); cursor: pointer; transition: all 0.15s;
        }
        .brief-regen-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-secondary); }
        .brief-tab-header {
            display: flex; align-items: center; justify-content: space-between;
            gap: 8px; margin-bottom: 12px;
        }
        .brief-tab-header .brief-section-tabs { margin-bottom: 0; }
        .brief-tab-header-right {
            display: flex; align-items: center; gap: 6px; flex-shrink: 0;
        }
        .brief-info-btn {
            width: 24px; height: 24px; border-radius: 50%;
            border: 1px solid var(--border); background: var(--white);
            font-size: 0.7rem; font-weight: 700; font-style: italic;
            color: var(--text-muted); cursor: pointer; font-family: serif;
            display: inline-flex; align-items: center; justify-content: center;
            transition: all 0.15s;
        }
        .brief-info-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-secondary); }
        .brief-info-panel {
            display: none; flex-wrap: wrap; align-items: center; gap: 10px;
            padding: 10px 14px; margin-bottom: 12px;
            background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
        }
        .brief-info-panel .brief-method-chip { padding: 6px 10px; }
        .brief-info-panel .brief-method-chip-label { font-size: 0.52rem; }
        .brief-info-panel .brief-method-chip-val { font-size: 0.76rem; }
        .brief-wrap[data-show-info] .brief-info-panel { display: flex; }
        .brief-tab-summary {
            font-size: 0.82rem; color: var(--sv-fg-7c3aed); font-weight: 600; line-height: 1.6;
            margin-bottom: 16px;
        }
        .brief-tab-summary.loading {
            color: var(--text-muted); font-style: italic;
        }
        .general-brief-card {
            background: transparent; border: none;
            border-radius: 0; padding: 8px 0;
            margin-bottom: 20px;
        }
        .general-brief-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 12px; gap: 12px;
        }
        .general-brief-title {
            font-size: 1.05rem; font-weight: 800; color: var(--text-primary);
            letter-spacing: -0.02em;
        }
        .general-brief-bullets {
            margin: 0; padding: 0 0 0 18px;
            list-style: none;
        }
        .general-brief-bullets li {
            font-size: 0.82rem; color: var(--text-primary); line-height: 1.65;
            padding: 5px 0; position: relative; padding-left: 6px;
        }
        .general-brief-bullets li::before {
            content: '▸'; position: absolute; left: -16px;
            color: var(--text-muted); font-size: 0.7rem; top: 6px;
        }
        .general-brief-sections { display: flex; flex-direction: column; gap: 14px; }
        .general-brief-section { display: flex; gap: 10px; align-items: flex-start; }
        .general-brief-section-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; margin-top: 1px; }
        .general-brief-section-label { font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 3px; }
        .general-brief-section-body { font-size: 0.82rem; color: var(--text-primary); line-height: 1.6; }
        .general-brief-generate {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px; border-radius: 9px;
            background: var(--bg); border: 1px solid var(--border);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem; font-weight: 600; color: var(--text-secondary);
            cursor: pointer; transition: all 0.15s;
        }
        .general-brief-generate:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .general-brief-generate:disabled { opacity: 0.5; cursor: not-allowed; }
        .brief-meta-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
        .brief-date-select {
            -webkit-appearance: none; appearance: none;
            border: 1px solid var(--border); border-radius: 8px;
            padding: 7px 30px 7px 12px; background: var(--bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem; font-weight: 600; color: var(--text-primary);
            cursor: pointer; outline: none; transition: border-color 0.15s;
            background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23b4b4ae' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
            background-repeat: no-repeat; background-position: right 10px center;
        }
        .brief-date-select:hover { border-color: var(--sv-border-aaa); }
        .brief-action-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border);
            background: var(--white); font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem; font-weight: 600; color: var(--text-secondary);
            cursor: pointer; transition: all 0.15s; white-space: nowrap;
        }
        .brief-action-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .brief-action-btn.primary {
            background: var(--text-primary); color: var(--white); border-color: var(--text-primary);
        }
        .brief-action-btn.primary:hover { background: var(--sv-bg-333); border-color: var(--sv-border-333); }

        /* Confirmation modal overlay */
        .confirm-overlay {
            display: none; position: fixed; inset: 0; z-index: 9999;
            background: var(--sv-bg-rgba-0-0-0-0_35); backdrop-filter: blur(2px);
            align-items: center; justify-content: center;
        }
        .confirm-overlay.active { display: flex; }
        .confirm-box {
            background: var(--white); border-radius: 14px; padding: 28px 32px 24px;
            max-width: 380px; width: 90%; box-shadow: 0 20px 60px var(--sv-shadow-rgba-0-0-0-0_18);
            text-align: center;
        }
        .confirm-box-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
        .confirm-box-msg { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 20px; }
        .confirm-box-actions { display: flex; gap: 10px; justify-content: center; }
        .confirm-box-check { display: flex; align-items: center; justify-content: center; gap: 7px; margin: -8px 0 18px;
            font-size: 0.76rem; color: var(--text-muted); cursor: pointer; }
        .confirm-box-check[hidden] { display: none; }
        .confirm-box-check input { cursor: pointer; }

        /* Resolve-and-route chooser — wider, left-aligned (it can carry a
           change-request checklist), with a corner ✕ and a 3-up route row. */
        .resolve-dest-box { position: relative; max-width: 430px; text-align: left; }
        .resolve-dest-box .confirm-box-title,
        .resolve-dest-box .confirm-box-msg { text-align: left; }
        .resolve-dest-close { position: absolute; top: 11px; right: 11px; width: 26px; height: 26px;
            display: inline-flex; align-items: center; justify-content: center; padding: 0;
            border: none; border-radius: 50%; background: var(--bg); color: var(--text-muted); cursor: pointer; }
        .resolve-dest-close:hover { background: var(--border); color: var(--text-primary); }
        .resolve-dest-close svg { width: 13px; height: 13px; }
        .resolve-dest-checklist { display: flex; flex-direction: column; gap: 9px; margin: 0 0 18px;
            max-height: 190px; overflow-y: auto; padding: 2px 2px 2px 0; }
        .resolve-dest-checklist[hidden] { display: none; }
        .resolve-dest-check { display: flex; align-items: flex-start; gap: 9px; font-size: 0.78rem;
            color: var(--text-secondary); line-height: 1.4; cursor: pointer; }
        .resolve-dest-check input { margin: 2px 0 0; cursor: pointer; flex-shrink: 0; }
        .resolve-dest-check .rd-round { font-weight: 700; color: var(--text-primary); }
        .resolve-dest-actions { flex-wrap: wrap; }
        .resolve-dest-actions .brief-action-btn { flex: 1 1 auto; justify-content: center; }
        /* "Mark done — don't change the status": resolve without routing. A quiet
           secondary action, set apart from the three send-routes (it isn't a
           route — it's the absence of one). */
        .resolve-dest-stay { display: block; width: 100%; margin: 12px 0 0; padding: 7px 8px;
            border: none; background: none; font-family: inherit; font-size: 0.76rem; font-weight: 600;
            color: var(--text-muted); cursor: pointer; text-align: center; border-radius: 8px; }
        .resolve-dest-stay:hover { background: var(--bg); color: var(--text-secondary); }
        .resolve-dest-stay[hidden] { display: none; }

        .brief-section-tabs {
            display: flex; gap: 0; overflow-x: auto; flex-wrap: nowrap;
            border-bottom: 2px solid var(--border); margin-bottom: 20px;
            scrollbar-width: none;
        }
        .brief-section-tabs::-webkit-scrollbar { display: none; }
        .brief-section-tab {
            padding: 9px 16px; border: none; background: transparent;
            font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem;
            font-weight: 600; color: var(--text-muted); cursor: pointer;
            white-space: nowrap; border-bottom: 2px solid transparent;
            margin-bottom: -2px; transition: all 0.15s;
        }
        .brief-section-tab:hover { color: var(--text-secondary); }
        .brief-section-tab.active { color: var(--text-primary); border-bottom-color: var(--text-primary); }

        .brief-cards-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px;
        }
        .brief-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 9px;
        }
        .brief-card-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: var(--bg); border-radius: 6px; padding: 3px 9px;
            font-size: 0.62rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.07em; color: var(--text-muted); width: fit-content;
        }
        .brief-card-label {
            font-size: 0.94rem; font-weight: 700; color: var(--text-primary);
            letter-spacing: -0.01em; line-height: 1.3;
        }
        .brief-card-section-label {
            font-size: 0.62rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.09em; color: var(--text-muted);
        }
        .brief-card-body { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.6; }
        .brief-card-sub {
            font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55;
            border-top: 1px solid var(--border-light); padding-top: 10px; margin-top: 2px;
        }
        .brief-card-sub strong { color: var(--text-primary); font-weight: 700; }
        .brief-card-accent { border-left: 3px solid var(--sv-border-6c5ce7); padding-left: 12px; }

        .brief-exec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        @media (max-width: 600px) { .brief-exec-grid { grid-template-columns: 1fr; } }
        .brief-exec-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 10px;
        }
        .brief-exec-card.full-width { grid-column: 1 / -1; }
        .brief-exec-card-eyebrow {
            display: flex; align-items: center; gap: 8px;
            font-size: 0.63rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.1em; color: var(--text-muted);
        }
        .brief-exec-card-icon { font-size: 1rem; }
        .brief-exec-card-body { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.65; }
        .brief-action-list { display: flex; flex-direction: column; gap: 8px; }
        .brief-action-item {
            display: flex; align-items: flex-start; gap: 10px;
            font-size: 0.83rem; color: var(--text-secondary); line-height: 1.5;
        }
        .brief-action-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 19px; height: 19px; border-radius: 50%; background: var(--text-primary);
            color: var(--white); font-size: 0.6rem; font-weight: 800; flex-shrink: 0; margin-top: 1px;
        }

        .source-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 10px; padding: 12px 16px; display: flex; flex-direction: column; gap: 6px;
        }
        .source-card-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
        .source-card-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .source-rank-badge {
            display: inline-flex; align-items: center; justify-content: center;
            width: 22px; height: 22px; border-radius: 6px;
            background: var(--bg); font-size: 0.6rem; font-weight: 800;
            color: var(--text-muted); flex-shrink: 0;
        }
        .source-handle { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); }
        .source-views-badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.78rem; font-weight: 700; color: var(--text-primary);
            white-space: nowrap; flex-shrink: 0;
        }
        .source-views-badge svg { color: var(--text-muted); }
        .source-meta-row {
            display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        }
        .source-outlier-pill {
            display: inline-flex; align-items: center; gap: 3px;
            font-size: 0.65rem; font-weight: 700; color: var(--text-muted);
            background: var(--bg); border-radius: 4px; padding: 2px 7px;
        }
        .source-outlier-pill.strong { color: var(--sv-fg-7c3aed); background: var(--sv-bg-f3f0ff); }
        .source-outlier-pill.mega { color: var(--sv-fg-dc2626); background: var(--sv-bg-fef2f2); }
        .source-link {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 0.75rem; font-weight: 600; color: var(--text-secondary);
            text-decoration: none; background: var(--bg); border-radius: 6px;
            padding: 5px 10px; transition: all 0.15s; width: fit-content;
        }
        .source-link:hover { color: var(--text-primary); background: var(--border); }
        .brief-methodology-bar {
            display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px;
        }
        .brief-method-chip {
            display: flex; flex-direction: column; gap: 2px;
            background: var(--white); border: 1px solid var(--border);
            border-radius: 9px; padding: 9px 14px;
        }
        .brief-method-chip-label {
            font-size: 0.58rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.09em; color: var(--text-muted);
        }
        .brief-method-chip-val { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); }

        .hook-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 12px; overflow: hidden;
            display: flex; flex-direction: column;
        }
        .hook-card-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 18px 0;
        }
        .hook-card-views {
            font-size: 0.78rem; font-weight: 700; color: var(--text-secondary);
            display: inline-flex; align-items: center; gap: 4px;
        }
        .hook-card-views svg { color: var(--text-muted); }
        .hook-card-body { padding: 10px 18px 16px; flex: 1; }
        .hook-text {
            font-size: 0.9rem; font-weight: 600; color: var(--text-primary);
            line-height: 1.55;
        }
        .hook-card-meta {
            display: flex; align-items: center; gap: 8px; margin-top: 12px; flex-wrap: wrap;
        }
        .hook-type-label {
            font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.04em; color: var(--text-muted);
        }
        .hook-eye-btn-inline {
            display: inline-flex; align-items: center; justify-content: center;
            width: 22px; height: 22px; border-radius: 5px;
            border: none; background: transparent;
            color: var(--text-muted); cursor: pointer; transition: all 0.13s;
            flex-shrink: 0; padding: 0;
        }
        .hook-eye-btn-inline:hover { color: var(--sv-fg-7c3aed); background: var(--sv-bg-faf5ff); }
        .hook-formula-pill {
            font-size: 0.75rem; font-weight: 500; color: var(--text-muted);
            line-height: 1.45; margin-top: 10px; font-style: italic;
        }
        .hook-formula-pill strong { color: var(--text-secondary); margin-right: 3px; font-weight: 600; font-style: normal; }
        .hook-steal-wrap {
            padding: 12px 18px 14px; border-top: 1px solid var(--border-light);
        }
        .hook-steal-label {
            font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 5px;
        }
        .hook-steal-text { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55; }
        .hook-template-text {
            font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55;
        }
        .hook-template-bracket {
            display: inline; background: var(--sv-bg-f3f0ff); border: 1px solid var(--sv-border-ddd6fe);
            border-radius: 4px; padding: 1px 5px; font-size: 0.77rem; font-weight: 700;
            color: var(--sv-fg-6d28d9); font-style: normal;
        }
        .hook-card-actions {
            display: flex; align-items: center; justify-content: flex-end;
            padding: 10px 18px 12px; border-top: 1px solid var(--border-light);
            margin-top: auto;
        }
        .hook-add-btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 11px; border-radius: 7px; border: 1px solid var(--border);
            background: var(--white); font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.71rem; font-weight: 700; color: var(--text-secondary);
            cursor: pointer; transition: all 0.13s; white-space: nowrap;
        }
        .hook-add-btn:hover { border-color: var(--sv-border-7c3aed); color: var(--sv-fg-5b21b6); background: var(--sv-bg-faf5ff); }
        .hook-add-btn.saved { border-color: var(--sv-border-10b981); color: var(--sv-fg-065f46); background: var(--sv-bg-f0fdf4); cursor: default; }
        .hook-add-btn svg { flex-shrink: 0; }

        /* Transcript modal */
        .transcript-overlay {
            display: none; position: fixed; inset: 0; z-index: 9998;
            background: var(--sv-bg-rgba-0-0-0-0_4); backdrop-filter: blur(3px);
            align-items: center; justify-content: center;
        }
        .transcript-overlay.active { display: flex; }
        .transcript-modal {
            background: var(--white); border-radius: 16px; padding: 0;
            max-width: 560px; width: 92%; max-height: 80vh;
            box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_2);
            display: flex; flex-direction: column; overflow: hidden;
        }
        .transcript-modal-header {
            display: flex; align-items: flex-start; justify-content: space-between;
            gap: 12px; padding: 20px 24px 16px; border-bottom: 1px solid var(--border-light);
        }
        .transcript-modal-title {
            font-size: 0.84rem; font-weight: 700; color: var(--text-primary);
            letter-spacing: -0.01em;
        }
        .transcript-modal-meta {
            font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;
        }
        .transcript-modal-close {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--border);
            background: var(--bg); cursor: pointer; color: var(--text-muted);
            transition: all 0.12s; flex-shrink: 0;
        }
        .transcript-modal-close:hover { border-color: var(--sv-border-bbb); color: var(--text-primary); }
        .transcript-modal-body {
            overflow-y: auto; padding: 20px 24px; flex: 1;
        }
        .transcript-modal-body p {
            font-size: 0.84rem; color: var(--text-secondary); line-height: 1.75;
            margin: 0;
        }
        .transcript-modal-body .no-transcript {
            font-size: 0.8rem; color: var(--text-muted); font-style: italic;
            padding: 12px 0;
        }

        .comment-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 12px; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px;
        }
        .comment-text {
            font-size: 0.88rem; font-style: italic; color: var(--text-primary);
            line-height: 1.55; border-left: 3px solid var(--ig-mid);
            padding-left: 12px; margin-left: 2px;
        }
        .comment-insight { display: flex; flex-direction: column; gap: 4px; }
        .comment-insight-label {
            font-size: 0.59rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.09em; color: var(--text-muted);
        }
        .comment-insight-body { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5; }
        .brief-patterns-grid { margin-top: 8px; }
        .brief-pattern-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 10px; padding: 14px 16px;
            display: flex; flex-direction: column; gap: 6px;
        }
        .brief-pattern-label { font-size: 0.88rem; font-weight: 700; color: var(--text-primary); }
        .brief-pattern-body { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5; }
        .brief-pattern-action {
            font-size: 0.78rem; font-weight: 600; color: var(--up);
            display: flex; align-items: center; gap: 5px; padding-top: 4px;
        }

        .brief-generate-prompt {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 16px; padding: 56px 32px;
            text-align: center; display: flex; flex-direction: column;
            align-items: center; gap: 12px;
        }
        .brief-prompt-icon { font-size: 2.2rem; margin-bottom: 4px; }
        .brief-prompt-title {
            font-size: 1.15rem; font-weight: 800; color: var(--text-primary);
            letter-spacing: -0.02em;
        }
        .brief-prompt-sub {
            font-size: 0.83rem; color: var(--text-muted);
            max-width: 360px; line-height: 1.6;
        }
        .brief-gen-btn-lg {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 26px; border-radius: 10px; margin-top: 8px;
            background: var(--text-primary); color: var(--white);
            border: none; font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.88rem; font-weight: 700; cursor: pointer;
            transition: all 0.15s; letter-spacing: -0.01em;
        }
        .brief-gen-btn-lg:hover { background: var(--sv-bg-333); transform: translateY(-1px); box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_15); }
        .brief-gen-btn-lg:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
        .brief-loading-wrap {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 16px; padding: 56px 32px;
            text-align: center; display: flex; flex-direction: column;
            align-items: center; gap: 14px;
        }
        .brief-loading-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); }
        .brief-loading-sub { font-size: 0.82rem; color: var(--text-muted); max-width: 320px; line-height: 1.55; }
        .brief-loading-poll { font-size: 0.72rem; color: var(--text-muted); font-style: italic; }
        .brief-progress-dots { display: flex; gap: 7px; margin: 6px 0; }
        .brief-progress-dot {
            width: 8px; height: 8px; border-radius: 50%; background: var(--border);
            animation: briefDotPulse 1.5s ease-in-out infinite;
        }
        .brief-progress-dot:nth-child(2) { animation-delay: 0.2s; }
        .brief-progress-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes briefDotPulse {
            0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
            40% { opacity: 1; transform: scale(1); background: var(--text-primary); }
        }
        .brief-section-header {
            font-size: 0.65rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 12px;
            margin-top: 20px; padding-bottom: 8px; border-bottom: 1px solid var(--border-light);
        }
        .brief-section-header:first-child { margin-top: 0; }

        /* Header nav */
        .header-nav { display: flex; align-items: center; gap: 6px; width: max-content; max-width: 100%; min-width: 0; justify-self: center; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; position: relative; }
        .header-nav::-webkit-scrollbar { display: none; }
        .header-nav-btn { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--white); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; text-decoration: none; white-space: nowrap; position: relative; z-index: 1; }
        @media (min-width: 761px) and (max-width: 1400px) {
            .header { padding-left: 18px; padding-right: 18px; }
            .header-nav { gap: 4px; }
            .header-nav-btn { gap: 5px; padding-left: 10px; padding-right: 10px; font-size: 0.75rem; }
            .header-actions { gap: 6px; }
        }
        .header-nav-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); background: var(--bg); }
        .header-nav-btn.active { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
        .header-nav-btn svg { flex-shrink: 0; }
        /* Owner-designed tab icons (2026-08-21).

           They ship as PNG, and a PNG cannot inherit currentColor the way the
           inline glyphs it replaced did -- an icon baked in one colour goes
           invisible on the light strip or on the near-black active pill,
           whichever it was not drawn for. So the artwork is used as a MASK and
           the colour comes from `currentColor`: the shape is the owner's, the
           fill is whatever the label beside it already is. Light theme, dark
           theme and the active pill are then correct by construction, with one
           asset per tab and no second set to keep in sync.

           `background-color` paints through the mask, so the span needs no
           content; every tab is a void <span> because a <div> inside #headerNav
           truncates the nav extractor test/samples-legacy-retirement.js uses.
           Sized 16px where the old glyphs were 14 because these shapes carry
           their own padding. */
        .header-nav-btn .header-nav-ico {
            flex-shrink: 0; width: 16px; height: 16px; display: block;
            background-color: currentColor;
            -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
            -webkit-mask-position: center; mask-position: center;
            -webkit-mask-size: contain; mask-size: contain;
        }
        .header-nav-btn .ico-analytics { -webkit-mask-image: url('nav-icons/analytics.png'); mask-image: url('nav-icons/analytics.png'); }
        .header-nav-btn .ico-synclinear { -webkit-mask-image: url('nav-icons/synclinear.png'); mask-image: url('nav-icons/synclinear.png'); }
        .header-nav-btn .ico-submit { -webkit-mask-image: url('nav-icons/submit.png'); mask-image: url('nav-icons/submit.png'); }
        .header-nav-btn .ico-templates { -webkit-mask-image: url('nav-icons/templates.png'); mask-image: url('nav-icons/templates.png'); }
        .header-nav-btn .ico-filmingplans { -webkit-mask-image: url('nav-icons/filming-plans.png'); mask-image: url('nav-icons/filming-plans.png'); }
        .header-nav-btn .ico-workload { -webkit-mask-image: url('nav-icons/workload.png'); mask-image: url('nav-icons/workload.png'); }
        .header-nav-btn .ico-calendar { -webkit-mask-image: url('nav-icons/calendar.png'); mask-image: url('nav-icons/calendar.png'); }
        .header-nav-btn .ico-samples { -webkit-mask-image: url('nav-icons/samples.png'); mask-image: url('nav-icons/samples.png'); }
        .header-nav-btn .ico-tiktok { -webkit-mask-image: url('nav-icons/tiktok.png'); mask-image: url('nav-icons/tiktok.png'); }
        /* Sliding active pill.
           The pill is an absolutely-positioned sibling INSIDE #headerNav, so the
           buttons stay direct children (the active-tab scrollIntoView and the
           wired nav suites both key on `#headerNav > .header-nav-btn`). Because
           #headerNav is the scroll container AND the offset parent, the pill
           lives in the same scrolled coordinate space as the buttons and tracks
           horizontal scrolling for free — no scrollLeft bookkeeping.
           Pre-JS the per-button .active background is still the highlight (see
           the data-boot-nav block above), so a cold boot never flashes an
           unpositioned pill: #headerNav only gets .pill-ready once JS has
           measured and parked it, and every pill rule is additionally scoped to
           html:not([data-boot-nav]) so the pre-paint route highlight always wins. */
        .header-nav-pill { position: absolute; top: 0; left: 0; width: 0; height: 0; border-radius: 8px; background: var(--text-primary); opacity: 0; pointer-events: none; z-index: 0; transition: transform 0.34s cubic-bezier(0.22, 0.61, 0.36, 1), width 0.34s cubic-bezier(0.22, 0.61, 0.36, 1); }
        html:not([data-boot-nav]) #headerNav.pill-ready .header-nav-pill { opacity: 1; }
        html:not([data-boot-nav]) #headerNav.pill-ready .header-nav-btn { background: transparent; border-color: transparent; }
        html:not([data-boot-nav]) #headerNav.pill-ready .header-nav-btn:hover { background: var(--bg); border-color: var(--sv-border-aaa); color: var(--text-primary); }
        html:not([data-boot-nav]) #headerNav.pill-ready .header-nav-btn.active { background: transparent; border-color: transparent; color: var(--white); }
        html:not([data-boot-nav]) #headerNav.pill-ready .header-nav-btn.active:hover { background: transparent; border-color: transparent; color: var(--white); }
        @media (prefers-reduced-motion: reduce) { .header-nav-pill { transition: none; } }

        /* Linear form */
        .linear-view { max-width: 620px; margin: 0 auto; animation: fadeIn 0.15s ease; }
        .linear-form-title { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 6px; }
        .linear-form-sub { font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 28px; }
        .linear-form { display: flex; flex-direction: column; gap: 18px; }
        .linear-field { display: flex; flex-direction: column; gap: 6px; }
        .linear-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
        .linear-input, .linear-select, .linear-textarea { width: 100%; padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border); background: var(--white); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--text-primary); transition: border-color 0.15s, box-shadow 0.15s; outline: none; }
        .linear-input:focus, .linear-select:focus, .linear-textarea:focus { border-color: var(--sv-border-aaa); box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_06); }
        .linear-input::placeholder, .linear-textarea::placeholder { color: var(--text-muted); font-weight: 400; }
        .linear-textarea { min-height: 80px; resize: vertical; }
        .linear-select { cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23b4b4ae' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 14px center; padding-right: 36px; }
        .linear-link-wrap { position: relative; }
        .linear-link-suggestion { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; padding: 8px 14px; font-size: 0.8rem; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; z-index: 10; box-shadow: 0 4px 12px var(--sv-shadow-rgba-0-0-0-0_08); display: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .linear-link-suggestion:hover { border-color: var(--sv-border-aaa); background: var(--bg); color: var(--text-primary); }
        .linear-link-suggestion.visible { display: block; }
        .linear-link-suggestion-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 3px; }
        .linear-videos-section { display: flex; flex-direction: column; gap: 12px; }
        .linear-video-card { background: var(--white); border: 1.5px solid var(--border); border-radius: 12px; padding: 14px 16px; }
        .linear-video-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
        .linear-video-num { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); }
        .linear-video-remove { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 6px; border: none; background: transparent; cursor: pointer; color: var(--text-muted); transition: all 0.13s; opacity: 0; }
        .linear-video-remove:hover { background: var(--dn-bg); color: var(--dn); }
        .linear-video-card:hover .linear-video-remove { opacity: 1; }
        .linear-title-display { padding: 10px 14px; border-radius: 10px; border: 1.5px solid var(--border-light); background: var(--bg); font-size: 0.85rem; font-weight: 600; color: var(--text-primary); min-height: 42px; display: flex; align-items: center; }
        .linear-title-display.empty { color: var(--text-muted); font-weight: 400; font-style: italic; }
        /* Read-only filming-plan display: auto-filled from the filming_plans source,
           mirrors the Title field. Long doc URLs wrap rather than overflow. */
        #linearFilmingPlansDisplay { word-break: break-all; overflow-wrap: anywhere; font-weight: 500; font-size: 0.8rem; line-height: 1.4; }
        .linear-title-display.warn { color: var(--sv-fg-b45309); font-weight: 600; font-style: normal; }
        .video-link-hint { font-size: 0.65rem; color: var(--text-muted); opacity: 0.7; white-space: nowrap; position: absolute; bottom: 12px; left: 16px; pointer-events: none; }
        .linear-video-card { position: relative; padding-bottom: 30px; }
        .linear-video-fields { display: flex; flex-direction: column; gap: 8px; }
        /* Per-video notes. Shorter than the batch-level box (.linear-textarea is
           80px) because it sits inside a card that already carries three inputs,
           but still multi-line and drag-resizable like its bigger sibling. */
        .linear-video-notes { min-height: 62px; }
        .linear-video-field-row { display: flex; gap: 8px; }
        .linear-video-field-row .linear-input { flex: 1; padding: 9px 12px; font-size: 0.8rem; }
        .linear-add-video-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 10px; border: 1.5px dashed var(--border); background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--text-muted); cursor: pointer; transition: all 0.15s; align-self: flex-start; }
        .linear-add-video-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-secondary); background: var(--white); }
        .linear-submit-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 28px; border-radius: 10px; border: none; background: var(--text-primary); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.88rem; font-weight: 700; color: var(--white); cursor: pointer; transition: all 0.15s; align-self: flex-start; margin-top: 4px; }
        .linear-submit-btn:hover { background: var(--sv-bg-333); }
        .linear-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .linear-submit-btn.secondary { background: transparent; color: var(--text-primary); border: 1.5px solid var(--text-primary); }
        .linear-submit-btn.secondary:hover { background: var(--text-primary); color: var(--white); }
        .linear-submit-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
        .linear-submit-btn.success { background: var(--up); }
        .linear-submit-primary { padding: 14px 28px; flex-direction: row; gap: 12px; }
        .linear-submit-primary-text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.15; }
        .linear-submit-primary-label { font-size: 0.92rem; font-weight: 700; }
        .linear-submit-primary-sub { font-size: 0.66rem; font-weight: 500; opacity: 0.65; letter-spacing: 0.02em; margin-top: 2px; }
        .linear-advanced { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; align-self: flex-start; }
        .linear-advanced-toggle { display: inline-flex; align-items: center; gap: 6px; padding: 4px 2px; border: none; background: transparent; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; transition: color 0.15s; align-self: flex-start; }
        .linear-advanced-toggle:hover { color: var(--text-secondary); }
        .linear-advanced-toggle .chevron { transition: transform 0.18s ease; }
        .linear-advanced-toggle.open .chevron { transform: rotate(90deg); }
        .linear-advanced-panel { display: none; flex-wrap: wrap; gap: 8px; }
        .linear-advanced-panel.open { display: flex; animation: fadeIn 0.15s ease; }
        .linear-advanced-panel .linear-submit-btn { padding: 9px 18px; font-size: 0.78rem; font-weight: 600; margin-top: 0; }
        .linear-status { font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px; }
        .linear-success-banner { display: flex; align-items: center; gap: 8px; background: var(--sv-bg-1a3a2a); border: 1px solid var(--sv-border-2d6a45); color: var(--sv-fg-4ade80); border-radius: 10px; padding: 12px 16px; font-size: 0.88rem; font-weight: 600; margin-bottom: 20px; animation: fadeIn 0.2s ease; }
        /* Linear search bar */
        .linear-search-wrap { position: relative; }
        .linear-search-pill { display: flex; align-items: center; background: var(--white); border: 1.5px solid var(--border); border-radius: 99px; padding: 0 14px 0 20px; gap: 10px; width: 100%; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_07); transition: border-color 0.18s, box-shadow 0.18s; }
        .linear-search-pill:focus-within { border-color: var(--sv-border-aaa); box-shadow: 0 4px 18px var(--sv-shadow-rgba-0-0-0-0_11); }
        .linear-search-input { flex: 1; border: none; outline: none; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--text-primary); padding: 11px 0; min-width: 0; }
        .linear-search-input::placeholder { color: var(--text-muted); font-weight: 400; }
        .linear-search-ghost { position: absolute; top: 0; left: 20px; right: 14px; pointer-events: none; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 500; white-space: nowrap; overflow: hidden; display: flex; align-items: center; height: 100%; color: transparent; }
        .linear-search-dropdown { position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--white); border-radius: 16px; box-shadow: 0 8px 32px var(--sv-shadow-rgba-0-0-0-0_13); padding: 6px; z-index: 60; opacity: 0; transform: translateY(-6px) scale(0.99); pointer-events: none; transition: all 0.16s ease; transform-origin: top center; max-height: 280px; overflow-y: auto; }
        .linear-search-dropdown.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
        .linear-search-suggestion { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; cursor: pointer; transition: background 0.1s; font-size: 0.82rem; font-weight: 500; color: var(--text-secondary); }
        .linear-search-suggestion:hover { background: var(--bg); color: var(--text-primary); }
        .linear-search-suggestion .s-match { color: var(--text-primary); font-weight: 700; }
        .linear-search-empty { padding: 12px; font-size: 0.78rem; color: var(--text-muted); font-style: italic; text-align: center; }
        .linear-search-loading { padding: 12px; font-size: 0.78rem; color: var(--text-muted); text-align: center; }

        /* Production preview (Track B B2) - hidden unless ?prod=1. */
        .prod-view, .prod-layer, .prod-tip, .prod-toast, .prod-cmd-bd { --prod-bg:#f3f3f4; --prod-content:#fcfcfd; --prod-surface:#ffffff; --prod-column:#f6f6f7; --prod-hover:#ebebec; --prod-selected-nav:#e5e5e6; --prod-selected:#eaebf6; --prod-menu-hover:#f3f3f3; --prod-border:#d5d5d5; --prod-border-soft:#e8e8e8; --prod-divider:#ececed; --prod-text:#1b1b1b; --prod-strong:#2e2e30; --prod-dim:#5a5a5c; --prod-muted:#5d5d5f; --prod-faint:#9a9aa0; --prod-accent:#5e6ad2; --prod-link:#4162db; --prod-danger:#d64b4b; --prod-overdue:#c0574e; --prod-prop-label:#5e5e60; --prod-shadow-pop:0 6px 18px rgba(0,0,0,.03), 0 3px 9px rgba(0,0,0,.05), 0 1px 3px rgba(0,0,0,.08); --prod-st-backlog:#a4a8ae; --prod-st-todo:#a8a8a8; --prod-st-in-progress:#c6a333; --prod-st-smm-approval:#ed86bc; --prod-st-kasper-approval:#eb5757; --prod-st-tweak:#db6e1f; --prod-st-client-approval:#ff0016; --prod-st-approved:#43bc58; --prod-st-scheduled:#0044ff; --prod-st-posted:#5e6ad2; --prod-st-canceled:#95a2b3; --prod-st-duplicate:#95a2b3; --prod-st-triage:#f2994a; }
        html[data-theme="dark"] .prod-view, html[data-theme="dark"] .prod-layer, html[data-theme="dark"] .prod-tip, html[data-theme="dark"] .prod-toast, html[data-theme="dark"] .prod-cmd-bd { --prod-bg:#070708; --prod-content:#0c0c0d; --prod-surface:#151518; --prod-column:#111113; --prod-hover:#1e1e21; --prod-selected-nav:#1e1e21; --prod-selected:#171923; --prod-menu-hover:#1e1e21; --prod-border:#2a2a2d; --prod-border-soft:#242428; --prod-divider:#1d1d20; --prod-text:#f4f4f5; --prod-strong:#ededee; --prod-dim:#b6b6bb; --prod-muted:#8f8f96; --prod-faint:#6f6f78; --prod-accent:#5e6ad2; --prod-link:#8ea0ff; --prod-danger:#ff5f5f; --prod-overdue:#ff5f5f; --prod-prop-label:#b6b6bb; --prod-shadow-pop:0 14px 32px rgba(0,0,0,.42), 0 3px 12px rgba(0,0,0,.34), 0 0 0 1px rgba(255,255,255,.03); }
        /* Production owns the viewport below the 60px sticky header: the page
           body must NEVER scroll here — only .prod-listwrap / .prod-detail-main
           do. The previous geometry assumed a 64px header and cancelled only
           24px of .main's `32px 32px 80px` padding, leaving ~84px of phantom
           page height, a second (outer) scrollbar, and a scroll position that
           re-clamped to the top on every innerHTML rebuild. body.prod-page is
           toggled in navTo()/render(). */
        body.prod-page { overflow: hidden; }
        body.prod-page .main { padding: 0; }
        .prod-view { height: calc(100vh - 60px); margin: 0; background: var(--prod-bg); color: var(--prod-text); font-family: "Inter Variable", "SF Pro Display", "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; display: flex; overflow: hidden; }
        .prod-side { width: 244px; flex: 0 0 244px; border-right: 1px solid var(--prod-divider); padding: 12px; display: flex; flex-direction: column; gap: 16px; }
        .prod-brand { display: flex; align-items: center; gap: 9px; min-height: 30px; padding: 0 2px 4px; font: inherit; font-size: 14px; font-weight: 550; color: var(--prod-strong); background: transparent; border: 0; text-align: left; cursor: default; }
        .prod-brand-mark { width: 18px; height: 18px; border-radius: 5px; background: var(--prod-accent); display: grid; place-items: center; color: #fff; font-size: 11px; font-weight: 700; }
        .prod-preview-chip { margin-left: auto; height: 20px; border: 1px solid var(--prod-border); border-radius: 5px; padding: 0 6px; display: inline-flex; align-items: center; font-size: 10.5px; font-weight: 500; color: var(--prod-muted); background: var(--prod-surface); }
        .prod-side-section { display: flex; flex-direction: column; gap: 4px; }
        .prod-side-label { padding: 0 8px 4px; font-size: 12px; font-weight: 500; color: var(--prod-dim); }
        .prod-nav-btn { height: 28px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-dim); font: inherit; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 9px; padding: 0 8px; cursor: pointer; text-align: left; }
        .prod-nav-btn:hover { background: var(--prod-hover); color: var(--prod-text); }
        .prod-nav-btn.active { background: var(--prod-selected-nav); color: var(--prod-text); }
        .prod-nav-btn svg { width: 16px; height: 16px; flex: none; }
        .prod-main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--prod-content); }
        .prod-topbar { height: 48px; flex: none; border-bottom: 1px solid var(--prod-divider); display: flex; align-items: center; gap: 8px; padding: 0 16px; }
        .prod-crumb { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: var(--prod-strong); min-width: 0; }
        .prod-crumb span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-tabs { display: flex; gap: 2px; margin-left: 8px; }
        .prod-tab { height: 24px; border: 0; border-radius: 5px; background: transparent; padding: 0 8px; font: inherit; font-size: 12px; font-weight: 500; color: var(--prod-muted); cursor: pointer; }
        .prod-tab:hover, .prod-tab.active { background: var(--prod-hover); color: var(--prod-text); }
        .prod-tab-static, .prod-tab-static.active, .prod-tab-static:hover { display: inline-flex; align-items: center; background: transparent; color: var(--prod-muted); cursor: default; padding: 0; pointer-events: none; }
        .prod-spacer { flex: 1; }
        /* F95: last-success age + degraded state + manual Refresh. */
        .prod-freshness { display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
        .prod-freshness-age { font-size: 11px; font-weight: 500; color: var(--prod-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px; }
        .prod-freshness[data-prod-freshness="degraded"] .prod-freshness-age { color: var(--prod-strong); }
        .prod-freshness[data-prod-freshness="degraded"] .prod-icon-btn { color: var(--prod-strong); }
        .prod-content { flex: 1; min-height: 0; overflow: hidden; display: flex; }
        .prod-listwrap { flex: 1; overflow: auto; }
        /* The list is the page's main scroll region; it is keyboard-focusable
           (axe scrollable-region-focusable) and shows a ring only for keyboard focus. */
        .prod-listwrap:focus { outline: none; }
        .prod-listwrap:focus-visible { outline: 2px solid var(--prod-accent); outline-offset: -2px; }
        /* Shown only when a ?d= / ?batch= / project deep link could not be
           resolved against live data — otherwise the reader gets a plain list
           and no way to tell the link from a broken app. */
        .prod-deeplink-missing { display: flex; align-items: center; gap: 10px; padding: 10px 12px; font-size: 12px; line-height: 1.5; color: var(--prod-strong); background: var(--prod-column); border-bottom: 1px solid var(--prod-divider); }
        .prod-deeplink-missing b { font-weight: 600; }
        /* The chip stays 24px so the strip does not grow, but the TAP target is
           44px per docs/features/UI_DESIGN_STANDARDS.md — this strip has the
           room, so "where space permits" is satisfied and the compact visual is
           not a reason to ship a 24px target at 360px. The overlay is the hit
           area only; it is the strip's sole control, so it cannot steal a tap
           from a neighbour. */
        .prod-deeplink-dismiss { position: relative; margin-left: auto; flex: none; height: 24px; padding: 0 10px; border: 0; border-radius: 6px; background: var(--prod-hover); color: var(--prod-strong); font-size: 12px; font-weight: 500; cursor: pointer; }
        .prod-deeplink-dismiss::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 44px; transform: translateY(-50%); }
        .prod-deeplink-dismiss:hover { background: var(--prod-divider); }
        .prod-deeplink-dismiss:focus-visible { outline: 2px solid var(--prod-accent); outline-offset: 2px; }
        .prod-group { position: sticky; top: 0; z-index: 1; height: 30px; display: flex; align-items: center; gap: 8px; padding: 0 12px; background: var(--prod-content); border-bottom: 1px solid var(--prod-divider); }
        .prod-group:hover { background: var(--prod-column); }
        .prod-group-chev { width: 16px; height: 16px; flex: none; display: grid; place-items: center; color: var(--prod-faint); transition: transform .12s; }
        .prod-group.collapsed .prod-group-chev { transform: rotate(-90deg); }
        .prod-group-title { font-size: 13px; font-weight: 500; color: var(--prod-strong); }
        .prod-group-title.navp { cursor: pointer; }
        .prod-group-count { font-size: 13px; color: var(--prod-muted); font-variant-numeric: tabular-nums; }
        .prod-row { height: 44px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-bottom: 1px solid var(--prod-divider); cursor: pointer; user-select: none; content-visibility: auto; contain-intrinsic-size: 0 44px; contain: content; }
        .prod-row:hover { background: var(--prod-hover); }
        .prod-row.active, .prod-row.selected { background: var(--prod-selected); }
        .prod-row.kfocus { box-shadow: inset 2px 0 0 var(--prod-accent); }
        .prod-status-dot { width: 16px; height: 16px; flex: none; display: grid; place-items: center; border-radius: 5px; color: var(--prod-faint); }
        .prod-status-dot::before { content: ""; width: 12px; height: 12px; border-radius: 50%; border: 1.6px solid currentColor; background: transparent; box-sizing: border-box; }
        .prod-status-dot[data-status="in_progress"] { color: var(--prod-st-in-progress); }
        .prod-status-dot[data-status="smm_approval"] { color: var(--prod-st-smm-approval); }
        .prod-status-dot[data-status="kasper_approval"] { color: var(--prod-st-kasper-approval); }
        .prod-status-dot[data-status="client_approval"] { color: var(--prod-st-client-approval); }
        .prod-status-dot[data-status="tweak"] { color: var(--prod-st-tweak); }
        .prod-status-dot[data-status="approved"] { color: var(--prod-st-approved); }
        .prod-status-dot[data-status="scheduled"] { color: var(--prod-st-scheduled); }
        .prod-status-dot[data-status="posted"] { color: var(--prod-st-posted); }
        .prod-status-dot[data-status="canceled"], .prod-status-dot[data-status="duplicate"] { color: var(--prod-st-canceled); }
        .prod-status-dot[data-status="backlog"] { color: var(--prod-st-backlog); }
        .prod-status-dot[data-status="todo"] { color: var(--prod-st-todo); }
        .prod-status-dot[data-status="triage"] { color: var(--prod-st-triage); }
        .prod-status-dot[data-status="approved"]::before, .prod-status-dot[data-status="scheduled"]::before, .prod-status-dot[data-status="posted"]::before, .prod-status-dot[data-status="canceled"]::before, .prod-status-dot[data-status="duplicate"]::before { background: currentColor; border-color: currentColor; }
        /* `width: 76px` was never a cap, and the cell did not escape sideways.
           MEASURED, after a first explanation that was wrong: a deliverable id
           is hyphenated, so with no `white-space: nowrap` it WRAPS, and the
           cell grows taller than the 44px row -- escaping top and bottom by
           8px each, not left or right. `min-width: 0` alone would not have
           fixed it; `nowrap` plus `overflow: hidden` is what does.
           It never showed while every card carried a 9-character Linear
           identifier. A natively created card has none yet, so
           `_prodIssueLabel` falls through to the deliverable id, and the cards
           created on 2026-09-18 turned the layout lane red on rows nothing had
           changed.
           `min-width: 0` makes the declared width the real one, and the
           ellipsis makes the truncation legible instead of a hard cut. The
           full id stays available on hover; see _prodIssueIdHTML. */
        .prod-id { width: 76px; flex: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 450; color: var(--prod-muted); letter-spacing: 0; font-variant-numeric: tabular-nums; }
        .prod-title { min-width: 0; flex: 1; display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--prod-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .prod-title b { min-width: 0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; }
        .prod-subtle { color: var(--prod-muted); font-weight: 450; overflow: hidden; text-overflow: ellipsis; }
        .prod-chip { height: 24px; max-width: 180px; flex: none; display: inline-flex; align-items: center; gap: 5px; border: 1px solid var(--prod-border); border-radius: 999px; padding: 0 8px; color: var(--prod-muted); font-size: 12px; font-weight: 450; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        /* A CLIENT NAME IS NOT A FIXED WIDTH, and `.prod-chip` above says it is.
           `flex: none` is `flex: 0 0 auto`, so this chip cannot shrink: at any
           row narrower than its content it keeps its width and hangs outside
           the row instead. `max-width` caps it but does not make it yield, and
           the `text-overflow: ellipsis` above never fires because the label
           lives in a nested span that the chip's own overflow only clips.
           Invisible for as long as every active client's display name was
           short -- 13 characters was the longest -- and it went red the day a
           19-character name arrived, on rows nobody had changed.
           So: let it yield like `.prod-title` above it already does
           (`min-width: 0; flex: 1`), and ellipsize the label span itself,
           which is the element that actually holds the text. Any name length
           now stays inside its row at any viewport. Pinned by
           test/prod-client-chip-name-width.js against a synthetic
           24-character name. */
        .prod-chip-client { flex-shrink: 1; min-width: 0; }
        .prod-chip-client > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-avatar { width: 18px; height: 18px; border-radius: 50%; flex: none; display: grid; place-items: center; color: #fff; font-size: 8px; font-weight: 700; background: var(--prod-accent); }
        .prod-avatar.empty { background: transparent; border: 1px dashed var(--prod-faint); color: var(--prod-faint); }
        .prod-board { flex: 1; display: flex; overflow: auto; }
        .prod-col { flex: 1 1 188px; min-width: 188px; max-width: 354px; box-sizing: border-box; display: flex; flex-direction: column; padding: 11px 12px; border-right: 1px solid var(--prod-divider); background: var(--prod-column); min-height: 0; }
        .prod-col-head { display: flex; align-items: center; gap: 7px; padding: 2px 6px 9px; }
        .prod-col-title { font-size: 13px; font-weight: 500; color: var(--prod-strong); }
        .prod-cards { display: flex; flex-direction: column; gap: 7px; overflow: auto; padding-bottom: 20px; }
        .prod-card { background: var(--prod-surface); border-radius: 8px; padding: 11px 13px; box-shadow: 0 3px 6px -2px rgba(0,0,0,.02), 0 1px 1px rgba(0,0,0,.04); cursor: pointer; box-sizing: border-box; }
        .prod-card:hover { box-shadow: 0 4px 10px -2px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.06); }
        .prod-card.pcard-kfocus { box-shadow: inset 0 0 0 2px var(--prod-accent), 0 3px 6px -2px rgba(0,0,0,.04); }
        .prod-card.pcard-sel { background: var(--prod-selected); }
        .prod-card-head { display: flex; align-items: center; gap: 7px; }
        .prod-card-title { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; font-weight: 500; color: var(--prod-strong); }
        .prod-card-desc { margin-top: 5px; font-size: 11px; line-height: 1.45; color: var(--prod-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .prod-card-meta { display: flex; gap: 8px; align-items: center; margin-top: 8px; color: var(--prod-muted); font-size: 12px; }
        .prod-detail { flex: 1; display: flex; min-width: 0; overflow: hidden; }
        .prod-detail-main { flex: 1; overflow: auto; display: flex; justify-content: center; }
        .prod-detail-inner { width: min(100%, 860px); max-width: 860px; padding: 42px 32px 80px; box-sizing: border-box; }
        .prod-project-detail .prod-detail-main { justify-content: flex-start; }
        .prod-project-detail .prod-detail-inner { width: 100%; max-width: none; margin: 0; padding-right: 32px; }
        .prod-detail-id { margin-bottom: 10px; font-size: 13px; font-weight: 450; color: var(--prod-muted); letter-spacing: 0; }
        .prod-detail-title { margin: 0 0 14px; font-size: 24px; line-height: 32px; font-weight: 600; letter-spacing: 0; color: var(--prod-text); }
        .prod-detail-context { margin: 2px 0 10px; min-width: 0; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; color: var(--prod-muted); font-size: 12.5px; line-height: 20px; }
        .prod-detail-context-link, .prod-context-project { min-width: 0; border: 0; border-radius: 6px; background: transparent; color: var(--prod-strong); font: inherit; padding: 1px 3px; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
        .prod-detail-context-link:hover, .prod-context-project:hover { background: var(--prod-hover); }
        .prod-detail-context-link b { max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-desc { font-size: 15px; line-height: 24px; color: var(--prod-strong); white-space: pre-wrap; overflow-wrap: anywhere; }
        .prod-desc .prod-md-heading { display: block; margin: 14px 0 2px; color: var(--prod-text); font-size: 14px; line-height: 22px; font-weight: 650; }
        .prod-desc .prod-md-rule { border: 0; border-top: 1px solid var(--prod-divider); margin: 14px 0; }
        .prod-desc .prod-md-bullet { display: flex; align-items: flex-start; gap: 8px; }
        .prod-desc .prod-md-bullet-mark { flex: none; color: var(--prod-faint); }
        /* A pasted screenshot is evidence, not decoration: it gets real room but
           never pushes the panel sideways, and it keeps its own aspect ratio.
           `display:block` because an inline-block image inside `white-space:
           pre-wrap` inherits the surrounding line box and leaves a stripe of
           blank line under it. */
        /* `max-height` with both dimensions auto keeps the aspect ratio while
           stopping a tall capture from swallowing the panel; the full-size
           image is one click away (zoom-in cursor, opens in a new tab). The
           browser also downscales to 1600px on the long edge BEFORE upload,
           which is the only lever that reaches Linear, since Linear renders
           the mirrored markdown image at its natural size. */
        .prod-desc-image { display: block; max-width: 100%; max-height: 360px; width: auto; height: auto; object-fit: contain; margin: 8px 0; border-radius: 6px; border: 1px solid var(--prod-line); background: var(--prod-column); cursor: zoom-in; }
        .prod-desc-image:focus-visible { outline: 2px solid var(--prod-accent); outline-offset: 2px; }
        .prod-desc a { color: var(--prod-link); text-decoration: none; }
        .prod-desc a:hover { text-decoration: underline; }
        .prod-desc-empty { color: var(--prod-faint); }
        .prod-desc-loading { display: block; width: min(320px, 68%); height: 14px; margin: 5px 0; }
        .prod-right { width: 286px; flex: 0 0 286px; border-left: 1px solid var(--prod-divider); padding: 18px 14px; overflow: auto; background: var(--prod-content); }
        .prod-props { display: flex; flex-direction: column; gap: 2px; }
        .prod-prop { min-height: 32px; display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 8px; font-size: 13px; color: var(--prod-strong); }
        .prod-prop-label { color: var(--prod-prop-label); font-weight: 450; }
        .prod-link { color: var(--prod-link); text-decoration: none; word-break: break-all; }
        .prod-link:hover { text-decoration: underline; }
        .prod-subsection { margin-top: 24px; }
        .prod-subhead { display: flex; align-items: center; gap: 8px; min-height: 26px; margin-bottom: 4px; color: var(--prod-muted); font-size: 12px; font-weight: 500; }
        .prod-subhead-title { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
        .prod-subrow { min-height: 34px; border-top: 1px solid var(--prod-divider); display: flex; align-items: center; gap: 10px; font-size: 13px; cursor: pointer; user-select: none; }
        .prod-subrow:hover { background: var(--prod-hover); margin: 0 -8px; padding: 0 8px; border-radius: 6px; }
        .prod-activity { margin-top: 28px; border-top: 1px solid var(--prod-divider); padding-top: 18px; }
        .prod-activity-head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
        .prod-activity-title { color: var(--prod-strong); font-size: 13px; font-weight: 600; }
        .prod-act { min-height: 22px; display: flex; align-items: center; gap: 8px; margin-bottom: 5px; color: var(--prod-muted); font-size: 12.5px; line-height: 18px; }
        .prod-act-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-act-text b { color: var(--prod-strong); font-weight: 600; }
        .prod-act-time { color: var(--prod-faint); }
        .prod-act-empty { color: var(--prod-faint); font-size: 12.5px; margin-bottom: 12px; }
        .prod-comment-feed { display: flex; flex-direction: column; gap: 14px; }
        .prod-comment { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 9px; color: var(--prod-strong); }
        .prod-comment.is-reply { margin-left: 31px; }
        .prod-comment-main { min-width: 0; }
        .prod-comment-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 5px; min-height: 18px; color: var(--prod-faint); font-size: 12px; line-height: 18px; }
        .prod-comment-author { color: var(--prod-strong); font-weight: 600; }
        .prod-comment-edited { color: var(--prod-faint); }
        .prod-comment-pill { display: inline-flex; align-items: center; min-height: 17px; padding: 0 5px; border-radius: 999px; background: var(--prod-hover); color: var(--prod-muted); font-size: 10.5px; font-weight: 600; }
        .prod-comment-body { margin-top: 2px; color: var(--prod-strong); font-size: 13px; line-height: 20px; overflow-wrap: anywhere; white-space: normal; user-select: text; }
        .prod-comment-body a { color: var(--prod-link); text-decoration: none; }
        .prod-comment-body a:hover { text-decoration: underline; }
        .prod-comment.is-deleted .prod-comment-body { color: var(--prod-faint); font-style: italic; }
        .prod-comment-attachments { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
        .prod-comment-attachment { display: inline-flex; align-items: center; min-height: 25px; max-width: 100%; padding: 0 8px; border: 1px solid var(--prod-border-soft); border-radius: 7px; color: var(--prod-link); font-size: 11.5px; text-decoration: none; }
        .prod-comment-attachment:hover { background: var(--prod-hover); }
        .prod-comment-actions { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 5px; }
        .prod-comment-action { min-height: 24px; padding: 0 7px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-muted); font: inherit; font-size: 11.5px; cursor: pointer; }
        .prod-comment-action:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-comment-action.is-danger { color: var(--prod-danger); }
        .prod-comment-state { color: var(--prod-faint); font-size: 12.5px; line-height: 19px; margin-bottom: 12px; }
        .prod-comment-state.is-error { color: var(--prod-danger); }
        .prod-comment-state-action, .prod-comment-more { min-height: 27px; margin-top: 8px; padding: 0 10px; border: 1px solid var(--prod-border-soft); border-radius: 7px; background: var(--prod-surface); color: var(--prod-strong); font: inherit; font-size: 12px; cursor: pointer; }
        .prod-comment-state-action:hover, .prod-comment-more:hover { background: var(--prod-hover); }
        .prod-comment-state-action:disabled, .prod-comment-more:disabled { cursor: default; opacity: .6; }
        .prod-feedback-status { margin: 12px 0; color: var(--prod-faint); font-size: 12px; line-height: 1.5; }
        .prod-feedback-status.is-error { color: var(--prod-strong); }
        .prod-feedback-source { border-top: 1px solid var(--prod-border-soft); margin-top: 12px; padding-top: 12px; }
        .prod-feedback-heading { font-size: 13px; font-weight: 600; margin-bottom: 12px; color: var(--prod-strong); }
        .prod-feedback-context { margin-top: 6px; font-size: 12px; color: var(--prod-muted); overflow-wrap: anywhere; }
        .prod-feedback-status .prod-comment-state-action { min-height: 44px; }
        .prod-feedback-status .prod-comment-state-action:focus-visible { outline: 2px solid var(--prod-strong); outline-offset: 2px; }
        .prod-comment-loading { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 9px; margin-bottom: 12px; }
        .prod-comment-loading-copy { display: flex; flex-direction: column; gap: 7px; padding-top: 2px; }
        .prod-composer { margin-top: 12px; display: flex; align-items: flex-start; gap: 10px; }
        .prod-composer-box { flex: 1; border: 1px solid var(--prod-border); border-radius: 10px; background: var(--prod-surface); padding: 9px 10px; color: var(--prod-faint); font-size: 13px; text-align: left; }
        .prod-composer-form { flex: 1; min-width: 0; border: 1px solid var(--prod-border); border-radius: 10px; background: var(--prod-surface); overflow: hidden; }
        .prod-composer-input { display: block; width: 100%; min-height: 74px; resize: vertical; border: 0; outline: 0; box-sizing: border-box; padding: 10px 11px 7px; background: transparent; color: var(--prod-strong); font: inherit; font-size: 13px; line-height: 20px; }
        .prod-composer-input::placeholder { color: var(--prod-faint); }
        .prod-composer-actions { min-height: 36px; display: flex; align-items: center; gap: 8px; padding: 5px 7px; border-top: 1px solid var(--prod-divider); }
        .prod-composer-audience { min-height: 26px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-muted); font: inherit; font-size: 11.5px; padding: 0 5px; }
        .prod-composer-submit { min-height: 27px; border: 0; border-radius: 7px; padding: 0 11px; background: var(--prod-accent); color: #fff; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
        .prod-composer-submit:disabled, .prod-composer-input:disabled, .prod-composer-audience:disabled { cursor: default; opacity: .58; }
        .prod-write-state { color: var(--prod-faint); font-size: 11.5px; }
        .prod-write-state.is-error { color: var(--prod-danger); }
        .prod-prop-btn[aria-disabled="true"], .prod-status[data-prod-write="off"], .prod-due[data-prod-write="off"], .prod-assign-hot[data-prod-write="off"] { cursor: default; opacity: .68; }
        .prod-labels-btn { flex-wrap: wrap; align-items: center; gap: 5px; padding-top: 3px; padding-bottom: 3px; }
        .prod-label-chip { --prod-label-color: var(--prod-faint); display: inline-flex; align-items: center; gap: 5px; min-width: 0; max-width: 100%; min-height: 20px; padding: 0 7px; border: 1px solid color-mix(in srgb, var(--prod-label-color) 42%, var(--prod-border-soft)); border-radius: 999px; background: color-mix(in srgb, var(--prod-label-color) 12%, var(--prod-surface)); color: var(--prod-strong); font-size: 11.5px; line-height: 18px; }
        .prod-label-chip > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-label-dot { --prod-label-color: var(--prod-faint); width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--prod-label-color); }
        .prod-label-muted { color: var(--prod-faint); }
        .prod-label-pop { width: min(330px, calc(100vw - 20px)); max-height: min(460px, calc(100vh - 24px)); overflow: hidden; }
        .prod-label-pop .prod-pop-list { max-height: 350px; overflow: auto; }
        .prod-label-option { width: 100%; min-height: 36px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-strong); display: grid; grid-template-columns: 16px 10px minmax(0, 1fr); align-items: center; gap: 8px; padding: 6px 8px; font: inherit; text-align: left; cursor: pointer; }
        .prod-label-option:hover, .prod-label-option:focus-visible { background: var(--prod-menu-hover); outline: 0; }
        .prod-label-option[aria-disabled="true"] { cursor: default; }
        .prod-label-check { width: 14px; height: 14px; border: 1.5px solid var(--prod-faint); border-radius: 4px; background: var(--prod-surface); box-sizing: border-box; display: grid; place-items: center; }
        .prod-label-check[aria-checked="true"] { border-color: var(--prod-accent); background: var(--prod-accent); }
        .prod-label-check[aria-checked="true"]::after { content: ""; width: 3.2px; height: 6.5px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(42deg) translateY(-1px); }
        .prod-label-option-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
        .prod-label-option-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; }
        .prod-label-option-desc { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--prod-faint); font-size: 10.5px; }
        .prod-label-state { padding: 15px 12px; color: var(--prod-muted); font-size: 12px; line-height: 18px; }
        .prod-label-state.is-error { color: var(--prod-danger); }
        .prod-label-retry { min-height: 26px; margin-top: 8px; border: 1px solid var(--prod-border-soft); border-radius: 6px; background: var(--prod-surface); color: var(--prod-strong); padding: 0 9px; font: inherit; font-size: 11.5px; cursor: pointer; }
        .prod-label-lock { padding: 7px 10px; border-top: 1px solid var(--prod-divider); color: var(--prod-faint); font-size: 10.5px; line-height: 15px; }
        .prod-create-trigger { min-height: 28px; border: 0; border-radius: 7px; padding: 0 11px; background: var(--prod-accent); color: #fff; display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
        .prod-create-trigger:hover { filter: brightness(.97); }
        .prod-create-trigger[disabled] { background: var(--prod-hover); color: var(--prod-faint); cursor: not-allowed; filter: none; }
        .prod-create-bd { position: fixed; inset: 0; padding: 32px 18px; box-sizing: border-box; display: flex; justify-content: center; align-items: flex-start; overflow: auto; background: rgba(18,18,20,.34); pointer-events: auto; }
        .prod-create-modal { width: min(720px, calc(100vw - 36px)); max-height: calc(100vh - 64px); display: flex; flex-direction: column; border: 1px solid var(--prod-border); border-radius: 14px; background: var(--prod-surface); color: var(--prod-strong); box-shadow: 0 24px 70px rgba(0,0,0,.24); overflow: hidden; }
        .prod-create-head { min-height: 54px; padding: 0 16px; border-bottom: 1px solid var(--prod-divider); display: flex; align-items: center; gap: 10px; }
        .prod-create-head h2 { margin: 0; font-size: 15px; font-weight: 650; letter-spacing: -.01em; }
        .prod-create-head p { margin: 2px 0 0; color: var(--prod-muted); font-size: 11.5px; }
        .prod-create-close { width: 28px; height: 28px; border: 0; border-radius: 7px; background: transparent; color: var(--prod-muted); display: grid; place-items: center; cursor: pointer; }
        .prod-create-close:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-create-body { padding: 16px; overflow: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
        .prod-create-field { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
        .prod-create-field.wide { grid-column: 1 / -1; }
        .prod-create-field > label, .prod-create-label-head > span { color: var(--prod-muted); font-size: 11.5px; font-weight: 600; }
        .prod-create-input, .prod-create-textarea, .prod-create-label-search { width: 100%; box-sizing: border-box; border: 1px solid var(--prod-border); border-radius: 8px; background: var(--prod-surface); color: var(--prod-strong); font: inherit; font-size: 13px; outline: none; }
        .prod-create-input, .prod-create-label-search { min-height: 36px; padding: 0 10px; }
        .prod-create-textarea { min-height: 126px; resize: vertical; padding: 9px 10px; line-height: 19px; tab-size: 2; }
        .prod-create-input:focus, .prod-create-textarea:focus, .prod-create-label-search:focus { border-color: var(--prod-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--prod-accent) 16%, transparent); }
        .prod-create-input[disabled] { background: var(--prod-hover); color: var(--prod-muted); }
        .prod-create-label-box { border: 1px solid var(--prod-border); border-radius: 9px; overflow: hidden; }
        .prod-create-label-head { min-height: 38px; padding: 7px 9px; display: flex; align-items: center; gap: 9px; border-bottom: 1px solid var(--prod-divider); }
        .prod-create-label-head > span { white-space: nowrap; }
        .prod-create-label-search { min-height: 30px; border: 0; padding: 0 4px; }
        .prod-create-label-list { max-height: 196px; overflow: auto; padding: 5px; }
        .prod-create-label-option { min-height: 34px; border-radius: 6px; padding: 5px 7px; display: grid; grid-template-columns: 16px 10px minmax(0,1fr); align-items: center; gap: 8px; cursor: pointer; font-size: 12.5px; }
        .prod-create-label-option:hover { background: var(--prod-hover); }
        .prod-create-label-option input { margin: 0; accent-color: var(--prod-accent); }
        .prod-create-label-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
        .prod-create-label-copy small { color: var(--prod-faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-create-label-empty { padding: 16px 10px; color: var(--prod-muted); font-size: 12px; text-align: center; }
        .prod-create-note { grid-column: 1 / -1; padding: 8px 10px; border-radius: 8px; background: var(--prod-hover); color: var(--prod-muted); font-size: 11.5px; line-height: 17px; }
        .prod-create-error { grid-column: 1 / -1; min-height: 18px; color: var(--prod-danger); font-size: 12px; line-height: 18px; }
        .prod-create-foot { min-height: 56px; padding: 9px 14px; border-top: 1px solid var(--prod-divider); display: flex; align-items: center; gap: 8px; }
        .prod-create-secondary, .prod-create-submit { min-height: 32px; border: 0; border-radius: 8px; padding: 0 13px; font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; }
        .prod-create-secondary { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-create-submit { background: var(--prod-accent); color: #fff; }
        .prod-create-submit[disabled] { opacity: .56; cursor: wait; }
        .prod-empty, .prod-error, .prod-loading { margin: auto; max-width: 420px; text-align: center; color: var(--prod-muted); font-size: 13px; line-height: 1.5; padding: 40px; }
        .prod-error { color: var(--prod-danger); }
        /* Production preview artifact-structure layer, sourced from docs/syncview-design/SyncView.html. */
        .prod-view svg { display: block; }
        .prod-side { padding: 8px 7px 6px; gap: 0; background: var(--prod-bg); }
        .prod-side-top { display: flex; align-items: center; gap: 6px; padding: 2px 5px 9px; }
        .prod-brand { flex: 1; min-width: 0; min-height: 26px; padding: 3px 5px; margin: -3px -5px; border-radius: 6px; }
        .prod-brand:hover { background: transparent; }
        .prod-brand-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .prod-preview-chip { white-space: nowrap; flex: none; }
        .prod-search-btn, .prod-icon-btn { width: 25px; height: 25px; border: 0; border-radius: 6px; display: grid; place-items: center; color: var(--prod-muted); background: transparent; font: inherit; cursor: pointer; }
        .prod-search-btn:hover, .prod-icon-btn:hover { background: var(--prod-hover); color: var(--prod-text); }
        .prod-search-btn.active, .prod-icon-btn.active { background: var(--prod-hover); color: var(--prod-text); }
        .prod-icon-btn[data-prod-disabled] { color: var(--prod-faint); }
        .prod-side-scroll { flex: 1; min-height: 0; overflow: auto; padding-top: 2px; }
        .prod-nav { display: flex; flex-direction: column; gap: 1px; }
        .prod-nav-section { display: flex; align-items: center; gap: 4px; width: 100%; padding: 14px 8px 4px; color: var(--prod-dim); font: inherit; font-size: 12px; font-weight: 500; background: transparent; border: 0; text-align: left; cursor: pointer; }
        .prod-nav-section .prod-section-label { flex: 1; }
        .prod-section-chev { color: var(--prod-faint); transition: transform .12s; }
        .prod-nav-section.collapsed .prod-section-chev, .prod-team-hd.collapsed .prod-section-chev { transform: rotate(-90deg); }
        .prod-nav-btn { width: 100%; }
        .prod-nav-btn.child { padding-left: 27px; }
        .prod-nav-ico { width: 16px; height: 16px; flex: none; display: grid; place-items: center; color: var(--prod-faint); }
        .prod-nav-btn.active .prod-nav-ico, .prod-nav-btn:hover .prod-nav-ico { color: var(--prod-dim); }
        .prod-team-hd { height: 28px; border: 0; border-radius: 5px; background: transparent; display: flex; align-items: center; gap: 8px; padding: 0 8px; width: 100%; font: inherit; cursor: pointer; color: var(--prod-dim); }
        .prod-team-hd:hover { background: var(--prod-hover); color: var(--prod-text); }
        .prod-team-emoji { width: 16px; height: 16px; flex: none; display: grid; place-items: center; font-size: 11px; }
        .prod-team-name { flex: 1; text-align: left; font-size: 13px; font-weight: 500; }
        .prod-main { border-left: 1px solid var(--prod-border); border-top: 1px solid var(--prod-border); border-top-left-radius: 8px; margin-top: 8px; }
        .prod-topbar { gap: 7px; }
        /* The age text yields first on narrow widths; the Refresh button and
           its accessible name always stay reachable by touch. */
        .prod-freshness-age { display: none; }
        .prod-crumb-sep { color: var(--prod-faint); display: inline-flex; }
        .prod-subbar { min-height: 44px; height: auto; flex: none; border-bottom: 1px solid var(--prod-divider); display: flex; align-items: center; gap: 7px; padding: 5px 16px; box-sizing: border-box; }
        .prod-filter-pills { display: flex; align-items: center; gap: 6px; margin-left: 6px; flex: 1 1 auto; min-width: 0; overflow: hidden; flex-wrap: nowrap; }
        .prod-filter-pill { min-width: 0; max-width: 250px; display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 8px; border: 1px solid var(--prod-border-soft); border-radius: 6px; background: var(--prod-surface); color: var(--prod-strong); font-size: 12px; font-weight: 500; white-space: nowrap; cursor: default; }
        .prod-filter-pill.interactive { cursor: pointer; padding-right: 4px; }
        .prod-filter-pill.interactive * { cursor: pointer; }
        .prod-filter-pill.interactive:hover { background: var(--prod-menu-hover); }
        .prod-filter-pill.prod-scope-pill { cursor: pointer; }
        .prod-filter-pill.prod-scope-pill * { cursor: pointer; }
        .prod-filter-pill.prod-scope-pill:hover { background: var(--prod-menu-hover); }
        .prod-filter-pill > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
        .prod-filter-pill .ficon, .prod-filter-pill .fval { flex: none; display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
        .prod-filter-pill .fval { flex: 1 1 auto; }
        .prod-filter-pill .fval > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
        .prod-filter-pill .fop { color: var(--prod-faint); }
        .prod-filter-pill .fx { width: 17px; height: 17px; display: grid; place-items: center; border: 0; background: transparent; padding: 0; border-radius: 4px; color: var(--prod-faint); font: inherit; }
        .prod-filter-pill .fx:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-status { width: 16px; height: 16px; flex: none; display: grid; place-items: center; color: var(--prod-faint); }
        .prod-status svg { width: 14px; height: 14px; }
        .prod-group { cursor: default; }
        .prod-group-add { width: 22px; height: 22px; border-radius: 5px; display: grid; place-items: center; }
        .prod-check { width: 14px; height: 14px; flex: none; border-radius: 4px; border: 1.5px solid var(--prod-faint); background: var(--prod-surface); opacity: 0; display: grid; place-items: center; margin-right: -1px; position: relative; }
        /* The drawn box stays 14px; the CLICK target fills the row. A 14px box
           centred in a 44px row leaves ~15px of dead zone above and below it,
           and a miss is not harmless -- it lands on the row, which OPENS the
           deliverable. Owner report 2026-08-20: "make the hitbox bigger so I
           don't enter an issue without wanting to."
           Absolute, so it never becomes a grid item and cannot move the box.
           `.prod-row` carries `contain: content`, whose paint containment clips
           this pad to the row, so it can never reach a neighbouring row. The
           subrow default below is sized to a subrow's own height for the same
           reason -- `.prod-subrow` has no containment to clip it. */
        .prod-check::before { content: ""; position: absolute; top: -10px; bottom: -10px; left: -10px; right: -7px; }
        .prod-row .prod-check::before { top: -15px; bottom: -15px; }
        .prod-row:hover .prod-check, .prod-subrow:hover .prod-check, .prod-check.on { opacity: 1; }
        .prod-subrow.selected { background: var(--prod-selected); }
        .prod-check.on { background: var(--prod-accent); border-color: var(--prod-accent); }
        .prod-check.on::after { content: ""; width: 3.2px; height: 6.5px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(42deg) translateY(-1px); display: block; }
        .prod-group-check { width: 14px; height: 14px; flex: none; border-radius: 4px; border: 1.5px solid var(--prod-faint); background: var(--prod-surface); opacity: 0; display: grid; place-items: center; }
        .prod-group:hover .prod-group-check, .prod-group-check.partial, .prod-group-check.on { opacity: 1; }
        .prod-group-check.on, .prod-group-check.partial { background: var(--prod-accent); border-color: var(--prod-accent); }
        .prod-group-check.on::after { content: ""; width: 3.2px; height: 6.5px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(42deg) translateY(-1px); }
        .prod-group-check.partial::after { content: ""; width: 7px; height: 1.5px; background: #fff; border-radius: 1px; }
        .prod-title { gap: 0; }
        .prod-title .prod-parent-title { min-width: 0; color: var(--prod-muted); font-weight: 450; margin-left: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .prod-title .prod-parent-title::before { content: "> "; color: var(--prod-faint); }
        .prod-subchip { display: inline-flex; align-items: center; gap: 3px; height: 24px; border: 1px solid var(--prod-border); border-radius: 999px; padding: 0 8px; color: var(--prod-muted); font-size: 12px; font-weight: 450; white-space: nowrap; }
        .prod-client-dot { font-size: 10px; }
        .prod-due { display: inline-flex; align-items: center; gap: 5px; height: 24px; border: 1px solid var(--prod-border); border-radius: 999px; padding: 0 8px; color: var(--prod-muted); font-size: 12px; font-weight: 450; white-space: nowrap; }
        /* The sub-issue file pill: same shape as the due and project pills it
           sits beside, so the row reads as one set of controls. */
        .prod-subrow-file { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 24px; height: 24px; border: 1px solid var(--prod-border); border-radius: 999px; color: var(--prod-muted); text-decoration: none; }
        .prod-subrow-file:hover { border-color: var(--prod-link); color: var(--prod-link); }
        .prod-subrow-file:focus-visible { outline: 2px solid var(--prod-link); outline-offset: 1px; }
        .prod-due.over svg { color: var(--prod-overdue); }
        .prod-created { width: 48px; flex: none; text-align: right; color: var(--prod-faint); font-size: 11px; font-variant-numeric: tabular-nums; }
        .prod-board { background: var(--prod-content); overflow-x: auto; overflow-y: hidden; }
        .prod-board::-webkit-scrollbar { height: 9px; }
        .prod-board::-webkit-scrollbar-thumb { background: var(--prod-border-soft); border-radius: 9px; }
        .prod-col { background: transparent; }
        .prod-col.has-cards, .prod-col.is-empty { flex: 0 0 260px; min-width: 260px; max-width: 260px; }
        .prod-col.prod-col-drop { background: var(--prod-selected); }
        .prod-col.collapsed { width: 46px; min-width: 46px; flex: 0 0 46px; padding-left: 5px; padding-right: 5px; }
        .prod-col.collapsed .prod-card-status, .prod-col.collapsed .prod-col-title, .prod-col.collapsed .prod-group-count, .prod-col.collapsed .prod-spacer, .prod-col.collapsed .prod-icon-btn, .prod-col.collapsed .prod-group-add, .prod-col.collapsed .prod-cards { display: none; }
        .prod-col-collapse { width: 17px; height: 17px; border: 0; border-radius: 4px; background: transparent; display: grid; place-items: center; color: var(--prod-faint); flex: none; opacity: 0; cursor: pointer; }
        .prod-col-head:hover .prod-col-collapse { opacity: 1; }
        .prod-col-collapse:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-col.collapsed .prod-col-collapse { opacity: 1; transform: rotate(-90deg); }
        .prod-col-rail { writing-mode: vertical-rl; font-size: 13px; font-weight: 500; color: var(--prod-strong); margin: 8px 0 0 4px; white-space: nowrap; }
        .prod-col-head .prod-icon-btn { width: 22px; height: 22px; color: var(--prod-faint); }
        .prod-cards { overflow-y: auto; overflow-x: hidden; }
        .prod-cards::-webkit-scrollbar { width: 7px; }
        .prod-cards::-webkit-scrollbar-thumb { background: var(--prod-border-soft); border-radius: 8px; }
        .prod-card { cursor: pointer; }
        .prod-card.prod-card-dragging, .prod-card.pcard-dragging { opacity: .45; cursor: grabbing; }
        .prod-card-check { width: 14px; height: 14px; flex: none; border-radius: 4px; border: 1.5px solid var(--prod-faint); background: var(--prod-surface); opacity: 0; display: grid; place-items: center; position: relative; }
        /* Same enlarged target on the board card. Bounded by the card's own
           11px/13px padding rather than clipped, since `.prod-card` has no
           containment -- it must not reach the title or the card edge. */
        .prod-card-check::before { content: ""; position: absolute; top: -9px; bottom: -9px; left: -11px; right: -6px; }
        .prod-card:hover .prod-card-check, .prod-card.pcard-sel .prod-card-check { opacity: 1; }
        .prod-card-check.on { background: var(--prod-accent); border-color: var(--prod-accent); opacity: 1; }
        .prod-card-check.on::after { content: ""; width: 3.2px; height: 6.5px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(42deg) translateY(-1px); }
        .prod-card-ico { width: 16px; height: 16px; flex: none; display: grid; place-items: center; color: var(--prod-muted); font-size: 13px; }
        .prod-card-status { width: 16px; height: 16px; flex: none; display: grid; place-items: center; }
        .prod-card-status[data-prod-pstatus], .prod-card-lead, .prod-card-target, .prod-chip-client, .prod-assign-hot { cursor: pointer; }
        .prod-card-target { min-width: 20px; height: 20px; border-radius: 5px; display: inline-flex; align-items: center; justify-content: flex-end; gap: 4px; color: var(--prod-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .prod-card-target:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-card-target.is-empty { justify-content: center; color: var(--prod-faint); opacity: .72; }
        .prod-card-target.is-empty:hover { opacity: 1; }
        .prod-detail-top { border-bottom: 1px solid var(--prod-divider); }
        .prod-sibling-pos { font-size: 11.5px; color: var(--prod-muted); font-variant-numeric: tabular-nums; margin-right: 2px; }
        [data-prod-sibling-nav="prev"] svg { transform: rotate(180deg); }
        .prod-icon-btn:disabled { opacity: .35; cursor: default; }
        .prod-detail-crumb { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: 12px; font-weight: 500; color: var(--prod-strong); }
        .prod-detail-crumb span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-detail-crumb b { flex: none; white-space: nowrap; }
        .prod-detail-crumb .prod-crumb-title { flex: 1 1 auto; }
        .prod-detail-crumb .prod-crumb-kind { flex: none; color: var(--prod-muted); font-size: 11px; font-weight: 600; }
        .prod-desc { margin-bottom: 16px; }
        .prod-description { margin-bottom: 16px; }
        .prod-description-head { min-height: 30px; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; color: var(--prod-muted); }
        .prod-description-title { color: var(--prod-strong); font-size: 12px; font-weight: 600; }
        .prod-description-actions { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; }
        .prod-description-action { min-height: 28px; border: 0; border-radius: 6px; padding: 0 8px; background: transparent; color: var(--prod-muted); font: inherit; font-size: 12px; font-weight: 500; cursor: pointer; }
        .prod-description-action:hover, .prod-description-action.is-active { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-description-action[disabled] { opacity: .55; cursor: wait; }
        .prod-description-action[data-prod-write="off"] { cursor: not-allowed; }
        .prod-description-body { min-height: 24px; }
        .prod-description .prod-desc { margin: 0; }
        /* IN PLACE (2026-09-06). Read view and editor share one box: 6px of
           side padding pulled back out with a negative margin, so the text
           does not move by a pixel when editing starts; the editor adds a
           hairline ring and nothing else. Height is whatever the text needs. */
        .prod-description .prod-description-body, .prod-description .prod-description-rich { margin: 0 -6px; padding: 3px 6px; border-radius: 6px; min-height: 30px; }
        .prod-description-body[data-prod-desc-click-edit] { cursor: text; }
        .prod-description-body[data-prod-desc-click-edit]:hover { background: var(--prod-hover); }
        .prod-description-rich { position: relative; outline: none; box-shadow: 0 0 0 1px var(--prod-accent); background: var(--prod-surface); color: var(--prod-strong); }
        .prod-description-rich.is-drop-target { box-shadow: 0 0 0 2px var(--prod-accent); }
        .prod-description-rich[contenteditable="false"] { opacity: .7; }
        .prod-description-rich.is-empty::before { content: 'Add a description…'; position: absolute; color: var(--prod-faint); pointer-events: none; }
        .prod-desc .prod-md-bullet-text { flex: 1 1 auto; min-width: 0; }
        /* display:none, not height:0: a zero-height block with a line box in it still stops the neighbouring heading and rule margins collapsing through, which is 2px to 14px the read view does not have. The block stays in the model; the caret helpers step over it. */
        .prod-desc .prod-md-gap { display: none; }
        .prod-desc-media-pending, .prod-desc-media-ref { display: inline-flex; align-items: center; padding: 0 8px; border-radius: 6px; border: 1px dashed var(--prod-line); background: var(--prod-hover); color: var(--prod-muted); font-size: 12px; line-height: 20px; }
        .prod-desc-uploading { display: inline-flex; align-items: center; padding: 0 8px; border-radius: 6px; background: var(--prod-hover); color: var(--prod-muted); font-size: 12px; line-height: 20px; }
        .prod-description-footer-rich { min-height: 0; border-top: 0; padding: 4px 0 0; }
        .prod-description-footer-rich .prod-description-hint { margin-left: 0; }
        .prod-description-footer-rich .prod-description-count { margin-left: auto; }
        .prod-description-count.is-quiet { display: none; }
        /* The link card: one body-mounted element, shown on hover over any
           description link, editable where the description is. z-index sits
           with the toast, below the tooltip. */
        .prod-linkpop { position: fixed; z-index: 10000; min-width: 220px; max-width: min(380px, calc(100vw - 16px)); padding: 5px; border: 1px solid var(--prod-border-soft); border-radius: 9px; background: var(--prod-surface); color: var(--prod-strong); box-shadow: var(--prod-shadow-pop); font-size: 12px; line-height: 18px; }
        .prod-linkpop-view { display: flex; align-items: center; gap: 4px; }
        .prod-linkpop-url { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 3px 6px; color: var(--prod-link); text-decoration: none; }
        .prod-linkpop-url:hover { text-decoration: underline; }
        .prod-linkpop-btn { min-height: 26px; border: 0; border-radius: 6px; padding: 0 8px; background: transparent; color: var(--prod-muted); font: inherit; font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap; }
        .prod-linkpop-btn:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-linkpop-apply { background: var(--prod-accent); color: #fff; }
        .prod-linkpop-apply:hover { background: var(--prod-accent); color: #fff; filter: brightness(.96); }
        .prod-linkpop-form { display: none; flex-direction: column; gap: 6px; padding: 2px; }
        .prod-linkpop.is-editing .prod-linkpop-form { display: flex; }
        .prod-linkpop.is-editing .prod-linkpop-view { display: none; }
        .prod-linkpop-field { display: flex; align-items: center; gap: 8px; }
        .prod-linkpop-field span { width: 30px; color: var(--prod-muted); }
        .prod-linkpop-field input { flex: 1 1 auto; min-width: 0; min-height: 26px; border: 1px solid var(--prod-border-soft); border-radius: 6px; padding: 0 7px; font: inherit; font-size: 12px; background: var(--prod-surface); color: var(--prod-strong); outline: none; }
        .prod-linkpop-field input:focus { border-color: var(--prod-accent); }
        .prod-linkpop-note { padding: 0 2px; color: var(--prod-overdue, #eb5757); font-size: 11px; line-height: 16px; }
        .prod-linkpop-actions { display: flex; align-items: center; gap: 4px; }
        .prod-linkpop-spacer { flex: 1 1 auto; }
        .prod-description-state { margin-top: 8px; border-radius: 7px; padding: 8px 10px; background: var(--prod-hover); color: var(--prod-muted); font-size: 12px; line-height: 18px; }
        .prod-description-state.is-error { color: var(--prod-overdue, #eb5757); }
        .prod-description-state button { min-height: 26px; margin-left: 6px; border: 0; border-radius: 6px; padding: 0 8px; background: var(--prod-surface); color: inherit; font: inherit; font-weight: 600; cursor: pointer; }
        .prod-description-editor { border: 1px solid var(--prod-border); border-radius: 9px; overflow: hidden; background: var(--prod-surface); }
        .prod-description-textarea { display: block; width: 100%; min-height: 190px; max-height: 520px; resize: vertical; border: 0; padding: 12px 13px; box-sizing: border-box; outline: none; background: transparent; color: var(--prod-text); font: inherit; font-size: 14px; line-height: 22px; tab-size: 2; }
        .prod-description-textarea:focus { box-shadow: inset 0 0 0 2px var(--prod-accent); }
        .prod-description-preview { min-height: 190px; padding: 12px 13px; box-sizing: border-box; }
        .prod-description-footer { min-height: 42px; border-top: 1px solid var(--prod-divider); padding: 6px 7px 6px 11px; display: flex; align-items: center; gap: 6px; box-sizing: border-box; }
        .prod-description-count { color: var(--prod-faint); font-size: 11px; font-variant-numeric: tabular-nums; }
        .prod-description-count.is-invalid { color: var(--prod-overdue, #eb5757); font-weight: 600; }
        .prod-description-hint { color: var(--prod-faint); font-size: 11px; margin-left: 10px; }
        .prod-description-textarea.is-drop-target { box-shadow: inset 0 0 0 2px var(--prod-accent); }
        .prod-description-save { background: var(--prod-accent); color: #fff; }
        .prod-description-save:hover { background: var(--prod-accent); color: #fff; filter: brightness(.96); }
        .prod-attribution-chip { border-style: solid; font-weight: 600; cursor: default; }
        .prod-attribution-chip.is-provisional { color: #9a6700; border-color: rgba(214, 155, 21, .35); background: rgba(214, 155, 21, .10); }
        .prod-attribution-chip.is-needs { color: #9a6700; border-color: rgba(214, 155, 21, .35); background: rgba(214, 155, 21, .10); }
        .prod-attribution-chip.is-conflict { color: var(--prod-overdue, #eb5757); border-color: rgba(235, 87, 87, .35); background: rgba(235, 87, 87, .10); }
        /* A card SyncView created seconds ago, still waiting for Linear, is not
           a repair: it reads in the neutral muted key, not the amber one every
           other unresolved state uses. */
        .prod-attribution-chip.is-syncing { color: var(--prod-muted); border-color: var(--prod-border); background: var(--prod-hover); }
        .prod-attribution-notice { margin: -4px 0 14px; border-radius: 8px; padding: 9px 11px; background: var(--prod-hover); color: var(--prod-muted); font-size: 12px; line-height: 18px; }
        .prod-attribution-notice b { color: var(--prod-strong); }
        .prod-attribution-notice.is-conflict { color: var(--prod-overdue, #eb5757); }
        @media (max-width: 600px) {
            .prod-description-head { align-items: flex-start; flex-wrap: wrap; }
            .prod-description-actions { width: 100%; margin-left: 0; }
            .prod-description-action { min-height: 36px; padding: 0 11px; }
            .prod-description-actions .prod-spacer { display: block; }
            .prod-description-textarea, .prod-description-preview { min-height: 220px; }
            .prod-description-footer { flex-wrap: wrap; }
        }
        .prod-assets { margin: 8px 0 18px; }
        .prod-assets-head { min-height: 30px; display: flex; align-items: center; gap: 8px; }
        .prod-assets-title { color: var(--prod-strong); font-size: 12px; font-weight: 600; }
        .prod-assets-refresh, .prod-assets-action { min-height: 28px; border: 0; border-radius: 6px; padding: 0 8px; background: transparent; color: var(--prod-muted); font: inherit; font-size: 12px; font-weight: 500; cursor: pointer; }
        .prod-assets-refresh:hover, .prod-assets-action:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-assets-refresh[disabled], .prod-assets-action[disabled] { opacity: .55; cursor: wait; }
        .prod-assets-list { border: 1px solid var(--prod-divider); border-radius: 9px; overflow: hidden; }
        /* Four columns since 2026-08-31: label, value, state, and the per-row
           Edit control. A row that carries no control (the filming plan) simply
           leaves the last column empty, which keeps every state pill on the
           same vertical line rather than letting the writable rows shift. */
        .prod-asset-row { min-height: 42px; padding: 7px 10px; display: grid; grid-template-columns: minmax(125px, .8fr) minmax(150px, 1.4fr) auto auto; align-items: center; gap: 10px; border-top: 1px solid var(--prod-divider); box-sizing: border-box; }
        .prod-asset-row:first-child { border-top: 0; }
        .prod-asset-label { color: var(--prod-strong); font-size: 12px; font-weight: 600; }
        .prod-asset-value { min-width: 0; color: var(--prod-muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-asset-value a { color: var(--prod-link); text-decoration: none; }
        .prod-asset-state { border-radius: 999px; padding: 2px 7px; background: var(--prod-hover); color: var(--prod-muted); font-size: 10px; font-weight: 600; text-transform: capitalize; white-space: nowrap; }
        .prod-asset-state[data-state="available"] { color: var(--prod-success, #43bc58); }
        .prod-asset-state[data-state="invalid"], .prod-asset-state[data-state="expired"], .prod-asset-state[data-state="permission_denied"], .prod-asset-state[data-state="unavailable"] { color: var(--prod-overdue, #eb5757); }
        /* Neither green nor red on purpose. The link is there and opens; this
           server simply could not reach past the provider's auth wall to
           confirm what is inside. Claiming either would be a claim we do not
           have. */
        .prod-asset-state[data-state="unverified"] { color: var(--prod-muted, #8a8f98); }
        /* The loading shape. Deliberately not a spinner and not a word: it
           occupies the room the answer will take and says nothing about what
           the answer is. Respects prefers-reduced-motion by holding still
           rather than disappearing -- the placeholder is the information. */
        .prod-asset-skeleton { display: inline-block; width: 148px; height: 12px; border-radius: 4px;
            background: linear-gradient(90deg, var(--field-bg) 25%, var(--field-bg-hover) 37%, var(--field-bg) 63%);
            background-size: 400% 100%; animation: prod-asset-shimmer 1.4s ease-in-out infinite; }
        .prod-asset-skeleton-pill { width: 64px; height: 12px; }
        @keyframes prod-asset-shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
        @media (prefers-reduced-motion: reduce) { .prod-asset-skeleton { animation: none; } }
        .prod-assets-editor { margin-top: 8px; border: 1px solid var(--prod-divider); border-radius: 9px; padding: 10px; background: var(--prod-hover); }
        /* Nested under the row it edits, the editor is a band inside the list
           rather than a card below it, so the corner radius and outer border
           belong to the list and not to each editor. */
        .prod-assets-list .prod-assets-editor { margin-top: 0; border: 0; border-top: 1px solid var(--prod-divider); border-radius: 0; }
        .prod-assets-scope { margin-top: 6px; color: var(--prod-muted); font-size: 11px; }
        .prod-asset-origin { margin-left: 6px; color: var(--prod-muted); font-size: 11px; }
        .prod-assets-input { width: 100%; min-height: 36px; border: 1px solid var(--prod-border); border-radius: 7px; padding: 0 10px; box-sizing: border-box; background: var(--prod-surface); color: var(--prod-text); font: inherit; font-size: 12px; }
        .prod-assets-candidates { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
        .prod-assets-candidate { min-height: 28px; border: 1px solid var(--prod-divider); border-radius: 999px; padding: 0 9px; background: var(--prod-surface); color: var(--prod-muted); font: inherit; font-size: 11px; cursor: pointer; }
        .prod-assets-editor-actions { margin-top: 8px; display: flex; align-items: center; gap: 6px; }
        .prod-assets-save { background: var(--prod-accent); color: #fff; }
        .prod-assets-save:hover { background: var(--prod-accent); color: #fff; filter: brightness(.96); }
        .prod-assets-error { margin-top: 7px; color: var(--prod-overdue, #eb5757); font-size: 12px; line-height: 18px; }
        .prod-comment-assets { margin-top: 7px; display: grid; gap: 4px; }
        .prod-comment-asset { display: flex; align-items: center; gap: 6px; font-size: 11px; }
        .prod-mi[aria-disabled="true"] { opacity: .58; cursor: not-allowed; }
        .prod-mi .mlbl small { display: block; color: var(--prod-faint); font-size: 10px; font-weight: 450; line-height: 14px; }
        .prod-archive-modal { width: min(860px, calc(100vw - 36px)); }
        .prod-archive-controls { display: grid; grid-template-columns: 1fr 160px 220px; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--prod-divider); }
        .prod-archive-body { min-height: 300px; max-height: min(65vh, 680px); display: grid; grid-template-columns: minmax(220px, .8fr) minmax(300px, 1.4fr); overflow: hidden; }
        .prod-archive-list, .prod-archive-detail { overflow: auto; padding: 12px; }
        .prod-archive-list { border-right: 1px solid var(--prod-divider); }
        .prod-archive-item { width: 100%; min-height: 48px; border: 0; border-radius: 7px; padding: 7px 9px; display: block; background: transparent; color: var(--prod-text); text-align: left; font: inherit; cursor: pointer; }
        .prod-archive-item:hover, .prod-archive-item.is-active { background: var(--prod-hover); }
        .prod-archive-item b, .prod-archive-item span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-archive-item span { margin-top: 2px; color: var(--prod-muted); font-size: 11px; }
        .prod-archive-ref { margin-top: 8px; border: 1px solid var(--prod-divider); border-radius: 8px; padding: 9px; }
        .prod-archive-ref code { color: var(--prod-muted); font-size: 10px; word-break: break-all; }
        .prod-archive-comment { margin-top: 8px; border-left: 2px solid var(--prod-divider); padding-left: 9px; color: var(--prod-muted); font-size: 12px; line-height: 18px; }
        .prod-archive-more { min-height: 32px; margin-top: 8px; border: 1px solid var(--prod-divider); border-radius: 7px; padding: 0 10px; background: var(--prod-surface); color: var(--prod-muted); font: inherit; font-size: 12px; cursor: pointer; }
        @media (max-width: 720px) {
            .prod-archive-controls { grid-template-columns: 1fr; }
            .prod-archive-body { display: block; overflow: auto; }
            .prod-archive-list, .prod-archive-detail { overflow: visible; }
            .prod-archive-list { border-right: 0; border-bottom: 1px solid var(--prod-divider); }
        }
        @media (max-width: 600px) {
            .prod-asset-row { grid-template-columns: 1fr auto auto; }
            .prod-asset-value { grid-column: 1 / -1; grid-row: 2; white-space: normal; overflow-wrap: anywhere; }
            .prod-assets-refresh, .prod-assets-action { min-height: 36px; }
        }
        .prod-subrow .prod-title { flex: 1; }
        .prod-project-groups { margin-top: 4px; }
        .prod-project-groups .prod-group { position: static; border-bottom: 0; border-radius: 6px; margin-top: 8px; background: var(--prod-hover); }
        .prod-project-groups .prod-group:first-child { margin-top: 0; }
        .prod-project-groups .prod-subrow { padding-left: 24px; padding-right: 12px; border-radius: 6px; box-sizing: border-box; }
        .prod-project-groups .prod-subrow:hover { margin-left: 0; margin-right: 0; padding-left: 24px; padding-right: 12px; }
        .prod-project-groups .prod-subrow .prod-title, .prod-subrow .prod-title { min-width: 0; }
        .prod-project-groups .prod-project-issue-row { min-height: 40px; }
        .prod-project-groups .prod-project-issue-title b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; }
        .prod-project-groups .prod-subrow .prod-spacer { min-width: 8px; }
        .prod-project-groups .prod-subrow .prod-due, .prod-project-groups .prod-subrow .prod-assign-hot, .prod-project-groups .prod-subrow .prod-created { flex: none; }
        .prod-actionbar { position: fixed; left: calc(50% + 122px); bottom: 20px; transform: translateX(-50%); z-index: 2000; height: 44px; border: 1px solid var(--prod-border-soft); border-radius: 12px; background: var(--prod-surface); display: inline-flex; align-items: center; gap: 3px; padding: 5px; color: var(--prod-strong); font-size: 12px; box-shadow: var(--prod-shadow-pop); }
        .prod-actionbar .cnt { color: var(--prod-dim); padding: 0 8px 0 9px; white-space: nowrap; }
        .prod-actionbar .abtn { height: 28px; border: 0; border-radius: 7px; background: var(--prod-hover); color: var(--prod-strong); display: inline-flex; align-items: center; gap: 6px; font: inherit; cursor: pointer; padding: 0 10px; }
        .prod-actionbar .abtn:hover, .prod-actionbar .ax:hover { background: var(--prod-hover); color: var(--prod-text); }
        .prod-actionbar .abq { padding: 0; width: 28px; justify-content: center; }
        .prod-actionbar .abq svg { width: 15px; height: 15px; }
        .prod-actionbar .absep { width: 1px; height: 20px; background: var(--prod-border); margin: 0 2px; }
        .prod-actionbar .ax { width: 28px; height: 28px; border: 0; border-radius: 7px; background: transparent; color: var(--prod-faint); display: grid; place-items: center; font: inherit; cursor: pointer; padding: 0; }
        .prod-right { padding: 18px 14px; }
        .prod-side-card { border: 0; border-radius: 8px; background: transparent; margin-bottom: 12px; }
        .prod-side-card-head { display: flex; align-items: center; gap: 8px; min-height: 28px; color: var(--prod-strong); font-size: 13px; font-weight: 600; }
        .prod-side-row { min-height: 32px; display: flex; align-items: center; gap: 8px; color: var(--prod-strong); font-size: 13px; }
        .prod-side-row.muted { color: var(--prod-muted); }
        .prod-side-row.dueover > .prod-prop-btn > svg { color: var(--prod-overdue, #eb5757); }
        button.prod-filter-pill { font-family: inherit; }
        .prod-prop-btn { min-width: 0; width: 100%; min-height: 28px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-strong); font: inherit; display: flex; align-items: center; gap: 8px; padding: 0 6px; box-sizing: border-box; text-align: left; cursor: pointer; transition: background .12s ease, color .12s ease, transform .12s ease; }
        .prod-prop-btn:hover { background: var(--prod-hover); transform: translateX(1px); }
        .prod-parent-link { border: 0; border-radius: 6px; background: transparent; padding: 0 6px; box-sizing: border-box; min-height: 28px; color: var(--prod-strong); font: inherit; text-align: left; cursor: pointer; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: flex; align-items: center; gap: 8px; width: 100%; transition: background .12s ease, color .12s ease, transform .12s ease; }
        .prod-parent-link:hover { background: var(--prod-hover); transform: translateX(1px); text-decoration: none; }
        .prod-composer-box { text-align: left; cursor: not-allowed; }
        .prod-crumb-link { border: 0; background: transparent; color: var(--prod-strong); font: inherit; font-size: 12px; font-weight: 500; padding: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; min-width: 0; max-width: 260px; }
        .prod-crumb .prod-crumb-link { font-size: 13px; }
        .prod-crumb-link:hover { text-decoration: underline; }
        .prod-layer { position: fixed; inset: 0; z-index: 9999; pointer-events: none; }
        .prod-pop-bd { position: fixed; inset: 0; }
        .prod-pop { position: absolute; min-width: 190px; padding: 5px; border: 1px solid var(--prod-border); border-radius: 12px; background: var(--prod-surface); color: var(--prod-strong); box-shadow: var(--prod-shadow-pop); font-size: 13px; }
        .prod-pop[data-prod-bulkcmd="1"] { width: min(720px, calc(100vw - 48px)); max-height: min(450px, calc(100vh - 120px)); padding: 8px; overflow: hidden; }
        .prod-bulk-chip { display: inline-flex; align-items: center; max-width: 100%; height: 24px; padding: 0 8px; border-radius: 999px; background: var(--prod-hover); color: var(--prod-muted); font-size: 12px; font-weight: 600; box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-bulk-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 4px 8px; color: var(--prod-muted); }
        .prod-bulk-ask { display: inline-flex; align-items: center; gap: 7px; color: var(--prod-muted); font-size: 12px; }
        .prod-bulk-ask kbd { height: 18px; min-width: 20px; padding: 0 5px; border: 1px solid var(--prod-border-soft); border-radius: 4px; background: var(--prod-hover); color: var(--prod-faint); font: inherit; font-size: 10px; line-height: 16px; text-align: center; box-sizing: border-box; }
        .prod-pop-hd { padding: 7px 9px; color: var(--prod-muted); font-size: 12px; font-weight: 500; }
        .prod-pop-search { padding: 4px; }
        .prod-pop[data-prod-bulkcmd="1"] .prod-pop-search { display: block; padding: 0 4px 8px; }
        .prod-pop-search input { width: 100%; box-sizing: border-box; height: 30px; border: 1px solid var(--prod-border); border-radius: 8px; background: var(--prod-surface); color: var(--prod-strong); font: inherit; font-size: 13px; padding: 0 8px; outline: 0; }
        .prod-pop[data-prod-bulkcmd="1"] .prod-pop-search input { min-width: 0; height: 34px; border-color: transparent; background: transparent; padding: 0; }
        .prod-pop-search input:focus { border-color: var(--prod-accent); }
        .prod-pop[data-prod-bulkcmd="1"] .prod-pop-search input:focus { border-color: transparent; }
        .prod-pop[data-prod-bulkcmd="1"] .prod-pop-list { max-height: 344px; overflow-y: auto; padding-right: 2px; }
        .prod-pop[data-prod-bulkcmd="1"] .prod-mi { height: 38px; padding: 0 10px; font-weight: 600; }
        .prod-mi { height: 32px; display: flex; align-items: center; gap: 9px; padding: 0 8px; border-radius: 6px; white-space: nowrap; cursor: default; }
        .prod-mi:not(.disabled):hover, .prod-mi.sel { background: var(--prod-menu-hover); }
        .prod-mi.disabled { color: var(--prod-faint); cursor: not-allowed; opacity: .72; }
        .prod-mi.danger, .prod-mi.danger .mic { color: var(--prod-danger); }
        .prod-mi .mic { width: 16px; height: 16px; flex: none; display: grid; place-items: center; color: var(--prod-muted); }
        .prod-mi.disabled .mic { color: var(--prod-faint); }
        .prod-mi .mlbl { flex: 1; }
        .prod-mi .kbd { color: var(--prod-faint); font-size: 10px; margin-left: 14px; order: 1; }
        .prod-mi .chev { color: var(--prod-faint); display: flex; margin-left: 6px; }
        .prod-mi .tick { color: var(--prod-text); display: block; margin-left: 8px; }
        .prod-mi .dres { color: var(--prod-faint); font-size: 11px; margin-left: 14px; }
        .prod-pop-empty { padding: 7px 11px; color: var(--prod-faint); font-size: 12.5px; }
        .prod-msep { height: 1px; margin: 5px 6px; background: var(--prod-divider); }
        .prod-cmd-bd { position: fixed; inset: 0; z-index: 9998; background: rgba(20,20,22,.28); display: flex; justify-content: center; align-items: flex-start; padding-top: 13vh; pointer-events: auto; }
        .prod-cmd { width: min(620px,92vw); max-height: 56vh; background: var(--prod-surface); border: 1px solid var(--prod-border); border-radius: 12px; box-shadow: var(--prod-shadow-pop); display: flex; flex-direction: column; overflow: hidden; color: var(--prod-strong); }
        .prod-cmd-input { border: 0; outline: 0; font: inherit; font-size: 15px; font-weight: 450; padding: 13px 16px; background: var(--prod-surface); color: var(--prod-strong); border-bottom: 1px solid var(--prod-divider); }
        .prod-cmd-list { overflow-y: auto; padding: 6px; flex: 1; }
        .prod-cmd-item { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 7px; cursor: pointer; font-size: 13px; font-weight: 450; color: var(--prod-strong); }
        .prod-cmd-item.sel, .prod-cmd-item:hover { background: var(--prod-menu-hover); }
        .prod-cmd-item .ci { width: 16px; height: 16px; flex: none; display: grid; place-items: center; }
        .prod-cmd-item .ct { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-cmd-item .cmeta { margin-left: auto; font-size: 11px; color: var(--prod-faint); flex: none; padding-left: 10px; }
        .prod-cmd-empty { padding: 18px 16px; color: var(--prod-faint); font-size: 13px; }
        .prod-duepop { width: 286px; }
        .prod-cal { padding: 8px; }
        .prod-cal-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
        .prod-cal-nav { width: 24px; height: 24px; border: 0; border-radius: 6px; background: transparent; color: var(--prod-muted); cursor: pointer; }
        .prod-cal-nav:hover { background: var(--prod-hover); color: var(--prod-strong); }
        .prod-cal-mo { font-weight: 600; font-size: 13px; color: var(--prod-strong); }
        .prod-cal-wk, .prod-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
        .prod-cal-wk span { text-align: center; font-size: 10px; font-weight: 700; color: var(--prod-faint); text-transform: uppercase; }
        .prod-cal-d { height: 28px; border-radius: 7px; display: grid; place-items: center; color: var(--prod-strong); font-size: 12px; cursor: pointer; }
        .prod-cal-d:not(.empty):hover, .prod-cal-d.focus { background: var(--prod-hover); }
        .prod-cal-d.today { box-shadow: inset 0 0 0 1px var(--prod-accent); font-weight: 700; }
        .prod-cal-d.sel { background: var(--prod-accent); color: var(--prod-surface); font-weight: 700; }
        .prod-cal-d.empty { cursor: default; }
        .prod-toast { position: fixed; left: 50%; bottom: 22px; transform: translate(-50%, 8px); z-index: 10000; min-height: 34px; max-width: min(420px, calc(100vw - 32px)); padding: 8px 13px; border: 1px solid var(--prod-border); border-radius: 10px; background: var(--prod-surface); color: var(--prod-strong); box-shadow: 0 12px 32px rgba(0,0,0,.16); font-size: 13px; opacity: 0; pointer-events: none; transition: opacity .12s, transform .12s; }
        .prod-toast.show { opacity: 1; transform: translate(-50%, 0); }
        .prod-tip { position: fixed; z-index: 10001; padding: 5px 8px; border: 1px solid var(--prod-border-soft); border-radius: 8px; background: var(--prod-surface); color: var(--prod-strong); box-shadow: var(--prod-shadow-pop); font-size: 11px; font-weight: 450; white-space: nowrap; pointer-events: none; opacity: 0; transform: translateY(3px); transition: opacity .1s, transform .1s; }
        .prod-tip.show { opacity: 1; transform: translateY(0); }
        .prod-tip .tk { color: var(--prod-muted); margin-left: 6px; }
        .prod-empty-state { width: 100%; padding: 48px 64px 90px; text-align: center; color: var(--prod-muted); font-size: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 56vh; gap: 18px; }
        .prod-empty-state .es-ico { color: var(--prod-faint); opacity: .45; }
        .prod-empty-state .es-ico svg { width: 46px; height: 46px; }
        .prod-empty-state .es-clear { height: 30px; padding: 0 14px; border-radius: 7px; background: var(--prod-hover); color: var(--prod-strong); font-size: 13px; font-weight: 500; border: 0; }
        .prod-inline-empty { margin: 0; padding: 16px 12px; text-align: left; color: var(--prod-muted); font-size: 13px; line-height: 1.5; border-top: 1px solid var(--prod-divider); }
        .prod-inline-empty-title { display: block; color: var(--prod-strong); font-weight: 600; margin-bottom: 2px; }
        .prod-inline-empty-action { margin-top: 10px; height: 28px; padding: 0 12px; border: 0; border-radius: 7px; background: var(--prod-hover); color: var(--prod-strong); font: inherit; font-size: 12.5px; font-weight: 500; cursor: pointer; }
        .prod-inline-empty-action:hover { background: var(--prod-menu-hover); }
        @media (max-width: 900px) { .prod-side { display: none; } .prod-right { display: none; } .prod-detail-inner { padding-left: 20px; padding-right: 20px; } .prod-chip.optional { display: none; } .prod-row .prod-created, .prod-subrow .prod-created { display: none; } .prod-create-body { grid-template-columns: 1fr; } .prod-create-field.wide, .prod-create-note, .prod-create-error { grid-column: 1; } }

        /* Workload calendar */
        .workload-view { max-width: 1440px; margin: 0 auto; animation: fadeIn 0.15s ease; }
        .workload-toolbar { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
        .workload-toolbar-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
        .workload-toolbar-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .workload-toolbar-divider { width: 1px; align-self: stretch; min-height: 22px; background: var(--border); margin: 0 4px; }
        .workload-toolbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .workload-title-group { display: flex; flex-direction: column; gap: 2px; }
        .workload-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); }
        .workload-nav { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .workload-nav button { border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; background: var(--white); cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); transition: all 0.13s; min-width: 36px; }
        .workload-nav button:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); background: var(--bg); }
        .workload-nav button.wl-refreshing { cursor: wait; }
        .workload-nav button.wl-refreshing .wl-refresh-icon { display: inline-block; animation: wl-spin 0.7s linear infinite; }
        @keyframes wl-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .workload-pills { display: inline-flex; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 2px; gap: 2px; flex-shrink: 0; }
        .workload-pills button { border: 0; background: transparent; border-radius: 8px; padding: 5px 12px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); cursor: pointer; transition: all 0.12s; letter-spacing: 0.01em; }
        .workload-pills button:hover { color: var(--text-primary); }
        .workload-pills button.active { background: var(--white); color: var(--text-primary); box-shadow: 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_06); }
        .workload-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .wl-dropdown { position: relative; }
        .wl-dropdown .dropdown-trigger { padding: 8px 14px; border-radius: 20px; min-width: 180px; justify-content: space-between; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); }
        .wl-dropdown .dropdown-trigger .dd-arrow { font-size: 0.65rem; margin-left: 8px; color: var(--text-muted); }
        .wl-dropdown .dropdown-menu { min-width: 220px; max-height: 320px; overflow-y: auto; right: auto; left: 0; }
        .wl-dropdown .dropdown-item { font-size: 0.78rem; font-weight: 600; padding: 8px 14px; }
        .wl-client-search { position: relative; min-width: 180px; }
        .wl-client-search-input { width: 100%; padding: 8px 28px 8px 14px; border-radius: 20px; border: none; background: var(--white); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); outline: none; box-sizing: border-box; transition: box-shadow 0.15s; }
        .wl-client-search-input::placeholder { color: var(--text-muted); font-weight: 600; }
        .wl-client-search-input:hover  { box-shadow: 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_1); }
        .wl-client-search-input:focus  { box-shadow: 0 0 0 2px var(--sv-shadow-6c5ce7); }
        .wl-client-search-clear { position: absolute; top: 50%; right: 6px; transform: translateY(-50%); width: 20px; height: 20px; padding: 0; box-sizing: border-box; background: transparent; border: 0; font-size: 1rem; line-height: 1; color: var(--text-muted); cursor: pointer; border-radius: 50%; }
        .wl-client-search-clear:hover { background: var(--bg); color: var(--text-primary); }
        .wl-client-search-results { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--white); border-radius: 12px; box-shadow: 0 8px 30px var(--sv-shadow-rgba-0-0-0-0_12); padding: 6px; z-index: 1000; max-height: 260px; overflow-y: auto; }
        .wl-client-search-result { display: block; width: 100%; padding: 8px 12px; border: 0; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); text-align: left; cursor: pointer; border-radius: 8px; }
        .wl-client-search-result:hover, .wl-client-search-result.active { background: var(--bg); color: var(--text-primary); }
        .wl-client-search-result.empty { color: var(--text-muted); cursor: default; font-style: italic; font-weight: 500; }
        .wl-client-search-result.loading { display: flex; align-items: center; gap: 8px; color: var(--text-muted); cursor: default; font-weight: 500; border-bottom: 1px solid var(--border); margin-bottom: 4px; padding-bottom: 8px; }
        .wl-client-search-result.loading .spinner { width: 12px; height: 12px; border-width: 2px; }
        .workload-section-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 8px; }
        .workload-section-toggle { width: 100%; min-height: 32px; padding: 0; border: 0; background: transparent; font-family: inherit; text-align: left; cursor: pointer; }
        .workload-section-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; border-radius: 6px; }
        .workload-section-toggle-chevron { margin-left: auto; color: currentColor; opacity: 0.75; transition: transform 0.15s ease; }
        .workload-section-toggle[aria-expanded="true"] .workload-section-toggle-chevron { transform: rotate(180deg); }
        .workload-exception-section.is-collapsed .workload-section-toggle { margin-bottom: 0; }
        .workload-exception-rollups[hidden] { display: none; }
        @media (prefers-reduced-motion: reduce) { .workload-section-toggle-chevron { transition: none; } }
        .workload-weekend-notice { position: relative; margin-left: auto; text-transform: none; letter-spacing: 0; }
        .workload-weekend-notice[hidden] { display: none; }
        .workload-weekend-notice summary { min-height: 28px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border: 1px solid var(--border); border-radius: 999px; background: var(--white); color: var(--text-secondary); font-size: 0.62rem; font-weight: 750; cursor: pointer; list-style: none; white-space: nowrap; }
        .workload-weekend-notice summary::-webkit-details-marker { display: none; }
        .workload-weekend-notice summary:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .workload-weekend-notice summary:focus-visible { outline: 2px solid var(--sv-border-4f46e5); outline-offset: 2px; }
        .workload-weekend-notice-panel { position: absolute; z-index: 30; top: calc(100% + 6px); right: 0; width: min(360px, calc(100vw - 40px)); max-height: 280px; overflow-y: auto; padding: 8px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); box-shadow: 0 10px 32px var(--sv-shadow-rgba-0-0-0-0_16); }
        .workload-weekend-row { width: 100%; display: flex; align-items: center; gap: 7px; padding: 6px 7px; border: 0; border-radius: 7px; background: transparent; color: var(--text-primary); font: inherit; font-size: 0.66rem; font-weight: 650; text-align: left; cursor: pointer; }
        .workload-weekend-row:hover { background: var(--bg); }
        .workload-weekend-row-date { width: 48px; flex-shrink: 0; color: var(--text-muted); font-size: 0.58rem; font-weight: 800; text-transform: uppercase; }
        .workload-weekend-row-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .workload-weekend-row-role { flex-shrink: 0; color: var(--text-muted); font-size: 0.56rem; font-weight: 750; }
        .wl-plan-origin { display: inline-flex; align-items: center; justify-content: center; gap: 2px; width: auto; min-width: 14px; height: 14px; color: var(--text-muted); font-size: 0.52rem; font-weight: 850; line-height: 1; white-space: nowrap; flex-shrink: 0; }
        .wl-plan-origin svg { width: 13px; height: 13px; display: block; }
        .wl-plan-origin.is-manual { color: var(--sv-fg-5e6ad2); }
        .wl-plan-origin.is-fallback { color: var(--sv-fg-92400e); }
        .wl-plan-origin.is-loading { color: var(--text-muted); }
        .wl-plan-origin.is-loading svg { animation: wlPlanOriginSpin 0.9s linear infinite; }
        @keyframes wlPlanOriginSpin { to { transform: rotate(360deg); } }
        .wl-settle-in { animation: wlSettleIn 340ms cubic-bezier(0.22, 0.61, 0.36, 1); }
        @keyframes wlSettleIn { from { opacity: 0.25; transform: translateY(-6px) scale(0.985); } to { opacity: 1; transform: none; } }
        @media (prefers-reduced-motion: reduce) { .wl-plan-origin.is-loading svg, .wl-settle-in { animation: none; } }
        .wl-plan-origin-count { min-width: 6px; text-align: center; }
        .wl-workload-group { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 4px; color: var(--sv-fg-9a3412); flex: 0 0 16px; transition: background 0.12s, opacity 0.12s; }
        .wl-workload-group.is-some { opacity: 0.68; }
        .wl-workload-group:hover { background: var(--sv-bg-fff7ed); opacity: 1; }
        .wl-workload-group svg { width: 14px; height: 14px; display: block; }
        .wl-deadline-summary { display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; color: var(--text-muted); flex-shrink: 0; }
        .wl-deadline-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--wl-proximity-dot, currentColor); box-shadow: 0 0 0 2px var(--white); flex: 0 0 8px; }
        .wl-deadline-summary.is-red { color: var(--sv-fg-dc2626); --wl-proximity-dot: var(--wl-proximity-red); }
        .wl-deadline-summary.is-orange { color: var(--sv-fg-ea580c); --wl-proximity-dot: var(--wl-proximity-orange); }
        .wl-deadline-summary.is-green { color: var(--sv-fg-16a34a); --wl-proximity-dot: var(--wl-proximity-green); }
        .wl-deadline-tag { display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted); font-size: 0.56rem; font-weight: 750; white-space: nowrap; }
        .wl-deadline-tag::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--wl-proximity-dot, currentColor); box-shadow: 0 0 0 2px var(--white); flex: 0 0 8px; }
        .wl-deadline-tag.is-red { color: var(--sv-fg-dc2626); --wl-proximity-dot: var(--wl-proximity-red); }
        .wl-deadline-tag.is-orange { color: var(--sv-fg-ea580c); --wl-proximity-dot: var(--wl-proximity-orange); }
        .wl-deadline-tag.is-green { color: var(--sv-fg-16a34a); --wl-proximity-dot: var(--wl-proximity-green); }
        .wl-workload-badge { --wl-weight-color: var(--sv-fg-ea580c); display: inline-flex; align-items: center; min-height: 16px; padding: 1px 5px; border: 1px solid var(--wl-weight-color); border-radius: 999px; color: var(--wl-weight-color); font-size: 0.54rem; font-weight: 850; line-height: 1; white-space: nowrap; flex-shrink: 0; }
        .wl-plan-origin[data-tip], .wl-deadline-summary[data-tip], .wl-deadline-tag[data-tip], .wl-workload-badge[data-tip], .wl-workload-group[data-tip] { cursor: help; }
        .workload-plan-status { margin: -2px 0 10px; padding: 8px 11px; border-radius: 9px; font-size: 0.7rem; font-weight: 650; color: var(--text-secondary); background: var(--bg); border: 1px solid var(--border-light); }
        .workload-plan-status.is-warning { color: var(--sv-fg-92400e); background: var(--sv-bg-fffbeb); border-color: var(--sv-border-fde68a); }
        .workload-popover { position: absolute; z-index: 1000; background: var(--white); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 12px 40px var(--sv-shadow-rgba-0-0-0-0_18); padding: 10px; min-width: 280px; max-width: 380px; max-height: 60vh; overflow-y: auto; display: none; }
        .workload-popover.open { display: block; }
        .workload-popover-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 2px 4px 8px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }
        .workload-popover-head-title-group { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; overflow: hidden; }
        .workload-popover-head-title { font-size: 0.74rem; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .workload-popover-templates { display: inline-flex; align-items: center; gap: 4px; font-size: 0.62rem; font-weight: 600; color: var(--text-muted); text-decoration: none; white-space: nowrap; align-self: flex-start; max-width: 100%; transition: color 0.13s; }
        .workload-popover-templates:hover { color: var(--text-primary); text-decoration: underline; }
        .workload-popover-templates svg { flex-shrink: 0; opacity: 0.85; }
        .workload-popover-parent { font-size: 0.66rem; font-weight: 600; color: var(--text-muted); text-decoration: none; white-space: nowrap; flex-shrink: 0; }
        .workload-popover-parent-linear { font-weight: 500; opacity: 0.75; margin-left: 6px; }
        .workload-popover-item-linear { opacity: 0.65; }
        .workload-popover-item-linear:hover { opacity: 1; }
        .workload-popover-parent:hover { color: var(--text-primary); text-decoration: underline; }
        .workload-popover-close { width: 44px; height: 44px; padding: 0; box-sizing: border-box; background: transparent; border: 0; color: var(--text-muted); font-size: 1rem; cursor: pointer; line-height: 1; flex-shrink: 0; border-radius: 7px; }
        .workload-popover-close:hover { background: var(--bg); color: var(--text-primary); }
        .workload-popover-item { display: flex; align-items: center; gap: 4px; padding: 3px 4px 3px 8px; border-radius: 6px; color: var(--text-primary); font-size: 0.76rem; }
        .workload-popover-item:hover { background: var(--bg); }
        .workload-popover-item-main { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; padding: 4px 0; text-decoration: none; color: inherit; }
        .workload-popover-item-cal { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
            width: 26px; height: 26px; border: 0; border-radius: 6px; background: transparent; color: var(--text-muted);
            cursor: pointer; transition: background 0.12s, color 0.12s; }
        .workload-popover-item-cal:hover { background: var(--sv-bg-ecedfb); color: var(--sv-fg-5e6ad2); }
        .workload-popover-item-cal svg { width: 14px; height: 14px; }
        .workload-popover-item-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
        .workload-popover-item-client{ font-size: 0.62rem; color: var(--text-muted); flex-shrink: 0; font-weight: 600; padding: 1px 6px; background: var(--bg); border-radius: 999px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .workload-popover-plan { margin: 1px 4px 8px 8px; padding: 8px; border-radius: 8px; background: var(--bg); border: 1px solid var(--border-light); }
        .workload-popover-plan-line { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
        .workload-popover-plan-label { display: inline-flex; align-items: center; gap: 4px; color: var(--text-secondary); font-size: 0.64rem; font-weight: 750; white-space: nowrap; }
        .workload-popover-plan .sv-date { min-width: 0; flex: 1 1 auto; }
        .workload-popover-plan .sv-date-trigger { min-height: 44px; padding: 8px 10px; font-size: 0.68rem; }
        .workload-popover-plan-saving { font-size: 0.61rem; font-weight: 650; color: var(--text-muted); white-space: nowrap; }
        .workload-plan-clear { min-height: 44px; border: 1px solid var(--sv-border-c7c9f2); background: var(--white); padding: 7px 10px; border-radius: 7px; color: var(--sv-fg-5e6ad2); font: inherit; font-size: 0.62rem; font-weight: 750; cursor: pointer; white-space: nowrap; }
        .workload-plan-clear:hover:not(:disabled) { background: var(--sv-bg-ecedfb); }
        .workload-plan-clear:disabled { opacity: 0.5; cursor: default; }
        /* Tweak-comment preview inside the workload popover — surfaces the
           client / Kasper comment that bounced the sub-issue back so the
           editor sees what to change. One muted row per comment (author ·
           body · time), no card chrome, matching the popover items above. */
        .wl-tweak-frame-note { display: flex; gap: 7px; align-items: center; background: var(--sv-bg-fff7ed); border: 1px solid var(--sv-border-fed7aa); border-radius: 8px; padding: 6px 10px; margin: 0 0 8px; font-size: 0.68rem; font-weight: 600; color: var(--sv-fg-9a3412); line-height: 1.45; }
        .wl-tweak-frame-note > svg { flex-shrink: 0; }
        /* The (i) carries the full explanation in its title tooltip. */
        .wl-tweak-frame-info { display: inline-flex; align-items: center; color: var(--sv-fg-b45309); flex-shrink: 0; border-radius: 50%; }
        .wl-tweak-comments { display: flex; flex-direction: column; gap: 1px; margin: 2px 4px 6px 16px; }
        .wl-tweak-comments:empty { display: none; }
        .wl-tweak-comments-status { font-size: 0.64rem; color: var(--text-muted); font-style: italic; padding: 2px 4px 2px 8px; }
        /* An unread row must not read as an empty one: the muted italic above
           is the house's "nothing here" voice, so the couldn't-ask notice
           drops the italic and takes the same amber the Frame.io warning uses. */
        .wl-tweak-comments-status.is-unavailable { color: var(--sv-fg-b45309); font-style: normal; font-weight: 600; }
        .wl-tweak-comment { display: flex; align-items: baseline; gap: 8px; padding: 3px 6px 3px 8px; border-radius: 6px; }
        .wl-tweak-comment:hover { background: var(--bg); }
        .wl-tweak-comment-author { font-size: 0.64rem; font-weight: 700; color: var(--text-secondary); flex-shrink: 0; }
        .wl-tweak-comment-time { font-size: 0.6rem; color: var(--text-muted); font-weight: 600; flex-shrink: 0; }
        /* One row by default (truncated with an ellipsis); wlMarkClampedComments
           adds .is-clamped only when the body genuinely overflows, so short
           comments don't advertise an expand that does nothing. Click expands
           the body to its full wrapped text. */
        .wl-tweak-comment-body { font-size: 0.72rem; color: var(--text-primary); line-height: 1.45; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .wl-tweak-comment-body.is-clamped { cursor: pointer; }
        .wl-tweak-comment-body.is-clamped:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; border-radius: 3px; }
        .wl-tweak-comment-body.expanded { white-space: pre-wrap; word-break: break-word; overflow: visible; text-overflow: clip; }
        .wl-tweak-comment-more { font-size: 0.62rem; font-weight: 600; color: var(--text-muted); padding: 1px 4px 1px 8px; }
        .workload-needs-assignment { border: 1.5px dashed var(--border); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; background: var(--white); }
        .workload-needs-assignment.empty { display: none; }
        .workload-undated { background: var(--bg); }
        .workload-capacity { border: 1px solid var(--border); border-radius: 12px; padding: 9px 16px; margin-bottom: 14px; background: var(--white); display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
        .workload-capacity.empty { display: none; }
        .workload-capacity .workload-section-label { display: flex; align-items: center; gap: 8px; margin-bottom: 0; color: var(--sv-fg-4f46e5); font-size: 0.76rem; flex-shrink: 0; }
        .workload-capacity-hint { font-size: 0.66rem; font-weight: 500; color: var(--text-muted); text-transform: none; letter-spacing: 0; }
        /* Editor workload — a centered row of editors (freest first), each a
           clickable chip showing name + Free / ~N days. Click opens that
           editor's sub-issues. No bars. */
        .workload-capacity-row { flex: 1 1 auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
        .workload-capacity-chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--white); font-family: inherit; cursor: pointer; transition: border-color 0.1s ease, box-shadow 0.1s ease, transform 0.08s ease; }
        .workload-capacity-chip:hover { border-color: var(--sv-border-bbb); box-shadow: 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_06); transform: translateY(-1px); }
        .workload-capacity-chip:focus-visible { outline: 2px solid var(--sv-border-4f46e5); outline-offset: 2px; }
        .wl-cap-name { font-size: 0.8rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; }
        .wl-cap-label { font-size: 0.74rem; font-weight: 700; white-space: nowrap; }
        .wl-cap-label::before { content: '·'; margin-right: 7px; color: var(--text-muted); font-weight: 700; }
        .workload-capacity-chip.free  .wl-cap-label { color: var(--sv-fg-059669); }
        .workload-capacity-chip.light .wl-cap-label { color: var(--sv-fg-0284c7); }
        .workload-capacity-chip.busy  .wl-cap-label { color: var(--sv-fg-b45309); }
        .workload-capacity-chip.full  .wl-cap-label { color: var(--sv-fg-dc2626); }
        .workload-in-progress { border: 1.5px solid var(--wl-progress-border); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; background: var(--wl-progress-section-bg); }
        .workload-in-progress.empty { display: none; }
        .workload-in-progress .workload-section-label { color: var(--wl-progress-label); display: flex; align-items: center; gap: 8px; }
        .workload-section-label .wl-now-total { border-radius: 999px; padding: 1px 8px; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; color: var(--wl-status-fg); }
        .workload-in-progress .workload-section-label .wl-now-total { background: var(--wl-progress-accent); }
        .workload-in-progress-rollups { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
        .wl-now-card { background: var(--white); border: 1px solid var(--wl-progress-border); border-left: 3px solid var(--wl-progress-accent); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        .wl-now-card-head { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .wl-now-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--wl-progress-accent); color: var(--wl-status-fg); font-size: 0.7rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; letter-spacing: 0.02em; }
        .wl-now-card-name { flex: 1; min-width: 0; font-size: 0.82rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .wl-now-card-total { border: 0; background: var(--wl-progress-accent); color: var(--wl-status-fg); border-radius: 999px; padding: 2px 9px; font-family: inherit; font-size: 0.7rem; font-weight: 800; line-height: 1.3; flex-shrink: 0; cursor: pointer; transition: background 0.1s; }
        .wl-now-card-total:hover { background: var(--wl-progress-accent-hover); }
        .wl-now-client-chip-count { font-weight: 800; opacity: 0.65; flex-shrink: 0; cursor: pointer; padding: 0 1px; }
        .wl-now-client-chip-count:hover { opacity: 1; }
        .wl-now-card-clients { display: flex; flex-wrap: wrap; gap: 4px; }
        .wl-now-client-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; background: var(--wl-progress-chip-bg); color: var(--wl-progress-chip-fg); font-size: 0.7rem; font-weight: 600; text-decoration: none; transition: background 0.1s; max-width: 100%; }
        .wl-now-client-chip:hover { background: var(--wl-progress-chip-hover); }
        .wl-now-client-chip-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        /* Overdue strip — same shape as In progress now / Tweaks needed,
           but red. An overdue sub-issue is the most urgent signal on the
           page (still in To Do, deadline already gone, and it still sits
           with them), so the strip lives above In progress now. Work that
           has started, or moved on to any other live status, is counted by
           that status instead — see the partition loop's 2026-09-07 ruling. */
        .workload-overdue { border: 1.5px solid var(--wl-overdue-border); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; background: var(--wl-overdue-section-bg); }
        .workload-overdue.empty { display: none; }
        .workload-overdue .workload-section-label { color: var(--wl-overdue-label); display: flex; align-items: center; gap: 8px; }
        .workload-overdue .workload-section-label .wl-now-total { background: var(--wl-overdue-accent); }
        .workload-overdue .wl-now-card { border: 1px solid var(--wl-overdue-border); border-left: 3px solid var(--wl-overdue-accent); }
        .workload-overdue .wl-now-avatar { background: var(--wl-overdue-accent); }
        .workload-overdue .wl-now-card-total { background: var(--wl-overdue-accent); }
        .workload-overdue .wl-now-card-total:hover { background: var(--wl-overdue-accent-hover); }
        .workload-overdue .wl-now-client-chip { background: var(--wl-overdue-chip-bg); color: var(--wl-overdue-chip-fg); }
        .workload-overdue .wl-now-client-chip:hover { background: var(--wl-overdue-chip-hover); }
        /* Tweaks needed strip — same shape as In progress now, but dark
           orange. A tweak is work bounced back to the editor for revision:
           still "owed" but distinct from work they're actively cutting. */
        .workload-tweaks { border: 1.5px solid var(--wl-tweaks-border); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; background: var(--wl-tweaks-section-bg); }
        .workload-tweaks.empty { display: none; }
        .workload-tweaks .workload-section-label { color: var(--wl-tweaks-label); display: flex; align-items: center; gap: 8px; }
        .workload-tweaks .workload-section-label .wl-now-total { background: var(--wl-tweaks-accent); }
        .workload-tweaks .wl-now-card { border: 1px solid var(--wl-tweaks-border); border-left: 3px solid var(--wl-tweaks-accent); }
        .workload-tweaks .wl-now-avatar { background: var(--wl-tweaks-accent); }
        .workload-tweaks .wl-now-card-total { background: var(--wl-tweaks-accent); }
        .workload-tweaks .wl-now-card-total:hover { background: var(--wl-tweaks-accent-hover); }
        .workload-tweaks .wl-now-client-chip { background: var(--wl-tweaks-chip-bg); color: var(--wl-tweaks-chip-fg); }
        .workload-tweaks .wl-now-client-chip:hover { background: var(--wl-tweaks-chip-hover); }
        /* Workload overview matrix — one softly raised row per editor, with
           whitespace instead of a ruled grid. Status counts and client chips
           remain visible in every status column. */
        .workload-overview-matrix { border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-bottom: 14px; background: var(--white); }
        .workload-overview-matrix.empty { display: none; }
        .workload-overview-head,
        .workload-overview-row { display: grid; grid-template-columns: minmax(180px, 1.2fr) minmax(130px, 0.72fr) repeat(3, minmax(170px, 1fr)); gap: 12px; align-items: center; }
        .workload-overview-head { padding: 2px 10px 9px; }
        .workload-overview-heading { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        .workload-overview-heading strong { color: var(--sv-fg-4f46e5); font-size: 0.86rem; font-weight: 850; letter-spacing: 0.06em; text-transform: uppercase; }
        .workload-overview-heading span,
        .workload-overview-capacity-head { color: var(--text-muted); font-size: 0.68rem; font-weight: 750; text-align: center; }
        .workload-overview-status-head { min-width: 0; min-height: 34px; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 4px 2px; color: var(--text-secondary); font: inherit; font-size: 0.72rem; font-weight: 850; text-align: center; }
        .workload-overview-status-head::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--wl-overview-accent); flex: 0 0 7px; }
        .workload-overview-status-head.is-overdue { --wl-overview-accent: var(--wl-overdue-accent); }
        .workload-overview-status-head.is-inprogress { --wl-overview-accent: var(--wl-progress-accent); }
        .workload-overview-status-head.is-tweaks { --wl-overview-accent: var(--wl-tweaks-accent); }
        .workload-overview-head-total { min-width: 22px; padding: 2px 6px; border-radius: 999px; background: var(--wl-overview-accent); color: var(--wl-status-fg); font-size: 0.58rem; font-weight: 850; line-height: 1.2; text-align: center; }
        .workload-overview-rows { display: flex; flex-direction: column; gap: 8px; }
        .workload-overview-row.is-skeleton .workload-overview-editor, .workload-overview-row.is-skeleton .workload-overview-capacity { display: flex; align-items: center; gap: 10px; min-height: 40px; }
        .workload-overview-row.is-skeleton .workload-overview-editor-copy { display: flex; flex-direction: column; gap: 6px; }
        .workload-overview-row.is-skeleton .workload-overview-capacity { flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; }
        .workload-overview-row.is-skeleton .workload-overview-status { display: flex; align-items: center; justify-content: center; min-height: 40px; }
        .workload-overview-row { padding: 10px 12px; border: 0; border-radius: 11px; background: var(--bg); transition: background 0.12s ease, box-shadow 0.12s ease; }
        .workload-overview-row:hover { background: var(--white); box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_06); }
        .workload-overview-editor,
        .workload-overview-capacity { min-width: 0; display: flex; align-items: center; gap: 9px; padding: 0; border: 0; background: transparent; color: var(--text-primary); font: inherit; text-align: left; cursor: pointer; }
        .workload-overview-editor:focus-visible,
        .workload-overview-capacity:focus-visible,
        .workload-overview-status-total:focus-visible,
        .wl-now-client-chip:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .workload-overview-avatar { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 9px; background: var(--sv-bg-ecedfb); color: var(--sv-fg-5e6ad2); font-size: 0.62rem; font-weight: 850; flex: 0 0 28px; }
        .workload-overview-editor-copy { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .workload-overview-editor-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.73rem; font-weight: 800; }
        .workload-overview-editor-team { color: var(--text-muted); font-size: 0.56rem; font-weight: 650; }
        .workload-overview-capacity { display: grid; grid-template-columns: minmax(54px, auto) minmax(46px, 1fr); gap: 8px; }
        .workload-overview-capacity-label { color: var(--text-secondary); font-size: 0.64rem; font-weight: 800; white-space: nowrap; }
        .workload-overview-capacity.free .workload-overview-capacity-label { color: var(--sv-fg-059669); }
        .workload-overview-capacity.light .workload-overview-capacity-label { color: var(--sv-fg-0284c7); }
        .workload-overview-capacity.busy .workload-overview-capacity-label { color: var(--sv-fg-b45309); }
        .workload-overview-capacity.full .workload-overview-capacity-label { color: var(--sv-fg-dc2626); }
        .workload-overview-meter { height: 5px; overflow: hidden; border-radius: 999px; background: var(--border-light); }
        .workload-overview-meter > span { display: block; width: var(--wl-capacity-fill); max-width: 100%; height: 100%; border-radius: inherit; background: var(--wl-capacity-color); }
        .workload-overview-capacity.free { --wl-capacity-color: var(--sv-fg-059669); }
        .workload-overview-capacity.light { --wl-capacity-color: var(--sv-fg-0284c7); }
        .workload-overview-capacity.busy { --wl-capacity-color: var(--sv-fg-b45309); }
        .workload-overview-capacity.full { --wl-capacity-color: var(--sv-fg-dc2626); }
        .workload-overview-status { min-width: 0; min-height: 38px; display: flex; align-items: center; gap: 6px; padding: 6px 7px; border: 0; border-radius: 9px; background: var(--white); }
        .workload-overview-status.is-empty { justify-content: center; color: var(--text-muted); background: transparent; font-size: 0.68rem; font-weight: 700; text-align: center; }
        .workload-overview-status-clients { min-width: 0; flex: 1; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
        .workload-overview-status-total { min-width: 24px; min-height: 24px; margin-left: auto; padding: 2px 7px; border: 0; border-radius: 999px; background: var(--wl-overview-accent); color: var(--wl-status-fg); font: inherit; font-size: 0.62rem; font-weight: 850; cursor: pointer; flex-shrink: 0; }
        .workload-overview-status.is-overdue { --wl-overview-accent: var(--wl-overdue-accent); }
        .workload-overview-status.is-inprogress { --wl-overview-accent: var(--wl-progress-accent); }
        .workload-overview-status.is-tweaks { --wl-overview-accent: var(--wl-tweaks-accent); }
        .workload-overview-status.is-overdue .wl-now-client-chip { background: var(--wl-overdue-chip-bg); color: var(--wl-overdue-chip-fg); }
        .workload-overview-status.is-inprogress .wl-now-client-chip { background: var(--wl-progress-chip-bg); color: var(--wl-progress-chip-fg); }
        .workload-overview-status.is-tweaks .wl-now-client-chip { background: var(--wl-tweaks-chip-bg); color: var(--wl-tweaks-chip-fg); }
        @media (max-width: 900px) {
            .workload-overview-head { grid-template-columns: minmax(180px, 1fr) repeat(3, minmax(110px, 1fr)); }
            .workload-overview-capacity-head { display: none; }
            .workload-overview-row { grid-template-columns: minmax(180px, 1fr) minmax(120px, 0.8fr); }
            .workload-overview-status { grid-column: 1 / -1; display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; }
            .workload-overview-status::before { content: attr(data-wl-status-label); color: var(--text-muted); font-size: 0.58rem; font-weight: 800; text-transform: uppercase; }
            .workload-overview-status.is-empty { grid-template-columns: 92px 1fr; }
        }
        @media (max-width: 560px) {
            .workload-overview-matrix { padding: 9px; }
            .workload-overview-head { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-inline: 4px; }
            .workload-overview-heading { grid-column: 1 / -1; margin-bottom: 2px; }
            .workload-overview-status-head { justify-content: center; font-size: 0.58rem; }
            .workload-overview-row { grid-template-columns: 1fr; padding: 10px; }
            .workload-overview-capacity { max-width: 220px; }
        }
        .workload-chips { display: flex; flex-wrap: wrap; gap: 6px; }
        .workload-chip { padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg); font-size: 0.71rem; font-weight: 600; color: var(--text-primary); cursor: pointer; transition: all 0.13s; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
        .workload-chip:hover { border-color: var(--sv-border-aaa); background: var(--white); }
        .workload-loose-item { display: inline-flex; align-items: center; gap: 3px; }
        /* Loose strips are grouped client then parent issue, so the chip row
           stops being one flat wrap and becomes a column of client cards.
           Kept deliberately dense: these two strips are a queue someone scans
           top to bottom, so every row of padding is a row of scrolling. */
        .wl-loose-clients { flex-direction: column; align-items: stretch; gap: 7px; }
        .wl-loose-client { border: 1px solid var(--border); border-radius: 7px; background: var(--bg); padding: 6px 8px; }
        .workload-undated .wl-loose-client { background: var(--white); }
        .wl-loose-client-head { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
        .wl-loose-client-name { font-size: 0.75rem; font-weight: 800; color: var(--text-primary); }
        .wl-loose-client-count { border-radius: 4px; padding: 0 5px; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em; background: var(--border); color: var(--text-secondary); }
        .wl-loose-parents { display: flex; flex-direction: column; gap: 5px; }
        .wl-loose-parent { border-left: 2px solid var(--border); padding-left: 8px; }
        .wl-loose-parent-head { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-bottom: 4px; }
        .wl-loose-parent-ident { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.03em; color: var(--sv-fg-6c5ce7); }
        .wl-loose-parent-title { font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); overflow-wrap: anywhere; }
        .wl-loose-parent-title-none { font-style: italic; color: var(--text-muted); font-weight: 500; }
        .wl-loose-parent-count { border-radius: 4px; padding: 0 5px; font-size: 0.6rem; font-weight: 800; background: var(--white); border: 1px solid var(--border); color: var(--text-muted); }
        .workload-undated .wl-loose-parent-count { background: var(--bg); }
        .wl-loose-parent-chips { gap: 4px; }
        .wl-loose-open { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--sv-border-6c5ce7); border-radius: 5px; padding: 2px 7px; background: var(--white); color: var(--sv-fg-6c5ce7); font-size: 0.63rem; font-weight: 800; text-decoration: none; transition: all 0.13s; }
        .wl-loose-open svg { width: 9px; height: 9px; flex-shrink: 0; }
        .wl-loose-open:hover { background: var(--bg); border-color: var(--sv-fg-6c5ce7); }
        /* Linear stays reachable but visually subordinate: a bare glyph, no
           pill of its own, so the escape hatch costs a click and not a row. */
        .workload-calendar-module { overflow: visible; background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 14px; }
        .workload-calendar-heading { position: relative; min-height: 34px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
        .workload-calendar-heading h2 { margin: 0; color: var(--text-primary); font-size: 1.45rem; font-weight: 850; letter-spacing: -0.025em; text-align: center; }
        .workload-calendar-heading .workload-weekend-notice { position: absolute; right: 0; margin-left: 0; }
        .workload-calendar-module .workload-title { font-size: 1rem; }
        .workload-calendar-module > .workload-toolbar { margin-bottom: 12px; }
        .workload-calendar-module #wlBody > .workload-grid-wrap { border: 0; border-radius: 0; padding: 0; background: transparent; }
        .workload-grid-wrap { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 10px; }
        .workload-deadline-mode button { padding-inline: 10px; }
        .workload-pills button:disabled { opacity: 0.42; cursor: not-allowed; }
        .workload-weekdays { display: grid; gap: 4px; margin-bottom: 6px; }
        .workload-weekdays.month { grid-template-columns: repeat(7, 1fr); }
        .workload-weekdays.week { grid-template-columns: repeat(5, 1fr); }
        .workload-weekday { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); text-align: center; padding: 6px 0; }
        .workload-grid { display: grid; gap: 4px; }
        .workload-grid.month { grid-template-columns: repeat(7, 1fr); grid-auto-rows: minmax(140px, auto); }
        .workload-grid.week  { grid-template-columns: repeat(5, 1fr); grid-auto-rows: minmax(420px, auto); }
        .workload-day { padding: 8px 10px; border-radius: 8px; background: var(--bg); overflow: hidden; display: flex; flex-direction: column; gap: 5px; min-height: 140px; }
        .workload-grid.week .workload-day { min-height: 420px; gap: 6px; padding: 10px 12px; }
        .workload-day.today { outline: 2px solid var(--text-primary); }
        .workload-day.out-of-month { opacity: 0.4; }
        .workload-day.weekend { background: transparent; border: 1px dashed var(--border-light); }
        .workload-day.is-plan-drop-target { box-shadow: inset 0 0 0 2px var(--sv-border-6c5ce7); background: var(--sv-bg-ecedfb); }
        .workload-day-num { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); margin-bottom: 2px; display: flex; justify-content: space-between; align-items: center; }
        .workload-grid.week .workload-day-num { font-size: 0.85rem; margin-bottom: 4px; }
        .workload-day.today .workload-day-num { color: var(--text-primary); }
        .workload-day-count { font-size: 0.6rem; font-weight: 600; color: var(--text-muted); background: var(--white); border-radius: 999px; padding: 1px 6px; }
        .workload-day-card { background: var(--white); border-left: 3px solid var(--sv-border-6c5ce7); border-radius: 6px; padding: 6px 8px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .workload-day-card.team-video    { border-left-color: var(--sv-border-6c5ce7); }
        .workload-day-card.team-graphics { border-left-color: var(--sv-border-d97706); }
        .workload-grid.week .workload-day-card { padding: 8px 10px; gap: 6px; }
        .workload-day-card-head { display: flex; align-items: center; gap: 6px; min-width: 0; }
        .workload-day-card-name { flex: 1; font-size: 0.7rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        .workload-grid.week .workload-day-card-name { font-size: 0.78rem; }
        .workload-day-card-total { background: var(--bg); border: 0; border-radius: 999px; padding: 1px 7px; font-family: inherit; font-size: 0.6rem; font-weight: 800; color: var(--text-secondary); flex-shrink: 0; cursor: pointer; transition: background 0.1s; }
        .workload-day-card-total:hover { background: var(--white); box-shadow: 0 0 0 1px var(--border) inset; color: var(--text-primary); }
        .workload-day-card-total.over-capacity { color: var(--wl-status-fg); background: var(--wl-overdue-accent); }
        .workload-day-card-total.over-capacity:hover { color: var(--wl-status-fg); background: var(--wl-overdue-accent-hover); box-shadow: none; }
        /* Editor exception pills — the same three queues as the Team workload
           matrix, on their own row under the editor name so the name keeps its
           full width. Outlined rather than filled: the filled treatment is
           already spoken for by the over-capacity badge on the row above. */
        .workload-day-card-status { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; min-width: 0; }
        .wl-day-status-pill { display: inline-flex; align-items: center; gap: 3px; flex-shrink: 0; padding: 1px 6px 1px 5px; border: 0; border-radius: 999px; background: transparent; box-shadow: inset 0 0 0 1px var(--wl-pill-border); color: var(--wl-pill-label); font: inherit; font-size: 0.58rem; font-weight: 850; font-variant-numeric: tabular-nums; line-height: 1.55; cursor: pointer; transition: background 0.1s, box-shadow 0.1s; }
        .wl-day-status-pill::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--wl-pill-accent); flex: 0 0 5px; }
        .wl-day-status-pill:hover { background: var(--bg); box-shadow: inset 0 0 0 1.5px var(--wl-pill-accent); }
        .wl-day-status-pill:focus-visible { outline: 2px solid var(--sv-border-4f46e5); outline-offset: 1px; }
        .wl-day-status-pill.is-overdue { --wl-pill-accent: var(--wl-overdue-accent); --wl-pill-border: var(--wl-overdue-border); --wl-pill-label: var(--wl-overdue-label); }
        .wl-day-status-pill.is-tweaks { --wl-pill-accent: var(--wl-tweaks-accent); --wl-pill-border: var(--wl-tweaks-border); --wl-pill-label: var(--wl-tweaks-label); }
        .wl-day-status-pill.is-inprogress { --wl-pill-accent: var(--wl-progress-accent); --wl-pill-border: var(--wl-progress-border); --wl-pill-label: var(--wl-progress-label); }
        .workload-grid.week .wl-day-status-pill { font-size: 0.62rem; }
        .workload-day-card-clients { display: flex; flex-wrap: wrap; gap: 3px; }
        .workload-day-client-group { min-width: 0; }
        .workload-day-client-group[open] { flex-basis: 100%; }
        .workload-day-card-chip { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px; padding: 3px 7px; border-radius: 8px; background: var(--bg); color: var(--text-primary); font-size: 0.62rem; font-weight: 600; text-decoration: none; max-width: 100%; transition: background 0.1s; cursor: pointer; list-style: none; }
        .workload-day-card-chip::-webkit-details-marker { display: none; }
        .workload-grid.week .workload-day-card-chip { font-size: 0.7rem; padding: 3px 9px; }
        .workload-day-card-chip:hover { background: var(--sv-bg-fff); box-shadow: 0 0 0 1px var(--border) inset; }
        .workload-day-card-chip-main { display: inline-flex; align-items: center; gap: 4px; min-width: 0; max-width: 100%; }
        .workload-day-card-chip-meta { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 3px; max-width: 100%; }
        .workload-day-card-chip-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        .workload-day-card-chip-count { color: var(--text-primary); font-weight: 800; opacity: 1; flex-shrink: 0; cursor: pointer; padding: 0 1px; }
        html[data-theme="dark"] .workload-day-card-chip-count { color: var(--sv-fg-fff); }
        .workload-day-card-chip.is-dragging { opacity: 0.45; }
        .workload-day-card-items { display: flex; flex-direction: column; gap: 4px; margin-top: 3px; }
        .workload-day-client-group[open] > .workload-day-card-items,
        .workload-timeline-source[open] > .workload-timeline-items { padding-left: 14px; }
        .workload-day-client-group[open] > .workload-day-card-items .workload-plan-item-wrap,
        .workload-timeline-source[open] > .workload-timeline-items .workload-plan-item-wrap { position: relative; }
        .workload-day-client-group[open] > .workload-day-card-items .workload-plan-item-wrap::before,
        .workload-timeline-source[open] > .workload-timeline-items .workload-plan-item-wrap::before { content: ''; position: absolute; left: -14px; top: -5px; width: 11px; height: calc(50% + 5px); border-left: 1px solid var(--border); border-bottom: 1px solid var(--border); border-bottom-left-radius: 7px; pointer-events: none; }
        .workload-day-client-group[open] > .workload-day-card-items .workload-plan-item-wrap:not(:last-child)::after,
        .workload-timeline-source[open] > .workload-timeline-items .workload-plan-item-wrap:not(:last-child)::after { content: ''; position: absolute; left: -14px; top: 50%; bottom: -6px; border-left: 1px solid var(--border); pointer-events: none; }
        .workload-plan-item-wrap { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .workload-plan-item { width: 100%; display: flex; align-items: flex-start; gap: 7px; min-width: 0; padding: 4px 6px 4px 9px; border: 1px solid transparent; border-radius: 6px; background: var(--bg); color: var(--text-primary); font: inherit; font-size: 0.61rem; font-weight: 650; text-align: left; cursor: pointer; }
        .workload-grid.week .workload-plan-item { font-size: 0.68rem; padding: 5px 7px 5px 10px; }
        .workload-plan-item:hover { background: var(--white); border-color: var(--border); }
        .workload-plan-item:focus-visible { outline: 2px solid var(--sv-border-4f46e5); outline-offset: 1px; }
        .workload-plan-item.is-dragging { opacity: 0.45; }
        .workload-plan-item-content { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
        .workload-plan-item-title-line { display: flex; align-items: center; gap: 6px; min-width: 0; }
        .workload-plan-item-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        .workload-plan-item-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 3px; }
        .workload-plan-item-arrow { color: var(--text-muted); font-size: 0.58rem; }
        .workload-plan-item-title-line .wl-plan-origin { margin-left: auto; }
        .workload-drag-handle { width: 24px; height: 24px; margin: -3px -3px -3px 0; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 24px; border-radius: 6px; color: var(--text-muted); cursor: grab; opacity: 0.62; touch-action: none; }
        .workload-drag-handle:hover { background: var(--white); color: var(--sv-fg-5e6ad2); opacity: 1; }
        .workload-drag-handle:active { cursor: grabbing; }
        .workload-drag-handle svg { width: 15px; height: 15px; display: block; }

        /* Show-deadlines Week view: each planned editor/client group owns one
           fixed row, so its deadline relationships stay straight at every
           width. Deadline endpoints are reference-only and never participate
           in workload counts or drag writes. */
        .workload-timeline-wrap { --wl-editor-rail: 130px; --wl-timeline-days-min: 800px; overflow-x: auto; overscroll-behavior-inline: contain; scroll-padding-inline-start: calc(var(--wl-editor-rail) + 10px); }
        .workload-timeline-header, .workload-timeline-stage { min-width: calc(var(--wl-editor-rail) + var(--wl-timeline-days-min)); }
        .workload-timeline-header { display: grid; grid-template-columns: var(--wl-editor-rail) minmax(var(--wl-timeline-days-min), 1fr); gap: 0; margin-bottom: 6px; }
        .workload-timeline-weekdays { min-width: 0; margin-bottom: 0; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; }
        .workload-timeline-editor-rail { position: sticky; left: 0; z-index: 6; box-sizing: border-box; background: var(--surface-raised); }
        .workload-timeline-editor-rail-head { z-index: 8; min-height: 32px; border-right: 1px solid var(--border); }
        .workload-timeline-weekday.today { color: var(--focus-ring); background: var(--wl-timeline-today-bg); border-radius: 7px 7px 0 0; }
        .workload-timeline-today-marker { color: inherit; font-weight: 850; letter-spacing: 0.1em; }
        .workload-timeline-stage { position: relative; min-height: 420px; overflow: visible; border-radius: 8px; }
        .workload-timeline-day-columns { position: absolute; top: 0; right: 0; bottom: 0; left: var(--wl-editor-rail); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; pointer-events: none; }
        .workload-timeline-day { min-width: 0; background: var(--bg); border-left: 1px solid var(--border-light); pointer-events: auto; }
        .workload-timeline-day:first-child { border-radius: 8px 0 0 8px; }
        .workload-timeline-day:last-child { border-radius: 0 8px 8px 0; }
        .workload-timeline-day.today { background: var(--wl-timeline-today-bg); }
        .workload-timeline-day.weekend { background: transparent; border: 1px dashed var(--border-light); }
        .workload-timeline-day.is-plan-drop-target { box-shadow: inset 0 0 0 2px var(--sv-border-6c5ce7); background: var(--sv-bg-ecedfb); }
        .workload-timeline-editors { position: relative; z-index: 2; }
        .workload-timeline-editor { position: relative; display: grid; grid-template-columns: var(--wl-editor-rail) minmax(0, 1fr); padding: 7px 0 10px; }
        .workload-timeline-editor + .workload-timeline-editor { border-top: 1px solid var(--border); padding-top: 11px; }
        .workload-timeline-editor:nth-child(even) .workload-timeline-day-lane { background: var(--wl-timeline-lane-alt-bg); }
        .workload-timeline-day-lane { grid-column: 2; min-width: 0; border-radius: 0 8px 8px 0; }
        .workload-timeline-editor-head { position: relative; z-index: 4; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; align-items: center; margin-bottom: 6px; }
        .workload-timeline-editor-banner { grid-column: 1; align-self: stretch; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 7px; padding: 14px 10px; border: 1px solid var(--border); border-left: 4px solid var(--sv-border-6c5ce7); border-radius: 8px 0 0 8px; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
        .workload-timeline-editor.team-graphics .workload-timeline-editor-banner { border-left-color: var(--sv-border-d97706); }
        .workload-timeline-editor-day { min-width: 0; min-height: 24px; padding: 0 9px; display: flex; align-items: center; justify-content: flex-end; gap: 5px; }
        .workload-timeline-editor-kicker { color: var(--text-muted); font-size: 0.5rem; font-weight: 800; letter-spacing: 0.09em; line-height: 1; text-transform: uppercase; }
        .workload-timeline-editor-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary); font-size: 0.76rem; font-weight: 850; }
        .workload-timeline-day-total { border: 0; border-radius: 999px; padding: 2px 6px; background: var(--white); box-shadow: 0 0 0 1px var(--border-light); color: var(--text-secondary); font: inherit; font-size: 0.56rem; font-weight: 800; cursor: pointer; white-space: nowrap; }
        .workload-timeline-day-total.over-capacity { color: var(--wl-status-fg); background: var(--wl-overdue-accent); box-shadow: none; }
        .workload-timeline-relationship { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; min-height: var(--wl-track-height); border-bottom: 1px solid var(--border-light); }
        .workload-timeline-relationship:last-child { border-bottom: 0; }
        .workload-timeline-lines { position: absolute; inset: 0 0 auto; z-index: 1; width: 100%; height: var(--wl-track-height); overflow: visible; pointer-events: none; color: var(--text-muted); opacity: 1; }
        .workload-timeline-lines line { vector-effect: non-scaling-stroke; }
        .workload-timeline-connector.is-red { color: var(--wl-proximity-red); }
        .workload-timeline-connector.is-orange { color: var(--wl-proximity-orange); }
        .workload-timeline-connector.is-green { color: var(--wl-proximity-green); }
        .workload-timeline-source { position: relative; z-index: 3; grid-row: 1; min-width: 0; min-height: var(--wl-track-height); }
        .workload-timeline-plan-chip { position: absolute; left: 8px; right: 8px; top: var(--wl-source-top); min-height: 34px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 4px; padding: 5px 8px; border: 1px solid var(--border); border-left: 3px solid var(--sv-border-6c5ce7); border-radius: 8px; background: var(--white); color: var(--text-primary); font-size: 0.61rem; font-weight: 700; list-style: none; cursor: pointer; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
        .workload-timeline-wrap .workload-timeline-plan-chip, .workload-timeline-wrap .workload-timeline-due, .workload-timeline-wrap .workload-timeline-day-total, .workload-timeline-wrap .workload-plan-item { scroll-margin-inline-start: calc(var(--wl-editor-rail) + 10px); }
        .workload-timeline-plan-chip::-webkit-details-marker { display: none; }
        .workload-timeline-plan-chip.is-dragging { opacity: 0.45; }
        .workload-timeline-source[open] .workload-timeline-plan-chip { background: var(--sv-bg-fff); }
        .workload-timeline-items { margin: var(--wl-track-height) 8px 8px; display: flex; flex-direction: column; gap: 4px; }
        .workload-timeline-endpoint-slot { position: relative; z-index: 3; grid-row: 1; min-width: 0; min-height: var(--wl-track-height); pointer-events: none; }
        .workload-timeline-due { position: absolute; left: 8px; right: 8px; top: var(--wl-endpoint-top); min-height: 32px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 4px; padding: 4px 7px; border: 1px dashed currentColor; border-radius: 8px; background: var(--white); color: var(--text-muted); font: inherit; font-size: 0.59rem; font-weight: 750; cursor: pointer; pointer-events: auto; }
        .workload-timeline-due.is-red { color: var(--sv-fg-991b1b); border-color: var(--sv-border-fecaca); --wl-proximity-dot: var(--wl-proximity-red); }
        .workload-timeline-due.is-orange { color: var(--sv-fg-9a3412); border-color: var(--sv-border-fed7aa); --wl-proximity-dot: var(--wl-proximity-orange); }
        .workload-timeline-due.is-green { color: var(--sv-fg-166534); border-color: var(--sv-border-bbf7d0); --wl-proximity-dot: var(--wl-proximity-green); }
        .workload-timeline-due .wl-deadline-dot { box-shadow: none; }
        .workload-timeline-due-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .workload-timeline-due-count { opacity: 0.65; white-space: nowrap; }
        .workload-timeline-continuation { font-size: 0.54rem; }
        .workload-timeline-empty { position: relative; z-index: 2; margin-left: var(--wl-editor-rail); padding: 36px 16px; color: var(--text-muted); font-size: 0.75rem; text-align: center; }
        .workload-timeline-same-day { display: inline-flex; align-items: center; gap: 4px; color: var(--text-muted); font-size: 0.52rem; font-weight: 800; white-space: nowrap; flex-shrink: 0; }
        .workload-timeline-same-day.is-red { color: var(--sv-fg-dc2626); --wl-proximity-dot: var(--wl-proximity-red); }
        .workload-timeline-same-day.is-orange { color: var(--sv-fg-ea580c); --wl-proximity-dot: var(--wl-proximity-orange); }
        .workload-timeline-same-day.is-green { color: var(--sv-fg-16a34a); --wl-proximity-dot: var(--wl-proximity-green); }
        .workload-timeline-same-day .wl-deadline-dot { box-shadow: none; }
        /* Spotlight: while a popover is open, dim everything that isn't part
           of the clicked rollup. The CSS does the dimming via one attribute on
           the grid wrapper; a per-element data-wl-match opts back in. */
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card,
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card-chip,
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-plan-chip,
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-due,
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-day-total,
        .workload-grid-wrap[data-wl-spotlight] .workload-plan-item,
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card-total { transition: opacity 0.15s ease; opacity: 0.22; }
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card[data-wl-match="1"] { opacity: 1; }
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card[data-wl-match="1"] .workload-day-card-chip,
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card[data-wl-match="1"] .workload-day-card-total { opacity: 0.4; }
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card-chip[data-wl-match="1"],
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-plan-chip[data-wl-match="1"],
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-due[data-wl-match="1"],
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-day-total[data-wl-match="1"],
        .workload-grid-wrap[data-wl-spotlight] .workload-plan-item[data-wl-match="1"],
        .workload-grid-wrap[data-wl-spotlight] .workload-day-card-total[data-wl-match="1"] { opacity: 1; }
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-lines [data-wl-deadline-ids] { opacity: 0.18; }
        .workload-grid-wrap[data-wl-spotlight] .workload-timeline-lines [data-wl-deadline-ids][data-wl-match="1"] { opacity: 0.8; }
        .workload-rollup { display: flex; flex-direction: column; gap: 2px; padding: 6px 8px; border-radius: 6px; background: var(--white); cursor: pointer; border-left: 3px solid transparent; transition: background 0.1s; min-width: 0; text-decoration: none; color: var(--text-primary); }
        .workload-grid.week .workload-rollup { padding: 8px 10px; }
        .workload-rollup:hover { background: var(--sv-bg-fafafa); }
        .workload-rollup.team-video    { border-left-color: var(--sv-border-6c5ce7); }
        .workload-rollup.team-graphics { border-left-color: var(--sv-border-d97706); }
        .workload-rollup.in-progress   { background: var(--wl-progress-section-bg); border-left-color: var(--wl-progress-accent) !important; }
        .workload-rollup.in-progress:hover { background: var(--wl-progress-chip-bg); }
        .workload-rollup-row           { display: flex; align-items: center; gap: 6px; min-width: 0; }
        .workload-rollup-editor        { font-size: 0.68rem; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1; }
        .workload-rollup-now-tag       { font-size: 0.56rem; font-weight: 800; color: var(--sv-fg-ca8a04); letter-spacing: 0.1em; text-transform: uppercase; flex-shrink: 0; }
        .workload-rollup-client        { font-size: 0.72rem; font-weight: 500; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1; }
        .workload-grid.week .workload-rollup-editor { font-size: 0.72rem; }
        .workload-grid.week .workload-rollup-client { font-size: 0.76rem; }
        .workload-rollup .rollup-count  { background: var(--bg); border: 1px solid transparent; border-radius: 999px; padding: 1px 8px; font-size: 0.64rem; font-weight: 700; color: var(--text-secondary); flex-shrink: 0; cursor: pointer; transition: all 0.1s; }
        .workload-rollup .rollup-count:hover { background: var(--white); border-color: var(--border); color: var(--text-primary); }
        .workload-rollup.in-progress .rollup-count { background: var(--wl-progress-accent); color: var(--wl-status-fg); }
        .workload-rollup.in-progress .rollup-count:hover { background: var(--wl-progress-accent-hover); border-color: var(--wl-progress-accent); color: var(--wl-status-fg); }
        .editor-dot { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: var(--bg); font-size: 0.58rem; font-weight: 700; color: var(--text-primary); flex-shrink: 0; border: 1px solid var(--border); }
        .workload-legend { display: flex; gap: 14px; margin-top: 12px; font-size: 0.7rem; color: var(--text-muted); flex-wrap: wrap; }
        .workload-legend-item { display: inline-flex; align-items: center; gap: 6px; }
        .workload-legend-swatch { width: 10px; height: 10px; border-radius: 2px; }
        .workload-empty { padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 0.85rem; }
        .workload-error { padding: 16px; border-radius: 10px; background: var(--sv-bg-fef2f2); border: 1px solid var(--sv-border-fecaca); color: var(--sv-fg-991b1b); font-size: 0.82rem; font-weight: 500; }
