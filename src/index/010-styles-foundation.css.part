            --sv-bg-ededea: #ededea;
            --sv-bg-eef0fe: #eef0fe;
            /* Vibrant accent pair for the two asset slots: the Thumbnail
               field and its Production button share blue, the Video field
               and its Production button share pink, so each field and its
               square button read as one thing. */
            --sv-slot-thumb-fg: #3737f2;
            --sv-slot-thumb-bg: #e2e4ff;
            --sv-slot-thumb-bg-hover: #cdd1ff;
            --sv-slot-thumb-fg-soft: #5b5be8;
            --sv-slot-thumb-border: #ccceff;
            /* Measured against the pill background, not eyeballed: the label is
               0.72rem body text, so it needs 4.5:1. The first vivid pink tried
               here reached only 3.72:1 (the pre-2026-09-14 pair managed
               4.73:1) -- the vibrancy came straight out of the contrast
               budget. The value below is 5.47:1 on the pill and 4.69:1 on the
               HOVER background, which is the darker of the two and the one a
               label-only check misses, and still reads as the same hot pink.
               The -soft tone carries icon-only buttons, which need 3:1, on
               both backgrounds. */
            --sv-slot-video-fg: #b21060;
            --sv-slot-video-bg: #ffe0ef;
            --sv-slot-video-bg-hover: #ffc9e2;
            --sv-slot-video-fg-soft: #d62d79;
            --sv-slot-video-border: #ffc9e2;
