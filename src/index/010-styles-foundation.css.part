            --cal-status-in-progress-bg: #fde047; --cal-status-in-progress-fg: #101114; --cal-status-for-smm-approval-bg: #e879f9; --cal-status-for-smm-approval-fg: #101114; --cal-status-kasper-approval-bg: #93c5fd; --cal-status-kasper-approval-fg: #101114; --cal-status-client-approval-bg: #ff6b6b; --cal-status-client-approval-fg: #101114; --cal-status-approved-bg: #4ade80; --cal-status-approved-fg: #101114; --cal-status-tweaks-needed-bg: #fb923c; --cal-status-tweaks-needed-fg: #101114; --cal-status-scheduled-bg: #60a5fa; --cal-status-scheduled-fg: #101114; --cal-status-posted-bg: #047857; --cal-status-posted-fg: #ffffff; --cal-status-archived-bg: #9ca3af; --cal-status-archived-fg: #101114; --cal-status-n-a-bg: #9ca3af; --cal-status-n-a-fg: #101114;
            --cal-urgent-bg: #ff5a36; --cal-urgent-hover-bg: #f0442d; --cal-urgent-fg: #101114; --cal-urgent-disabled-bg: #9ca3af; --cal-urgent-sent-bg: #4ade80;
            /* Video and Thumbnail share the same vibrant pink/blue pair the
               link fields use (--sv-slot-video-fg / --sv-slot-thumb-fg,
               defined below) instead of their own independent cyan/fuchsia --
               those never matched the fields and, worse, paired the wrong way
               round: Video's dot read blue-ish and Thumbnail's read pink-ish,
               backwards from the fields sitting right below them on the same
               card. One token per concept now. */
            --cal-comp-video-dot: var(--sv-slot-video-fg); --cal-comp-graphic-dot: var(--sv-slot-thumb-fg); --cal-comp-caption-dot: var(--sv-misc-f59e0b); --cal-comp-title-dot: var(--sv-misc-ef4444); --cal-comp-dot-ring: var(--sv-shadow-rgba-255-255-255-0_55);
            --cal-notes-accent: var(--sv-bg-ea580c); --cal-notes-accent-fg: var(--sv-fg-c2410c); --cal-notes-open-bg: var(--sv-bg-fff5e6); --cal-notes-count-fg: var(--sv-fg-fff); --cal-notes-dot-bg: var(--sv-bg-ea580c); --cal-notes-dot-ring: rgba(0,0,0,0); --cal-notes-dot-glow: rgba(234,88,12,0);
