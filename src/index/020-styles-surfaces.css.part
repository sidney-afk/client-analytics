        /* ── Templates view ── */
        @media (max-width: 768px) {
            .workload-grid-wrap { overflow-x: auto; overscroll-behavior-inline: contain; }
            .workload-weekdays.week, .workload-grid.week { min-width: 800px; }
            .workload-weekdays.month, .workload-grid.month { min-width: 840px; }
            .workload-popover { width: min(360px, calc(100vw - 20px)); min-width: 0; max-width: none; box-sizing: border-box; }
            .workload-calendar-heading { flex-direction: column; gap: 8px; }
            .workload-calendar-heading .workload-weekend-notice { position: static; }
        }

        .tpl-view { max-width: 980px; margin: 24px auto 80px; padding: 0 28px; font-family: 'Plus Jakarta Sans', sans-serif; }
        .tpl-index-centered { min-height: calc(100vh - 200px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 24px; gap: 0; }
        .tpl-index-centered .tpl-index-title { font-size: 1.85rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 6px; text-align: center; }
        .tpl-index-centered .tpl-index-sub { font-size: 0.86rem; color: var(--text-secondary); margin-bottom: 22px; max-width: 460px; text-align: center; line-height: 1.5; }
        .tpl-index-centered .search-bar-wrap { width: min(440px, 100%); }
        .tpl-index-centered .search-bar-pill { width: 100%; }
        .tpl-pins-area { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 30px; max-width: 640px; width: 100%; }
        .tpl-pins-label { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-muted); }

        /* Per-client */
        .tpl-client-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 12px 0 22px; }
        .tpl-client-name { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.015em; }
        .tpl-head-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        .tpl-head-actions { display: flex; align-items: center; gap: 12px; }

        .tpl-edit-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 99px; background: var(--white); border: 1.5px solid var(--border); font-family: inherit; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); cursor: pointer; transition: all 0.15s; }
        .tpl-edit-btn:hover { border-color: var(--sv-border-111110); transform: translateY(-1px); box-shadow: 0 3px 8px var(--sv-shadow-rgba-0-0-0-0_06); }
        .tpl-edit-btn.done { background: var(--sv-bg-111110); color: var(--sv-fg-fff); border-color: var(--sv-border-111110); }
        .tpl-edit-btn.done:hover { background: var(--sv-bg-2a2a28); }

        .tpl-status-badge { font-size: 0.72rem; font-weight: 600; color: var(--text-muted); display: inline-flex; align-items: center; gap: 6px; min-height: 18px; }
        /* Empty status badge would otherwise still be a flex child and take
           a gap slot in the toolbar — visible as an extra ~10px gap between
           the bulk-action buttons and the kebab. Hide it until it carries
           text so the toolbar spacing stays uniform. */
        .tpl-status-badge:empty { display: none; }
        .tpl-status-badge.saving { color: var(--sv-fg-6b6b67); }
        .tpl-status-badge.saved  { color: var(--sv-fg-10b981); }
        .tpl-status-badge.error  { color: var(--sv-fg-dc2626); }
        .tpl-status-badge .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: 0.7; }
        .tpl-status-badge.saving .dot { animation: tpl-pulse 1s ease-in-out infinite; }
        @keyframes tpl-pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

        .tpl-toggle-row { display: inline-flex; background: var(--white); border: 1px solid var(--border); border-radius: 99px; padding: 4px; gap: 2px; margin: 4px 0 18px; }
        .tpl-toggle-btn { border: none; background: transparent; padding: 8px 18px; border-radius: 99px; font-family: inherit; font-size: 0.84rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; }
        .tpl-toggle-btn.active { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }

        .tpl-section { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 20px 22px; margin-bottom: 14px; }
        .tpl-section-title { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 14px; }

        /* Filming-plans card (view mode top callout, but not yellow) */
        .tpl-filming-card { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-radius: 14px; background: var(--white); border: 1px solid var(--border); text-decoration: none; color: var(--text-primary); margin-bottom: 18px; transition: all 0.15s; }
        .tpl-filming-card:hover { border-color: var(--sv-border-111110); transform: translateY(-1px); box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_06); }
        .tpl-filming-card.empty { color: var(--text-muted); cursor: default; }
        .tpl-filming-card.empty:hover { border-color: var(--border); transform: none; box-shadow: none; }
        .tpl-filming-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--bg); display: inline-flex; align-items: center; justify-content: center; color: var(--text-secondary); flex-shrink: 0; }
        .tpl-filming-card:hover .tpl-filming-icon { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .tpl-filming-card.empty:hover .tpl-filming-icon { background: var(--bg); color: var(--text-secondary); }
        .tpl-filming-text { display: flex; flex-direction: column; gap: 2px; flex: 1; }
        .tpl-filming-title { font-size: 0.92rem; font-weight: 700; letter-spacing: -0.005em; color: var(--text-primary); }
        .tpl-filming-card.empty .tpl-filming-title { color: var(--text-secondary); }
        .tpl-filming-host { font-size: 0.74rem; color: var(--text-muted); }
        .tpl-filming-arrow { color: var(--text-muted); flex-shrink: 0; transition: transform 0.15s; }
        .tpl-filming-card:hover .tpl-filming-arrow { transform: translate(2px, -2px); color: var(--sv-fg-111110); }

        /* View-mode value display */
        .tpl-view-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; }
        @media (max-width: 640px) { .tpl-view-grid { grid-template-columns: 1fr; gap: 18px; } }
        .tpl-view-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .tpl-view-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .tpl-view-value { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); letter-spacing: -0.005em; word-break: break-word; }
        .tpl-not-set { color: var(--text-muted); font-weight: 500; font-style: italic; }
        .tpl-view-color-row { display: inline-flex; align-items: center; gap: 10px; }
        .tpl-view-swatch { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--sv-shadow-rgba-0-0-0-0_10), 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_08); flex-shrink: 0; }
        .tpl-view-swatch-empty { background: repeating-linear-gradient(45deg, var(--bg) 0 4px, var(--border-light) 4px 8px); }
        .tpl-view-color-hex { font-family: 'SF Mono', Menlo, Consolas, monospace; font-size: 0.86rem; font-weight: 600; letter-spacing: 0.02em; }
        .tpl-view-link { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 99px; background: var(--bg); color: var(--text-primary); text-decoration: none; font-size: 0.82rem; font-weight: 600; transition: all 0.13s; }
        .tpl-view-link:hover { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .tpl-view-link-host { color: var(--text-muted); font-weight: 500; font-size: 0.74rem; }
        .tpl-view-link:hover .tpl-view-link-host { color: var(--sv-fg-rgba-255-255-255-0_7); }
        .tpl-view-prose { font-size: 0.92rem; line-height: 1.6; color: var(--text-primary); white-space: pre-wrap; word-wrap: break-word; }
        .tpl-view-prose-empty { color: var(--text-muted); font-style: italic; font-size: 0.88rem; }

        /* Edit-mode inputs */
        .tpl-fields { display: grid; gap: 14px; }
        .tpl-fields.two { grid-template-columns: 1fr 1fr; }
        @media (max-width: 640px) { .tpl-fields.two { grid-template-columns: 1fr; } }

        .tpl-field { display: flex; flex-direction: column; gap: 6px; }
        .tpl-field-label { font-size: 0.74rem; font-weight: 700; color: var(--text-secondary); }
        .tpl-input, .tpl-textarea { width: 100%; border: 1.5px solid transparent; background: var(--field-bg); border-radius: 8px; padding: 10px 12px; font-family: inherit; font-size: 0.88rem; color: var(--text-primary); transition: border-color 0.13s, background 0.13s; outline: none; resize: none; }
        .tpl-input:hover, .tpl-textarea:hover { background: var(--field-bg-hover); }
        .tpl-input:focus, .tpl-textarea:focus { border-color: var(--field-border-focus); background: var(--field-bg-focus); }
        .tpl-input::placeholder, .tpl-textarea::placeholder { color: var(--text-muted); font-weight: 500; }
        .tpl-textarea { min-height: 90px; line-height: 1.5; }

        /* Inline label + toggle row (for "No highlight" switch) */
        .tpl-field-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .tpl-toggle-mini { display: inline-flex; align-items: center; gap: 7px; cursor: pointer; user-select: none; font-size: 0.7rem; color: var(--text-muted); font-weight: 600; }
        .tpl-toggle-mini input { position: absolute; opacity: 0; pointer-events: none; }
        .tpl-toggle-mini-track { position: relative; width: 26px; height: 14px; border-radius: 7px; background: var(--border); transition: background 0.15s; flex-shrink: 0; }
        .tpl-toggle-mini-thumb { position: absolute; top: 1px; left: 1px; width: 12px; height: 12px; border-radius: 50%; background: var(--sv-bg-fff); transition: left 0.15s; box-shadow: 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_18); }
        .tpl-toggle-mini input:checked ~ .tpl-toggle-mini-track { background: var(--sv-bg-111110); }
        .tpl-toggle-mini input:checked ~ .tpl-toggle-mini-track .tpl-toggle-mini-thumb { left: 13px; }
        .tpl-color-off { opacity: 0.32; pointer-events: none; }

        .tpl-color-row { display: flex; align-items: center; gap: 10px; }
        .tpl-color-swatch { width: 38px; height: 38px; border-radius: 8px; border: 1.5px solid var(--border); padding: 0; cursor: pointer; background: var(--white); flex-shrink: 0; overflow: hidden; }
        .tpl-color-swatch::-webkit-color-swatch-wrapper { padding: 0; }
        .tpl-color-swatch::-webkit-color-swatch { border: none; border-radius: 6px; }
        .tpl-color-hex { flex: 1; }

        .tpl-link-row { display: flex; align-items: stretch; gap: 6px; }
        .tpl-link-row .tpl-input { flex: 1; }
        .tpl-link-open { display: inline-flex; align-items: center; justify-content: center; padding: 0 12px; border-radius: 8px; background: var(--bg); border: 1.5px solid transparent; color: var(--text-secondary); text-decoration: none; transition: all 0.13s; }
        .tpl-link-open:hover { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .tpl-link-open.disabled { opacity: 0.35; pointer-events: none; }

        /* Multiple links per link field — same add/remove UX as color sets. */
        .tpl-links-edit { display: flex; flex-direction: column; gap: 8px; }
        .tpl-link-set-row { display: flex; align-items: center; gap: 8px; }
        .tpl-link-set-row .tpl-link-row { flex: 1; min-width: 0; }
        .tpl-links-edit .tpl-set-remove { margin-top: 0; }
        .tpl-links-edit .tpl-set-add { align-self: flex-start; margin-top: 2px; }
        .tpl-view-links { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }

        /* Skeleton (loading) */
        .tpl-skeleton { --sv-skel-base: var(--bg); --sv-skel-sheen: var(--border-light); background: linear-gradient(90deg, var(--sv-skel-base) 0%, var(--sv-skel-sheen) 48%, var(--sv-skel-base) 100%); background-size: 220% 100%; border-radius: 8px; animation: sv-shimmer 1.35s ease-in-out infinite; }
        .tpl-skeleton-pill { border-radius: 99px; }
        .tpl-skeleton-line { height: 14px; border-radius: 6px; }
        .tpl-skeleton-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 22px; margin-bottom: 14px; }

        /* Color sets — edit mode */
        .tpl-subsection { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border-light); }
        .tpl-subsection-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
        .tpl-subsection-label { font-size: 0.74rem; font-weight: 700; color: var(--text-secondary); }
        .tpl-color-sets-edit { display: flex; flex-direction: column; gap: 10px; }
        .tpl-color-set-row { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; background: var(--bg); border-radius: 10px; }
        .tpl-color-set-row .tpl-set-num { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--white); color: var(--text-muted); font-size: 0.72rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; margin-top: 8px; }
        .tpl-set-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; flex: 1; min-width: 0; }
        @media (max-width: 640px) { .tpl-set-pair { grid-template-columns: 1fr; } }
        .tpl-set-cell { display: flex; flex-direction: column; gap: 4px; }
        .tpl-set-cell-label { font-size: 0.66rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        .tpl-set-cell .tpl-color-row { gap: 8px; }
        .tpl-set-cell .tpl-color-swatch { width: 32px; height: 32px; }
        .tpl-set-remove { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; border: none; background: transparent; color: var(--text-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; margin-top: 8px; transition: all 0.13s; }
        .tpl-set-remove:hover { background: var(--dn-bg); color: var(--dn); }
        .tpl-set-add { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 99px; background: transparent; border: 1.5px dashed var(--border); font-family: inherit; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.13s; margin-top: 4px; }
        .tpl-set-add:hover { border-color: var(--sv-border-111110); color: var(--text-primary); background: var(--white); }
        .tpl-set-add-max { font-size: 0.74rem; color: var(--text-muted); font-style: italic; padding: 6px 4px; }

        /* Color sets — view mode */
        .tpl-view-color-sets-wrap { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border-light); }
        .tpl-view-color-sets-field { display: flex; flex-direction: column; gap: 10px; }
        .tpl-color-sets-view { display: flex; flex-wrap: wrap; gap: 10px; }
        .tpl-color-set-card { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px 7px 8px; border-radius: 99px; background: var(--bg); }
        .tpl-color-set-card .tpl-set-num { width: 18px; height: 18px; border-radius: 50%; background: var(--white); color: var(--text-muted); font-size: 0.66rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }
        .tpl-set-swatches { display: inline-flex; align-items: center; gap: 4px; }
        .tpl-view-swatch-sm { width: 16px; height: 16px; }
        .tpl-set-hex { font-family: 'SF Mono', Menlo, Consolas, monospace; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.02em; color: var(--text-primary); }

        .tpl-config-banner { background: var(--sv-bg-fef3c7); border: 1px solid var(--sv-border-fde68a); color: var(--sv-fg-92400e); border-radius: 12px; padding: 14px 18px; font-size: 0.84rem; line-height: 1.55; margin-bottom: 16px; }
        .tpl-config-banner code { background: var(--sv-bg-rgba-0-0-0-0_07); padding: 2px 6px; border-radius: 4px; font-size: 0.78rem; }

        /* Filming Plans source-of-truth tab */
        .fp-view { max-width: 980px; margin: 22px auto 80px; padding: 0 28px; font-family: 'Plus Jakarta Sans', sans-serif; }
        .fp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
        .fp-title { font-size: 1.65rem; font-weight: 800; letter-spacing: 0; color: var(--text-primary); line-height: 1.12; }
        .fp-sub { margin-top: 4px; font-size: 0.82rem; color: var(--text-secondary); }
        .fp-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
        .fp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 34px; padding: 7px 12px; border-radius: 8px; border: 1px solid var(--border); background: var(--white); color: var(--text-secondary); font-family: inherit; font-size: 0.76rem; font-weight: 700; cursor: pointer; text-decoration: none; transition: border-color 0.13s, color 0.13s, background 0.13s, transform 0.13s; }
        .fp-btn:hover:not(:disabled) { border-color: var(--sv-border-111110); color: var(--text-primary); transform: translateY(-1px); }
        .fp-btn.primary { background: var(--sv-bg-111110); border-color: var(--sv-border-111110); color: var(--sv-fg-fff); }
        .fp-btn.primary:hover:not(:disabled) { background: var(--sv-bg-2a2a28); color: var(--sv-fg-fff); }
        .fp-btn:disabled { opacity: 0.45; cursor: default; transform: none; }
        .fp-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 14px; }
        .fp-toolbar .search-bar-wrap { width: min(440px, 100%); }
        .fp-count { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); white-space: nowrap; }
        .fp-add-card, .fp-row { background: var(--white); border: 1px solid var(--border); border-radius: 12px; }
        .fp-add-card { padding: 14px; margin-bottom: 12px; }
        .fp-form-grid { display: grid; grid-template-columns: minmax(180px, 0.7fr) minmax(240px, 1.3fr); gap: 10px; align-items: end; }
        .fp-form-actions { display: flex; gap: 8px; align-items: center; justify-content: flex-end; margin-top: 10px; }
        .fp-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
        .fp-field label { font-size: 0.66rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0; }
        .fp-input { width: 100%; border: 1.5px solid transparent; background: var(--field-bg); border-radius: 8px; padding: 10px 11px; font-family: inherit; font-size: 0.86rem; color: var(--text-primary); outline: none; transition: border-color 0.13s, background 0.13s; }
        .fp-input:hover { background: var(--field-bg-hover); }
        .fp-input:focus { border-color: var(--field-border-focus); background: var(--field-bg-focus); }
        .fp-list { display: flex; flex-direction: column; gap: 10px; }
        .fp-row { padding: 14px 16px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; }
        .fp-main { min-width: 0; display: flex; align-items: center; gap: 12px; }
        .fp-doc-icon { width: 34px; height: 34px; border-radius: 9px; background: var(--bg); color: var(--text-secondary); display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
        .fp-meta { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
        .fp-name { font-size: 0.94rem; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .fp-url { font-size: 0.74rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .fp-row-actions { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
        .fp-edit { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; padding-top: 12px; border-top: 1px solid var(--border-light); }
        .fp-edit-actions { display: flex; gap: 8px; justify-content: flex-end; }
        .fp-empty { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 36px 20px; text-align: center; color: var(--text-secondary); font-size: 0.86rem; }
        .fp-loading { display: flex; flex-direction: column; gap: 10px; }
        .fp-skel-row { height: 66px; border-radius: 12px; }
        @media (max-width: 760px) {
            .fp-view { padding: 0 18px; }
            .fp-head, .fp-toolbar { flex-direction: column; align-items: stretch; }
            .fp-actions, .fp-form-actions, .fp-edit-actions { justify-content: flex-start; }
            .fp-form-grid { grid-template-columns: 1fr; }
            .fp-row { grid-template-columns: 1fr; }
            .fp-row-actions { justify-content: flex-start; flex-wrap: wrap; }
        }

        /* ── Content Calendar module ──────────────────────────────────────── */
        .cal-view { position: relative; padding: 8px 16px 32px;
            --cal-card-w: 320px; --cal-thumb-h: 240px; --cal-month-w: 146px; --cal-week-h: 224px; }
        .cal-view[data-zoom="s"] { --cal-card-w: 268px; --cal-thumb-h: 178px; --cal-month-w: 116px;  --cal-week-h: 172px; }
        .cal-view[data-zoom="l"] { --cal-card-w: 420px; --cal-thumb-h: 340px; --cal-month-w: 184px; --cal-week-h: 320px; }
        .cal-zoom { display: inline-flex; align-items: center; gap: 2px; background: var(--bg); border-radius: 99px; padding: 3px 6px; }
        .cal-zoom .cal-zoom-ico { width: 14px; height: 14px; color: var(--text-muted); margin: 0 3px; }
        .cal-zoom button { width: 26px; height: 26px; border-radius: 50%; border: 0; background: transparent; cursor: pointer; color: var(--text-secondary); display: inline-flex; align-items: center; justify-content: center; }
        .cal-zoom button:hover:not(:disabled) { background: var(--white); color: var(--text-primary); }
        .cal-zoom button:disabled { opacity: 0.32; cursor: default; }
        .cal-zoom button svg { width: 13px; height: 13px; }
        body.cal-modal-open { overflow: hidden; }
        .cal-toolbar { display: flex; align-items: center; gap: 16px; padding: 12px 14px; background: var(--white); border: 1px solid var(--border); border-radius: 12px; margin: 8px 0 16px; flex-wrap: wrap; }
        /* Calendar page only: collapse the dead vertical space above and below
           the toolbar so the board sits higher and the whole view is shorter.
           Scoped to body.cal-page so the embedded client calendar and every
           other page keep the original .main gutter. */
        body.cal-page .main { padding-top: 12px; }
        body.cal-page .cal-view { padding-top: 0; }
        body.cal-page .cal-toolbar { margin: 0 0 8px; }
        .cal-toolbar-left, .cal-toolbar-mid, .cal-toolbar-right { display: flex; align-items: center; gap: 10px; }
        .cal-toolbar-left  { flex: 1 1 380px; min-width: 0; }
        .cal-toolbar-mid   { flex: 0 0 auto; }
        .cal-toolbar-right { flex: 0 0 auto; }
        .cal-tool-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); flex-shrink: 0; }

        /* Tabs (one per pinned client). Kept to a SINGLE row: the pills live in
           a horizontally-scrollable inner strip (.cal-tabs-scroll). When they
           overflow, a chevron button appears on each scrollable side (+ an edge
           fade so a pill never hard-clips mid-word), so it's obvious there are
           more clients and how to reach them. The add/search button sits OUTSIDE
           the scroller so its dropdown isn't clipped. State is driven by
           _calUpdateTabScroll; the active tab is scrolled into view on render. */
        .cal-tabs { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; min-width: 0; }
        .cal-tabs-scroll { display: flex; align-items: center; gap: 4px; flex-wrap: nowrap; min-width: 0; flex: 0 1 auto;
            overflow-x: auto; overflow-y: hidden; scrollbar-width: none; scroll-behavior: smooth; }
        .cal-tabs-scroll::-webkit-scrollbar { display: none; }
        .cal-tabs-scroll > .cal-tab { flex: 0 0 auto; }
        .cal-tabs > .cal-tab-add-wrap { flex: 0 0 auto; }
        .cal-tabs-scroll.fade-left  { -webkit-mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px); mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px); }
        .cal-tabs-scroll.fade-right { -webkit-mask-image: linear-gradient(to left, transparent, var(--sv-misc-000) 20px); mask-image: linear-gradient(to left, transparent, var(--sv-misc-000) 20px); }
        .cal-tabs-scroll.fade-left.fade-right { -webkit-mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px, var(--sv-misc-000) calc(100% - 20px), transparent); mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px, var(--sv-misc-000) calc(100% - 20px), transparent); }
        .cal-tab-scroll-btn { flex: 0 0 auto; display: none; align-items: center; justify-content: center; width: 26px; height: 26px; padding: 0;
            border-radius: 50%; border: 1px solid var(--border); background: var(--white); box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_1);
            cursor: pointer; color: var(--text-secondary); transition: color 0.12s, border-color 0.12s; }
        .cal-tab-scroll-btn.is-shown { display: inline-flex; }
        .cal-tab-scroll-btn:hover { color: var(--text-primary); border-color: var(--sv-border-999); }
        .cal-tab-scroll-btn svg { width: 12px; height: 12px; display: block; }
        /* Client tabs. Inactive tabs are NEUTRAL (no per-client tint) so the one
           active tab — the only colour-filled one — reads as selected at a
           glance, whatever the client hue. The small dot carries each client's
           identity colour. Softer rounded-rectangle shape (not a full pill). */
        .cal-tab { position: relative; display: inline-flex; align-items: center; gap: 8px;
            padding: 7px 12px 7px 11px; border-radius: 10px; cursor: pointer;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-secondary);
            font-family: inherit; font-size: 0.8rem; font-weight: 600;
            white-space: nowrap; transition: background 0.13s, color 0.13s, border-color 0.13s, box-shadow 0.13s; }
        .cal-tab::before { content: ''; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
            background: hsl(var(--tab-h, 220) 62% 52%); }
        .cal-tab:hover { background: var(--white); border-color: var(--text-muted); color: var(--text-primary); }
        .cal-tab.active { background: hsl(var(--tab-h, 220) 52% 43%); color: var(--sv-fg-fff);
            border-color: hsl(var(--tab-h, 220) 52% 43%); font-weight: 700;
            box-shadow: 0 1px 3px hsl(var(--tab-h, 220) 46% 40% / 0.28); }
        .cal-tab.active::before { background: var(--sv-bg-rgba-255-255-255-0_9); }
        .cal-tab.active:hover { background: hsl(var(--tab-h, 220) 52% 38%); border-color: hsl(var(--tab-h, 220) 52% 38%); }
        html[data-theme="dark"] .cal-tab {
            border-color: var(--border);
            background: transparent;
            color: var(--text-secondary);
        }
        html[data-theme="dark"] .cal-tab::before { background: hsl(var(--tab-h, 220) 56% 60%); }
        html[data-theme="dark"] .cal-tab:hover { background: var(--white); border-color: var(--text-muted); color: var(--text-primary); }
        html[data-theme="dark"] .cal-tab.active {
            background: hsl(var(--tab-h, 220) 50% 44%);
            border-color: hsl(var(--tab-h, 220) 50% 44%);
            color: var(--sv-fg-fff);
            box-shadow: 0 1px 4px hsl(var(--tab-h, 220) 50% 12% / 0.5);
        }
        .cal-tab-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%;
            background: transparent; color: inherit; font-size: 0.85rem; line-height: 1; opacity: 0.45; transition: opacity 0.12s, background 0.12s; }
        .cal-tab:hover .cal-tab-x { opacity: 1; }
        .cal-tab-x:hover { background: var(--sv-bg-rgba-0-0-0-0_15); }
        .cal-tab.active .cal-tab-x:hover { background: var(--sv-bg-rgba-255-255-255-0_25); }
        .cal-tab-add-wrap { position: relative; display: inline-flex; }
        .cal-tab-add { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 14px; border-radius: 10px;
            border: 1.5px dashed var(--sv-border-c7c7c4); background: var(--white); color: var(--text-muted);
            font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; line-height: 1;
            transition: color 0.12s, border-color 0.12s, background 0.12s; }
        .cal-tab-add.no-label { padding: 8px; width: 32px; height: 32px; min-width: 32px; }
        .cal-tab-add:hover { color: var(--text-primary); border-color: var(--text-primary); border-style: solid; }
        .cal-tab-add svg { display: block; }
        .cal-tab-search { position: absolute; top: calc(100% + 6px); left: 0; min-width: 260px; z-index: 80;
            background: var(--white); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 8px 30px var(--sv-shadow-rgba-0-0-0-0_12); padding: 8px; }
        .cal-tab-search .wl-client-search { min-width: 0; width: 100%; }
        .cal-tab-search .wl-client-search-input { width: 100%; font-size: 0.82rem; padding: 9px 14px; border-radius: 99px; }
        .cal-tab-search .wl-client-search-results { position: static; box-shadow: none; padding: 4px 0 0; max-height: 320px; }

        /* Pin row inside the search dropdown */
        .wl-client-search-result.is-pin-row { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding-right: 6px; }
        .wl-client-search-result.is-pin-row > span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .wl-client-search-pin { background: transparent; border: 0; padding: 4px 6px; font-size: 0.9rem; line-height: 1; cursor: pointer; color: var(--text-muted); border-radius: 4px; }
        .wl-client-search-pin:hover { background: var(--bg); color: var(--text-primary); }
        .wl-client-search-pin.pinned { color: var(--sv-fg-d97706); }
        .wl-client-search-result.is-empty-prompt { color: var(--text-muted); font-style: italic; font-weight: 500; cursor: default; padding: 8px 12px; }
        .wl-client-search-section { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); padding: 6px 12px 2px; }
        .wl-client-search-divider { height: 1px; background: var(--border); margin: 4px 6px; }
        .cal-view-toggle { display: inline-flex; background: var(--bg); border-radius: 99px; padding: 3px; }
        .cal-view-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border: none; background: transparent; border-radius: 99px; font-family: inherit; font-size: 0.78rem; font-weight: 700; color: var(--text-muted); cursor: pointer; }
        .cal-view-btn.active { background: var(--white); color: var(--text-primary); box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_06); }
        .cal-view-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 99px; background: var(--sv-bg-ec4899); color: var(--sv-fg-fff); font-size: 0.64rem; font-weight: 800; line-height: 1; }
        .cal-view-btn.active .cal-view-badge { background: var(--sv-bg-db2777); }
        .cal-month-filter { position: relative; display: inline-flex; align-items: center; }
        .cal-month-filter .dropdown-trigger { padding: 8px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); background: var(--bg); box-shadow: none; }
        .cal-month-filter .dropdown-trigger:hover { box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_08); color: var(--text-primary); }
        .cal-month-filter .dropdown-trigger.is-filtered { background: var(--text-primary); color: var(--white); }
        .cal-month-filter .dropdown-trigger.is-filtered:hover { color: var(--white); }
        .cal-month-filter .dropdown-trigger .dd-arrow { font-size: 0.62rem; margin-left: 2px; opacity: 0.55; }
        .cal-month-filter .dropdown-menu { min-width: 200px; max-height: 320px; overflow-y: auto; left: 0; right: auto; padding: 6px; }
        .cal-month-filter .dropdown-item { padding: 8px 12px; font-size: 0.78rem; font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .cal-month-filter .dropdown-item .cal-month-filter-tag { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
        .cal-month-filter .dropdown-item.active .cal-month-filter-tag { color: var(--text-primary); }
        .cal-month-filter-custom { position: relative; cursor: pointer; }
        .cal-month-filter-custom-input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; background: transparent; opacity: 0; cursor: pointer; color: transparent; font-family: inherit; }
        .cal-month-filter-custom-input::-webkit-calendar-picker-indicator { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; opacity: 0; }
        /* Organize menu — one pill holding the Sheet's ordering mode plus the
           month and content filters (it replaced the standalone "All months"
           and "All content" pills). Reuses .cal-month-filter chrome so the
           trigger still reads as one of the toolbar's pills. */
        .cal-organize .dropdown-trigger { gap: 7px; }
        .cal-organize .cal-org-ico { width: 15px; height: 15px; display: block; flex-shrink: 0; opacity: 0.75; }
        .cal-organize .dropdown-trigger.is-filtered .cal-org-ico { opacity: 0.9; }
        .cal-organize .cal-org-trigger-txt { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cal-organize .dropdown-menu { min-width: 254px; max-height: min(440px, 70vh); overflow-y: auto; }
        .cal-org-sec { padding: 7px 12px 3px; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.08em;
            text-transform: uppercase; color: var(--text-muted); }
        .cal-org-sep { height: 1px; margin: 5px 8px; background: var(--border); }
        /* Ordering-mode row. Its own label carries the explanation via the
           shared data-tip layer — no info icon sits beside it (see
           docs/features/UI_DESIGN_STANDARDS.md, "Explain through the label"). */
        .cal-org-toggle { align-items: center; gap: 12px; cursor: pointer; }
        .cal-org-toggle .cal-org-toggle-txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; text-align: left; }
        .cal-org-toggle .cal-org-toggle-name { font-size: 0.78rem; font-weight: 700; color: var(--text-primary);
            text-decoration-line: underline; text-decoration-style: dotted; text-decoration-thickness: 1px;
            text-decoration-color: var(--text-muted); text-underline-offset: 3px; transition: text-decoration-color 0.12s ease; }
        .cal-org-toggle:hover .cal-org-toggle-name,
        .cal-org-toggle:focus-visible .cal-org-toggle-name { text-decoration-color: currentColor; }
        .cal-org-toggle .cal-org-toggle-sub { font-size: 0.66rem; font-weight: 600; color: var(--text-muted); white-space: nowrap; }
        .cal-org-toggle:focus-visible { outline: 0; box-shadow: 0 0 0 2px var(--focus-ring); }
        /* Auto-organized Sheet: the grip stays put (so the card layout doesn't
           shift when the mode flips) but reads as unavailable, and its title
           says which switch brings dragging back. */
        .cal-card-grip.is-locked { cursor: not-allowed; }
        .cal-card-grip.is-locked svg { opacity: 0.45; }
        @media (prefers-reduced-motion: reduce) {
            .cal-org-toggle .cal-org-toggle-name { transition: none; }
            .cal-org-toggle .cal-kebab-switch, .cal-org-toggle .cal-kebab-switch::after { transition: none; }
        }
        /* SMM quick-links to the client's own social profiles — an icon button
           in the calendar toolbar that drops down the client's accounts, each
           opening in a new tab. Sourced from the Clients Info sheet. */
        .cal-client-links { position: relative; display: inline-flex; align-items: center; }
        .cal-client-links .dropdown-trigger { padding: 8px 11px; border-radius: 20px; background: var(--bg); box-shadow: none; color: var(--text-primary); gap: 5px; }
        .cal-client-links .dropdown-trigger:hover, .cal-client-links .dropdown-trigger.open { box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_08); color: var(--text-primary); }
        .cal-client-links .cal-client-links-ico { width: 15px; height: 15px; display: block; }
        .cal-client-links .dropdown-trigger .dd-arrow { opacity: 0.55; }
        .cal-client-links .dropdown-menu { left: 0; right: auto; min-width: 216px; padding: 6px; }
        .cal-client-links-head { padding: 4px 10px 6px; font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .cal-client-link-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; border-radius: 8px; text-decoration: none; transition: background 0.1s; }
        .cal-client-link-item:hover { background: var(--bg); }
        .cal-client-link-ico { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; flex-shrink: 0; }
        .cal-client-link-ico svg { width: 17px; height: 17px; display: block; }
        .cal-client-link-txt { display: flex; flex-direction: column; line-height: 1.2; flex: 1; min-width: 0; }
        .cal-client-link-name { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); }
        .cal-client-link-sub { font-size: 0.66rem; font-weight: 600; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cal-client-link-ext { display: inline-flex; align-items: center; color: var(--text-muted); opacity: 0.5; flex-shrink: 0; transition: opacity 0.1s; }
        .cal-client-link-item:hover .cal-client-link-ext { opacity: 0.9; }
        .cal-filter-empty { padding: 32px 22px; text-align: center; color: var(--text-secondary); font-size: 0.88rem; }
        .cal-filter-empty-title { font-weight: 700; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 6px; }
        .cal-filter-empty-sub { font-size: 0.82rem; color: var(--text-muted); }
        .cal-filter-empty-sub .cal-link { background: none; border: none; padding: 0; color: var(--text-primary); font-weight: 700; cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; }
        /* Orange info icon hanging off the LEFT of the month pill: the filter
           is hiding cards that are anomalous (recently edited, or unfinished
           in a past month). Hover previews the detail popover; clicking pins
           it open until a click lands elsewhere — it never changes the
           filter. Absolutely positioned so appearing/vanishing never shifts
           the dropdown — and an icon, not a banner row, because hidden cards
           in other months are normal and must not cost height. */
        /* The flag hangs 25px to the LEFT of the month pill; once the tab strip
           fills the row it landed on the "+" add-client button. Reserve clearance
           on the month-filter group — but only while the flag is actually shown. */
        .cal-month-filter:has(.cal-month-warn) { margin-left: 30px; }
        .cal-month-warn { position: absolute; left: -25px; top: 50%; transform: translateY(-50%);
            width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;
            border: none; background: none; padding: 0; color: var(--sv-fg-ea580c); cursor: pointer; }
        .cal-month-warn svg { width: 17px; height: 17px; }
        .cal-month-warn:hover { color: var(--sv-fg-9a3412); }
        .cal-month-warn-pop { display: none; position: absolute; top: calc(100% + 8px); left: -25px; z-index: 60;
            width: 270px; background: var(--sv-bg-fff7ed); border: 1px solid var(--sv-border-fed7aa); border-radius: 10px;
            padding: 10px 12px; color: var(--sv-fg-9a3412); font-size: 0.78rem; line-height: 1.5; text-align: left;
            box-shadow: 0 10px 28px var(--sv-shadow-rgba-0-0-0-0_1); }
        .cal-month-warn-pop > div + div { margin-top: 6px; }
        .cal-month-warn:hover + .cal-month-warn-pop, .cal-month-warn-pop.is-open { display: block; }
        .cal-refresh-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid var(--border); background: var(--white); color: var(--text-muted); cursor: pointer; }
        .cal-refresh-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .cal-embed-title { display: flex; align-items: baseline; gap: 9px; }
        .cal-embed-title strong { font-size: 0.98rem; font-weight: 800; color: var(--text-primary); }
        .cal-embed-title span { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .cal-share-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.76rem; font-weight: 700; color: var(--text-secondary); cursor: pointer; white-space: nowrap; transition: all 0.15s; }
        .cal-share-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .cal-share-btn.copied { background: var(--up-bg); border-color: var(--sv-border-86efac); color: var(--up); }
        /* Overflow (kebab) menu */
        .cal-kebab-wrap { position: relative; display: inline-flex; }
        .cal-kebab { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid var(--border); background: var(--white); color: var(--text-secondary); cursor: pointer; }
        .cal-kebab svg { width: 15px; height: 15px; display: block; }
        .cal-kebab:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .cal-kebab-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 90; min-width: 188px;
            background: var(--white); border: 1px solid var(--border); border-radius: 11px; box-shadow: 0 10px 34px var(--sv-shadow-rgba-0-0-0-0_14); padding: 5px; }
        .cal-kebab-menu[hidden] { display: none; }
        .cal-kebab-item { display: flex; align-items: center; gap: 9px; width: 100%; box-sizing: border-box; padding: 9px 11px;
            background: transparent; border: 0; border-radius: 7px; cursor: pointer; font-family: inherit; font-size: 0.8rem;
            font-weight: 600; color: var(--text-primary); text-align: left; }
        .cal-kebab-item:hover { background: var(--bg); }
        .cal-kebab-sep { height: 1px; margin: 5px 8px; background: var(--border); }
        .cal-kebab-item svg { width: 15px; height: 15px; color: var(--text-secondary); flex-shrink: 0; }
        .cal-kebab-import-panel { display: none; padding: 0 0 2px; }
        .cal-kebab-import-panel.is-open { display: block; }
        .cal-kebab-import-toggle .cal-kebab-label { flex: 1 1 auto; }
        .cal-kebab-import-toggle[aria-expanded="true"] .cal-kebab-chevron { transform: rotate(180deg); }
        .cal-kebab-chevron { width: 13px; height: 13px; margin-left: auto; transition: transform 0.14s ease; }
        .cal-kebab-subitem { padding-left: 33px; color: var(--text-secondary); font-size: 0.76rem; font-weight: 600; }
        .cal-kebab-subitem:hover { color: var(--text-primary); }
        .cal-kebab-subitem svg { width: 13px; height: 13px; opacity: 0.8; }
        .cal-kebab-item.cal-kebab-toggle { gap: 8px; }
        .cal-kebab-item .cal-kebab-label { flex: 1 1 auto; }
        .cal-kebab-info-wrap { position: relative; display: inline-flex; align-items: center; flex-shrink: 0; }
        .cal-kebab-info-i { display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px;
            border-radius: 50%; background: var(--sv-bg-e5e5e1); color: var(--text-secondary);
            font-family: Georgia, 'Times New Roman', serif; font-size: 0.66rem; font-weight: 700; font-style: italic;
            line-height: 1; cursor: help; flex-shrink: 0; user-select: none;
            transition: background 0.12s, color 0.12s; }
        .cal-kebab-info-wrap:hover .cal-kebab-info-i { background: var(--sv-bg-2a2a28); color: var(--sv-fg-fff); }
        .cal-kebab-info-tip { position: absolute; top: calc(100% + 9px); right: -10px; z-index: 1500;
            width: 230px; padding: 10px 12px;
            background: var(--sv-bg-2a2a28); color: var(--sv-fg-f5f5f3);
            font-size: 0.72rem; font-weight: 500; line-height: 1.45; letter-spacing: 0;
            border-radius: 8px; box-shadow: 0 8px 22px var(--sv-shadow-rgba-0-0-0-0_22);
            opacity: 0; pointer-events: none; transform: translateY(-4px);
            transition: opacity 0.14s ease, transform 0.14s ease;
            white-space: normal; text-align: left; font-style: normal; }
        .cal-kebab-info-tip::before { content: ''; position: absolute; bottom: 100%; right: 14px;
            border: 6px solid transparent; border-bottom-color: var(--sv-border-2a2a28); }
        .cal-kebab-info-wrap:hover .cal-kebab-info-tip { opacity: 1; transform: translateY(0); }
        .cal-kebab-switch { position: relative; display: inline-block; width: 26px; height: 15px; border-radius: 99px;
            background: var(--sv-bg-d4d4d0); flex-shrink: 0; transition: background 0.15s; }
        .cal-kebab-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 11px; height: 11px;
            border-radius: 50%; background: var(--sv-bg-fff); box-shadow: 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_18); transition: transform 0.15s; }
        .cal-kebab-switch.is-on { background: var(--sv-bg-10b981); }
        .cal-kebab-switch.is-on::after { transform: translateX(11px); }
        .cal-import-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.76rem; font-weight: 700; color: var(--text-secondary); cursor: pointer; white-space: nowrap; transition: all 0.15s; }
        .cal-import-btn:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        /* Excel import modal */
        .cal-import-overlay { display: none; position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_4); z-index: 260; align-items: center; justify-content: center; }
        .cal-import-overlay.open { display: flex; }
        .cal-import-modal { background: var(--white); border-radius: 16px; width: 560px; max-width: 94vw; max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_3); overflow: hidden; }
        .cal-import-head { position: relative; padding: 20px 48px 14px 24px; border-bottom: 1px solid var(--border); }
        .cal-import-x { position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--bg); color: var(--text-secondary); font-size: 1.2rem; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
        .cal-import-x:hover { background: var(--sv-bg-ececea); color: var(--text-primary); }
        .cal-import-head h3 { margin: 0; font-size: 1.02rem; font-weight: 800; color: var(--text-primary); }
        .cal-import-head p { margin: 5px 0 0; font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }
        .cal-import-body { padding: 18px 24px; overflow-y: auto; }
        .cal-import-foot { padding: 14px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; }
        .cal-native-batch-options { display: grid; gap: 10px; }
        .cal-native-batch-option { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: start; padding: 14px;
            border: 1px solid var(--border); border-radius: 12px; cursor: pointer; background: var(--white); transition: border-color 0.12s, background 0.12s; }
        .cal-native-batch-option:hover { border-color: var(--text-muted); background: var(--bg); }
        .cal-native-batch-option:has(input:checked) { border-color: var(--text-primary); box-shadow: inset 0 0 0 1px var(--text-primary); }
        .cal-native-batch-option.is-incompatible { opacity: .62; cursor: not-allowed; }
        .cal-native-batch-option.is-incompatible:hover { border-color: var(--border); background: transparent; }
        .cal-native-batch-option input { margin: 3px 0 0; accent-color: var(--text-primary); }
        .cal-native-batch-copy { min-width: 0; display: grid; gap: 3px; }
        .cal-native-batch-title { color: var(--text-primary); font-size: 0.84rem; font-weight: 800; }
        .cal-native-batch-meta { color: var(--text-muted); font-size: 0.74rem; line-height: 1.45; overflow-wrap: anywhere; }
        .cal-native-batch-error { margin-top: 12px; color: var(--danger, var(--sv-fg-b91c1c)); font-size: 0.76rem; line-height: 1.45; }
        .cal-native-batch-unavailable { border: 1px dashed var(--border); border-radius: 12px; padding: 10px 14px; }
        .cal-native-batch-unavailable summary { cursor: pointer; color: var(--text-muted); font-size: 0.76rem; font-weight: 600; }
        .cal-native-batch-unavailable summary:hover { color: var(--text-primary); }
        .cal-native-batch-unavailable summary:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 2px; border-radius: 4px; }
        .cal-native-batch-unavailable-list { display: grid; gap: 10px; margin-top: 10px; }
        /* Create Post round 2 (owner pick 2026-08-18, option E): the post
           shape is a segmented toggle and the previous-batch choice is one
           card with an always-visible dropdown; batches that cannot hold the
           post are not rendered at all. */
        .cal-native-mode-toggle { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; }
        .cal-native-mode-toggle label { position: relative; display: block; }
        .cal-native-mode-toggle input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
        .cal-native-mode-toggle span { display: flex; justify-content: center; align-items: center; padding: 8px 6px; border-radius: 7px; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); white-space: nowrap; }
        .cal-native-mode-toggle input:checked + span { background: var(--white); color: var(--text-primary); box-shadow: var(--shadow-sm); }
        .cal-native-mode-toggle input:focus-visible + span { outline: 2px solid var(--text-primary); outline-offset: 1px; }
        .cal-native-count-row { display: flex; align-items: center; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
        .cal-native-count-row label { font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        /* The control itself is the shared `sv-stepper` primitive -- 44px
           targets, its own clamp and disabled ends. Only its WIDTH is scoped
           here: the primitive is width:100% for the full-width PTO fields it
           was built for, and this one sits inline beside a label and a hint.
           126px is its own 42/42/42 grid, so the cells keep their intended
           size instead of being stretched. */
        .cal-native-count-row .sv-stepper { width: 126px; flex: 0 0 auto; }
        .cal-native-count-hint { font-size: 0.76rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        /* Search and dropdown are two separate decisions, so they get a real
           gap rather than sitting flush against each other. */
        .cal-native-batch-controls { display: grid; gap: 10px; margin-top: 10px; }
        .cal-native-batch-field { position: relative; display: block; }
        /* One chevron, drawn by us. A native select arrow is a different shape,
           weight and colour in every browser, and in dark mode it is usually
           the light-mode one. */
        .cal-native-batch-field::after { content: ''; position: absolute; right: 13px; top: 50%; width: 8px; height: 8px; margin-top: -6px; border-right: 2px solid var(--text-muted); border-bottom: 2px solid var(--text-muted); transform: rotate(45deg); pointer-events: none; }
        .cal-native-batch-select { width: 100%; height: 40px; padding: 0 34px 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 600; line-height: 1.2; cursor: pointer; -webkit-appearance: none; -moz-appearance: none; appearance: none; text-overflow: ellipsis; }
        .cal-native-batch-select:hover { border-color: var(--text-muted); }
        .cal-native-batch-select:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        .cal-native-batch-select:disabled { opacity: .55; cursor: not-allowed; }
        .cal-native-batch-filter { width: 100%; height: 40px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 500; }
        .cal-native-batch-filter::placeholder { color: var(--sv-fg-aaa); font-weight: 500; }
        .cal-native-batch-filter:hover { border-color: var(--text-muted); }
        .cal-native-batch-filter:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        /* margin-top: 0 -- the grid gap above owns the spacing now, and a
           margin here would double it the moment the notice appears. */
        .cal-native-batch-filter-empty { display: block; margin-top: 0; font-size: 0.72rem; color: var(--sv-fg-aaa); }
        /* Editor picker chrome. The control itself is the shared sv-select
           primitive, which already carries the 44px trigger, focus ring and
           listbox semantics -- only the row, its label and its hint live here. */
        .cal-native-editor-row { margin-top: 14px; }
        .cal-native-editor-label { display: block; margin-bottom: 6px; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .cal-native-editor-hint { margin: 6px 0 0; font-size: 0.74rem; line-height: 1.45; color: var(--text-muted); }
        /* POST NAMES (owner request 2026-09-07: "they should be able to name
           that sub-issue also"). One field per post, because a single press can
           mint up to 50 of them and one shared name would defeat the point.

           The name is a SUFFIX -- 'Video 4 - Launch hook' -- so the 2026-08-17
           ruling survives it: the owner read his own test post as "two video
           sub-issues" when both halves were called the same thing, and a
           free-form title would rebuild exactly that. The kind and the number
           stay in front of whatever anyone types.

           The list scrolls rather than growing the dialog past the viewport;
           at the 50-post ceiling it would otherwise be taller than the screen
           and push Create out of reach. */
        .cal-native-name-row { margin-top: 14px; }
        .cal-native-name-label { display: block; margin-bottom: 6px; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .cal-native-name-optional { margin-left: 6px; font-size: 0.72rem; font-weight: 600; color: var(--sv-fg-aaa); }
        /* THE PADDING IS THE FOCUS RING'S ROOM, not decoration (2026-09-08).
           `overflow-y: auto` computes `overflow-x: auto` too, so this scroll
           container clips at its PADDING box -- and the focused input's ring
           sits 3px outside its border box (1px offset + 2px wide). With no
           padding the ring's four straight edges were clipped away and only
           the corner arcs survived, which read as stray marks at the corners
           of the field. The negative margin puts the row back where it was, so
           nothing moves. */
        .cal-native-name-list { display: grid; gap: 8px; max-height: 216px; overflow-y: auto; padding: 4px; margin: -4px; }
        .cal-native-name-item { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; align-items: center; }
        .cal-native-name-item.is-numbered { grid-template-columns: 22px minmax(0, 1fr); }
        .cal-native-name-index { font-size: 0.74rem; font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; text-align: right; }
        .cal-native-name-input { width: 100%; height: 40px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 500; box-sizing: border-box; }
        .cal-native-name-input::placeholder { color: var(--sv-fg-aaa); font-weight: 500; }
        .cal-native-name-input:hover { border-color: var(--text-muted); }
        .cal-native-name-input:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        .cal-native-name-hint { margin: 6px 0 0; font-size: 0.74rem; line-height: 1.45; color: var(--text-muted); }
        /* The batch name lives INSIDE the "Start a new batch" card, so the name
           and the decision to create it are one control rather than two. */
        .cal-native-batch-name { width: 100%; height: 38px; margin-top: 8px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 600; box-sizing: border-box; }
        .cal-native-batch-name::placeholder { color: var(--sv-fg-aaa); font-weight: 500; }
        .cal-native-batch-name:hover { border-color: var(--text-muted); }
        .cal-native-batch-name:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        /* CREATE POST, OPTION A (owner pick 2026-09-08).
           The four hint blocks are gone. Three of them described the same
           thing in prose -- the issue tree about to be created -- so one live
           receipt replaces all three and states it exactly, including the
           NUMBERS an append will get, which no hint could ever say. The batch
           pair became a segmented toggle because both branches used to sit
           open at once, so a third of the dialog was controls for the choice
           you had not made. */
        .cal-native-batch-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; padding: 4px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; }
        .cal-native-batch-tabs label { position: relative; display: block; }
        .cal-native-batch-tabs input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
        .cal-native-batch-tabs span { display: flex; justify-content: center; align-items: center; padding: 8px 6px; border-radius: 7px; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); white-space: nowrap; }
        .cal-native-batch-tabs input:checked + span { background: var(--white); color: var(--text-primary); box-shadow: var(--shadow-sm); }
        .cal-native-batch-tabs input:focus-visible + span { outline: 2px solid var(--text-primary); outline-offset: 1px; }
        /* NARROW SCREENS STACK BOTH TOGGLES (Codex P2 on PR 1353).
           Measured, not estimated: at 360px the batch tabs fit exactly
           (288 = 288) and it is the three-column MODE toggle that overflows
           (314 > 288); at 320px both do (277 and 314 against 251). The labels
           are nowrap by design -- 'Add to a previous batch' wrapping mid-phrase
           reads worse than a stacked tab -- so the columns collapse instead.
           This covers the mode toggle as well as the tabs this PR added,
           deliberately: fixing only the new half would leave the dialog
           overflowing horizontally on the same screen, which is the whole
           defect. */
        @media (max-width: 420px) {
            .cal-native-mode-toggle, .cal-native-batch-tabs { grid-template-columns: 1fr; }
        }
        .cal-native-batch-panel { margin-top: 10px; display: grid; gap: 8px; }
        .cal-native-batch-panel .cal-native-sublabel { margin: 2px 0 -4px; font-size: 0.74rem; }
        .cal-native-field-label { display: block; margin-bottom: 6px; font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .cal-native-field-label .cal-native-name-optional { margin-left: 6px; }
        .cal-native-receipt { margin-top: 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); padding: 11px 13px; }
        .cal-native-receipt-cap { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
        .cal-native-receipt-cap em { font-style: normal; font-weight: 600; letter-spacing: 0; text-transform: none; font-variant-numeric: tabular-nums; }
        .cal-native-receipt-parent { display: flex; align-items: center; gap: 8px; margin-top: 9px; padding-bottom: 8px; border-bottom: 1px solid var(--border); font-size: 0.8rem; font-weight: 700; color: var(--text-primary); overflow-wrap: anywhere; }
        .cal-native-receipt-kids { list-style: none; margin: 7px 0 0; padding: 0; display: grid; gap: 4px; max-height: 168px; overflow-y: auto; }
        .cal-native-receipt-kids li { display: flex; align-items: center; gap: 8px; padding-left: 9px; border-left: 1px solid var(--border); font-size: 0.76rem; color: var(--text-secondary); overflow-wrap: anywhere; }
        .cal-native-receipt-dot { width: 6px; height: 6px; border-radius: 50%; flex: none; }
        .cal-native-receipt-dot.is-video { background: var(--cal-comp-video-dot); }
        .cal-native-receipt-dot.is-graphics { background: var(--cal-comp-graphic-dot); }
        .cal-native-receipt-name { color: var(--text-primary); font-weight: 600; }
        .cal-native-receipt-more { padding-left: 9px; border-left: 1px solid var(--border); font-size: 0.74rem; color: var(--text-muted); }
        .cal-import-drop { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1.5px dashed var(--sv-border-c7c7c4); border-radius: 12px; padding: 34px 20px; text-align: center; cursor: pointer; transition: border-color 0.12s, background 0.12s; }
        .cal-import-drop:hover { border-color: var(--text-primary); background: var(--sv-bg-fafaf9); }
        .cal-import-drop svg { width: 34px; height: 34px; color: var(--text-muted); }
        .cal-import-drop-title { font-size: 0.86rem; font-weight: 700; color: var(--text-primary); margin-top: 10px; }
        .cal-import-drop-sub { font-size: 0.74rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5; }
        .cal-import-map-row { display: grid; grid-template-columns: 24px 1fr 1fr; gap: 10px 14px; align-items: center; padding: 7px 0; }
        .cal-import-map-row label { font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .cal-import-map-row label .req { color: var(--dn); }
        .cal-import-map-row select { font-family: inherit; font-size: 0.78rem; padding: 7px 9px; border: 1px solid var(--border); border-radius: 7px; background: var(--white); color: var(--text-primary); width: 100%; box-sizing: border-box; }
        .cal-import-map-row select:disabled { background: var(--bg); color: var(--text-muted); cursor: not-allowed; }
        .cal-import-map-row.is-off label,
        .cal-import-map-row.is-off label .req { color: var(--text-muted); text-decoration: line-through; text-decoration-color: var(--sv-fg-rgba-0-0-0-0_25); }
        .cal-import-skip-chk { width: 16px; height: 16px; margin: 0; cursor: pointer; accent-color: var(--text-primary); }
        .cal-import-info { font-size: 0.76rem; color: var(--text-secondary); background: var(--bg); border-radius: 8px; padding: 9px 12px; margin-bottom: 14px; line-height: 1.5; }
        .cal-import-flip-note { color: var(--text-secondary); }
        .cal-import-flip { font: inherit; font-size: 0.76rem; color: var(--text-primary); font-weight: 600; background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; }
        .cal-import-flip:hover { opacity: 0.8; }
        .cal-import-err { font-size: 0.78rem; color: var(--dn); background: var(--dn-bg); border-radius: 8px; padding: 9px 12px; margin-top: 12px; }
        .cal-import-progress { font-size: 0.82rem; color: var(--text-secondary); text-align: center; padding: 20px; }
        .cal-import-pick-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 4px 10px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }
        .cal-import-pick-count { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); font-variant-numeric: tabular-nums; }
        .cal-import-pick-toggle { background: transparent; border: 1px solid var(--border); border-radius: 7px; padding: 5px 11px; font-family: inherit; font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); cursor: pointer; }
        .cal-import-pick-toggle:hover { color: var(--text-primary); border-color: var(--text-primary); }
        .cal-import-pick-list { display: flex; flex-direction: column; gap: 2px; max-height: 56vh; overflow-y: auto; padding-right: 4px; }
        .cal-import-pick-row { display: flex; align-items: center; gap: 11px; padding: 8px 10px; border-radius: 8px; cursor: pointer; transition: background 0.08s; }
        .cal-import-pick-row:hover { background: var(--bg); }
        .cal-import-pick-row input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--text-primary); flex-shrink: 0; cursor: pointer; }
        .cal-import-pick-name { flex: 1; font-size: 0.84rem; color: var(--text-primary); font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cal-import-pick-date { font-size: 0.72rem; color: var(--text-muted); font-variant-numeric: tabular-nums; flex-shrink: 0; }
        button.cal-import-sheet-row { background: transparent; border: 1px solid var(--border); font-family: inherit; text-align: left; width: 100%; }
        button.cal-import-sheet-row:hover { border-color: var(--text-primary); }
        .cal-linear-import-input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1.5px solid var(--sv-border-c7c7c4);
            border-radius: 9px; font-family: inherit; font-size: 0.84rem; color: var(--text-primary); outline: 0; }
        .cal-linear-import-input:focus { border-color: var(--text-primary); }
        .cal-linear-sub-list { display: flex; flex-direction: column; gap: 6px; }
        .cal-linear-sub-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 9px; }
        .cal-linear-sub-count { font-size: 0.74rem; font-weight: 600; color: var(--text-muted); }
        .cal-linear-sort-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px;
            border: 1px solid var(--border); border-radius: 7px; background: var(--white); color: var(--text-secondary);
            font-family: inherit; font-size: 0.73rem; font-weight: 600; cursor: pointer;
            transition: background 0.12s, border-color 0.12s; }
        .cal-linear-sort-btn:hover { background: var(--bg); border-color: var(--text-muted); }
        .cal-linear-sort-btn svg { width: 13px; height: 13px; }
        .cal-linear-sub { display: flex; align-items: flex-start; gap: 8px; padding: 10px 12px; border: 1px solid var(--border);
            border-radius: 9px; transition: background 0.12s, border-color 0.12s; }
        .cal-linear-sub:hover { background: var(--bg); }
        .cal-linear-sub.is-disabled { opacity: 0.5; }
        .cal-linear-sub.cal-sub-dragging { opacity: 0.4; }
        .cal-linear-sub.cal-sub-drop-target { border-color: var(--text-primary); background: var(--bg); }
        .cal-linear-grip { display: flex; align-items: center; flex-shrink: 0; margin-top: 1px;
            color: var(--text-muted); cursor: grab; }
        .cal-linear-grip svg { width: 12px; height: 14px; }
        .cal-linear-sub.is-disabled .cal-linear-grip { visibility: hidden; }
        .cal-linear-sub-pick { display: flex; align-items: flex-start; gap: 10px; flex: 1; min-width: 0; cursor: pointer; }
        .cal-linear-sub input { margin-top: 2px; flex-shrink: 0; }
        .cal-linear-sub-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        .cal-linear-sub-title { font-size: 0.84rem; font-weight: 600; color: var(--text-primary); }
        .cal-linear-sub-meta { font-size: 0.72rem; color: var(--text-muted); }
        .cal-linear-sub-graphic { color: var(--sv-fg-9d174d); font-weight: 700; }
        .cal-linear-sub-graphic-miss { color: var(--text-muted); font-style: italic; }
        .cal-import-label { display: block; font-size: 0.74rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.04em; }
        .cal-import-req { display: inline-block; font-size: 0.66rem; font-weight: 700; color: var(--sv-fg-b91c1c); background: var(--sv-bg-fee2e2); border-radius: 5px; padding: 1px 6px; margin-left: 6px; letter-spacing: 0; text-transform: none; }
        .cal-import-opt { display: inline-block; font-size: 0.66rem; font-weight: 600; color: var(--text-muted); background: var(--bg); border-radius: 5px; padding: 1px 6px; margin-left: 6px; letter-spacing: 0; text-transform: none; }
        .cal-import-btn-primary { padding: 9px 18px; border-radius: 8px; border: 0; background: var(--text-primary); color: var(--white); font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; }
        .cal-import-btn-primary:disabled { opacity: 0.45; cursor: default; }
        .cal-import-btn-ghost { padding: 9px 16px; border-radius: 8px; border: 1px solid var(--border); background: var(--white); color: var(--text-secondary); font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; }

        /* Client Credentials */
        .cc-wrap { display: flex; flex-direction: column; gap: 16px; }
        .cc-topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 16px; background: var(--sv-bg-rgba-255-255-255-0_72); border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 18px 55px var(--sv-shadow-rgba-17-17-16-0_06); }
        .cc-title { margin: 0; font-size: 1.05rem; font-weight: 850; color: var(--text-primary); letter-spacing: -0.02em; }
        .cc-sub { margin: 4px 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--text-muted); max-width: 720px; }
        .cc-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
        .cc-search { width: min(360px, 100%); box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); font-family: inherit; font-size: 0.86rem; color: var(--text-primary); outline: none; }
        .cc-search:focus { border-color: var(--text-primary); }
        .cc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.78rem; font-weight: 750; padding: 9px 12px; cursor: pointer; transition: border-color 0.14s, background 0.14s, transform 0.14s; }
        .cc-btn:hover { border-color: var(--sv-border-aaa); background: var(--sv-bg-fafaf8); transform: translateY(-1px); }
        .cc-btn.primary { background: var(--sv-bg-111110); border-color: var(--sv-border-111110); color: var(--sv-fg-fff); }
        .cc-btn.danger { color: var(--sv-fg-b91c1c); border-color: var(--sv-border-fecaca); background: var(--sv-bg-fff7f7); }
        .cc-btn:disabled { opacity: 0.45; cursor: default; transform: none; }
        .cc-body { display: flex; flex-direction: column; gap: 14px; }
        .cc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 14px; }
        .cc-card { border: 1px solid var(--border); border-radius: 18px; background: var(--sv-bg-rgba-255-255-255-0_82); box-shadow: 0 16px 45px var(--sv-shadow-rgba-17-17-16-0_06); overflow: hidden; }
        .cc-card.needs-review { border-color: var(--sv-border-fed7aa); background: linear-gradient(180deg, var(--sv-bg-rgba-255-247-237-0_96), var(--sv-bg-rgba-255-255-255-0_9)); }
        .cc-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 14px 15px; border-bottom: 1px solid var(--border-light); }
        .cc-card-toggle { display: flex; align-items: flex-start; gap: 9px; flex: 1 1 auto; min-width: 0; padding: 0; margin: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
        .cc-card-toggle > svg { width: 12px; height: 12px; margin-top: 5px; flex-shrink: 0; color: var(--text-muted); transform: rotate(-90deg); transition: transform 0.16s ease; }
        .cc-card.cc-open .cc-card-toggle > svg { transform: rotate(0deg); }
        .cc-card.cc-collapsible:not(.cc-open) .cc-rows { display: none; }
        .cc-card.cc-collapsible:not(.cc-open) .cc-card-head { border-bottom: 0; }
        .cc-client { font-size: 0.95rem; font-weight: 850; color: var(--text-primary); }
        .cc-client-meta { margin-top: 3px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 0.72rem; color: var(--text-muted); }
        .cc-chip { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 3px 7px; background: var(--bg); color: var(--text-secondary); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.02em; text-transform: uppercase; }
        .cc-chip.warn { background: var(--sv-bg-ffedd5); color: var(--sv-fg-9a3412); }
        .cc-rows { display: flex; flex-direction: column; gap: 0; }
        .cc-row { display: grid; grid-template-columns: minmax(86px, 0.8fr) minmax(120px, 1.1fr) minmax(120px, 1.1fr) auto; gap: 10px; align-items: center; padding: 12px 15px; border-bottom: 1px solid var(--border-light); }
        .cc-row:last-child { border-bottom: 0; }
        .cc-platform { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        .cc-platform strong { color: var(--text-primary); font-size: 0.82rem; text-transform: capitalize; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cc-platform span, .cc-muted { color: var(--text-muted); font-size: 0.72rem; }
        .cc-secret, .cc-handle { display: flex; align-items: center; gap: 7px; min-width: 0; }
        .cc-secret code, .cc-handle code { display: block; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 5px 8px; border-radius: 9px; background: var(--sv-bg-f6f6f3); color: var(--text-primary); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.76rem; font-weight: 750; }
        /* The reveal (eye) + copy buttons hug the password value instead of
           being pushed to the far edge. A stable min-width keeps the masked
           ••••• and a shorter revealed value the same width, so the icons don't
           jump; longer values grow up to the shared max-width and ellipsize. */
        .cc-secret code { flex: 0 1 auto; min-width: 88px; }
        .cc-secret .cc-mini:first-of-type { margin-left: 2px; }
        /* Borderless "ghost" icon buttons — no box/border, just the glyph, with
           a soft hover/active wash. Cuts the visual noise of a per-icon frame. */
        .cc-mini { width: 27px; height: 27px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 8px; background: transparent; color: var(--text-muted); cursor: pointer; padding: 0; transition: color 0.14s, background 0.14s; }
        .cc-mini:hover { color: var(--text-primary); background: var(--sv-bg-f6f6f3); }
        .cc-mini svg { width: 15px; height: 15px; display: block; stroke-width: 1.8; }
        .cc-mini.is-active { color: var(--text-primary); background: var(--sv-bg-f6f6f3); }
        .cc-row-actions { display: flex; align-items: center; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
        .cc-updated { grid-column: 1 / -1; margin-top: -4px; font-size: 0.68rem; color: var(--text-muted); }
        .cc-empty { padding: 46px 20px; text-align: center; border: 1px dashed var(--border); border-radius: 16px; background: var(--sv-bg-rgba-255-255-255-0_5); color: var(--text-muted); line-height: 1.6; }
        .cc-modal-wide { width: 840px; }
        .cc-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .cc-field { display: flex; flex-direction: column; gap: 5px; position: relative; }
        .cc-field.full { grid-column: 1 / -1; }
        .cc-field label { font-size: 0.7rem; font-weight: 850; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-secondary); }
        .cc-field input:not([type="hidden"]), .cc-field textarea { width: 100%; box-sizing: border-box; padding: 11px 12px; border: 1px solid var(--border); border-radius: 11px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.86rem; outline: 0; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .cc-field textarea { min-height: 92px; resize: vertical; line-height: 1.45; }
        .cc-field input:not([type="hidden"]):focus, .cc-field textarea:focus, .cc-select-trigger:focus { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .cc-select { position: relative; width: 100%; }
        .cc-select-trigger { width: 100%; min-height: 41px; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--border); border-radius: 11px; background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); color: var(--text-primary); font-family: inherit; font-size: 0.86rem; font-weight: 650; outline: 0; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 10px; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .cc-select-trigger:hover { border-color: var(--sv-border-b9b9b4); background: var(--sv-bg-fff); }
        .cc-select-trigger svg { width: 13px; height: 13px; flex-shrink: 0; color: var(--text-muted); transition: transform 0.16s ease, color 0.16s ease; }
        .cc-select.open .cc-select-trigger svg { transform: rotate(180deg); color: var(--text-primary); }
        .cc-select-menu { position: absolute; z-index: 620; top: calc(100% + 7px); left: 0; right: 0; max-height: 240px; overflow: auto; padding: 6px; border: 1px solid var(--border); border-radius: 14px; background: var(--sv-bg-rgba-255-255-255-0_98); box-shadow: 0 18px 48px var(--sv-shadow-rgba-17-17-16-0_16); opacity: 0; transform: translateY(-4px) scale(0.985); pointer-events: none; visibility: hidden; transition: opacity 0.13s ease, transform 0.13s ease, visibility 0s linear 0.13s; }
        .cc-select.open .cc-select-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; visibility: visible; transition: opacity 0.13s ease, transform 0.13s ease, visibility 0s; }
        .cc-select-menu::-webkit-scrollbar { width: 6px; }
        .cc-select-menu::-webkit-scrollbar-thumb { background: var(--sv-bg-d8d8d4); border-radius: 99px; }
        .cc-select-option { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 10px; border: 0; border-radius: 10px; background: transparent; color: var(--text-secondary); font-family: inherit; font-size: 0.82rem; font-weight: 650; text-align: left; cursor: pointer; }
        .cc-select-option:hover { background: var(--bg); color: var(--text-primary); }
        .cc-select-option.active { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .cc-select-option svg { width: 12px; height: 12px; opacity: 0.9; }
        .cc-password-wrap { position: relative; display: flex; align-items: center; }
        .cc-password-wrap input { padding-right: 44px !important; }
        .cc-pass-toggle { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px; border: 0; border-radius: 9px; background: transparent; color: var(--text-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.14s, color 0.14s; }
        .cc-pass-toggle:hover { background: var(--bg); color: var(--text-primary); }
        .cc-pass-toggle svg { width: 17px; height: 17px; display: block; }
        .cc-history-list { display: flex; flex-direction: column; gap: 8px; }
        .cc-event { border: 1px solid var(--border-light); border-radius: 11px; padding: 10px 12px; background: var(--sv-bg-fff); }
        .cc-event-head { display: flex; justify-content: space-between; gap: 10px; font-size: 0.76rem; font-weight: 800; color: var(--text-primary); }
        .cc-event-meta { margin-top: 3px; font-size: 0.68rem; color: var(--text-muted); }
        .cc-diff { margin-top: 7px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 7px; align-items: center; font-size: 0.74rem; }
        .cc-diff code { padding: 5px 7px; border-radius: 7px; background: var(--bg); overflow-wrap: anywhere; }
        .cc-bulk-preview { margin-top: 12px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        .cc-ob-group { margin-top: 12px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        .cc-ob-client { padding: 8px 12px; background: var(--bg); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary); border-bottom: 1px solid var(--border); }
        .cc-ob-row { display: grid; grid-template-columns: 20px 92px minmax(120px, 1fr) minmax(110px, 1fr) 108px auto; gap: 10px; align-items: center; padding: 8px 12px; font-size: 0.8rem; cursor: pointer; border-bottom: 1px solid var(--border); }
        .cc-ob-row:last-child { border-bottom: 0; }
        .cc-ob-row:hover { background: var(--bg); }
        .cc-ob-plat { font-weight: 700; text-transform: capitalize; }
        .cc-ob-label { color: var(--text-secondary); }
        .cc-ob-handle { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.76rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cc-ob-has { font-size: 0.72rem; font-weight: 700; color: var(--sv-fg-047857); }
        .cc-ob-none { font-size: 0.72rem; color: var(--text-muted); }
        .cc-ob-summary { font-size: 0.78rem; color: var(--text-secondary); margin-right: auto; font-variant-numeric: tabular-nums; }
        .cc-ob-client { display: flex; align-items: center; justify-content: space-between; }
        .cc-ob-groupsel { border: 1px solid var(--border); background: var(--card); color: var(--text-secondary); border-radius: 999px; padding: 2px 9px; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; cursor: pointer; }
        .cc-ob-groupsel:hover { color: var(--text-primary); border-color: var(--text-muted); }
        .cc-ob-row.has-raw { grid-template-areas: "c p l h s f" "r r r r r r"; row-gap: 4px; }
        .cc-ob-raw { grid-area: r; font-size: 0.73rem; color: var(--text-muted); padding-left: 30px; font-style: italic; overflow-wrap: anywhere; }
        .cc-ob-raw span { font-style: normal; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.66rem; margin-right: 5px; }
        .cc-ob-reveal { margin-left: 8px; border: 1px solid var(--border); background: var(--card); color: var(--text-secondary); border-radius: 999px; padding: 1px 8px; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; cursor: pointer; font-style: normal; }
        .cc-ob-reveal:hover { color: var(--text-primary); border-color: var(--text-muted); }
        .cc-ob-revealed { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; color: var(--text-primary); overflow-wrap: anywhere; }
        .cc-ob-row.is-locked { opacity: 0.55; cursor: not-allowed; }
        .cc-ob-row.is-locked input { cursor: not-allowed; }
        .cc-bulk-row { display: grid; grid-template-columns: 42px 1.2fr 0.8fr 1fr 1fr; gap: 9px; padding: 9px 10px; border-top: 1px solid var(--border-light); font-size: 0.76rem; align-items: center; }
        .cc-bulk-row:first-child { border-top: 0; background: var(--bg); font-weight: 850; color: var(--text-secondary); }
        .cc-flags { display: flex; flex-wrap: wrap; gap: 4px; }
        .cc-identity-card { width: 420px; max-width: 92vw; background: var(--white); border-radius: 18px; box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_28); padding: 22px; position: relative; }
        .cc-identity-x { position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--bg); color: var(--text-secondary); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.14s, color 0.14s; }
        .cc-identity-x:hover { background: var(--sv-bg-e8e8e4); color: var(--text-primary); }
        .cc-identity-x svg { width: 12px; height: 12px; display: block; }
        .cc-identity-card h3 { margin: 0; color: var(--text-primary); font-size: 1.05rem; }
        .cc-identity-card p { margin: 6px 0 16px; color: var(--text-muted); font-size: 0.8rem; line-height: 1.5; }
        @media (max-width: 760px) { .cc-row { grid-template-columns: 1fr; } .cc-row-actions { justify-content: flex-start; } .cc-form-grid { grid-template-columns: 1fr; } .cc-bulk-row { grid-template-columns: 34px 1fr; } }

        /* Calendar embedded in a client profile — break out to full width */
        .client-view.cal-tab-view { max-width: none; }

        .cal-empty { padding: 60px 20px; text-align: center; color: var(--text-muted); font-size: 0.92rem; line-height: 1.65; }
        /* The stranded-review notice. Sits above the queue in both the empty
           and non-empty states, because a queue quietly missing one card is the
           same falsehood as an empty one that claims nothing is waiting. */
        .cal-review-stranded { margin: 0 0 14px; padding: 11px 14px; border: 1px solid var(--border); border-left-width: 3px; border-radius: 8px; background: var(--surface-2, transparent); color: var(--text-muted); font-size: 0.88rem; line-height: 1.55; }
        .cal-empty.cal-error { color: var(--dn); background: var(--dn-bg); border-radius: 12px; }
        .cal-empty code { background: var(--sv-bg-rgba-0-0-0-0_07); padding: 2px 6px; border-radius: 4px; font-size: 0.78rem; }
        /* Modern loader — single clean rotating ring with a subtle label.
           Used everywhere the calendar shows a loading state. */
        .cal-loader { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 70px 20px; color: var(--text-primary); }
        .cal-loader-svg { animation: cal-loader-spin 1s linear infinite; color: var(--text-primary); display: block; }
        .cal-loader-svg circle.track { opacity: 0.18; }
        .cal-loader-text { font-size: 0.86rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.01em; }
        @keyframes cal-loader-spin { to { transform: rotate(360deg); } }
        .cal-link { background: none; border: none; color: var(--text-primary); font-weight: 700; cursor: pointer; text-decoration: underline; padding: 0; font-family: inherit; font-size: inherit; }

        /* Organizer — inline-editable cards */
        .cal-organizer-wrap { padding: 4px 0; }
        .cal-organizer-strip { display: flex; gap: 14px; overflow-x: auto; padding: 10px 4px 6px; align-items: flex-start; min-height: 320px;
            scrollbar-width: thin; scrollbar-color: var(--sv-fg-cdcdc8) transparent;
            /* Generous right runway so the user can scroll past the last
               card into empty canvas — and so a newly added card can be
               scrolled into the centre of the viewport instead of pinning
               against the right edge of the strip. Clamped so the empty
               space stays sensible on tiny and wide screens. */
            scroll-padding-right: clamp(120px, 40vw, 800px); }
        .cal-organizer-strip::after { content: ''; flex: 0 0 clamp(120px, 40vw, 800px); align-self: stretch; }
        /* Subtle scrollbar — track blends into the page; thumb is solid and
           pill-shaped. The arrow buttons (start / end / single-button) are
           all zero-sized so they can't render even on platforms where
           `display: none` is ignored for scrollbar buttons. */
        .cal-organizer-strip::-webkit-scrollbar { height: 10px; background: transparent; }
        .cal-organizer-strip::-webkit-scrollbar-track,
        .cal-organizer-strip::-webkit-scrollbar-track-piece { background: transparent; }
        .cal-organizer-strip::-webkit-scrollbar-thumb { background: var(--sv-bg-cdcdc8); border-radius: 99px; border: 2px solid transparent; background-clip: padding-box; }
        .cal-organizer-strip::-webkit-scrollbar-thumb:hover { background: var(--sv-bg-b1b1aa); background-clip: padding-box; }
        .cal-organizer-strip::-webkit-scrollbar-button,
        .cal-organizer-strip::-webkit-scrollbar-button:single-button,
        .cal-organizer-strip::-webkit-scrollbar-button:start:decrement,
        .cal-organizer-strip::-webkit-scrollbar-button:end:increment,
        .cal-organizer-strip::-webkit-scrollbar-button:horizontal:start,
        .cal-organizer-strip::-webkit-scrollbar-button:horizontal:end,
        .cal-organizer-strip::-webkit-scrollbar-button:vertical:start,
        .cal-organizer-strip::-webkit-scrollbar-button:vertical:end {
            display: block; width: 0 !important; height: 0 !important; background: transparent;
        }
        .cal-organizer-strip::-webkit-scrollbar-corner { background: transparent; }
        .cal-card { position: relative; flex: 0 0 var(--cal-card-w, 420px); background: var(--white); border: 1px solid var(--border); border-radius: 14px; transition: box-shadow 0.12s, border-color 0.12s; overflow: hidden; display: flex; flex-direction: column; }
        .cal-card:hover { box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_07); }
        .cal-card.is-blank { background: var(--sv-bg-fcfcfb); border-style: dashed; border-color: var(--sv-border-d4d4d2); }
        .cal-card.is-blank .cal-card-thumb { background: var(--media-tub-empty-bg); }
        .cal-card.is-blank:hover { border-color: var(--sv-border-888); }
        /* Saving / error frame is painted by a pseudo-element overlay
           rather than an inset box-shadow on .cal-card itself. The card
           has overflow:hidden so the inset shadow was being clipped by
           the thumbnail at the top edge — the border only showed on the
           sides + bottom. The overlay sits on top of every card child,
           shares the card's border-radius, and so the dark frame traces
           the full rounded shape including the top. */
        .cal-card.is-saving::after, .cal-card.is-error::after { content: ''; position: absolute; inset: 0;
            border: 1.5px solid currentColor; border-radius: 14px; pointer-events: none; z-index: 12; box-sizing: border-box; }
        .cal-card.is-saving::after { color: var(--text-primary); }
        .cal-card.is-error::after  { color: var(--dn); }
        .cal-card.is-error { border-color: var(--dn); }
        /* Close-button × glyphs across the app are now SVG crosses instead of
           the unicode multiplication sign — the unicode glyph sits a pixel
           or two above the geometric centre of its box in every system
           font, so close buttons of different sizes had their crosses at
           visibly different vertical positions. A single shared SVG with a
           symmetric path centres perfectly in any size container, so every
           × in the app (calendar archive, tab close, modal close,
           lightbox close, search clear, etc.) aligns. The relative sizing
           (% of the parent) keeps the cross proportional to whatever
           button it lives in. */
        .cal-card-del > svg, .cal-tab-x > svg, .cal-import-x > svg,
        .cal-lightbox-close > svg, .kasper-lightbox-close > svg,
        .cal-preview-close > svg, .cal-comments-close > svg,
        .cal-prompt-close > svg, .cr-modal-close > svg,
        .workload-popover-close > svg, .wl-client-search-clear > svg {
            display: block; width: 42%; height: 42%;
            /* DEFENSIVE CAP — do not remove. The cross is sized as a % of its
               button so it stays proportional. But a percentage on a replaced
               element (an inline <svg> with no width/height attribute) only
               resolves when the button has a *definite* box size. If a close
               button is ever styled with only padding + font-size (no explicit
               width/height), the % cannot resolve and the SVG silently falls
               back to the CSS default replaced size of 300x150px — which is
               exactly the "giant X" regression this rule guards against.
               max-width/height are expressed in `em` (always definite, derived
               from the button's font-size), so they bound the fallback to a
               sane glyph size no matter how the parent is laid out. Every
               button above currently declares an explicit width/height, so the
               cap never actually clamps the intended size today — it is purely
               a safety net for future additions. */
            max-width: 1em; max-height: 1em; }
        /* Audit follow-up: every close-button class that hosts the shared
           SVG cross must also center it. Most of these classes already
           had display:inline-flex + align/justify center, but
           cal-comments-close / cal-preview-close / cal-prompt-close /
           cal-lightbox-close / cr-modal-close / workload-popover-close
           / wl-client-search-clear were laying out the SVG as a plain
           block child — the cross visibly sat in the top-left of the
           button. Applying centering as a shared follow-up rule means
           any future close-button class added to the list above
           automatically gets centred too, and we can't regress this
           by forgetting to set the centering flags on a new class. */
        .cal-card-del, .cal-tab-x, .cal-import-x,
        .cal-lightbox-close, .kasper-lightbox-close,
        .cal-preview-close, .cal-comments-close,
        .cal-prompt-close, .cr-modal-close,
        .workload-popover-close, .wl-client-search-clear {
            display: inline-flex; align-items: center; justify-content: center; }
        .cal-card.dragging { opacity: 0.45; }
        .cal-card.cal-card-posted { border-color: var(--sv-border-15803d); box-shadow: 0 0 0 1px var(--sv-shadow-15803d); }
        .cal-card.cal-card-posted:hover { box-shadow: 0 0 0 1px var(--sv-shadow-15803d), 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_07); }
        /* Platform overlay — vertical column floating inside the thumbnail
           tub, anchored bottom-left. Sits over the gradient padding so it
           doesn't change the card's height or width. Muted by default;
           click colours an icon in to mark the post is going there. */
        .cal-card-platforms { position: absolute; left: 8px; top: 38px; z-index: 3; display: flex; flex-direction: column; gap: 3px; padding: 0; }
        .cal-card-platform-btn { width: 20px; height: 20px; border-radius: 50%; border: 0; background: var(--sv-bg-rgba-255-255-255-0_78); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_18); color: var(--sv-fg-555); padding: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: color 0.12s, background 0.12s, transform 0.08s, opacity 0.12s; opacity: 0.78; }
        .cal-card-platform-btn svg { width: 12px; height: 12px; display: block; }
        .cal-card-platform-btn:hover:not(:disabled) { color: var(--text-primary); opacity: 1; }
        .cal-card-platform-btn.is-active { color: var(--sv-fg-fff) !important; opacity: 1; box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_28); }
        .cal-card-platform-btn.is-active:hover { transform: scale(1.08); }
        .cal-card-platform-btn:disabled { cursor: default; }
        .cal-card-platform-btn.is-active[data-platform="instagram"] { background: var(--sv-bg-e4405f); }
        .cal-card-platform-btn.is-active[data-platform="tiktok"]    { background: var(--sv-bg-000); }
        .cal-card-platform-btn.is-active[data-platform="youtube"]   { background: var(--sv-bg-ff0000); }
        .cal-card-platform-btn.is-active[data-platform="facebook"]  { background: var(--sv-bg-1877f2); }
        .cal-card-platform-btn.is-active[data-platform="linkedin"]  { background: var(--sv-bg-0a66c2); }
        .cal-card-platform-btn.is-active[data-platform="x"]         { background: var(--sv-bg-000); }
        .cal-card-platform-btn.is-active[data-platform="threads"]   { background: var(--sv-bg-000); }
        .cal-card-platform-btn.is-active[data-platform="pinterest"] { background: var(--sv-bg-e60023); }
        /* Color tag — small circle anchored to the bottom-left of the thumb.
           Click opens a tiny picker with four colors + a clear option. The
           same color is then surfaced as a vertical stripe on month/week
           pills, so a batch reads at a glance. */
        .cal-card-color-tag { position: absolute; left: 8px; bottom: 8px; z-index: 3; width: 22px; height: 22px; border-radius: 50%; border: 0; background: var(--sv-bg-rgba-255-255-255-0_78); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_18); cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center; opacity: 0.85; transition: opacity 0.12s, transform 0.08s; }
        .cal-card-color-tag:hover { opacity: 1; transform: scale(1.06); }
        .cal-card-color-tag-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--sv-bg-d1d1d1); box-shadow: 0 0 0 1.5px var(--sv-shadow-fff), 0 0 0 2.5px var(--sv-shadow-rgba-0-0-0-0_08); }
        .cal-card-color-tag[data-color="red"]      .cal-card-color-tag-dot { background: var(--sv-bg-ef4444); }
        .cal-card-color-tag[data-color="amber"]    .cal-card-color-tag-dot { background: var(--sv-bg-f59e0b); }
        .cal-card-color-tag[data-color="emerald"]  .cal-card-color-tag-dot { background: var(--sv-bg-10b981); }
        .cal-card-color-tag[data-color="indigo"]   .cal-card-color-tag-dot { background: var(--sv-bg-6366f1); }
        .cal-card-color-tag.has-color { opacity: 1; }
        /* Client / read-only rendering of the colour tag: a passive dot, no
           picker — so kill the clickable affordances (pointer + hover scale). */
        .cal-card-color-tag.is-readonly { cursor: default; }
        .cal-card-color-tag.is-readonly:hover { transform: none; }
        .cal-card-color-picker { position: absolute; left: 8px; bottom: 36px; z-index: 5; background: var(--white); border-radius: 10px; padding: 6px; box-shadow: 0 8px 24px var(--sv-shadow-rgba-0-0-0-0_18); display: flex; flex-direction: row; gap: 5px; }
        .cal-card-color-pick { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--sv-border-fff); box-shadow: 0 0 0 1px var(--sv-shadow-rgba-0-0-0-0_1); cursor: pointer; padding: 0; transition: transform 0.08s; }
        .cal-card-color-pick:hover { transform: scale(1.12); }
        .cal-card-color-pick.is-clear { background: var(--bg); position: relative; }
        .cal-card-color-pick.is-clear::after { content: ''; position: absolute; left: 3px; right: 3px; top: 50%; height: 1.5px; background: var(--text-secondary); transform: translateY(-50%) rotate(-45deg); }
        /* Month/week pills get a small color dot in the bottom-right
           corner so a batch reads at a glance without changing the pill's
           shape. (Earlier rev used a left stripe — replaced because it
           visually competed with the borders / posted ring.) */
        .cal-month-pill[data-color], .cal-week-card[data-color] { position: relative; }
        .cal-month-pill[data-color]::before,
        .cal-week-card[data-color]::before {
            content: '';
            position: absolute;
            right: 6px;
            bottom: 6px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            z-index: 2;
            pointer-events: none;
            box-shadow: 0 0 0 1.5px var(--sv-shadow-fff), 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_2);
        }
        .cal-month-pill[data-color="red"]::before,     .cal-week-card[data-color="red"]::before     { background: var(--sv-bg-ef4444); }
        .cal-month-pill[data-color="amber"]::before,   .cal-week-card[data-color="amber"]::before   { background: var(--sv-bg-f59e0b); }
        .cal-month-pill[data-color="emerald"]::before, .cal-week-card[data-color="emerald"]::before { background: var(--sv-bg-10b981); }
        .cal-month-pill[data-color="indigo"]::before,  .cal-week-card[data-color="indigo"]::before  { background: var(--sv-bg-6366f1); }
        /* Edit platforms modal — reuses the import modal chrome */
        .cal-platforms-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .cal-platforms-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--white); cursor: pointer; user-select: none; transition: background 0.1s, border-color 0.1s; }
        .cal-platforms-row:hover { border-color: var(--sv-border-aaa); background: var(--sv-bg-fafaf9); }
        .cal-platforms-row input { margin: 0; accent-color: var(--text-primary); width: 16px; height: 16px; cursor: pointer; }
        .cal-platforms-row-icon { width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: var(--sv-fg-fff); flex-shrink: 0; }
        .cal-platforms-row-icon svg { width: 14px; height: 14px; }
        .cal-platforms-row-label { font-size: 0.82rem; font-weight: 700; color: var(--text-primary); }
        .cal-card-thumb { cursor: default; }
        .cal-card-thumb img { cursor: zoom-in; }
        /* Asset stage — image floats centred on a soft gradient with room to breathe */
        /* The thumb container is the fixed "tub" — width/height never change
           regardless of the image's aspect ratio. Vertical/portrait videos,
           ultrawide videos, etc. are all centered inside without stretching
           it or the parent card. */
        .cal-card-thumb { width: 100%; height: calc(var(--cal-thumb-h, 184px) + 16px); background: var(--media-tub-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; flex-shrink: 0; padding: 8px 14px; box-sizing: border-box; }
        .cal-card-thumb img { display: block; max-width: 100%; max-height: var(--cal-thumb-h, 184px); width: auto; height: auto; object-fit: contain; object-position: center; border-radius: 10px; box-shadow: 0 10px 26px var(--sv-shadow-rgba-0-0-0-0_20); }
        .cal-thumb-zoom { position: absolute; bottom: 8px; right: 8px; width: 27px; height: 27px; border-radius: 7px; background: var(--sv-bg-rgba-0-0-0-0_55); color: var(--sv-fg-fff); display: inline-flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.15s, background 0.12s; cursor: pointer; }
        .cal-thumb-zoom:hover { background: var(--sv-bg-rgba-0-0-0-0_78); }
        .cal-card:hover .cal-thumb-zoom { opacity: 1; }
        .cal-thumb-zoom svg { width: 14px; height: 14px; }
        /* Drag handle, top-left */
        .cal-card-grip { position: absolute; top: 7px; left: 7px; z-index: 4; width: 24px; height: 24px; border-radius: 6px;
            background: var(--sv-bg-rgba-255-255-255-0_92); box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_22); color: var(--text-muted);
            display: inline-flex; align-items: center; justify-content: center; cursor: grab; opacity: 0; transition: opacity 0.15s; }
        .cal-card:hover .cal-card-grip { opacity: 1; }
        /* Keep a faint grip visible so reordering is discoverable without a
           hover hunt — and fully visible on touch screens (no hover there). */
        .cal-strip .cal-card .cal-card-grip { opacity: 0.4; }
        .cal-strip .cal-card:hover .cal-card-grip { opacity: 1; }
        @media (hover: none) { .cal-strip .cal-card .cal-card-grip { opacity: 0.85; } }
        .cal-card-grip:active { cursor: grabbing; }
        .cal-card-grip svg { width: 13px; height: 13px; display: block; }
        /* Per-card link copy button — sits to the right of the drag grip */
        .cal-card-link { position: absolute; top: 7px; left: 37px; z-index: 4; width: 24px; height: 24px; border-radius: 6px;
            background: var(--sv-bg-rgba-255-255-255-0_92); box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_22); color: var(--text-muted);
            display: inline-flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0;
            transition: opacity 0.15s, color 0.15s, background 0.15s; border: 0; padding: 0; }
        .cal-card:hover .cal-card-link { opacity: 1; }
        .cal-card-link:hover { color: var(--text-primary); }
        .cal-card-link.copied { background: var(--sv-bg-dcfce7); color: var(--sv-fg-15803d); opacity: 1; }
        .cal-card-link svg { width: 13px; height: 13px; display: block; }
        /* Persistent focus highlight after opening a per-card deep link */
        /* !important: a posted card (.cal-card.cal-card-posted, specificity 2) and
           a hovered card (.cal-card:hover, and .cal-card.cal-card-posted:hover at
           specificity 3) both carry their own static box-shadow at equal-or-higher
           specificity than this single-class rule, so without it a linked card
           that is posted, or simply under the pointer, shows no ring at all --
           the exact silence this whole feature exists to end. Codex review, same PR. */
        .cal-card-focused { box-shadow: 0 0 0 3px var(--sv-shadow-rgba-94-106-210-0_55), 0 6px 22px var(--sv-shadow-rgba-94-106-210-0_18) !important; }
        /* Full-screen thumbnail lightbox */
        .cal-lightbox { display: none; position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_88); z-index: 300; align-items: center; justify-content: center; cursor: zoom-out; }
        .cal-lightbox.open { display: flex; }
        .cal-lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 8px; box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_55); cursor: default; }
        .cal-lightbox-close { position: fixed; top: 20px; right: 24px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--sv-bg-rgba-255-255-255-0_16); color: var(--sv-fg-fff); font-size: 1.5rem; line-height: 1; cursor: pointer; }
        .cal-lightbox-close:hover { background: var(--sv-bg-rgba-255-255-255-0_3); }
        /* Thumbnail revision history. A bounded availability read reveals the
           icon only for cards with a real previous/current pair. */
        .thumb-compare-slot { display: contents; }
        .thumb-compare-trigger { display: inline-flex; align-items: center; gap: 5px; border: 0; border-radius: 6px; padding: 3px 6px;
            background: transparent; color: var(--text-muted); font-family: inherit; font-size: 0.74rem; font-weight: 500; line-height: 1.35; cursor: pointer;
            transition: color 0.14s ease, background 0.14s ease; position: relative; }
        .thumb-compare-trigger:hover, .thumb-compare-trigger:focus-visible { color: var(--text-primary); background: var(--bg); outline: none; }
        .thumb-compare-trigger svg { width: 13px; height: 13px; opacity: 0.72; flex: 0 0 auto; }
        .thumb-compare-trigger:hover svg, .thumb-compare-trigger:focus-visible svg { opacity: 1; }
        .thumb-compare-trigger.is-link-action { gap: 0; }
        .thumb-compare-trigger.is-compact { width: 32px; height: 32px; padding: 0; justify-content: center; border: 1px solid var(--border); background: transparent; }
        .thumb-compare-trigger.is-compact svg { width: 15px; height: 15px; }
        .thumb-compare-trigger.is-compact span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .thumb-compare-overlay { position: fixed; inset: 0; z-index: 360; display: none; align-items: center; justify-content: center; padding: 22px;
            background: var(--sv-bg-rgba-0-0-0-0_55); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
        .thumb-compare-overlay.open { display: flex; }
        .thumb-compare-dialog { position: relative; width: min(1280px, 96vw); max-height: 94vh; overflow: hidden; display: flex; flex-direction: column;
            border: 1px solid var(--border); border-radius: 18px; background: var(--white); color: var(--text-primary); box-shadow: 0 28px 90px var(--sv-shadow-rgba-0-0-0-0_32); }
        .thumb-compare-head { position: absolute; z-index: 2; top: 12px; right: 12px; }
        .thumb-compare-close { width: 34px; height: 34px; border: 0; border-radius: 50%; background: var(--bg); color: var(--text-secondary); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
        .thumb-compare-close:hover, .thumb-compare-close:focus-visible { background: var(--border); color: var(--text-primary); outline: none; }
        .thumb-compare-close svg { width: 14px; height: 14px; }
        .thumb-compare-content { min-height: 280px; overflow: auto; padding: 22px 24px 24px; }
        .thumb-compare-loading, .thumb-compare-empty { min-height: 250px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; text-align: center; color: var(--text-secondary); }
        .thumb-compare-loading strong, .thumb-compare-empty strong { color: var(--text-primary); font-size: 0.92rem; }
        .thumb-compare-loading p, .thumb-compare-empty p { max-width: 470px; margin: 0; font-size: 0.8rem; line-height: 1.55; }
        .thumb-compare-empty-icon { width: 42px; height: 42px; border-radius: 13px; display: flex; align-items: center; justify-content: center; background: var(--bg); color: var(--text-muted); }
        .thumb-compare-empty-icon svg { width: 21px; height: 21px; }
        .thumb-compare-retry { margin-top: 5px; border: 1px solid var(--border); border-radius: 99px; padding: 8px 15px; background: var(--white); color: var(--text-primary); font-family: inherit; font-size: 0.76rem; font-weight: 700; line-height: 1; cursor: pointer; }
        .thumb-compare-retry:hover, .thumb-compare-retry:focus-visible { border-color: var(--sv-border-aaa); background: var(--bg); outline: none; }
        .thumb-compare-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
        .thumb-compare-pane { min-width: 0; margin: 0; }
        .thumb-compare-pane-head { padding: 0 0 9px; }
        .thumb-compare-pane-title { color: var(--text-primary); font-size: 0.82rem; font-weight: 800; }
        .thumb-compare-image-wrap { min-height: 520px; height: min(76vh, 720px); display: flex; align-items: center; justify-content: center; }
        .thumb-compare-image-wrap img { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 10px; }
        .thumb-compare-image-error { max-width: 240px; color: var(--text-secondary); font-size: 0.76rem; line-height: 1.5; text-align: center; }
        @media (max-width: 720px) {
            .thumb-compare-overlay { align-items: flex-end; padding: 0; }
            .thumb-compare-dialog { width: 100%; max-height: 96vh; border-radius: 18px 18px 0 0; }
            .thumb-compare-head { top: 10px; right: 10px; }
            .thumb-compare-content { padding: 20px 14px 24px; }
            .thumb-compare-grid { grid-template-columns: 1fr; }
            .thumb-compare-image-wrap { min-height: 360px; height: 58vh; }
        }
        .cal-card-thumb-fallback { font-size: 1.4rem; font-weight: 800; color: var(--text-muted); letter-spacing: 0.06em; display: inline-flex; align-items: center; justify-content: center; }
        /* Google Drive permission warning shown when a thumbnail won't load */
        .cal-thumb-drive-warn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 16px; color: var(--sv-fg-92400e); }
        .cal-thumb-drive-warn svg { width: 30px; height: 30px; flex-shrink: 0; }
        .cal-thumb-drive-warn strong { font-size: 0.78rem; font-weight: 800; }
        .cal-thumb-drive-warn span { font-size: 0.7rem; line-height: 1.45; font-weight: 600; color: var(--sv-fg-b45309); max-width: 240px; }
        /* Frame.io share/review links have no public image URL and block
           embedding, so they can't render as a real <img>. Instead of a broken
           placeholder, show a branded click-to-open poster that opens the
           thumbnail in Frame.io in a new tab. */
        .cal-thumb-frame { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 11px; text-decoration: none; text-align: center; padding: 14px;
            background: radial-gradient(120% 120% at 50% 32%, var(--sv-bg-262220) 0%, var(--sv-bg-0e0d0c) 74%); color: var(--sv-fg-fff); transition: background 0.18s; cursor: pointer; }
        .cal-thumb-frame:hover { background: radial-gradient(120% 120% at 50% 32%, var(--sv-bg-322d2a) 0%, var(--sv-bg-100f0e) 74%); }
        .cal-thumb-frame-badge { width: 52px; height: 52px; border-radius: 14px; background: var(--sv-bg-rgba-255-255-255-0_12); border: 1.5px solid var(--sv-border-rgba-255-255-255-0_5);
            display: flex; align-items: center; justify-content: center; transition: transform 0.18s, background 0.18s; }
        .cal-thumb-frame:hover .cal-thumb-frame-badge { transform: scale(1.06); background: var(--sv-bg-rgba-255-255-255-0_2); }
        .cal-thumb-frame-badge svg { width: 26px; height: 26px; }
        .cal-thumb-frame-cta { font-size: 0.84rem; font-weight: 700; letter-spacing: -0.01em; display: inline-flex; align-items: center; gap: 6px; }
        .cal-thumb-frame-cta svg { width: 13px; height: 13px; }
        .cal-thumb-frame-host { font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sv-fg-rgba-255-255-255-0_45); }
        /* Frame.io marker on the compact month-grid pill thumbnail. */
        .cal-month-pill-thumb.is-frame, .cal-week-card-thumb.is-frame { background: var(--sv-bg-16130f); color: var(--sv-fg-rgba-255-255-255-0_92); display: flex; align-items: center; justify-content: center; }
        .cal-month-pill-thumb.is-frame svg, .cal-week-card-thumb.is-frame svg { width: 56%; height: 56%; }
        .cal-mini-drive-warn { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--sv-bg-fffbeb); color: var(--sv-fg-b45309); padding: 6px; }
        .cal-mini-drive-warn svg { width: 22px; height: 22px; }
        /* Brief highlight when a card is jumped-to from the review queue. */
        @keyframes cal-card-flash-kf { 0%, 18% { box-shadow: 0 0 0 3px var(--sv-shadow-rgba-94-106-210-0_6); } 100% { box-shadow: 0 0 0 3px var(--sv-shadow-rgba-94-106-210-0); } }
        .cal-card-flash { animation: cal-card-flash-kf 1.7s ease-out; }
        /* "Awaiting SMM approval but no media linked" — banner on the editable
           card / preview, and a small corner badge on the month/week pills. */
        .cal-smm-warn { display: flex; align-items: flex-start; gap: 8px; padding: 8px 10px; border-radius: 8px; background: var(--sv-bg-fff7ed); border: 1px solid var(--sv-border-fdba74); color: var(--sv-fg-9a3412); font-size: 0.72rem; line-height: 1.35; font-weight: 600; }
        .cal-smm-warn svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 1px; color: var(--sv-fg-c2410c); }
        .cal-smm-warn strong { font-weight: 800; }
        /* Overlay variant — floats in front of the card's thumbnail (pinned to
           the bottom, clear of the bottom-left colour tag) so the warning never
           reflows the card body / changes the card's height. Frosted so it
           reads over either the placeholder or a real thumbnail. */
        .cal-smm-warn-overlay { position: absolute; left: 38px; right: 8px; bottom: 8px; z-index: 3;
            padding: 7px 9px; gap: 6px; font-size: 0.68rem; line-height: 1.3; text-align: left;
            background: var(--sv-bg-rgba-255-247-237-0_96); box-shadow: 0 6px 18px var(--sv-shadow-rgba-124-45-18-0_22);
            -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); pointer-events: none; }
        .cal-smm-warn-overlay svg { width: 14px; height: 14px; }
        .cal-smm-warn-dot { position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--sv-bg-fff7ed); border: 1px solid var(--sv-border-fdba74); color: var(--sv-fg-c2410c); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_12); pointer-events: auto; z-index: 2; }
        .cal-smm-warn-dot svg { width: 11px; height: 11px; }
        .cal-card.is-blank .cal-card-thumb-fallback { color: var(--sv-fg-c5c5c2); }
        .cal-card.is-blank .cal-card-thumb-fallback svg { width: 44px; height: 44px; }
        .cal-card-body { padding: 13px 14px 12px; display: flex; flex-direction: column; gap: 9px; }
        /* Duplicate Linear-issue warning — two active cards point at the same sub-issue.
           Loud (red) so a collision can never hide silently the way it used to. */
        .cal-dupe-warn { background: var(--sv-bg-fef2f2); color: var(--sv-fg-b91c1c); border: 1px solid var(--sv-border-fecaca);
            border-radius: 7px; padding: 6px 9px; font-size: 0.7rem; font-weight: 700;
            line-height: 1.3; letter-spacing: 0.01em; }

        /* Title — reads as a heading, not a form field */
        .cal-fld-name { width: 100%; box-sizing: border-box; border: 0; outline: 0; background: transparent;
            padding: 3px 4px; font-family: inherit; font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); }
        .cal-fld-name::placeholder { color: var(--sv-fg-c2c2bd); }
        .cal-fld-name:focus { background: var(--field-bg); border-radius: 7px; }

        /* Linear sub-issue link — icon at the start of the title row */
        .cal-title-row { display: flex; align-items: center; gap: 4px; }
        .cal-title-name-wrap { position: relative; flex: 1 1 0; min-width: 0; display: flex; align-items: center; }
        .cal-title-row .cal-fld-name { flex: 1 1 0; min-width: 0; }
        /* Fade the title out on its right edge when it overflows, so the save
           indicator reads as sitting where the title fades (owner sketch). The
           gradient melts into the card surface; it's dropped while editing so
           the caret text stays crisp. */
        .cal-title-fade { position: absolute; top: 0; right: 0; width: 22px; height: 100%; pointer-events: none;
            background: linear-gradient(to right, transparent, var(--white)); transition: opacity 0.15s ease; }
        .cal-title-name-wrap:focus-within .cal-title-fade { opacity: 0; }
        /* Rename propagation marker (staff only): the card's new name is still on
           its way to the linked sub-issues, or gave up (with a Retry). */
        .cal-name-sync { flex: 0 0 auto; font-size: 11px; line-height: 1.2; color: var(--text-muted); white-space: nowrap; }
        .cal-name-sync[hidden] { display: none; }
        .cal-name-sync.is-failed { color: var(--dn); }
        /* SyncLinear sub-issue rename (release 2): the title edits in place; the
           numbered prefix is shown but fixed. */
        .prod-title-editable { cursor: text; border-radius: 4px; }
        .prod-title-editable:hover, .prod-title-editable:focus-visible { background: var(--prod-hover, rgba(0,0,0,.04)); }
        .prod-title-editable .prod-title-prefix { opacity: .6; }
        .prod-title-editable.is-saving { opacity: .75; transition: opacity .15s ease; }
        .prod-title-input { font: inherit; color: inherit; background: transparent; border: 0; outline: none; padding: 0; width: 70%; }
        .cal-name-sync-retry { font: inherit; color: inherit; background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
        .cal-linear-slot { flex: 0 0 auto; display: flex; align-items: center; gap: 4px; }
        .cal-linear-slot:empty { display: none; }
        .cal-linear-btn { display: inline-flex; align-items: center; justify-content: center;
            width: 26px; height: 26px; padding: 0; border: 0; border-radius: 7px; cursor: pointer;
            background: var(--field-bg); color: var(--sv-fg-bdbdb8); transition: background 0.13s, color 0.13s; text-decoration: none; }
        .cal-linear-btn:hover { background: var(--field-bg-hover); color: var(--sv-fg-6b6b66); }
        .cal-linear-btn svg { width: 14px; height: 14px; }
        /* Unlinked card — the Linear button warns it must be connected. */
        .cal-linear-btn.cal-linear-btn-warn { background: var(--sv-bg-ffedd5); color: var(--sv-fg-ea580c); }
        .cal-linear-btn.cal-linear-btn-warn:hover { background: var(--sv-bg-fed7aa); color: var(--sv-fg-c2410c); }
        /* A SLOT THAT ALREADY HOLDS A LINK STILL SAYS WHICH COMPONENT IT IS.
           Colour carries the component here exactly as it does on the link
           fields, the status dots and the Production chips: pink for Video,
           blue for Thumbnail. Before the external Linear anchors were removed
           this came from the anchor's own `is-linked` rule, and dropping the
           anchors took the colour with it -- leaving the edit and clear
           buttons as two identical grey squares stacked in one pile, the video
           one above the thumbnail one, distinguishable only by a `title`
           tooltip that a touch device never shows. That is the 2026-09-15
           report verbatim ("both of them look the same"), and these are
           destructive controls, so a reader must not have to press one to find
           out which field it clears. Raised by Codex review on PR 1492.
           The class is NOT the old `is-linked`: that name also rode the
           Production anchors, which is why the rule it replaced needed a
           `:not(.cal-prod-btn)` guard to stop it repainting them. This one
           names the state it means and is never emitted on a Production
           control, so the two can no longer collide. It still sits BEFORE the
           Production rules below, so equal specificity resolves in
           Production's favour even if some future markup carries both. */
        .cal-linear-btn-video.cal-linear-btn-linked { background: var(--sv-slot-video-bg); color: var(--sv-slot-video-fg); }
        .cal-linear-btn-video.cal-linear-btn-linked:hover { background: var(--sv-slot-video-bg-hover); color: var(--sv-slot-video-fg); }
        .cal-linear-btn-graphic.cal-linear-btn-linked { background: var(--sv-slot-thumb-bg); color: var(--sv-slot-thumb-fg); }
        .cal-linear-btn-graphic.cal-linear-btn-linked:hover { background: var(--sv-slot-thumb-bg-hover); color: var(--sv-slot-thumb-fg); }
        /* SyncView Production sub-issue link — same footprint as the Linear
           icon. This used to be teal for BOTH components, which meant the two
           Production buttons in one pile were identical twins: same colour,
           same glyph, nothing to say which was the video and which the
           thumbnail (owner, 2026-09-15: "both of them look the same... the
           sync linear button looks the fucking same"). Teal carried the
           SYSTEM but threw away the COMPONENT, and the component is what a
           reader is actually picking between when both buttons stack up.
           So the two axes are split across two properties:
             - COLOUR = component. Pink for Video, blue for Thumbnail, the
               same pair the link fields and status dots already use, so a
               pile reads as a pink half and a blue half.
             - SHAPE = Production is a chip on the neutral raised surface,
               RINGED in its component colour around the open-in-a-new-tab box.
           The ring is a border, not a box-shadow: .cal-linear-pile sets its own
           drop box-shadow on every button in the pile and would clobber it.
           Global box-sizing is border-box, so the ring costs no footprint.
           The surface stays OPAQUE, and that is load-bearing rather than
           cosmetic (Codex, PR 1403). This pile is absolutely positioned OVER
           .cal-card-thumb, so a transparent centre puts the ring and the glyph
           straight onto arbitrary photo pixels — and measured against a
           deliberately hostile pink/white/lavender thumbnail, pink-on-pale-pink
           and blue-on-pale-lavender both washed out to nearly unreadable while
           the filled Linear chips beside them stayed crisp. A thumbnail is
           user-supplied art that can be any colour, so legibility here cannot
           depend on it. */
        .cal-linear-btn.cal-prod-btn { background: var(--surface-raised); border: 1.5px solid currentColor; }
        .cal-linear-btn-video.cal-prod-btn { color: var(--sv-slot-video-fg); }
        .cal-linear-btn-video.cal-prod-btn:hover { background: var(--sv-slot-video-bg); }
        .cal-linear-btn-graphic.cal-prod-btn { color: var(--sv-slot-thumb-fg); }
        .cal-linear-btn-graphic.cal-prod-btn:hover { background: var(--sv-slot-thumb-bg); }
        /* Fill the missing component. A DASHED outline over the plain field
           background, deliberately quieter than the orange warn state: a card
           with one component is a normal, common shape (127 of 688 live cards
           on 2026-08-31), not an error someone has to clear. The dash says
           "there is a slot here" without claiming anything is wrong. */
        .cal-linear-btn.cal-fill-btn { background: transparent; color: var(--sv-fg-bdbdb8);
            box-shadow: inset 0 0 0 1px var(--sv-shadow-rgba-0-0-0-0_10); border: 1px dashed var(--sv-fg-bdbdb8); }
        .cal-linear-btn.cal-fill-btn:hover { background: var(--sv-bg-e6f7f4);
            color: var(--sv-fg-0d9488); border-color: var(--sv-fg-0d9488); }
        /* Linear sub-issue buttons moved to a vertical pile at the bottom-right
           of the thumbnail box (video on top, graphic below). */
        .cal-linear-pile { position: absolute; right: 8px; bottom: 8px; z-index: 3; flex-direction: column; gap: 4px; }
        .cal-linear-pile .cal-linear-btn { box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_18); }
        /* YouTube title status — small colour square to the left of the title. */
        .cal-title-status-sq { flex: 0 0 auto; width: 22px; height: 22px; padding: 0; border: 0; border-radius: 6px; cursor: pointer; box-shadow: inset 0 0 0 1px var(--sv-shadow-rgba-0-0-0-0_10); transition: filter 0.12s; }
        .cal-title-status-sq:hover { filter: brightness(0.96); }
        .cal-title-status-sq.cal-fld-status-in-progress      { background: var(--cal-status-in-progress-bg); }
        .cal-title-status-sq.cal-fld-status-for-smm-approval { background: var(--cal-status-for-smm-approval-bg); }
        .cal-title-status-sq.cal-fld-status-kasper-approval  { background: var(--cal-status-kasper-approval-bg); }
        .cal-title-status-sq.cal-fld-status-client-approval  { background: var(--cal-status-client-approval-bg); }
        .cal-title-status-sq.cal-fld-status-approved         { background: var(--cal-status-approved-bg); }
        .cal-title-status-sq.cal-fld-status-tweaks-needed    { background: var(--cal-status-tweaks-needed-bg); }
        /* Collapse toggle for long Kasper review threads (show 3 most recent). */
        .cal-review-thread-toggle { display: block; width: 100%; text-align: center; background: none; border: 0; color: var(--sv-fg-6b6b66); font-size: 0.72rem; font-weight: 600; padding: 5px; margin: 2px 0; cursor: pointer; border-radius: 6px; }
        .cal-review-thread-toggle:hover { color: var(--sv-fg-3a3a37); background: var(--field-bg); }
        .cal-thumb-linear-warn { position: absolute; top: 0; left: 0; right: 0; z-index: 3;
            display: flex; align-items: center; justify-content: center; gap: 6px; padding: 5px 10px;
            border: 0; cursor: pointer; background: var(--sv-bg-ea580c); color: var(--sv-fg-fff); font-family: inherit;
            font-size: 0.68rem; font-weight: 700; letter-spacing: 0.02em; text-decoration: none; }
        .cal-thumb-linear-warn:hover { background: var(--sv-bg-c2410c); }
        .cal-thumb-linear-warn svg { width: 12px; height: 12px; flex-shrink: 0; }
        /* Multi-select mode — pick several posts, then bulk-archive. */
        .cal-select-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
            border: 1px solid var(--border); border-radius: 8px; background: var(--white); color: var(--text-secondary);
            cursor: pointer; transition: background 0.12s, border-color 0.12s, color 0.12s; }
        .cal-select-btn:hover { background: var(--bg); color: var(--text-primary); }
        .cal-select-btn.active { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
        .cal-select-btn svg { width: 15px; height: 15px; }
        .cal-card-select-overlay { position: absolute; inset: 0; z-index: 7; cursor: pointer; background: transparent;
            transition: background 0.12s; }
        .cal-card-select-overlay:hover { background: var(--sv-bg-rgba-37-99-235-0_07); }
        /* In select mode, shift-click should extend the selection, not the
           browser's text range — kill text selection across the strip. */
        .cal-organizer-strip.cal-selecting,
        .cal-organizer-strip.cal-selecting * { user-select: none; -webkit-user-select: none; }
        /* The check-circle sits OUTSIDE the card (negative offsets) so it
           can't be mistaken for the × archive button at the same corner.
           Backdrop-blur + double-ring shadow give it a floating, glassy
           look that reads clearly against any thumbnail behind it.
           overflow:visible on selectable cards lets it escape — the
           thumbnail keeps its own overflow:hidden so the image still
           clips against the rounded top of the card. */
        .cal-card-selectable { overflow: visible; }
        .cal-card-select-check { position: absolute; top: -9px; right: -9px; width: 26px; height: 26px; border-radius: 50%;
            background: var(--sv-bg-rgba-255-255-255-0_96); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
            border: 2px solid var(--sv-border-rgba-15-23-42-0_18); display: flex; align-items: center; justify-content: center;
            color: transparent; box-shadow: 0 6px 16px var(--sv-shadow-rgba-0-0-0-0_22), 0 0 0 4px var(--sv-shadow-rgba-255-255-255-0_5); z-index: 10; }
        .cal-card-select-check svg { width: 14px; height: 14px; stroke-width: 2.8; }
        .cal-card-selected { box-shadow: 0 0 0 3px var(--sv-shadow-2563eb); }
        .cal-card-selected .cal-card-select-check { background: var(--sv-bg-2563eb); border-color: var(--sv-border-fff); color: var(--sv-fg-fff);
            box-shadow: 0 6px 16px var(--sv-shadow-rgba-37-99-235-0_42), 0 0 0 3px var(--sv-shadow-fff); }
        .cal-select-bar { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 80;
            display: flex; align-items: center; gap: 12px; padding: 9px 11px 9px 18px; background: var(--text-primary);
            border-radius: 13px; box-shadow: 0 10px 30px var(--sv-shadow-rgba-0-0-0-0_32); }
        .cal-select-count { color: var(--white); font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
        .cal-select-bar button { font-family: inherit; font-size: 0.78rem; font-weight: 700; border: 0;
            border-radius: 8px; cursor: pointer; padding: 8px 15px; }
        .cal-select-archive { background: var(--sv-bg-dc2626); color: var(--sv-fg-fff); }
        .cal-select-archive:disabled { opacity: 0.4; cursor: default; }
        .cal-select-cancel { background: var(--sv-bg-rgba-255-255-255-0_16); color: var(--sv-fg-fff); }
        .cal-select-cancel:hover { background: var(--sv-bg-rgba-255-255-255-0_26); }
        /* Bulk colour-tag swatches shown in the select bar when colour mode is
           active. Scoped under .cal-select-bar so they beat the generic
           `.cal-select-bar button` padding/radius and stay circular. */
        .cal-bulk-color-swatches { display: inline-flex; align-items: center; gap: 7px; }
        .cal-select-bar .cal-bulk-color-swatch { width: 24px; height: 24px; border-radius: 50%; padding: 0; border: 1.5px solid var(--sv-border-rgba-255-255-255-0_85); box-shadow: 0 0 0 1px var(--sv-shadow-rgba-0-0-0-0_18); cursor: pointer; transition: transform 0.08s; }
        .cal-select-bar .cal-bulk-color-swatch:hover:not(:disabled) { transform: scale(1.14); }
        .cal-select-bar .cal-bulk-color-swatch:disabled { opacity: 0.4; cursor: default; }
        .cal-select-bar .cal-bulk-color-swatch.is-clear { background: var(--sv-bg-fff); position: relative; overflow: hidden; }
        .cal-select-bar .cal-bulk-color-swatch.is-clear::after { content: ''; position: absolute; left: 50%; top: 2px; width: 1.5px; height: calc(100% - 4px); background: var(--sv-bg-dc2626); transform: translateX(-50%) rotate(45deg); }
        .cal-bulk-color-label { color: var(--sv-fg-rgba-255-255-255-0_72); font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
        .cal-select-divider { width: 1px; height: 20px; background: var(--sv-bg-rgba-255-255-255-0_22); flex-shrink: 0; }
        /* Floating glass pill that slides in from the top of its parent
           (the parent needs position:relative). Reusable affordance for
           any "background refresh in progress" state — used by both the
           SMM calendar and the Kasper review queue. position:absolute
           keeps it out of toolbar flow so its appearance/disappearance
           never shifts other controls sideways. */
        /* Refreshing pill is fixed to the viewport so it stays visible while
           the user scrolls — previously it was position:absolute and slid
           off-screen with the page on long calendars. Sits 14px below
           the 60px sticky header (top:74px) so it never lands on top of
           the nav buttons / logo. z-index 101 puts it just over the
           header (header is z-index 100) but still under modals (1000+),
           so the pill is always visible even when the header is in the
           same vertical region. When the page hides the header
           (client share link view, etc.) the pill still floats 74px from
           the viewport top — well inside the visible content area. */
        .cal-refreshing, .app-refresh-pill { position: fixed; top: 74px; left: 50%; z-index: 101;
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 14px; background: var(--sv-bg-rgba-255-255-255-0_92);
            -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
            border: 1px solid var(--sv-border-rgba-0-0-0-0_08); border-radius: 99px;
            box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_08);
            font-size: 0.74rem; font-weight: 600; color: var(--text-secondary);
            opacity: 0; transform: translate(-50%, -140%); pointer-events: none;
            transition: opacity 0.22s ease-out, transform 0.22s ease-out; }
        .cal-refreshing:not([hidden]), .app-refresh-pill:not([hidden]) { opacity: 1; transform: translate(-50%, 0); }
        .cal-refreshing[hidden], .app-refresh-pill[hidden] { display: inline-flex; }
        .app-refresh-pill .cal-refresh-spin { width: 11px; height: 11px; border: 2px solid var(--border);
            border-top-color: var(--text-muted); border-radius: 50%; animation: cal-spin 0.7s linear infinite; }
        .cal-refresh-spin { width: 11px; height: 11px; border: 2px solid var(--border);
            border-top-color: var(--text-muted); border-radius: 50%; animation: cal-spin 0.7s linear infinite; }
        @keyframes cal-spin { to { transform: rotate(360deg); } }
        .cal-stale-notice { display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem;
            font-weight: 600; color: var(--sv-fg-b45309); background: var(--sv-bg-fef3c7); border: 1px solid var(--sv-border-fde68a);
            padding: 3px 8px; border-radius: 999px; cursor: pointer; }
        .cal-stale-notice:hover { background: var(--sv-bg-fde68a); }
        .cal-stale-notice[hidden] { display: none; }
        .cal-card-flash { animation: cal-flash 2.2s ease; }
        @keyframes cal-flash {
            0% { box-shadow: 0 0 0 0 var(--sv-shadow-rgba-94-106-210-0); }
            14% { box-shadow: 0 0 0 4px var(--sv-shadow-rgba-94-106-210-0_55); }
            70% { box-shadow: 0 0 0 4px var(--sv-shadow-rgba-94-106-210-0_45); }
            100% { box-shadow: 0 0 0 0 var(--sv-shadow-rgba-94-106-210-0); }
        }
        .cal-linear-input { flex: 1 1 0; min-width: 0; box-sizing: border-box; padding: 5px 9px;
            border: 1px solid var(--text-primary); border-radius: 7px; font-family: inherit;
            font-size: 0.78rem; color: var(--text-primary); background: var(--field-bg-focus); outline: 0; }

        /* Linear link already-in-use prompt — replaces the link input when the
           pasted sub-issue is already on another live card. Offers Move / Cancel. */
        .cal-link-conflict { flex: 1 1 0; min-width: 0; display: flex; flex-wrap: wrap; align-items: center;
            gap: 6px; padding: 5px 9px; box-sizing: border-box; border: 1px solid var(--sv-border-e0a23c);
            background: var(--sv-bg-fff7ea); border-radius: 7px; }
        .cal-link-conflict-msg { flex: 1 1 140px; min-width: 0; font-size: 0.72rem; line-height: 1.25;
            color: var(--sv-fg-7a4e10); }
        .cal-link-conflict-actions { display: flex; gap: 6px; flex-shrink: 0; }
        .cal-link-conflict-move, .cal-link-conflict-cancel { font-family: inherit; font-size: 0.72rem;
            font-weight: 600; padding: 4px 9px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
        .cal-link-conflict-move { background: var(--sv-bg-e0a23c); color: var(--sv-fg-fff); }
        .cal-link-conflict-move:hover { background: var(--sv-bg-cf9230); }
        .cal-link-conflict-cancel { background: transparent; color: var(--sv-fg-7a4e10); border-color: var(--sv-border-e0a23c); }
        .cal-link-conflict-cancel:hover { background: var(--sv-bg-f3e4cb); }

        /* Meta row — date + status as two equal chips */
        .cal-meta-row { display: flex; gap: 7px; }
        .cal-meta-row > * { flex: 1 1 0; min-width: 0; }

        /* Date chip */
        .cal-fld-date-wrap { position: relative; }
        .cal-date-chip { display: flex; align-items: center; gap: 6px; width: 100%; box-sizing: border-box;
            padding: 8px 9px; background: var(--field-bg); border-radius: 8px; font-size: 0.73rem; font-weight: 600;
            color: var(--text-primary); transition: background 0.12s; }
        .cal-fld-date-wrap:hover .cal-date-chip { background: var(--field-bg-hover); }
        .cal-cal-ico { width: 13px; height: 13px; flex-shrink: 0; color: var(--text-muted); }
        .cal-date-txt { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cal-date-chip.is-empty .cal-date-txt { color: var(--text-muted); font-weight: 500; }
        .cal-chev { width: 9px; height: 9px; flex-shrink: 0; color: var(--text-muted); }
        /* The native <input type="date"> is kept ONLY as the storage / change
           event sink — clicks go through to the chip, which opens the
           custom modern picker (.dp-popup) below. pointer-events: none
           on the input lets the chip absorb every click; the picker
           writes input.value and dispatches a change event so the existing
           _calOnDateChange / save plumbing keeps working unchanged. */
        .cal-fld-date-input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; opacity: 0; pointer-events: none; }
        .cal-fld-date-input::-webkit-calendar-picker-indicator { display: none; }
        .cal-fld-date-wrap .cal-date-chip { cursor: pointer; }
        .cal-fld-date-wrap.is-readonly .cal-date-chip { cursor: default; }
        /* Modern custom date picker — replaces the OS-rendered native popup
           so the calendar looks the same on every machine and inherits the
           app's styled tooltip + typography. Portaled to <body>; one
           shared instance per page. See setupDatePicker() at the bottom
           of the script block. */
        .dp-popup { position: fixed; z-index: 9999; width: 280px; padding: 12px 12px 10px;
            background: var(--white); border: 1px solid var(--border); border-radius: 12px;
            box-shadow: 0 14px 40px var(--sv-shadow-rgba-0-0-0-0_16);
            font-family: inherit; user-select: none; animation: dpFade 0.13s ease-out;
            max-height: calc(100vh - 16px); max-height: calc(100dvh - 16px); overflow-y: auto;
            overscroll-behavior: contain; }
        @keyframes dpFade { from { opacity: 1; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        .dp-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 2px 2px 10px; }
        .dp-head-label { font-size: 0.86rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
        .dp-head-nav { display: inline-flex; gap: 2px; }
        .dp-nav-btn { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px;
            border: 0; border-radius: 7px; background: transparent; color: var(--text-secondary); cursor: pointer;
            transition: background 0.12s, color 0.12s; }
        .dp-nav-btn:hover { background: var(--bg); color: var(--text-primary); }
        .dp-nav-btn svg { width: 12px; height: 12px; }
        .dp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
        .dp-dow { text-align: center; font-size: 0.62rem; font-weight: 700; color: var(--text-secondary);
            text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 0 6px; }
        .dp-day { aspect-ratio: 1; border: 0; background: transparent; border-radius: 8px;
            font-family: inherit; font-size: 0.78rem; font-weight: 500; color: var(--text-primary); cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            transition: background 0.12s, color 0.12s; }
        .dp-day:hover { background: var(--bg); }
        .dp-day:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        .dp-day:disabled { color: var(--text-muted); opacity: 0.24; cursor: not-allowed; background: transparent; }
        .dp-day.is-out { color: var(--text-secondary); opacity: 1; }
        .dp-day.is-out:disabled { opacity: 0.18; }
        .dp-day.is-today { box-shadow: inset 0 0 0 1.5px var(--text-secondary); font-weight: 700; }
        .dp-day.is-selected, .dp-day.is-selected:hover { background: var(--text-primary); color: var(--bg); font-weight: 700;
            box-shadow: none; }
        .dp-foot { display: flex; justify-content: space-between; align-items: center;
            margin-top: 10px; padding-top: 9px; border-top: 1px solid var(--border); }
        .dp-foot-btn { background: transparent; border: 0; font-family: inherit; font-size: 0.72rem; font-weight: 600;
            color: var(--text-primary); cursor: pointer; padding: 5px 9px; border-radius: 6px;
            transition: background 0.12s, color 0.12s; }
        .dp-foot-btn:hover { background: var(--bg); color: var(--text-primary); }
        .dp-foot-btn.is-primary { color: var(--text-primary); font-weight: 700; }
        .dp-foot-btn:disabled { opacity: 0.32; cursor: not-allowed; background: transparent; }
        @media (max-width: 600px) {
            .dp-popup { width: min(344px, calc(100vw - 16px)); box-sizing: border-box; padding: 14px 12px 12px; border-radius: 16px; }
            .dp-nav-btn { width: 34px; height: 34px; }
            .dp-day { min-height: 40px; }
        }
        @media (max-height: 500px) {
            .dp-popup { padding: 8px; }
            .dp-head { padding-bottom: 4px; }
            .dp-nav-btn { width: 28px; height: 28px; }
            .dp-dow { padding: 2px 0 3px; }
            .dp-day { min-height: 26px; }
            .dp-foot { margin-top: 4px; padding-top: 4px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .dp-popup { animation: none !important; transition: none !important; }
        }

        /* Link fields — paste a URL, then it becomes a click-to-open pill */
        .cal-link-field { display: flex; }
        .cal-link-input { width: 100%; box-sizing: border-box; background: var(--field-bg); border: 1px solid transparent;
            border-radius: 8px; padding: 8px 9px; font-family: inherit; font-size: 0.72rem; color: var(--text-secondary); outline: 0; }
        .cal-link-input::placeholder { color: var(--field-placeholder); }
        .cal-link-input:focus { background: var(--field-bg-focus); border-color: var(--field-border-focus); }
        .cal-link-field.has-link .cal-link-input { display: none; }
        .cal-link-field.has-link.editing .cal-link-input { display: block; }
        .cal-link-field.has-link.editing .cal-link-pill-open,
        .cal-link-field.has-link.editing .cal-link-folder,
        .cal-link-field.has-link.editing .cal-link-edit { display: none; }
        .cal-link-pill-open { flex: 1; min-width: 0; display: flex; align-items: center; gap: 7px;
            padding: 8px 9px; background: var(--field-bg); border: 0; border-radius: 8px 0 0 8px; cursor: pointer;
            font-family: inherit; font-size: 0.72rem; font-weight: 600; color: var(--text-primary); text-align: left; transition: background 0.12s; }
        .cal-link-pill-open:hover { background: var(--field-bg-hover); }
        .cal-link-ico { width: 13px; height: 13px; flex-shrink: 0; color: var(--text-secondary); }
        .cal-link-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cal-link-folder,
        .cal-link-edit { flex-shrink: 0; width: 32px; display: inline-flex; align-items: center; justify-content: center;
            background: var(--field-bg); border: 0; border-left: 1px solid var(--sv-border-e3e3e0); border-radius: 0 8px 8px 0;
            color: var(--text-muted); cursor: pointer; transition: background 0.12s, color 0.12s; }
        .cal-link-folder { border-radius: 0; }
        .cal-link-folder + .cal-link-edit { border-radius: 0 8px 8px 0; }
        .cal-link-folder:hover,
        .cal-link-edit:hover { background: var(--field-bg-hover); color: var(--text-primary); }
        .cal-link-folder svg,
        .cal-link-edit svg { width: 12px; height: 12px; }
        /* Coloured link pills once a URL is set */
        .cal-link-thumb.has-link .cal-link-pill-open { background: var(--sv-slot-thumb-bg); color: var(--sv-slot-thumb-fg); }
        .cal-link-thumb.has-link .cal-link-pill-open:hover { background: var(--sv-slot-thumb-bg-hover); }
        .cal-link-thumb.has-link .cal-link-ico { color: var(--sv-slot-thumb-fg); }
        .cal-link-thumb.has-link .cal-link-folder,
        .cal-link-thumb.has-link .cal-link-edit { background: var(--sv-slot-thumb-bg); color: var(--sv-slot-thumb-fg-soft); border-left-color: var(--sv-slot-thumb-border); }
        .cal-link-thumb.has-link .cal-link-folder:hover,
        .cal-link-thumb.has-link .cal-link-edit:hover { background: var(--sv-slot-thumb-bg-hover); color: var(--sv-slot-thumb-fg); }
        .cal-link-post.has-link .cal-link-pill-open { background: var(--sv-slot-video-bg); color: var(--sv-slot-video-fg); }
        .cal-link-post.has-link .cal-link-pill-open:hover { background: var(--sv-slot-video-bg-hover); }
        .cal-link-post.has-link .cal-link-ico { color: var(--sv-slot-video-fg); }
        .cal-link-post.has-link .cal-link-folder,
        .cal-link-post.has-link .cal-link-edit { background: var(--sv-slot-video-bg); color: var(--sv-slot-video-fg-soft); border-left-color: var(--sv-slot-video-border); }
        .cal-link-post.has-link .cal-link-folder:hover,
        .cal-link-post.has-link .cal-link-edit:hover { background: var(--sv-slot-video-bg-hover); color: var(--sv-slot-video-fg); }

        /* Caption */
        .cal-cap-wrap { position: relative; display: flex; flex-direction: column; }
        .cal-fld-cap { width: 100%; box-sizing: border-box; background: var(--field-bg); border: 1px solid transparent;
            border-radius: 8px; padding: 8px 9px; font-family: inherit; font-size: 0.74rem; line-height: 1.5;
            color: var(--text-primary); resize: none; outline: 0;
            scrollbar-width: thin; scrollbar-color: var(--sv-fg-c8c8c3) transparent; }
        .cal-fld-cap::placeholder { color: var(--field-placeholder); }
        .cal-fld-cap:focus { background: var(--field-bg-focus); border-color: var(--field-border-focus); }
        .cal-fld-cap::-webkit-scrollbar, .cal-fld-tweaks::-webkit-scrollbar { width: 9px; }
        .cal-fld-cap::-webkit-scrollbar-thumb, .cal-fld-tweaks::-webkit-scrollbar-thumb { background: var(--sv-bg-cdcdc8); border-radius: 99px; border: 3px solid transparent; background-clip: padding-box; }
        .cal-fld-cap::-webkit-scrollbar-thumb:hover, .cal-fld-tweaks::-webkit-scrollbar-thumb:hover { background: var(--sv-bg-b1b1aa); background-clip: padding-box; }
        .cal-fld-cap::-webkit-scrollbar-track, .cal-fld-tweaks::-webkit-scrollbar-track { background: transparent; }
        /* Bottom fade over a collapsed caption that has more text below — the
           passive "there's more" cue. Blends to the collapsed textarea bg
           (var(--sv-misc-f3f3f1)); pointer-events:none so clicks fall through to the box. */
        .cal-cap-fade { position: absolute; left: 1px; right: 1px; bottom: 1px; height: 38px;
            border-radius: 0 0 8px 8px; pointer-events: none; opacity: 0; transition: opacity 0.12s;
            background: linear-gradient(to bottom, var(--field-fade-from) 0%, var(--field-fade-mid) 55%, var(--field-bg) 100%); }
        .cal-cap-wrap.is-clamped .cal-cap-fade { opacity: 1; }
        /* The whole clamped, read-only caption is a tap-to-read-more target. */
        .cal-cap-wrap.is-clamped textarea.cal-fld-cap[readonly] { cursor: pointer; }
        .cal-cap-toggle { position: absolute; right: 7px; bottom: 7px; height: 21px; padding: 0 8px; border-radius: 99px;
            display: inline-flex; align-items: center; gap: 4px;
            background: var(--sv-bg-rgba-255-255-255-0_96); border: 1px solid var(--border); box-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_12);
            cursor: pointer; color: var(--text-secondary); font-family: inherit; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.01em; }
        .cal-cap-toggle:hover { color: var(--text-primary); border-color: var(--sv-border-999); }
        .cal-cap-toggle-txt { line-height: 1; white-space: nowrap; }
        .cal-cap-toggle svg { width: 10px; height: 10px; transition: transform 0.16s; }
        .cal-cap-toggle.is-expanded svg { transform: rotate(180deg); }
        /* Expanded: collapse the pill to just the up-chevron so it stops
           covering the end of the caption (which is then clickable). */
        .cal-cap-toggle.is-expanded { width: 21px; padding: 0; justify-content: center; }
        .cal-cap-toggle.is-expanded .cal-cap-toggle-txt { display: none; }

        /* CTA + tweaks — clean filled fields */
        .cal-fld-cta, .cal-fld-tweaks { width: 100%; box-sizing: border-box; background: var(--field-bg); border: 1px solid transparent;
            border-radius: 8px; padding: 8px 9px; font-family: inherit; font-size: 0.72rem; color: var(--text-primary); outline: 0; }
        .cal-fld-cta::placeholder, .cal-fld-tweaks::placeholder { color: var(--field-placeholder); }
        .cal-fld-cta:focus, .cal-fld-tweaks:focus { background: var(--field-bg-focus); border-color: var(--field-border-focus); }
        .cal-fld-tweaks { line-height: 1.5; resize: none; scrollbar-width: thin; }

        /* Alt caption — optional second platform-specific caption on a card.
           Rides inside the same caption component (one caption_status, one
           tweaks thread, one client approval); only the text differs.
           Rendered as browser-style tabs sitting on top of the caption box,
           so a second caption never makes the card taller. */
        .cal-capblock { display: flex; flex-direction: column; }
        .cal-capblock .cal-cap-wrap.captab-off { display: none; }
        .cal-cap-tabs { display: flex; align-items: center; gap: 2px; padding: 0 4px; }
        .cal-cap-tab { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px 5px;
            border: 0; border-radius: 8px 8px 0 0; background: transparent; color: var(--text-muted);
            font-family: inherit; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.02em; cursor: pointer;
            transition: background 0.1s, color 0.1s; }
        .cal-cap-tab:hover { color: var(--text-primary); }
        .cal-cap-tab.is-active { background: var(--field-bg); color: var(--text-primary); }
        .cal-capblock:focus-within .cal-cap-tab.is-active { background: var(--field-bg-focus); }
        .cal-cap-tab-chev { display: inline-flex; }
        .cal-cap-tab-chev svg { width: 8px; height: 8px; opacity: 0.6; }
        .cal-cap-tab-x { display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px;
            margin-right: -4px; border-radius: 4px; opacity: 0.5; transition: opacity 0.1s, background 0.1s; }
        .cal-cap-tab-x:hover { opacity: 1; background: var(--sv-bg-rgba-0-0-0-0_08); }
        .cal-cap-tab-x svg { width: 7px; height: 7px; }
        .cal-altcap-add { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; margin: 0 0 3px;
            border-radius: 99px; background: none; border: 1px dashed var(--border); color: var(--text-muted);
            font-family: inherit; font-size: 0.64rem; font-weight: 700; cursor: pointer; transition: color 0.12s, border-color 0.12s; }
        .cal-altcap-add:hover { color: var(--text-primary); border-color: var(--sv-border-999); }
        .cal-altcap-add svg { width: 9px; height: 9px; }
        /* Platform picker — same portal menu chrome as the status dropdowns
           (cal-fld-status-menu), but rows carry the platform icon dot instead
           of the coloured status fill. */
        .cal-cap-tab-menu-head { padding: 7px 11px 3px; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
        .cal-fld-status-item.cal-cap-tab-menu-item { gap: 8px; text-transform: none; letter-spacing: 0; font-size: 0.74rem; font-weight: 700; color: var(--text-primary); background: transparent; }
        .cal-fld-status-item.cal-cap-tab-menu-item:hover { background: var(--field-bg); filter: none; }
        .cal-cap-tab-menu-ico { width: 20px; height: 20px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: var(--sv-fg-fff); flex-shrink: 0; }
        .cal-cap-tab-menu-ico svg { width: 11px; height: 11px; }

        /* Dual-caption preview on the review surfaces — each caption sits in
           its own boxed card with an icon header (neutral text icon for the
           main caption, the platform's coloured icon for the alt), so a
           client immediately reads them as two separate deliverables. */
        .cal-review-preview-captions { width: 100%; display: flex; flex-direction: column; gap: 8px; text-align: left; }
        .cal-review-cap-card { border: 1px solid var(--sv-border-rgba-17-17-16-0_10); border-radius: 10px; background: var(--white); overflow: hidden; box-shadow: 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_03); }
        .cal-review-cap-head { display: flex; align-items: center; gap: 7px; padding: 7px 11px; background: var(--sv-bg-rgba-17-17-16-0_035); border-bottom: 1px solid var(--sv-border-rgba-17-17-16-0_07);
            font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
        .cal-review-cap-ico { width: 17px; height: 17px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: var(--sv-fg-fff); flex-shrink: 0; }
        .cal-review-cap-ico svg { width: 10px; height: 10px; }
        .cal-review-cap-card .cal-review-preview-caption { padding: 9px 11px; }
        /* Keep the boxes readable on the amber "changes requested" panel. */
        .cal-review-panel[data-state="tweaks"] .cal-review-cap-card { background: var(--sv-bg-rgba-255-255-255-0_65); border-color: var(--sv-border-rgba-124-45-18-0_18); }
        .cal-review-panel[data-state="tweaks"] .cal-review-cap-head { background: var(--sv-bg-rgba-124-45-18-0_06); border-bottom-color: var(--sv-border-rgba-124-45-18-0_12); color: var(--sv-fg-7c2d12); }
        /* Kasper hero variant — same labelled sections inside the parchment
           card, separated by a dashed rule. The card itself is pre-wrap (for
           the single-caption case), so the multi layout must reset it or the
           template's inter-tag newlines render as giant blank gaps. */
        .kasper-hero-caption-multi { display: flex; flex-direction: column; gap: 12px; white-space: normal; }
        .kasper-hero-cap-text { white-space: pre-wrap; }
        .kasper-hero-cap-sec + .kasper-hero-cap-sec { border-top: 1px dashed var(--sv-border-rgba-92-68-38-0_28); padding-top: 12px; }
        .kasper-hero-cap-head { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sv-fg-rgba-92-68-38-0_75); }

        .cal-card-foot { display: flex; align-items: center; justify-content: flex-start; min-height: 0; }
        .cal-card-saving { font-size: 0.64rem; font-weight: 700; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; }
        button.cal-card-saving { background: none; border: 0; padding: 0; margin: 0; font-family: inherit; cursor: pointer; }
        .cal-card-saving.is-saved { color: var(--sv-fg-166534); }
        .cal-card-saving.is-error { color: var(--dn); }
        button.cal-card-saving.is-error:hover { text-decoration: underline; }
        /* Status committed, card row still syncing: not an error, so no red. */
        .cal-card-saving.is-syncing { color: var(--text-muted); }
        button.cal-card-saving.is-syncing:hover { text-decoration: underline; }

        /* ── Reusable modern save indicator (icon-only). See _svSaveIndHtml. ──
           Themed via CSS variables so it works in both light and dark. */
        .sv-save-ind { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 15px; height: 15px; line-height: 0; transition: opacity 0.4s ease; }
        .sv-save-ind[hidden] { display: none; }
        .sv-save-ind.is-fading { opacity: 0; }
        .sv-save-ind-svg { display: block; overflow: visible; }
        .sv-save-ind-track { stroke: var(--border); }
        .sv-save-ind-arc { stroke: var(--text-muted); stroke-dasharray: 34 57; opacity: 0; }
        /* The glyphs sit on a SOLID colour disc, so they are white. */
        .sv-save-ind-check { stroke: var(--text-inverse); stroke-dasharray: 16; stroke-dashoffset: 16; opacity: 0; }
        .sv-save-ind-bang { stroke: var(--text-inverse); opacity: 0; }
        /* saving — a subtle partial arc rotating around the ring */
        .sv-save-ind.is-saving .sv-save-ind-svg { animation: spin 0.75s linear infinite; }
        .sv-save-ind.is-saving .sv-save-ind-arc { opacity: 1; }
        /* saved — a SOLID green disc with a white check that draws in */
        .sv-save-ind.is-saved .sv-save-ind-track { fill: var(--up); stroke: var(--up); }
        .sv-save-ind.is-saved .sv-save-ind-check { opacity: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 0.25s ease 0.05s; }
        /* error — a persistent SOLID red disc with a white exclamation */
        .sv-save-ind.is-error .sv-save-ind-track { fill: var(--dn); stroke: var(--dn); }
        .sv-save-ind.is-error .sv-save-ind-bang { opacity: 1; }
        @media (prefers-reduced-motion: reduce) {
            .sv-save-ind.is-saving .sv-save-ind-svg { animation: none; }
            .sv-save-ind.is-saved .sv-save-ind-check { transition: none; }
        }
        .cal-card-del { position: absolute; top: 7px; right: 7px; z-index: 4; width: 24px; height: 24px; border-radius: 50%; border: 0;
            background: var(--sv-bg-rgba-255-255-255-0_92); box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_22); color: var(--text-secondary); cursor: pointer;
            font-size: 1.1rem; line-height: 1; opacity: 0; transition: opacity 0.15s, background 0.12s, color 0.12s;
            display: inline-flex; align-items: center; justify-content: center; }
        .cal-card:hover .cal-card-del { opacity: 1; }
        .cal-card-del:hover { background: var(--dn); color: var(--sv-fg-fff); }

        /* Add-card — small subtle square, vertically centred in the strip */
        .cal-card-add { flex: 0 0 auto; align-self: center; width: 54px; height: 54px; border-radius: 13px;
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--white); border: 1.5px dashed var(--sv-border-c7c7c4); color: var(--text-muted);
            cursor: pointer; transition: background 0.14s, color 0.14s, border-color 0.14s; padding: 0; }
        .cal-card-add:hover { background: var(--text-primary); border-color: var(--text-primary); border-style: solid; color: var(--sv-fg-fff); }
        .cal-card-add svg { width: 20px; height: 20px; }
        /* First-post state — centred, larger, with a label */
        .cal-organizer-strip.is-empty { justify-content: center; align-items: center; }
        /* The right-side scroll runway (::after) takes up real flex space, which
           pulls the lone "Add the first post" hero left of the true centre when
           the strip is empty. Drop it in the empty state so the hero centres. */
        .cal-organizer-strip.is-empty::after { content: none; }
        .cal-card-add.cal-card-add-hero { width: auto; min-width: 168px; height: 168px; border-radius: 18px;
            flex-direction: column; gap: 12px; padding: 0 28px; }
        .cal-card-add-hero svg { width: 34px; height: 34px; }
        .cal-card-add-hero span { font-size: 0.84rem; font-weight: 700; }

        .cal-org-empty { padding: 40px 16px; text-align: center; color: var(--text-muted); font-size: 0.9rem; }

        .cal-chip { display: inline-flex; align-items: center; padding: 2px 7px; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; border: 1px solid currentColor; border-radius: 99px; }
        .cal-status { display: inline-block; align-self: flex-start; padding: 3px 10px; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.05em; border-radius: 99px; background: var(--bg); color: var(--text-secondary); text-transform: uppercase; white-space: nowrap; }
        .cal-status-in-progress { background: var(--cal-status-in-progress-bg); color: var(--cal-status-in-progress-fg); }
        .cal-status-for-smm-approval { background: var(--cal-status-for-smm-approval-bg); color: var(--cal-status-for-smm-approval-fg); }
        .cal-status-kasper-approval { background: var(--cal-status-kasper-approval-bg); color: var(--cal-status-kasper-approval-fg); }
        .cal-status-client-approval { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        .cal-status-approved { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .cal-status-tweaks-needed { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        .cal-status-scheduled { background: var(--cal-status-scheduled-bg); color: var(--cal-status-scheduled-fg); }
        .cal-status-posted { background: var(--cal-status-posted-bg); color: var(--cal-status-posted-fg); }
        .cal-status-archived { background: var(--cal-status-archived-bg); color: var(--cal-status-archived-fg); text-decoration: line-through; }
        /* N/A is deliberately the only neutral in the palette — every other
           status is a live pipeline state and earns a colour; "does not apply"
           should recede rather than compete with them. */
        .cal-status-n-a { background: var(--cal-status-n-a-bg); color: var(--cal-status-n-a-fg); }
        /* Status — clearly a dropdown; colour mirrors the chip palette */
        .cal-fld-status-wrap { position: relative; display: flex; align-items: center; justify-content: center;
            padding: 5px 11px; border-radius: 8px; background: var(--field-bg); color: var(--text-secondary);
            font-family: inherit; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
        .cal-fld-status-wrap.is-derived { cursor: default; user-select: none; }
        .cal-fld-status-wrap .cal-fld-status-label { line-height: 1; }
        .cal-fld-status-trigger { -webkit-appearance: none; appearance: none; width: 100%; box-sizing: border-box;
            padding: 8px 26px 8px 11px; border: 0; border-radius: 8px; outline: 0; cursor: pointer; text-align: left;
            background: transparent; color: inherit; font-family: inherit; font-size: 0.64rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.04em; }
        .cal-fld-status-trigger:disabled { cursor: not-allowed; }
        .cal-status-chev { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); width: 9px; height: 9px;
            pointer-events: none; color: inherit; opacity: 0.7; }
        .cal-fld-status-wrap.is-locked { opacity: 0.55; }
        /* Floating status menu — portaled to body so card overflow can't clip it. */
        /* max-height + scroll, because this menu is position: fixed. A fixed
           element taller than the viewport is CLIPPED and the clipped part
           cannot be reached by scrolling the page -- and the options that get
           clipped are the ones at the top, which is where N/A sits. So the
           note added on 2026-09-05 pointing the reader at N/A could, on a short
           viewport, be the thing that hid N/A. Found by Codex on PR 1277.
           (The PR number is written without a leading hash on purpose: the CSS
           colour guard reads a hash followed by four hex digits as a colour
           literal and fails the file. Yes, the first attempt at this comment
           tripped it, and so did the comment explaining that it tripped it.) */
        .cal-fld-status-menu { position: fixed; z-index: 1000; min-width: 200px; padding: 5px;
            max-height: calc(100vh - 20px); overflow-y: auto; overscroll-behavior: contain;
            background: var(--white); border-radius: 11px; box-shadow: 0 10px 30px var(--sv-shadow-rgba-0-0-0-0_16);
            opacity: 0; pointer-events: none; transform: translateY(-4px) scale(0.98); transform-origin: top center;
            transition: opacity 0.12s ease, transform 0.12s ease; }
        .cal-fld-status-menu.open { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
        /* Dropdown rows mirror the chip palette — each option is a filled,
           coloured row instead of plain text. The "active" item shows a
           subtle inset ring; hover slightly darkens via filter. */
        .cal-fld-status-item { display: flex; align-items: center; width: 100%; padding: 8px 11px;
            border: 0; border-radius: 7px; background: transparent; color: var(--text-secondary);
            font-family: inherit; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.045em;
            text-transform: uppercase; text-align: left; cursor: pointer; margin: 2px 0; transition: filter 0.1s; }
        .cal-fld-status-item:hover { filter: brightness(0.94); }
        /* A status this component cannot be moved to yet. Kept VISIBLE and in
           place rather than removed from the list: a menu whose options move
           around between openings is harder to use than one where the
           unavailable option is plainly there and plainly greyed. */
        .cal-fld-status-item[disabled] { opacity: 0.38; cursor: not-allowed; }
        .cal-fld-status-item[disabled]:hover { filter: none; }
        .cal-fld-status-note { padding: 7px 11px 8px; font-size: 0.68rem; line-height: 1.35;
            color: var(--text-secondary); border-top: 1px solid var(--border); }
        .cal-fld-status-item.active { box-shadow: inset 0 0 0 1.5px currentColor; }
        .cal-fld-status-item.cal-fld-status-n-a               { background: var(--cal-status-n-a-bg); color: var(--cal-status-n-a-fg); }
        .cal-fld-status-item.cal-fld-status-in-progress       { background: var(--cal-status-in-progress-bg); color: var(--cal-status-in-progress-fg); }
        .cal-fld-status-item.cal-fld-status-for-smm-approval  { background: var(--cal-status-for-smm-approval-bg); color: var(--cal-status-for-smm-approval-fg); }
        .cal-fld-status-item.cal-fld-status-kasper-approval   { background: var(--cal-status-kasper-approval-bg); color: var(--cal-status-kasper-approval-fg); }
        .cal-fld-status-item.cal-fld-status-client-approval   { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        .cal-fld-status-item.cal-fld-status-approved          { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .cal-fld-status-item.cal-fld-status-tweaks-needed     { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        .cal-fld-status-item.cal-fld-status-scheduled         { background: var(--cal-status-scheduled-bg); color: var(--cal-status-scheduled-fg); }
        .cal-fld-status-item.cal-fld-status-posted            { background: var(--cal-status-posted-bg); color: var(--cal-status-posted-fg); }
        .cal-fld-status-wrap[data-val="In Progress"]       { background: var(--cal-status-in-progress-bg); color: var(--cal-status-in-progress-fg); }
        .cal-fld-status-wrap[data-val="For SMM Approval"]  { background: var(--cal-status-for-smm-approval-bg); color: var(--cal-status-for-smm-approval-fg); }
        .cal-fld-status-wrap[data-val="Kasper Approval"]   { background: var(--cal-status-kasper-approval-bg); color: var(--cal-status-kasper-approval-fg); }
        .cal-fld-status-wrap[data-val="Client Approval"]   { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        .cal-fld-status-wrap[data-val="Approved"]          { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .cal-fld-status-wrap[data-val="Tweaks Needed"]     { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        .cal-fld-status-wrap[data-val="Scheduled"]         { background: var(--cal-status-scheduled-bg); color: var(--cal-status-scheduled-fg); }
        .cal-fld-status-wrap[data-val="Posted"]            { background: var(--cal-status-posted-bg); color: var(--cal-status-posted-fg); }

        /* Per-component sub-status pills (organizer view) — small clickable
           chips below the overall status that drive video/graphic/caption
           status individually. Click opens the same portal menu as the
           overall dropdown, but writes to the chosen sub-status. */
        .cal-card-substatus-row { display: flex; flex-direction: column; gap: 4px; margin-top: 5px; }
        /* "Set all" pill — visually distinct from the three component pills:
           neutral background, chain-link icon, and a centred label. Sits on
           top of the component pills as a fourth row. Clicking opens the
           same status picker the per-component pills use, but the selection
           writes to every component the SMM is allowed to change (caption
           always; video/graphic only if linked to a Linear sub-issue). */
        .cal-fld-setall { display: flex; align-items: center; gap: 7px; width: 100%; box-sizing: border-box;
            padding: 6px 10px; border-radius: 7px; border: 1px dashed var(--sv-border-cfcec7);
            background: var(--field-bg); color: var(--text-secondary);
            font-family: inherit; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.04em;
            text-transform: uppercase; cursor: pointer; transition: background 0.12s, border-color 0.12s, color 0.12s; }
        .cal-fld-setall:hover { background: var(--field-bg-hover); border-color: var(--text-secondary); color: var(--text-primary); }
        .cal-fld-setall svg { width: 13px; height: 13px; flex-shrink: 0; }
        .cal-fld-setall-label { flex: 1 1 auto; text-align: left; }
        .cal-fld-setall-chev { width: 9px; height: 9px; flex-shrink: 0; opacity: 0.55; }
        /* Header strip inside the status menu when it's opened from the
           Set-all pill — names which components the pick will affect, so
           the SMM sees the scope (and any skipped components) before they
           commit to a status. */
        .cal-fld-setall-menu-head { padding: 7px 11px 8px; margin-bottom: 4px;
            border-bottom: 1px solid var(--border); color: var(--text-secondary);
            font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
        .cal-fld-substatus-wrap { display: block; border-radius: 7px; background: var(--field-bg); color: var(--text-secondary); }
        .cal-fld-substatus-wrap.is-locked { opacity: 0.55; }
        .cal-fld-substatus-trigger { display: flex; align-items: center; gap: 7px; width: 100%; box-sizing: border-box;
            padding: 5px 9px; border: 0; border-radius: 7px; outline: 0; cursor: pointer; background: transparent;
            color: inherit; font-family: inherit; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
        .cal-fld-substatus-trigger:disabled { cursor: not-allowed; }
        /* Dot needs a thin ring so a similar-hue background (e.g. amber dot
           on the Tweaks Needed amber pill) doesn't make it disappear. */
        .cal-fld-substatus-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 1px var(--cal-comp-dot-ring); }
        /* Comp + label inherit the button colour so a coloured-state pill
           (tweaks, approved, etc.) reads with proper contrast against the
           tinted background. The slight alpha differentiates label vs. comp
           without falling back to muted gray. */
        .cal-fld-substatus-comp { color: inherit; opacity: 0.78; font-weight: 700; }
        .cal-fld-substatus-label { flex: 1; text-align: right; font-weight: 800; color: inherit; }
        .cal-fld-substatus-trigger.cal-fld-status-n-a              { background: var(--cal-status-n-a-bg); color: var(--cal-status-n-a-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-in-progress       { background: var(--cal-status-in-progress-bg); color: var(--cal-status-in-progress-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-for-smm-approval  { background: var(--cal-status-for-smm-approval-bg); color: var(--cal-status-for-smm-approval-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-kasper-approval   { background: var(--cal-status-kasper-approval-bg); color: var(--cal-status-kasper-approval-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-client-approval   { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-approved          { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-tweaks-needed     { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-scheduled         { background: var(--cal-status-scheduled-bg); color: var(--cal-status-scheduled-fg); }
        .cal-fld-substatus-trigger.cal-fld-status-posted            { background: var(--cal-status-posted-bg); color: var(--cal-status-posted-fg); }
        /* URGENT ping button — only rendered on the Video pill when it sits at
           Tweaks Needed and has a linked Linear sub-issue. The pill goes from a
           full-width block to a flex row so the status shrinks and the warm
           URGENT action docks on the right, the two reading as one segmented
           pill. Clicking posts to #video-editing via the SyncView Bot. */
        .cal-fld-substatus-wrap.has-urgent { display: flex; align-items: stretch; }
        .cal-fld-substatus-wrap.has-urgent .cal-fld-substatus-trigger { flex: 1 1 auto; width: auto; border-radius: 7px 0 0 7px; }
        .cal-urgent-btn { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 4px;
            padding: 5px 9px; border: 0; border-radius: 0 7px 7px 0; cursor: pointer;
            background: var(--cal-urgent-bg); color: var(--cal-urgent-fg); font-family: inherit; font-size: 0.58rem; font-weight: 800;
            letter-spacing: 0.05em; text-transform: uppercase; transition: background 0.12s; }
        .cal-urgent-btn:hover { background: var(--cal-urgent-hover-bg); }
        .cal-urgent-btn:disabled { background: var(--cal-urgent-disabled-bg); cursor: default; }
        .cal-urgent-btn.is-sent { background: var(--cal-urgent-sent-bg); }
        .cal-urgent-btn svg { width: 11px; height: 11px; flex-shrink: 0; }
        /* Standalone orange-red URGENT pill for Kasper's review-card action row — the
           same button as the calendar, minus the segmented border-radius, sized
           to sit beside Finish reviewing / Watch video. Warm bg, hover, is-sent
           (green) and disabled (grey) all inherit from .cal-urgent-btn. */
        .kcard-urgent-btn { padding: 9px 13px; border-radius: 10px; font-size: 0.72rem; letter-spacing: 0.04em; }
        .kcard-urgent-btn svg { width: 13px; height: 13px; }
        /* The Kasper flavour of the same button (a card parked at Kasper
           Approval, pinging HIM rather than the editor) deliberately has NO
           rules of its own. It is the same escalation aimed at a different
           person, so it inherits every state — base, hover, disabled grey,
           is-sent green — from .cal-urgent-btn above.

           It briefly carried two `.cal-urgent-btn.is-kasper` rules that merely
           repeated the base background and hover. They changed nothing on a
           fresh button and broke the finished ones: equal specificity but LATER
           in the sheet, so they beat `:disabled` and `.is-sent` and repainted a
           sent ping orange. A redundant override is not free — it silently
           outranks the states declared above it. (Codex P2 on PR 1370.)

           The title-row variant only re-rounds its corners: it docks beside the
           title square rather than on the end of a segmented pill, so it has no
           flat edge to meet. */
        .cal-title-urgent-btn { flex: 0 0 auto; border-radius: 7px; }
        /* Client-link view — read-only adjustments */
        .cal-fld-date-wrap.is-readonly .cal-date-chip { cursor: default; }
        .cal-fld-date-wrap.is-readonly:hover .cal-date-chip { background: var(--field-bg); }
        .cal-client-status { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
        /* Client view — let the status pill size to its label so it never
           wraps; the date pill takes the remaining width and truncates. */
        .cal-card-ro .cal-meta-row > .cal-client-status { flex: 0 0 auto; }
        .cal-approve-bar { display: flex; align-items: center; justify-content: center; gap: 7px;
            width: 100%; box-sizing: border-box; margin-top: 10px; padding: 11px 14px;
            border: none; border-radius: 10px; cursor: pointer;
            background: var(--sv-bg-166534); color: var(--sv-fg-fff); font-family: inherit; font-size: 0.84rem; font-weight: 700;
            letter-spacing: 0.01em; box-shadow: 0 2px 8px var(--sv-shadow-rgba-22-101-52-0_28);
            transition: background 0.13s, transform 0.08s, box-shadow 0.13s; }
        .cal-approve-bar:hover { background: var(--sv-bg-15803d); box-shadow: 0 4px 14px var(--sv-shadow-rgba-22-101-52-0_36); }
        .cal-approve-bar:active { transform: translateY(1px); box-shadow: 0 1px 5px var(--sv-shadow-rgba-22-101-52-0_3); }
        .cal-approve-bar svg { width: 14px; height: 14px; }
        .cal-link-field.cal-link-ro a.cal-link-pill-open { text-decoration: none; }
        /* Client read-only view has no edit button alongside the pill, so the
           pill's right-side corners need to round too — without this the
           pink Video / blue Thumbnail pill on the client sheet looks
           clipped on the right. */
        .cal-link-field.cal-link-ro .cal-link-pill-open { border-radius: 8px; }
        /* "Coming soon" placeholder — same shape as the populated pink Video
           pill so the layout doesn't shift when the SMM later fills in the
           link, but greyed out and non-interactive so the client can tell
           it's a slot, not a button. Tooltip on hover spells it out. */
        .cal-link-field.cal-link-empty .cal-link-pill-open { background: var(--field-bg); color: var(--text-muted); cursor: default; font-style: italic; }
        .cal-link-field.cal-link-empty .cal-link-pill-open:hover { background: var(--field-bg); }
        .cal-link-field.cal-link-empty .cal-link-ico { color: var(--text-muted); opacity: 0.7; }
        /* Global styled tooltip — same dark pill the Collab mode "i" uses,
           applied site-wide by the script at the end of the file in place
           of native browser title tooltips. See setupGlobalTooltip() for
           the wire-up and opt-out semantics (data-no-tip, form fields, etc.). */
        .global-tip { position: fixed; z-index: 99999; max-width: 240px; padding: 7px 11px;
            background: var(--sv-bg-0f172a); color: var(--sv-fg-fff);
            font-family: inherit; font-size: 0.72rem; font-weight: 500; line-height: 1.4; letter-spacing: 0;
            border-radius: 7px; box-shadow: 0 6px 20px var(--sv-shadow-rgba-0-0-0-0_22);
            pointer-events: none; white-space: normal; word-wrap: break-word; text-align: left;
            animation: globalTipFade 0.12s ease-out; }
        @keyframes globalTipFade { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
        .global-tip::before { content: ''; position: absolute;
            left: var(--arrow-left, 50%); transform: translateX(-50%);
            border: 5px solid transparent; }
        .global-tip[data-placement="above"]::before { top: 100%; border-top-color: var(--sv-border-0f172a); }
        .global-tip[data-placement="below"]::before { bottom: 100%; border-bottom-color: var(--sv-border-0f172a); }
        @media (prefers-reduced-motion: reduce) {
            .global-tip[data-label-explainer="true"] { animation: none !important; transition: none !important; }
        }

        /* Month + Week shared header */
        .cal-month-header { display: flex; align-items: center; gap: 12px; padding: 4px 4px 14px; }
        .cal-nav-btn { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); background: var(--white); cursor: pointer; font-size: 1rem; line-height: 1; color: var(--text-secondary); display: inline-flex; align-items: center; justify-content: center; }
        .cal-nav-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .cal-month-label { flex: 1; font-size: 1rem; font-weight: 700; color: var(--text-primary); }
        .cal-today-btn { padding: 6px 14px; border-radius: 99px; border: 1px solid var(--border); background: var(--white); font-family: inherit; font-size: 0.76rem; font-weight: 700; cursor: pointer; color: var(--text-primary); }
        .cal-today-btn:hover { border-color: var(--sv-border-aaa); }

        /* Month */
        .cal-month-wrap { padding: 4px 0; }
        .cal-month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        .cal-month-head { background: var(--bg); padding: 8px; font-size: 0.7rem; font-weight: 700; color: var(--text-muted); text-align: center; letter-spacing: 0.05em; text-transform: uppercase; }
        .cal-month-cell { background: var(--white); min-height: 196px; padding: 6px 8px; display: flex; flex-direction: column; gap: 4px; transition: background 0.12s; }
        .cal-month-cell:hover { background: var(--sv-bg-fafaf9); }
        .cal-month-cell.out { background: var(--sv-bg-fafafa); }
        .cal-month-cell.out .cal-month-num { color: var(--sv-fg-c5c5c2); }
        .cal-month-cell.out .cal-month-dow { color: var(--sv-fg-d6d6d3); }
        .cal-month-cell.today { background: var(--sv-bg-eff3ff); }
        .cal-month-cell.today:hover { background: var(--sv-bg-e7edff); }
        .cal-month-cell.today .cal-month-num { background: var(--sv-bg-4f46e5); color: var(--text-inverse); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; }
        .cal-month-cellhead { display: flex; align-items: center; gap: 5px; }
        .cal-month-dow { font-size: 0.6rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
        .cal-month-num { font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .cal-month-pill { position: relative; display: flex; flex-direction: column; align-items: stretch; background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 0; font-family: inherit; cursor: pointer; text-align: left; width: var(--cal-month-w, 112px); max-width: 100%; overflow: hidden; transition: border-color 0.12s, box-shadow 0.12s; }
        .cal-month-pill[draggable="true"] { cursor: grab; }
        .cal-day-drop { outline: 2px dashed var(--text-primary); outline-offset: -3px; background: var(--sv-bg-f0f0ee) !important; }
        .cal-move-grip { position: absolute; top: 4px; left: 4px; z-index: 3; width: 18px; height: 18px; border-radius: 5px;
            background: var(--sv-bg-rgba-255-255-255-0_94); box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_2); color: var(--text-muted);
            display: inline-flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.13s; pointer-events: none; }
        .cal-month-pill:hover .cal-move-grip, .cal-week-card:hover .cal-move-grip { opacity: 1; }
        .cal-move-grip svg { width: 11px; height: 11px; display: block; }
        .cal-card-dragging { opacity: 0.4; }
        .cal-month-pill:hover { border-color: var(--sv-border-888); box-shadow: 0 3px 10px var(--sv-shadow-rgba-0-0-0-0_09); }
        .cal-month-pill-thumb { width: 100%; aspect-ratio: 1 / 1; background: var(--sv-bg-f4f4f2); display: flex; align-items: center; justify-content: center; color: var(--text-muted); overflow: hidden; }
        .cal-month-pill-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cal-month-pill-thumb svg { width: 20px; height: 20px; }
        .cal-month-pill-meta { padding: 4px 6px 5px; display: flex; flex-direction: column; gap: 3px; }
        .cal-month-pill-name { font-size: 0.63rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.25; }
        .cal-month-pill-meta .cal-status { font-size: 0.54rem; padding: 2px 7px; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; }
        .cal-month-pill.is-posted { border-color: var(--sv-border-15803d); box-shadow: 0 0 0 1px var(--sv-shadow-15803d); }
        /* Review tab — client-facing 3-panel approval queue. Reuses .kcard-*. */
        .cal-review-wrap { padding: 18px 12px 60px; max-width: 1100px; margin: 0 auto; }
        .cal-review-list { display: flex; flex-direction: column; gap: 14px; }
        .cal-review-card { background: var(--white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.15s, border-color 0.15s; }
        .cal-review-card:hover { border-color: var(--sv-border-888); box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_07); }
        .cal-review-card.expanded { border-color: var(--text-primary); box-shadow: 0 4px 16px var(--sv-shadow-rgba-0-0-0-0_10); }
        .cal-review-sub-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
        .cal-review-sub-row:empty { display: none; }
        .cal-review-sub-summary { display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; color: var(--text-secondary); }
        .cal-review-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        /* Compact per-component divergence pills — only shown when a sub-status
           differs from the overall. Background colors are reused from the
           sub-status palette below. */
        .cal-review-sub-pill { display: inline-flex; padding: 2px 8px; border-radius: 5px;
            font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em;
            text-transform: uppercase; background: var(--field-bg); color: var(--text-secondary); }
        .cal-review-sub-pill.cal-fld-status-n-a               { background: var(--cal-status-n-a-bg); color: var(--cal-status-n-a-fg); }
        .cal-review-sub-pill.cal-fld-status-in-progress       { background: var(--cal-status-in-progress-bg); color: var(--cal-status-in-progress-fg); }
        .cal-review-sub-pill.cal-fld-status-for-smm-approval  { background: var(--cal-status-for-smm-approval-bg); color: var(--cal-status-for-smm-approval-fg); }
        .cal-review-sub-pill.cal-fld-status-kasper-approval   { background: var(--cal-status-kasper-approval-bg); color: var(--cal-status-kasper-approval-fg); }
        .cal-review-sub-pill.cal-fld-status-client-approval   { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        .cal-review-sub-pill.cal-fld-status-approved          { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .cal-review-sub-pill.cal-fld-status-tweaks-needed     { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        .cal-review-sub-pill.cal-fld-status-scheduled         { background: var(--cal-status-scheduled-bg); color: var(--cal-status-scheduled-fg); }
        .cal-review-sub-pill.cal-fld-status-posted            { background: var(--cal-status-posted-bg); color: var(--cal-status-posted-fg); }
        /* 3-column grid: video / thumbnail / caption side by side. Falls
           back to a single stacked column under ~880 px wide so the cards
           don't get crushed on small viewports. */
        .cal-review-body { padding: 16px 18px 18px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; border-top: 1px solid var(--border); background: var(--white); align-items: stretch; }
        @media (max-width: 880px) { .cal-review-body { grid-template-columns: 1fr; } }
        /* Each panel is a vertical stack with consistent gaps — clean,
           predictable, no overlapping flex layouts. */
        .cal-review-panel { background: transparent; border: 0; border-radius: 12px; padding: 0;
            display: flex; flex-direction: column; gap: 12px;
            transition: background 0.18s;
            height: 100%; }
        /* Only the "done" / "tweaks" states get a gentle fill — everything else
           is just stacked content on the white card, no boxes-in-boxes. */
        .cal-review-panel[data-state="approved"] { background: linear-gradient(135deg,var(--sv-bg-f0fdf4),var(--sv-bg-dcfce7)); }
        .cal-review-panel[data-state="tweaks"]   { background: var(--sv-bg-fff7ed); padding: 14px; }
        /* Inside the tweaks panel, the inner caption/textarea blend with
           the panel rather than sitting on a stacked gray box. */
        .cal-review-panel[data-state="tweaks"] .cal-review-preview-caption { color: var(--sv-fg-7c2d12); }
        .cal-review-panel[data-state="tweaks"] .cal-review-textarea { background: var(--sv-bg-rgba-255-255-255-0_78); border-color: var(--sv-border-rgba-124-45-18-0_2); }
        /* Approved/posted: a centered, restful state — big check, gentle
           label, optional subtitle. Same column height as the other panels
           so the row stays symmetric; content lives in the middle vertical
           band, not pinned to the top. */
        .cal-review-panel-mini { display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 10px; padding: 18px 14px; text-align: center; }
        .cal-review-mini-icon { display: inline-flex; width: 36px; height: 36px; border-radius: 50%;
            background: var(--sv-bg-16a34a); color: var(--sv-fg-fff);
            align-items: center; justify-content: center; flex-shrink: 0;
            box-shadow: 0 3px 10px var(--sv-shadow-rgba-22-101-52-0_22); }
        .cal-review-mini-icon svg { width: 18px; height: 18px; }
        .cal-review-mini-label { font-weight: 700; font-size: 0.92rem; color: var(--sv-fg-166534); letter-spacing: -0.005em; }
        .cal-review-mini-sub { font-size: 0.72rem; font-weight: 500; color: var(--sv-fg-15803d); opacity: 0.85; }
        .cal-review-panel-mini[data-state="posted"] .cal-review-mini-icon { background: var(--sv-bg-064e3b); box-shadow: 0 3px 10px var(--sv-shadow-rgba-6-78-59-0_28); }
        .cal-review-panel-mini[data-state="posted"] .cal-review-mini-label { color: var(--sv-fg-064e3b); }
        .cal-review-panel-mini[data-state="posted"] .cal-review-mini-sub { color: var(--sv-fg-047857); }
        /* Head: component name on the left, a soft status chip on the right.
           No bullet dot — the column position already says which component
           it is, and an extra dot just adds visual chatter. */
        .cal-review-panel-head { display: flex; align-items: center; gap: 10px; }
        .cal-review-panel-title { font-weight: 700; font-size: 0.92rem; color: var(--text-primary); letter-spacing: -0.005em; }
        /* Right-aligned cluster: status pill (when shown) + Linear link, so the
           Linear button stays pinned right even when the pill is hidden. */
        .cal-review-panel-head-right { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; }
        .cal-review-panel-head-right:empty { display: none; }
        .cal-review-panel-head-right .cal-review-panel-status { margin-left: 0; }
        /* Linear link — a compact icon-only button (the Linear mark), instead
           of a raw blue browser link. */
        .cal-review-linear-link { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 7px;
            background: var(--sv-bg-f3f4fb); border: 1px solid var(--sv-border-e2e3f3); color: var(--sv-fg-5e6ad2);
            text-decoration: none; line-height: 0; transition: background 0.12s, border-color 0.12s, color 0.12s, box-shadow 0.12s; }
        .cal-review-linear-link:hover { background: var(--sv-bg-ecedfb); border-color: var(--sv-border-c7c9f2); color: var(--sv-fg-4a54c0); box-shadow: 0 1px 3px var(--sv-shadow-rgba-94-106-210-0_18); }
        .cal-review-linear-mark { width: 13px; height: 13px; flex-shrink: 0; }
        .cal-review-no-link { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 7px;
            border: 1px dashed var(--border); color: var(--text-muted); }
        .cal-review-no-link .cal-review-linear-mark { opacity: 0.5; }
        .cal-review-panel-status { margin-left: auto; font-size: 0.7rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.045em;
            padding: 3px 9px; border-radius: 99px;
            background: var(--sv-bg-rgba-0-0-0-0_04); color: var(--text-secondary); }
        .cal-review-panel[data-state="tweaks"]   .cal-review-panel-status { background: var(--sv-bg-rgba-194-65-12-0_12); color: var(--sv-fg-9a3412); }
        .cal-review-panel[data-state="approved"] .cal-review-panel-status { background: var(--sv-bg-rgba-22-101-52-0_12); color: var(--sv-fg-166534); }
        .cal-review-panel[data-state="posted"]   .cal-review-panel-status { background: var(--sv-bg-rgba-6-78-59-0_18); color: var(--sv-fg-064e3b); }
        /* Preview area — image / caption / video link. Center-aligned and
           consistent across all three components. */
        .cal-review-panel-preview { font-size: 0.82rem; color: var(--text-primary);
            display: flex; align-items: flex-start; justify-content: center;
            min-height: 36px; }
        .cal-review-preview-empty { font-size: 0.78rem; color: var(--text-muted); font-style: italic; padding: 8px 0; }
        .cal-review-preview-link { display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 13px; background: var(--text-primary); color: var(--white);
            border-radius: 7px; text-decoration: none; font-weight: 600; font-size: 0.78rem;
            transition: opacity 0.12s; }
        .cal-review-preview-link:hover { opacity: 0.88; }
        .cal-review-preview-thumb { width: 100%; display: flex; justify-content: center; }
        .cal-review-preview-thumb-btn { padding: 0; border: 0; background: transparent; cursor: pointer; border-radius: 8px; overflow: hidden;
            box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_08); transition: transform 0.18s, box-shadow 0.18s; }
        .cal-review-preview-thumb-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_16); }
        .cal-review-preview-thumb-btn img { display: block; width: 100%; max-width: 260px; max-height: 220px; object-fit: contain; }
        /* Branded Frame.io click-to-open card for the expanded review previews
           (client review panel + Kasper hero/panel). Frame.io share links have
           no public image and block embedding, so instead of a broken <img>
           the client/Kasper get a dark poster that opens the thumbnail in
           Frame.io. Matches the calendar .cal-thumb-frame treatment. */
        .cal-review-frame { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
            width: 100%; max-width: 260px; min-height: 150px; padding: 22px 16px; border-radius: 10px;
            text-decoration: none; text-align: center; color: var(--sv-fg-fff);
            background: radial-gradient(120% 120% at 50% 32%, var(--sv-bg-262220) 0%, var(--sv-bg-0e0d0c) 74%);
            box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_08); transition: transform 0.18s, box-shadow 0.18s, background 0.18s; }
        .cal-review-frame:hover { transform: translateY(-1px); box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_16);
            background: radial-gradient(120% 120% at 50% 32%, var(--sv-bg-322d2a) 0%, var(--sv-bg-100f0e) 74%); }
        .cal-review-frame-badge { width: 52px; height: 52px; border-radius: 14px; background: var(--sv-bg-rgba-255-255-255-0_12);
            border: 1.5px solid var(--sv-border-rgba-255-255-255-0_5); display: flex; align-items: center; justify-content: center;
            transition: transform 0.18s, background 0.18s; }
        .cal-review-frame:hover .cal-review-frame-badge { transform: scale(1.06); background: var(--sv-bg-rgba-255-255-255-0_2); }
        .cal-review-frame-badge svg { width: 26px; height: 26px; }
        .cal-review-frame-cta { font-size: 0.84rem; font-weight: 700; letter-spacing: -0.01em; display: inline-flex; align-items: center; gap: 6px; }
        .cal-review-frame-cta svg { width: 13px; height: 13px; }
        .cal-review-frame-host { font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sv-fg-rgba-255-255-255-0_45); }
        /* Kasper hero variant — fills the same tall 9/16 poster silhouette as
           the video/graphic posters so the row stays visually consistent. */
        .cal-review-frame.is-hero { max-width: 380px; aspect-ratio: 9 / 16; max-height: 520px; min-height: 0;
            border-radius: 14px; gap: 16px; box-shadow: 0 8px 30px var(--sv-shadow-rgba-15-23-42-0_18), 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_06); }
        .cal-review-frame.is-hero:hover { box-shadow: 0 18px 50px var(--sv-shadow-rgba-15-23-42-0_28), 0 4px 12px var(--sv-shadow-rgba-0-0-0-0_08); }
        .cal-review-frame.is-hero .cal-review-frame-badge { width: 66px; height: 66px; border-radius: 18px; }
        .cal-review-frame.is-hero .cal-review-frame-badge svg { width: 32px; height: 32px; }
        .cal-review-frame.is-hero .cal-review-frame-cta { font-size: 0.95rem; }
        /* Video tile — same visual silhouette as the thumbnail tile, image
           blurred, with a centered play button + "Open video" overlay. Keeps
           the three columns' heights matched so the Approve buttons align. */
        .cal-review-video-tile { position: relative; display: block; width: 100%; max-width: 260px;
            aspect-ratio: 9 / 16; max-height: 220px; margin: 0 auto;
            border-radius: 8px; overflow: hidden; text-decoration: none;
            background: linear-gradient(135deg, var(--sv-bg-1f2937), var(--sv-bg-0f172a));
            box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_18);
            transition: transform 0.18s, box-shadow 0.18s; }
        .cal-review-video-tile:hover { transform: translateY(-1px); box-shadow: 0 6px 18px var(--sv-shadow-rgba-0-0-0-0_22); }
        .cal-review-video-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(8px) brightness(0.62); transform: scale(1.06); }
        .cal-review-video-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--sv-fg-fff); }
        .cal-review-video-play { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: var(--sv-bg-rgba-255-255-255-0_18); backdrop-filter: blur(6px); transition: background 0.14s, transform 0.14s; }
        .cal-review-video-play svg { width: 22px; height: 22px; margin-left: 3px; }
        .cal-review-video-tile:hover .cal-review-video-play { background: var(--sv-bg-rgba-255-255-255-0_28); transform: scale(1.06); }
        .cal-review-video-label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.01em; text-shadow: 0 1px 4px var(--sv-shadow-rgba-0-0-0-0_4); }
        .cal-review-preview-caption { padding: 0; background: transparent; white-space: pre-wrap; line-height: 1.5; font-size: 0.84rem; width: 100%; }
        /* Approve button — full width, dominant. */
        .cal-review-approve-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%; padding: 10px 14px;
            background: var(--sv-bg-16a34a); color: var(--white); border: 0; border-radius: 8px;
            font-family: inherit; font-size: 0.86rem; font-weight: 700; cursor: pointer;
            transition: background 0.12s, transform 0.08s, box-shadow 0.12s;
            box-shadow: 0 1px 2px var(--sv-shadow-rgba-22-101-52-0_16); }
        .cal-review-approve-btn:hover:not(:disabled) { background: var(--sv-bg-15803d); box-shadow: 0 3px 8px var(--sv-shadow-rgba-22-101-52-0_22); }
        .cal-review-approve-btn:active:not(:disabled) { transform: translateY(1px); }
        .cal-review-approve-btn:disabled { opacity: 0.55; cursor: default; }
        .cal-review-approve-btn svg { width: 14px; height: 14px; }
        /* SMM split approve — a primary "Approve" with a route chip showing the
           smart-default destination, paired with a soft ghost button for the
           other destination. No arrow glyphs; clean pill geometry. */
        .cal-review-approve-split { display: flex; align-items: stretch; gap: 8px; width: 100%; }
        .cal-review-approve-split .cal-review-approve-main { width: auto; flex: 1 1 auto; gap: 8px; border-radius: 11px; padding: 11px 16px; letter-spacing: -0.005em; }
        .cal-ap-verb { font-weight: 700; }
        .cal-ap-route { display: inline-flex; align-items: center; padding: 2px 9px; border-radius: 999px; background: var(--sv-bg-rgba-255-255-255-0_24); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.01em; }
        .cal-review-approve-alt { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; padding: 0 17px;
            background: var(--sv-bg-ffffff); color: var(--sv-fg-15803d); border: 1.5px solid var(--sv-border-c5efd5); border-radius: 11px;
            font-family: inherit; font-size: 0.82rem; font-weight: 700; line-height: 1; cursor: pointer; white-space: nowrap;
            transition: background 0.13s, border-color 0.13s, color 0.13s, box-shadow 0.13s; }
        .cal-review-approve-alt:hover:not(:disabled) { background: var(--sv-bg-f0fdf4); border-color: var(--sv-border-86efac); color: var(--sv-fg-166534); box-shadow: 0 2px 8px var(--sv-shadow-rgba-22-101-52-0_10); }
        .cal-review-approve-alt:active:not(:disabled) { background: var(--sv-bg-dcfce7); }
        .cal-review-approve-alt:disabled { opacity: 0.5; cursor: default; }
        /* "First review" flag — this component hasn't been to Kasper yet. */
        .cal-review-firstpass { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 99px;
            background: var(--sv-bg-f3e8ff); color: var(--sv-fg-7c3aed); font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
        .cal-review-firstpass::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
        /* Icon-only "no more tweaks needed" badge in the SMM review panel head. */
        .cal-review-aat-pill { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 99px;
            background: var(--sv-bg-dcfce7); color: var(--sv-fg-166534); flex-shrink: 0; }
        .cal-review-aat-pill svg { width: 13px; height: 13px; }
        /* Compose block — textarea full-width, button below right-aligned.
           No more textarea+button on the same line awkwardly fighting for
           space. */
        .cal-review-panel-compose { display: flex; flex-direction: column; gap: 8px; }
        .cal-review-textarea { width: 100%; box-sizing: border-box; min-height: 64px; padding: 9px 11px;
            border: 1px solid var(--border); border-radius: 8px;
            font-family: inherit; font-size: 0.84rem; color: var(--text-primary);
            resize: vertical; outline: 0; transition: border-color 0.12s, box-shadow 0.12s; }
        .cal-review-textarea:focus { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-0-0-0-0_04); }
        html[data-theme="dark"] .cal-review-textarea { background: var(--field-bg); }
        html[data-theme="dark"] .cal-review-textarea:focus { border-color: var(--field-border-focus); background: var(--field-bg-focus); }
        .cal-review-tweak-btn { align-self: flex-end; display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 13px; background: var(--white);
            border: 1px solid var(--text-primary); color: var(--text-primary);
            border-radius: 7px; font-family: inherit; font-size: 0.8rem; font-weight: 600;
            cursor: pointer; transition: background 0.12s, color 0.12s; }
        .cal-review-tweak-btn:hover:not(:disabled) { background: var(--text-primary); color: var(--white); }
        .cal-review-tweak-btn:disabled { opacity: 0.45; cursor: default; }
        .cal-review-tweak-btn svg { width: 12px; height: 12px; }
        /* "Comment" — neutral sibling of Request change. A plain internal note
           that doesn't change status or ping the editor, so it's styled quietly
           (muted, no heavy border) to sit below the change-request actions. */
        .cal-review-comment-btn { align-self: flex-end; display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 13px; background: var(--white);
            border: 1px solid var(--border, var(--sv-border-e2e2e2)); color: var(--text-secondary, var(--sv-fg-6b6b6b));
            border-radius: 7px; font-family: inherit; font-size: 0.8rem; font-weight: 600;
            cursor: pointer; transition: background 0.12s, color 0.12s, border-color 0.12s; }
        .cal-review-comment-btn:hover:not(:disabled) { background: var(--bg-muted, var(--sv-bg-f4f4f5)); color: var(--text-primary); border-color: var(--text-secondary, var(--sv-border-9b9b9b)); }
        .cal-review-comment-btn:disabled { opacity: 0.45; cursor: default; }
        .cal-review-comment-btn svg { width: 12px; height: 12px; }
        /* Row holding the comment + tweak actions (Comment · Approve after tweaks · Request change). */
        .cal-review-tweak-actions { align-self: flex-end; display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
        /* "Approve after tweaks" — green sibling of the Send button. Sends the
           tweak AND pre-clears the component for the client. */
        .cal-review-aat-btn { display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 13px; background: var(--white);
            border: 1px solid var(--sv-border-16a34a); color: var(--sv-fg-166534);
            border-radius: 7px; font-family: inherit; font-size: 0.8rem; font-weight: 600;
            cursor: pointer; transition: background 0.12s, color 0.12s; }
        .cal-review-aat-btn:hover:not(:disabled) { background: var(--sv-bg-16a34a); color: var(--white); }
        .cal-review-aat-btn:disabled { opacity: 0.45; cursor: default; }
        .cal-review-aat-btn svg { width: 12px; height: 12px; }
        .cal-review-panel-err { font-size: 0.76rem; color: var(--dn); background: var(--dn-bg); padding: 6px 10px; border-radius: 6px; }
        .cal-review-thread { padding-top: 10px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
        /* Quote-style comment: left rule tinted to the component colour. */
        .cal-review-comment { padding: 2px 0 2px 11px; border-left: 2px solid var(--border); background: transparent; transition: opacity 0.18s; }
        .cal-review-panel[data-comp="video"]   .cal-review-comment { border-left-color: var(--sv-border-rgba-6-182-212-0_55); }
        .cal-review-panel[data-comp="graphic"] .cal-review-comment { border-left-color: var(--sv-border-rgba-217-70-239-0_55); }
        .cal-review-panel[data-comp="caption"] .cal-review-comment { border-left-color: var(--sv-border-rgba-245-158-11-0_55); }
        .cal-review-comment-head { font-size: 0.74rem; color: var(--text-muted); margin-bottom: 2px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        /* Chat-style author tint so Kasper can scan who said what at a glance —
           his own messages vs the SMM's reply vs the client. */
        .cal-review-comment.cal-cm-kasper .cal-review-comment-head strong { color: var(--sv-fg-7c3aed); }
        .cal-review-comment.cal-cm-smm    .cal-review-comment-head strong { color: var(--sv-fg-0891b2); }
        .cal-review-comment.cal-cm-client .cal-review-comment-head strong { color: var(--sv-fg-16a34a); }
        .cal-review-comment-time { font-weight: 500; }
        .cal-review-comment-body { font-size: 0.82rem; color: var(--text-primary); white-space: pre-wrap; line-height: 1.45; }
        .cal-review-comment-empty { font-size: 0.76rem; color: var(--text-muted); font-style: italic; padding: 6px 0; }
        /* Resolved comments — strike-through body + tiny "Resolved" pill so
           the client can tell at a glance which tweaks were applied. */
        .cal-review-comment.is-reply { margin-left: 22px; }
        .cal-review-comment.is-resolved { opacity: 0.62; }
        .cal-review-comment.is-resolved .cal-review-comment-body { text-decoration: line-through; text-decoration-thickness: 1px; text-decoration-color: var(--sv-fg-rgba-0-0-0-0_4); }
        .cal-review-resolved-pill { display: inline-flex; align-items: center; gap: 3px;
            padding: 1px 7px 1px 5px; border-radius: 99px;
            background: var(--sv-bg-dcfce7); color: var(--sv-fg-166534);
            font-size: 0.62rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
        .cal-review-resolved-pill svg { width: 9px; height: 9px; }
        .cal-month-pill[data-tweak-comp]::after { content: ""; position: absolute; top: 0; right: 0; width: 0; height: 0; border-style: solid; border-width: 0 8px 8px 0; pointer-events: none; }
        .cal-month-pill[data-tweak-comp="video"]::after   { border-color: transparent var(--sv-border-06b6d4) transparent transparent; }
        .cal-month-pill[data-tweak-comp="graphic"]::after { border-color: transparent var(--sv-border-d946ef) transparent transparent; }
        .cal-month-pill[data-tweak-comp="caption"]::after { border-color: transparent var(--sv-border-f59e0b) transparent transparent; }
        .cal-week-card[data-tweak-comp]::after { content: ""; position: absolute; top: 0; right: 0; width: 0; height: 0; border-style: solid; border-width: 0 10px 10px 0; pointer-events: none; }
        .cal-week-card[data-tweak-comp="video"]::after   { border-color: transparent var(--sv-border-06b6d4) transparent transparent; }
        .cal-week-card[data-tweak-comp="graphic"]::after { border-color: transparent var(--sv-border-d946ef) transparent transparent; }
        .cal-week-card[data-tweak-comp="caption"]::after { border-color: transparent var(--sv-border-f59e0b) transparent transparent; }
        .cal-unscheduled { margin-top: 16px; padding: 12px 16px; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; }
        .cal-unscheduled.cal-unscheduled-top { margin-top: 0; margin-bottom: 14px; }
        .cal-unscheduled-h { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
        .cal-unscheduled-list { display: flex; flex-wrap: wrap; gap: 6px; }

        /* Week */
        .cal-week-wrap { padding: 4px 0; }
        /* The grid is a horizontal strip translated by the wheel handler; the
           viewport clips the 1-day buffer column on each side so the visible
           week sits flush. overflow-x:clip keeps vertical content (tall day
           columns) fully visible while hiding the horizontal overflow. */
        .cal-week-viewport { overflow-x: clip; }
        .cal-week-grid { display: flex; flex-wrap: nowrap; gap: 8px; will-change: transform; }
        /* min-height holds one full card (thumb + 2-line title + badge) plus
           the day header, so empty/sparse days reserve the same height as a
           day with a post and the strip never collapses as weeks slide by.
           Tied to --cal-week-h so it scales with the zoom level. Flex stretch
           then keeps every column in the strip the same height. */
        .cal-week-col { flex: 0 0 var(--cal-week-colw, 200px); background: var(--white); border: 1px solid var(--border); border-radius: 10px; min-height: calc(var(--cal-week-h, 320px) + 160px); display: flex; flex-direction: column; overflow: hidden; }
        .cal-week-col.today { border-color: var(--sv-border-4f46e5); }
        .cal-week-head { padding: 10px 12px; border-bottom: 1px solid var(--border); background: var(--bg); }
        .cal-week-col.today .cal-week-head { background: var(--sv-bg-eef0fe); border-bottom-color: var(--sv-border-d9daf8); }
        .cal-week-day { font-size: 0.7rem; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; text-transform: uppercase; }
        .cal-week-num { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin-top: 2px; }
        .cal-week-col.today .cal-week-day, .cal-week-col.today .cal-week-num { color: var(--sv-fg-4f46e5); }
        .cal-week-stack { flex: 1; padding: 8px; display: flex; flex-direction: column; gap: 8px; }
        .cal-week-card { display: flex; flex-direction: column; align-items: stretch; padding: 0; background: var(--white); border: 1px solid var(--border); border-radius: 10px; cursor: pointer; text-align: left; font-family: inherit; overflow: hidden; transition: border-color 0.12s, box-shadow 0.12s; }
        .cal-week-card:hover { border-color: var(--sv-border-888); box-shadow: 0 3px 12px var(--sv-shadow-rgba-0-0-0-0_10); }
        .cal-week-card { position: relative; }
        .cal-week-card.is-posted { border-color: var(--sv-border-15803d); box-shadow: 0 0 0 1px var(--sv-shadow-15803d); }
        .cal-week-card[draggable="true"] { cursor: grab; }
        .cal-week-card-thumb { width: 100%; height: var(--cal-week-h, 320px); flex-shrink: 0; background: var(--sv-bg-f4f4f2); display: flex; align-items: center; justify-content: center; color: var(--text-muted); overflow: hidden; }
        .cal-week-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cal-week-card-thumb svg { width: 30px; height: 30px; }
        .cal-week-card-body { padding: 8px 10px 10px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
        .cal-week-card-body .cal-status { max-width: 100%; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; }
        /* Clamp to two lines with a reserved two-line min-height so a card's
           height never shifts with title length as days slide into view. */
        .cal-week-card-name { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); line-height: 1.3;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }

        /* Preview popover (Month/Week → read-only post details) */
        .cal-preview-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--sv-bg-rgba-0-0-0-0_35); z-index: 250; align-items: center; justify-content: center; }
        .cal-preview-overlay.open { display: flex; }
        .cal-preview { background: var(--white); border-radius: 16px; padding: 0; width: 460px; max-width: 94vw; max-height: 86vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px var(--sv-shadow-rgba-0-0-0-0_25); overflow: hidden; }
        .cal-preview-thumb { width: 100%; height: 200px; background: var(--bg); display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .cal-preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .cal-preview-body { padding: 18px 22px 14px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
        .cal-preview-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
        .cal-preview-title { font-size: 1.05rem; font-weight: 800; color: var(--text-primary); flex: 1; }
        .cal-preview-close { width: 30px; height: 30px; border-radius: 50%; border: none; background: var(--bg); font-size: 1.3rem; line-height: 1; cursor: pointer; color: var(--text-muted); flex-shrink: 0; }
        .cal-preview-close:hover { background: var(--border); color: var(--text-primary); }
        .cal-preview-meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-size: 0.78rem; color: var(--text-secondary); }
        .cal-preview-row { display: flex; flex-direction: column; gap: 4px; padding: 4px 0; }
        .cal-preview-label { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
        .cal-preview-val { font-size: 0.86rem; color: var(--text-primary); line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
        .cal-preview-val.empty { color: var(--text-muted); font-style: italic; }
        .cal-preview-val a { color: var(--sv-fg-4338ca); text-decoration: underline; }
        .cal-preview-foot { padding: 12px 22px 18px; display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid var(--border); }

        /* Shared buttons (used by preview popover) */
        .cal-btn { padding: 9px 18px; border-radius: 99px; font-family: inherit; font-size: 0.82rem; font-weight: 700; cursor: pointer; border: 1px solid var(--border); background: var(--white); color: var(--text-primary); }
        .cal-btn:hover { border-color: var(--sv-border-aaa); }
        .cal-btn-primary { background: var(--text-primary); border-color: var(--text-primary); color: var(--white); }
        .cal-btn-primary:hover { opacity: 0.9; border-color: var(--text-primary); }
        .cal-btn-secondary { background: var(--white); }

        /* ── Card tweaks button + threaded-tweaks modal ─────────────── */
        .cal-card-foot { justify-content: space-between; gap: 8px; }
        .cal-card-status-row { margin-top: 8px; }
        /* Tweaks button — compact, ghost-style. When idle it's a quiet
           icon + label (no border, no background). When threads are open
           it picks up a faint amber underline-style notification dot
           with a tiny number — modern and unobtrusive. */
        .cal-comments-btn { display: inline-flex; align-items: center; gap: 5px;
            background: transparent; border: 0;
            color: var(--text-muted); border-radius: 6px;
            padding: 3px 6px; font-family: inherit; font-size: 0.74rem;
            font-weight: 500; letter-spacing: 0; cursor: pointer; position: relative;
            transition: color 0.14s ease, background 0.14s ease; }
        .cal-comments-btn:hover { color: var(--text-primary); background: var(--bg); }
        .cal-comments-btn svg { width: 13px; height: 13px; opacity: 0.7; }
        .cal-comments-btn:hover svg { opacity: 1; }
        .cal-comments-btn .cal-comments-label { letter-spacing: 0; }
        .cal-comments-btn .cal-comments-count { display: none; }
        /* Unread-replies dot — a new message the viewer hasn't opened yet. */
        .cal-comments-dot { display: inline-block; width: 7px; height: 7px; border-radius: 99px;
            background: var(--cal-notes-dot-bg); box-shadow: 0 0 0 2px var(--cal-notes-dot-ring), 0 0 0 4px var(--cal-notes-dot-glow); flex-shrink: 0; }
        .cal-comments-btn.has-unread { color: var(--cal-notes-accent-fg); font-weight: 600; }
        .cal-comments-btn.has-unread svg { opacity: 1; color: var(--cal-notes-accent-fg); }
        .cal-comments-btn.has-open { color: var(--cal-notes-accent-fg); font-weight: 600; }
        .cal-comments-btn.has-open svg { opacity: 1; color: var(--cal-notes-accent-fg); }
        .cal-comments-btn.has-open:hover { background: var(--cal-notes-open-bg); }
        .cal-comments-btn.has-open .cal-comments-count {
            display: inline-block; min-width: 16px; height: 16px; padding: 0 4px;
            border-radius: 99px; background: var(--cal-notes-dot-bg); color: var(--cal-notes-count-fg);
            font-size: 0.62rem; font-weight: 700; font-variant-numeric: tabular-nums;
            letter-spacing: 0; line-height: 16px; text-align: center;
            box-sizing: border-box; vertical-align: middle;
        }

        /* Slack/Discord-style continuous feed. Conversation and composer
           share one background — no hard mid-modal separator. */
        .cal-comments-overlay { display: none; position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_4); z-index: 320; align-items: center; justify-content: center; padding: 20px; }
        .cal-comments-overlay.open { display: flex; }
        .cal-comments-modal { background: var(--white); border-radius: 16px; width: 560px; max-width: 96vw; height: 86vh; max-height: 720px; display: flex; flex-direction: column; box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_24); overflow: hidden; }
        .cal-comments-head { padding: 16px 20px 14px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-shrink: 0; }
        .cal-comments-head-text { min-width: 0; flex: 1; }
        .cal-comments-head-text h3 { margin: 0 0 2px; font-size: 0.98rem; font-weight: 800; color: var(--text-primary); }
        .cal-comments-head-text p { margin: 0; font-size: 0.74rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cal-comments-close { width: 28px; height: 28px; border-radius: 50%; border: none; background: var(--bg); font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--text-muted); flex-shrink: 0; }
        .cal-comments-close:hover { background: var(--border); color: var(--text-primary); }
        /* History (resolved) toggle, top-right next to close. */
        .cal-comments-hist { display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 9px; border-radius: 99px; border: 1px solid var(--border); background: var(--white); color: var(--text-muted); cursor: pointer; flex-shrink: 0; transition: background 0.12s, color 0.12s, border-color 0.12s; }
        .cal-comments-hist:hover { background: var(--bg); color: var(--text-primary); }
        .cal-comments-hist.is-active { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
        .cal-comments-hist svg { width: 14px; height: 14px; }
        .cal-comments-hist-count { font-size: 0.68rem; font-weight: 700; font-variant-numeric: tabular-nums; }
        /* Bare internal lock icon on a row (no text). */
        .cal-cm-lock { display: inline-flex; align-items: center; color: var(--sv-fg-8b5cf6); flex-shrink: 0; }
        .cal-cm-lock svg { width: 12px; height: 12px; }
        .cal-comments-feed { flex: 1; overflow-y: auto; padding: 8px 0 0; display: flex; flex-direction: column; background: var(--white); }
        .cal-comments-feed-inner { display: flex; flex-direction: column; padding: 8px 4px 14px; flex: 1; }
        .cal-comments-empty { font-size: 0.84rem; color: var(--text-muted); padding: 36px 24px; text-align: center; line-height: 1.5; }
        .cal-comments-empty-title { font-weight: 700; color: var(--text-primary); margin-bottom: 4px; font-size: 0.9rem; }
        .cal-cm-thread { display: flex; flex-direction: column; }
        .cal-cm-thread.is-done .cal-cm-row { opacity: 0.6; transition: opacity 0.15s; }
        .cal-cm-thread.is-done:hover .cal-cm-row { opacity: 0.9; }
        .cal-cm-thread.is-done .cal-cm-row-body { color: var(--text-secondary); font-style: italic; }
        .cal-cm-row { position: relative; display: flex; gap: 11px; padding: 7px 22px 7px 22px; align-items: flex-start; transition: background 0.1s; }
        .cal-cm-row:hover { background: var(--sv-bg-f7f7f5); }
        .cal-cm-row.is-reply { padding-left: 64px; }
        .cal-cm-avatar { width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.78rem; color: var(--sv-fg-fff); letter-spacing: 0.01em; font-family: inherit; }
        .cal-cm-row.is-reply .cal-cm-avatar { width: 26px; height: 26px; border-radius: 7px; font-size: 0.66rem; }
        .cal-cm-avatar.is-smm { background: linear-gradient(135deg, var(--sv-bg-4f46e5), var(--sv-bg-7c3aed)); }
        .cal-cm-avatar.is-client { background: linear-gradient(135deg, var(--sv-bg-16a34a), var(--sv-bg-059669)); }
        .cal-cm-body-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .cal-cm-head-line { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; line-height: 1.3; }
        .cal-cm-comp-badge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 0.62rem;
            font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: var(--sv-fg-fff); flex-shrink: 0; align-self: center; }
        .cal-cm-comp-badge.cal-cm-comp-video   { background: var(--sv-bg-06b6d4); }
        .cal-cm-comp-badge.cal-cm-comp-graphic { background: var(--sv-bg-d946ef); }
        .cal-cm-comp-badge.cal-cm-comp-caption { background: var(--sv-bg-f59e0b); }
        .cal-cm-comp-label { margin-left: auto; flex-shrink: 0; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
        .cal-cm-comp-label.cal-cm-comp-video   { color: var(--sv-fg-0891b2); }
        .cal-cm-comp-label.cal-cm-comp-graphic { color: var(--sv-fg-c026d3); }
        .cal-cm-comp-label.cal-cm-comp-caption { color: var(--sv-fg-d97706); }
        .cal-cm-author { font-weight: 800; color: var(--text-primary); font-size: 0.86rem; }
        .cal-cm-row.is-reply .cal-cm-author { font-size: 0.8rem; }
        .cal-cm-time { font-size: 0.7rem; color: var(--text-muted); font-weight: 500; }
        .cal-cm-done-tag { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sv-fg-166534); background: var(--sv-bg-dcfce7); padding: 1px 7px; border-radius: 99px; }
        .cal-cm-row-body { font-size: 0.9rem; color: var(--text-primary); line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
        .cal-cm-row.is-reply .cal-cm-row-body { font-size: 0.86rem; }
        .cal-cm-actions { position: absolute; right: 16px; top: 4px; display: flex; gap: 2px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 2px; box-shadow: 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_06); opacity: 0; pointer-events: none; transition: opacity 0.12s; }
        .cal-cm-row:hover .cal-cm-actions, .cal-cm-row:focus-within .cal-cm-actions { opacity: 1; pointer-events: auto; }
        .cal-cm-action { background: transparent; border: none; border-radius: 5px; padding: 5px 7px; cursor: pointer; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 700; font-family: inherit; }
        .cal-cm-action:hover { background: var(--bg); color: var(--text-primary); }
        .cal-cm-action svg { width: 12px; height: 12px; }
        .cal-cm-action.is-done-on { color: var(--sv-fg-166534); }
        .cal-cm-action.is-danger:hover { color: var(--sv-fg-b91c1c); background: var(--sv-bg-fee2e2); }
        .cal-cm-reply-form { padding: 4px 22px 10px 64px; }
        .cal-cm-reply-form .cal-cm-composer { background: var(--bg); border: 1px solid var(--border); }
        .cal-cm-composer-wrap { padding: 10px 18px 16px; background: var(--white); border-top: 1px solid var(--border); flex-shrink: 0; }
        /* Audience picker — sits above the composer when starting a new thread. */
        .cal-cm-audience { display: flex; align-items: center; gap: 8px; padding: 0 4px 8px; flex-wrap: wrap; }
        .cal-cm-audience-cap { font-size: 0.7rem; color: var(--text-muted); font-weight: 600; }
        /* Internal/Client tag shown on each thread root in the feed (team view). */
        .cal-cm-aud-tag { display: inline-flex; align-items: center; gap: 3px; font-size: 0.62rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.03em; padding: 1px 6px; border-radius: 5px; }
        .cal-cm-aud-tag svg { width: 9px; height: 9px; }
        .cal-cm-aud-tag.is-internal { background: var(--sv-bg-rgba-124-58-237-0_12); color: var(--sv-fg-6d28d9); }
        .cal-cm-aud-tag.is-client { background: var(--sv-bg-rgba-22-163-74-0_12); color: var(--sv-fg-15803d); }
        /* Tweak vs comment tag on each thread root. */
        .cal-cm-type-tag { display: inline-flex; align-items: center; font-size: 0.62rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.03em; padding: 1px 6px; border-radius: 5px; }
        .cal-cm-type-tag.is-tweak { background: var(--sv-bg-rgba-234-88-12-0_12); color: var(--sv-fg-c2410c); }
        .cal-cm-type-tag.is-comment { background: var(--bg-muted, var(--sv-bg-f1f1f2)); color: var(--text-secondary, var(--sv-fg-6b6b6b)); }
        .cal-cm-aud-seg { display: inline-flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
        .cal-cm-aud-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; background: var(--white);
            border: 0; border-right: 1px solid var(--border); color: var(--text-secondary, var(--sv-fg-6b6b6b));
            font-family: inherit; font-size: 0.74rem; font-weight: 600; cursor: pointer; transition: background 0.12s, color 0.12s; }
        .cal-cm-aud-btn:last-child { border-right: 0; }
        .cal-cm-aud-btn svg { width: 12px; height: 12px; }
        .cal-cm-aud-btn:hover:not(.is-active) { background: var(--bg-muted, var(--sv-bg-f4f4f5)); }
        .cal-cm-aud-btn.is-active { background: var(--text-primary); color: var(--white); }
        .cal-cm-composer { display: flex; gap: 8px; align-items: flex-end; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 8px 8px 8px 12px; transition: border-color 0.12s; }
        .cal-cm-composer:focus-within { border-color: var(--text-primary); background: var(--white); }
        .cal-cm-composer textarea { flex: 1; min-width: 0; border: none; outline: none; resize: none; background: transparent; font-family: inherit; font-size: 0.88rem; line-height: 1.45; color: var(--text-primary); padding: 4px 0; max-height: 160px; overflow-y: auto; }
        .cal-cm-composer textarea::placeholder { color: var(--text-muted); }
        /* Hide the native scroll-bar (its up/down arrows) in the Notes composer — the
           textarea still autosizes + scrolls, just without the chrome. Shared by the
           SMM/calendar composer and the Samples composer (both use .cal-cm-composer). */
        .cal-cm-composer textarea { scrollbar-width: none; -ms-overflow-style: none; }
        .cal-cm-composer textarea::-webkit-scrollbar { width: 0; height: 0; display: none; }
        .cal-cm-composer-actions { display: flex; gap: 4px; align-items: center; flex-shrink: 0; }
        .cal-cm-cancel-reply { background: transparent; border: none; cursor: pointer; color: var(--text-muted); padding: 6px; border-radius: 8px; display: inline-flex; }
        .cal-cm-cancel-reply:hover { background: var(--border); color: var(--text-primary); }
        .cal-cm-send { background: var(--text-primary); border: none; color: var(--white); width: 32px; height: 32px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: opacity 0.12s, transform 0.08s; }
        .cal-cm-send:hover:not(:disabled) { transform: translateY(-1px); }
        .cal-cm-send:disabled { opacity: 0.35; cursor: not-allowed; }
        .cal-cm-send svg { width: 14px; height: 14px; }
        .cal-cm-pending-hint { font-size: 0.72rem; color: var(--text-secondary); padding: 4px 2px 0 40px; }
        .cal-cm-replying-to { font-size: 0.7rem; color: var(--text-muted); padding: 0 4px 6px; display: flex; align-items: center; gap: 6px; }
        .cal-cm-replying-to strong { color: var(--text-primary); font-weight: 800; }

        /* ── Caption generator: inline Generate pill, prompt-edit modal ── */
        .cal-cap-gen { position: absolute; left: 8px; bottom: 8px; display: inline-flex; align-items: center; gap: 5px; padding: 5px 9px; border-radius: 99px; background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); font-family: inherit; font-size: 0.72rem; font-weight: 700; cursor: pointer; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_05); transition: color 0.12s, border-color 0.12s, background 0.12s, opacity 0.1s; }
        /* Hide while the SMM is typing in the caption so the pill doesn't
           cover the text. Stays visible (and clickable) when the field is
           empty and unfocused. The is-busy state overrides this so the
           spinner remains visible mid-generation. */
        .cal-cap-wrap textarea.cal-fld-cap:focus ~ .cal-cap-gen:not(.is-busy),
        .cal-cap-wrap textarea.cal-fld-cap:not(:placeholder-shown) ~ .cal-cap-gen:not(.is-busy) { opacity: 0; pointer-events: none; }
        .cal-cap-gen:hover:not(:disabled) { color: var(--text-primary); border-color: var(--text-primary); background: var(--bg); }
        .cal-cap-gen:disabled { opacity: 0.55; cursor: not-allowed; }
        .cal-cap-gen svg { width: 12px; height: 12px; }
        .cal-cap-gen.is-busy { color: var(--text-primary); border-color: var(--text-primary); }
        .cal-cap-gen.is-busy:disabled { opacity: 1; cursor: default; }
        .cal-cap-gen.is-busy .cal-cap-gen-spin { animation: cal-cap-spin 0.9s linear infinite; }
        .cal-cap-gen-spin { display: inline-block; width: 11px; height: 11px; border: 1.6px solid var(--border); border-top-color: var(--text-primary); border-radius: 50%; }
        @keyframes cal-cap-spin { to { transform: rotate(360deg); } }
        /* Per-card cancel for an in-flight generation. Anchored TOP-right: the
           bottom edge is already taken by the busy pill (bottom-left), the error
           banner (bottom-left) and the "Show more" toggle (bottom-right), and the
           cancel-X used to sit bottom-right where it overlapped that toggle when a
           long (overflowing) caption was re-generated. Top-right is the only free
           corner, and reads as the conventional "cancel" spot. */
        .cal-cap-gen-x { position: absolute; right: 8px; top: 8px; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; border-radius: 99px; background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); cursor: pointer; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_05); transition: color 0.12s, border-color 0.12s, background 0.12s; z-index: 2; }
        .cal-cap-gen-x:hover { color: var(--sv-fg-b91c1c); border-color: var(--sv-border-fecaca); background: var(--sv-bg-fef2f2); }
        .cal-cap-gen-x svg { width: 10px; height: 10px; }
        .cal-cap-err { position: absolute; left: 8px; bottom: 38px; max-width: calc(100% - 16px); padding: 5px 9px; background: var(--sv-bg-fef2f2); border: 1px solid var(--sv-border-fecaca); color: var(--sv-fg-b91c1c); border-radius: 8px; font-size: 0.72rem; font-weight: 600; line-height: 1.35; pointer-events: none; }

        .cal-prompt-overlay { display: none; position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_4); z-index: 330; align-items: center; justify-content: center; padding: 20px; }
        .cal-prompt-overlay.open { display: flex; }
        .cal-prompt-modal { background: var(--white); border-radius: 16px; width: 720px; max-width: 96vw; max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 24px 70px var(--sv-shadow-rgba-0-0-0-0_24); overflow: hidden; }
        .cal-prompt-head { padding: 16px 20px 14px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-shrink: 0; }
        .cal-prompt-head-text { min-width: 0; flex: 1; }
        .cal-prompt-head-text h3 { margin: 0 0 3px; font-size: 0.98rem; font-weight: 800; color: var(--text-primary); }
        .cal-prompt-head-text p { margin: 0; font-size: 0.74rem; color: var(--text-muted); line-height: 1.45; }
        .cal-prompt-close { width: 28px; height: 28px; border-radius: 50%; border: none; background: var(--bg); font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--text-muted); flex-shrink: 0; }
        .cal-prompt-close:hover { background: var(--border); color: var(--text-primary); }
        .cal-prompt-body { flex: 1; overflow-y: auto; padding: 14px 20px; display: flex; flex-direction: column; gap: 10px; }
        .cal-prompt-textarea { width: 100%; min-height: 260px; resize: vertical; border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; font-family: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace; font-size: 0.8rem; line-height: 1.55; color: var(--text-primary); background: var(--bg); box-sizing: border-box; outline: none; }
        .cal-prompt-textarea:focus { border-color: var(--text-primary); background: var(--white); }
        .cal-prompt-hint { font-size: 0.72rem; color: var(--text-muted); line-height: 1.45; }
        .cal-prompt-banner { display: flex; align-items: flex-start; gap: 8px; padding: 9px 12px; border-radius: 9px; font-size: 0.78rem; font-weight: 600; line-height: 1.4; }
        .cal-prompt-banner.is-default { background: var(--sv-bg-fef9c3); border: 1px solid var(--sv-border-fde68a); color: var(--sv-fg-854d0e); }
        .cal-prompt-banner.is-custom { background: var(--sv-bg-dcfce7); border: 1px solid var(--sv-border-bbf7d0); color: var(--sv-fg-166534); }
        .cal-prompt-banner svg { width: 14px; height: 14px; flex-shrink: 0; margin-top: 1px; }
        .cal-prompt-foot { padding: 12px 20px 16px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-shrink: 0; }
        .cal-prompt-foot-left { display: flex; gap: 8px; }
        .cal-prompt-foot-right { display: flex; gap: 8px; }
        .cal-prompt-btn { font-family: inherit; font-size: 0.82rem; font-weight: 700; padding: 8px 14px; border-radius: 9px; border: 1px solid var(--border); background: var(--white); color: var(--text-primary); cursor: pointer; }
        .cal-prompt-btn:hover { background: var(--bg); }
        .cal-prompt-btn.is-primary { background: var(--text-primary); color: var(--white); border-color: var(--text-primary); }
        .cal-prompt-btn.is-primary:hover { opacity: 0.9; background: var(--text-primary); }
        .cal-prompt-btn:disabled { opacity: 0.55; cursor: not-allowed; }

        .cal-bulk-cap-bar { position: fixed; bottom: 24px; right: 24px; z-index: 320; background: var(--text-primary); color: var(--white); padding: 10px 14px; border-radius: 12px; box-shadow: 0 8px 26px var(--sv-shadow-rgba-0-0-0-0_22); font-size: 0.82rem; font-weight: 700; display: inline-flex; align-items: center; gap: 10px; visibility: hidden; opacity: 0; transform: translateY(10px); pointer-events: none; transition: opacity 0.2s ease-out, transform 0.2s ease-out, visibility 0s linear 0.2s; }
        .cal-bulk-cap-bar.is-active { visibility: visible; opacity: 1; transform: none; pointer-events: auto; transition: opacity 0.2s ease-out, transform 0.2s ease-out, visibility 0s linear 0s; }
        /* Inner text span is a flex row so the inline spinner sits at a
           comfortable distance from the "G" of "Generating…". Without this
           the spinner is rendered as inline-block with zero word-spacing
           and visually crashes into the first letter. */
        .cal-bulk-cap-bar [data-bulk-cap-text] { display: inline-flex; align-items: center; gap: 8px; }
        .cal-bulk-cap-bar .cal-bulk-cap-cancel { background: var(--sv-bg-rgba-255-255-255-0_15); color: var(--white); border: none; border-radius: 7px; padding: 4px 9px; font-family: inherit; font-size: 0.72rem; font-weight: 700; cursor: pointer; }
        .cal-bulk-cap-bar .cal-bulk-cap-cancel:hover { background: var(--sv-bg-rgba-255-255-255-0_25); }
        .cal-bulk-cap-bar .cal-bulk-cap-spin { display: inline-block; width: 12px; height: 12px; border: 1.8px solid var(--sv-border-rgba-255-255-255-0_3); border-top-color: var(--sv-border-fff); border-radius: 50%; animation: cal-cap-spin 0.9s linear infinite; }

        /* ── Kasper review tab (hidden, unlocked via ?Kasper=1) ───────── */
        .kasper-wrap { max-width: 1100px; margin: 0 auto; position: relative; }
        .kasper-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
        .kasper-title { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
        .kasper-sub { font-size: 0.85rem; color: var(--text-secondary); }
        .kasper-subtabs { display: flex; align-items: center; gap: 4px; padding: 4px; background: var(--white); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 22px; width: 100%; max-width: 100%; box-sizing: border-box; box-shadow: 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_04); }
        .kasper-subtab { background: transparent; border: none; font-family: inherit; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); padding: 8px 16px; border-radius: 8px; cursor: pointer; transition: color 0.15s, background 0.15s; display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; white-space: nowrap; }
        .kasper-subtab[hidden] { display: none; }
        .kasper-subtab svg { width: 14px; height: 14px; flex-shrink: 0; }
        .kasper-subtab:hover { color: var(--text-primary); background: var(--bg); }
        .kasper-subtab.active { background: var(--text-primary); color: var(--white); }
        .kasper-subtab .kasper-tab-count { background: var(--sv-bg-rgba-255-255-255-0_18); color: inherit; font-size: 0.68rem; font-weight: 700; padding: 1px 7px; border-radius: 99px; font-variant-numeric: tabular-nums; }
        .kasper-subtab:not(.active) .kasper-tab-count { background: var(--bg); color: var(--text-muted); }
        .kasper-tab-count[hidden] { display: none; }
        .kasper-tab-label-short { display: none; }
        .kasper-more { position: relative; margin-left: auto; flex: 0 0 auto; }
        .kasper-more-trigger { min-width: 86px; justify-content: center; }
        .kasper-more-trigger .kasper-more-icon { display: inline-flex; }
        .kasper-more-trigger .kasper-more-count { margin-left: 2px; background: var(--dn); color: var(--white); }
        .kasper-more-trigger.active .kasper-more-count { background: var(--sv-bg-rgba-255-255-255-0_18); color: inherit; }
        .kasper-more-trigger .kasper-more-chevron { width: 12px; height: 12px; margin-left: 2px; transition: transform 0.15s; }
        .kasper-more.open .kasper-more-chevron { transform: rotate(180deg); }
        .kasper-more-menu { position: absolute; z-index: 80; top: calc(100% + 8px); right: 0; width: 258px; max-width: calc(100vw - 32px); padding: 8px; border: 1px solid var(--border); border-radius: 12px; background: var(--white); box-shadow: 0 16px 38px var(--sv-shadow-rgba-0-0-0-0_18); }
        .kasper-more-menu[hidden] { display: none; }
        .kasper-more-group + .kasper-more-group { border-top: 1px solid var(--border); margin-top: 7px; padding-top: 7px; }
        .kasper-more-heading { padding: 5px 10px 4px; color: var(--text-muted); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
        .kasper-more-item { width: 100%; justify-content: flex-start; padding: 9px 10px; text-align: left; }
        .kasper-more-item.active { background: var(--bg); color: var(--text-primary); }
        .kasper-more-item .kasper-tab-count { margin-left: auto; }
        .kasper-subtab:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        @media (max-width: 900px) {
            .kasper-subtabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .kasper-primary-tab { min-width: 0; justify-content: center; padding-inline: 8px; overflow: hidden; }
            .kasper-primary-tab .kasper-tab-label-full { display: none; }
            .kasper-primary-tab .kasper-tab-label-short { display: inline; }
            .kasper-more { grid-column: 1 / -1; width: 100%; margin-left: 0; }
            .kasper-more-trigger { width: 100%; }
        }
        @media (max-width: 420px) {
            .kasper-subtabs { grid-template-columns: minmax(0, 1fr); gap: 3px; }
            .kasper-primary-tab { padding-inline: 8px; }
            .kasper-subtab .kasper-tab-count { padding-inline: 5px; }
            .kasper-more-trigger { min-width: 0; padding-inline: 8px; }
        }
        /* Replies inbox */
        .kasper-replies-list { display: flex; flex-direction: column; gap: 14px; }
        .kasper-replies-card { border: 1px solid var(--border); border-radius: 12px; padding: 14px; background: var(--white); }
        .kasper-replies-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .kasper-replies-thumb { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
        .kasper-replies-meta { flex: 1; min-width: 0; }
        .kasper-replies-client { font-size: 0.72rem; color: var(--text-muted); font-weight: 600; }
        .kasper-replies-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .kasper-replies-read { flex-shrink: 0; background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); border-radius: 7px; padding: 6px 11px; font-family: inherit; font-size: 0.76rem; font-weight: 600; cursor: pointer; transition: background 0.12s, color 0.12s; }
        .kasper-replies-read:hover { background: var(--bg-muted, var(--sv-bg-f4f4f5)); color: var(--text-primary); }
        .kasper-replies-open { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; text-decoration: none; background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); border-radius: 7px; padding: 6px 11px; font-size: 0.76rem; font-weight: 600; transition: background 0.12s, color 0.12s; }
        .kasper-replies-open:hover { background: var(--bg-muted, var(--sv-bg-f4f4f5)); color: var(--text-primary); }
        .kasper-replies-open svg { width: 13px; height: 13px; }
        .kasper-replies-thread { display: flex; flex-direction: column; gap: 10px; padding: 10px 0; border-top: 1px solid var(--border); }
        .kasper-replies-showall { align-self: center; background: none; border: 0; color: var(--text-muted); font-family: inherit; font-size: 0.74rem; font-weight: 600; cursor: pointer; padding: 4px 10px; border-radius: 6px; }
        .kasper-replies-showall:hover { background: var(--bg-muted, var(--sv-bg-f4f4f5)); color: var(--text-primary); }
        .kasper-replies-compose { margin-top: 10px; }
        /* New (unseen) message highlight in a thread. */
        .cal-review-comment.is-new { background: var(--sv-bg-rgba-234-88-12-0_07); border-left-color: var(--sv-border-ea580c) !important; border-radius: 0 6px 6px 0; padding-right: 8px; }
        /* "New reply" chip on a review-queue card. */
        .kcard-newreply-chip { display: inline-flex; align-items: center; font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; padding: 2px 7px; border-radius: 99px; background: var(--sv-bg-rgba-234-88-12-0_12); color: var(--sv-fg-c2410c); }
        .kasper-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .kasper-count-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--text-secondary); font-weight: 600; }
        .kasper-count-chip .kasper-count-num { background: var(--text-primary); color: var(--white); font-weight: 700; font-size: 0.72rem; padding: 2px 9px; border-radius: 99px; font-variant-numeric: tabular-nums; }
        .kasper-refresh-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.76rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; }
        .kasper-refresh-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .kasper-refresh-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .kasper-refresh-btn svg { width: 12px; height: 12px; }
        .kasper-refresh-btn.spinning svg { animation: spin 0.8s linear infinite; }
        .kasper-loading { display: flex; align-items: center; justify-content: center; padding: 80px 20px; gap: 14px; color: var(--text-secondary); font-size: 0.86rem; }
        .kasper-loading .spinner { width: 22px; height: 22px; }
        .kasper-empty { text-align: center; padding: 80px 20px; color: var(--text-secondary); }
        .kasper-empty-icon { width: 54px; height: 54px; margin: 0 auto 14px; border-radius: 16px; background: var(--bg); display: flex; align-items: center; justify-content: center; color: var(--text-muted); }
        .kasper-empty-title { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
        .kasper-empty-sub { font-size: 0.82rem; color: var(--text-muted); }
        .kasper-list { display: flex; flex-direction: column; gap: 12px; }
        /* Stranded-hand-off notice: cards at Kasper Approval with no file
           attached. Advisory, not actionable, so it reads quieter than a card
           and never competes with the queue below it. */
        .kasper-unloaded { background: var(--white); border: 1px solid var(--border); border-left: 3px solid var(--sv-bg-ef4444); border-radius: 12px; padding: 14px 18px; margin-bottom: 14px; }
        .kasper-stranded { background: var(--white); border: 1px solid var(--border); border-left: 3px solid var(--sv-bg-f59e0b); border-radius: 12px; padding: 14px 18px; margin-bottom: 14px; }
        .kasper-stranded-title { font-size: 0.9rem; font-weight: 700; color: var(--text-primary); margin-bottom: 3px; }
        .kasper-stranded-sub { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 8px; }
        .kasper-stranded-list { margin: 0; padding-left: 18px; font-size: 0.8rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 2px; }

        /* Card */
        .kcard { position: relative; background: var(--white); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; transition: box-shadow 0.18s, border-color 0.18s; }
        .kcard:hover { box-shadow: 0 4px 18px var(--sv-shadow-rgba-0-0-0-0_07); border-color: var(--sv-border-d4d4cf); }
        .kcard.expanded { box-shadow: 0 6px 24px var(--sv-shadow-rgba-0-0-0-0_09); border-color: var(--sv-border-c9c9c4); }

        /* Kasper review body — minimalist flat layout. The panels live
           directly on the card background (no inner border, no inner
           background, no rounded corners), separated by a subtle vertical
           rule when there are 2 or 3 of them. Single panel is centered
           with a sensible max-width so it doesn't sprawl across a wide
           viewport. */
        .kasper-review-body { padding: 0; border-top: 1px solid var(--border); background: var(--white); align-items: stretch; }
        .kasper-review-body .cal-review-panel {
            background: transparent; border: 0; border-radius: 0;
            padding: 18px 22px; height: auto; gap: 14px;
        }
        .kasper-review-body .cal-review-panel + .cal-review-panel { border-left: 1px solid var(--border); }
        .kasper-review-body[style*="repeat(1,"] .cal-review-panel { max-width: 640px; margin: 0 auto; padding: 22px 24px; }
        .kasper-review-body .cal-review-panel-head { margin-bottom: 0; }
        .kasper-review-body .cal-review-panel-title { font-size: 0.86rem; }
        .kasper-review-body .cal-review-panel-status { padding: 3px 8px; font-size: 0.66rem; background: transparent; color: var(--text-muted); }
        .kasper-review-body .cal-review-panel-preview { min-height: 0; }
        .kasper-review-body .cal-review-thread { padding-top: 12px; }
        /* Tweaks-needed state — match the client review's visual signal so
           Kasper sees the same "Changes requested" feedback after sending a
           comment. The Kasper-specific resets above had higher specificity
           than the base .cal-review-panel[data-state="tweaks"] rule, so the
           orange treatment never landed. Re-apply it scoped under
           .kasper-review-body. */
        .kasper-review-body .cal-review-panel[data-state="tweaks"] {
            background: var(--sv-bg-fff7ed);
        }
        .kasper-review-body .cal-review-panel[data-state="tweaks"] .cal-review-panel-status {
            background: var(--sv-bg-rgba-194-65-12-0_12); color: var(--sv-fg-9a3412);
        }
        .kasper-review-body .cal-review-panel[data-state="tweaks"] .cal-review-preview-caption { background: var(--sv-bg-rgba-255-255-255-0_6); color: var(--sv-fg-7c2d12); }
        .kasper-review-body .cal-review-panel[data-state="tweaks"] .cal-review-textarea { background: var(--sv-bg-rgba-255-255-255-0_78); border-color: var(--sv-border-rgba-124-45-18-0_2); }
        @media (max-width: 880px) {
            .kasper-review-body { display: flex !important; flex-direction: column; }
            .kasper-review-body .cal-review-panel + .cal-review-panel { border-left: 0; border-top: 1px solid var(--border); }
        }

        /* Hero layout — used only when the sole pending Kasper component is
           the video. Cinematic poster on the left, action column on the right.
           Reads like a "review and decide" moment, not a form. */
        .kasper-review-body.is-hero { display: grid; grid-template-columns: 1fr; padding: 0; background: linear-gradient(180deg, var(--sv-bg-fafaf7) 0%, var(--sv-bg-ffffff) 100%); transition: background 0.25s; }
        .kasper-review-body.is-hero:has(.kasper-hero-panel[data-state="tweaks"]) {
            background: linear-gradient(180deg, var(--sv-bg-fff7ed) 0%, var(--sv-bg-fffaf2) 100%);
        }
        .kasper-review-body.is-hero .kasper-hero-panel {
            display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
            gap: 0; padding: 0; background: transparent; border: 0; border-radius: 0; max-width: none; margin: 0;
        }
        .kasper-review-body.is-hero .kasper-hero-panel[data-state="tweaks"] .kasper-hero-title { color: var(--sv-fg-7c2d12); }
        .kasper-review-body.is-hero .kasper-hero-panel[data-state="tweaks"] .cal-review-panel-status {
            background: var(--sv-bg-rgba-194-65-12-0_16); color: var(--sv-fg-9a3412);
            padding: 4px 10px; font-size: 0.7rem; border-radius: 99px;
            text-transform: uppercase; letter-spacing: 0.045em; font-weight: 700;
            margin-left: 8px;
        }
        .kasper-review-body.is-hero .kasper-hero-panel[data-state="tweaks"] .cal-review-textarea {
            background: var(--sv-bg-rgba-255-255-255-0_85); border-color: var(--sv-border-rgba-124-45-18-0_2);
        }
        .kasper-hero-left { padding: 24px 18px 24px 24px; display: flex; align-items: center; justify-content: center; }
        .kasper-hero-poster { position: relative; display: block; width: 100%; max-width: 380px;
            aspect-ratio: 9 / 16; max-height: 520px; border-radius: 14px; overflow: hidden;
            background: linear-gradient(135deg, var(--sv-bg-1f2937), var(--sv-bg-0f172a)); text-decoration: none;
            box-shadow: 0 8px 30px var(--sv-shadow-rgba-15-23-42-0_18), 0 2px 6px var(--sv-shadow-rgba-0-0-0-0_06);
            transition: transform 0.22s cubic-bezier(.4,0,.2,1), box-shadow 0.22s; }
        .kasper-hero-poster:hover { transform: translateY(-2px) scale(1.005); box-shadow: 0 18px 50px var(--sv-shadow-rgba-15-23-42-0_28), 0 4px 12px var(--sv-shadow-rgba-0-0-0-0_08); }
        .kasper-hero-poster-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
            filter: blur(10px) brightness(0.6) saturate(1.05); transform: scale(1.12); }
        .kasper-hero-poster-overlay { position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 14px; color: var(--sv-fg-fff);
            background: radial-gradient(ellipse at center, var(--sv-bg-rgba-0-0-0-0_05) 0%, var(--sv-bg-rgba-0-0-0-0_35) 100%); }
        .kasper-hero-play { display: inline-flex; align-items: center; justify-content: center;
            width: 78px; height: 78px; border-radius: 50%;
            background: var(--sv-bg-rgba-255-255-255-0_22); backdrop-filter: blur(10px);
            border: 1.5px solid var(--sv-border-rgba-255-255-255-0_35);
            box-shadow: 0 8px 24px var(--sv-shadow-rgba-0-0-0-0_22);
            transition: transform 0.18s cubic-bezier(.4,0,.2,1), background 0.18s, box-shadow 0.18s; }
        .kasper-hero-poster:hover .kasper-hero-play { transform: scale(1.08); background: var(--sv-bg-rgba-255-255-255-0_32); box-shadow: 0 12px 32px var(--sv-shadow-rgba-0-0-0-0_28); }
        .kasper-hero-play svg { width: 32px; height: 32px; margin-left: 4px; }
        .kasper-hero-play-label { font-size: 0.84rem; font-weight: 600; letter-spacing: 0.01em;
            text-shadow: 0 1px 8px var(--sv-shadow-rgba-0-0-0-0_5); }
        .kasper-hero-poster-empty { background: linear-gradient(135deg, var(--sv-bg-e5e5e0), var(--sv-bg-d6d6d0)); }
        .kasper-hero-poster-empty .kasper-hero-play-label { color: var(--text-muted); text-shadow: none; }
        /* Graphic hero: full thumbnail image (not blurred) with a light
           overlay on hover, click opens the lightbox. Same silhouette as
           the video poster so the row stays visually consistent when only
           the thumbnail is pending Kasper. */
        .kasper-hero-poster-graphic { padding: 0; border: 0; cursor: pointer; background: linear-gradient(135deg, var(--sv-bg-1f2937), var(--sv-bg-0f172a)); }
        .kasper-hero-poster-fg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        /* Subtle "open full size" affordance for the thumbnail hero: a
           small glass chip in the top-right corner of the poster instead
           of the centred white circle that was covering image content.
           Resting at half-opacity, fully visible on hover. */
        .kasper-hero-zoom-chip { position: absolute; top: 12px; right: 12px;
            display: inline-flex; align-items: center; justify-content: center;
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--sv-bg-rgba-15-23-42-0_55); color: var(--sv-fg-fff);
            border: 1px solid var(--sv-border-rgba-255-255-255-0_18);
            -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
            box-shadow: 0 4px 14px var(--sv-shadow-rgba-0-0-0-0_28);
            opacity: 0.7; transition: opacity 0.18s, transform 0.18s, background 0.18s; }
        .kasper-hero-poster-graphic:hover .kasper-hero-zoom-chip { opacity: 1; transform: scale(1.08); background: var(--sv-bg-rgba-15-23-42-0_8); }
        .kasper-hero-zoom-chip svg { width: 15px; height: 15px; }
        /* Caption hero: read-first card. Generous padding, slightly serif-y
           reading line-height, gentle gradient ground so it doesn't feel
           sterile in the otherwise media-heavy hero row. */
        .kasper-hero-caption-card { width: 100%; max-width: 380px; min-height: 260px;
            padding: 22px 24px; border-radius: 14px;
            background: linear-gradient(140deg, var(--sv-bg-fdf6e3) 0%, var(--sv-bg-fffaec) 100%);
            color: var(--sv-fg-5c4426); line-height: 1.55; font-size: 0.95rem; white-space: pre-wrap;
            box-shadow: 0 4px 18px var(--sv-shadow-rgba-92-68-38-0_10), 0 1px 3px var(--sv-shadow-rgba-0-0-0-0_04);
            overflow-y: auto; max-height: 520px; }
        .kasper-hero-caption-empty { font-style: italic; color: var(--text-muted); display: flex; align-items: center; justify-content: center; }

        .kasper-hero-right { padding: 28px 28px 24px 12px; display: flex; flex-direction: column; gap: 16px; justify-content: center; min-height: 100%; }
        .kasper-hero-head { display: flex; align-items: baseline; gap: 12px; }
        .kasper-hero-title { font-size: 1.6rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em; line-height: 1.1; }
        .kasper-hero-approve { padding: 13px 18px; font-size: 0.95rem; border-radius: 10px;
            box-shadow: 0 2px 8px var(--sv-shadow-rgba-22-101-52-0_22); }
        .kasper-hero-approve:hover:not(:disabled) { box-shadow: 0 6px 18px var(--sv-shadow-rgba-22-101-52-0_28); }
        /* Keep the hero approve's larger sizing even inside the split control. */
        .cal-review-approve-split .cal-review-approve-main.kasper-hero-approve { padding: 13px 18px; font-size: 0.95rem; }

        @media (max-width: 720px) {
            .kasper-review-body.is-hero .kasper-hero-panel { grid-template-columns: 1fr; }
            .kasper-hero-left { padding: 20px 20px 0; }
            .kasper-hero-poster { max-height: 360px; }
            .kasper-hero-right { padding: 18px 20px 20px; }
        }
        .kcard-strip { display: grid; grid-template-columns: 96px 1fr auto; gap: 14px; padding: 12px; align-items: center; cursor: pointer; }
        .kcard-thumb { position: relative; width: 96px; height: 96px; border-radius: 10px; overflow: hidden; background: var(--media-tub-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .kcard-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .kcard-thumb.is-fallback { color: var(--text-muted); }
        .kcard-thumb-fallback { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--text-muted); }
        .kcard-thumb-fallback svg { width: 38px; height: 38px; }
        .kcard-thumb-fallback.is-frame { background: var(--sv-bg-16130f); color: var(--sv-fg-rgba-255-255-255-0_92); }
        .kcard-thumb-zoom { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--sv-bg-rgba-0-0-0-0_32); opacity: 0; transition: opacity 0.15s; border: none; cursor: zoom-in; color: var(--sv-fg-fff); padding: 0; }
        .kcard-thumb-zoom svg { width: 22px; height: 22px; color: var(--sv-fg-fff); filter: drop-shadow(0 1px 4px var(--sv-shadow-rgba-0-0-0-0_4)); }
        .kcard-thumb:hover .kcard-thumb-zoom { opacity: 1; }
        .kcard-thumb.is-no-image .kcard-thumb-zoom { display: none; }

        /* Editors sub-tab: weekly labor view */
        .ked-meta-week { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.015em; }
        .ked-toolbar-actions { display: flex; align-items: center; gap: 8px; }
        .ked-info-btn { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); background: var(--white); color: var(--text-muted); cursor: pointer; transition: all 0.13s; padding: 0; flex-shrink: 0; }
        .ked-info-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .ked-info-btn svg { width: 14px; height: 14px; }
        .ked-info-panel { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; margin-bottom: 14px; font-size: 0.82rem; line-height: 1.55; color: var(--text-secondary); box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_04); }
        .ked-info-panel[hidden] { display: none; }
        .ked-info-panel p { margin: 0 0 8px; }
        .ked-info-panel p:last-child { margin-bottom: 0; }
        .ked-info-panel strong { color: var(--text-primary); }
        .ked-info-note { font-size: 0.76rem; color: var(--text-muted); font-style: italic; }
        .ked-info-list { list-style: none; padding: 0; margin: 6px 0 10px; display: flex; flex-direction: column; gap: 5px; }
        .ked-info-list li { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--text-secondary); }
        .ked-info-list .ked-legend-swatch { flex-shrink: 0; }
        .ked-legend { display: flex; flex-wrap: wrap; gap: 10px 14px; margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border); font-size: 0.72rem; color: var(--text-secondary); }
        .ked-legend-item { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
        .ked-legend-swatch { display: inline-block; width: 18px; height: 8px; border-radius: 3px; flex-shrink: 0; }
        .ked-legend-swatch--marker { width: 7px; height: 12px; border-radius: 2px; box-shadow: 0 0 0 1.5px var(--sv-shadow-fff), 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_18); }
        .ked-list { display: flex; flex-direction: column; gap: 12px; }
        .ked-row { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; transition: box-shadow 0.18s, border-color 0.18s; }
        .ked-row:hover { box-shadow: 0 4px 18px var(--sv-shadow-rgba-0-0-0-0_06); border-color: var(--sv-border-d4d4cf); }
        .ked-row.expanded { box-shadow: 0 6px 24px var(--sv-shadow-rgba-0-0-0-0_08); border-color: var(--sv-border-c9c9c4); }
        .ked-row-head { display: grid; grid-template-columns: 38px 1fr auto auto; gap: 14px; align-items: center; cursor: pointer; user-select: none; }
        .ked-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg,var(--sv-bg-cdb4f5),var(--sv-bg-7c3aed)); color: var(--sv-fg-fff); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; flex-shrink: 0; overflow: hidden; }
        .ked-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .ked-id { min-width: 0; }
        .ked-name { font-size: 1rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; }
        .ked-id-sep { color: var(--text-muted); margin: 0 1px; }
        .ked-bd-wip { color: var(--text-muted); }
        .ked-row-avg { display: flex; flex-direction: column; align-items: flex-end; line-height: 1; gap: 6px; }
        .ked-avg-val { font-size: 1.7rem; font-weight: 800; color: var(--text-primary); font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
        .ked-avg-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); margin-top: 4px; }
        .ked-avg-split { display: flex; gap: 8px; font-size: 0.66rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-muted); letter-spacing: -0.005em; }
        .ked-avg-split-item { display: inline-flex; align-items: baseline; gap: 3px; }
        .ked-avg-split-item .ked-avg-split-n { color: var(--text-primary); font-weight: 800; font-size: 0.78rem; }
        .ked-avg-split-item.is-finished .ked-avg-split-n { color: var(--sv-fg-15803d); }
        .ked-avg-split-item.is-tweaks   .ked-avg-split-n { color: var(--sv-fg-c2410c); }
        .ked-avg-split-item.is-firstcut .ked-avg-split-n { color: var(--sv-fg-6d28d9); }
        /* Load (what's piled on him) vs Deliveries (what he pushed through) */
        .ked-row-stats { display: flex; gap: 14px; align-items: flex-start; }
        .ked-stat { display: flex; flex-direction: column; align-items: flex-end; line-height: 1; gap: 3px; min-width: 0; }
        .ked-stat-val { font-size: 1.55rem; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; line-height: 1; }
        .ked-stat.is-load  .ked-stat-val { color: var(--sv-fg-b45309); }
        .ked-stat.is-deliv .ked-stat-val { color: var(--text-primary); }
        .ked-stat.is-finished .ked-stat-val { color: var(--sv-fg-15803d); }
        .ked-stat.is-open .ked-stat-val { color: var(--sv-fg-6b7280); }
        .ked-vid-rounds { display: inline-block; margin-left: 7px; padding: 1px 7px; border-radius: 999px; background: var(--sv-bg-fef3c7); color: var(--sv-fg-b45309); font-size: 0.66rem; font-weight: 700; vertical-align: middle; white-space: nowrap; }
        .ked-stat-label { font-size: 0.58rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-top: 3px; }
        .ked-stat-sub { font-size: 0.66rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--text-secondary); white-space: nowrap; }
        .ked-stat-sep { width: 1px; align-self: stretch; min-height: 34px; background: var(--border); }
        .ked-avgtoggle { display: inline-flex; background: var(--sv-bg-f1f1ef); border-radius: 8px; padding: 2px; }
        .ked-avgtoggle-btn { border: none; background: transparent; font: inherit; font-size: 0.72rem; font-weight: 700; color: var(--text-muted); padding: 4px 11px; border-radius: 6px; cursor: pointer; transition: background 0.12s, color 0.12s; }
        .ked-avgtoggle-btn.is-active { background: var(--sv-bg-fff); color: var(--text-primary); box-shadow: 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_1); }
        .ked-row-chev { color: var(--text-muted); transition: transform 0.15s; flex-shrink: 0; }
        .ked-row.expanded .ked-row-chev { transform: rotate(180deg); }
        .ked-bars { margin-top: 14px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
        .ked-bars.with-weekend { grid-template-columns: repeat(7, 1fr); }
        .ked-bar { display: flex; flex-direction: column; align-items: stretch; gap: 6px; min-width: 0; }
        .ked-bar-count { font-size: 0.82rem; font-weight: 700; color: var(--text-primary); font-variant-numeric: tabular-nums; line-height: 1; text-align: center; letter-spacing: -0.02em; }
        .ked-bar-count.is-empty { color: var(--sv-fg-d4d4d8); font-weight: 600; }
        .ked-bar-stack { width: 100%; height: 52px; background: var(--sv-bg-f4f4f5); border-radius: 8px; display: flex; flex-direction: column-reverse; overflow: hidden; position: relative; transition: background 0.13s ease, box-shadow 0.13s ease; }
        .ked-bar-stack.is-clickable { cursor: pointer; }
        .ked-bar-stack.is-clickable:hover { background: var(--sv-bg-ececef); }
        .ked-bar-stack.is-clickable:hover .ked-bar-seg { background: var(--sv-bg-6d28d9); }
        .ked-bar-stack.is-selected { background: var(--sv-bg-ede9fe); box-shadow: inset 0 0 0 1.5px var(--sv-shadow-7c3aed); }
        .ked-bar-stack.is-selected .ked-bar-seg { background: var(--sv-bg-6d28d9); }
        .ked-bar-seg { width: 100%; background: var(--sv-bg-8b5cf6); border-radius: 6px 6px 0 0; transition: background 0.13s ease; }
        .ked-bar-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); text-align: center; }
        .ked-row.is-day-filtered .ked-bar-stack:not(.is-selected) { opacity: 0.45; }

        /* Per-video timeline cards inside the expanded editor row */
        .ked-vid-list { margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--border); position: relative; }
        .ked-vid-empty { text-align: center; padding: 18px; color: var(--text-muted); font-size: 0.8rem; }
        .ked-vid-toolbar { display: flex; align-items: center; gap: 4px; padding: 4px 6px 10px; font-size: 0.74rem; }
        .ked-vid-toolbar-meta { color: var(--text-muted); font-weight: 600; letter-spacing: -0.005em; }
        .ked-vid-toolbar-btn { display: inline-flex; align-items: center; gap: 4px; background: transparent; border: 0; color: var(--text-muted); font-family: inherit; font-size: 0.72rem; font-weight: 600; padding: 3px 7px; border-radius: 5px; cursor: pointer; transition: color 0.13s ease, background 0.13s ease; letter-spacing: -0.005em; }
        .ked-vid-toolbar-btn::before { content: "·"; margin-right: 4px; color: var(--sv-fg-d4d4d8); }
        .ked-vid-toolbar-btn:hover { color: var(--text-primary); background: var(--sv-bg-f4f4f5); }
        .ked-vid-toolbar-btn:hover::before { color: var(--sv-fg-d4d4d8); }
        .ked-vid-toolbar-btn svg { color: currentColor; flex-shrink: 0; opacity: 0.65; }
        /* Shared horizontal day axis above the strips. Aligned with strip track via grid template. */
        .ked-vid-axis { display: grid; grid-template-columns: 220px 1fr; gap: 14px; align-items: end; margin-bottom: 6px; }
        .ked-vid-axis::before { content: ""; }
        .ked-vid-axis-track { position: relative; height: 14px; }
        .ked-vid-axis-day { position: absolute; top: 0; transform: translateX(-50%); font-size: 0.6rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
        .ked-vid-track-grid { display: none; }
        .ked-vid-group { margin-bottom: 4px; border-radius: 8px; }
        .ked-vid-group:last-child { margin-bottom: 0; }
        .ked-vid-group-head { width: 100%; background: transparent; border: 0; font-family: inherit; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); padding: 8px 6px; display: flex; align-items: center; gap: 9px; cursor: pointer; border-radius: 8px; transition: background 0.13s ease; letter-spacing: -0.005em; text-align: left; }
        .ked-vid-group-head:hover { background: var(--sv-bg-f4f4f5); }
        .ked-group-chev { color: var(--text-muted); flex-shrink: 0; transition: transform 0.15s ease; }
        .ked-vid-group.is-expanded .ked-group-chev { transform: rotate(90deg); }
        .ked-group-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        .ked-vid-group-count { background: var(--sv-bg-f4f4f5); color: var(--text-muted); font-size: 0.7rem; font-weight: 700; padding: 1px 8px; border-radius: 99px; font-variant-numeric: tabular-nums; flex-shrink: 0; }
        .ked-vid-group-head:hover .ked-vid-group-count { background: var(--sv-bg-e9e9eb); }
        .ked-group-summary { display: inline-flex; gap: 6px; flex-wrap: wrap; margin-left: 4px; }
        .ked-group-chip { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; background: var(--sv-bg-f1f5f9); color: var(--sv-fg-475569); font-size: 0.7rem; font-weight: 600; border-radius: 99px; letter-spacing: -0.005em; }
        .ked-chip-n { color: var(--text-primary); font-weight: 800; font-variant-numeric: tabular-nums; }
        .ked-vid-group-body { padding: 4px 0 8px; }
        .ked-vid { display: grid; grid-template-columns: 220px 1fr; gap: 14px; align-items: center; padding: 7px 0; border-bottom: 1px solid var(--sv-border-f1f5f9); }
        .ked-vid:last-child { border-bottom: 0; }
        .ked-vid-meta { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .ked-vid-client { font-size: 0.72rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: -0.005em; }
        .ked-vid-title { font-size: 0.78rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
        a.ked-vid-title:hover { color: var(--sv-fg-5b21b6); text-decoration: underline; }
        .ked-vid-strip { position: relative; min-width: 0; }
        .ked-strip-track { position: relative; height: 14px; background: var(--sv-bg-fafaf9); border-radius: 4px; overflow: visible; box-shadow: inset 0 0 0 1px var(--sv-shadow-f1f5f9); background-image: linear-gradient(to right, transparent 0, transparent calc(100%/7 - 1px), var(--sv-misc-ececea) calc(100%/7 - 1px), var(--sv-misc-ececea) calc(100%/7), transparent calc(100%/7)); background-size: calc(100%/7 * 1.0001) 100%; }
        .ked-strip-seg { position: absolute; top: 0; bottom: 0; transition: filter 0.13s, transform 0.13s; cursor: default; }

        /* Work segments — In Progress only. The editor was actively working;
           the band's width = how long they spent on it. Solid colour. */
        .ked-strip-seg[data-kind="work"] {
            background: var(--sv-bg-eab308); /* in-progress yellow/amber */
        }
        .ked-strip-seg[data-kind="work"]:hover { filter: brightness(1.06); }

        /* Markers and terminals — uniform 7px notches that indicate "the
           status changed here". They don't take time on the strip; their
           job is to punctuate the line. Subtle left-to-right gradient in
           the status's own colour family gives a directional feel without
           competing with the work band visually. */
        .ked-strip-seg[data-kind="marker"],
        .ked-strip-seg[data-kind="terminal"] {
            width: 7px;
            transform: translateX(-50%);
            border-radius: 2px;
            z-index: 3;
            box-shadow: 0 0 0 1.5px var(--sv-shadow-fff), 0 1px 2px var(--sv-shadow-rgba-0-0-0-0_18);
        }
        .ked-strip-seg[data-kind="marker"]:hover,
        .ked-strip-seg[data-kind="terminal"]:hover { transform: translateX(-50%) scaleY(1.22); }

        /* Marker palette — left→right gradient inside each marker. The
           identity colour sits on the right, a lighter wash on the left. */
        .ked-strip-seg[data-kind="marker"][data-status="smm"]           { background: linear-gradient(90deg, var(--sv-bg-fbcfe8) 0%, var(--sv-bg-ec4899) 100%); }
        .ked-strip-seg[data-kind="marker"][data-status="kasper"]        { background: linear-gradient(90deg, var(--sv-bg-fed7aa) 0%, var(--sv-bg-f97316) 100%); }
        .ked-strip-seg[data-kind="marker"][data-status="client"]        { background: linear-gradient(90deg, var(--sv-bg-fecaca) 0%, var(--sv-bg-ef4444) 100%); }
        .ked-strip-seg[data-kind="marker"][data-status="tweak-needed"]  { background: linear-gradient(90deg, var(--sv-bg-fdba74) 0%, var(--sv-bg-c2410c) 100%); }
        .ked-strip-seg[data-kind="terminal"][data-status="approved"]    { background: linear-gradient(90deg, var(--sv-bg-93c5fd) 0%, var(--sv-bg-2563eb) 100%); }
        .ked-strip-seg[data-kind="terminal"][data-status="posted"]      { background: linear-gradient(90deg, var(--sv-bg-3b82f6) 0%, var(--sv-bg-1e3a8a) 100%); }
        .ked-strip-seg[data-kind="terminal"][data-status="canceled"]    { background: linear-gradient(90deg, var(--sv-bg-d4d4d8) 0%, var(--sv-bg-71717a) 100%); }
        .ked-strip-seg[data-kind="marker"][data-status="other"]         { background: linear-gradient(90deg, var(--sv-bg-d4d4d8) 0%, var(--sv-bg-71717a) 100%); }

        /* Legend swatches — flat colour at the rightmost stop of each
           marker gradient, so the legend doesn't introduce a different
           visual language. */
        .ked-legend-swatch[data-status="in-progress"]   { background: var(--sv-bg-eab308); }
        .ked-legend-swatch[data-status="smm"]           { background: var(--sv-bg-ec4899); }
        .ked-legend-swatch[data-status="kasper"]        { background: var(--sv-bg-f97316); }
        .ked-legend-swatch[data-status="client"]        { background: var(--sv-bg-ef4444); }
        .ked-legend-swatch[data-status="tweak-needed"]  { background: var(--sv-bg-c2410c); }
        .ked-legend-swatch[data-status="approved"]      { background: var(--sv-bg-2563eb); }
        .ked-legend-swatch[data-status="posted"]        { background: var(--sv-bg-1e3a8a); }
        .ked-legend-swatch[data-status="canceled"],
        .ked-legend-swatch[data-status="todo"],
        .ked-legend-swatch[data-status="backlog"],
        .ked-legend-swatch[data-status="other"]         { background: var(--sv-bg-9ca3af); }

        /* Custom hover tooltip — single line, status name only. */
        /* Editor-tab tooltips use the shared .global-tip system (see setupGlobalTooltip). */
        .ked-empty-msg { background: var(--white); border: 1px dashed var(--border); border-radius: 12px; padding: 26px 18px; text-align: center; color: var(--text-secondary); font-size: 0.84rem; }

        @media (max-width: 720px) {
            .ked-vid-axis { grid-template-columns: 140px 1fr; }
            .ked-vid { grid-template-columns: 140px 1fr; }
        }

        /* Filming Plans sub-tab */
        .kfilm-summary { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
        .kfilm-pill { font-size: 0.74rem; font-weight: 700; padding: 4px 11px; border-radius: 99px; }
        .kfilm-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
        .kfilm-red.kfilm-dot   { background: var(--sv-bg-dc2626); }
        .kfilm-amber.kfilm-dot { background: var(--sv-bg-d97706); }
        .kfilm-green.kfilm-dot { background: var(--sv-bg-16a34a); }
        .kfilm-pill.kfilm-red   { background: var(--sv-bg-fef2f2); color: var(--sv-fg-b91c1c); }
        .kfilm-pill.kfilm-amber { background: var(--sv-bg-fffbeb); color: var(--sv-fg-b45309); }
        .kfilm-pill.kfilm-green { background: var(--sv-bg-f0fdf4); color: var(--sv-fg-15803d); }
        html[data-theme="dark"] .kfilm-pill.kfilm-red   { background: var(--cal-status-client-approval-bg); color: var(--cal-status-client-approval-fg); }
        html[data-theme="dark"] .kfilm-pill.kfilm-amber { background: var(--cal-status-tweaks-needed-bg); color: var(--cal-status-tweaks-needed-fg); }
        html[data-theme="dark"] .kfilm-pill.kfilm-green { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); }
        .kfilm-list { display: flex; flex-direction: column; gap: 8px; }
        .kfilm-row { background: var(--white); border: 1px solid var(--border); border-left-width: 3px; border-radius: 12px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
        .kfilm-row:hover { box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_05); }
        .kfilm-row.kfilm-red   { border-left-color: var(--sv-border-dc2626); }
        .kfilm-row.kfilm-amber { border-left-color: var(--sv-border-d97706); }
        .kfilm-row.kfilm-green { border-left-color: var(--sv-border-16a34a); }
        .kfilm-main { display: grid; grid-template-columns: auto minmax(140px, 1.1fr) minmax(150px, 1fr) minmax(160px, 1.4fr) auto; align-items: center; gap: 14px; padding: 13px 16px; }
        .kfilm-name { font-size: 0.92rem; font-weight: 700; color: var(--text-primary); }
        .kfilm-runway { font-size: 0.8rem; color: var(--text-secondary); }
        .kfilm-runway strong { color: var(--text-primary); font-weight: 700; }
        .kfilm-reason { font-size: 0.78rem; color: var(--text-secondary); }
        .kfilm-row.kfilm-red .kfilm-reason   { color: var(--sv-fg-b91c1c); font-weight: 600; }
        .kfilm-row.kfilm-amber .kfilm-reason { color: var(--sv-fg-b45309); font-weight: 600; }
        .kfilm-actions { display: inline-flex; align-items: center; gap: 12px; justify-self: end; }
        .kfilm-open { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-decoration: none; white-space: nowrap; padding: 5px 11px; border: 1px solid var(--border); border-radius: 7px; }
        .kfilm-open:hover { border-color: var(--sv-border-aaa); }
        .kfilm-cal { font-weight: 600; color: var(--text-secondary); }
        .kfilm-cal:hover { color: var(--text-primary); }
        .kfilm-nodoc { font-size: 0.74rem; color: var(--text-muted); white-space: nowrap; }
        .kfilm-caret { color: var(--text-muted); font-size: 0.8rem; width: 12px; text-align: center; }
        .kfilm-muted, .kfilm-row .kfilm-muted { color: var(--text-muted); }
        .kfilm-strip { padding: 4px 16px 15px 33px; border-top: 1px solid var(--border-light); margin-top: 2px; }
        .kfilm-grid { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 11px; }
        .kfilm-cell { min-width: 46px; text-align: center; font-size: 0.74rem; font-weight: 600; padding: 6px 8px; border-radius: 7px; background: var(--bg); color: var(--text-muted); border: 1px solid var(--border-light); }
        .kfilm-cell a { color: inherit; text-decoration: none; display: block; }
        .kfilm-cell--on { background: var(--sv-bg-f0fdf4); color: var(--sv-fg-15803d); border-color: var(--sv-border-bbf7d0); }
        html[data-theme="dark"] .kfilm-cell--on { background: var(--cal-status-approved-bg); color: var(--cal-status-approved-fg); border-color: var(--cal-status-approved-bg); }
        .kfilm-note { font-size: 0.76rem; color: var(--text-secondary); margin-top: 9px; }
        @media (max-width: 760px) {
            .kfilm-main { grid-template-columns: auto 1fr; grid-auto-rows: auto; row-gap: 6px; }
            .kfilm-actions { grid-column: 1 / -1; justify-self: start; }
            .kfilm-reason, .kfilm-runway { grid-column: 1 / -1; }
        }

        /* Kasper lightbox (reuses calendar's overlay pattern, scoped under .kasper-wrap) */
        .kasper-lightbox { position: fixed; inset: 0; background: var(--sv-bg-rgba-0-0-0-0_86); z-index: 9000; display: none; align-items: center; justify-content: center; padding: 40px; cursor: zoom-out; }
        .kasper-lightbox.open { display: flex; }
        .kasper-lightbox img { max-width: 100%; max-height: 100%; object-fit: contain; cursor: default; border-radius: 6px; box-shadow: 0 12px 60px var(--sv-shadow-rgba-0-0-0-0_6); }
        .kasper-lightbox-close { position: absolute; top: 18px; right: 22px; background: var(--sv-bg-rgba-255-255-255-0_12); border: none; color: var(--sv-fg-fff); font-size: 1.6rem; line-height: 1; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s; }
        .kasper-lightbox-close:hover { background: var(--sv-bg-rgba-255-255-255-0_22); }
        /* History section */
        .kasper-history-wrap { margin-top: 36px; padding-top: 22px; border-top: 1px dashed var(--border); }
        /* Waiting section is the first bucket on the page — it doesn't
           need a top divider since there's nothing above it but the
           toolbar / refresh pill. */
        .kasper-waiting-wrap { margin-top: 4px; padding-top: 0; border-top: 0; }
        .kasper-history-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; cursor: pointer; user-select: none; }
        .kasper-history-title { font-size: 0.84rem; font-weight: 800; letter-spacing: -0.01em; color: var(--text-primary); }
        .kasper-history-count { font-size: 0.68rem; font-weight: 700; background: var(--border-light); color: var(--text-secondary); padding: 2px 9px; border-radius: 99px; font-variant-numeric: tabular-nums; }
        /* A focusable head needs a visible focus ring, or keyboard users can
           tab to it and have no idea where they are. Scoped to the Urgent
           heads because they are the only ones carrying tabindex today. */
        .kasper-urgent-wrap .kasper-history-head:focus-visible {
            outline: 2px solid var(--cal-urgent-bg); outline-offset: 3px; border-radius: 4px; }
        /* "Urgent" section head. Same section as its three siblings — only the
           title and count carry the urgent colour, so the group reads as more
           pressing without becoming a different kind of object on the page. */
        .kasper-urgent-wrap .kasper-history-title { color: var(--cal-urgent-bg); }
        .kasper-urgent-wrap .kasper-history-count { background: var(--cal-urgent-bg); color: var(--cal-urgent-fg); }
        .kasper-history-chev { color: var(--text-muted); transition: transform 0.2s; margin-left: auto; }
        .kasper-history-wrap.collapsed .kasper-history-chev { transform: rotate(-90deg); }
        .kasper-history-wrap.collapsed .kasper-history-body { display: none; }
        .kasper-history-day { margin-bottom: 18px; }
        .kasper-history-day-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); margin-bottom: 8px; display: flex; align-items: baseline; gap: 6px; }
        .kasper-history-day-label .kasper-day-count { color: var(--text-muted); font-weight: 600; font-size: 0.66rem; }
        .kasper-history-row { display: grid; grid-template-columns: 44px 1fr auto; gap: 12px; align-items: center; padding: 10px 12px; background: var(--white); border: 1px solid var(--border-light); border-radius: 10px; margin-bottom: 6px; transition: border-color 0.12s, box-shadow 0.12s; }
        .kasper-history-row:hover { border-color: var(--border); box-shadow: 0 2px 8px var(--sv-shadow-rgba-0-0-0-0_05); }
        .kasper-history-thumb { width: 44px; height: 44px; border-radius: 7px; overflow: hidden; background: var(--bg); display: flex; align-items: center; justify-content: center; color: var(--text-muted); flex-shrink: 0; }
        .kasper-history-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .kasper-history-main { min-width: 0; }
        .kasper-history-line1 { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .kasper-history-line2 { font-size: 0.7rem; color: var(--text-muted); margin-top: 1px; display: flex; align-items: center; gap: 6px; }
        .kasper-history-line2 .kasper-history-client { color: var(--text-secondary); font-weight: 600; }
        .kasper-history-actions { display: flex; align-items: center; gap: 6px; }
        .kasper-history-actions a { display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); padding: 5px 9px; border: 1px solid var(--border); border-radius: 7px; text-decoration: none; transition: all 0.12s; }
        .kasper-history-actions a:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); background: var(--bg); }
        .kcard-main { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
        .kcard-line1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .kcard-client { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); cursor: default; }
        .kcard-dot { color: var(--text-muted); cursor: default; }
        .kcard-date { font-size: 0.74rem; font-weight: 600; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 4px; cursor: default; }
        .kcard-date.is-empty { color: var(--text-muted); font-weight: 500; font-style: italic; }
        .kcard-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; cursor: default; }
        /* Client review card — plain-English line telling the client what's
           waiting on them (or what we're working on for them). Sits right
           below the big title, before the date / status pills, so the
           collapsed card carries the gist on its own. */
        .cal-review-card .kcard-title { font-size: 1.15rem; line-height: 1.25; }
        .cal-review-card .kcard-pending { font-size: 0.82rem; font-weight: 500; color: var(--text-secondary); line-height: 1.35; }
        .cal-review-card .kcard-pending-strong { color: var(--text-primary); font-weight: 700; }
        .cal-review-card .kcard-date { font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.03em; }
        .kcard-meta-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .kcard-smm { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 6px; background: var(--bg); border-radius: 99px; font-size: 0.72rem; font-weight: 600; color: var(--text-secondary); cursor: default; }
        .kcard-smm-avatar { width: 18px; height: 18px; border-radius: 50%; background: var(--text-primary); color: var(--white); font-size: 0.62rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
        .kcard-smm.is-missing { background: var(--sv-bg-fef3c7); color: var(--sv-fg-92400e); }
        .kcard-smm.is-missing .kcard-smm-avatar { background: var(--sv-bg-d97706); }
        .kcard-tweaks-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 700; color: var(--sv-fg-9a3412); background: var(--sv-bg-ffedd5); padding: 2px 8px; border-radius: 99px; }
        /* Icon-only "no more tweaks needed" chip on the Kasper queue card. */
        .kcard-aat-chip { display: inline-flex; align-items: center; justify-content: center; width: 19px; height: 19px; color: var(--sv-fg-166534); background: var(--sv-bg-dcfce7); border-radius: 99px; flex-shrink: 0; }
        .kcard-aat-chip svg { width: 11px; height: 11px; }
        /* Icon-only "no more tweaks needed" badge, right of the Tweaks pill. */
        .cal-foot-tweaks { display: inline-flex; align-items: center; gap: 6px; }
        .cal-aat-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; color: var(--sv-fg-166534); background: var(--sv-bg-dcfce7); border-radius: 99px; flex-shrink: 0; }
        .cal-aat-badge svg { width: 13px; height: 13px; }
        .kcard-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .kcard-watch-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; background: var(--text-primary); color: var(--white); border: none; border-radius: 10px; font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.15s; text-decoration: none; }
        .kcard-watch-btn:hover { background: var(--sv-bg-000); transform: translateY(-1px); box-shadow: 0 3px 10px var(--sv-shadow-rgba-0-0-0-0_15); }
        .kcard-watch-btn.is-disabled { background: var(--border); color: var(--text-muted); cursor: not-allowed; pointer-events: none; }
        .kcard-watch-btn svg { width: 12px; height: 12px; }
        /* Mark-reviewed button — sits next to Watch video in the strip. A
           muted outlined pill so it doesn't compete with the primary watch
           action, but still reads as an actionable affordance. */
        .kcard-done-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px;
            background: var(--white); color: var(--text-secondary);
            border: 1px solid var(--border); border-radius: 9px;
            font-family: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer;
            transition: background 0.15s, color 0.15s, border-color 0.15s; }
        .kcard-done-btn:hover:not(:disabled) { background: var(--sv-bg-f0fdf4); color: var(--sv-fg-166534); border-color: var(--sv-border-86efac); }
        .kcard-done-btn:disabled { opacity: 0.4; cursor: default; }
        .kcard-done-btn svg { width: 13px; height: 13px; }
        .kcard-expand-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: transparent; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; color: var(--text-secondary); transition: all 0.15s; }
        .kcard-expand-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); background: var(--bg); }
        .kcard-open-sheet { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: transparent; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; color: var(--text-secondary); transition: all 0.15s; }
        .kcard-open-sheet:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); background: var(--bg); }
        .kcard-open-sheet svg { width: 14px; height: 14px; }
        .kcard-expand-btn svg { width: 12px; height: 12px; transition: transform 0.2s; }
        .kcard.expanded .kcard-expand-btn svg { transform: rotate(180deg); }
        /* Close (X) — top-right corner of each Kasper review card. Hides the
           card from the queue until the SMM re-routes it back to Kasper. Kept
           subtle so it doesn't compete with the in-strip actions, firming up
           on hover. */
        .kcard-close-btn { position: absolute; top: 7px; right: 7px; z-index: 3; display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; padding: 0; background: transparent; border: none; border-radius: 6px; cursor: pointer; color: var(--text-muted); opacity: 0.55; transition: opacity 0.15s, color 0.15s, background 0.15s; }
        .kcard-close-btn:hover { opacity: 1; color: var(--text-primary); background: var(--bg); }
        .kcard-close-btn svg { width: 12px; height: 12px; }
        .kcard-body { border-top: 1px solid var(--border-light); padding: 18px 20px 20px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 22px; background: var(--sv-bg-fafaf8); }
        @media (max-width: 820px) { .kcard-body { grid-template-columns: 1fr; } .kcard-strip { grid-template-columns: 80px 1fr; gap: 12px; } .kcard-actions { grid-column: 1 / -1; justify-content: flex-end; padding-top: 6px; } .kcard-thumb { width: 80px; height: 80px; } }
        .kcard-col-left, .kcard-col-right { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
        .kcard-section-label { font-size: 0.64rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
        .kcard-caption { font-size: 0.88rem; line-height: 1.55; color: var(--text-primary); white-space: pre-wrap; background: var(--white); border: 1px solid var(--border-light); border-radius: 10px; padding: 12px 14px; max-height: 280px; overflow-y: auto; font-weight: 500; }
        .kcard-caption.is-empty { color: var(--text-muted); font-style: italic; font-weight: 400; }
        .kcard-cta-row { font-size: 0.8rem; color: var(--text-secondary); display: flex; align-items: baseline; gap: 8px; }
        .kcard-cta-row strong { color: var(--text-primary); font-weight: 700; }
        .kcard-thread { display: flex; flex-direction: column; gap: 10px; background: var(--white); border: 1px solid var(--border-light); border-radius: 10px; padding: 12px; max-height: 260px; overflow-y: auto; }
        .kcard-thread-empty { color: var(--text-muted); font-style: italic; font-size: 0.8rem; padding: 4px; }
        .kcard-cm { display: flex; gap: 8px; align-items: flex-start; }
        .kcard-cm-avatar { width: 24px; height: 24px; border-radius: 50%; background: var(--text-primary); color: var(--white); font-size: 0.66rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .kcard-cm-avatar.is-kasper { background: var(--sv-bg-7c3aed); }
        .kcard-cm-avatar.is-client { background: var(--sv-bg-16a34a); }
        .kcard-cm-body { flex: 1; min-width: 0; }
        .kcard-cm-line1 { display: flex; align-items: baseline; gap: 6px; }
        .kcard-cm-author { font-size: 0.74rem; font-weight: 700; color: var(--text-primary); }
        .kcard-cm-time { font-size: 0.66rem; color: var(--text-muted); }
        .kcard-cm-body-text { font-size: 0.82rem; line-height: 1.45; color: var(--text-primary); white-space: pre-wrap; margin-top: 2px; word-break: break-word; }
        .kcard-cm.is-done .kcard-cm-body-text { color: var(--text-muted); text-decoration: line-through; }
        .kcard-compose { background: var(--white); border: 1.5px solid var(--border); border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 8px; transition: border-color 0.12s; }
        .kcard-compose:focus-within { border-color: var(--text-primary); }
        .kcard-compose textarea { width: 100%; border: none; outline: none; resize: none; background: transparent; font-family: inherit; font-size: 0.86rem; line-height: 1.45; color: var(--text-primary); min-height: 64px; padding: 4px; }
        .kcard-compose textarea::placeholder { color: var(--text-muted); }
        .kcard-decisions { display: flex; gap: 8px; padding-top: 4px; border-top: 1px dashed var(--border-light); }
        .kcard-tweak-send { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 14px; background: var(--sv-bg-f97316); color: var(--sv-fg-fff); border: none; border-radius: 9px; font-family: inherit; font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.15s; }
        .kcard-tweak-send:hover:not(:disabled) { background: var(--sv-bg-ea580c); transform: translateY(-1px); }
        .kcard-tweak-send:disabled { opacity: 0.4; cursor: not-allowed; }
        .kcard-tweak-send svg { width: 13px; height: 13px; }
        .kcard-approve-bar { display: flex; flex-direction: column; gap: 10px; background: linear-gradient(135deg,var(--sv-bg-dcfce7),var(--sv-bg-bbf7d0)); border: 1.5px solid var(--sv-border-86efac); border-radius: 12px; padding: 14px; }
        .kcard-approve-title { font-size: 0.78rem; font-weight: 700; color: var(--sv-fg-14532d); display: flex; align-items: center; gap: 6px; }
        .kcard-approve-help { font-size: 0.74rem; color: var(--sv-fg-15803d); line-height: 1.4; }
        .kcard-approve-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: var(--sv-bg-16a34a); color: var(--sv-fg-fff); border: none; border-radius: 10px; font-family: inherit; font-size: 0.9rem; font-weight: 800; cursor: pointer; transition: all 0.15s; box-shadow: 0 1px 3px var(--sv-shadow-rgba-22-163-74-0_3); }
        .kcard-approve-btn:hover:not(:disabled) { background: var(--sv-bg-15803d); transform: translateY(-1px); box-shadow: 0 3px 10px var(--sv-shadow-rgba-22-163-74-0_35); }
        .kcard-approve-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .kcard-approve-btn svg { width: 14px; height: 14px; }
        /* Toast (Undo + confirmations) */
        .sv-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(10px); background: var(--toast-bg); color: var(--toast-color); border-radius: 12px; padding: 11px 16px; display: flex; align-items: center; gap: 14px; font-size: 0.84rem; font-weight: 600; box-shadow: 0 10px 32px var(--sv-shadow-rgba-0-0-0-0_28); z-index: 3000; opacity: 0; transition: opacity 0.18s ease, transform 0.18s ease; max-width: min(92vw, 480px); }
        .sv-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .sv-toast-msg { line-height: 1.35; }
        .sv-toast-action { background: var(--sv-bg-rgba-255-255-255-0_16); border: none; color: var(--sv-fg-fff); font-family: inherit; font-size: 0.8rem; font-weight: 800; border-radius: 8px; padding: 6px 13px; cursor: pointer; flex-shrink: 0; transition: background 0.13s; }
        .sv-toast-action:hover { background: var(--sv-bg-rgba-255-255-255-0_28); }
        /* Kasper queue: which components still need his decision (collapsed card) */
        .kcard-comp-pills { display: inline-flex; gap: 4px; align-items: center; }
        .kcard-comp-pill { font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; background: var(--sv-bg-fff7ed); color: var(--sv-fg-9a3412); border: 1px solid var(--sv-border-fed7aa); border-radius: 99px; padding: 1px 8px; line-height: 1.5; }
        /* Replies inbox: who the new messages are from */
        .kasper-replies-newfrom { margin-left: 8px; font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; background: var(--sv-bg-f5f3ff); color: var(--sv-fg-6d28d9); border: 1px solid var(--sv-border-ddd6fe); border-radius: 99px; padding: 1px 8px; }
        .kcard-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-top: 6px; border-top: 1px solid var(--border-light); margin-top: 4px; }
        .kcard-open-cal-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; background: transparent; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.74rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; text-decoration: none; }
        .kcard-open-cal-btn:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); background: var(--white); }
        .kcard-open-cal-btn svg { width: 11px; height: 11px; }
        .kcard-saving-chip { font-size: 0.7rem; color: var(--text-muted); display: inline-flex; align-items: center; gap: 5px; }
        .kcard-saving-chip.is-error { color: var(--sv-fg-dc2626); }
        .kcard.is-removing { opacity: 0; transform: scale(0.97); transition: opacity 0.25s, transform 0.25s; pointer-events: none; }

        /* ============================ CONTENT SAMPLES ============================
           Native rebuild of the Samples tab, modelled on the Content Calendar:
           one toolbar row, per-client tabs, a horizontal strip of sample cards,
           threaded comments, an editor/client preview toggle and a tokenised
           client share link. Self-contained (sm- prefix) so it can't collide
           with the calendar's cal- styles. */
        .samples-view { --sm-card-w: 296px; }
        .sm-loader { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; min-height:50vh; color:var(--text-muted); }
        .sm-loader .spinner { width:26px; height:26px; }

        .sm-toolbar { display:flex; align-items:center; gap:14px; flex-wrap:wrap; padding:14px 0 14px; border-bottom:1px solid var(--border-light); }
        .sm-toolbar-left { display:flex; align-items:center; gap:10px; min-width:0; flex:1 1 auto; }
        .sm-toolbar-right { display:flex; align-items:center; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
        .sm-embed-title { display:flex; flex-direction:column; line-height:1.2; }
        .sm-embed-title strong { font-size:1rem; font-weight:800; letter-spacing:-0.02em; }
        .sm-embed-title span { font-size:0.72rem; color:var(--text-muted); font-weight:600; }

        /* client tabs — mirrors the calendar's per-client pills. Single-row:
           pills scroll horizontally inside .sm-tabs-scroll; the add/search button
           stays outside so its dropdown isn't clipped. */
        .sm-tabs { display:flex; align-items:center; gap:6px; flex-wrap:nowrap; min-width:0; }
        .sm-tabs-scroll { display:flex; align-items:center; gap:6px; flex-wrap:nowrap; min-width:0; flex:0 1 auto;
            overflow-x:auto; overflow-y:hidden; scrollbar-width:none; scroll-behavior:smooth; }
        .sm-tabs-scroll::-webkit-scrollbar { display:none; }
        .sm-tabs-scroll > .sm-tab { flex:0 0 auto; white-space:nowrap; }
        .sm-tabs > .sm-tab-add-wrap { flex:0 0 auto; }
        .sm-tabs-scroll.fade-left  { -webkit-mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px); mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px); }
        .sm-tabs-scroll.fade-right { -webkit-mask-image: linear-gradient(to left, transparent, var(--sv-misc-000) 20px); mask-image: linear-gradient(to left, transparent, var(--sv-misc-000) 20px); }
        .sm-tabs-scroll.fade-left.fade-right { -webkit-mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px, var(--sv-misc-000) calc(100% - 20px), transparent); mask-image: linear-gradient(to right, transparent, var(--sv-misc-000) 20px, var(--sv-misc-000) calc(100% - 20px), transparent); }
        .sm-tab { position:relative; display:inline-flex; align-items:center; gap:7px; padding:7px 13px; border-radius:9px; border:1.5px solid var(--border); background:var(--white); font-family:inherit; font-size:0.8rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.14s; }
        .sm-tab:hover { border-color:var(--sv-border-bbb); color:var(--text-primary); }
        .sm-tab.active { color:var(--text-primary); border-color:transparent; background:hsl(var(--tab-h,250) 70% 96%); box-shadow:inset 0 0 0 1.5px hsl(var(--tab-h,250) 60% 78%); }
        .sm-tab .sm-tab-dot { width:7px; height:7px; border-radius:50%; background:hsl(var(--tab-h,250) 65% 60%); flex-shrink:0; }
        html[data-theme="dark"] .sm-tab.active { color:var(--text-inverse); background:hsl(var(--tab-h,250) 52% 28%); box-shadow:inset 0 0 0 1.5px hsl(var(--tab-h,250) 52% 38%); }
        html[data-theme="dark"] .sm-tab .sm-tab-dot { background:hsl(var(--tab-h,250) 60% 58%); }
        .sm-tab-x { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; color:var(--text-muted); opacity:0; transition:all 0.13s; }
        .sm-tab:hover .sm-tab-x { opacity:0.7; }
        .sm-tab-x:hover { background:var(--dn); color:var(--sv-fg-fff); opacity:1; }
        .sm-tab-x svg { width:8px; height:8px; }
        .sm-tab-add-wrap { position:relative; }
        .sm-tab-add { display:inline-flex; align-items:center; gap:5px; padding:7px 12px; border-radius:9px; border:1.5px dashed var(--border); background:transparent; font-family:inherit; font-size:0.78rem; font-weight:700; color:var(--text-muted); cursor:pointer; transition:all 0.14s; }
        .sm-tab-add:hover { border-color:var(--sv-border-aaa); color:var(--text-secondary); background:var(--white); }
        .sm-tab-add svg { width:13px; height:13px; }
        .sm-tab-search { position:absolute; top:calc(100% + 7px); left:0; z-index:60; background:var(--white); border:1px solid var(--border); border-radius:12px; box-shadow:0 10px 34px var(--sv-shadow-rgba-0-0-0-0_14); padding:8px; width:248px; }
        .sm-tab-search input { width:100%; font-family:inherit; font-size:0.82rem; padding:9px 11px; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--text-primary); }
        .sm-tab-search input:focus { outline:none; border-color:var(--accent,var(--sv-border-6c5ce7)); background:var(--white); }
        .sm-tab-results { margin-top:6px; max-height:240px; overflow-y:auto; display:flex; flex-direction:column; gap:2px; }
        .sm-tab-result { padding:8px 10px; border-radius:7px; font-size:0.82rem; font-weight:600; color:var(--text-secondary); cursor:pointer; text-align:left; border:none; background:transparent; font-family:inherit; }
        .sm-tab-result:hover, .sm-tab-result.active { background:var(--bg); color:var(--text-primary); }
        .sm-tab-empty { padding:10px; font-size:0.78rem; color:var(--text-muted); text-align:center; }

        /* segmented toggles (Reels/Thumbnails and Editor/Client) */
        .sm-seg { display:inline-flex; gap:3px; background:var(--bg); padding:3px; border-radius:9px; border:1px solid var(--border-light); }
        .sm-seg-btn { display:inline-flex; align-items:center; gap:6px; padding:6px 13px; border-radius:7px; border:none; background:transparent; font-family:inherit; font-size:0.76rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.14s; }
        .sm-seg-btn:hover { color:var(--text-primary); }
        .sm-seg-btn.active { background:var(--white); color:var(--text-primary); box-shadow:0 1px 3px var(--sv-shadow-rgba-0-0-0-0_1); }
        .sm-seg-btn .sm-seg-badge { font-size:0.6rem; font-weight:800; background:var(--border); color:var(--text-secondary); padding:2px 6px; border-radius:99px; letter-spacing:0.02em; }
        .sm-seg-btn.active .sm-seg-badge { background:var(--sv-bg-111110); color:var(--sv-fg-fff); }
        /* Client view: a larger, centered Reels/Thumbnails switch so it reads as the obvious thing to click. */
        .sm-seg-lg { padding:4px; gap:4px; border-radius:11px; box-shadow:0 1px 3px var(--sv-shadow-rgba-0-0-0-0_05); }
        .sm-seg-lg .sm-seg-btn { padding:11px 24px; font-size:0.95rem; border-radius:8px; }
        .sm-seg-lg .sm-seg-btn .sm-seg-badge { font-size:0.62rem; }
        .sm-toolbar-client { flex-direction:column; align-items:center; gap:14px; text-align:center; }
        .sm-toolbar-client .sm-toolbar-left { flex:none; }
        .sm-toolbar-client .sm-embed-title { align-items:center; }

        .sm-share-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; border:none; background:var(--sv-bg-111110); color:var(--sv-fg-fff); font-family:inherit; font-size:0.78rem; font-weight:700; cursor:pointer; transition:opacity 0.15s; }
        .sm-share-btn:hover { opacity:0.9; }
        .sm-share-btn.copied { background:var(--sv-bg-16a34a); }
        .sm-share-btn svg { width:13px; height:13px; }

        /* body / strip */
        .sm-body { padding-top:18px; }
        .sm-section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:4px; flex-wrap:wrap; }
        .sm-section-title { font-size:1.45rem; font-weight:800; letter-spacing:-0.025em; }
        .sm-section-sub { font-size:0.8rem; color:var(--text-secondary); margin-top:2px; }
        .sm-pill { font-size:0.64rem; font-weight:800; background:var(--sv-bg-efedfd); color:var(--sv-fg-6c5ce7); padding:5px 11px; border-radius:99px; letter-spacing:0.03em; }
        .sm-client-intro { background:var(--white); border:1px solid var(--border); border-radius:12px; padding:16px 18px; margin-bottom:8px; font-size:0.85rem; color:var(--text-secondary); line-height:1.5; }
        .sm-client-intro strong { color:var(--text-primary); font-weight:700; }

        .sm-strip { display:flex; align-items:flex-start; gap:16px; overflow-x:auto; overflow-y:visible; padding:20px 4px 30px; scroll-snap-type:x proximity; scrollbar-width:thin; }
        .sm-strip::-webkit-scrollbar { height:10px; }
        .sm-strip::-webkit-scrollbar-thumb { background:var(--border); border-radius:99px; border:3px solid var(--bg); }
        .sm-strip::after { content:''; flex:0 0 40vw; }

        .sm-card { flex:0 0 var(--sm-card-w); width:var(--sm-card-w); background:var(--white); border:1px solid var(--border); border-radius:14px; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 1px 3px var(--sv-shadow-rgba-0-0-0-0_05); scroll-snap-align:start; position:relative; transition:box-shadow 0.16s, border-color 0.16s; }
        .sm-card:hover { box-shadow:0 4px 18px var(--sv-shadow-rgba-0-0-0-0_1); }
        .sm-card.is-flash { animation:smFlash 1.4s ease; }
        @keyframes smFlash { 0%,100%{box-shadow:0 1px 3px var(--sv-shadow-rgba-0-0-0-0_05);} 25%{box-shadow:0 0 0 3px var(--sv-shadow-rgba-108-92-231-0_5);} }
        .sm-card.sm-dragging { opacity:0.45; }
        .sm-card.sm-drop-before { box-shadow:-3px 0 0 0 var(--accent,var(--sv-shadow-6c5ce7)); }
        .sm-card-top { display:flex; align-items:center; gap:8px; padding:10px 12px 8px; }
        .sm-card-label-wrap { display:flex; align-items:center; gap:7px; min-width:0; flex:1; }
        .sm-card-dot { width:7px; height:7px; border-radius:50%; background:var(--border); flex-shrink:0; }
        .sm-card-dot.has { background:var(--sv-bg-22c55e); }
        .sm-card-label { font-size:0.66rem; font-weight:800; color:var(--text-muted); letter-spacing:0.08em; text-transform:uppercase; background:transparent; border:none; font-family:inherit; padding:2px 4px; border-radius:5px; min-width:40px; max-width:160px; }
        .sm-card-label:not([readonly]):hover { background:var(--bg); }
        .sm-card-label:focus { outline:none; background:var(--bg); color:var(--text-primary); }
        .sm-card-grip { display:inline-flex; align-items:center; color:var(--text-muted); cursor:grab; opacity:0; transition:opacity 0.14s; }
        .sm-card:hover .sm-card-grip { opacity:0.55; }
        .sm-card-grip svg { width:14px; height:14px; }
        .sm-card-tools { display:flex; align-items:center; gap:2px; }
        .sm-card-tool { display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:6px; border:none; background:transparent; color:var(--text-muted); cursor:pointer; opacity:0; transition:all 0.13s; }
        .sm-card:hover .sm-card-tool { opacity:0.75; }
        .sm-card-tool:hover { background:var(--bg); color:var(--text-primary); opacity:1; }
        .sm-card-tool.del:hover { background:var(--sv-bg-rgba-192-57-43-0_1); color:var(--dn); }
        .sm-card-tool.copied { color:var(--sv-fg-16a34a); opacity:1; }
        .sm-card-tool svg { width:13px; height:13px; }

        .sm-frame { width:100%; aspect-ratio:9/16; max-height:62vh; background:var(--sv-bg-0e0d0c); position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; }
        .sm-frame iframe, .sm-frame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; border:none; display:block; }
        .sm-frame video { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; background:var(--sv-bg-000); border:none; display:block; }
        /* Click-to-open poster for links that can't be embedded (e.g. Frame.io). */
        .sm-video-poster { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-decoration:none;
            background:radial-gradient(120% 120% at 50% 34%, var(--sv-bg-262220) 0%, var(--sv-bg-0e0d0c) 72%); color:var(--sv-fg-fff); transition:background 0.18s; }
        .sm-video-poster:hover { background:radial-gradient(120% 120% at 50% 34%, var(--sv-bg-322d2a) 0%, var(--sv-bg-100f0e) 72%); }
        .sm-video-play { width:58px; height:58px; border-radius:50%; background:var(--sv-bg-rgba-255-255-255-0_12); border:1.5px solid var(--sv-border-rgba-255-255-255-0_55);
            display:flex; align-items:center; justify-content:center; transition:transform 0.18s, background 0.18s; }
        .sm-video-poster:hover .sm-video-play { transform:scale(1.07); background:var(--sv-bg-rgba-255-255-255-0_2); }
        .sm-video-play svg { width:24px; height:24px; margin-left:3px; }
        .sm-video-cta { font-size:0.85rem; font-weight:700; letter-spacing:-0.01em; }
        .sm-video-host { font-size:0.6rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--sv-fg-rgba-255-255-255-0_42); }
        /* Approval bar (Kasper → Client) */
        .sm-appr { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-top:10px; padding-top:11px; border-top:1px solid var(--border-light); }
        .sm-appr-pill { display:inline-flex; align-items:center; gap:5px; font-size:0.66rem; font-weight:800; letter-spacing:0.02em; text-transform:uppercase; padding:3px 9px; border-radius:99px; white-space:nowrap; }
        .sm-appr-pill::before { content:''; width:6px; height:6px; border-radius:50%; background:currentColor; flex:none; }
        .sm-appr-pill.is-draft    { background:var(--sv-bg-f1f0ee); color:var(--sv-fg-8a8780); }
        .sm-appr-pill.is-kasper   { background:var(--sv-bg-fef3c7); color:var(--sv-fg-92681e); }
        .sm-appr-pill.is-client   { background:var(--sv-bg-dbeafe); color:var(--sv-fg-1d4ed8); }
        .sm-appr-pill.is-approved { background:var(--sv-bg-dcfce7); color:var(--sv-fg-166534); }
        .sm-appr-pill.is-changes  { background:var(--sv-bg-fee2e2); color:var(--sv-fg-b91c1c); }
        html[data-theme="dark"] .sm-appr-pill.is-draft    { background:var(--cal-status-archived-bg); color:var(--cal-status-archived-fg); }
        html[data-theme="dark"] .sm-appr-pill.is-kasper   { background:var(--cal-status-kasper-approval-bg); color:var(--cal-status-kasper-approval-fg); }
        html[data-theme="dark"] .sm-appr-pill.is-client   { background:var(--cal-status-client-approval-bg); color:var(--cal-status-client-approval-fg); }
        html[data-theme="dark"] .sm-appr-pill.is-approved { background:var(--cal-status-approved-bg); color:var(--cal-status-approved-fg); }
        html[data-theme="dark"] .sm-appr-pill.is-changes  { background:var(--cal-status-tweaks-needed-bg); color:var(--cal-status-tweaks-needed-fg); }
        .sm-appr-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
        .sm-appr-note { font-size:0.72rem; color:var(--text-muted); }
        .sm-appr-btn { display:inline-flex; align-items:center; gap:6px; padding:7px 13px; border-radius:9px; border:1px solid var(--border); background:var(--white);
            font-family:inherit; font-size:0.76rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s; white-space:nowrap; }
        .sm-appr-btn:hover { border-color:var(--sv-border-aaa); color:var(--text-primary); }
        .sm-appr-btn.primary { background:var(--sv-bg-16a34a); border-color:var(--sv-border-16a34a); color:var(--sv-fg-fff); }
        .sm-appr-btn.primary:hover { background:var(--sv-bg-15803d); border-color:var(--sv-border-15803d); }
        .sm-appr-link { background:none; border:none; padding:4px 2px; font-family:inherit; font-size:0.72rem; font-weight:600; color:var(--text-muted); cursor:pointer; text-decoration:underline; text-underline-offset:2px; }
        .sm-appr-link:hover { color:var(--text-secondary); }
        .sm-appr-summary { font-size:0.7rem; font-weight:700; color:var(--text-muted); white-space:nowrap; }
        .sm-head-right { display:flex; align-items:center; gap:10px; }
        .sm-frame .sm-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; color:var(--sv-fg-rgba-255-255-255-0_45); font-size:0.78rem; padding:14px; text-align:center; }
        .sm-frame .sm-empty .sm-ratio { font-size:0.6rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--sv-fg-rgba-255-255-255-0_26); }
        .sm-frame .sm-empty svg { width:26px; height:26px; opacity:0.5; }
        .sm-open-btn { position:absolute; bottom:10px; right:10px; z-index:3; display:inline-flex; align-items:center; gap:6px; padding:6px 11px; border-radius:8px; border:none; background:var(--sv-bg-rgba-17-17-16-0_82); color:var(--sv-fg-fff); font-family:inherit; font-size:0.7rem; font-weight:700; cursor:pointer; backdrop-filter:blur(4px); transition:background 0.14s; text-decoration:none; }
        .sm-open-btn:hover { background:var(--sv-bg-111110); }
        .sm-open-btn svg { width:11px; height:11px; }

        .sm-card-body { padding:12px 13px 13px; display:flex; flex-direction:column; gap:11px; }
        .sm-field { display:flex; flex-direction:column; gap:5px; }
        .sm-field-label { font-size:0.62rem; font-weight:800; color:var(--text-muted); letter-spacing:0.08em; text-transform:uppercase; }
        .sm-input, .sm-textarea { width:100%; font-family:inherit; font-size:0.82rem; line-height:1.5; color:var(--text-primary); background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:8px 10px; resize:none; transition:border-color 0.12s, background 0.12s; }
        .sm-input:focus, .sm-textarea:focus { outline:none; border-color:var(--accent,var(--sv-border-6c5ce7)); background:var(--white); }
        .sm-input::placeholder, .sm-textarea::placeholder { color:var(--text-muted); }
        .sm-input[readonly], .sm-textarea[readonly] { cursor:default; background:var(--bg); }
        html[data-theme="dark"] .sm-input, html[data-theme="dark"] .sm-textarea { background:var(--field-bg); }
        html[data-theme="dark"] .sm-input:focus, html[data-theme="dark"] .sm-textarea:focus { border-color:var(--field-border-focus); background:var(--field-bg-focus); }
        html[data-theme="dark"] .sm-input[readonly], html[data-theme="dark"] .sm-textarea[readonly] { background:var(--field-bg); }
        .sm-media-row { display:flex; gap:6px; }
        .sm-media-row .sm-input { flex:1; min-width:0; }
        .sm-media-save { padding:0 12px; border-radius:8px; border:1px solid var(--border); background:var(--white); cursor:pointer; color:var(--text-secondary); font-family:inherit; font-size:0.74rem; font-weight:700; white-space:nowrap; }
        .sm-media-save:hover { background:var(--bg); color:var(--text-primary); }
        .sm-readonly-direction { font-size:0.84rem; line-height:1.55; color:var(--text-primary); white-space:pre-wrap; word-break:break-word; }
        .sm-readonly-direction.is-empty { color:var(--text-muted); font-style:italic; }

        /* Creative-direction client-visibility toggle (editor only) */
        .sm-dir-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .sm-dir-toggle { display:inline-flex; align-items:center; gap:5px; border:1px solid var(--border); background:var(--white); color:var(--text-secondary); border-radius:999px; padding:3px 9px; font-family:inherit; font-size:0.6rem; font-weight:700; letter-spacing:0.01em; text-transform:none; cursor:pointer; transition:all 0.15s; white-space:nowrap; }
        .sm-dir-toggle:hover { background:var(--bg); color:var(--text-primary); }
        .sm-dir-toggle svg { width:12px; height:12px; flex:none; }
        .sm-dir-toggle.is-hidden { background:var(--sv-bg-fef3c7); color:var(--sv-fg-92400e); border-color:transparent; }

        .sm-card-foot { display:flex; align-items:center; justify-content:space-between; gap:8px; padding-top:2px; }
        .sm-comments-btn { display:inline-flex; align-items:center; gap:6px; padding:6px 11px; border-radius:8px; border:1px solid var(--border); background:var(--white); cursor:pointer; color:var(--text-secondary); font-family:inherit; font-size:0.74rem; font-weight:700; transition:all 0.13s; position:relative; }
        .sm-comments-btn:hover { border-color:var(--sv-border-bbb); color:var(--text-primary); }
        .sm-comments-btn.has-open { border-color:var(--sv-border-f0b429); color:var(--sv-fg-9a6700); background:var(--sv-bg-fffbeb); }
        .sm-comments-btn svg { width:13px; height:13px; }
        .sm-comments-count { font-weight:800; }
        .sm-comments-count:empty { display:none; }
        .sm-comments-dot { position:absolute; top:-3px; right:-3px; width:8px; height:8px; border-radius:50%; background:var(--dn); border:1.5px solid var(--white); }
        .sm-card-saving { font-size:0.7rem; color:var(--text-muted); display:inline-flex; align-items:center; gap:5px; }
        .sm-card-saving[hidden] { display:none; }
        .sm-card-saving.is-error { color:var(--dn); cursor:pointer; border:none; background:transparent; font-family:inherit; font-weight:700; }

        /* add card */
        .sm-card-add { flex:0 0 var(--sm-card-w); width:var(--sm-card-w); min-height:200px; align-self:stretch; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; background:transparent; border:2px dashed var(--border); border-radius:14px; color:var(--text-muted); font-family:inherit; font-size:0.84rem; font-weight:700; cursor:pointer; transition:all 0.15s; scroll-snap-align:start; }
        .sm-card-add:hover { border-color:var(--sv-border-aaa); color:var(--text-secondary); background:var(--white); }
        .sm-card-add svg { width:26px; height:26px; }
        .sm-card-add.is-hero { flex-basis:var(--sm-card-w); min-height:62vh; }

        .sm-empty-state { padding:64px 24px; text-align:center; color:var(--text-muted); font-size:0.9rem; background:var(--white); border:1px dashed var(--border); border-radius:14px; }
        .sm-pick-client { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; min-height:46vh; text-align:center; color:var(--text-muted); }
        .sm-pick-client .sm-pick-title { font-size:1.1rem; font-weight:800; color:var(--text-primary); }
        .sm-error-state { padding:40px 24px; text-align:center; color:var(--dn); font-size:0.86rem; }

        /* comments modal — mirrors the calendar's notes modal */
        .sm-comments-overlay { position:fixed; inset:0; background:var(--sv-bg-rgba-15-15-14-0_42); backdrop-filter:blur(2px); z-index:300; display:none; align-items:center; justify-content:center; padding:24px; }
        .sm-comments-overlay.open { display:flex; }
        .sm-comments-modal { background:var(--white); border-radius:16px; width:100%; max-width:480px; max-height:84vh; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 24px 70px var(--sv-shadow-rgba-0-0-0-0_3); }
        .sm-cm-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:16px 18px; border-bottom:1px solid var(--border-light); }
        .sm-cm-title { font-size:0.95rem; font-weight:800; letter-spacing:-0.01em; }
        .sm-cm-title span { display:block; font-size:0.72rem; font-weight:600; color:var(--text-muted); margin-top:2px; }
        .sm-cm-head-actions { display:flex; align-items:center; gap:6px; }
        .sm-cm-hist { padding:5px 10px; border-radius:7px; border:1px solid var(--border); background:var(--white); font-family:inherit; font-size:0.7rem; font-weight:700; color:var(--text-secondary); cursor:pointer; }
        .sm-cm-hist.active { background:var(--bg); color:var(--text-primary); }
        .sm-cm-close { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:8px; border:none; background:transparent; color:var(--text-muted); cursor:pointer; }
        .sm-cm-close:hover { background:var(--bg); color:var(--text-primary); }
        .sm-cm-close svg { width:14px; height:14px; }
        .sm-cm-feed { flex:1; overflow-y:auto; padding:16px 18px; display:flex; flex-direction:column; gap:14px; }
        .sm-cm-empty { text-align:center; color:var(--text-muted); font-size:0.82rem; padding:30px 10px; }
        .sm-cm-thread { display:flex; flex-direction:column; gap:8px; }
        .sm-cm-thread.is-resolved { opacity:0.62; }
        .sm-cm-row { display:flex; gap:10px; }
        .sm-cm-row.is-reply { margin-left:30px; }
        .sm-cm-avatar { flex-shrink:0; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:800; color:var(--sv-fg-fff); background:var(--sv-bg-6c5ce7); }
        .sm-cm-row.is-client .sm-cm-avatar { background:var(--sv-bg-0ea5e9); }
        .sm-cm-bubble { flex:1; min-width:0; }
        .sm-cm-meta { display:flex; align-items:center; gap:8px; margin-bottom:3px; }
        .sm-cm-author { font-size:0.76rem; font-weight:800; color:var(--text-primary); }
        .sm-cm-role { font-size:0.6rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; padding:1px 6px; border-radius:99px; background:var(--sv-bg-efedfd); color:var(--sv-fg-6c5ce7); }
        .sm-cm-row.is-client .sm-cm-role { background:var(--sv-bg-e0f2fe); color:var(--sv-fg-0369a1); }
        .sm-cm-time { font-size:0.66rem; color:var(--text-muted); }
        .sm-cm-done-tag { font-size:0.6rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; color:var(--sv-fg-16a34a); background:var(--sv-bg-f0fdf4); padding:1px 7px; border-radius:99px; }
        .sm-cm-text { font-size:0.84rem; line-height:1.5; color:var(--text-primary); white-space:pre-wrap; word-break:break-word; }
        .sm-cm-actions { display:flex; gap:10px; margin-top:5px; }
        .sm-cm-action { font-size:0.7rem; font-weight:700; color:var(--text-secondary); background:none; border:none; cursor:pointer; padding:0; font-family:inherit; }
        .sm-cm-action:hover { color:var(--text-primary); text-decoration:underline; }
        .sm-cm-action.del:hover { color:var(--dn); }
        .sm-cm-action.resolve { color:var(--sv-fg-16a34a); }
        .sm-cm-composer { border-top:1px solid var(--border-light); padding:12px 18px 14px; }
        .sm-cm-reply-ctx { display:flex; align-items:center; justify-content:space-between; font-size:0.72rem; color:var(--text-secondary); background:var(--bg); border-radius:7px; padding:6px 10px; margin-bottom:8px; }
        .sm-cm-reply-ctx button { border:none; background:none; color:var(--text-muted); cursor:pointer; font-family:inherit; font-weight:700; }
        .sm-cm-composer-row { display:flex; gap:8px; align-items:flex-end; }
        .sm-cm-composer-row textarea { flex:1; font-family:inherit; font-size:0.84rem; line-height:1.5; border:1px solid var(--border); border-radius:9px; padding:9px 11px; background:var(--bg); resize:none; max-height:140px; }
        .sm-cm-composer-row textarea:focus { outline:none; border-color:var(--accent,var(--sv-border-6c5ce7)); background:var(--white); }
        .sm-cm-send { padding:9px 15px; border-radius:9px; border:none; background:var(--accent,var(--sv-bg-6c5ce7)); color:var(--sv-fg-fff); font-family:inherit; font-size:0.78rem; font-weight:800; cursor:pointer; white-space:nowrap; }
        .sm-cm-send:disabled { opacity:0.45; cursor:default; }
        .sm-cm-audience { display:flex; gap:6px; margin-bottom:8px; }
        .sm-cm-aud-btn { padding:5px 11px; border-radius:7px; border:1px solid var(--border); background:var(--white); font-family:inherit; font-size:0.7rem; font-weight:700; color:var(--text-secondary); cursor:pointer; }
        .sm-cm-aud-btn.active { background:var(--sv-bg-111110); color:var(--sv-fg-fff); border-color:var(--sv-border-111110); }
        body.sm-modal-open { overflow:hidden; }

        .sm-flash { position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(8px); background:var(--sv-bg-111110); color:var(--sv-fg-fff); padding:10px 18px; border-radius:9px; font-size:0.8rem; font-weight:700; box-shadow:0 8px 28px var(--sv-shadow-rgba-0-0-0-0_22); opacity:0; pointer-events:none; transition:opacity 0.18s, transform 0.18s; z-index:400; }
        .sm-flash.show { opacity:1; transform:translateX(-50%) translateY(0); }
        .sm-flash.error { background:var(--dn); }

        /* ── PTO / Time Off ─────────────────────────────────────────────── */
        .pto-wrap, .pto-admin { --text-muted: var(--text-secondary); --pto-positive: var(--sv-fg-166534); --pto-negative: var(--sv-fg-991b1b); }
        .pto-wrap { width: min(1180px, 100%); margin: 0 auto; padding: 10px 0 70px; }
        .pto-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin: 0 0 24px; }
        .pto-eyebrow { color: var(--text-muted); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
        .pto-title { margin-top: 5px; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.045em; }
        .pto-sub { max-width: 620px; margin-top: 6px; color: var(--text-secondary); font-size: 0.82rem; line-height: 1.55; }
        .pto-refresh { min-height: 36px; border: 1px solid var(--border); border-radius: 10px; padding: 8px 13px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.72rem; font-weight: 750; cursor: pointer; }
        .pto-refresh:hover { border-color: var(--text-muted); color: var(--text-primary); }
        .pto-refresh:disabled { opacity: 0.55; cursor: wait; }
        .pto-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr); gap: 18px; align-items: start; }
        .pto-stack { display: grid; gap: 18px; }
        .pto-card { min-width: 0; border: 1px solid var(--border); border-radius: 16px; background: var(--white); box-shadow: 0 1px 5px var(--sv-shadow-rgba-0-0-0-0_04); padding: 20px; }
        .pto-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
        .pto-card-title { color: var(--text-primary); font-size: 0.9rem; font-weight: 800; letter-spacing: -0.015em; }
        .pto-card-sub { margin-top: 4px; color: var(--text-muted); font-size: 0.68rem; line-height: 1.45; }
        .pto-balance-card { overflow: hidden; position: relative; padding: 24px; border-color: var(--sv-border-111110); background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .pto-balance-card::after { content: ''; position: absolute; width: 180px; height: 180px; right: -70px; top: -90px; border-radius: 50%; background: var(--sv-bg-rgba-255-255-255-0_07); pointer-events: none; }
        .pto-balance-label { position: relative; z-index: 1; font-size: 0.7rem; font-weight: 700; opacity: 0.7; }
        .pto-balance-number { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 8px; margin: 5px 0 17px; font-size: clamp(3rem, 8vw, 4.7rem); font-weight: 800; letter-spacing: -0.08em; line-height: 1; }
        .pto-balance-number span { font-size: 0.78rem; font-weight: 700; letter-spacing: 0; opacity: 0.68; }
        .pto-balance-number.negative { color: var(--pto-negative); }
        .pto-balance-metrics { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
        .pto-balance-metric { min-width: 0; border: 1px solid var(--sv-border-rgba-255-255-255-0_15); border-radius: 10px; padding: 10px; background: var(--sv-bg-rgba-255-255-255-0_07); }
        .pto-balance-metric strong { display: block; font-size: 0.92rem; }
        .pto-balance-metric span { display: block; margin-top: 2px; font-size: 0.59rem; opacity: 0.68; line-height: 1.35; }
        .pto-balance-card .sv-explain-label { text-decoration-color: var(--sv-border-rgba-255-255-255-0_15); }
        .pto-balance-card .sv-explain-label:hover, .pto-balance-card .sv-explain-label:focus-visible { background: var(--sv-bg-rgba-255-255-255-0_07); text-decoration-color: currentColor; }
        .pto-yearline { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 7px 14px; margin-top: 14px; font-size: 0.62rem; opacity: 0.72; }
        .pto-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
        .pto-field { min-width: 0; display: grid; gap: 6px; }
        .pto-field.full { grid-column: 1 / -1; }
        .pto-field label { color: var(--text-secondary); font-size: 0.67rem; font-weight: 750; }
        .pto-field input, .pto-field select, .pto-field textarea { width: 100%; min-height: 41px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--text-primary); padding: 9px 11px; font: inherit; font-size: 0.78rem; outline: 0; }
        .pto-field textarea { min-height: 76px; resize: vertical; line-height: 1.45; }
        .pto-field input:focus, .pto-field select:focus, .pto-field textarea:focus { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .pto-field input:disabled, .pto-field select:disabled, .pto-field textarea:disabled { opacity: 0.6; cursor: not-allowed; }
        .pto-field-help { color: var(--text-muted); font-size: 0.61rem; line-height: 1.4; }
        /* Shared branded controls. Browser-native select/date/number chrome is
           intentionally kept behind these primitives so staff tools render the
           same way on every OS. See docs/features/UI_DESIGN_STANDARDS.md. */
        .sv-explain-label { display: inline; border-radius: 3px; cursor: help; outline: 0; text-decoration-line: underline; text-decoration-style: dotted; text-decoration-thickness: 1px; text-decoration-color: var(--text-muted); text-underline-offset: 3px; touch-action: manipulation; transition: background-color 0.12s ease, text-decoration-color 0.12s ease; }
        .sv-explain-label:hover { background: var(--surface-subtle); text-decoration-color: currentColor; }
        .sv-explain-label:focus-visible { background: var(--surface-subtle); box-shadow: 0 0 0 2px var(--focus-ring); text-decoration-color: currentColor; }
        .sv-select { position: relative; width: 100%; }
        .sv-select.is-disabled { opacity: 0.58; pointer-events: none; }
        .sv-select-trigger, .sv-select-option, .sv-date-trigger, .sv-stepper-btn { -webkit-tap-highlight-color: transparent; }
        .sv-select-trigger, .sv-date-trigger { width: 100%; min-height: 44px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 12px; padding: 9px 12px; background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); color: var(--text-primary); font: inherit; font-size: 0.78rem; font-weight: 700; text-align: left; outline: 0; cursor: pointer; display: flex; align-items: center; gap: 9px; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s, transform 0.14s; }
        .sv-select-trigger:hover, .sv-date-trigger:hover { border-color: var(--sv-border-b9b9b4); background: var(--white); }
        .sv-select-trigger:focus-visible, .sv-date-trigger:focus-visible { border-color: var(--focus-ring); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .sv-select-trigger[aria-invalid="true"], .sv-date-trigger[aria-invalid="true"], .sv-stepper-input[aria-invalid="true"], .pto-field input[aria-invalid="true"] { border-color: var(--dn); box-shadow: 0 0 0 3px var(--dn-bg); }
        .sv-select-trigger > span:not(.sv-control-icon):not(.sv-option-dot), .sv-date-trigger > span:not(.sv-control-icon) { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .sv-control-icon { width: 17px; height: 17px; flex: 0 0 17px; display: inline-flex; align-items: center; justify-content: center; color: var(--text-muted); }
        .sv-control-icon svg { width: 15px; height: 15px; }
        .sv-select-chevron { margin-left: auto; transition: transform 0.16s ease, color 0.16s ease; }
        .sv-select.open .sv-select-chevron { transform: rotate(180deg); color: var(--text-primary); }
        .sv-select-menu { position: absolute; z-index: 680; top: calc(100% + 7px); left: 0; right: 0; max-height: 270px; overflow: auto; padding: 6px; border: 1px solid var(--border); border-radius: 14px; background: var(--white); box-shadow: 0 18px 48px var(--sv-shadow-rgba-17-17-16-0_16); opacity: 1; transform: translateY(-4px) scale(0.985); pointer-events: none; visibility: hidden; transition: transform 0.13s ease, visibility 0s linear 0.13s; }
        .sv-select.open .sv-select-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; visibility: visible; transition: transform 0.13s ease, visibility 0s; }
        .sv-select.open-up .sv-select-menu { top: auto; bottom: calc(100% + 7px); transform: translateY(4px) scale(0.985); }
        .sv-select.open.open-up .sv-select-menu { transform: translateY(0) scale(1); }
        .sv-select-menu::-webkit-scrollbar { width: 6px; }
        .sv-select-menu::-webkit-scrollbar-thumb { background: var(--sv-bg-d8d8d4); border-radius: 99px; }
        .sv-select-option { width: 100%; min-height: 42px; display: flex; align-items: center; gap: 9px; border: 0; border-radius: 10px; padding: 9px 10px; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.78rem; font-weight: 700; text-align: left; cursor: pointer; outline: 0; }
        .sv-select-option > span:not(.sv-option-dot):not(.sv-option-check) { min-width: 0; flex: 1; }
        .sv-select-option:hover, .sv-select-option:focus-visible { background: var(--bg); color: var(--text-primary); }
        .sv-select-option.active { background: var(--sv-bg-f5f3ff); color: var(--sv-fg-5b21b6); }
        .sv-select-option[aria-disabled="true"] { opacity: 0.42; cursor: not-allowed; }
        .sv-option-dot { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; background: var(--text-muted); }
        .sv-option-dot.wellness { background: var(--sv-bg-7c3aed); }
        .sv-option-dot.sick { background: var(--dn); }
        .sv-option-dot.floating { background: var(--sv-bg-eab308); }
        .sv-option-check { width: 15px; height: 15px; flex: 0 0 15px; margin-left: auto; }
        .sv-date { position: relative; width: 100%; }
        .sv-date.is-disabled { opacity: 0.58; pointer-events: none; }
        .sv-date .sv-date-value { position: absolute; width: 1px; height: 1px; left: 8px; bottom: 0; margin: 0; padding: 0; border: 0; opacity: 0; pointer-events: none; }
        .sv-date .sv-date-value::-webkit-calendar-picker-indicator { display: none; }
        .sv-date-placeholder { color: var(--text-muted); font-weight: 600; }
        .sv-stepper { width: 100%; min-height: 44px; display: grid; grid-template-columns: 42px minmax(0, 1fr) 42px; align-items: stretch; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .sv-stepper:focus-within { border-color: var(--focus-ring); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); background: var(--white); }
        .sv-stepper.is-disabled { opacity: 0.58; }
        .sv-stepper-btn { min-width: 42px; border: 0; background: transparent; color: var(--text-secondary); font: inherit; font-size: 1.12rem; font-weight: 850; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.12s, color 0.12s; }
        .sv-stepper-btn:hover:not(:disabled) { background: var(--bg); color: var(--text-primary); }
        .sv-stepper-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -3px; }
        .sv-stepper-btn:disabled { opacity: 0.3; cursor: not-allowed; }
        .sv-stepper .sv-stepper-input { width: 100%; min-width: 0; height: 42px; min-height: 42px; margin: 0; border: 0; border-left: 1px solid var(--border-light); border-right: 1px solid var(--border-light); border-radius: 0; padding: 0 8px; background: transparent; color: var(--text-primary); font: inherit; font-size: 0.84rem; font-weight: 800; text-align: center; outline: 0; box-shadow: none; -moz-appearance: textfield; }
        .sv-stepper .sv-stepper-input:focus { border-color: var(--border-light); box-shadow: none; }
        .sv-stepper-input::-webkit-outer-spin-button, .sv-stepper-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .pto-type-pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 4px 8px; background: var(--sv-bg-f5f3ff); color: var(--sv-fg-5b21b6); font-size: 0.59rem; font-weight: 800; }
        .pto-type-pill.sick { background: var(--dn-bg); color: var(--pto-negative); }
        .pto-type-pill.floating { background: var(--sv-bg-fef9c3); color: var(--sv-fg-854d0e); }
        .pto-type-pill.unpaid { background: var(--bg); color: var(--text-secondary); }
        .pto-type-pill.untyped { background: var(--up-bg); color: var(--pto-positive); }
        .sv-option-dot.untyped { background: var(--pto-positive); }
        .pto-card-title-row, .pto-admin-title-row { display: flex; align-items: center; gap: 7px; }
        .pto-notice { grid-column: 1 / -1; display: flex; gap: 8px; border: 1px solid var(--sv-border-fdba74); border-radius: 10px; padding: 9px 11px; background: var(--sv-bg-fff7ed); color: var(--sv-fg-9a3412); font-size: 0.67rem; font-weight: 650; line-height: 1.4; }
        .pto-notice[hidden] { display: none; }
        .pto-submit { grid-column: 1 / -1; min-height: 42px; border: 0; border-radius: 11px; padding: 10px 16px; background: var(--sv-bg-111110); color: var(--sv-fg-fff); font: inherit; font-size: 0.76rem; font-weight: 800; cursor: pointer; }
        .pto-submit:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 7px 18px var(--sv-shadow-rgba-17-17-16-0_16); }
        .pto-submit:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
        .pto-submit:disabled { opacity: 0.48; cursor: not-allowed; }
        .pto-form-error { grid-column: 1 / -1; color: var(--pto-negative); font-size: 0.68rem; font-weight: 650; line-height: 1.4; }
        .pto-status { display: inline-flex; align-items: center; border-radius: 999px; padding: 4px 8px; font-size: 0.59rem; font-weight: 800; text-transform: capitalize; white-space: nowrap; }
        .pto-status.pending { background: var(--sv-bg-fff7ed); color: var(--sv-fg-9a3412); }
        .pto-status.approved { background: var(--up-bg); color: var(--pto-positive); }
        .pto-status.denied, .pto-status.cancelled { background: var(--dn-bg); color: var(--pto-negative); }
        .pto-table-scroll { width: 100%; overflow-x: auto; }
        .pto-table { width: 100%; min-width: 620px; border-collapse: collapse; }
        .pto-table th { border-bottom: 1px solid var(--border); padding: 8px 9px; color: var(--text-muted); font-size: 0.59rem; font-weight: 800; letter-spacing: 0.05em; text-align: left; text-transform: uppercase; }
        .pto-table td { border-bottom: 1px solid var(--border-light); padding: 10px 9px; color: var(--text-secondary); font-size: 0.69rem; vertical-align: middle; }
        .pto-table-note { max-width: 320px; margin-top: 5px; color: var(--text-muted); font-size: 0.6rem; line-height: 1.4; white-space: normal; }
        .pto-table-note strong { color: var(--text-secondary); }
        .pto-table tr:last-child td { border-bottom: 0; }
        .pto-table strong { color: var(--text-primary); }
        .pto-request-history-cards { display: none; }
        .pto-request-history-card { display: grid; gap: 9px; border: 1px solid var(--border-light); border-left: 3px solid var(--text-muted); border-radius: 11px; padding: 12px; background: var(--surface-subtle); }
        .pto-request-history-card.type-wellness { border-left-color: var(--sv-border-7c3aed); }
        .pto-request-history-card.type-sick { border-left-color: var(--pto-negative); }
        .pto-request-history-card.type-floating { border-left-color: var(--sv-border-fde047); }
        .pto-request-history-top, .pto-request-history-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .pto-request-history-dates { color: var(--text-primary); font-size: 0.72rem; font-weight: 800; line-height: 1.4; }
        .pto-request-history-meta { color: var(--text-muted); font-size: 0.63rem; font-weight: 700; }
        .pto-request-history-actions { min-height: 30px; }
        .pto-negative { color: var(--pto-negative) !important; font-weight: 800; }
        .pto-row-btn { border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.63rem; font-weight: 750; cursor: pointer; }
        .pto-row-btn:hover { border-color: var(--text-muted); color: var(--text-primary); }
        .pto-row-btn:disabled { opacity: 0.48; cursor: not-allowed; }
        .pto-empty { border: 1px dashed var(--border); border-radius: 12px; padding: 24px 16px; color: var(--text-muted); font-size: 0.72rem; line-height: 1.5; text-align: center; }
        .pto-calendar-card { grid-column: 1 / -1; }
        .pto-calendar-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 13px; }
        .pto-calendar-title { font-size: 0.88rem; font-weight: 800; }
        .pto-calendar-nav { display: inline-flex; align-items: center; gap: 6px; }
        .pto-calendar-nav button { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 9px; background: var(--white); color: var(--text-secondary); cursor: pointer; }
        .pto-calendar-nav button:disabled { opacity: 0.38; cursor: not-allowed; }
        .pto-calendar-scroll { width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }
        .pto-calendar-scroll:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .pto-calendar { min-width: 720px; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); background: var(--border); gap: 1px; }
        .pto-cal-weekday { background: var(--bg); color: var(--text-muted); padding: 8px; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.04em; text-align: center; text-transform: uppercase; }
        .pto-cal-day { min-height: 104px; overflow: hidden; background: var(--white); padding: 7px; }
        .pto-cal-day.weekend { background: var(--surface-subtle); }
        .pto-cal-day.outside { background: var(--bg); }
        .pto-cal-day.today { box-shadow: inset 0 0 0 2px var(--text-primary); }
        .pto-cal-num { margin-bottom: 6px; color: var(--text-muted); font-size: 0.63rem; font-weight: 800; }
        .pto-cal-event { overflow: hidden; margin-top: 4px; border-radius: 6px; padding: 4px 6px; background: var(--up-bg); color: var(--pto-positive); font-size: 0.57rem; font-weight: 750; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
        .pto-cal-event.holiday { background: var(--ig-light); color: var(--ig-dark); }
        .pto-cal-more { margin-top: 4px; color: var(--text-muted); font-size: 0.55rem; font-weight: 700; }
        .pto-signin { display: grid; justify-items: center; gap: 10px; padding: 44px 18px; text-align: center; }
        .pto-signin strong { font-size: 0.92rem; }
        .pto-signin span { max-width: 420px; color: var(--text-muted); font-size: 0.7rem; line-height: 1.5; }
        .pto-spinner { width: 18px; height: 18px; border: 2px solid var(--border); border-top-color: var(--text-primary); border-radius: 50%; animation: spin 0.75s linear infinite; }
        @media (prefers-reduced-motion: reduce) {
            .sv-select-menu { animation: none !important; transition: none !important; }
            .sv-explain-label { transition: none !important; }
            .pto-spinner { animation: none !important; }
        }

        .kad-wrap { display: grid; gap: 16px; }
        .kad-toolbar { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
        .kad-range-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
        .kad-range-btn { min-height: 32px; padding: 6px 12px; border: none; border-right: 1px solid var(--border); background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.72rem; font-weight: 700; cursor: pointer; }
        .kad-range-btn:last-child { border-right: none; }
        .kad-range-btn.active { background: var(--text-primary); color: var(--white); }
        .kad-range-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
        .kad-lead-status { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 0.68rem; font-weight: 700; }
        .kad-lead-won { background: var(--up-bg); color: var(--up); }
        .kad-lead-lost { background: var(--dn-bg); color: var(--dn); }
        .kad-lead-open { background: var(--surface-subtle); color: var(--text-secondary); }
        .kad-lead-cancelled { font-size: 0.65rem; color: var(--text-muted); font-style: italic; }
        .kad-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; }
        .kad-stat-label { color: var(--text-muted); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
        .kad-stat-value { margin-top: 6px; font-size: 1.3rem; font-weight: 800; color: var(--text-primary); }
        .kad-stat-sub { margin-top: 4px; color: var(--text-muted); font-size: 0.65rem; }
        /* This panel's card chrome, copied declaration-for-declaration from the
           Time-Off card rules it used to borrow by class name. Nothing renders
           differently; only the selector names changed.

           Wearing another feature's class names had a cost nobody priced. The
           leave-evidence gate fingerprints every index.html line matching one
           of its tokens, and a CSS class name is such a token -- so four lines
           of Kasper markup made a published 101-shot packet read as stale for a
           source change that feature never had, and that lane went red on main
           on 2026-08-24 for no reason of its own. The only sanctioned way to
           clear it is a human re-review of all 101 shots. Duplicating six short
           rules is cheaper than a false alarm that teaches everyone to skim CI.
           (Deliberately worded without those selector names: naming them here
           would put this very comment back in the fingerprint.) */
        .kad-card { min-width: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--white); padding: 18px; }
        .kad-card.full { grid-column: 1 / -1; }
        .kad-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
        .kad-card-title { color: var(--text-primary); font-size: 0.9rem; font-weight: 800; letter-spacing: -0.015em; }
        .kad-card-sub { margin-top: 4px; color: var(--text-muted); font-size: 0.68rem; line-height: 1.45; }
        .kad-section-title { margin-bottom: 4px; font-size: 0.82rem; font-weight: 800; }
        .kad-section-sub { margin-bottom: 14px; color: var(--text-muted); font-size: 0.65rem; line-height: 1.45; }
        .kad-refresh { min-height: 36px; border: 1px solid var(--border); border-radius: 10px; padding: 8px 13px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.72rem; font-weight: 750; cursor: pointer; }
        .kad-refresh:hover { border-color: var(--text-muted); color: var(--text-primary); }
        .kad-refresh:disabled { opacity: 0.55; cursor: wait; }
        /* Same declaration-for-declaration copy as the card chrome above, and
           for the same reason: the by-ad and per-lead tables (v2) borrowed the
           Time-Off feature's scrollable-table classes, which is the exact
           coupling that made the leave-evidence gate go red on 2026-08-24. */
        .kad-table-scroll { width: 100%; overflow-x: auto; }
        .kad-table { width: 100%; min-width: 620px; border-collapse: collapse; }
        .kad-table th { border-bottom: 1px solid var(--border); padding: 8px 9px; color: var(--text-muted); font-size: 0.59rem; font-weight: 800; letter-spacing: 0.05em; text-align: left; text-transform: uppercase; }
        .kad-table td { border-bottom: 1px solid var(--border-light); padding: 10px 9px; color: var(--text-secondary); font-size: 0.69rem; vertical-align: middle; }
        .kad-table tr:last-child td { border-bottom: 0; }
        .kad-table strong { color: var(--text-primary); }
        .kad-table-scroll-cue { display: none; margin-bottom: 7px; color: var(--text-muted); font-size: 0.61rem; font-weight: 750; line-height: 1.35; }
        @media (max-width: 640px) { .kad-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 900px) { .kad-card.full { grid-column: auto; } }
        @media (max-width: 600px) { .kad-table-scroll-cue { display: block; } }

        .pto-admin { display: grid; gap: 16px; }
        .pto-admin-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
        .pto-admin-card { min-width: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--white); padding: 18px; }
        .pto-admin-card.full { grid-column: 1 / -1; }
        .pto-admin-title { margin-bottom: 4px; font-size: 0.82rem; font-weight: 800; }
        .pto-admin-sub { margin-bottom: 14px; color: var(--text-muted); font-size: 0.65rem; line-height: 1.45; }
        .pto-admin-queue { display: grid; gap: 10px; }
        .pto-admin-section-break { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); }
        .pto-upcoming-list { display: grid; gap: 8px; }
        .pto-upcoming-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--border-light); border-radius: 11px; padding: 11px 12px; background: var(--surface-subtle); }
        .pto-upcoming-row strong { color: var(--text-primary); font-size: 0.73rem; }
        .pto-admin-history { margin-top: 14px; border-top: 1px solid var(--border-light); padding-top: 12px; }
        .pto-admin-history summary { color: var(--text-secondary); font-size: 0.67rem; font-weight: 800; cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .pto-admin-history summary::-webkit-details-marker { display: none; }
        .pto-admin-history summary span { border-radius: 999px; padding: 3px 7px; background: var(--bg); color: var(--text-muted); font-size: 0.58rem; }
        .pto-history-list { display: grid; gap: 7px; margin-top: 10px; }
        .pto-history-row { display: grid; gap: 5px; border: 1px solid var(--border-light); border-radius: 10px; padding: 10px 11px; }
        .pto-history-row > div { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 7px; color: var(--text-secondary); font-size: 0.65rem; }
        .pto-history-row strong { color: var(--text-primary); font-size: 0.7rem; }
        .pto-history-row small { color: var(--text-muted); font-size: 0.59rem; display: grid; gap: 2px; }
        .pto-history-note { border-radius: 8px; padding: 7px 9px; background: var(--bg); color: var(--text-secondary); font-size: 0.61rem; line-height: 1.4; }
        .pto-history-note strong { font-size: inherit; }
        .pto-table-scroll-cue { display: none; margin-bottom: 7px; color: var(--text-muted); font-size: 0.61rem; font-weight: 750; line-height: 1.35; }
        .pto-request-card { border: 1px solid var(--border); border-radius: 12px; padding: 14px; }
        .pto-request-card.type-wellness { border-left: 3px solid var(--sv-border-7c3aed); }
        .pto-request-card.type-sick { border-left: 3px solid var(--pto-negative); }
        .pto-request-card.type-floating { border-left: 3px solid var(--sv-border-fde047); }
        .pto-request-card.type-unpaid { border-left: 3px solid var(--text-muted); }
        .pto-request-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .pto-request-name { font-size: 0.78rem; font-weight: 800; }
        .pto-request-meta { margin-top: 6px; color: var(--text-muted); font-size: 0.63rem; line-height: 1.45; display: flex; align-items: center; flex-wrap: wrap; gap: 7px; }
        .pto-request-note { margin-top: 9px; border-radius: 8px; padding: 8px 10px; background: var(--bg); color: var(--text-secondary); font-size: 0.66rem; line-height: 1.45; }
        .pto-decision { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 7px; margin-top: 11px; }
        .pto-decision input { min-width: 0; border: 1px solid var(--border); border-radius: 9px; background: var(--white); color: var(--text-primary); padding: 8px 10px; font: inherit; font-size: 0.68rem; }
        .pto-decision button { border: 0; border-radius: 9px; padding: 8px 11px; font: inherit; font-size: 0.64rem; font-weight: 800; cursor: pointer; }
        .pto-decision button:disabled { opacity: 0.48; cursor: not-allowed; }
        .pto-decision .approve { background: var(--up-bg); color: var(--pto-positive); }
        .pto-decision .deny { background: var(--dn-bg); color: var(--pto-negative); }
        .pto-request-card > .pto-notice { margin-top: 10px; }
        .pto-admin-form { display: grid; gap: 10px; }
        .pto-check { display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 0.68rem; font-weight: 700; }
        .pto-check input { width: 16px; height: 16px; accent-color: var(--text-primary); }
        /* Kasper Time Off calendar. Month and by-person reads of the same
           merged event list; every colour comes from an existing theme token so
           both views stay legible in light and dark. */
        .pto-cal-head { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
        .pto-cal-head .pto-admin-sub { margin-bottom: 0; }
        .pto-cal-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        .pto-cal-views { display: inline-flex; gap: 2px; border: 1px solid var(--border); border-radius: 11px; padding: 3px; background: var(--bg); }
        .pto-cal-view { min-height: 32px; border: 0; border-radius: 8px; padding: 0 12px; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.64rem; font-weight: 780; cursor: pointer; }
        .pto-cal-view:hover { color: var(--text-primary); }
        .pto-cal-view[aria-pressed="true"] { background: var(--white); color: var(--text-primary); box-shadow: 0 1px 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .pto-cal-today { min-height: 34px; border: 1px solid var(--border); border-radius: 9px; padding: 0 12px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.64rem; font-weight: 780; cursor: pointer; }
        .pto-cal-today:hover { border-color: var(--text-muted); color: var(--text-primary); }
        .pto-cal-view:focus-visible, .pto-cal-today:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .pto-cal-stats { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 15px 0 12px; }
        .pto-cal-stat { display: grid; gap: 2px; }
        .pto-cal-stat strong { color: var(--text-primary); font-size: 1.05rem; font-weight: 850; line-height: 1.1; }
        .pto-cal-stat span { color: var(--text-muted); font-size: 0.57rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
        .pto-cal-legend { display: flex; flex-wrap: wrap; gap: 7px 15px; margin-bottom: 12px; color: var(--text-muted); font-size: 0.6rem; font-weight: 750; }
        .pto-cal-legend-item { display: inline-flex; align-items: center; gap: 6px; }
        /* Legend swatches carry the strong accent, not the tinted chip fill:
           dark theme collapses every soft tint onto one surface colour, so a
           tint-only key would read as six identical squares. */
        .pto-cal-swatch { width: 11px; height: 11px; flex: 0 0 11px; border-radius: 3px; background: var(--pto-positive); }
        .pto-cal-swatch.wellness { background: var(--sv-bg-7c3aed); }
        .pto-cal-swatch.sick { background: var(--dn); }
        .pto-cal-swatch.floating { background: var(--sv-bg-eab308); }
        .pto-cal-swatch.unpaid { background: var(--text-muted); }
        .pto-cal-swatch.pending { background: var(--sv-bg-fff7ed); box-shadow: inset 0 0 0 1.5px var(--sv-fg-9a3412); }
        .pto-cal-swatch.holiday { background: var(--ig-dark); }
        .pto-cal-note { margin-bottom: 11px; color: var(--text-muted); font-size: 0.66rem; line-height: 1.45; }
        .pto-cal-scroll-cue { display: none; margin-bottom: 7px; color: var(--text-muted); font-size: 0.61rem; font-weight: 750; line-height: 1.35; }
        .pto-cal-admin .pto-calendar { min-width: 700px; }
        button.pto-cal-day { display: block; width: 100%; margin: 0; border: 0; font: inherit; color: inherit; text-align: left; cursor: pointer; }
        button.pto-cal-day:hover { background: var(--surface-subtle); }
        button.pto-cal-day.weekend:hover { background: var(--bg); }
        button.pto-cal-day:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
        .pto-cal-admin .pto-cal-day.selected { background: var(--sv-bg-f5f3ff); box-shadow: inset 0 0 0 2px var(--sv-fg-5b21b6); }
        .pto-cal-admin .pto-cal-day.selected.today { box-shadow: inset 0 0 0 2px var(--sv-fg-5b21b6), inset 0 0 0 4px var(--text-primary); }
        .pto-cal-admin .pto-cal-num { display: block; }
        /* Each chip keeps the request-card accent bar so leave type survives
           dark theme, where the soft chip fills all resolve to one colour. */
        .pto-cal-admin .pto-cal-event { display: block; border-left: 3px solid var(--pto-positive); }
        .pto-cal-admin .pto-cal-event.wellness { background: var(--sv-bg-f5f3ff); color: var(--sv-fg-5b21b6); border-left-color: var(--sv-border-7c3aed); }
        .pto-cal-admin .pto-cal-event.sick { background: var(--dn-bg); color: var(--pto-negative); border-left-color: var(--pto-negative); }
        .pto-cal-admin .pto-cal-event.floating { background: var(--sv-bg-fef9c3); color: var(--sv-fg-854d0e); border-left-color: var(--sv-border-fde047); }
        .pto-cal-admin .pto-cal-event.unpaid { background: var(--bg); color: var(--text-secondary); border-left-color: var(--text-muted); }
        .pto-cal-admin .pto-cal-event.holiday { border-left-color: var(--ig-dark); }
        .pto-cal-admin .pto-cal-event.pending { background: var(--sv-bg-fff7ed); color: var(--sv-fg-9a3412); border: 1px dashed currentColor; padding: 3px 5px; }
        .pto-cal-admin .pto-cal-more { display: block; }
        .pto-people-grid { min-width: 700px; display: grid; gap: 1px; background: var(--border); }
        .pto-people-daynum { display: flex; align-items: center; justify-content: center; padding: 7px 2px; background: var(--bg); color: var(--text-muted); font-size: 0.55rem; font-weight: 800; }
        .pto-people-daynum.weekend { background: var(--surface-subtle); }
        .pto-people-daynum.today { background: var(--surface-subtle); color: var(--text-primary); }
        .pto-people-name { position: sticky; left: 0; z-index: 2; display: flex; align-items: center; min-height: 36px; overflow: hidden; padding: 7px 11px; background: var(--white); color: var(--text-primary); font-size: 0.66rem; font-weight: 780; white-space: nowrap; text-overflow: ellipsis; }
        .pto-people-name.pto-people-head { background: var(--bg); color: var(--text-muted); font-size: 0.57rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
        .pto-people-name > span[aria-hidden="true"] { overflow: hidden; text-overflow: ellipsis; }
        .pto-people-cell { min-height: 36px; background: var(--white); }
        .pto-people-cell.weekend { background: var(--surface-subtle); }
        .pto-people-cell.today { background: var(--surface-subtle); }
        /* One bar per leave, laid over the day cells it spans. A wordless block
           has only its fill to read, so approved leave is a solid accent and a
           pending one stays hollow. */
        .pto-people-bar { min-height: 36px; margin: 0; border: 0; border-radius: 4px; padding: 0; background: var(--pto-positive); cursor: pointer; }
        .pto-people-bar.wellness { background: var(--sv-bg-7c3aed); }
        .pto-people-bar.sick { background: var(--dn); }
        .pto-people-bar.floating { background: var(--sv-bg-eab308); }
        .pto-people-bar.unpaid { background: var(--text-muted); }
        .pto-people-bar.pending { background: var(--sv-bg-fff7ed); box-shadow: inset 0 0 0 1.5px var(--sv-fg-9a3412); }
        .pto-people-bar:hover { filter: brightness(0.92); }
        .pto-people-bar:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
        .pto-cal-admin .pto-row-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .pto-cal-detail { display: grid; gap: 9px; margin-top: 15px; border: 1px solid var(--border); border-radius: 12px; padding: 14px; background: var(--surface-subtle); }
        .pto-cal-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .pto-cal-detail-head .pto-admin-title { margin-bottom: 0; }
        .pto-cal-detail-row { display: grid; gap: 6px; border: 1px solid var(--border-light); border-radius: 10px; padding: 11px 12px; background: var(--white); }
        .pto-cal-detail-row .pto-request-meta { margin-top: 0; }
        .pto-cal-detail-top { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        .pto-cal-detail-top strong { color: var(--text-primary); font-size: 0.74rem; }
        .pto-cal-detail-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .pto-cal-detail-actions .pto-row-btn { min-height: 34px; }
        .pto-request-card.is-flagged { box-shadow: 0 0 0 2px var(--focus-ring); }
        /* Both grids are wider than a tablet column, so the swipe cue appears
           well before the phone breakpoint. */
        @media (max-width: 900px) {
            .pto-cal-scroll-cue { display: block; }
        }
        @media (max-width: 600px) {
            .pto-cal-head { flex-direction: column; align-items: stretch; }
            .pto-cal-controls { justify-content: space-between; }
            .pto-cal-stats { gap: 10px 18px; }
            .pto-cal-detail-head { align-items: flex-start; }
            /* Touch is the primary input here, so every calendar control grows
               to the 44px target the standards ask for. */
            .pto-cal-view, .pto-cal-today { min-height: 44px; }
            .pto-cal-controls .pto-calendar-nav { flex-wrap: wrap; }
            .pto-cal-controls .pto-calendar-nav button { width: 44px; height: 44px; }
            .pto-cal-detail-actions .pto-row-btn { min-width: 96px; min-height: 44px; }
            .pto-people-bar, .pto-people-cell, .pto-people-name { min-height: 44px; }
        }

        @media (max-width: 900px) {
            .pto-layout { grid-template-columns: 1fr; }
            .pto-calendar-card { grid-column: auto; }
            .pto-admin-grid { grid-template-columns: 1fr; }
            .pto-admin-card.full { grid-column: auto; }
        }
        @media (max-width: 600px) {
            .pto-wrap { padding-top: 0; }
            .pto-head { align-items: flex-start; }
            .pto-layout { gap: 14px; }
            .pto-stack { gap: 14px; }
            .pto-card { padding: 16px; border-radius: 14px; }
            .pto-balance-card { padding: 20px; }
            .pto-balance-metrics { grid-template-columns: 1fr 1fr; }
            .pto-form { grid-template-columns: 1fr; }
            .pto-field.full, .pto-notice, .pto-submit, .pto-form-error { grid-column: auto; }
            .pto-decision { grid-template-columns: 1fr 1fr; }
            .pto-decision input { grid-column: 1 / -1; }
            .pto-upcoming-row { align-items: flex-start; flex-direction: column; }
            .pto-staff-history-table { display: none; }
            .pto-request-history-cards { display: grid; gap: 9px; }
            .pto-request-history-actions .pto-row-btn { min-width: 88px; min-height: 34px; }
            .pto-table-scroll-cue { display: block; }
        }

        @media (max-width:760px) {
            .samples-view { --sm-card-w: 80vw; }
            .sm-toolbar { gap:10px; }
            .sm-toolbar-right { width:100%; justify-content:flex-start; }
        }
        /* ── Mobile / touch polish ──────────────────────────────────────
           Clients review on phones: the chrome must fit a narrow screen and
           every hover-revealed control needs a touch equivalent. */
        @media (max-width: 760px) {
            .header {
                height: auto;
                min-height: 60px;
                padding: 10px 14px 8px;
                gap: 8px 10px;
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) auto !important;
                grid-template-areas:
                    "logo actions"
                    "nav nav" !important;
                align-items: center !important;
            }
            .header .logo { grid-area: logo; min-width: 0; }
            .header-actions { grid-area: actions; justify-self: end; }
            .header-meta { display: none; }
            .header-nav { grid-area: nav; width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; max-width: 100%; padding-bottom: 2px; }
            .header-nav::-webkit-scrollbar { display: none; }
            .header-nav-btn { flex-shrink: 0; }
            .main { padding: 18px 14px 80px; }
            .search-bar-pill { width: calc(100vw - 48px); }
            /* Full-screen notes modal; dvh tracks the on-screen keyboard so
               the composer stays visible while typing (falls back to the
               base 86vh on browsers without dvh support). */
            .cal-comments-modal { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; }
        }
        @media (hover: none) {
            .cal-cm-row { flex-wrap: wrap; }
            .cal-cm-actions { position: static; opacity: 1; pointer-events: auto; flex-basis: 100%; width: max-content; margin: 2px 0 0 43px; box-shadow: none; }
            .cal-cm-action { padding: 7px 10px; }
            .pin-pill .pin-remove { width: 20px; height: 20px; }
        }
        /* >>> SXR_BEGIN */
        /* Samples (Review) styles — REUSE the calendar's global cal-* CSS for
           pixel parity; surface-specific rules are appended here per surface. */
        /* Surface 2 — creative-direction field + visibility eye, notes button */
        .sxr-cd-wrap { position: relative; margin-top: 6px; }
        .sxr-cd-input { width: 100%; border: 1px solid var(--sv-border-e2e4ea); border-radius: 8px; padding: 7px 30px 7px 9px; font: inherit; font-size: 12.5px; line-height: 1.4; color: var(--sv-fg-2b2f38); resize: none; min-height: 38px; background: var(--sv-bg-fff); box-sizing: border-box; }
        .sxr-cd-input:focus { outline: none; border-color: var(--sv-border-9aa3f0); box-shadow: 0 0 0 2px var(--sv-shadow-rgba-94-106-210-_12); }
        .sxr-cd-input::placeholder { color: var(--sv-fg-aab0c0); }
        .sxr-cd-eye { position: absolute; top: 5px; right: 5px; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border: none; background: transparent; color: var(--sv-fg-8a93a6); cursor: pointer; border-radius: 5px; padding: 0; }
        .sxr-cd-eye svg { width: 15px; height: 15px; }
        .sxr-cd-eye:hover { background: var(--sv-bg-f0f1f6); color: var(--sv-fg-5e6ad2); }
        .sxr-cd-eye.is-hidden { color: var(--sv-fg-c08a2e); }
        .cal-card-ro .sxr-cd-input { background: var(--sv-bg-f7f8fb); border-color: var(--sv-border-eceef3); }
        .cal-card-notes { display: inline-flex; align-items: center; gap: 5px; border: 1px solid var(--sv-border-e2e4ea); background: var(--sv-bg-fff); color: var(--sv-fg-5b6172); border-radius: 7px; padding: 4px 9px; font-size: 12px; font-weight: 600; cursor: pointer; }
        .cal-card-notes svg { width: 14px; height: 14px; }
        .cal-card-notes:hover { border-color: var(--sv-border-c7ccda); color: var(--sv-fg-2b2f38); }
        /* <<< SXR_END */

        /* ===== Sales Intake (subtab of the Kasper tab) ===== */
        .si-wrap { max-width: 720px; }
        .si-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }
        .si-title { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.2; }
        .si-sub { font-size: 0.85rem; color: var(--text-secondary); }
        .si-card { background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; padding: 26px 28px 28px; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_04); }
        .si-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; }
        .si-q { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        .si-q.si-full { grid-column: 1 / -1; }
        .si-label { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); }
        .si-req { color: var(--sv-fg-ef4444); margin-left: 3px; }
        .si-help { font-size: 0.72rem; color: var(--text-muted); line-height: 1.45; }
        .si-input { width: 100%; border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; font: inherit; font-size: 0.85rem; color: var(--text-primary); background: var(--white); box-sizing: border-box; }
        .si-input[readonly] { background: var(--bg); color: var(--text-secondary); }
        .si-input:focus { outline: none; border-color: var(--sv-border-9aa3f0); box-shadow: 0 0 0 2px var(--sv-shadow-rgba-94-106-210-_12); }
        textarea.si-input { resize: vertical; min-height: 92px; line-height: 1.5; }
        .si-radios { display: flex; flex-wrap: wrap; gap: 8px; }
        .si-pill { position: relative; }
        .si-pill input { position: absolute; opacity: 0; pointer-events: none; }
        .si-pill span { display: inline-flex; align-items: center; padding: 7px 13px; border: 1px solid var(--border); border-radius: 99px; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.12s; user-select: none; }
        .si-pill span:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .si-pill input:checked + span { border-color: var(--sv-border-5e6ad2); background: var(--sv-bg-rgba-94-106-210-_08); color: var(--sv-fg-4a54b8); }
        .si-pill input:disabled + span { cursor: default; opacity: 0.7; }
        .si-pill input:disabled:not(:checked) + span { background: var(--bg); }
        .si-locked-value { border: 1px solid var(--border-light); border-radius: 9px; background: var(--bg); padding: 9px 11px; color: var(--text-secondary); font-size: 0.82rem; line-height: 1.45; word-break: break-word; }
        .si-locked-value a { color: var(--sv-fg-4a54b8); font-weight: 700; text-decoration: none; }
        .si-locked-value a:hover { text-decoration: underline; }
        .si-linkprev { font-size: 0.72rem; color: var(--text-muted); word-break: break-all; }
        .si-linkprev b { color: var(--text-secondary); font-weight: 700; }
        .si-clause { font-size: 0.74rem; color: var(--text-secondary); line-height: 1.55; background: var(--bg); border: 1px solid var(--border-light); border-radius: 9px; padding: 10px 12px; }
        .si-preview { border-top: 1px solid var(--border-light); margin-top: 18px; padding-top: 18px; }
        .si-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
        .si-preview-head-main { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
        .si-preview-title { font-size: 0.78rem; font-weight: 800; color: var(--text-primary); }
        .si-preview-subject { font-size: 0.72rem; color: var(--text-muted); text-align: right; }
        .si-email-preview { border: 1px solid var(--border-light); border-radius: 10px; background: var(--white); padding: 16px; color: var(--text-primary); font-family: Arial, sans-serif; font-size: 0.8rem; line-height: 1.45; }
        .si-email-preview p { margin: 12px 0; }
        .si-email-preview .si-email-logo { width: 42px; height: 42px; border-radius: 9px; display: block; margin-bottom: 12px; }
        .si-email-preview .si-email-divider { padding-bottom: 12px; border-bottom: 1px solid var(--border-light); margin-bottom: 14px; }
        .si-email-preview .si-email-btn { display: inline-block; border-radius: 8px; padding: 10px 14px; color: var(--sv-fg-fff); font-weight: 700; text-decoration: none; }
        .si-email-preview .si-email-btn.sign { background: var(--sv-bg-a020f0); }
        .si-email-preview .si-email-btn.sign.disabled { background: var(--sv-bg-ede9fe); color: var(--sv-fg-5b21b6); cursor: default; pointer-events: none; }
        .si-email-preview .si-email-btn.pay { background: var(--sv-bg-111); }
        .si-email-preview .si-email-signature { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
        .si-email-preview .si-email-signature img { width: 34px; height: 34px; border-radius: 8px; }
        .si-email-preview .si-email-sig-text { border-left: 2px solid var(--sv-bg-a020f0); padding-left: 10px; line-height: 1.45; }
        .si-q.si-missing .si-input, .si-q.si-missing .si-pill span { border-color: var(--sv-border-ef4444); }
        .si-q.si-missing .si-label { color: var(--sv-fg-ef4444); }
        .si-err { display: none; font-size: 0.78rem; font-weight: 600; color: var(--sv-fg-b91c1c); background: var(--sv-bg-fef2f2); border: 1px solid var(--sv-border-fecaca); border-radius: 9px; padding: 10px 12px; margin-top: 16px; }
        .si-actions { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
        .si-btn { border: none; background: var(--sv-bg-5e6ad2); color: var(--sv-fg-fff); font: inherit; font-size: 0.85rem; font-weight: 700; padding: 11px 22px; border-radius: 10px; cursor: pointer; transition: background 0.12s; }
        .si-btn:hover { background: var(--sv-bg-4a54b8); }
        .si-btn:disabled { opacity: 0.55; cursor: default; }
        .si-btn-ghost { border: 1px solid var(--border); background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.78rem; font-weight: 600; padding: 8px 14px; border-radius: 9px; cursor: pointer; }
        .si-btn-ghost:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .si-btn-ghost:disabled { opacity: 0.55; cursor: default; }
        .si-btn-link { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.78rem; font-weight: 700; padding: 8px 14px; border-radius: 9px; cursor: pointer; text-decoration: none; }
        .si-btn-link:hover { color: var(--text-primary); border-color: var(--sv-border-aaa); }
        .si-done { background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; padding: 34px 30px; text-align: center; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_04); }
        .si-done-ico { width: 46px; height: 46px; border-radius: 50%; background: var(--sv-bg-dcfce7); color: var(--sv-fg-16a34a); font-size: 1.4rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
        .si-done h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 6px; }
        .si-done p { font-size: 0.82rem; color: var(--text-secondary); margin: 0 0 18px; }
        .si-done-summary { text-align: left; max-width: 430px; margin: 0 auto 22px; border: 1px solid var(--border-light); border-radius: 10px; overflow: hidden; }
        .si-done-row { display: flex; justify-content: space-between; gap: 14px; padding: 9px 14px; font-size: 0.78rem; border-bottom: 1px solid var(--border-light); }
        .si-done-row:last-child { border-bottom: none; }
        .si-done-row .k { color: var(--text-muted); font-weight: 600; flex-shrink: 0; }
        .si-done-row .v { color: var(--text-primary); font-weight: 600; text-align: right; word-break: break-all; }
        @media (max-width: 640px) { .si-grid { grid-template-columns: 1fr; } .si-card { padding: 20px 16px 22px; } .si-preview-head { align-items: flex-start; flex-direction: column; } .si-preview-subject { text-align: left; } }

        /* Hiring Process is a private, admin-only review queue. It deliberately
           has its own hp-* namespace so it can borrow the Sales Intake visual
           language without sharing the sales form's unauthenticated transport. */
        .hp-wrap { max-width: 1180px; }
        .hp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 16px; }
        .hp-title { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.015em; color: var(--text-primary); }
        .hp-sub { margin-top: 4px; max-width: 680px; font-size: 0.84rem; line-height: 1.5; color: var(--text-secondary); }
        .hp-refresh, .hp-action { border: 1px solid var(--border); border-radius: 9px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: 0.78rem; font-weight: 700; line-height: 1.2; padding: 9px 13px; cursor: pointer; transition: border-color .12s, color .12s, background .12s; }
        .hp-refresh:hover, .hp-action:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .hp-refresh:disabled, .hp-action:disabled { opacity: .55; cursor: default; }
        .hp-roles { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
        .hp-filters { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
        .hp-field-label { display: block; margin: 10px 0 4px; color: var(--text-secondary); font-size: .72rem; font-weight: 700; }
        .hp-input { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; background: var(--white); color: var(--text-primary); font: inherit; font-size: .8rem; padding: 8px 10px; }
        .hp-input:focus-visible { outline: 2px solid var(--sv-border-5e6ad2); outline-offset: 1px; }
        .hp-textarea { resize: vertical; line-height: 1.5; }
        .hp-filter { min-height: 34px; border: 1px solid var(--border); border-radius: 999px; background: var(--white); color: var(--text-secondary); font: inherit; font-size: .75rem; font-weight: 700; padding: 7px 12px; cursor: pointer; }
        .hp-filter:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .hp-filter.active { border-color: var(--sv-border-5e6ad2); background: var(--sv-bg-rgba-94-106-210-_08); color: var(--sv-fg-4a54b8); }
        .hp-workspace { display: grid; grid-template-columns: minmax(260px, .82fr) minmax(0, 1.6fr); gap: 16px; align-items: start; }
        .hp-list, .hp-detail { min-width: 0; background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_04); }
        .hp-list { overflow: hidden; }
        .hp-list-head, .hp-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 17px; border-bottom: 1px solid var(--border-light); }
        .hp-list-title, .hp-detail-title { color: var(--text-primary); font-size: .82rem; font-weight: 800; }
        .hp-list-count, .hp-muted { color: var(--text-muted); font-size: .74rem; }
        .hp-row { width: 100%; border: 0; border-bottom: 1px solid var(--border-light); background: var(--white); color: inherit; display: flex; flex-direction: column; gap: 5px; padding: 14px 16px; text-align: left; cursor: pointer; font: inherit; }
        .hp-row:last-child { border-bottom: 0; }
        .hp-row:hover { background: var(--bg); }
        .hp-row:focus-visible, .hp-action:focus-visible, .hp-refresh:focus-visible, .hp-filter:focus-visible { outline: 2px solid var(--sv-border-5e6ad2); outline-offset: 2px; }
        .hp-row.active { box-shadow: inset 3px 0 0 var(--sv-bg-5e6ad2); background: var(--sv-bg-rgba-94-106-210-_08); }
        .hp-row-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
        .hp-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary); font-size: .84rem; font-weight: 800; }
        .hp-row-time { flex: none; color: var(--text-muted); font-size: .7rem; }
        .hp-email { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: .74rem; }
        .hp-status { display: inline-flex; align-items: center; width: fit-content; min-height: 21px; border-radius: 999px; padding: 2px 8px; font-size: .68rem; font-weight: 800; text-transform: capitalize; }
        .hp-status.new { background: var(--sv-bg-fff7ed); color: var(--sv-fg-c2410c); }
        .hp-status.reviewing { background: var(--sv-bg-rgba-94-106-210-_08); color: var(--sv-fg-4a54b8); }
        .hp-status.hold { background: var(--sv-bg-fef3c7); color: var(--sv-fg-92400e); }
        .hp-status.invited, .hp-status.interview_booked { background: var(--sv-bg-dcfce7); color: var(--sv-fg-166534); }
        .hp-status.rejected, .hp-status.withdrawn { background: var(--bg); color: var(--text-muted); }
        .hp-empty, .hp-loading, .hp-error { padding: 28px 20px; color: var(--text-secondary); font-size: .8rem; line-height: 1.55; text-align: center; }
        .hp-error { color: var(--sv-fg-b91c1c); }
        .hp-detail-empty { min-height: 340px; display: flex; align-items: center; justify-content: center; padding: 30px; text-align: center; }
        .hp-detail-body { padding: 18px; }
        .hp-person { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
        .hp-person-name { color: var(--text-primary); font-size: 1.08rem; font-weight: 800; letter-spacing: -.015em; }
        .hp-person-meta { margin-top: 5px; color: var(--text-secondary); font-size: .78rem; line-height: 1.5; }
        .hp-link { color: var(--sv-fg-4a54b8); font-weight: 700; text-decoration: none; }
        .hp-link:hover { text-decoration: underline; }
        .hp-section { margin-top: 18px; }
        .hp-section-title { color: var(--text-primary); font-size: .76rem; font-weight: 800; letter-spacing: .01em; text-transform: uppercase; }
        .hp-answer-list { display: grid; gap: 10px; margin-top: 10px; }
        .hp-answer { border: 1px solid var(--border-light); border-radius: 10px; padding: 11px 12px; }
        .hp-answer-q { color: var(--text-secondary); font-size: .73rem; font-weight: 800; line-height: 1.35; }
        .hp-answer-a { margin-top: 5px; color: var(--text-primary); font-size: .8rem; line-height: 1.5; overflow-wrap: anywhere; white-space: pre-wrap; }
        .hp-video { display: inline-flex; align-items: center; min-height: 38px; margin-top: 10px; border: 1px solid var(--border); border-radius: 9px; padding: 0 12px; color: var(--sv-fg-4a54b8); font-size: .78rem; font-weight: 800; text-decoration: none; }
        .hp-video:hover { border-color: var(--sv-border-5e6ad2); background: var(--sv-bg-rgba-94-106-210-_08); }
        .hp-preview { margin-top: 20px; border-top: 1px solid var(--border-light); padding-top: 18px; }
        .hp-email { margin-top: 10px; border: 1px solid var(--border-light); border-radius: 10px; background: var(--bg); padding: 15px; color: var(--text-primary); font-family: Arial, sans-serif; font-size: .8rem; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }
        .hp-preview-meta { display: grid; gap: 4px; margin-top: 10px; color: var(--text-secondary); font-size: .75rem; }
        .hp-preview-meta b { color: var(--text-primary); }
        .hp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-top: 16px; }
        .hp-action.primary { border-color: var(--sv-bg-5e6ad2); background: var(--sv-bg-5e6ad2); color: var(--sv-fg-fff); }
        .hp-action.primary:hover { background: var(--sv-bg-4a54b8); border-color: var(--sv-bg-4a54b8); }
        .hp-action.danger { color: var(--sv-fg-b91c1c); }
        .hp-action-status { min-height: 22px; color: var(--text-secondary); font-size: .75rem; line-height: 1.4; }
        .hp-action-status.error { color: var(--sv-fg-b91c1c); }
        @media (max-width: 800px) { .hp-workspace { grid-template-columns: 1fr; } .hp-detail-empty { min-height: 220px; } }
        @media (max-width: 560px) { .hp-head { flex-direction: column; } .hp-refresh { width: 100%; min-height: 44px; } .hp-detail-body { padding: 15px; } .hp-actions .hp-action { min-height: 42px; } }

        /* ===== SMM weekly reports (hidden form + Kasper viewer) ===== */
        body.smm-weekly-mode .header, body.smm-weekly-mode #pageTop { display: none !important; }
        html[data-boot-nav="smm-weekly-report"] .header,
        html[data-boot-nav="smm-weekly-reports"] .header,
        html[data-boot-nav="smm-weekly-report"] #pageTop,
        html[data-boot-nav="smm-weekly-reports"] #pageTop { display: none !important; }
        .srp-wrap { width: min(1120px, calc(100vw - 48px)); margin: 34px auto 56px; }
        .srp-wrap.form { max-width: 760px; }
        .srp-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
        .srp-kicker { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); font-weight: 800; margin-bottom: 5px; }
        .srp-title { font-size: 1.55rem; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; color: var(--text-primary); }
        .srp-sub { font-size: 0.84rem; color: var(--text-secondary); margin-top: 5px; max-width: 620px; line-height: 1.45; }
        .srp-card { background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; padding: 24px 26px 26px; box-shadow: 0 2px 10px var(--sv-shadow-rgba-0-0-0-0_04); }
        .srp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; }
        .srp-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; position: relative; }
        .srp-field.full { grid-column: 1 / -1; }
        .srp-label { font-size: 0.72rem; font-weight: 850; letter-spacing: 0.035em; text-transform: uppercase; color: var(--text-secondary); }
        .srp-help { font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; }
        .srp-input, .srp-select { width: 100%; border: 1px solid var(--border); border-radius: 11px; padding: 10px 12px; font: inherit; font-size: 0.86rem; color: var(--text-primary); background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); box-sizing: border-box; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .srp-input:focus, .srp-select:focus { outline: none; border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); background: var(--white); }
        .srp-input[readonly] { background: var(--bg); color: var(--text-secondary); }
        .srp-select-wrap { position: relative; width: 100%; }
        .srp-select-wrap.is-disabled { opacity: 0.62; pointer-events: none; }
        .srp-select-trigger { width: 100%; min-height: 41px; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--border); border-radius: 11px; background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); color: var(--text-primary); font-family: inherit; font-size: 0.86rem; font-weight: 650; outline: 0; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 10px; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .srp-select-trigger:hover { border-color: var(--sv-border-b9b9b4); background: var(--sv-bg-fff); }
        .srp-select-trigger:focus { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); }
        .srp-select-trigger span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .srp-select-trigger svg { width: 13px; height: 13px; flex-shrink: 0; color: var(--text-muted); transition: transform 0.16s ease, color 0.16s ease; }
        .srp-select-wrap.open .srp-select-trigger svg { transform: rotate(180deg); color: var(--text-primary); }
        .srp-select-menu { position: absolute; z-index: 620; top: calc(100% + 7px); left: 0; right: 0; max-height: 260px; overflow: auto; padding: 6px; border: 1px solid var(--border); border-radius: 14px; background: var(--white); box-shadow: 0 18px 48px var(--sv-shadow-rgba-17-17-16-0_16); opacity: 0; transform: translateY(-4px) scale(0.985); pointer-events: none; visibility: hidden; transition: opacity 0.13s ease, transform 0.13s ease, visibility 0s linear 0.13s; }
        .srp-select-wrap.open .srp-select-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; visibility: visible; transition: opacity 0.13s ease, transform 0.13s ease, visibility 0s; }
        .srp-select-menu::-webkit-scrollbar, .srp-search-results::-webkit-scrollbar { width: 6px; }
        .srp-select-menu::-webkit-scrollbar-thumb, .srp-search-results::-webkit-scrollbar-thumb { background: var(--sv-bg-d8d8d4); border-radius: 99px; }
        .srp-select-option { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 10px; border: 0; border-radius: 10px; background: transparent; color: var(--text-secondary); font-family: inherit; font-size: 0.82rem; font-weight: 650; text-align: left; cursor: pointer; }
        .srp-select-option:hover { background: var(--bg); color: var(--text-primary); }
        .srp-select-option.active { background: var(--sv-bg-111110); color: var(--sv-fg-fff); }
        .srp-select-option svg { width: 12px; height: 12px; opacity: 0.9; }
        .srp-count-control { display: grid; grid-template-columns: 38px minmax(0, 1fr) 38px; align-items: center; border: 1px solid var(--border); border-radius: 11px; background: linear-gradient(180deg, var(--sv-bg-fff), var(--sv-bg-fbfbfa)); overflow: hidden; transition: border-color 0.14s, box-shadow 0.14s, background 0.14s; }
        .srp-count-control:focus-within { border-color: var(--text-primary); box-shadow: 0 0 0 3px var(--sv-shadow-rgba-17-17-16-0_07); background: var(--white); }
        .srp-count-btn { width: 38px; height: 40px; border: 0; background: transparent; color: var(--text-secondary); font-family: inherit; font-size: 1.1rem; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.12s, color 0.12s; }
        .srp-count-btn:hover { background: var(--bg); color: var(--text-primary); }
        .srp-count-input { width: 100%; height: 40px; min-width: 0; border: 0; border-left: 1px solid var(--border-light); border-right: 1px solid var(--border-light); background: transparent; color: var(--text-primary); font: inherit; font-size: 0.88rem; font-weight: 750; text-align: center; outline: 0; box-sizing: border-box; -moz-appearance: textfield; }
        .srp-count-input::-webkit-outer-spin-button, .srp-count-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .srp-radios { display: flex; flex-wrap: wrap; gap: 8px; }
        .srp-pill { position: relative; }
        .srp-pill input { position: absolute; opacity: 0; pointer-events: none; }
        .srp-pill span { display: inline-flex; align-items: center; min-height: 31px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 99px; font-size: 0.76rem; font-weight: 700; color: var(--text-secondary); cursor: pointer; transition: all 0.12s; user-select: none; box-sizing: border-box; }
        .srp-pill span:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); }
        .srp-pill input:checked + span { border-color: var(--sv-border-5e6ad2); background: var(--sv-bg-rgba-94-106-210-_08); color: var(--sv-fg-4a54b8); }
        .srp-search-results { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; box-shadow: 0 18px 48px var(--sv-shadow-rgba-17-17-16-0_16); padding: 6px; z-index: 40; max-height: 260px; overflow-y: auto; }
        .srp-search-option { display: block; width: 100%; padding: 8px 11px; border: 0; background: transparent; border-radius: 8px; text-align: left; font: inherit; font-size: 0.8rem; font-weight: 650; color: var(--text-secondary); cursor: pointer; }
        .srp-search-option:hover { background: var(--bg); color: var(--text-primary); }
        .srp-search-option.empty { color: var(--text-muted); cursor: default; font-style: italic; }
        .srp-field.srp-missing .srp-input, .srp-field.srp-missing .srp-select, .srp-field.srp-missing .srp-select-trigger, .srp-field.srp-missing .srp-count-control, .srp-field.srp-missing .srp-pill span { border-color: var(--sv-border-fecaca); }
        .srp-field.srp-missing .srp-label { color: var(--sv-fg-b91c1c); }
        .srp-error { display: none; font-size: 0.78rem; font-weight: 650; color: var(--sv-fg-b91c1c); background: var(--sv-bg-fef2f2); border: 1px solid var(--sv-border-fecaca); border-radius: 9px; padding: 10px 12px; margin-top: 16px; }
        .srp-actions { display: flex; align-items: center; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
        .srp-btn { border: none; background: var(--sv-bg-5e6ad2); color: var(--sv-fg-fff); font: inherit; font-size: 0.85rem; font-weight: 800; padding: 11px 20px; border-radius: 10px; cursor: pointer; transition: background 0.12s; }
        .srp-btn:hover { background: var(--sv-bg-4a54b8); }
        .srp-btn:disabled { opacity: 0.55; cursor: default; }
        .srp-btn.secondary { background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); padding: 10px 15px; }
        .srp-btn.secondary:hover { border-color: var(--sv-border-aaa); color: var(--text-primary); background: var(--white); }
        .srp-done { text-align: center; padding: 36px 28px; }
        .srp-done-icon { width: 46px; height: 46px; border-radius: 50%; background: var(--sv-bg-dcfce7); color: var(--sv-fg-16a34a); display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 0.82rem; margin-bottom: 14px; }
        .srp-skeleton { display: grid; gap: 15px; }
        .srp-skel-head { display: flex; gap: 12px; align-items: center; }
        .srp-skel-circle { width: 42px; height: 42px; border-radius: 50%; flex: 0 0 auto; }
        .srp-skel-line, .srp-skel-pill, .srp-skel-box, .srp-skel-circle { display: block; background: linear-gradient(90deg, var(--bg) 0%, var(--border-light) 42%, var(--bg) 78%); background-size: 220% 100%; animation: srpSkeleton 1.25s ease-in-out infinite; }
        .srp-skel-line { height: 12px; border-radius: 999px; }
        .srp-skel-line.short { width: 36%; }
        .srp-skel-line.medium { width: 62%; }
        .srp-skel-line.long { width: 86%; }
        .srp-skel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
        .srp-skel-field { display: grid; gap: 8px; min-width: 0; }
        .srp-skel-field.full { grid-column: 1 / -1; }
        .srp-skel-pill { height: 39px; border-radius: 11px; }
        .srp-skel-box { height: 88px; border-radius: 12px; }
        @keyframes srpSkeleton { 0% { background-position: 120% 0; } 100% { background-position: -120% 0; } }
        .srp-toolbar { display: grid; grid-template-columns: minmax(190px, 1.1fr) minmax(150px, 0.8fr) minmax(180px, 1fr) minmax(170px, 0.9fr) auto; align-items: center; gap: 10px; padding: 12px; background: var(--white); border: 1px solid var(--border-light); border-radius: 12px; margin-bottom: 14px; }
        .srp-toolbar .srp-input, .srp-toolbar .srp-select-wrap { width: 100%; min-width: 0; }
        .srp-toolbar .srp-btn { white-space: nowrap; min-height: 41px; }
        .srp-filter-field { position: relative; min-width: 0; width: 100%; }
        .srp-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
        .srp-metric { background: var(--white); border: 1px solid var(--border-light); border-radius: 10px; padding: 12px; min-width: 0; }
        .srp-metric strong { display: block; font-size: 1.2rem; color: var(--text-primary); line-height: 1; }
        .srp-metric span { display: block; margin-top: 5px; font-size: 0.7rem; color: var(--text-muted); font-weight: 750; text-transform: uppercase; letter-spacing: 0.04em; }
        .srp-group { margin-bottom: 18px; }
        .srp-group-title { font-size: 0.78rem; font-weight: 850; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; margin: 18px 0 8px; }
        .srp-report-list { display: grid; gap: 10px; }
        .srp-report { background: var(--white); border: 1px solid var(--border-light); border-radius: 12px; padding: 14px 16px; }
        .srp-report-top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 10px; }
        .srp-report-client { font-size: 0.96rem; font-weight: 800; color: var(--text-primary); }
        .srp-report-meta { font-size: 0.73rem; color: var(--text-muted); margin-top: 2px; }
        .srp-status { display: inline-flex; align-items: center; border-radius: 99px; padding: 4px 9px; font-size: 0.68rem; font-weight: 850; white-space: nowrap; background: var(--bg); color: var(--text-secondary); }
        .srp-status.alert { background: var(--sv-bg-fef2f2); color: var(--sv-fg-b91c1c); }
        .srp-status.warn { background: var(--sv-bg-fff7ed); color: var(--sv-fg-9a3412); }
        .srp-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px 16px; }
        .srp-answer { min-width: 0; }
        .srp-answer.full { grid-column: 1 / -1; }
        .srp-answer .k { display: block; font-size: 0.67rem; color: var(--text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.035em; margin-bottom: 2px; }
        .srp-answer .v { font-size: 0.8rem; color: var(--text-primary); line-height: 1.45; word-break: break-word; }
        .srp-empty { text-align: center; padding: 56px 20px; color: var(--text-secondary); background: var(--white); border: 1px solid var(--border-light); border-radius: 12px; }
        @media (max-width: 980px) { .srp-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); } .srp-toolbar .srp-btn { justify-self: start; } }
        @media (max-width: 880px) { .srp-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); } .srp-detail-grid { grid-template-columns: 1fr; } .srp-answer.full { grid-column: auto; } }
        @media (max-width: 640px) { .srp-wrap { width: calc(100vw - 28px); margin-top: 22px; } .srp-head { align-items: flex-start; flex-direction: column; } .srp-grid, .srp-summary, .srp-skel-grid, .srp-toolbar { grid-template-columns: 1fr; } .srp-card { padding: 20px 16px 22px; } .srp-toolbar .srp-btn { width: 100%; justify-content: center; } }
