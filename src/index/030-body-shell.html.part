    </style>
</head>
<body>
<!-- Confirmation modal -->
<div class="confirm-overlay" id="confirmOverlay" data-backdrop-dismiss onclick="if(event.target===this&&this._backdropPressBegan)dismissConfirm()">
    <div class="confirm-box">
        <div class="confirm-box-title" id="confirmTitle">Are you sure?</div>
        <div class="confirm-box-msg" id="confirmMsg">This will replace the current content.</div>
        <label class="confirm-box-check" id="confirmCheckWrap" hidden>
            <input type="checkbox" id="confirmCheck"><span id="confirmCheckLabel"></span>
        </label>
        <div class="confirm-box-actions">
            <button class="brief-action-btn" onclick="dismissConfirm()">Cancel</button>
            <button class="brief-action-btn primary" id="confirmYes">Regenerate</button>
        </div>
    </div>
</div>

<!-- Resolve-and-route chooser. Opened when the SMM routes a component onward —
     either by marking the last open change-request done (Notes modal) or by
     approving it in the Review tab. It resolves the open change-requests she
     ticks and routes the component to Kasper, the client, or straight to
     Approved. The ✕ (and a backdrop click) just close it — closing is
     non-destructive, since nothing is applied until a route is picked. -->
<div class="confirm-overlay" id="resolveDestOverlay" data-backdrop-dismiss onclick="if(event.target===this&&this._backdropPressBegan)_calDismissResolveDest()">
    <div class="confirm-box resolve-dest-box">
        <button type="button" class="resolve-dest-close" id="resolveDestClose" aria-label="Close" title="Close" onclick="_calDismissResolveDest()">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2.5 2.5l9 9M11.5 2.5l-9 9"/></svg>
        </button>
        <div id="resolveDestMain">
            <div class="confirm-box-title">Tweaks resolved — where to next?</div>
            <div class="confirm-box-msg" id="resolveDestMsg">Send this for approval.</div>
            <div class="resolve-dest-checklist" id="resolveDestChecklist" hidden></div>
            <div class="confirm-box-actions resolve-dest-actions">
                <button class="brief-action-btn" type="button" id="resolveDestKasper">Kasper approval</button>
                <button class="brief-action-btn" type="button" id="resolveDestClient">Client approval</button>
                <button class="brief-action-btn" type="button" id="resolveDestApprove">Approve</button>
            </div>
            <button type="button" class="resolve-dest-stay" id="resolveDestStay" title="Resolve the change request(s) without moving this to another stage">Mark done — don’t change the status</button>
        </div>
    </div>
</div>

<!-- Staff sign-in gate. Opaque cover shown until a staff identity is admitted.
     The sign-in card itself is rendered on top of this by
     _syncviewOpenStaffIdentity({ entry: true }) once the roster loads. -->
<div id="staffGateOverlay">
    <div class="staff-gate-inner">
        <img src="syncview-favicon.png" alt="SyncView">
        <div>
            <div class="staff-gate-title">Welcome to SyncView</div>
            <div class="staff-gate-note" id="staffGateNote">Preparing secure sign-in…</div>
        </div>
        <button class="cal-import-btn-primary staff-gate-retry" type="button" id="staffGateRetry" hidden onclick="_syncviewOpenStaffGate()">Try again</button>
    </div>
</div>

<header class="header" style="display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;">
    <a class="logo" href="./" onclick="if(_modClick(event))return;event.preventDefault();goHome();" style="cursor:pointer;text-decoration:none;color:inherit;" title="Back to overview">
        <img src="syncview-favicon.png" alt="SyncView">
        <span class="logo-text">SyncView</span>
    </a>
    <div class="header-nav" id="headerNav">
        <span class="header-nav-pill" aria-hidden="true"></span>
        <a class="header-nav-btn active" id="navHome" href="#" onclick="if(_modClick(event))return;event.preventDefault();navTo('home')">
            <span class="header-nav-ico ico-analytics" aria-hidden="true"></span>
            Analytics
        </a>
        <a class="header-nav-btn" id="navProd" href="#production" onclick="if(_modClick(event))return;event.preventDefault();navTo('production')">
            <span class="header-nav-ico ico-synclinear" aria-hidden="true"></span>
            SyncLinear
        </a>
        <a class="header-nav-btn" id="navLinear" href="#linear" onclick="if(_modClick(event))return;event.preventDefault();navTo('linear')">
            <span class="header-nav-ico ico-submit" aria-hidden="true"></span>
            Submit
        </a>
        <a class="header-nav-btn" id="navTemplates" href="#templates" onclick="if(_modClick(event))return;event.preventDefault();navTo('templates')">
            <span class="header-nav-ico ico-templates" aria-hidden="true"></span>
            Templates
        </a>
        <a class="header-nav-btn" id="navFilmingPlans" href="#filming-plans" onclick="if(_modClick(event))return;event.preventDefault();navTo('filming-plans')">
            <span class="header-nav-ico ico-filmingplans" aria-hidden="true"></span>
            Filming Plans
        </a>
        <a class="header-nav-btn" id="navWorkload" href="#workload" onclick="if(_modClick(event))return;event.preventDefault();navTo('workload')">
            <span class="header-nav-ico ico-workload" aria-hidden="true"></span>
            Workload
        </a>
        <a class="header-nav-btn" id="navCalendar" href="#calendar" onclick="if(_modClick(event))return;event.preventDefault();navTo('calendar')">
            <span class="header-nav-ico ico-calendar" aria-hidden="true"></span>
            Calendar
        </a>
        <!-- >>> SXR_BEGIN (nav) -->
        <a class="header-nav-btn" id="navSxr" href="#sample-reviews" style="display:none;" onclick="if(_modClick(event))return;event.preventDefault();navTo('sample-reviews')">
            <span class="header-nav-ico ico-samples" aria-hidden="true"></span>
            Samples
        </a>
        <!-- <<< SXR_END -->


        <a class="header-nav-btn" id="navTiktokUpload" href="#tiktok-upload" onclick="if(_modClick(event))return;event.preventDefault();navTo('tiktok-upload')">
            <span class="header-nav-ico ico-tiktok" aria-hidden="true"></span>
            TikTok Upload
        </a>
        <a class="header-nav-btn" id="navKasper" href="#kasper" style="display:none;" onclick="if(_modClick(event))return;event.preventDefault();navTo('kasper')">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M1 8s2.5-4.5 7-4.5S15 8 15 8s-2.5 4.5-7 4.5S1 8 1 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="8" cy="8" r="2.2" stroke="currentColor" stroke-width="1.5"/></svg>
            Kasper
        </a>
    </div>
    <div class="header-actions">
        <div class="staff-identity-wrap" id="staffIdentityWrap">
            <button class="theme-toggle staff-identity-btn" id="headerMenuButton" type="button" onclick="_syncviewOpenStaffAccount()" title="Open staff menu" aria-label="Open staff menu" aria-haspopup="menu" aria-expanded="false">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="5.3" r="2.5" stroke="currentColor" stroke-width="1.45"/><path d="M3.2 13.2c.35-2.35 2.1-3.7 4.8-3.7s4.45 1.35 4.8 3.7" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
            </button>
            <div class="staff-account-popover" id="staffAccountPopover" role="menu" aria-labelledby="headerMenuButton" hidden>
                <div class="staff-account-summary" id="staffAccountSummary" role="presentation" aria-hidden="true"></div>
                <div class="staff-account-sep" role="separator"></div>
                <button class="staff-account-action" id="staffIdentitySignOut" type="button" role="menuitem">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="5.3" r="2.5"/><path d="M3.2 13.2c.35-2.35 2.1-3.7 4.8-3.7s4.45 1.35 4.8 3.7"/></svg>
                    <span id="staffIdentityMenuLabel">Staff sign in</span>
                </button>
                <button class="staff-account-action" id="headerTimeOffMenuItem" type="button" role="menuitem" onclick="_ptoOpenFromMenu()" hidden>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.25" y="3.25" width="11.5" height="10.5" rx="1.6"/><path d="M2.5 6.5h11M5 1.8v3M11 1.8v3"/><path d="m5.2 9 1.4 1.4 3.4-3.2"/></svg>
                    <span>Time Off</span>
                </button>
                <button class="staff-account-action" id="themeToggle" type="button" role="menuitemcheckbox" onclick="toggleSyncViewTheme()" title="Switch to dark mode" aria-label="Switch to dark mode" aria-pressed="false">
                    <svg class="theme-icon-moon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.2 10.4A5.8 5.8 0 0 1 5.6 2.8 5.8 5.8 0 1 0 13.2 10.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    <svg class="theme-icon-sun" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.6"/><path d="M8 1.8V3M8 13v1.2M13 8h1.2M1.8 8H3M11.7 4.3l.8-.8M3.5 12.5l.8-.8M11.7 11.7l.8.8M3.5 3.5l.8.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    <span class="staff-account-action-copy"><span id="themeToggleLabel">Dark mode</span><span class="staff-account-action-note">Adjust SyncView's appearance</span></span>
                    <span class="staff-account-action-state" id="themeToggleState">Off</span>
                </button>
                <button class="staff-account-action palette-toggle" id="statusPaletteToggle" type="button" role="menuitemcheckbox" onclick="toggleSyncViewStatusPalette()" title="Switch to original status colors" aria-label="Switch to original status colors" aria-pressed="false">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2.2" y="2.2" width="4.6" height="4.6" rx="1.1" stroke="currentColor" stroke-width="1.35"/><rect x="9.2" y="2.2" width="4.6" height="4.6" rx="1.1" fill="currentColor"/><rect x="2.2" y="9.2" width="4.6" height="4.6" rx="1.1" fill="currentColor"/><rect x="9.2" y="9.2" width="4.6" height="4.6" rx="1.1" stroke="currentColor" stroke-width="1.35"/></svg>
                    <span class="staff-account-action-copy"><span>Original status colors</span><span class="staff-account-action-note">Use the classic workflow palette</span></span>
                    <span class="staff-account-action-state" id="statusPaletteToggleState">Off</span>
                </button>
            </div>
        </div>
    </div>
</header>
<main class="main" id="mainWrap">
    <div class="page-top overview-mode" id="pageTop">
        <div>
            <div class="page-title-row" id="titleRow">
                <div class="page-title" id="pageTitle">Client Analytics</div>
            </div>
            <div class="page-sub" id="pageSub">Instagram · TikTok · YouTube</div>
        </div>
        <div class="selector-wrap" id="selectorWrap">
            <div class="search-bar-wrap" id="searchWrap">
                <div class="search-bar-pill">
                    <input class="search-bar-input" id="searchInput" type="text"
                        placeholder="Search clients…"
                        oninput="onSearchInput()" onkeydown="onSearchKey(event)"
                        onfocus="onSearchFocus()" autocomplete="off">
                    <div class="search-ghost-overlay" id="searchGhost"></div>
                    <button class="search-bar-icon" onclick="onSearchIconClick()" title="Search">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                </div>
                <div class="search-dropdown" id="searchBox">
                    <div id="searchResults"></div>
                </div>
            </div>
        </div>
        <div class="pins-area" id="pinsArea"><div class="pins-row" id="pinsRow"></div><div class="pins-add-row" id="pinsAddRow"></div></div>
    </div>
    <div id="content">
        <span class="sr-only" id="bootLoadingText">Loading...</span>
        <div class="boot-skeleton-variant boot-skeleton-analytics">
        <div class="overview-wrap analytics-overview-skeleton" role="status" aria-live="polite" aria-label="Loading">
            <div class="overview-controls">
                <div class="controls-left">
                    <div class="sv-skeleton sv-skeleton-pill" style="width:96px;height:30px;"></div>
                    <div class="sv-skeleton sv-skeleton-pill" style="width:86px;height:30px;"></div>
                </div>
                <div class="sv-skeleton sv-skeleton-pill" style="width:74px;height:31px;"></div>
            </div>
            <table class="overview-table analytics-overview-table" aria-hidden="true">
                <colgroup><col class="col-name"><col class="col-date"><col class="col-num"><col class="col-gain"><col class="col-num"><col class="col-gain"><col class="col-num"><col class="col-gain"><col class="col-num"><col class="col-gain"><col class="col-num"><col class="col-gain"><col class="col-num"><col class="col-gain"></colgroup>
                <thead>
                    <tr>
                        <th rowspan="2" style="text-align:left;vertical-align:middle;"><div class="sv-skeleton sv-skeleton-line" style="width:72px;"></div></th>
                        <th rowspan="2" style="vertical-align:middle;"><div class="sv-skeleton sv-skeleton-line" style="width:44px;"></div></th>
                        <th colspan="4" class="group-ig"><div class="sv-skeleton sv-skeleton-line" style="width:86px;"></div></th>
                        <th colspan="4" class="group-tt"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></th>
                        <th colspan="4" class="group-yt"><div class="sv-skeleton sv-skeleton-line" style="width:74px;"></div></th>
                    </tr>
                    <tr>
                        <th class="ig-h"><div class="sv-skeleton sv-skeleton-line" style="width:54px;"></div></th><th class="ig-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th><th class="ig-h"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></th><th class="ig-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th>
                        <th class="tt-h"><div class="sv-skeleton sv-skeleton-line" style="width:54px;"></div></th><th class="tt-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th><th class="tt-h"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></th><th class="tt-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th>
                        <th class="yt-h"><div class="sv-skeleton sv-skeleton-line" style="width:66px;"></div></th><th class="yt-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th><th class="yt-h"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></th><th class="yt-h"><div class="sv-skeleton sv-skeleton-line" style="width:42px;"></div></th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td><div class="cell-inner"><span class="client-view-btn"></span><div class="sv-skeleton sv-skeleton-line" style="width:118px;"></div></div></td><td><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-ig main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-tt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-yt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td></tr>
                    <tr><td><div class="cell-inner"><span class="client-view-btn"></span><div class="sv-skeleton sv-skeleton-line" style="width:96px;"></div></div></td><td><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-ig main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:36px;height:18px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-line" style="width:48px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:42px;height:18px;"></div></td><td class="col-tt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:42px;height:18px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-line" style="width:56px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:38px;height:18px;"></div></td><td class="col-yt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:54px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:42px;height:18px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:38px;height:18px;"></div></td></tr>
                    <tr><td><div class="cell-inner"><span class="client-view-btn"></span><div class="sv-skeleton sv-skeleton-line" style="width:132px;"></div></div></td><td><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-ig main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:48px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:40px;height:18px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-tt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:38px;height:18px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-line" style="width:54px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-yt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:50px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:38px;height:18px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-line" style="width:58px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td></tr>
                    <tr><td><div class="cell-inner"><span class="client-view-btn"></span><div class="sv-skeleton sv-skeleton-line" style="width:104px;"></div></div></td><td><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-ig main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:54px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:42px;height:18px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-ig"><div class="sv-skeleton sv-skeleton-pill" style="width:36px;height:18px;"></div></td><td class="col-tt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:48px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:44px;height:18px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></td><td class="col-tt"><div class="sv-skeleton sv-skeleton-pill" style="width:40px;height:18px;"></div></td><td class="col-yt main-metric"><div class="sv-skeleton sv-skeleton-line" style="width:62px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:42px;height:18px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-line" style="width:52px;"></div></td><td class="col-yt"><div class="sv-skeleton sv-skeleton-pill" style="width:40px;height:18px;"></div></td></tr>
                </tbody>
            </table>
        </div>
        </div>
        <div class="boot-skeleton-variant boot-skeleton-client-verify">
            <div class="client-link-verify-skeleton" role="status" aria-live="polite" aria-label="Verifying secure client link" data-boot-surface="client-verify">
                <div class="client-link-verify-card">
                    <div class="client-link-verify-mark" aria-hidden="true"><div class="sv-skeleton sv-skeleton-dot"></div></div>
                    <div class="sv-skeleton sv-skeleton-line" style="width:210px;height:16px;"></div>
                    <div class="sv-skeleton sv-skeleton-line" style="width:286px;max-width:86%;"></div>
                </div>
            </div>
        </div>
        <div class="boot-skeleton-variant boot-skeleton-client-profile">
            <div class="boot-page-skeleton client-profile-boot-skeleton" role="status" aria-live="polite" aria-label="Loading client profile" data-boot-surface="client-analytics">
                <div class="boot-tab-skeleton-row">
                    <div class="sv-skeleton sv-skeleton-pill" style="width:92px;height:34px;"></div>
                    <div class="sv-skeleton sv-skeleton-pill" style="width:146px;height:34px;"></div>
                    <div class="sv-skeleton sv-skeleton-pill" style="width:76px;height:34px;"></div>
                </div>
                <div class="detail-hero sv-skeleton-card">
                    <div class="sv-skeleton sv-skeleton-line" style="width:220px;height:28px;"></div>
                    <div class="sv-skeleton sv-skeleton-line" style="width:310px;max-width:72%;"></div>
                </div>
                <div class="analytics-skel-platform">
                    <div class="analytics-skel-platform-head"><div class="sv-skeleton sv-skeleton-line" style="width:126px;"></div><div class="sv-skeleton sv-skeleton-pill" style="width:88px;height:26px;"></div></div>
                    <div class="analytics-skel-metrics">
                        <div class="analytics-skel-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58%;"></div><div class="sv-skeleton sv-skeleton-line" style="width:82%;height:24px;"></div></div>
                        <div class="analytics-skel-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58%;"></div><div class="sv-skeleton sv-skeleton-line" style="width:82%;height:24px;"></div></div>
                        <div class="analytics-skel-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58%;"></div><div class="sv-skeleton sv-skeleton-line" style="width:82%;height:24px;"></div></div>
                        <div class="analytics-skel-metric"><div class="sv-skeleton sv-skeleton-line" style="width:58%;"></div><div class="sv-skeleton sv-skeleton-line" style="width:82%;height:24px;"></div></div>
                    </div>
                </div>
            </div>
