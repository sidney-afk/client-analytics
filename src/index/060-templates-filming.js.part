    function _tplRenderColorSetsView(name, hlOff) {
        const sets = _tplGetColorSets(name).filter(s => s.title || s.highlight);
        if (!sets.length) {
            return `<div class="tpl-view-field">
                <div class="tpl-view-label">Color sets</div>
                <div class="tpl-view-value">${_NOT_SET}</div>
            </div>`;
        }
        const cards = sets.map((s, i) => {
            const titleHex = /^#[0-9a-fA-F]{6}$/.test(s.title);
            const hlHex = /^#[0-9a-fA-F]{6}$/.test(s.highlight);
            const titleSwatch = titleHex
                ? `<span class="tpl-view-swatch tpl-view-swatch-sm" style="background:${_tplEsc(s.title)}"></span>`
                : `<span class="tpl-view-swatch tpl-view-swatch-sm tpl-view-swatch-empty"></span>`;
            const hlSwatch = (!hlOff && s.highlight)
                ? (hlHex
                    ? `<span class="tpl-view-swatch tpl-view-swatch-sm" style="background:${_tplEsc(s.highlight)}"></span>`
                    : `<span class="tpl-view-swatch tpl-view-swatch-sm tpl-view-swatch-empty"></span>`)
                : '';
            const titleHexLabel = s.title ? _tplEsc(s.title.toUpperCase()) : '—';
            const hlHexLabel = (!hlOff && s.highlight) ? ` · ${_tplEsc(s.highlight.toUpperCase())}` : '';
            return `<div class="tpl-color-set-card">
                <span class="tpl-set-num">${i + 1}</span>
                <span class="tpl-set-swatches">${titleSwatch}${hlSwatch}</span>
                <span class="tpl-set-hex">${titleHexLabel}${hlHexLabel}</span>
            </div>`;
        }).join('');
        return `<div class="tpl-view-field tpl-view-color-sets-field">
            <div class="tpl-view-label">Color sets</div>
            <div class="tpl-color-sets-view">${cards}</div>
        </div>`;
    }

    /* ── Multiple links per link field (client photos, thumbnail, reference reel)
       ─────────────────────────────────────────────────────────────────────
       Same additive pattern as the thumbnails color sets above, and the SAME
       add/remove UX ("+ Add link" button, per-row remove). The full list lives
       in a new sibling JSON column `<field>_list`, while the legacy single
       `<field>` column stays populated with the FIRST link so anything still
       reading that Sheet cell — an external consumer, an old row, or an
       unflagged n8n client — keeps working untouched. On read, a legacy single
       value with no `_list` yet renders as a one-item list. Saving rides the
       existing _tplQueueSave → _tplFlush path (both the n8n Sheet webhook and
       the templates-save Edge Function accept arbitrary string patch keys), so
       no endpoint or Edge Function change is needed. */
    const TPL_MAX_LINKS = 8;
    function _tplGetLinks(name, field) {
        const raw = _tplGet(name, field + '_list');
        if (raw && typeof raw === 'string') {
            try {
                const arr = JSON.parse(raw);
                if (Array.isArray(arr) && arr.length) {
                    return arr.map(v => String(v == null ? '' : v));
                }
            } catch {}
        }
        // Migration: fall back to the legacy single-link column when no JSON yet.
        const single = _tplGet(name, field);
        if (single) return [String(single)];
        return [''];
    }
    function _tplSaveLinks(name, field, links) {
        const cleaned = (links && links.length ? links : [''])
            .map(v => String(v == null ? '' : v));
        // Persist the full list in the new sibling column…
        _tplQueueSave(name, field + '_list', JSON.stringify(cleaned), false);
        // …and mirror the FIRST link into the legacy single column so external
        // consumers / old readers / unflagged n8n clients keep working.
        _tplQueueSave(name, field, cleaned[0] || '', false);
    }
    function _tplAddLink(name, field) {
        const links = _tplGetLinks(name, field);
        if (links.length >= TPL_MAX_LINKS) return;
        links.push('');
        _tplSaveLinks(name, field, links);
        if (_templatesSelected === name) {
            const content = document.getElementById('content');
            if (content) { content.innerHTML = renderClientTemplate(name); mountTemplatesView(); }
        }
    }
    function _tplRemoveLink(name, field, index) {
        const links = _tplGetLinks(name, field);
        if (index < 0 || index >= links.length) return;
        links.splice(index, 1);
        if (links.length === 0) links.push('');
        _tplSaveLinks(name, field, links);
        if (_templatesSelected === name) {
            const content = document.getElementById('content');
            if (content) { content.innerHTML = renderClientTemplate(name); mountTemplatesView(); }
        }
    }
    const _TPL_LINK_ICON = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M9.5 2.5h4v4M13.5 2.5L7 9M11 8.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    function _tplRenderLinksEdit(name, field, label, placeholder) {
        const links = _tplGetLinks(name, field);
        const rows = links.map((v, i) => {
            const isUrl = /^https?:\/\//i.test(v);
            const removeBtn = links.length > 1
                ? `<button class="tpl-set-remove" onclick="_tplRemoveLink(${_jsAttrArg(name)}, '${field}', ${i})" title="Remove this link"><svg width="11" height="11" viewBox="0 0 12 12" fill="none"><line x1="2.5" y1="2.5" x2="9.5" y2="9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9.5" y1="2.5" x2="2.5" y2="9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>`
                : '';
            return `<div class="tpl-link-set-row" data-tpl-link-index="${i}">
                <div class="tpl-link-row">
                    <input class="tpl-input" type="url" data-tpl-link-set="${i}"
                           value="${_tplEsc(v)}" placeholder="${_tplEsc(placeholder || 'https://…')}" />
                    <a class="tpl-link-open${isUrl ? '' : ' disabled'}" href="${isUrl ? _tplEsc(v) : '#'}" target="_blank" rel="noopener" title="Open link" data-tpl-link-open="${i}">${_TPL_LINK_ICON}</a>
                </div>
                ${removeBtn}
            </div>`;
        }).join('');
        const canAddMore = links.length < TPL_MAX_LINKS;
        const addBtn = canAddMore
            ? `<button class="tpl-set-add" onclick="_tplAddLink(${_jsAttrArg(name)}, '${field}')"><svg width="11" height="11" viewBox="0 0 12 12" fill="none"><line x1="6" y1="2.5" x2="6" y2="9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="2.5" y1="6" x2="9.5" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg> Add link</button>`
            : `<div class="tpl-set-add-max">Max ${TPL_MAX_LINKS} links</div>`;
        return `<div class="tpl-field"><label class="tpl-field-label">${label}</label>
            <div class="tpl-links-edit" data-tpl-links data-tpl-client="${_tplEsc(name)}" data-tpl-link-field="${field}">
                ${rows}
                ${addBtn}
            </div></div>`;
    }
    function _tplRenderLinksView(name, field, label, openLabel) {
        const links = _tplGetLinks(name, field).filter(v => /^https?:\/\//i.test(v));
        if (!links.length) {
            return `<div class="tpl-view-field">
                <div class="tpl-view-label">${label}</div>
                <div class="tpl-view-value">${_NOT_SET}</div>
            </div>`;
        }
        const items = links.map(v => {
            let host = '';
            try { host = new URL(v).hostname.replace(/^www\./, ''); } catch {}
            return `<a class="tpl-view-link" href="${_tplEsc(v)}" target="_blank" rel="noopener">
                ${openLabel || 'Open'}
                ${host ? `<span class="tpl-view-link-host">${_tplEsc(host)}</span>` : ''}
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none"><path d="M9.5 2.5h4v4M13.5 2.5L7 9M11 8.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>`;
        }).join('');
        return `<div class="tpl-view-field">
            <div class="tpl-view-label">${label}</div>
            <div class="tpl-view-value tpl-view-links">${items}</div>
        </div>`;
    }

    /* ── View renderers ─────────────────────────────────────────────────── */
    /* ============================================================
       ONBOARDING VIEWER  (Templates tab → "Onboarding" sub-tab)
       Lists submissions from the centralized onboarding form and shows the
       editor/designer-relevant sections of each. Reads admin-key-gated Edge
       Functions which strip account credentials before returning list data.
       Namespaced _obv* / OBV_*. Inline handlers are global (matches the
       templates tab's _tpl* pattern).
       ============================================================ */
    // Onboarding reads go through admin-key-gated Supabase Edge Functions
    // (service-role, credential-stripped).
    // instead of n8n. Hardcoded base (CAL_SUPABASE_URL is declared later in the file → TDZ if referenced here).
    const ONBOARDING_EDGE_BASE = 'https://uzltbbrjidmjwwfakwve.supabase.co/functions/v1';
    const ONBOARDING_LIST_URL = ONBOARDING_EDGE_BASE + '/onboarding-list';
    const AI_ONBOARDING_LIST_URL = ONBOARDING_EDGE_BASE + '/ai-onboarding-list';
    const LEGACY_ONBOARDING_LIST_URL = ONBOARDING_EDGE_BASE + '/legacy-onboarding-list';
    const ONBOARDING_FULL_URL = ONBOARDING_EDGE_BASE + '/onboarding-full';  // Kasper-only (X-Syncview-Key)
    let _tplTab = 'templates';            // onboarding is no longer a Templates sub-tab (moved to Kasper)
    let _obvSubs = null, _obvLoading = false, _obvError = '', _obvWarn = '', _obvSelected = null, _obvLoadedAt = 0, _obvQuery = '';
    let _obvMode = 'edge';                 // 'edge' = credential-stripped list fns; 'full' = Kasper (onboarding-full)
    let _obvSlugSet = null, _obvSlugLoading = false;  // slugs that have any onboarding record (client-profile button)

    const OBV_GENRE = { inspirational:'Inspirational', ambient:'Ambient / Cinematic', lofi:'Lofi / Chill', piano:'Emotional Piano', guitar:'Acoustic Guitar', synth:'Synth', spiritual:'Spiritual', classical:'Classical', trending:'Trending / TikTok' };
    const OBV_SUB = { elegant:'Elegant', native:'Native', bold:'Bold', banner:'Banner', boxed:'Boxed banner', minimal:'Minimal', none:'No subtitles' };
    const OBV_BROLL = { stock:'Stock footage', ai:'AI-generated', mix:'Mix of both', own:'My own footage', none:'No B-roll' };
    const OBV_FRAMING = { closeup:'Close-up', mid:'Mid-shot', wide:'Wide', mixed:'Mixed' };
    const OBV_CLOTHING = { formal:'Formal / suit', smart_casual:'Smart casual', casual:'Casual', streetwear:'Streetwear', athletic:'Activewear', branded:'Branded merch', elegant:'Elegant' };
    const OBV_PODCAST = { studio:'Studio desk with mics', lounge:'Casual lounge', office:'Office / bookshelf', minimal:'Plain backdrop' };
    // Thumbnail picker → the live render the client landed on (thumbnail-styles/<font>-<style>[-hl].jpg).
    // Mirrors _obThumbImg / OB_THUMB_FONTS / OB_THUMB_TSTYLES in the onboarding form module.
    const OBV_TF = 'thumbnail-styles/';
    const OBV_THUMB_FONT = { bold:'Bold', native:'Native', elegant:'Elegant' };
    const OBV_THUMB_TSTYLE = { plain:'Plain', shadow:'Shadow', stroke:'Stroke', banner:'Banner' };
    // Only current subtitle choices have an approved video preview. Older submissions can
    // still use the text label below without being assigned a misleading sample.
    const OBV_SUB_PREVIEW = {
      elegant: ['onboarding-video/sub-elegant.mp4', 'onboarding-video/sub-elegant-hl.mp4'],
      native: ['onboarding-video/sub-native.mp4', 'onboarding-video/sub-native-hl.mp4'],
      bold: ['onboarding-video/sub-bold.mp4', 'onboarding-video/sub-bold-hl.mp4'],
    };

    function _obvEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    // Re-render whichever surface currently hosts the onboarding inbox (the Kasper
    // tab) or the standalone per-client viewer. (It used to live under Templates.)
    function _obvRerender(){
      if (typeof _kasperState !== 'undefined' && _kasperState && _kasperState.tab === 'onboarding' && document.getElementById('kasperContent')) {
        _kasperRenderOnboarding();
        try{ if(document.getElementById('obvSearchInput')) setTimeout(_obvFilter, 0); }catch(e){}
        return;
      }
      if (document.getElementById('obvStandaloneWrap')) { _obvRenderStandalone(); return; }
    }
    function _obvOpen(id){ _obvSelected = id; _obvRerender(); }
    function _obvBack(){ _obvSelected = null; _obvRerender(); }
    function _obvRefresh(){ _obvSubs = null; _obvSelected = null; _obvRerender(); _obvEnsureLoaded(true); }

    // Slug index: which clients have ANY onboarding record, so a client's template
    // profile can show/hide its "Onboarding" button. Uses the credential-stripped
    // list functions, after the same verified admin staff sign-in as the inbox.
    async function _obvFetchLists(retried){
      const ident = await _syncviewRequireStaffIdentity('onboarding');
      const pull = async (url, funnel) => {
        const r = await fetch(url + '?_t=' + Date.now(), { method:'GET', headers: { 'X-Syncview-Key': ident.key } });
        if (!r.ok) { const e = new Error(r.status === 403 ? 'Admin, SMM, or Creative access required.' : ('HTTP '+r.status)); e.status = r.status; throw e; }
        const txt = await r.text();
        let d=null; if(txt && txt.trim()){ try{ d=JSON.parse(txt); }catch(e){ d=null; } }
        const arr = Array.isArray(d) ? d : ((d && d.submissions) || []);
        arr.forEach(s=>{ s.funnel = funnel; });
        return arr;
      };
      const settled = await Promise.allSettled([
        pull(ONBOARDING_LIST_URL, 'standard'),
        pull(AI_ONBOARDING_LIST_URL, 'ai'),
        pull(LEGACY_ONBOARDING_LIST_URL, 'legacy')
      ]);
      const active = _syncviewStaffIdentityForHeaders();
      if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) throw new Error('Staff sign-in changed.');
      if (settled.some(item => item.status === 'rejected' && item.reason && item.reason.status === 401)) {
        _syncviewStaffIdentityClear();
        if (retried) throw new Error('Staff sign-in expired.');
        const replacement = await _syncviewOpenStaffIdentity({ reason: 'expired' });
        if (!replacement) throw new Error('Staff sign-in required.');
        return _obvFetchLists(true);
      }
      return settled;
    }
    function _obvEnsureSlugIndex(){
      if (_obvSlugSet || _obvSlugLoading) return;
      _obvSlugLoading = true;
      _obvFetchLists(false).then(results=>{
        const all = results.map(item => item.status === 'fulfilled' ? item.value : []);
        const set = new Set();
        all.flat().forEach(s=>{ if(s && s.slug) set.add(s.slug); });
        _obvSlugSet = set;
        // Re-render the open client profile so the button appears now that we know.
        try {
          if (_templatesSelected && !_obvSelected && document.getElementById('content')) {
            document.getElementById('content').innerHTML = renderClientTemplate(_templatesSelected);
            if (typeof mountTemplatesView === 'function') mountTemplatesView();
          }
        } catch(e){}
      }).catch(()=>{ _obvSlugSet = new Set(); })
        .finally(()=>{ _obvSlugLoading = false; });
    }
    function _obvHasOnboarding(name){
        if (!_obvSlugSet) return false;
        const slug = wlNormalizeClient(name);
        if (!slug) return false;
        if (_obvSlugSet.has(slug)) return true;
        // A brand/project client name has no natural first/last split, so a
        // submitter sometimes puts the same name in both onboarding-form
        // fields, which doubles the generated slug. Recognize that shape
        // too rather than losing the match.
        return _obvSlugSet.has(slug + slug);
    }
    function _obvOpenStandalone(slug){ try { window.open('?onboarding_view=' + encodeURIComponent(slug), '_blank', 'noopener'); } catch(e){} }

    // Standalone per-client onboarding viewer (its own browser tab, ?onboarding_view=<slug>).
    // Read-only, credential-free, no contact info. The isolated tab still
    // requires a verified admin staff identity before any list request.
    let _obvStandaloneSlug = null;
    function _obvMountStandalone(slug){
      _obvStandaloneSlug = String(slug||'');
      _obvMode = 'edge';
      const content = document.getElementById('content');
      if (content) { _obvInjectStyles(); content.innerHTML = `<div id="obvStandaloneWrap" class="obv-standalone"></div>`; _obvRenderStandalone(); }
      _syncviewStaffIdentityBoot().then(()=>_obvEnsureLoaded(), ()=>_obvEnsureLoaded());
    }
    function _obvRenderStandalone(){
      const wrap = document.getElementById('obvStandaloneWrap'); if(!wrap) return;
      if (_obvSubs === null) { wrap.innerHTML = _svLoadingSkeletonHtml('onboarding'); return; }
      const sub = (_obvSubs||[]).find(s => (s.slug||'') === _obvStandaloneSlug);
      if (!sub) { wrap.innerHTML = `<div class="obv-empty">No onboarding form on file for this client.</div>`; return; }
      wrap.innerHTML = _obvDetail(sub, { contact:false, creds:false }).replace(/<button class="obv-back"[\s\S]*?<\/button>/, '');
    }

    function _obvEnsureLoaded(force){
      if (_obvLoading) return;
      if (_obvSubs && !force) return;
      _obvLoading = true; _obvError = ''; _obvWarn = '';
      if (_obvMode === 'full') { _obvLoadFull(); return; }
      // Three sources = three admin-key-gated Edge Functions (standard + AI + legacy), all credential-stripped.
      // Pull all, tag each row with its funnel, merge. Partial failure still shows what loaded.
      // Read as text first: an empty table yields a 200 with an empty body → read as "no submissions".
      _obvFetchLists(false)
        .then(([std, ai, legacy])=>{
          const ok = []; const failed = [];
          if (std.status==='fulfilled') ok.push(...std.value); else failed.push('standard ('+(std.reason&&std.reason.message||'failed')+')');
          if (ai.status==='fulfilled')  ok.push(...ai.value);  else failed.push('AI ('+(ai.reason&&ai.reason.message||'failed')+')');
          if (legacy.status==='fulfilled') ok.push(...legacy.value); else failed.push('Old forms ('+(legacy.reason&&legacy.reason.message||'failed')+')');
          _obvSubs = ok;
          _obvError = (ok.length===0 && failed.length) ? failed.join('; ') : '';
          _obvWarn  = (ok.length>0  && failed.length) ? ('Couldn\'t load the ' + failed.join(' and ') + ' list.') : '';
          _obvLoadedAt = Date.now();
        })
        .catch(e=>{ _obvSubs = []; _obvError = (e && e.message) || 'Staff sign-in required.'; })
        .finally(()=>{
          _obvLoading = false;
          _obvRerender();
          if (typeof _kasperRefreshTabCounts === 'function') _kasperRefreshTabCounts();
        });
    }

    // Admin full view: one gated call (onboarding-full) returns all three sources
    // UN-stripped — names, emails, phones, and the account credentials.
    // The request reuses the verified role identity; there is no second passphrase.
    async function _obvLoadFull(){
      try {
        const res = await _obvFetchFull(false);
        _obvSubs = res.submissions; _obvError = res.error || ''; _obvWarn = res.warn || '';
      } catch (e) {
        _obvSubs = []; _obvError = (e && e.message) || 'failed';
      } finally {
        _obvLoadedAt = Date.now(); _obvLoading = false; _obvRerender();
        if (typeof _kasperRefreshTabCounts === 'function') _kasperRefreshTabCounts();
      }
    }
    async function _obvFetchFull(retried){
      const ident = await _syncviewRequireStaffIdentity('onboarding');
      const r = await fetch(ONBOARDING_FULL_URL + '?_t=' + Date.now(), { method:'GET', headers: { 'X-Syncview-Key': ident.key } });
      if (r.status === 401) {
        const active = _syncviewStaffIdentityForHeaders();
        if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) {
          return { submissions: [], error: 'Staff sign-in changed.' };
        }
        _syncviewStaffIdentityClear();
        if (retried) return { submissions: [], error: 'Staff sign-in expired.' };
        const replacement = await _syncviewOpenStaffIdentity({ reason: 'expired' });
        if (!replacement) return { submissions: [], error: 'Staff sign-in required.' };
        return _obvFetchFull(true);
      }
      if (r.status === 403) return { submissions: [], error: 'Admin access required.' };
      if (!r.ok) return { submissions: [], error: 'HTTP ' + r.status };
      const d = await r.json();
      const active = _syncviewStaffIdentityForHeaders();
      if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) return { submissions: [], error: 'Staff sign-in changed.' };
      return { submissions: (d && d.submissions) || [], warn: (d && d.warnings && d.warnings.length) ? d.warnings.join('; ') : '' };
    }

    function _obvToggle(){
      return `<div class="obv-toggle">
        <button class="obv-tab ${_tplTab==='templates'?'active':''}" onclick="_obvSetTab('templates')">Templates</button>
        <button class="obv-tab ${_tplTab==='onboarding'?'active':''}" onclick="_obvSetTab('onboarding')">Onboarding</button>
      </div>`;
    }

    function renderOnboardingInbox(){
      _obvInjectStyles();
      const top = `<div class="obv-wrap"><div class="obv-head"><div class="obv-inbox-title">Onboarding</div><button class="obv-refresh" onclick="_obvRefresh()" title="Refresh">↻</button></div>`;
      if (_obvSelected){
        const sub = (_obvSubs||[]).find(s=>s.id===_obvSelected);
        return top + (sub ? _obvDetail(sub, { contact:true, creds: _obvMode==='full' }) : `<div class="obv-empty">Submission not found.</div>`) + `</div>`;
      }
      let body;
      if (_obvSubs === null) body = _svLoadingSkeletonHtml('onboarding');
      else if (_obvError && !_obvSubs.length) body = `<div class="obv-empty">Couldn't load submissions (${_obvEsc(_obvError)}).<br><small>The current onboarding reader failed. Keep the access boundary in place and ask the SyncView operator to investigate.</small></div>`;
      else if (!_obvSubs.length) body = `<div class="obv-empty">No onboarding submissions yet.</div>`;
      else {
        // Three sections: Standard = client_onboarding; AI = ai_client_onboarding;
        // Old forms = legacy_onboarding (historical Notion intake, rendered as-is).
        const warn = _obvWarn ? `<div class="obv-warn">${_obvEsc(_obvWarn)}</div>` : '';
        const std = _obvSubs.filter(s=>s.funnel!=='ai' && s.funnel!=='legacy');
        const aiSubs = _obvSubs.filter(s=>s.funnel==='ai');
        const legacy = _obvSubs.filter(s=>s.funnel==='legacy').sort((a,b)=>(((a.first_name||'')+' '+(a.last_name||'')).trim().toLowerCase()).localeCompare(((b.first_name||'')+' '+(b.last_name||'')).trim().toLowerCase()));
        const group = (label, arr) => `<div class="obv-group" data-obv-group><div class="obv-group-h">${label}<span class="obv-group-n" data-obv-count="${arr.length}">${arr.length}</span></div>`
          + (arr.length ? `<div class="obv-list">${arr.map(_obvCard).join('')}</div>` : `<div class="obv-group-empty">None yet.</div>`)
          + `<div class="obv-group-nomatch" style="display:none;">No matches in this section.</div></div>`;
        const search = `<div class="obv-search"><div class="search-bar-pill">`
          + `<input class="search-bar-input" id="obvSearchInput" type="text" placeholder="Search onboarding…" oninput="_obvFilter()" onkeydown="if(event.key==='Escape'){this.value='';_obvFilter();this.blur();}" autocomplete="off" value="${_obvEsc(_obvQuery||'')}">`
          + `<button class="search-bar-icon" onclick="var i=document.getElementById('obvSearchInput'); if(i) i.focus();" title="Search"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>`
          + `</div></div>`;
        body = warn + search + `<div id="obvNoMatch" class="obv-empty" style="display:none;">No clients match your search.</div>`
          + group('Standard onboarding', std) + group('AI avatar onboarding', aiSubs) + group('Old forms', legacy);
      }
      return top + body + `</div>`;
    }

    // Filter the inbox in place (no re-render, so the search box keeps focus).
    function _obvFilter(){
      const inp = document.getElementById('obvSearchInput');
      _obvQuery = inp ? inp.value : '';
      const q = _obvQuery.trim().toLowerCase();
      let anyVisible = false;
      document.querySelectorAll('[data-obv-group]').forEach(g=>{
        const cards = g.querySelectorAll('.obv-card');
        let vis = 0;
        cards.forEach(c=>{ const m = !q || (c.getAttribute('data-obv-search')||'').indexOf(q)!==-1; c.style.display = m ? '' : 'none'; if(m) vis++; });
        if(vis) anyVisible = true;
        const badge = g.querySelector('.obv-group-n');
        if(badge){ badge.textContent = q ? String(vis) : (badge.getAttribute('data-obv-count')||String(vis)); }
        const nomatch = g.querySelector('.obv-group-nomatch');
        if(nomatch) nomatch.style.display = (q && cards.length>0 && vis===0) ? '' : 'none';
        const emptyPh = g.querySelector('.obv-group-empty');
        if(emptyPh) emptyPh.style.display = q ? 'none' : '';
      });
      const nm = document.getElementById('obvNoMatch');
      if(nm) nm.style.display = (q && !anyVisible) ? '' : 'none';
    }

    function _obvFmtDate(iso){ if(!iso) return ''; const d = new Date(iso); if (isNaN(d)) return ''; return d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}); }

    function _obvCard(s){
      const name = ((s.first_name||'')+' '+(s.last_name||'')).trim() || s.email || 'Untitled';
      const ai = (s.ai_avatar==='yes' && s.funnel!=='ai') ? `<span class="obv-badge">AI avatar</span>` : '';
      const _q = _obvEsc((name+' '+(s.email||'')+' '+(s.slug||'')).toLowerCase());
      return `<button class="obv-card" data-obv-search="${_q}" onclick="_obvOpen('${_obvEsc(s.id)}')">
        <div class="obv-card-main"><div class="obv-card-name">${_obvEsc(name)}</div>
        <div class="obv-card-sub">${_obvEsc(s.email||'')}</div></div>
        <div class="obv-card-meta">${ai}<span class="obv-card-date">${_obvEsc(_obvFmtDate(s.created_at))}</span></div>
      </button>`;
    }

    // value helpers for the detail view
    function _obvText(a,k){ const v=a[k]; return (v==null||v==='')?'':String(v); }
    function _obvLink(v){ if(!v) return ''; const u=String(v); const safe=_obvEsc(u); const href = /^https?:\/\//i.test(u) ? safe : ('https://'+safe); return `<a href="${href}" target="_blank" rel="noopener">${safe}</a>`; }
    function _obvRow(label, valueHtml){ if(!valueHtml) return ''; return `<div class="obv-row"><div class="obv-row-l">${_obvEsc(label)}</div><div class="obv-row-v">${valueHtml}</div></div>`; }
    function _obvList(arr, map){ if(!Array.isArray(arr)||!arr.length) return ''; return _obvEsc(arr.map(x=>(map&&map[x])||x).join(', ')); }
    // Reference fields are free-text textareas where clients paste links (often several, with
    // notes). Preserve line breaks and turn any URLs into clickable links.
    function _obvLinkify(v){ if(v==null||v==='') return ''; return _obvEsc(String(v)).replace(/\n/g,'<br>').replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" rel="noopener">$1</a>'); }
    // The exact thumbnail render the client built (or a note if they asked us to design it).
    function _obvThumb(a){
      // thumbnail_build toggle off => client opted out of building their own look.
      if (a.thumbnail_build === false || a.thumbnail_build === 'false') return '<span class="obv-muted">Wants us to design the thumbnail look.</span>';
      const font = a.thumbnail_font, style = a.thumbnail_text_style;
      if (!font || !style) return '';
      const hl = (a.thumbnail_highlight === true || a.thumbnail_highlight === 'true');
      const src = OBV_TF + font + '-' + style + (hl ? '-hl' : '') + '.jpg';
      const label = (OBV_THUMB_FONT[font]||font) + ' · ' + (OBV_THUMB_TSTYLE[style]||style) + (hl ? ' · Highlight' : '');
      return '<a class="obv-thumb" href="'+_obvEsc(src)+'" target="_blank" rel="noopener" title="Open full size">'
        + '<img src="'+_obvEsc(src)+'" alt="'+_obvEsc(label)+'" loading="lazy">'
        + '<span class="obv-thumb-cap">'+_obvEsc(label)+'</span></a>';
    }

    // Legacy (old Notion form) detail — no schema mapping; the original
    // question -> answer list is shown verbatim (credentials already stripped).
    // Login/credential keys inside `answers` (standard/AI funnels). Never returned by
    // the staff-gated list functions; only Kasper's onboarding-full view carries them.
    const OBV_CRED_KEYS = [['instagram','Instagram'],['instagram_backup','Instagram backup code'],['tiktok','TikTok'],['facebook','Facebook'],['linkedin','LinkedIn'],['youtube','YouTube']];
    function _obvCredSection(s){
      let rows='';
      if (s.funnel==='legacy'){
        (Array.isArray(s.credentials)?s.credentials:[]).forEach(c=>{ if(c && c.value) rows += _obvRow(c.label, _obvLinkify(c.value)); });
      } else {
        const a = s.answers || {};
        OBV_CRED_KEYS.forEach(([k,lbl])=>{ const v=_obvText(a,k); if(v) rows += _obvRow(lbl, _obvEsc(v)); });
      }
      if(!rows) return '';
      return `<div class="obv-sec obv-sec-cred"><div class="obv-sec-t">Account access <span class="obv-cred-warn">sensitive</span></div>${rows}</div>`;
    }

    // Show the exact subtitle clip the client chose. This is deliberately separate from
    // thumbnail_font/text_style: those fields describe the thumbnail, not subtitles.
    // The compact viewer tile opens the same contained player used by the public onboarding
    // form. It must not expose a native inline fullscreen control: that retains the tile's
    // `object-fit: cover` rule and crops a portrait preview across a landscape screen.
    function _obvOpenPreview(button){
      const src = button && button.getAttribute('data-obv-preview');
      if(src) _obZoom(src);
    }
    function _obvSubtitle(a){
      const raw = _obvText(a, 'subtitle_style').trim();
      if (!raw) return '';
      const key = raw.toLowerCase();
      const highlighted = (a.subtitle_highlight === true || a.subtitle_highlight === 'true' || a.highlight_keywords);
      const label = (OBV_SUB[key] || raw) + (highlighted ? ' · highlighted keywords' : '');
      const media = OBV_SUB_PREVIEW[key];
      // Legacy/unsupported choices remain truthful text instead of an unrelated preview.
      if (!media) return _obvEsc(label);
      const src = media[highlighted ? 1 : 0];
      return '<button type="button" class="obv-sub-preview" data-obv-preview="'+_obvEsc(src)+'" onclick="_obvOpenPreview(this)" aria-label="Play '+_obvEsc(label)+' subtitle preview">'
        + '<video src="'+_obvEsc(src)+'" muted loop playsinline preload="metadata" aria-hidden="true"></video>'
        + '<span class="obv-thumb-cap">'+_obvEsc(label)+'</span></button>';
    }

    function _obvLegacyDetail(s, opts){
      opts = opts || {}; const contact = opts.contact !== false; const creds = !!opts.creds;
      const name = ((s.first_name||'')+' '+(s.last_name||'')).trim() || (contact ? s.email : '') || 'Submission';
      const meta = [ contact && s.email ? _obvEsc(s.email) : '', contact && s.phone ? _obvEsc(s.phone) : '', s.submitted_on ? _obvEsc(s.submitted_on) : _obvFmtDate(s.created_at) ].filter(Boolean).join(' · ');
      const rows = (Array.isArray(s.fields)?s.fields:[]).map(f => _obvRow(f.label, _obvLinkify(f.value))).join('');
      const inner = rows || `<div class="obv-row"><div class="obv-row-v obv-muted">No responses recorded.</div></div>`;
      return `<div class="obv-detail">
        <button class="obv-back" onclick="_obvBack()">← All submissions</button>
        <div class="obv-detail-head"><div class="obv-detail-name">${_obvEsc(name)}<span class="obv-legacy-tag">Old form</span></div>
          <div class="obv-detail-meta">${meta}</div>
          <div class="obv-legacy-note">Imported from the old Notion onboarding form — shown exactly as it was answered.${creds ? '' : ' Account logins are hidden here.'}</div></div>
        <div class="obv-sec"><div class="obv-sec-t">Onboarding responses</div>${inner}</div>
        ${creds ? _obvCredSection(s) : ''}
      </div>`;
    }

    function _obvDetail(s, opts){
      opts = opts || {}; const contact = opts.contact !== false; const creds = !!opts.creds;
      if (s.funnel==='legacy' || (Array.isArray(s.fields) && !s.answers)) return _obvLegacyDetail(s, opts);
      const a = s.answers || {};
      const name = ((s.first_name||'')+' '+(s.last_name||'')).trim() || s.email || 'Submission';
      // creators
      let creators='';
      const crList = Array.isArray(a.creators) ? a.creators : [];
      crList.forEach(c=>{ if(!c) return; const note=c.model||c.copy; if(c.link||note) creators += `<div class="obv-creator">${_obvLink(c.link)}${note?(' — '+_obvEsc(note)):''}</div>`; });
      if(!creators){ for(let i=1;i<=5;i++){ const link=a['creator'+i+'_link'], copy=a['creator'+i+'_copy']; if(link||copy){ creators += `<div class="obv-creator">${_obvLink(link)}${copy?(' — '+_obvEsc(copy)):''}</div>`; } } }

      const brand = [
        _obvRow('Brand guidelines', _obvLink(_obvText(a,'brand_guidelines'))),
        _obvRow('Ideal customer', _obvEsc(_obvText(a,'ideal_customer'))),
        _obvRow('Pain points', _obvEsc(_obvText(a,'pain_points'))),
        _obvRow('Desired outcomes', _obvEsc(_obvText(a,'desired_outcomes'))),
        _obvRow('Process', _obvEsc(_obvText(a,'process'))),
      ].join('');

      const style = [
        creators ? _obvRow('Creators to model', creators) : '',
        // legacy field from the earlier form version — kept so old submissions still render.
        _obvRow('Clips they like', (Array.isArray(a.clips)&&a.clips.length) ? a.clips.map(c=>_obvLink(c&&c.link)).filter(Boolean).join('<br>') : _obvLink(_obvText(a,'clips_you_like'))),
        _obvRow('Subtitles', _obvSubtitle(a)),
        _obvRow('B-roll', _obvList(a.broll, OBV_BROLL)),
        _obvRow('Music genres', _obvList(a.music, OBV_GENRE)),
        _obvRow('Music reference', _obvLink(_obvText(a,'music_refs'))),
        _obvRow('Video reference', _obvLinkify(_obvText(a,'video_reference'))),
        _obvRow('Video look wanted', _obvEsc(_obvText(a,'video_reference_desc'))),
        _obvRow('Thumbnail style', _obvThumb(a)),
        _obvRow('Thumbnail reference', _obvLinkify(_obvText(a,'thumbnail_reference'))),
        _obvRow('Thumbnail look wanted', _obvEsc(_obvText(a,'thumbnail_reference_desc'))),
        // legacy fields (older form) — render only if present on old submissions.
        _obvRow('Colours', _obvEsc(_obvText(a,'color_prefs'))),
        _obvRow('Text / fonts', _obvEsc(_obvText(a,'text_prefs'))),
        _obvRow('Overall feel', _obvEsc(_obvText(a,'overall_approach'))),
        _obvRow('Brand tone', _obvEsc(_obvText(a,'brand_tone'))),
        _obvRow('Always / never', _obvEsc(_obvText(a,'dos_donts'))),
        _obvRow('Sample clip', _obvLink(_obvText(a,'sample_clip'))),
      ].join('');

      const assets = [
        _obvRow('Photos', _obvLink(_obvText(a,'photos_link'))),
        _obvRow('Source material', _obvLink(_obvText(a,'source_material'))),
      ].join('');

      const goals = [
        _obvRow('Success looks like', _obvEsc(_obvText(a,'success'))),
        _obvRow('Anything else', _obvEsc(_obvText(a,'anything_else'))),
        _obvRow('Questions / unclear', _obvEsc(_obvText(a,'questions'))),
      ].join('');

      let ai='';
      if (s.ai_avatar==='yes'){
        const likeness = a.ai_use_existing==='yes' ? 'Use the clip/photos shared above' : (_obvLink(_obvText(a,'ai_new_likeness')) || '');
        ai = [
          _obvRow('Build from', likeness),
          _obvRow('Personality', _obvEsc(_obvText(a,'ai_personality'))),
          _obvRow('Look', _obvList(a.ai_content_style, {talking_head:'Talking to camera',podcast:'Podcast style'})),
          _obvRow('Text-only videos', a.ai_text_driven?_obvEsc(a.ai_text_driven==='yes'?'Yes':'No'):''),
          _obvRow('Setting', _obvEsc(_obvText(a,'ai_setting'))),
          _obvRow('Podcast setting', _obvEsc(OBV_PODCAST[a.ai_podcast_setting]||_obvText(a,'ai_podcast_setting'))),
          _obvRow('Framing', _obvEsc(OBV_FRAMING[a.ai_framing]||_obvText(a,'ai_framing'))),
          _obvRow('Accessories', _obvList((a.ai_accessories||[]).map(x=>x==='other'?(a.ai_accessories_other||'Other'):x))),
          _obvRow('Hair', _obvEsc(_obvText(a,'ai_hair'))),
          _obvRow('Makeup', _obvEsc(_obvText(a,'ai_makeup'))),
          _obvRow('Clothing', _obvList(a.ai_clothing, OBV_CLOTHING)),
          _obvRow('Voice recording', _obvLink(_obvText(a,'ai_voice_link'))),
          _obvRow('More voice recordings', _obvLink(_obvText(a,'ai_voice_samples'))),
        ].join('');
      }

      const sec = (title, inner) => inner ? `<div class="obv-sec"><div class="obv-sec-t">${title}</div>${inner}</div>` : '';
      const contactStr = contact ? [_obvEsc(s.email||''), _obvEsc(s.phone||a.phone||'')].filter(Boolean).join(' · ') : '';
      const metaStr = [contactStr, _obvEsc(_obvFmtDate(s.created_at))].filter(Boolean).join(' · ') + (s.ai_avatar==='yes'?' · <b>AI avatar</b>':'');
      return `<div class="obv-detail">
        <button class="obv-back" onclick="_obvBack()">← All submissions</button>
        <div class="obv-detail-head"><div class="obv-detail-name">${_obvEsc(name)}</div>
          <div class="obv-detail-meta">${metaStr}</div></div>
        ${sec('Brand &amp; audience', brand)}
        ${sec('Style', style)}
        ${sec('Photos &amp; source', assets)}
        ${sec('Goals', goals)}
        ${sec('AI avatar', ai)}
        ${creds ? _obvCredSection(s) : ''}
      </div>`;
    }

    function mountOnboardingInbox(){ if (_tplTab==='onboarding') _obvEnsureLoaded(); }

    function _obvInjectStyles(){
      if (document.getElementById('obvStyles')) return;
      const css = `
      .obv-wrap{ max-width:720px; margin:0 auto; padding:8px 0 60px; }
      .obv-head{ display:flex; align-items:center; gap:10px; margin-bottom:18px; }
      .obv-toggle{ display:inline-flex; background:var(--bg); border:1px solid var(--border); border-radius:11px; padding:3px; gap:2px; }
      .obv-tab{ font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:600; padding:7px 18px; border:none; border-radius:8px; cursor:pointer; color:var(--text-muted); background:transparent; transition:all 0.13s; }
      .obv-tab:hover{ color:var(--text-secondary); }
      .obv-tab.active{ background:var(--white); color:var(--text-primary); box-shadow:0 1px 2px var(--sv-shadow-rgba-0-0-0-0_06); }
      .obv-refresh{ margin-left:auto; width:32px; height:32px; border-radius:8px; border:1px solid var(--border); background:var(--white); color:var(--text-secondary); cursor:pointer; font-size:0.95rem; }
      .obv-refresh:hover{ color:var(--text-primary); border-color:var(--text-muted); }
      .obv-empty{ text-align:center; color:var(--text-muted); font-size:0.9rem; padding:50px 20px; line-height:1.6; }
      .obv-warn{ font-size:0.8rem; color:var(--text-secondary); background:var(--bg); border:1px solid var(--border); border-radius:9px; padding:9px 12px; margin-bottom:16px; }
      .obv-group{ margin-bottom:22px; }
      .obv-group:last-child{ margin-bottom:0; }
      .obv-group-h{ display:flex; align-items:center; gap:8px; font-size:0.74rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin:0 2px 9px; }
      .obv-group-n{ font-size:0.7rem; font-weight:700; color:var(--text-secondary); background:var(--bg); border:1px solid var(--border); border-radius:99px; padding:1px 8px; }
      .obv-group-empty{ font-size:0.84rem; color:var(--text-muted); padding:8px 4px 2px; }
      .obv-list{ display:flex; flex-direction:column; gap:8px; }
      .obv-card{ display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; text-align:left; background:var(--white); border:1px solid var(--border); border-radius:12px; padding:13px 16px; cursor:pointer; font-family:'Plus Jakarta Sans',sans-serif; transition:all 0.12s; }
      .obv-card:hover{ border-color:var(--text-muted); box-shadow:0 1px 3px var(--sv-shadow-rgba-0-0-0-0_06); }
      .obv-card-name{ font-size:0.92rem; font-weight:700; color:var(--text-primary); }
      .obv-card-sub{ font-size:0.78rem; color:var(--text-secondary); margin-top:1px; }
      .obv-card-meta{ display:flex; align-items:center; gap:10px; flex-shrink:0; }
      .obv-card-date{ font-size:0.76rem; color:var(--text-muted); }
      .obv-badge{ font-size:0.66rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--ig); background:var(--ig-light); border-radius:99px; padding:3px 9px; }
      .obv-detail{ }
      .obv-back{ font-family:'Plus Jakarta Sans',sans-serif; font-size:0.82rem; font-weight:600; color:var(--text-secondary); background:none; border:none; cursor:pointer; padding:2px 0; margin-bottom:14px; }
      .obv-back:hover{ color:var(--text-primary); }
      .obv-detail-head{ margin-bottom:18px; }
      .obv-detail-name{ font-size:1.35rem; font-weight:800; letter-spacing:-0.02em; }
      .obv-detail-meta{ font-size:0.82rem; color:var(--text-secondary); margin-top:3px; }
      .obv-sec{ background:var(--white); border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-bottom:12px; }
      .obv-sec-t{ font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:10px; }
      .obv-row{ display:grid; grid-template-columns:140px 1fr; gap:12px; padding:7px 0; border-top:1px solid var(--border-light); font-size:0.86rem; }
      .obv-row:first-child{ border-top:none; }
      .obv-row-l{ color:var(--text-secondary); font-weight:600; }
      .obv-row-v{ color:var(--text-primary); white-space:pre-wrap; word-break:break-word; }
      .obv-row-v a{ color:var(--ig); text-decoration:none; word-break:break-all; }
      .obv-creator{ margin-bottom:3px; }
      .obv-thumb,.obv-sub-preview{ display:inline-block; text-decoration:none; }
      .obv-sub-preview{ padding:0; border:0; background:transparent; color:inherit; font:inherit; text-align:left; cursor:pointer; }
      .obv-thumb img,.obv-sub-preview video{ display:block; width:150px; max-width:55%; aspect-ratio:9/16; object-fit:cover; border-radius:10px; border:1px solid var(--border); background:var(--bg); }
      .obv-sub-preview video{ pointer-events:none; }
      .obv-thumb:hover img,.obv-sub-preview:hover video{ border-color:var(--text-muted); }
      .obv-sub-preview:focus-visible{ outline:2px solid var(--ig); outline-offset:3px; border-radius:10px; }
      .obv-thumb-cap{ display:block; font-size:0.78rem; font-weight:600; color:var(--text-secondary); margin-top:6px; }
      .obv-muted{ color:var(--text-muted); }
      @media(max-width:560px){ .obv-row{ grid-template-columns:1fr; gap:2px; } }
      /* The normal public onboarding form injects these rules with its own styles. The standalone
         viewer does not, so include only the shared zoom-player rules it needs. */
      .ob-zoom-ov{ position:fixed; inset:0; background:var(--sv-bg-rgba-0-0-0-0_82); display:none; align-items:center; justify-content:center; z-index:10000; cursor:zoom-out; padding:24px; }
      .ob-zoom-ov.show{ display:flex; }
      .ob-zoom-ov img,.ob-zoom-ov video{ max-width:92vw; max-height:88vh; border-radius:10px; box-shadow:0 10px 40px var(--sv-shadow-rgba-0-0-0-0_4); }
      .ob-zoom-x{ position:fixed; top:18px; right:22px; color:var(--sv-fg-fff); font-size:1.4rem; opacity:0.8; }
      .obv-search{ display:flex; justify-content:center; margin-bottom:18px; }
      .obv-search .search-bar-pill{ width:100%; max-width:440px; }
      .obv-group-nomatch{ font-size:0.84rem; color:var(--text-muted); padding:8px 4px 2px; }
      .obv-legacy-tag{ display:inline-block; font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; vertical-align:middle; color:var(--text-secondary); background:var(--bg); border:1px solid var(--border); border-radius:99px; padding:2px 8px; margin-left:10px; }
      .obv-legacy-note{ font-size:0.78rem; color:var(--text-muted); margin-top:8px; line-height:1.5; max-width:62ch; }
      .obv-inbox-title{ font-size:1.15rem; font-weight:800; letter-spacing:-0.02em; color:var(--text-primary); }
      .obv-standalone{ max-width:720px; margin:0 auto; padding:34px 20px 60px; }
      .obv-sec-cred{ border-color:var(--ig-light) !important; }
      .obv-cred-warn{ font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--ig); background:var(--ig-light); border-radius:99px; padding:2px 8px; margin-left:8px; }
      .tpl-client-name-wrap{ display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
      .tpl-ob-btn{ display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:99px; background:var(--ig-light); border:1px solid var(--ig-light); color:var(--ig); font-family:inherit; font-size:0.74rem; font-weight:700; cursor:pointer; transition:all 0.15s; }
      .tpl-ob-btn:hover{ filter:brightness(0.97); box-shadow:0 2px 6px var(--sv-shadow-rgba-0-0-0-0_06); }
      .tpl-ob-arrow{ font-size:0.85em; }
      `;
      const st = document.createElement('style'); st.id='obvStyles'; st.textContent=css; document.head.appendChild(st);
    }

    function renderTemplatesView() {
        _obvInjectStyles();
        if (_templatesSelected) return renderClientTemplate(_templatesSelected);
        return renderTemplatesIndex();
    }

    function renderTemplatesIndex() {
        const banner = '';
        const errBanner = (templatesLoadError && templatesLoadError !== 'not-configured') ? `
            <div class="tpl-config-banner">Couldn't load templates: ${_tplEsc(templatesLoadError)}. Try refreshing the page.</div>` : '';
        return `<div class="tpl-index-centered">
            ${banner}${errBanner}
            <div class="tpl-index-title">Client Templates</div>
            <div class="tpl-index-sub">Fonts, colors, references, and preferences — one place for all of them.</div>
            <div class="search-bar-wrap" id="tplSearchWrap">
                <div class="search-bar-pill">
                    <input class="search-bar-input" id="tplSearchInput" type="text"
                        placeholder="Search clients…"
                        oninput="_tplOnSearchInput()" onkeydown="_tplOnSearchKey(event)"
                        onfocus="_tplOnSearchFocus()" autocomplete="off">
                    <div class="search-ghost-overlay" id="tplSearchGhost"></div>
                    <button class="search-bar-icon" onclick="_tplOnSearchIconClick()" title="Search">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                </div>
                <div class="search-dropdown" id="tplSearchBox">
                    <div id="tplSearchResults"></div>
                </div>
            </div>
            <div class="tpl-pins-area" id="tplPinsArea">
                <div class="tpl-pins-label" id="tplPinsLabel">My Clients</div>
                <div class="pins-row" id="tplPinsRow"></div>
                <div class="pins-add-row" id="tplPinsAddRow"></div>
            </div>
        </div>`;
    }

    /* ── Templates pinned clients (per-user, localStorage) ──────────────── */
    function _tplGetPins() { try { return JSON.parse(localStorage.getItem(TPL_PINS_KEY) || '[]'); } catch { return []; } }
    function _tplSavePins(p) { localStorage.setItem(TPL_PINS_KEY, JSON.stringify(p)); }
    function _tplTogglePin(name) {
        let pins = _tplGetPins();
        if (pins.includes(name)) pins = pins.filter(p => p !== name);
        else { if (pins.length >= TPL_MAX_PINS) return; pins.push(name); }
        _tplSavePins(pins);
        _tplRenderPins();
    }
    function _tplRemovePin(name) {
        const pins = _tplGetPins().filter(p => p !== name);
        _tplSavePins(pins);
        if (pins.length === 0) _tplPinsEditMode = false;
        _tplPinSelectorOpen = false;
        _tplRenderPins();
    }
    function _tplTogglePinsEdit() { _tplPinsEditMode = !_tplPinsEditMode; _tplPinSelectorOpen = false; _tplRenderPins(); }
    function _tplClosePinSelector() { _tplPinSelectorOpen = false; const dd = document.getElementById('tplPinSelectorDropdown'); if (dd) dd.classList.remove('open'); }
    function _tplTogglePinSelector() {
        if (_tplPinSelectorOpen) { _tplClosePinSelector(); return; }
        _tplPinSelectorOpen = true;
        const dd = document.getElementById('tplPinSelectorDropdown');
        if (dd) { dd.classList.add('open'); _tplRenderPinSelectorList(); }
        const close = (e) => {
            const addRow = document.getElementById('tplPinsAddRow');
            if (addRow && !addRow.contains(e.target)) {
                _tplClosePinSelector();
                document.removeEventListener('click', close);
            }
        };
        setTimeout(() => document.addEventListener('click', close), 0);
    }
    function _tplRenderPins() {
        const row = document.getElementById('tplPinsRow');
        const addRow = document.getElementById('tplPinsAddRow');
        const area = document.getElementById('tplPinsArea');
        if (!row || !addRow) return;
        const pins = _tplGetPins();
        row.innerHTML = '';
        pins.forEach(name => {
            const pill = document.createElement('a');
            pill.className = 'pin-pill';
            pill.href = '#templates/' + encodeURIComponent(name);
            pill.style.textDecoration = 'none';
            pill.style.color = 'inherit';
            if (!_tplPinsEditMode) pill.onclick = (e) => { e.preventDefault(); openClientTemplate(name); };
            else pill.onclick = (e) => { e.preventDefault(); };
            const nameSpan = document.createElement('span');
            nameSpan.textContent = name;
            pill.appendChild(nameSpan);
            if (_tplPinsEditMode) {
                const rm = document.createElement('span');
                rm.className = 'pin-remove';
                rm.title = 'Remove';
                rm.textContent = '✕';
                rm.onclick = (e) => { e.preventDefault(); e.stopPropagation(); _tplRemovePin(name); };
                pill.appendChild(rm);
            }
            row.appendChild(pill);
        });
        if (pins.length >= 1) {
            const editBtn = document.createElement('button');
            editBtn.className = 'pin-edit-btn' + (_tplPinsEditMode ? ' active' : '');
            editBtn.title = _tplPinsEditMode ? 'Done' : 'Edit pins';
            editBtn.innerHTML = _tplPinsEditMode
                ? '<svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                : PEN_ICON_SVG;
            editBtn.onclick = _tplTogglePinsEdit;
            row.appendChild(editBtn);
        }
        addRow.innerHTML = '';
        const showAddBtn = pins.length < TPL_MAX_PINS && (pins.length === 0 || _tplPinsEditMode || _tplPinSelectorOpen);
        if (showAddBtn) {
            const addBtn = document.createElement('button');
            addBtn.className = 'pin-add-btn';
            addBtn.title = 'Pin a client';
            addBtn.innerHTML = PIN_ICON_SVG + ' Pin client <span style="opacity:0.6;font-size:0.68rem;">' + pins.length + '/' + TPL_MAX_PINS + '</span>';
            addBtn.onclick = _tplTogglePinSelector;
            addRow.appendChild(addBtn);
            const dd = document.createElement('div');
            dd.className = 'pin-selector-dropdown' + (_tplPinSelectorOpen ? ' open' : '');
            dd.id = 'tplPinSelectorDropdown';
            const hdr = document.createElement('div');
            hdr.className = 'pin-selector-header';
            hdr.innerHTML = '<span class="pin-selector-title">Pin a client</span><div style="display:flex;align-items:center;gap:8px;"><span class="pin-selector-count">' + pins.length + ' / ' + TPL_MAX_PINS + '</span><button style="background:none;border:none;cursor:pointer;color:var(--text-muted);display:inline-flex;align-items:center;padding:0;transition:color 0.13s;" id="tplPinDropCloseBtn" title="Close"><svg width="9" height="9" viewBox="0 0 10 10" fill="none"><line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button></div>';
            dd.appendChild(hdr);
            const list = document.createElement('div');
            list.className = 'pin-selector-list';
            list.id = 'tplPinSelectorList';
            dd.appendChild(list);
            addRow.appendChild(dd);
            const closeBtn = dd.querySelector('#tplPinDropCloseBtn');
            if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); _tplClosePinSelector(); };
            if (_tplPinSelectorOpen) _tplRenderPinSelectorList();
        } else if (!showAddBtn && _tplPinSelectorOpen) {
            _tplPinSelectorOpen = false;
        }
        if (area) area.style.display = '';
    }
    function _tplRenderPinSelectorList() {
        const list = document.getElementById('tplPinSelectorList');
        if (!list) return;
        const pins = _tplGetPins();
        const allNames = _tplAllNames();
        list.innerHTML = '';
        allNames.forEach(name => {
            const isPinned = pins.includes(name);
            const disabled = !isPinned && pins.length >= TPL_MAX_PINS;
            const item = document.createElement('div');
            item.className = 'pin-selector-item' + (isPinned ? ' pinned' : '');
            if (disabled) item.style.cssText = 'opacity:0.35;cursor:default;';
            const nameSpan = document.createElement('span');
            nameSpan.textContent = name;
            const check = document.createElement('span');
            check.className = 'pin-check';
            if (isPinned) check.innerHTML = CHECK_SVG;
            item.appendChild(nameSpan);
            item.appendChild(check);
            if (!disabled) item.onclick = (e) => { e.stopPropagation(); _tplTogglePin(name); };
            list.appendChild(item);
        });
    }

    /* ── Templates search bar (mirrors the analytics search bar) ────────── */
    function _tplGetRecent() { try { return JSON.parse(localStorage.getItem(TPL_RECENT_KEY) || '[]'); } catch { return []; } }
    function _tplAddRecent(name) { let r = _tplGetRecent().filter(n => n !== name); r.unshift(name); r = r.slice(0,3); localStorage.setItem(TPL_RECENT_KEY, JSON.stringify(r)); }
    function _tplAllNames() { return getClientRoster(); }
    function _tplMatches(q) {
        const allNames = _tplAllNames();
        const q2 = (q || '').trim().toLowerCase();
        if (!q2) return [];
        const starts = allNames.filter(n => n.toLowerCase().startsWith(q2));
        const contains = allNames.filter(n => !n.toLowerCase().startsWith(q2) && n.toLowerCase().includes(q2));
        return [...starts, ...contains];
    }
    function _tplHighlight(name, q) { if (!q) return _tplEsc(name); const idx = name.toLowerCase().indexOf(q.toLowerCase()); if (idx < 0) return _tplEsc(name); return _tplEsc(name.slice(0,idx)) + '<span class="s-match">' + _tplEsc(name.slice(idx, idx + q.length)) + '</span>' + _tplEsc(name.slice(idx + q.length)); }
    function _tplOpenSearchDropdown() {
        const box = document.getElementById('tplSearchBox');
        if (!box || box.classList.contains('open')) return;
        box.classList.add('open');
        const close = (e) => {
            const wrap = document.getElementById('tplSearchWrap');
            if (wrap && !wrap.contains(e.target)) {
                box.classList.remove('open');
                document.removeEventListener('click', close);
            }
        };
        setTimeout(() => document.addEventListener('click', close), 0);
    }
    function _tplOnSearchFocus() { _tplRenderSearchResults(document.getElementById('tplSearchInput')?.value || ''); _tplOpenSearchDropdown(); }
    function _tplOnSearchInput() {
        const q = document.getElementById('tplSearchInput')?.value || '';
        _tplRenderSearchResults(q);
        _tplUpdateSearchGhost(q);
        _tplOpenSearchDropdown();
    }
    function _tplOnSearchIconClick() {
        const inp = document.getElementById('tplSearchInput');
        const q = (inp?.value || '').trim();
        if (q) {
            const first = _tplMatches(q)[0];
            if (first) { _tplGoTo(first); return; }
        }
        inp?.focus();
        _tplOpenSearchDropdown();
    }
    function _tplOnSearchKey(e) {
        if (e.key === 'Escape') {
            document.getElementById('tplSearchBox')?.classList.remove('open');
            const ghost = document.getElementById('tplSearchGhost'); if (ghost) ghost.innerHTML = '';
            document.getElementById('tplSearchInput')?.blur();
            return;
        }
        if (e.key !== 'Enter') return;
        const q = (document.getElementById('tplSearchInput')?.value || '').trim();
        if (!q) return;
        const first = _tplMatches(q)[0];
        if (first) _tplGoTo(first);
    }
    function _tplUpdateSearchGhost(q) {
        const ghost = document.getElementById('tplSearchGhost');
        const inp = document.getElementById('tplSearchInput');
        if (!ghost || !inp) return;
        const q2 = q.trim().toLowerCase();
        if (!q2) { ghost.innerHTML = ''; return; }
        const first = _tplMatches(q2)[0];
        if (!first) { ghost.innerHTML = ''; return; }
        if (first.toLowerCase().startsWith(q2)) {
            const typed = first.slice(0, q.length);
            const rest = first.slice(q.length);
            ghost.innerHTML = `<span style="color:transparent;white-space:pre">${_tplEsc(typed)}</span><span style="color:var(--text-muted);opacity:0.55;white-space:pre">${_tplEsc(rest)}</span><span style="margin-left:8px;font-size:0.65rem;color:var(--text-muted);opacity:0.4;background:var(--border);border-radius:3px;padding:1px 5px;flex-shrink:0;">↵</span>`;
        } else {
            ghost.innerHTML = `<span style="color:transparent;white-space:pre">${_tplEsc(q)}</span><span style="margin-left:8px;font-size:0.65rem;color:var(--text-muted);opacity:0.4;background:var(--border);border-radius:3px;padding:1px 5px;flex-shrink:0;">↵ ${_tplEsc(first)}</span>`;
        }
    }
    function _tplRenderSearchResults(q) {
        const el = document.getElementById('tplSearchResults');
        if (!el) return;
        const allNames = _tplAllNames();
        const recent = _tplGetRecent().filter(n => allNames.includes(n));
        const q2 = q.trim().toLowerCase();
        if (!q2) {
            if (!recent.length) { el.innerHTML = ''; return; }
            el.innerHTML = `<div class="search-section-label">Recent</div>` + recent.map(name => `<div class="search-suggestion" onclick="_tplGoTo(${_jsAttrArg(name)})"><span class="s-icon">↩</span><span>${_tplEsc(name)}</span></div>`).join('');
        } else {
            const matches = _tplMatches(q2);
            if (!matches.length) { el.innerHTML = `<div class="search-empty">No clients found</div>`; }
            else { el.innerHTML = matches.slice(0, 6).map(name => `<div class="search-suggestion" onclick="_tplGoTo(${_jsAttrArg(name)})"><span class="s-icon">👤</span><span>${_tplHighlight(name, q.trim())}</span></div>`).join(''); }
        }
    }
    function _tplGoTo(name) {
        _tplAddRecent(name);
        const box = document.getElementById('tplSearchBox');
        const inp = document.getElementById('tplSearchInput');
        const ghost = document.getElementById('tplSearchGhost');
        if (box) box.classList.remove('open');
        if (inp) { inp.value = ''; inp.blur(); }
        if (ghost) ghost.innerHTML = '';
        openClientTemplate(name);
    }

    function openClientTemplate(name) {
        _templatesSelected = name;
        _templatesActiveTab = 'reels';
        _templatesEditMode = false;
        history.pushState({ nav: 'templates', templatesClient: name, templatesTab: 'reels' }, '', '#templates/' + encodeURIComponent(name));
        const content = document.getElementById('content');
        if (content) {
            content.innerHTML = renderClientTemplate(name);
            mountTemplatesView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        }
    }
    function backToTemplatesIndex() {
        _templatesSelected = null;
        _templatesEditMode = false;
        history.pushState({ nav: 'templates' }, '', '#templates');
        const content = document.getElementById('content');
        if (content) {
            content.innerHTML = renderTemplatesIndex();
            mountTemplatesView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        }
    }

    /* ── Synchro Brain on the Templates page ─────────────────────────────
       Facts come from the private brain repo through the `brain` Edge Function
       (the site never holds the brain token). The page lays out whatever facts
       exist with one generic card, so a bigger brain needs no change here.
       Facts carrying a `spec:` line are pinned at the top as a quick-look
       strip. Corrections go through "Send a change": saved word for word into
       the brain and processed there; nothing on this page edits a fact. */
    // Resolved lazily: CAL_SUPABASE_URL is declared in a later fragment.
    function _tplBrainUrl() { return CAL_SUPABASE_URL + '/functions/v1/brain'; }
    const TPL_BRAIN_FILES = [['editing', 'Editing'], ['voice', 'Voice'], ['identity', 'Identity'], ['relationship', 'Relationship']];
    const TPL_BRAIN_NAME_KEY = 'syncview_brain_sender_name';
    const _tplBrain = {};            // client -> { state: 'loading'|'ready'|'error', facts, found, error }
    let _tplBrainTab = 'editing';
    const _tplBrainSent = {};        // `${client}::${factId}` -> 'sending'|'sent'|'error'
    let _tplBrainOpenForm = '';      // `${client}::${factId}` currently showing the change box
    const _tplBrainDraft = {};       // key -> unsent text, survives background rerenders
    const TPL_BRAIN_STALE_MS = 3 * 60 * 1000;

    function _tplBrainPost(payload) {
        const url = _tplBrainUrl();
        return fetch(url, {
            method: 'POST',
            headers: _syncviewEfHeaders({ 'Content-Type': 'application/json', 'X-Syncview-Actor': 'SyncView', 'X-Syncview-Role': 'smm', 'X-Syncview-Source': 'brain' }, url),
            body: JSON.stringify(payload),
        }).then(async r => {
            const j = await r.json().catch(() => ({}));
            if (!r.ok || !j.ok) throw new Error(j.error || ('HTTP ' + r.status));
            return j;
        });
    }
    function _tplBrainEnsure(name, force) {
        const cur = _tplBrain[name];
        // Errors retry only from the button; a ready copy refreshes once stale.
        if (cur && !force && (cur.state !== 'ready' || Date.now() - (cur.at || 0) < TPL_BRAIN_STALE_MS)) return;
        // A background refresh keeps showing the current facts instead of a skeleton.
        _tplBrain[name] = cur && cur.state === 'ready' ? Object.assign({}, cur, { refreshing: true }) : { state: 'loading', facts: cur && cur.facts || [] };
        _tplBrainPost({ action: 'read', clientName: name }).then(j => {
            _tplBrain[name] = { state: 'ready', at: Date.now(), facts: Array.isArray(j.facts) ? j.facts : [], found: !!j.found };
        }).catch(e => {
            _tplBrain[name] = { state: 'error', facts: [], error: e && e.message || String(e) };
        }).then(() => { if (_templatesSelected === name) _maybeRerenderTemplates(); });
    }
    function tplBrainRetry() { if (_templatesSelected) { _tplBrainEnsure(_templatesSelected, true); _maybeRerenderTemplates(); } }
    function tplBrainSetTab(tab) { _tplBrainTab = tab; _maybeRerenderTemplates(); }

    // Plain-text facts with light markdown: **bold**, > quotes, paragraphs.
    function _tplBrainProse(text) {
        const out = [];
        let quote = [];
        const flush = () => { if (quote.length) { out.push('<blockquote class="tpl-brain-quote">' + quote.join('<br>') + '</blockquote>'); quote = []; } };
        String(text || '').split(/\n{2,}/).forEach(block => {
            const lines = block.split('\n');
            if (lines.every(l => /^>\s?/.test(l))) { quote.push(...lines.map(l => _tplBrainInline(l.replace(/^>\s?/, '')))); return; }
            flush();
            out.push('<p>' + lines.map(_tplBrainInline).join('<br>') + '</p>');
        });
        flush();
        return out.join('');
    }
    function _tplBrainInline(line) {
        return _tplEsc(line)
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            .replace(/(https?:\/\/[^\s<]+)/g, u => `<a href="${u}" target="_blank" rel="noopener">${u}</a>`);
    }
    function _tplBrainSpecChips(spec) {
        return String(spec || '').split(';').map(x => x.trim()).filter(Boolean).map(part => {
            const html = _tplEsc(part)
                .replace(/(^|\s)([a-z0-9]+)=/gi, (m, sp, k) => `${sp}<span class="tpl-brain-k">${k.charAt(0).toUpperCase() + k.slice(1)}</span> `)
                .replace(/#[0-9a-fA-F]{3,8}\b/g, hex =>
                `<button type="button" class="tpl-brain-swatch" title="Copy ${hex}" onclick="tplBrainCopy('${hex}', this)"><span style="background:${hex}"></span>${hex}</button>`);
            return `<span class="tpl-brain-chip">${html}</span>`;
        }).join('');
    }
    function tplBrainCopy(text, el) {
        try { navigator.clipboard.writeText(text); } catch (e) {}
        if (el) { el.classList.add('copied'); setTimeout(() => el.classList.remove('copied'), 900); }
    }
    function _tplBrainSpecStrip(name) {
        const b = _tplBrain[name];
        if (!b || b.state !== 'ready') return '';
        const specs = b.facts.filter(f => f.spec && f.status === 'written');
        if (!specs.length) return '';
        return `<div class="tpl-section tpl-brain-strip">
            <div class="tpl-section-title">Quick look</div>
            ${specs.map(f => `<div class="tpl-brain-spec-row"><span class="tpl-brain-spec-label">${_tplEsc(f.heading.replace(/\s*spec$/i, ''))}</span><span class="tpl-brain-spec-chips">${_tplBrainSpecChips(f.spec)}</span></div>`).join('')}
        </div>`;
    }
    function _tplBrainKey(name, id) { return name + '::' + (id || '_new'); }
    function _tplBrainChangeBox(name, fact) {
        const key = _tplBrainKey(name, fact && fact.id);
        const st = _tplBrainSent[key];
        if (st === 'sent') return `<div class="tpl-brain-sent">Change sent. It is being processed into the brain and will show here once it is in. <button type="button" class="tpl-brain-change-btn" onclick="tplBrainAnother('${_tplEscAttr(key)}')">Send another</button></div>`;
        if (_tplBrainOpenForm !== key) {
            const label = !fact ? 'Add something the brain is missing' : (fact.status === 'written' ? 'Send a change' : 'Write this');
            return `<button type="button" class="tpl-brain-change-btn" onclick="tplBrainOpen('${_tplEscAttr(key)}')">${label}</button>`;
        }
        let sender = '';
        try { sender = localStorage.getItem(TPL_BRAIN_NAME_KEY) || ''; } catch (e) {}
        return `<div class="tpl-brain-form" data-brain-key="${_tplEscAttr(key)}">
            <textarea class="tpl-brain-text" rows="4" oninput="_tplBrainDraft['${_tplEscAttr(key)}']=this.value" placeholder="${fact ? 'What is true now? Write it the way you would tell a teammate.' : 'What should the brain know about this client?'}">${_tplEsc(_tplBrainDraft[key] || '')}</textarea>
            <div class="tpl-brain-form-row">
                <input class="tpl-brain-from" type="text" placeholder="Your name" value="${_tplEscAttr(sender)}">
                <button type="button" class="tpl-brain-cancel" onclick="tplBrainOpen('')">Cancel</button>
                <button type="button" class="tpl-brain-send" onclick="tplBrainSend('${_tplEscAttr(key)}')">${st === 'sending' ? 'Sending…' : 'Send'}</button>
            </div>
            ${st === 'error' ? '<div class="tpl-brain-err">Couldn\'t send. Your text is still here; try again.</div>' : ''}
        </div>`;
    }
    function tplBrainAnother(key) { delete _tplBrainSent[key]; tplBrainOpen(key); }
    function tplBrainOpen(key) { _tplBrainOpenForm = key; _maybeRerenderTemplates(); const ta = document.querySelector('.tpl-brain-text'); if (ta) ta.focus(); }
    function tplBrainSend(key) {
        const name = _templatesSelected;
        const form = document.querySelector(`.tpl-brain-form[data-brain-key="${CSS.escape(key)}"]`);
        if (!name || !form) return;
        const text = form.querySelector('.tpl-brain-text').value.trim();
        const from = form.querySelector('.tpl-brain-from').value.trim();
        if (!text) { form.querySelector('.tpl-brain-text').focus(); return; }
        try { if (from) localStorage.setItem(TPL_BRAIN_NAME_KEY, from); } catch (e) {}
        const factId = key.slice(name.length + 2);
        const fact = ((_tplBrain[name] || {}).facts || []).find(f => f.id === factId);
        const btn = form.querySelector('.tpl-brain-send');
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        _tplBrainSent[key] = 'sending';
        _tplBrainPost({ action: 'change', clientName: name, factId: fact ? fact.id : '', heading: fact ? fact.heading : '', from, text })
            .then(() => {
                _tplBrainSent[key] = 'sent'; _tplBrainOpenForm = ''; delete _tplBrainDraft[key]; _maybeRerenderTemplates();
                // Processing takes a minute or two; pick the result up without a reload.
                [90, 240].forEach(sec => setTimeout(() => { if (_templatesSelected === name) _tplBrainEnsure(name, true); }, sec * 1000));
            })
            .catch(() => {
                _tplBrainSent[key] = 'error';
                if (btn) { btn.disabled = false; btn.textContent = 'Send'; }
                if (!form.querySelector('.tpl-brain-err')) form.insertAdjacentHTML('beforeend', '<div class="tpl-brain-err">Couldn\'t send. Your text is still here; try again.</div>');
            });
    }
    function _tplBrainCard(name, f) {
        const meta = f.status === 'written'
            ? `<span class="tpl-brain-status ok">Written</span>${f.owner ? `<span class="tpl-brain-meta">${_tplEsc(f.owner)}</span>` : ''}${f.updated ? `<span class="tpl-brain-meta">${_tplEsc(f.updated)}</span>` : ''}`
            : `<span class="tpl-brain-status empty">Not written yet</span>`;
        return `<div class="tpl-brain-card${f.status === 'written' ? '' : ' empty'}">
            <div class="tpl-brain-head"><span class="tpl-brain-title">${_tplEsc(f.heading)}</span><span class="tpl-brain-metas">${meta}</span></div>
            ${f.body ? `<div class="tpl-brain-body">${_tplBrainProse(f.body)}</div>` : ''}
            ${f.source ? `<div class="tpl-brain-source" title="${_tplEscAttr(f.source)}">Source: ${_tplEsc(f.source.split(';')[0].split('/').pop())}${f.source.includes(';') ? ' and more' : ''}</div>` : ''}
            ${_tplBrainChangeBox(name, f)}
        </div>`;
    }
    // While the brain is unreachable, show the last values typed into SyncView
    // (read-only) so editors are never left without fonts and colours.
    function _tplBrainFallback(name) {
        const hlR = !!_tplGet(name, 'reels_subtitle_highlight_off');
        const hlT = !!_tplGet(name, 'thumbnails_highlight_off');
        return `<div class="tpl-section">
            <div class="tpl-section-title">Last values saved in SyncView</div>
            <div class="tpl-view-grid">
                ${_tplViewText(name, 'reels_subtitle_font', 'Subtitle font')}
                ${_tplViewColor(name, 'reels_subtitle_main_color', 'Subtitle main color')}
                ${hlR ? '' : _tplViewColor(name, 'reels_subtitle_highlight_color', 'Subtitle highlight color')}
                ${_tplViewText(name, 'thumbnails_title_font', 'Thumbnail title font')}
            </div>
            <div class="tpl-view-color-sets-wrap">${_tplRenderColorSetsView(name, hlT)}</div>
            ${_tplViewProse(name, 'reels_preferences')}
            ${_tplViewProse(name, 'thumbnails_preferences')}
        </div>`;
    }
    function _tplBrainSection(name) {
        const b = _tplBrain[name];
        const head = `<div class="tpl-section-title">From the Synchro Brain</div>`;
        if (!b || b.state === 'loading') return `<div class="tpl-section">${head}<div class="tpl-skeleton tpl-skeleton-line" style="width:70%;"></div><div class="tpl-skeleton tpl-skeleton-line" style="width:50%;margin-top:10px;"></div></div>`;
        if (b.state === 'error') return `<div class="tpl-section">${head}<div class="tpl-config-banner">Couldn't reach the brain (${_tplEsc(b.error || 'error')}). <button type="button" class="tpl-brain-change-btn" onclick="tplBrainRetry()">Try again</button></div></div>${_tplBrainFallback(name)}`;
        if (!b.found) return `<div class="tpl-section">${head}<div class="tpl-brain-empty-note">This client has no folder in the brain yet.</div>${_tplBrainChangeBox(name, null)}</div>`;
        const tabs = TPL_BRAIN_FILES.map(([k, label]) => {
            const n = b.facts.filter(f => f.file === k && f.status === 'written').length;
            return `<button class="tpl-toggle-btn ${_tplBrainTab === k ? 'active' : ''}" onclick="tplBrainSetTab('${k}')">${label} <span class="tpl-brain-count">${n}</span></button>`;
        }).join('');
        const inTab = b.facts.filter(f => f.file === _tplBrainTab);
        const written = inTab.filter(f => f.status === 'written');
        const empty = inTab.filter(f => f.status !== 'written');
        return `<div class="tpl-section tpl-brain">
            ${head}
            <div class="tpl-toggle-row" role="tablist">${tabs}</div>
            ${written.map(f => _tplBrainCard(name, f)).join('') || '<div class="tpl-brain-empty-note">Nothing written here yet.</div>'}
            ${empty.length ? `<details class="tpl-brain-missing"><summary>${empty.length} not written yet</summary>${empty.map(f => _tplBrainCard(name, f)).join('')}</details>` : ''}
            <div class="tpl-brain-add">${_tplBrainChangeBox(name, null)}</div>
        </div>`;
    }

    function renderClientTemplate(name) {
        // Loading state — first paint while the GET is in flight.
        if (!_tplClientReady(name) && !templatesLoadError) {
            return `<div class="tpl-view">
                <button class="back-btn" onclick="backToTemplatesIndex()" style="margin-bottom:12px;">← All templates</button>
                <div class="tpl-client-head"><div class="tpl-client-name">${_tplEsc(name)}</div></div>
                <div class="tpl-skeleton tpl-skeleton-pill" style="width:160px;height:24px;margin-bottom:18px;"></div>
                <div class="tpl-skeleton-card">
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:35%;"></div>
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:80%;margin-top:14px;"></div>
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:60%;margin-top:10px;"></div>
                </div>
                <div class="tpl-skeleton-card">
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:30%;"></div>
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:90%;margin-top:14px;"></div>
                    <div class="tpl-skeleton tpl-skeleton-line" style="width:75%;margin-top:10px;"></div>
                </div>
            </div>`;
        }
        if (templatesLoadError && !_tplClientReady(name)) {
            return `<div class="tpl-view">
                <button class="back-btn" onclick="backToTemplatesIndex()" style="margin-bottom:12px;">← All templates</button>
                <div class="tpl-client-head"><div class="tpl-client-name">${_tplEsc(name)}</div></div>
                <div class="tpl-config-banner">Couldn't load templates: ${_tplEsc(templatesLoadError)}. Try refreshing the page.</div>
            </div>`;
        }

        const isEdit = _templatesEditMode;
        _tplBrainEnsure(name);

        // Working links: the only part of the page that is edited in SyncView.
        // Every other fact (fonts, colours, preferences, voice…) comes from the
        // Synchro Brain and is corrected with "Send a change".
        const links = isEdit
            ? `<div class="tpl-section">
                <div class="tpl-section-title">Working links</div>
                <div class="tpl-fields two">
                    ${_tplRenderLinksEdit(name, 'reels_reference_link', 'Reference reel (placement & sizing)', 'https://instagram.com/reel/…')}
                    ${_tplRenderLinksEdit(name, 'thumbnails_photos_link', 'Client photos (Drive / Dropbox)', 'https://drive.google.com/…')}
                </div>
                <div class="tpl-fields two" style="margin-top:14px;">
                    ${_tplRenderLinksEdit(name, 'thumbnails_canva_link', 'Editable Canva link', 'https://canva.com/design/…')}
                    ${_tplFieldLink(name, 'reels_editor_folder_link', 'Editor folder (Google Drive)', 'https://drive.google.com/…')}
                </div>
              </div>`
            : `<div class="tpl-section">
                <div class="tpl-section-title">Working links</div>
                <div class="tpl-view-grid">
                    ${_tplRenderLinksView(name, 'reels_reference_link', 'Reference reel', 'Open reference')}
                    ${_tplRenderLinksView(name, 'thumbnails_photos_link', 'Client photos', 'Open photos')}
                    ${_tplRenderLinksView(name, 'thumbnails_canva_link', 'Editable Canva', 'Open Canva')}
                </div>
              </div>`;

        // Filming plans block (rendered at the BOTTOM, after the active tab's sections).
        const filmingPlans = (() => {
            const v = _fpLinkForClient(name, _tplGet(name, 'filming_plans_link'));
            const isUrl = /^https?:\/\//i.test(v);
            let host = ''; if (isUrl) { try { host = new URL(v).hostname.replace(/^www\./,''); } catch {} }
            if (isUrl) {
                return `<a class="tpl-filming-card" href="${_tplEscAttr(v)}" target="_blank" rel="noopener">
                    <span class="tpl-filming-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 3v4a1 1 0 0 0 1 1h4M5 21V3a1 1 0 0 1 1-1h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <span class="tpl-filming-text"><span class="tpl-filming-title">Filming plans</span><span class="tpl-filming-host">${_tplEsc(host || 'Open document')}</span></span>
                    <svg class="tpl-filming-arrow" width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M9.5 2.5h4v4M13.5 2.5L7 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>`;
            }
            return `<div class="tpl-filming-card empty">
                <span class="tpl-filming-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 3v4a1 1 0 0 0 1 1h4M5 21V3a1 1 0 0 1 1-1h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class="tpl-filming-text"><span class="tpl-filming-title">Filming plans</span><span class="tpl-filming-host">Not set</span></span>
            </div>`;
        })();

        // Editor folder block (Reels only) — rendered at the BOTTOM, just after filming plans.
        // Lets the team paste a Google Drive folder link for the editor.
        let editorFolder = '';
        if (!isEdit) {
            editorFolder = (() => {
                    const v = _tplGet(name, 'reels_editor_folder_link');
                    const isUrl = /^https?:\/\//i.test(v);
                    let host = ''; if (isUrl) { try { host = new URL(v).hostname.replace(/^www\./,''); } catch {} }
                    if (isUrl) {
                        return `<a class="tpl-filming-card" href="${_tplEsc(v)}" target="_blank" rel="noopener">
                            <span class="tpl-filming-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 7a2 2 0 0 1 2-2h3.2a2 2 0 0 1 1.4.6L11 7h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                            <span class="tpl-filming-text"><span class="tpl-filming-title">Editor folder</span><span class="tpl-filming-host">${_tplEsc(host || 'Open folder')}</span></span>
                            <svg class="tpl-filming-arrow" width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M9.5 2.5h4v4M13.5 2.5L7 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>`;
                    }
                    return `<div class="tpl-filming-card empty">
                        <span class="tpl-filming-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 7a2 2 0 0 1 2-2h3.2a2 2 0 0 1 1.4.6L11 7h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="tpl-filming-text"><span class="tpl-filming-title">Editor folder</span><span class="tpl-filming-host">Not set</span></span>
                    </div>`;
                })();
        }

        const editToggle = isEdit
            ? `<button class="tpl-edit-btn done" onclick="setTemplatesEditMode(false)">Done</button>`
            : `<button class="tpl-edit-btn" onclick="setTemplatesEditMode(true)"><svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M11 2l3 3-8 8H3v-3l8-8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Edit links</button>`;

        // Onboarding button next to the name — opens this client's onboarding in a
        // new tab. Shown only when a matching onboarding record exists (by slug).
        _obvEnsureSlugIndex();
        const obBtn = _obvHasOnboarding(name)
            ? `<button class="tpl-ob-btn" onclick="_obvOpenStandalone('${_tplEsc(wlNormalizeClient(name))}')" title="Open this client's onboarding in a new tab">Onboarding <span class="tpl-ob-arrow">↗</span></button>`
            : '';

        return `<div class="tpl-view${isEdit?' editing':''}">
            <button class="back-btn" onclick="backToTemplatesIndex()" style="margin-bottom:12px;">← All templates</button>
            <div class="tpl-client-head">
                <div class="tpl-client-name-wrap"><div class="tpl-client-name">${_tplEsc(name)}</div>${obBtn}</div>
                <div class="tpl-head-right">${_svSaveIndHtml('templates')}${editToggle}</div>
            </div>
            ${_tplBrainSpecStrip(name)}
            <div class="tpl-filming-wrap">${filmingPlans}</div>
            ${editorFolder ? `<div class="tpl-filming-wrap">${editorFolder}</div>` : ''}
            ${links}
            ${_tplBrainSection(name)}
        </div>`;
    }

    function switchTemplatesTab(tab) {
        _templatesActiveTab = tab;
        if (!_templatesSelected) return;
        // Persist the active tab in history.state so a refresh restores it (the
        // URL stays #templates/<client>; the tab rides in state, which survives a
        // reload). Guarded for file:// test contexts.
        try { history.replaceState({ nav: 'templates', client: null, templatesClient: _templatesSelected, templatesTab: tab }, '', location.pathname + location.search.replace(/#.*$/, '') + '#templates/' + encodeURIComponent(_templatesSelected)); } catch (e) {}
        const content = document.getElementById('content');
        if (content) { content.innerHTML = renderClientTemplate(_templatesSelected); mountTemplatesView(); }
    }

    function setTemplatesEditMode(on) {
        const name = _templatesSelected;
        // Flush any pending autosaves before leaving edit mode so view mode reflects the latest.
        if (!on && name && _tplDirty[name] && Object.keys(_tplDirty[name]).length) _tplFlush(name);
        _templatesEditMode = !!on;
        const content = document.getElementById('content');
        if (!content || !name) return;
        content.innerHTML = renderClientTemplate(name);
        mountTemplatesView();
    }

    function mountTemplatesView() {
        const root = document.getElementById('content');
        if (!root) return;
        const hadFilmingPlans = !!filmingPlansData;
        if (_templatesSelected && !hadFilmingPlans) {
            _fpEnsureLoaded(false).then(() => {
                if (currentNav === 'templates' && _templatesSelected) _maybeRerenderTemplates();
            }, () => {});
        }
        mountOnboardingInbox();
        // Render the "My Clients" pinned section if the index page is showing.
        if (!_templatesSelected && document.getElementById('tplPinsArea')) _tplRenderPins();
        // Restore a persistent save-error state onto the freshly rendered header
        // indicator (a re-render otherwise resets it to hidden).
        if (_templatesSelected && _tplSaveErrorMsg) _setTplStatus('error', _tplSaveErrorMsg);
        const fields = root.querySelectorAll('[data-tpl-field]');
        fields.forEach(el => {
            const name  = el.getAttribute('data-tpl-client');
            const field = el.getAttribute('data-tpl-field');
            const isColorPair = el.hasAttribute('data-tpl-color-pair');
            const isBool = el.hasAttribute('data-tpl-bool');

            if (isBool) {
                // Booleans (e.g. "no highlight" toggle): persist as 'true' or '' so the
                // string round-trip stays unambiguous, and dim the paired color row.
                el.addEventListener('change', () => {
                    const v = el.checked ? 'true' : '';
                    _tplQueueSave(name, field, v, true);
                    const pair = el.getAttribute('data-tpl-disables-pair');
                    if (pair) {
                        const row = root.querySelector(`[data-tpl-color-row="${pair}"]`);
                        if (row) row.classList.toggle('tpl-color-off', el.checked);
                    }
                    // The thumbnails toggle dims every highlight cell across all color sets.
                    if (el.hasAttribute('data-tpl-disables-color-sets')) {
                        root.querySelectorAll('.tpl-color-sets-edit .tpl-set-cell').forEach(cell => {
                            const isHl = cell.querySelector('[data-tpl-set-key="highlight"]');
                            if (isHl) cell.classList.toggle('tpl-color-off', el.checked);
                        });
                    }
                });
                return;
            }

            el.addEventListener('input', () => {
                let v = el.value;
                if (isColorPair) {
                    const pair = el.getAttribute('data-tpl-color-pair');
                    const peers = root.querySelectorAll(`[data-tpl-color-pair="${pair}"][data-tpl-client="${CSS.escape(name)}"]`);
                    if (el.type === 'color') {
                        peers.forEach(p => { if (p !== el && p.type !== 'color') p.value = v; });
                    } else {
                        if (/^#[0-9a-fA-F]{6}$/.test(v)) peers.forEach(p => { if (p !== el && p.type === 'color') p.value = v; });
                    }
                }
                _tplQueueSave(name, field, v, false);
                if (field.endsWith('_link') || field === 'filming_plans_link') {
                    const opener = root.querySelector(`[data-tpl-link-for="${field}"]`);
                    if (opener) {
                        const ok = /^https?:\/\//i.test(v);
                        opener.classList.toggle('disabled', !ok);
                        opener.setAttribute('href', ok ? v : '#');
                    }
                }
            });
            el.addEventListener('blur', () => {
                if (_tplDirty[name] && Object.keys(_tplDirty[name]).length) _tplFlush(name);
            });
        });

        // Per-set color inputs (thumbnails color sets). Each has data-tpl-set + data-tpl-set-key.
        root.querySelectorAll('[data-tpl-color-sets]').forEach(container => {
            const cName = container.getAttribute('data-tpl-client');
            container.querySelectorAll('[data-tpl-set-pair-color]').forEach(el => {
                const idx = parseInt(el.getAttribute('data-tpl-set'), 10);
                const key = el.getAttribute('data-tpl-set-key');
                el.addEventListener('input', () => {
                    const v = el.value;
                    // Sync swatch ↔ hex within the same set+key.
                    const peers = container.querySelectorAll(`[data-tpl-set="${idx}"][data-tpl-set-key="${key}"]`);
                    if (el.type === 'color') {
                        peers.forEach(p => { if (p !== el && p.type !== 'color') p.value = v; });
                    } else if (/^#[0-9a-fA-F]{6}$/.test(v)) {
                        peers.forEach(p => { if (p !== el && p.type === 'color') p.value = v; });
                    }
                    const sets = _tplGetColorSets(cName);
                    while (sets.length <= idx) sets.push({ title: '', highlight: '' });
                    sets[idx][key] = v;
                    _tplSaveColorSets(cName, sets);
                });
                el.addEventListener('blur', () => {
                    if (_tplDirty[cName] && Object.keys(_tplDirty[cName]).length) _tplFlush(cName);
                });
            });
        });

        // Per-field multiple-link inputs. Each container owns one link field;
        // its rows carry data-tpl-link-set (their index). Mirrors the color-sets
        // wiring above and the legacy single-link handler (open-button state +
        // debounced save through _tplQueueSave → _tplFlush).
        root.querySelectorAll('[data-tpl-links]').forEach(container => {
            const cName = container.getAttribute('data-tpl-client');
            const field = container.getAttribute('data-tpl-link-field');
            container.querySelectorAll('[data-tpl-link-set]').forEach(el => {
                const idx = parseInt(el.getAttribute('data-tpl-link-set'), 10);
                el.addEventListener('input', () => {
                    const v = el.value;
                    const opener = container.querySelector(`[data-tpl-link-open="${idx}"]`);
                    if (opener) {
                        const ok = /^https?:\/\//i.test(v);
                        opener.classList.toggle('disabled', !ok);
                        opener.setAttribute('href', ok ? v : '#');
                    }
                    const links = _tplGetLinks(cName, field);
                    while (links.length <= idx) links.push('');
                    links[idx] = v;
                    _tplSaveLinks(cName, field, links);
                });
                el.addEventListener('blur', () => {
                    if (_tplDirty[cName] && Object.keys(_tplDirty[cName]).length) _tplFlush(cName);
                });
            });
        });
    }

    /* ── Linear View ── */
    /* -- Filming Plans source of truth ---------------------------------- */
    let filmingPlansData = null;       // { rows, bySlug, source, loadedAt }
    let filmingPlansLoadPromise = null;
    let filmingPlansLoadError = '';
    let _fpQuery = '';
    let _fpAddOpen = false;
    let _fpEditSlug = '';
    let _fpSavingSlug = '';
    let _fpStatusMsg = '';

    function _fpSlug(v) {
        try { return calClientSlug(v); } catch (e) { return String(v || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/^dr\.?\s+/, '').replace(/\s+(?:and|&)\s+/g, '&').replace(/[^a-z0-9&]+/g, ''); }
    }
    function _fpDocId(url) {
        const m = String(url || '').match(/\/d\/([A-Za-z0-9_-]+)/);
        return m ? m[1] : '';
    }
    function _fpNormalizePlan(row) {
        const clientName = String(row.client_name || row.clientName || row.client || '').trim();
        const docUrl = String(row.doc_url || row.docUrl || row.url || '').trim();
        const clientSlug = String(row.client_slug || row.clientSlug || _fpSlug(clientName)).trim();
        if (!clientName || !clientSlug) return null;
        return {
            clientSlug,
            clientName,
            docUrl,
            docId: String(row.doc_id || row.docId || _fpDocId(docUrl) || '').trim(),
            notes: String(row.notes || '').trim(),
            planMonths: String(row.plan_months || row.planMonths || '').trim(),
            updatedAt: String(row.updated_at || row.updatedAt || '').trim(),
            updatedBy: String(row.updated_by || row.updatedBy || '').trim(),
        };
    }
    function _fpSetData(rows, source) {
        const bySlug = new Map();
        const cleanRows = (rows || []).map(_fpNormalizePlan).filter(Boolean);
        cleanRows.sort((a, b) => a.clientName.localeCompare(b.clientName));
        cleanRows.forEach(row => bySlug.set(row.clientSlug, row));
        filmingPlansData = { rows: cleanRows, bySlug, source: source || 'supabase', loadedAt: Date.now() };
        try { if (typeof _linearInvalidatePlanMap === 'function') _linearInvalidatePlanMap(); } catch (e) {}
        return filmingPlansData;
    }
    async function _fpLoadFromSupabase(retried) {
        if (!FILMING_PLANS_EF_URL) throw new Error('Filming plans are not configured');
        const ident = await _syncviewRequireStaffIdentity();
        const resp = await fetch(FILMING_PLANS_EF_URL + '?_t=' + Date.now(), {
            method: 'GET',
            headers: { 'X-Syncview-Key': ident.key, Accept: 'application/json' },
        });
        if (resp.status === 401) {
            const active = _syncviewStaffIdentityForHeaders();
            if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) throw new Error('Staff sign-in changed.');
            _syncviewStaffIdentityClear();
            if (retried) throw new Error('Staff sign-in expired.');
            const replacement = await _syncviewOpenStaffIdentity({ reason: 'expired' });
            if (!replacement) throw new Error('Staff sign-in required.');
            return _fpLoadFromSupabase(true);
        }
        if (resp.status === 403) throw new Error('Staff access required.');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const payload = await resp.json();
        const active = _syncviewStaffIdentityForHeaders();
        if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) throw new Error('Staff sign-in changed.');
        if (!payload || !payload.ok || !Array.isArray(payload.plans)) throw new Error('Invalid filming plans response');
        return payload.plans;
    }
    async function _fpEnsureLoaded(force) {
        if (filmingPlansData && !force) return filmingPlansData;
        if (filmingPlansLoadPromise && !force) return filmingPlansLoadPromise;
        filmingPlansLoadError = '';
        filmingPlansLoadPromise = (async () => {
            try {
                const rows = await _fpLoadFromSupabase(false);
                _fpSavedWrite(rows);
                return _fpSetData(rows, 'edge-function');
            } catch (error) {
                filmingPlansLoadError = error && error.message ? error.message : String(error || '');
                throw error;
            } finally {
                filmingPlansLoadPromise = null;
            }
        })();
        return filmingPlansLoadPromise;
    }
    /* SAVED COPY. The plans list is small (one row per client), so it lives in
       localStorage, bound to the signed-in staff member (never the key) and
       dropped on sign-out by _fpPurgeSensitiveState. Client links never read or
       write it. The tab paints from it at once and refreshes behind. */
    const FP_SAVED_KEY = 'syncview_filmingPlansCache_v1';
    const FP_SAVED_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
    const FP_SAVED_MAX_BYTES = 900 * 1024;
    function _fpSavedOwner() {
        if (typeof _isClientLink !== 'undefined' && _isClientLink) return '';
        const ident = _syncviewStaffIdentityForHeaders();
        return ident && ident.member && ident.member.id ? String(ident.role || '') + ':' + String(ident.member.id) : '';
    }
    function _fpSavedWrite(rows) {
        try {
            const owner = _fpSavedOwner();
            if (!owner || !Array.isArray(rows)) return;
            const json = JSON.stringify({ owner, at: Date.now(), rows });
            if (json.length > FP_SAVED_MAX_BYTES) { localStorage.removeItem(FP_SAVED_KEY); return; }
            localStorage.setItem(FP_SAVED_KEY, json);
        } catch (e) {}
    }
    function _fpSavedRead() {
        try {
            const owner = _fpSavedOwner();
            if (!owner) return null;
            const o = JSON.parse(localStorage.getItem(FP_SAVED_KEY) || 'null');
            if (!o || o.owner !== owner || !Array.isArray(o.rows) || !(Date.now() - Number(o.at) < FP_SAVED_MAX_AGE_MS)) return null;
            return o.rows;
        } catch (e) { return null; }
    }
    function _fpRerenderSurfaces() {
        if (currentNav === 'filming-plans') _fpRenderPage();
        if (currentNav === 'templates') _maybeRerenderTemplates();
        if (currentNav === 'linear') updateLinearFilmingPlan();
        if (currentNav === 'kasper' && typeof _kasperState !== 'undefined' && _kasperState && _kasperState.tab === 'filming') {
            _kasperLoadFilming(true).catch(() => {});
        }
    }
    function _fpPurgeSensitiveState() {
        filmingPlansData = null;
        filmingPlansLoadPromise = null;
        filmingPlansLoadError = '';
        _fpEditSlug = '';
        _fpSavingSlug = '';
        try { _linearInvalidatePlanMap(); } catch (e) {}
        try { localStorage.removeItem(KASPER_FILMING_CACHE_KEY); } catch (e) {}
        try { localStorage.removeItem(FP_SAVED_KEY); } catch (e) {}
        try {
            if (typeof _kasperState !== 'undefined' && _kasperState) {
                _kasperState.filmingData = null;
                _kasperState.filmingLoadedAt = 0;
                _kasperState.filmingError = null;
                _kasperState.filmingExpanded = {};
            }
        } catch (e) {}
        try {
            if (typeof currentNav !== 'undefined' && currentNav === 'filming-plans') {
                const content = document.getElementById('content');
                if (content) content.innerHTML = '<div class="fp-view"><div class="fp-empty">Staff sign-in required to load filming plans.</div></div>';
            } else if (typeof currentNav !== 'undefined' && currentNav === 'templates') {
                _maybeRerenderTemplates();
            } else if (typeof currentNav !== 'undefined' && currentNav === 'linear') {
                updateLinearFilmingPlan();
            }
        } catch (e) {}
    }
    function _fpPlanForClient(nameOrSlug) {
        if (!filmingPlansData || !filmingPlansData.bySlug) return null;
        return filmingPlansData.bySlug.get(_fpSlug(nameOrSlug)) || null;
    }
    function _fpLinkForClient(nameOrSlug, fallback) {
        const row = _fpPlanForClient(nameOrSlug);
        return row && row.docUrl ? row.docUrl : (fallback || '');
    }
    function _fpRows() {
        return filmingPlansData && Array.isArray(filmingPlansData.rows) ? filmingPlansData.rows : [];
    }
    function _fpHost(url) {
        try { return new URL(url).hostname.replace(/^www\./, ''); } catch (e) { return ''; }
    }
    function _fpDomId(slug) {
        return String(slug || '').replace(/[^a-z0-9]+/gi, '_');
    }
    async function _fpPostPlan(payload, retried) {
        const ident = await _syncviewRequireStaffIdentity('onboarding');
        const resp = await fetch(FILMING_PLANS_EF_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Syncview-Key': ident.key, 'X-Syncview-Actor': ident.member.name, 'X-Syncview-Role': ident.role },
            body: JSON.stringify(payload),
        });
        let json = null;
        try { json = await resp.json(); } catch (e) {}
        if (resp.status === 401) {
            const active = _syncviewStaffIdentityForHeaders();
            if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) throw new Error('Staff sign-in changed.');
            _syncviewStaffIdentityClear();
            if (retried) throw new Error((json && json.error) || 'Staff sign-in expired.');
            const replacement = await _syncviewOpenStaffIdentity({ reason: 'expired' });
            if (!replacement) throw new Error('Staff sign-in required.');
            return _fpPostPlan(payload, true);
        }
        const active = _syncviewStaffIdentityForHeaders();
        if (_syncviewStaffIdentitySignature(active) !== _syncviewStaffIdentitySignature(ident)) throw new Error('Staff sign-in changed.');
        if (resp.status === 403) throw new Error('This onboarding action needs an Admin account. Sign out first to use another authorized account.');
        if (!resp.ok || !json || !json.ok) throw new Error((json && json.error) || ('HTTP ' + resp.status));
        return _fpNormalizePlan(json.plan || {});
    }
    function _fpSetStatus(msg) {
        _fpStatusMsg = msg || '';
        if (currentNav === 'filming-plans') _fpRenderPage();
    }
    function _fpRenderPage() {
        const content = document.getElementById('content');
        if (content) { content.innerHTML = renderFilmingPlansView(); mountFilmingPlansView(); }
    }
    function _fpSetQuery(v) {
        _fpQuery = String(v || '');
        _fpRenderPage();
        const input = document.getElementById('fpSearchInput');
        if (input) { input.focus(); input.setSelectionRange(input.value.length, input.value.length); }
    }
    function _fpToggleAdd() {
        if (!_syncviewStaffCan('onboarding')) { _syncviewOfferStaffSignIn('onboarding'); return; }
        _fpAddOpen = !_fpAddOpen;
        _fpEditSlug = '';
        _fpRenderPage();
    }
    function _fpEdit(slug) {
        if (!_syncviewStaffCan('onboarding')) { _syncviewOfferStaffSignIn('onboarding'); return; }
        _fpEditSlug = (_fpEditSlug === slug) ? '' : slug;
        _fpAddOpen = false;
        _fpRenderPage();
    }
    function _fpRefresh() {
        _fpSetStatus('');
        _fpEnsureLoaded(true).then(() => { _fpSetStatus('Refreshed'); _fpRenderPage(); }, e => _fpSetStatus((e && e.message) || 'Refresh failed'));
    }
    function _fpUpsertLocal(row) {
        const rows = _fpRows().filter(r => r.clientSlug !== row.clientSlug);
        rows.push(row);
        _fpSetData(rows, 'supabase');
        try { localStorage.removeItem(KASPER_FILMING_CACHE_KEY); } catch (e) {}
    }
    async function _fpSaveExisting(slug) {
        if (!_syncviewStaffCan('onboarding')) { _syncviewOfferStaffSignIn('onboarding'); return; }
        const row = _fpPlanForClient(slug);
        if (!row || _fpSavingSlug) return;
        const id = _fpDomId(slug);
        const docUrl = document.getElementById('fpDoc_' + id)?.value?.trim() || '';
        const notes = document.getElementById('fpNotes_' + id)?.value?.trim() || '';
        _fpSavingSlug = slug;
        _fpSetStatus('Saving...');
        try {
            const saved = await _fpPostPlan({ clientName: row.clientName, clientSlug: row.clientSlug, docUrl, notes, planMonths: row.planMonths });
            _fpUpsertLocal(saved);
            _fpEditSlug = '';
            _fpSetStatus('Saved');
            if (typeof showToast === 'function') showToast('Filming plan saved');
        } catch (e) {
            _fpSetStatus((e && e.message) || 'Save failed');
        } finally {
            _fpSavingSlug = '';
            _fpRenderPage();
        }
    }
    async function _fpSaveNew() {
        if (!_syncviewStaffCan('onboarding')) { _syncviewOfferStaffSignIn('onboarding'); return; }
        if (_fpSavingSlug) return;
        const clientName = document.getElementById('fpAddClient')?.value?.trim() || '';
        const docUrl = document.getElementById('fpAddDoc')?.value?.trim() || '';
        if (!clientName || !docUrl) { _fpSetStatus('Client and Doc link required'); return; }
        _fpSavingSlug = '__new';
        _fpSetStatus('Saving...');
        try {
            const saved = await _fpPostPlan({ clientName, docUrl });
            _fpUpsertLocal(saved);
            _fpAddOpen = false;
            _fpQuery = clientName;
            _fpSetStatus('Saved');
            if (typeof showToast === 'function') showToast('Filming plan saved');
        } catch (e) {
            _fpSetStatus((e && e.message) || 'Save failed');
        } finally {
            _fpSavingSlug = '';
            _fpRenderPage();
        }
    }
    function _fpDocIcon() {
        return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3v4a1 1 0 0 0 1 1h4M5 21V3a1 1 0 0 1 1-1h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }
    function _fpExternalIcon() {
        return '<svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M9.5 2.5h4v4M13.5 2.5L7 9M11 8.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }
    function _fpRowHtml(row) {
        const isUrl = /^https?:\/\//i.test(row.docUrl || '');
        const host = isUrl ? (_fpHost(row.docUrl) || 'Google Doc') : 'No Doc linked';
        const editing = _fpEditSlug === row.clientSlug;
        const id = _fpDomId(row.clientSlug);
        const open = isUrl
            ? `<a class="fp-btn" href="${_tplEscAttr(row.docUrl)}" target="_blank" rel="noopener">${_fpExternalIcon()} Open</a>`
            : `<button class="fp-btn" type="button" disabled>Open</button>`;
        const edit = editing ? `<div class="fp-edit" data-staff-capability="onboarding"${_syncviewStaffCan('onboarding') ? '' : ' hidden'}>
            <div class="fp-field"><label>Google Doc link</label><input class="fp-input" id="fpDoc_${id}" type="url" value="${_tplEscAttr(row.docUrl)}" autocomplete="off"></div>
            <div class="fp-field"><label>Notes</label><input class="fp-input" id="fpNotes_${id}" type="text" value="${_tplEscAttr(row.notes)}" autocomplete="off"></div>
            <div class="fp-edit-actions">
                <button class="fp-btn" type="button" onclick="_fpEdit('${_tplEscAttr(row.clientSlug)}')">Cancel</button>
                <button class="fp-btn primary" type="button" onclick="_fpSaveExisting('${_tplEscAttr(row.clientSlug)}')" ${_fpSavingSlug ? 'disabled' : ''}>Save</button>
            </div>
        </div>` : '';
        return `<div class="fp-row">
            <div class="fp-main">
                <span class="fp-doc-icon">${_fpDocIcon()}</span>
                <div class="fp-meta"><div class="fp-name">${_tplEsc(row.clientName)}</div><div class="fp-url">${_tplEsc(host)}</div></div>
            </div>
            <div class="fp-row-actions">${open}<button class="fp-btn" data-staff-capability="onboarding"${_syncviewStaffCan('onboarding') ? '' : ' hidden'} type="button" onclick="_fpEdit('${_tplEscAttr(row.clientSlug)}')">${editing ? 'Close' : 'Edit'}</button></div>
            ${edit}
        </div>`;
    }
    function _fpFilteredRows() {
        const q = _fpQuery.trim().toLowerCase();
        const rows = _fpRows();
        if (!q) return rows;
        return rows.filter(r => (r.clientName + ' ' + r.docUrl + ' ' + r.notes).toLowerCase().includes(q));
    }
    function _fpAddCardHtml() {
        if (!_fpAddOpen) return '';
        const roster = (() => { try { return getClientRoster(); } catch (e) { return []; } })();
        return `<div class="fp-add-card" data-staff-capability="onboarding"${_syncviewStaffCan('onboarding') ? '' : ' hidden'}>
            <datalist id="fpClientNames">${roster.map(n => `<option value="${_tplEscAttr(n)}"></option>`).join('')}</datalist>
            <div class="fp-form-grid">
                <div class="fp-field"><label>Client</label><input class="fp-input" id="fpAddClient" list="fpClientNames" autocomplete="off"></div>
                <div class="fp-field"><label>Google Doc link</label><input class="fp-input" id="fpAddDoc" type="url" autocomplete="off" placeholder="https://docs.google.com/document/d/..."></div>
            </div>
            <div class="fp-form-actions">
                <button class="fp-btn" type="button" onclick="_fpToggleAdd()">Cancel</button>
                <button class="fp-btn primary" type="button" onclick="_fpSaveNew()" ${_fpSavingSlug ? 'disabled' : ''}>Save</button>
            </div>
        </div>`;
    }
    function renderFilmingPlansView() {
        const hasData = !!filmingPlansData;
        const rows = _fpFilteredRows();
        const status = _fpStatusMsg ? `<span class="fp-count">${_tplEsc(_fpStatusMsg)}</span>` : `<span class="fp-count">${rows.length} / ${_fpRows().length}</span>`;
        const body = !hasData
            ? `<div class="fp-loading"><div class="tpl-skeleton fp-skel-row"></div><div class="tpl-skeleton fp-skel-row"></div><div class="tpl-skeleton fp-skel-row"></div></div>`
            : rows.length
                ? `<div class="fp-list">${rows.map(_fpRowHtml).join('')}</div>`
                : `<div class="fp-empty">No filming plans found.</div>`;
        return `<div class="fp-view">
            <div class="fp-head">
                <div><div class="fp-title">Filming Plans</div><div class="fp-sub">Master Google Docs for each client</div></div>
                <div class="fp-actions">
                    <button class="fp-btn" type="button" onclick="_fpRefresh()">Refresh</button>
                    <button class="fp-btn primary" data-staff-capability="onboarding"${_syncviewStaffCan('onboarding') ? '' : ' hidden'} type="button" onclick="_fpToggleAdd()">Add / update</button>
                </div>
            </div>
            <div class="fp-toolbar">
                <div class="search-bar-wrap">
                    <div class="search-bar-pill">
                        <input class="search-bar-input" id="fpSearchInput" type="text" placeholder="Search clients..." value="${_tplEscAttr(_fpQuery)}" oninput="_fpSetQuery(this.value)" autocomplete="off">
                        <button class="search-bar-icon" onclick="document.getElementById('fpSearchInput')?.focus()" title="Search">
                            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </button>
                    </div>
                </div>
                ${status}
            </div>
            ${_fpAddCardHtml()}
            ${body}
        </div>`;
    }
    function mountFilmingPlansView() {
        if (!filmingPlansData) {
            const saved = _fpSavedRead();
            if (saved) {
                const before = JSON.stringify(_fpSetData(saved, 'saved').rows);
                _fpEnsureLoaded(true).then(() => {
                    if (currentNav !== 'filming-plans' || _fpEditSlug || _fpSavingSlug) return;
                    if (JSON.stringify(filmingPlansData.rows) === before) return;
                    _fpRenderPage();
                }, () => {});
                _fpRenderPage();
                return;
            }
        }
        const hadData = !!filmingPlansData;
        _fpEnsureLoaded(false).then(() => { if (currentNav === 'filming-plans' && !hadData) _fpRenderPage(); }, e => _fpSetStatus((e && e.message) || 'Could not load filming plans'));
    }

    window._fpSetQuery = _fpSetQuery;
    window._fpToggleAdd = _fpToggleAdd;
    window._fpEdit = _fpEdit;
    window._fpRefresh = _fpRefresh;
    window._fpSaveExisting = _fpSaveExisting;
    window._fpSaveNew = _fpSaveNew;

    const LOG_SUBMISSION_WEBHOOK = 'https://synchrosocial.app.n8n.cloud/webhook/log-linear-submission';
    /*
     * The gateway's own cap on ONE credential-less submission, mirrored here so
     * the form can say so before sending rather than after being refused.
     * `MAX_PUBLIC_INTAKE_ITEMS` in supabase/functions/production-write/index.ts
     * is the authority; test/linear-intake-submission-cap.js fails if the two
     * numbers drift apart.
     *
     * Why this exists: on 2026-08-26 a videographer submitting through the
     * client link was refused eleven times between 19:53 and 20:39 with
     * "Submission was not completed", which names no cause, so he simply
     * pressed the button again. The request was 7.7KB -- nothing was too big
     * except the COUNT: video+thumbnail mode sends two deliverables per video,
     * so his shoot crossed 25 items and the gateway refused it whole, before
     * writing anything.
     */
    const LINEAR_INTAKE_MAX_ITEMS = 50;
    function _linearIntakeItemsPerVideo(mode) { return mode === 'both' ? 2 : 1; }
    function _linearIntakeTooLargeMessage(mode, itemCount) {
        const perVideo = _linearIntakeItemsPerVideo(mode);
        const maxVideos = Math.floor(LINEAR_INTAKE_MAX_ITEMS / perVideo);
        return 'This submission is ' + itemCount + ' deliverables and one submission can carry '
            + LINEAR_INTAKE_MAX_ITEMS + '. Send it in parts of up to ' + maxVideos
            + (maxVideos === 1 ? ' video' : ' videos')
            + (perVideo === 2 ? ' — video + thumbnail counts as two per video.' : '.')
            + ' Nothing was sent, so nothing is duplicated by splitting it.';
    }
    const LAST_LINK_KEY = 'syncview_last_link';
    const LINEAR_FORM_KEY = 'syncview_linear_form';
    const NATIVE_INTAKE_PENDING_KEY = 'syncview_native_intake_pending_v1';
    const LINEAR_RECEIPTS_KEY = 'syncview_linear_intake_receipts_v1';
    const LINEAR_INTAKE_HOLD_KEY = 'syncview_linear_intake_hold_v1';
    const LINEAR_INTAKE_LOAD_ID = Date.now().toString(36) + ':' + Math.random().toString(36).slice(2);
    const NAV_KEY = 'syncview_nav';
    const SMM_WEEKLY_ROUTES = ['smm-weekly-report', 'smm-weekly-reports'];
    function _isSmmWeeklyRoute(page) { return SMM_WEEKLY_ROUTES.includes(page); }
    let currentNav = 'home';
    /* Phase D: the last tab you clicked always wins. Every staff route change
       (navTo, render) bumps this; init() remembers the value it started with
       and gives up routing the moment it moves, so a landing tab that finishes
       loading after you left can never pull you back, rewrite the address bar
       or move focus. `var`, not `let`: navTo can run before this line has
       been evaluated on some boot paths, and a TDZ throw there would be worse
       than the bug. */
    var _syncviewNavEpoch = 0;
    const LINEAR_DEFAULT_VIDEO_COUNT = 12;
    let linearVideoCount = LINEAR_DEFAULT_VIDEO_COUNT;
    let linearJustCreated = false;
    let linearSubmitInFlight = null;
    let linearProjectsLoading = false;
    let linearProjectsLoaded = false;
    let linearProjectsLoadGeneration = 0;
    let linearLegacyProjects = [];



    function getLastLink() { return localStorage.getItem(LAST_LINK_KEY) || ''; }
    function saveLastLink(v) { if (v && v.trim()) localStorage.setItem(LAST_LINK_KEY, v.trim()); }

    function _linearPendingNativeClientSlug() {
        try {
            const pending = typeof _linearIntakeRead === 'function' ? _linearIntakeRead() : null;
            return String(pending && pending.payload && pending.payload.client_slug || '').trim();
        } catch (e) { return ''; }
    }

    /* WHEN THE ROSTER CANNOT BE TRUSTED, THE DROPDOWN FOLLOWS THE ROUTER.
       Submit routes with _writeUiRerouteUseGatewayFailClosed: if the reroute
       flag read failed, or landed with nothing usable, every client goes to the
       native gateway. The dropdown used the factual allowlist instead, which is
       empty in exactly that state, and the legacy Linear projects source that
       used to fill it is gone -- so a slow or failed flag read left Submit with
       no clients at all, while the submit path would have sent any of them
       natively. In that state the dropdown now lists every active native
       client, the same set the router would accept. With a usable roster it is
       unchanged: enrolled clients only. */
    function _linearRosterFailsNative() {
        try { return !!(_writeUiRerouteFlagFailed || _writeUiRerouteRosterUnusable); } catch (e) { return false; }
    }

    function _linearRebuildProjectSource() {
        const failNative = _linearRosterFailsNative();
        const enrolledBySlug = new Map(linearClientRows
            .filter(row => failNative || _writeUiRerouteUseGateway(row.slug))
            .map(row => [calClientSlug(row.slug), row]));
        const includedNativeSlugs = new Set();
        const mixedProjects = linearLegacyProjects.map(name => {
            const slug = calClientSlug(name);
            const row = enrolledBySlug.get(slug);
            if (!row) return name;
            includedNativeSlugs.add(slug);
            return String(row.display_name).trim();
        });
        enrolledBySlug.forEach((row, slug) => {
            if (!includedNativeSlugs.has(slug)) mixedProjects.push(String(row.display_name).trim());
        });
        linearProjects = [...new Set(mixedProjects.filter(Boolean))];
    }

    function _linearRenderProjectSource() {
        const q = document.getElementById('linearClientSearch')?.value || '';
        renderLinearSearchResults(q);
    }

    function _linearReconcileProjectSelection(previousClients, nextClients) {
        const input = document.getElementById('linearClientSearch');
        if (!input) return;
        const selectedSlug = calClientSlug(String(input.dataset.clientSlug || input.value || ''));
        if (!selectedSlug || !previousClients.has(selectedSlug) || nextClients.has(selectedSlug)) return;
        if (selectedSlug === calClientSlug(_linearPendingNativeClientSlug())) return;
        const legacyMatches = linearLegacyProjects.filter(name => calClientSlug(name) === selectedSlug);
        input.value = legacyMatches.length === 1 ? legacyMatches[0] : '';
        input.dataset.clientSlug = '';
        if (typeof updateLinearSearchGhost === 'function') updateLinearSearchGhost(input.value);
        if (typeof updateLinearTitle === 'function') updateLinearTitle();
        if (typeof updateLinearFilmingPlan === 'function') updateLinearFilmingPlan();
        if (typeof saveLinearForm === 'function') saveLinearForm();
    }

    function _linearRefreshProjectsForRerouteChange(previousClients, nextClients) {
        if (!linearProjectsLoaded && !linearProjectsLoading && !linearLegacyProjects.length && !linearClientRows.length) {
            return Promise.resolve();
        }
        // Rebuild synchronously from the last exact legacy response so a click
        // after de-enrollment cannot submit the former native display name.
        _linearRebuildProjectSource();
        _linearReconcileProjectSelection(previousClients, nextClients);
        _linearRenderProjectSource();
        // Refresh both sources in the background. The generation guard inside
        // fetchLinearProjects prevents an older cohort request from winning.
        return fetchLinearProjects();
    }

    async function fetchLinearProjects() {
        const generation = ++linearProjectsLoadGeneration;
        linearProjectsLoading = true;
        let legacyProjects = linearLegacyProjects.slice();
        let nativeRows = linearClientRows.slice();
        // The legacy source (the n8n Linear projects webhook) read Linear with a key
        // that is now revoked: every open of Submit failed with 401 and raised an
        // "n8n workflow failed" Slack alert, and returned no names. Every active
        // client is in the native cohort, so the dropdown comes from the clients
        // registry below; the legacy list stays whatever it already held.
        let nativeError = null;
        try {
            if (typeof _writeUiPrimeRerouteFlag === 'function') await _writeUiPrimeRerouteFlag();
            const pendingNativeClientSlug = _linearPendingNativeClientSlug();
            // The visible native source is cohort-only. A de-enrolled client may
            // still need its registry row to resume an already-checkpointed native
            // intake, but that recovery exception never changes dropdown names.
            if (_writeUiRerouteClients.size || pendingNativeClientSlug || _linearRosterFailsNative()) {
                const url = CAL_SUPABASE_URL + '/rest/v1/clients?select=slug,display_name,kind,active&active=eq.true&order=display_name.asc';
                const resp = await fetch(url, { headers: {
                    apikey: CAL_SUPABASE_ANON_KEY,
                    Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY,
                    Accept: 'application/json'
                }});
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const rows = await resp.json();
                nativeRows = (Array.isArray(rows) ? rows : []).filter(row => row && row.active !== false && row.slug && row.display_name);
            }
        } catch (e) {
            nativeError = e;
        } finally {
            if (generation === linearProjectsLoadGeneration) {
                linearLegacyProjects = legacyProjects;
                linearClientRows = nativeRows;
                _linearRebuildProjectSource();
                linearProjectsLoaded = true;
                linearProjectsLoading = false;
                _linearRenderProjectSource();
                if (nativeError) {
                    // A registry failure must never replace or blank the legacy
                    // project names used by every non-enrolled client.
                    console.error('[SyncView] Failed to fetch enrolled native clients:', nativeError);
                }
            }
        }
    }
