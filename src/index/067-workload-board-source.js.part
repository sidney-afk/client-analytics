  _wlDueWriteInFlight, _wlNativeDiffEnabled, _wlNativeDueReceiptGeneration,
  _wlNativeDueReceiptRetryAttempt, _wlNativeDueReceiptRetryPromise, _wlNativeDueReceiptRetryTimer,
  _wlNextNativeDueReceiptGeneration, _wlNextPlanLoadGeneration, _wlNextPlanWriteGeneration,
  _wlPendingNativeDueReceiptByTarget, _wlPlanLastWriteGeneration, _wlPlanLoadGeneration,
  _wlPlanSessionGeneration, _wlPlanWriteInFlight, _wlSetBackgroundRefreshMode,
  _wlSetBackgroundRefreshPromise, _wlSetNativeDueReceiptRetryAttempt,
  _wlSetNativeDueReceiptRetryPromise, _wlSetNativeDueReceiptRetryTimer,
  _wlTakeNativeDueReceiptRetryAttempt, _wlV2CheckWatermark, _wlV2Client, _wlV2EnsureSubscribed,
  _wlV2EnsureWatermarkPoll, _wlV2FetchIssues, _wlV2FetchLatestWatermark, _wlV2Ready, _wlV2Teardown,
  wlAdoptLinearMetadata, wlAdoptPlanRows, wlAnnouncePlanSaved, wlApplySettleAnimation,
