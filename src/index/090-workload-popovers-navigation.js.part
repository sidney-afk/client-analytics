    }
    function wlRenderTweakComments(comments) {
        // A row whose read FAILED is not a row with nothing to show. Both used
        // to arrive here as the same empty box, and "this deliverable has no
        // feedback" and "we could not ask" are identical pixels carrying
        // opposite facts — the second one an editor acts on by shipping the
        // cut unchanged. A row with no entry at all counts as a failure too:
        // silence is never evidence that a client said nothing.
        if (comments && comments.retired) {
            return '<div class="wl-tweak-comments-status is-unavailable" role="status">'
                + 'Feedback for this item isn&rsquo;t shown here. Use the calendar button on this row to open the post in the content calendar and check its review notes.</div>';
        }
        if (!comments || comments.failed) {
            return '<div class="wl-tweak-comments-status is-unavailable" role="status">'
                + 'Couldn&rsquo;t load this deliverable&rsquo;s feedback. Retry, or open the post in SyncView.</div>';
        }
        const native = !!(comments && comments.native);
        // One incomplete notice, used by both the populated and the empty
        // branch. An unread card projection is exactly the case where "no
        // feedback" would be a claim this browser cannot make.
        const incomplete = native && comments.sourceComplete === false
            ? '<div class="wl-tweak-comments-status">Some notes on the original card could not be read, so this list may be incomplete.</div>'
            : '';
        // A native read that found nothing says so, because after the Linear
        // exit this popover is the only reader and silence would be
        // indistinguishable from a broken one. A legacy read keeps rendering
        // nothing, which is this function's existing behaviour.
        if (!comments || !comments.length) {
            return native
                ? incomplete || '<div class="wl-tweak-comments-status">No feedback is available here. Open the post in SyncView to check its review notes.</div>'
                : '';
        }
        const shown = comments.slice(0, 3);
        const more = comments.length - shown.length;
        // One row per comment: author · body · time. No Frame/Linear link and
        // no card chrome — the body is the signal, everything else is muted.
        return shown.map(c => `<div class="wl-tweak-comment">
            <span class="wl-tweak-comment-author">${wlEscape(c.author || 'Unknown')}</span>${c.fromCard ? '<span class="wl-tweak-comment-time">from the card</span>' : ''}
            <span class="wl-tweak-comment-body" onclick="wlToggleTweakComment(this)" onkeydown="wlOnTweakCommentKey(event,this)">${wlEscape(c.body || '')}</span>
            <span class="wl-tweak-comment-time">${wlEscape(_calFmtCommentTime(c.createdAt))}</span>
        </div>`).join('') + (more > 0
            ? `<div class="wl-tweak-comment-more">+ ${more} older comment${more === 1 ? '' : 's'}</div>`
            : '') + incomplete;
    }
    // Expand/collapse is only offered on comments whose body genuinely
    // overflows its single row — a short comment that already fits has
    // nothing to expand, so it gets no pointer cursor. Must
    // run AFTER the comments are in the DOM, since it measures rendered width.
    function wlMarkClampedComments(scope) {
        scope.querySelectorAll('.wl-tweak-comment-body').forEach(el => {
            if (el.classList.contains('expanded') || el.classList.contains('is-clamped')) return;
            if (el.scrollWidth > el.clientWidth + 1) {
                el.classList.add('is-clamped');
                el.setAttribute('role', 'button');
                el.setAttribute('tabindex', '0');
                el.setAttribute('aria-expanded', 'false');
            }
        });
    }
    window.wlToggleTweakComment = function(el) {
        if (!el.classList.contains('is-clamped')) return;
        const open = el.classList.toggle('expanded');
        el.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    window.wlOnTweakCommentKey = function(e, el) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        wlToggleTweakComment(el);
    };

    function wlOpenRollupPopover(rollupEl) {
        const pop = document.getElementById('wlPopover');
        if (!pop) return;
        const parentId   = rollupEl.getAttribute('data-wl-parent-id') || '';
        const assigneeId = rollupEl.getAttribute('data-wl-assignee-id') || '';
        const clientName = rollupEl.getAttribute('data-wl-client') || '';
        const editorName = rollupEl.getAttribute('data-wl-editor-name') || '';
        const issueId     = rollupEl.getAttribute('data-wl-issue-id') || '';
        const deadlineIds = new Set((rollupEl.getAttribute('data-wl-deadline-open') || '').split('|').filter(Boolean));
        const inProgress = rollupEl.getAttribute('data-wl-in-progress') === '1';
        const dayISO     = rollupEl.getAttribute('data-wl-date') || '';

        // Pick the source list based on which rollup was clicked:
        //   - data-wl-source="active": planned + in-progress, deduped. Used
        //     by the "Editor workload (freest first)" chips, which want a
        //     view of every active sub-issue for that editor, regardless of
        //     status or day.
        //   - in-progress (strip): nowWorking covers every active "now" item
        //   - calendar cell: that day's exact work-day bucket
        //   - editor card total badge with no clientName: same source, but
        //     skip the client filter so the popover lists every sub-issue
        //     that editor owns for the day across all clients.
        const sourceMode = rollupEl.getAttribute('data-wl-source') || '';
        let source;
        if (issueId || deadlineIds.size) {
            source = wlState.allActiveSubs || [];
        } else if (sourceMode === 'active') {
            const seenIds = new Set();
            source = [];
            for (const s of [...(wlState.planned || []), ...(wlState.nowWorking || []), ...(wlState.tweaksNeeded || []), ...(wlState.overdue || []), ...(wlState.undated || [])]) {
                if (seenIds.has(s.id)) continue;
                seenIds.add(s.id);
                source.push(s);
            }
        } else if (sourceMode === 'overdue') {
            source = wlState.overdue;
        } else if (sourceMode === 'tweaks') {
            source = wlState.tweaksNeeded;
        } else if (sourceMode === 'inprogress' || inProgress) {
            source = wlState.nowWorking;
        } else if (dayISO) {
            source = wlState.calendarByDate.get(dayISO) || [];
        } else {
            source = wlState.planned;
        }
        const subs = source.filter(s =>
            (s.assigneeId || '') === assigneeId &&
            (clientName === '' || (s.clientName || '') === clientName) &&
            (!issueId || String(s.id || '') === issueId) &&
            (!deadlineIds.size || deadlineIds.has(String(s.id || '')))
        );

        subs.sort((a, b) => {
            const da = wlDisplayDate(a) || '9999-12-31';
            const db = wlDisplayDate(b) || '9999-12-31';
            if (da !== db) return da < db ? -1 : 1;
            const ca = a.clientName || '';
            const cb = b.clientName || '';
            if (ca !== cb) return ca.localeCompare(cb);
            return (a.identifier || '').localeCompare(b.identifier || '');
        });

        if (wlState.popoverAnchor && wlState.popoverAnchor !== rollupEl
            && typeof wlState.popoverAnchor.setAttribute === 'function') {
            wlState.popoverAnchor.setAttribute('aria-expanded', 'false');
        }
        wlState.popoverAnchor = rollupEl;
        rollupEl.setAttribute('aria-expanded', 'true');

        /* A PARENT BUTTON MAY NEVER RESOLVE TO A CHILD.

           Both link-outs below used to end `|| subs[0]?.url` / `||
           subs[0]?.identifier`. That fallback reads as harmless -- "open
           something rather than nothing" -- and is the one thing these two
           controls must not do: they are labelled and positioned as the
           PARENT, so substituting the first sub-issue does not degrade the
           button, it makes it lie. Owner report 2026-09-07, pressing
           "Open SyncView ->" on the In progress chip for one client and
           landing on the sub-issue `VID-13679` instead of its parent
           `VID-13678`, with nothing on the page saying a substitution had
           happened.

           `parentById` only holds parents that came back in THIS snapshot,
           and the board has several ways to hold fewer: the Linear-derived
           read pages `active = true` only, so a parent whose own row went
           inactive is absent while its children are still live, and the
           n8n `linear-issues` fallback (taken whenever the Supabase read
           throws) answers a different row set again. The sub itself carries
           `parentIdentifier` from `workload_issues` for exactly this case --
           which is all the SyncLinear deep link needs -- so that is the
           fallback, the same one `wlLooseParentInfo` already uses for the
           loose strips. It was added there on 2026-09-07 and never carried
           back here.

           When neither source can name the parent, the button is NOT
           rendered. An absent control is honest; one pointing at a child
           is not. The per-row links below still open each sub-issue, so
           nothing becomes unreachable -- only unlabelled-as-parent. */
        const parentRow   = parentId ? wlState.parentById.get(parentId) : null;
        const parentUrl   = clientName ? (parentRow?.url || '') : '';
        /* SyncView-first link-outs (owner request 2026-08-21: "it opens the
           original linear... make it so it opens our sync linear"). Post-flip
           the designers' work lives in the Production tab, so the popover's
           primary destinations point at ?prod=1 by Linear identifier -- the
           deep link the Production tab already resolves via displayId, falling
           back to its list view for anything it cannot find. Linear itself
           stays one small click away on every row: written when video was
           still Linear-authoritative, so "hiding the source of truth" no
           longer describes video precisely after the 2026-08-28 flip -- but
           the conclusion holds anyway. Linear stays the live rollback path
           for roughly two weeks past the flip, and the link is a reference
           either way, so the extra icon is still worth less than removing a
           working escape hatch. */
        const parentIdent = clientName
            ? (parentRow?.identifier || String(subs[0]?.parentIdentifier || ''))
            : '';
        /* A PILL IS VIDEOS, SO THE PRIMARY ACTION OPENS A VIDEO.

           Owner, 2026-09-07, after being sent to the parent and having to
           drill down himself to read the status he came for: "when you open
           a pill, you're opening a video, so you're supposed to go to that
           sub-issue, which has the status In progress."

           He is describing what the chip MEANS. A client chip reading "1"
           in the In progress column is not a statement about the client or
           the parent, it is one video that is in progress, and the status the
           chip just asserted lives on that sub-issue. The parent cannot
           carry it: for a native card the parent is a SYNTHETIC batch node
           whose status is hardcoded `todo` and never updated
           (_prodResolveBatchParentNodes), so sending the reader there
           answered his question with the one value guaranteed to be wrong.

           So when the group is ONE sub-issue there is no ambiguity about
           which video is meant, and the primary button opens it. With more
           than one, no single row is "the video" -- picking one would be a
           guess -- so the button stays on the parent and says so, and the
           rows below remain the way to each individual video. */
        const soleSub = subs.length === 1 ? subs[0] : null;
        /* Route by the NATIVE id first, exactly as the rows below and the loose
           strips do. A deliverable created after the outbound flip carries no
           `linear_identifier` at all, so keying the primary action on
           `identifier` alone sends the most prominent button on a one-video
           popover to the SYNTHETIC batch parent -- whose status is hardcoded
           `todo` and is the one value guaranteed to contradict the pill the
           reader just clicked -- or renders no button at all when the parent
           has no identifier either. `?prod=1&d=` resolves a `del_…` id because
           _prodIssue() matches on `id` OR `displayId`. */
        const soleSubIdent = String(soleSub?.nativeId || soleSub?.identifier || '');
        /* A NATIVE PARENT IS A BATCH, NOT AN ISSUE, so its deep link is
           `?prod=1&batch=<batch id>` -- exactly what the loose strips already
           build via wlLooseParentInfo().nativeBatchId. Owner report
           2026-09-20, cutoff day, pressing "Open parent ->" on a two-video
           pill: the native view answers `identifier` = the batch NAME for a
           batch row (workload_issues_native_v1, parent arm), so `?d=<name>`
           can resolve nothing and Production published "<batch name> has no
           row in Production". Same class as OPEN_REPAIRS 218/221: one more
           site assuming every parent carries a Linear identifier. */
        /* Judged by the subs that BELONG to the clicked parent, not by any row
           in the popover: `subs` is filtered by assignee and client only, so a
           legacy-parent chip can share the list with a native row of another
           post during a mixed-authority state, and "any native row" would
           send that legacy parent to `?batch=<legacy uuid>`, which resolves
           nothing (Codex P2 on PR 1454). */
        const nativeBatchId = parentId && subs.some(s => s && s.workloadSource === 'native'
                && String(s.parentId || '') === String(parentId))
            ? String(parentId) : '';
        const openIdent = soleSubIdent || parentIdent;
        const openIsParent = !soleSubIdent && !!(parentIdent || nativeBatchId);
        const parentSyncUrl = openIsParent && nativeBatchId
            ? (location.pathname + '?prod=1&batch=' + encodeURIComponent(nativeBatchId))
            : openIdent
                ? (location.pathname + '?prod=1&d=' + encodeURIComponent(openIdent))
                : '';
        const openLabel = openIsParent ? 'Open parent →' : 'Open SyncView →';
        // The Linear escape hatch follows the primary target rather than
        // silently pointing somewhere else than the button beside it.
        const openLinearUrl = soleSub ? String(soleSub.url || '') : parentUrl;
        const parentTitle = parentRow?.title || clientName || editorName || '';
        const headerTitle = clientName || editorName || parentTitle;
        pop.setAttribute('aria-label', headerTitle ? ('Workload details for ' + headerTitle) : 'Workload details');

        const templatesUrl = clientName
            ? (location.pathname + location.search + '#templates/' + encodeURIComponent(clientName))
            : '';
        const templatesLink = templatesUrl
            ? `<a class="workload-popover-templates" href="${wlEscape(templatesUrl)}" target="_blank" rel="noopener noreferrer" aria-label="Open ${wlEscape(clientName)} templates in a new tab">
                <span>Templates</span>
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M6.5 2.5h3v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9.5 2.5L5 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M9.5 6.5v3h-7v-7h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>`
            : '';

        const header = `<div class="workload-popover-head">
            <div class="workload-popover-head-title-group">
                <span class="workload-popover-head-title">${wlEscape(headerTitle)}</span>
                ${templatesLink}
            </div>
            ${parentSyncUrl ? `<a class="workload-popover-parent" href="${wlEscape(parentSyncUrl)}" target="_blank" rel="noopener noreferrer">${wlEscape(openLabel)}</a>` : ''}
            ${openLinearUrl ? `<a class="workload-popover-parent workload-popover-parent-linear" href="${wlEscape(openLinearUrl)}" target="_blank" rel="noopener noreferrer">Linear ↗</a>` : ''}
            <button type="button" class="workload-popover-close" data-wl-popover-close="1" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
        </div>`;
        // When the popover spans multiple clients (editor-total badge), label
        // each row with the client too so it's obvious whose work it is.
        const showClient = !clientName;
        const items = subs.map(s => {
            const explicitPlan = wlPlanDate(s) || null;
            const workDate = wlDisplayDate(s) || '';
            const placementMode = wlPlacementMode(s);
            const savingPlan = _wlPlanWriteInFlight.has(String(s.id || ''));
            const savingDue = _wlDueWriteInFlight.has(String(s.id || ''));
            const canEditPlan = !wlIsTweaksNeeded(s) && wlPlanEditingEnabled() && !savingPlan;
            const canEditDue = !wlIsTweaksNeeded(s) && wlLinearEditingEnabled(s) && !savingDue;
            const dateId = 'wlDueDate_' + String(s.id || '').replace(/[^A-Za-z0-9_-]/g, '_');
            const planControl = wlIsTweaksNeeded(s) ? '' : `<div class="workload-popover-plan" data-wl-due-issue="${wlEscape(s.id || '')}">
                <div class="workload-popover-plan-line">
                    <span class="workload-popover-plan-label">Due date</span>
                    ${_svDateHtml(dateId, s.dueDate || '', { placeholder: 'Choose due date', disabled: !canEditDue, todayPolicy: 'workload' })}
                    ${savingDue ? '<span class="workload-popover-plan-saving" role="status">Saving…</span>' : ''}
                    ${explicitPlan ? `<button type="button" class="workload-plan-clear" data-wl-plan-clear="${wlEscape(s.id || '')}"${canEditPlan ? '' : ' disabled'}>${wlPlanOriginHtml(placementMode, false)} Use automatic plan</button>` : ''}
                </div>
            </div>`;
            const clientTag = showClient && s.clientName
                ? `<span class="workload-popover-item-client">${wlEscape(s.clientName)}</span>`
                : '';
            const calBtn = s.clientName
                ? `<button type="button" class="workload-popover-item-cal" aria-label="Open in the content calendar" onclick="wlOpenInContentCalendar(${_jsAttrArg(s.clientName)},${_jsAttrArg(s.identifier || '')},${_jsAttrArg(s.nativeId || '')})"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="12" height="11" rx="2"/><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"/></svg></button>`
                : '';
            // A sub-issue sitting in "Tweak Needed" gets a comment preview
            // box under its row — filled asynchronously below from Linear.
            const tweakBox = wlIsTweaksNeeded(s)
                ? `<div class="wl-tweak-comments" data-wl-comments-for="${wlEscape(s.id)}"><div class="wl-tweak-comments-status" role="status" aria-label="Loading">${_svSkel('sv-skeleton-line', 'width:72%;height:10px;')}</div></div>`
                : '';
            // Route by the NATIVE id first, exactly as the loose strips do. A
            // deliverable created after the outbound flip carries neither
            // `identifier` nor `url`, so keying on the identifier renders
            // href="" and the click reloads the Workload page instead of
            // opening the deliverable. `?prod=1&d=` resolves a `del_…` id
            // because _prodIssue() matches on `id` OR `displayId`.
            const rowSyncUrl = wlSyncLinearUrl(s.nativeId || s.identifier) || s.url || '';
            const linearBtn = s.url
                ? `<a class="workload-popover-item-cal workload-popover-item-linear" href="${wlEscape(s.url)}" target="_blank" rel="noopener noreferrer" aria-label="Open in Linear" data-tip="Open in Linear"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.2 9.8 9.8 6.2M7 4.6h4.4V9"/><rect x="2.2" y="2.2" width="11.6" height="11.6" rx="2.6"/></svg></a>`
                : '';
            return `<div class="workload-popover-item">
                <a class="workload-popover-item-main" href="${wlEscape(rowSyncUrl)}" target="_blank" rel="noopener noreferrer">
                    <span class="workload-popover-item-title">${wlEscape(s.title || s.identifier)}</span>
                    ${wlWorkloadBadgeHtml(s, false)}
                    ${clientTag}
                    ${wlDeadlineTagHtml(s.dueDate, workDate)}
                </a>
                ${calBtn}
                ${linearBtn}
            </div>${planControl}${tweakBox}`;
        }).join('') || '<div class="workload-popover-item" style="color:var(--text-muted);cursor:default;">No upcoming sub-issues.</div>';

        // Frame.io disclaimer + comment fetch — only when the popover holds
        // at least one tweaks-needed sub-issue. Comments come from the
        // native production-comments read (see wlFetchTweakComments);
        // the token guard stops a slow response from painting into a
        // popover that has since been reopened on another rollup.
        const tweakSubs = subs.filter(wlIsTweaksNeeded);
        // The Frame.io reminder belongs on the per-client / tweak views where
        // the editor is reading tweak notes. The editor-workload chips
        // (source="active") are a capacity view — "how busy is this editor" —
        // so the note is just noise there and is skipped.
        const frameNote = (tweakSubs.length && sourceMode !== 'active')
            ? `<div class="wl-tweak-frame-note">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8L15 14H1L8 1.8z"/><path d="M8 6.5v3.5"/><circle cx="8" cy="12" r="0.4" fill="currentColor"/></svg>
                <span><strong>Always check Frame.io too.</strong></span>
                <span class="wl-tweak-frame-info" role="img" aria-label="Tweaks left as Frame.io comments can't be shown here — sub-issues aren't linked to Frame. The comments below are the ones sent through SyncView (clients can't comment on Frame.io).">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.4"/><path d="M8 7.2v4"/><circle cx="8" cy="4.8" r="0.5" fill="currentColor"/></svg>
                </span>
            </div>`
            : '';

        pop.innerHTML = header + frameNote + items;
        // EVERY replacement advances the feedback generation, not only one that
        // starts a read of its own. The line above just destroyed the previous
        // popover's feedback boxes; a rollup with no tweak rows destroys them
        // just as thoroughly, and leaving the generation alone there let the
        // previous read keep paging and draining against content that no longer
        // holds a single feedback box.
        const token = ++_wlTweakCommentsToken;

        if (tweakSubs.length) {
            const live = () => token === _wlTweakCommentsToken && pop.classList.contains('open');
            // Whether the ANSWER is still wanted. This is deliberately NOT read
            // off the DOM: `pop` gets its `open` class a few lines below this
            // block, so every sample taken before then sees a popover that is
            // not open YET, and a popover closed before its first page returned
            // was never sampled while open at all — the drain then ran to
            // completion for a popover nobody was looking at, which is exactly
            // when the budget protection had to work. The generation counter is
            // recorded rather than inferred: it advances on every open above and
            // on every close in wlClosePopover.
            const abandoned = () => token !== _wlTweakCommentsToken;
            // PAINT EACH ROW AS IT SETTLES. Every deliverable in this popover is
            // its own independent read, so a row that answered has no reason to
            // sit on a skeleton until its slowest neighbour has finished timing
            // out. The pool and deadline in wlFetchTweakComments bound how long
            // that slowest neighbour can take; this is what stops it costing the
            // fast rows anything at all.
            const painted = new Set();
            const paintRow = (id, rows) => {
                if (!live()) return;
                const sel = (window.CSS && CSS.escape) ? CSS.escape(id) : String(id).replace(/"/g, '');
                const box = pop.querySelector('[data-wl-comments-for="' + sel + '"]');
                if (!box) return;
                box.innerHTML = wlRenderTweakComments(rows);
                painted.add(id);
                // Clamp detection measures rendered width, so it runs on this
                // row's box now rather than on a whole popover that is still
                // filling in.
                wlMarkClampedComments(box);
            };
            wlFetchTweakComments(tweakSubs.map(s => s.id), paintRow, abandoned).then(byId => {
                if (!live()) return;
                // Backstop for rows the progressive call could not place — a box
                // that had not been laid out yet. A row already painted is left
                // ALONE rather than repainted with identical markup: the reads
                // now take seconds during which an editor can expand a comment,
                // and rewriting innerHTML under them would collapse it.
                for (const s of tweakSubs) { if (!painted.has(s.id)) paintRow(s.id, byId[s.id]); }
                wlMarkClampedComments(pop);
            }).catch(() => {
                if (token !== _wlTweakCommentsToken || !pop.classList.contains('open')) return;
                pop.querySelectorAll('.wl-tweak-comments').forEach(box => {
                    box.innerHTML = '<div class="wl-tweak-comments-status">Couldn&rsquo;t load feedback. Retry, or open the post in SyncView.</div>';
                });
            });
        }

        // Position: anchored below the clicked rollup, clamped to viewport.
        const rect = rollupEl.getBoundingClientRect();
        pop.classList.add('open');
        pop.setAttribute('aria-hidden', 'false');
        const popW = Math.min(pop.offsetWidth || 320, 380);
        let left = window.scrollX + rect.left;
        const maxLeft = window.scrollX + window.innerWidth - popW - 10;
        if (left > maxLeft) left = maxLeft;
        if (left < window.scrollX + 10) left = window.scrollX + 10;
        const popH = Math.min(pop.offsetHeight || 320, Math.max(160, window.innerHeight - 20));
        const below = window.scrollY + rect.bottom + 6;
        const above = window.scrollY + rect.top - popH - 6;
        const maxTop = window.scrollY + window.innerHeight - popH - 10;
        let top = below;
        if (below + popH > window.scrollY + window.innerHeight - 10 && above >= window.scrollY + 10) top = above;
        if (top > maxTop) top = maxTop;
        if (top < window.scrollY + 10) top = window.scrollY + 10;
        pop.style.left = left + 'px';
        pop.style.top  = top + 'px';
        const focusTarget = pop.querySelector('[data-wl-popover-close]');
        if (focusTarget && typeof focusTarget.focus === 'function') focusTarget.focus();

        // Spotlight: dim everything on the calendar that isn't part of this
        // exact work-day rollup.
        wlApplySpotlight(subs);
    }

    function wlApplySpotlight(subs) {
        wlClearSpotlight();
        if (!subs || !subs.length) return;
        const wrap = document.querySelector('#wlBody .workload-grid-wrap');
        const grid = wrap ? wrap.querySelector('.workload-grid, .workload-timeline-stage') : null;
        if (!wrap || !grid) return;

        // Only work in the calendar bucket participates. Tweaks remain
        // strip-only even when they retain a saved plan override.
        const plannedIds = new Set((wlState.planned || []).map(s => s.id));
        const subsOnCalendar = subs.filter(s => wlDisplayDate(s) && plannedIds.has(s.id));
        if (!subsOnCalendar.length) return;

        // Match keys: per-client chips use assignee|client|date; editor-total
        // badges aggregate across clients so they use assignee|*|date.
        const chipKeys = new Set();
        const totalKeys = new Set();
        const issueIds = new Set();
        for (const s of subsOnCalendar) {
            const p = wlDisplayDate(s);
            chipKeys.add(`${s.assigneeId || ''}|${s.clientName || ''}|${p}`);
            totalKeys.add(`${s.assigneeId || ''}|${p}`);
            issueIds.add(String(s.id || ''));
        }

        wrap.setAttribute('data-wl-spotlight', '1');

        grid.querySelectorAll('.workload-day-card-chip, .workload-timeline-plan-chip').forEach(chip => {
            const aid = chip.getAttribute('data-wl-assignee-id') || '';
            const cn  = chip.getAttribute('data-wl-client') || '';
            const dt  = chip.getAttribute('data-wl-date') || '';
            if (chipKeys.has(`${aid}|${cn}|${dt}`)) chip.setAttribute('data-wl-match', '1');
        });
        grid.querySelectorAll('.workload-day-card-total, .workload-timeline-day-total').forEach(tot => {
            const aid = tot.getAttribute('data-wl-assignee-id') || '';
            const dt  = tot.getAttribute('data-wl-date') || '';
            if (totalKeys.has(`${aid}|${dt}`)) tot.setAttribute('data-wl-match', '1');
        });
        grid.querySelectorAll('.workload-plan-item').forEach(item => {
            if (issueIds.has(item.getAttribute('data-wl-issue-id') || '')) item.setAttribute('data-wl-match', '1');
        });
        grid.querySelectorAll('.workload-timeline-due, .workload-timeline-lines [data-wl-deadline-ids]').forEach(endpoint => {
            const endpointIds = (endpoint.getAttribute('data-wl-deadline-ids')
                || endpoint.getAttribute('data-wl-deadline-open') || '').split('|').filter(Boolean);
            if (endpointIds.some(id => issueIds.has(id))) endpoint.setAttribute('data-wl-match', '1');
        });
        // An editor card "matches" if any of its chips/totals matched, so the
        // dimming reads as a card-level effect, not a chip-level one.
        grid.querySelectorAll('.workload-day-card').forEach(card => {
            if (card.querySelector('[data-wl-match="1"]')) card.setAttribute('data-wl-match', '1');
        });

    }

    function wlClearSpotlight() {
        document.querySelectorAll('.workload-grid-wrap[data-wl-spotlight]').forEach(w => {
            w.removeAttribute('data-wl-spotlight');
        });
        document.querySelectorAll('[data-wl-match]').forEach(el => el.removeAttribute('data-wl-match'));
    }

    function wlClosePopover(returnFocus) {
        const pop = document.getElementById('wlPopover');
        if (!pop) return;
        const anchor = wlState.popoverAnchor;
        if (anchor && typeof anchor.setAttribute === 'function') anchor.setAttribute('aria-expanded', 'false');
        pop.classList.remove('open');
        pop.setAttribute('aria-hidden', 'true');
        // Closing is the other end of the feedback generation opened in
        // wlOpenRollupPopover. Recording it here is what lets an in-flight
        // tweak-comment drain stop spending the actor-wide read budget on a
        // popover nobody is looking at; inferring it from this class instead
        // missed the case where the popover closed before its first page
        // returned. (Lane D edit inside a Workload function — noted on the PR.)
        _wlTweakCommentsToken++;
        wlState.popoverAnchor = null;
        wlClearSpotlight();
        // Paint any data refresh that was deferred while the popover was open.
        if (wlState.renderQueued) {
            wlState.renderQueued = false;
            renderWorkloadAll();
        } else if (returnFocus && anchor && document.contains(anchor) && typeof anchor.focus === 'function') {
            anchor.focus();
        }
    }

    function onLinearSearchInput() {
        const input = document.getElementById('linearClientSearch');
        const q = input?.value || '';
        if (input) {
            const selected = _linearResolveClientRow(q, input.dataset.clientSlug || '');
            input.dataset.clientSlug = selected ? selected.slug : '';
        }
        renderLinearSearchResults(q);
        updateLinearSearchGhost(q);
        openLinearSearchDropdown();
        updateLinearTitle();
        updateLinearFilmingPlan();
        saveLinearForm();
    }

    function onLinearSearchFocus() {
        renderLinearSearchResults(document.getElementById('linearClientSearch')?.value || '');
        openLinearSearchDropdown();
    }

    function onLinearSearchKey(e) {
        if (e.key === 'Escape') {
            const box = document.getElementById('linearSearchDropdown');
            const ghost = document.getElementById('linearSearchGhost');
            if (box) box.classList.remove('open');
            if (ghost) ghost.innerHTML = '';
            document.getElementById('linearClientSearch')?.blur();
            return;
        }
        if (e.key !== 'Enter') return;
        const q = document.getElementById('linearClientSearch')?.value.trim();
        if (!q) return;
        const names = linearProjects;
        const starts = names.filter(n => n.toLowerCase().startsWith(q.toLowerCase()));
        const contains = names.filter(n => !n.toLowerCase().startsWith(q.toLowerCase()) && n.toLowerCase().includes(q.toLowerCase()));
        const first = [...starts, ...contains][0];
        if (first) selectLinearProject(first);
    }

    function openLinearSearchDropdown() {
        const box = document.getElementById('linearSearchDropdown');
        if (!box || box.classList.contains('open')) return;
        box.classList.add('open');
        const close = (e) => {
            const wrap = document.getElementById('linearSearchWrap');
            if (wrap && !wrap.contains(e.target)) { box.classList.remove('open'); document.removeEventListener('click', close); }
        };
        setTimeout(() => document.addEventListener('click', close), 0);
    }

    function updateLinearSearchGhost(q) {
        const ghost = document.getElementById('linearSearchGhost');
        if (!ghost) return;
        const q2 = q.trim().toLowerCase();
        if (!q2) { ghost.innerHTML = ''; return; }
        const names = linearProjects;
        const starts = names.filter(n => n.toLowerCase().startsWith(q2));
        const contains = names.filter(n => !n.toLowerCase().startsWith(q2) && n.toLowerCase().includes(q2));
        const first = [...starts, ...contains][0];
        if (!first) { ghost.innerHTML = ''; return; }
        if (first.toLowerCase().startsWith(q2)) {
            const typed = first.slice(0, q.length);
            const rest = first.slice(q.length);
            ghost.innerHTML = `<span style="color:transparent;white-space:pre">${typed}</span><span style="color:var(--text-muted);opacity:0.55;white-space:pre">${rest}</span><span style="margin-left:8px;font-size:0.65rem;color:var(--text-muted);opacity:0.4;background:var(--border);border-radius:3px;padding:1px 5px;flex-shrink:0;">↵</span>`;
        } else {
            ghost.innerHTML = `<span style="color:transparent;white-space:pre">${q}</span><span style="margin-left:8px;font-size:0.65rem;color:var(--text-muted);opacity:0.4;background:var(--border);border-radius:3px;padding:1px 5px;flex-shrink:0;">↵ ${first}</span>`;
        }
    }

    function renderLinearSearchResults(q) {
        const el = document.getElementById('linearSearchResults');
        if (!el) return;
        if (linearProjectsLoading) { el.innerHTML = _svLoadingSkeletonHtml('linear-search'); return; }
        if (!linearProjects.length) { el.innerHTML = '<div class="linear-search-empty">No projects loaded</div>'; return; }
        const q2 = q.trim().toLowerCase();
        if (!q2) {
            el.innerHTML = linearProjects.slice(0, 8).map(name =>
                `<div class="linear-search-suggestion" onclick="selectLinearProject(${_jsAttrArg(name)},${_jsAttrArg((_linearResolveClientRow(name) || {}).slug || '')})"><span>${wlEscape(name)}</span></div>`
            ).join('');
            return;
        }
        const starts = linearProjects.filter(n => n.toLowerCase().startsWith(q2));
        const contains = linearProjects.filter(n => !n.toLowerCase().startsWith(q2) && n.toLowerCase().includes(q2));
        const matches = [...starts, ...contains];
        if (!matches.length) { el.innerHTML = '<div class="linear-search-empty">No projects found</div>'; return; }
        el.innerHTML = matches.slice(0, 6).map(name =>
            `<div class="linear-search-suggestion" onclick="selectLinearProject(${_jsAttrArg(name)},${_jsAttrArg((_linearResolveClientRow(name) || {}).slug || '')})"><span>${highlightMatch(name, q.trim())}</span></div>`
        ).join('');
    }

    function _linearResolveClientRow(name, slug) {
        const wantedSlug = String(slug || '').trim();
        const wantedName = String(name || '').trim().toLowerCase();
        if (wantedSlug) {
            const bySlug = linearClientRows.find(row => String(row && row.slug || '') === wantedSlug);
            if (bySlug && String(bySlug.display_name || '').trim().toLowerCase() === wantedName) return bySlug;
        }
        const matches = linearClientRows.filter(row => String(row && row.display_name || '').trim().toLowerCase() === wantedName);
        return matches.length === 1 ? matches[0] : null;
    }

    function selectLinearProject(name, slug) {
        const inp = document.getElementById('linearClientSearch');
        const box = document.getElementById('linearSearchDropdown');
        const ghost = document.getElementById('linearSearchGhost');
        if (inp) {
            inp.value = name;
            inp.dataset.clientSlug = String(slug || ((_linearResolveClientRow(name) || {}).slug || ''));
        }
        if (box) box.classList.remove('open');
        if (ghost) ghost.innerHTML = '';
        updateLinearTitle();
        updateLinearFilmingPlan();
        saveLinearForm();
    }

    // Filming plans are staff-only data. A client intake link must never try to
    // load them in the browser: the receiving writer resolves the plan from the
    // client server-side instead. Keep the state explicit so a failed staff
    // read cannot masquerade as a successful "no plan for this client" read.
    let _linearPlanMap = null;          // normalized client name -> doc_url; {} means loaded, none matched
    let _linearPlanMapLoading = false;
    let _linearPlanMapState = 'idle';   // idle | loading | loaded | failed | server
    let _linearPlanMapError = '';
    let _linearResolvedPlanUrl = '';

    function _linearIntakeUsesServerPlanResolution() {
        return !!(document.body && document.body.classList.contains('intake-mode'));
    }

    function _linearInvalidatePlanMap() {
        _linearPlanMap = null;
        _linearPlanMapLoading = false;
        _linearPlanMapState = 'idle';
        _linearPlanMapError = '';
        _linearResolvedPlanUrl = '';
    }

    function _normLinearName(s) {
        return String(s || '').toLowerCase()
            .replace(/\b(dr|mr|mrs|ms|prof)\.?\s+/g, '')
            .replace(/&/g, 'and')
            .replace(/[^a-z0-9]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    async function loadLinearPlanMap(force) {
        if (_linearIntakeUsesServerPlanResolution()) {
            _linearPlanMap = null;
            _linearPlanMapLoading = false;
            _linearPlanMapState = 'server';
            _linearPlanMapError = '';
            _linearResolvedPlanUrl = '';
            updateLinearFilmingPlan();
            return;
        }
        if (_linearPlanMap !== null && !force) { updateLinearFilmingPlan(); return; }
        if (_linearPlanMapLoading) return;
        _linearPlanMapLoading = true;
        _linearPlanMapState = 'loading';
        _linearPlanMapError = '';
        try {
            const data = await _fpEnsureLoaded(!!force);
            const map = {};
            (data.rows || []).forEach(row => {
                if (row.clientName && row.docUrl) map[_normLinearName(row.clientName)] = row.docUrl;
            });
            _linearPlanMap = map;
            _linearPlanMapState = 'loaded';
        } catch (e) {
            _linearPlanMap = null;
            _linearPlanMapState = 'failed';
            _linearPlanMapError = String((e && e.message) || e || 'Could not load filming plans.');
        } finally {
            _linearPlanMapLoading = false;
            updateLinearFilmingPlan();
        }
    }

    function updateLinearFilmingPlan() {
        const el = document.getElementById('linearFilmingPlansDisplay');
        if (!el) return;
        const client = document.getElementById('linearClientSearch')?.value?.trim() || '';
        if (!client) {
            _linearResolvedPlanUrl = '';
            el.textContent = 'Select a client…';
            el.classList.add('empty'); el.classList.remove('warn');
            el.removeAttribute('title');
            saveLinearForm();
            return;
        }
        if (_linearPlanMapState === 'server') {
            _linearResolvedPlanUrl = '';
            el.textContent = 'Resolved securely when submitted.';
            el.classList.add('empty'); el.classList.remove('warn');
            el.removeAttribute('title');
            saveLinearForm();
            return;
        }
        if (_linearPlanMapState === 'failed') {
            _linearResolvedPlanUrl = '';
            el.textContent = '⚠ Could not load filming plans. The server will resolve this when submitted.';
            el.title = _linearPlanMapError;
            el.classList.add('warn'); el.classList.remove('empty');
            saveLinearForm();
            return;
        }
        if (_linearPlanMap === null) {
            el.innerHTML = _svSkel('linear-plan-skeleton');
            el.classList.add('empty'); el.classList.remove('warn');
            loadLinearPlanMap();
            return;
        }
        const url = _linearPlanMap[_normLinearName(client)] || '';
        _linearResolvedPlanUrl = url;
        if (url) {
            el.textContent = url;
            el.title = url;
            el.classList.remove('empty', 'warn');
        } else {
            el.textContent = '⚠ No filming plan found for this client';
            el.removeAttribute('title');
            el.classList.add('warn'); el.classList.remove('empty');
        }
        saveLinearForm();
    }

    function buildLinearTitle() {
        const client = document.getElementById('linearClientSearch')?.value || '';
        return _linearIntakeBatchTitle(client);
    }

    function updateLinearTitle() {
        const el = document.getElementById('linearTitleDisplay');
        if (!el) return;
        const input = document.getElementById('linearClientSearch');
        const hold = _linearSubmissionHoldRead();
        const holdMatches = hold
            && hold.client_name === String(input && input.value || '').trim()
            && hold.client_slug === String(input && input.dataset && input.dataset.clientSlug || '').trim();
        const t = holdMatches ? hold.computed_title : buildLinearTitle();
        el.textContent = t || 'Select a client…';
        el.classList.toggle('empty', !t);
        saveLinearForm();
    }

    function saveLinearForm() {
        const cards = document.querySelectorAll('[id^="videoCard_"]');
        const clientInput = document.getElementById('linearClientSearch');
        const selectedClient = _linearResolveClientRow(clientInput?.value || '', clientInput?.dataset.clientSlug || '');
        const f = {
            client: clientInput?.value || '',
            clientSlug: selectedClient ? selectedClient.slug : '',
            filmingPlans: _linearResolvedPlanUrl || '',
            generalDrive: document.getElementById('linearGeneralDrive')?.value || '',
            notes: document.getElementById('linearNotes')?.value || '',
            videos: []
        };
        cards.forEach(card => {
            const num = card.id.replace('videoCard_', '');
            f.videos.push({
                main_cam: document.getElementById('vid_main_' + num)?.value || '',
                side_cam: document.getElementById('vid_side_' + num)?.value || '',
                audio: document.getElementById('vid_audio_' + num)?.value || '',
                notes: document.getElementById('vid_notes_' + num)?.value || ''
            });
        });
        localStorage.setItem(LINEAR_FORM_KEY, JSON.stringify(f));
        return f;
    }

    function loadLinearForm() {
        try {
            const hold = typeof _linearSubmissionHoldRead === 'function' ? _linearSubmissionHoldRead() : null;
            const raw = hold && typeof hold.draft_raw === 'string'
                ? hold.draft_raw : localStorage.getItem(LINEAR_FORM_KEY);
            return JSON.parse(raw || '{}');
        } catch { return {}; }
    }

    /* ===================================================================
     * CONTENT SAMPLES — native rebuild (replaces the samples.html iframe).
     * Per-client sample boards modelled on the Content Calendar: one
     * toolbar row, per-client tabs + search, a horizontal strip of
     * Reel/Thumbnail cards, threaded comments, an editor/client preview
     * toggle and a tokenised client share link. Persists through the
     * samples-* n8n webhooks (one Samples_<slug> tab per client on the
     * SyncView Calendar Sheet), mirroring the calendar's read/write
     * contract, with a localStorage fallback so it keeps working if a
     * webhook is briefly unreachable.
     * =================================================================== */
    const SAMPLES_GET_URL     = 'https://synchrosocial.app.n8n.cloud/webhook/samples-get';
    const SAMPLES_UPSERT_URL  = 'https://synchrosocial.app.n8n.cloud/webhook/samples-upsert';
    const SAMPLES_REORDER_URL = 'https://synchrosocial.app.n8n.cloud/webhook/samples-reorder';
    const SM_KINDS = ['reel', 'thumb'];
    const SM_KIND_META = {
        reel:  { label: 'Reels',      badge: '9:16', title: 'Instagram Reels',      sub: 'Video samples — 9:16 vertical · hosted on Frame.io', single: 'reel' },
        thumb: { label: 'Thumbnails', badge: '9:16', title: 'Instagram Thumbnails', sub: 'Cover image samples — 9:16 vertical · hosted on Google Drive', single: 'thumbnail' }
    };
    const SM_CACHE_PREFIX = 'syncview_samplesCache_v1:';
    const SM_PREFS_KEY = 'syncview_samples_prefs_v1';
    const SM_SEEN_KEY = 'syncview_samplesSeen_v1';
    /* Samples v2 (Supabase realtime) — own flag ?sv2=1, sticky (mirrors the
       calendar's ?v2). Reuses the calendar's Supabase project + publishable key
       + supabase-js loader (CAL_SUPABASE_URL/_ANON_KEY/_LIB_URL, defined in the
       calendar module below). _smV2Ready() gates every Supabase touch, so with
       the flag off the page is byte-identical to v1 (no Supabase calls, the lib
       never loads). */
    const SM_V2_LS_KEY         = 'syncview_samples_v2';
    const SM_V2_KILL_KEY       = 'syncview_samples_v2_off';
    const SM_V2_RT_DEBOUNCE_MS = 350;
    const SM_RT_SELF_ECHO_MS   = 4000;  // a realtime event within this window of a local save = our own echo → defer

    let smState = { client: null, kind: 'reel', mode: 'editor', samples: [], loading: false, error: null, embedded: false, focusCard: null };
    let _smLinkClient = null;     // client locked in via a ?c=…&v=samples share link
    let _smFocusRequest = null;   // {client, cardId} from a #samples/<slug>/<id> deep link
    let _smOutsideWired = false;
    const _smPendingTimers = {};

    /* ---- tiny self-contained helpers ---- */
    function _smEsc(s){ return String(s==null?'':s).replace(/[&<>]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[ch])); }
    function _smEscAttr(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    function smClientSlug(name){ return wlNormalizeClient(name); }
    function _smMintId(p){ return p + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,7); }
    function _smStringify(arr){ try { return JSON.stringify(Array.isArray(arr) ? arr : []); } catch(e){ return '[]'; } }
    function _smTruthy(v){ if(v === true) return true; if(v == null || v === false) return false; return /^(1|true|yes|y)$/i.test(String(v).trim()); }
    function _smFind(id){ return smState.samples.find(x => x.id === id); }
    function _smCssId(id){ return (window.CSS && CSS.escape) ? CSS.escape(id) : id; }
    function _smClientSurface(){ return _isClientLink || smState.mode === 'client'; }
    function _smCommentRole(){ return _isClientLink ? 'client' : 'smm'; }
    function _smCurrentAuthor(){ return _isClientLink ? (smState.client || _smLinkClient || 'Client') : 'Synchro Social'; }
    function _smFlash(msg, isErr){ const f = document.getElementById('smFlash'); if(!f) return; f.textContent = msg; f.classList.toggle('error', !!isErr); f.classList.add('show'); clearTimeout(_smFlash._t); _smFlash._t = setTimeout(() => f.classList.remove('show'), 2000); }

    /* ---- Video embed (provider-aware) + Google Drive image helpers ----
       Frame.io has no public iframe player: player.frame.io doesn't resolve and
       f.io sends X-Frame-Options: SAMEORIGIN, so Frame.io links simply can't be
       embedded — they fall through to a click-to-open poster (new tab). Providers
       that DO allow embedding (YouTube, Vimeo, Loom, Google Drive, direct video
       files) play inline. Returns { kind:'iframe'|'video', src } or null. */
    function _smVideoEmbed(url){
        if(!url) return null;
        url = url.trim();
        let m;
        if((m = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/|live\/)|youtu\.be\/)([a-zA-Z0-9_-]{6,})/i)))
            return { kind:'iframe', src:'https://www.youtube.com/embed/' + m[1] };
        if((m = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i)))
            return { kind:'iframe', src:'https://player.vimeo.com/video/' + m[1] };
        if((m = url.match(/loom\.com\/(?:share|embed)\/([a-zA-Z0-9]+)/i)))
            return { kind:'iframe', src:'https://www.loom.com/embed/' + m[1] };
        if((m = url.match(/drive\.google\.com\/file\/d\/([-\w]{20,})/i)))
            return { kind:'iframe', src:'https://drive.google.com/file/d/' + m[1] + '/preview' };
        if(/\.(mp4|webm|mov|m4v)(\?|#|$)/i.test(url))
            return { kind:'video', src:url };
        return null;   // Frame.io & anything else → open in a new tab
    }
    function _smLinkHost(url){ try { return new URL(String(url).trim()).hostname.replace(/^www\./,''); } catch(e){ return ''; } }
    function _smIsFrameIo(url){ return /(?:^|\.)(?:frame\.io|f\.io)$/i.test(_smLinkHost(url)); }

    /* ---- Approval (Kasper → Client) ----------------------------------------
       A tracked two-step gate stored per sample in the `approval` column:
       draft → kasper → client → approved, plus a `changes` state when the
       client asks for a change. The editor surface drives the draft/kasper
       steps; the client share link only ever sees client/approved/changes
       cards and drives the final approval. Stamps kasper_/client_approved_at|by. */
    const SM_APPR_META = {
        draft:    { label:'Draft',             cls:'is-draft'    },
        kasper:   { label:'Kasper review',     cls:'is-kasper'   },
        client:   { label:'Client review',     cls:'is-client'   },
        approved: { label:'Approved',          cls:'is-approved' },
        changes:  { label:'Changes requested', cls:'is-changes'  }
    };
    const SM_CLIENT_VISIBLE_APPR = new Set(['client','approved','changes']);
    function _smApprNorm(v){
        v = String(v == null ? '' : v).trim().toLowerCase().replace(/[\s-]+/g,'_');
        if(v === 'kasper' || v === 'kasper_review') return 'kasper';
        if(v === 'client' || v === 'client_review') return 'client';
        if(v === 'approved') return 'approved';
        if(v === 'changes' || v === 'change' || v === 'changes_requested') return 'changes';
        return 'draft';
    }
    function _smApprFmt(t){ if(!t) return ''; try { return new Date(t).toLocaleDateString([], { month:'short', day:'numeric' }); } catch(e){ return ''; } }
    function _smApprPill(s, surface){
        const st = _smApprNorm(s.approval);
        const meta = SM_APPR_META[st];
        let label = meta.label;
        if(surface){ if(st === 'client') label = 'Awaiting your approval'; else if(st === 'approved') label = 'Approved'; else if(st === 'changes') label = 'Change requested'; }
        return `<span class="sm-appr-pill ${meta.cls}">${_smEsc(label)}</span>`;
    }
    function _smApprovalSummary(items, surface){
        if(!items.length) return '';
        if(surface){
            const appr = items.filter(s => _smApprNorm(s.approval) === 'approved').length;
            return `<span class="sm-appr-summary">${appr === items.length ? 'All approved' : ('Approved ' + appr + ' of ' + items.length)}</span>`;
        }
        const c = { draft:0, kasper:0, client:0, approved:0, changes:0 };
        items.forEach(s => { c[_smApprNorm(s.approval)]++; });
        const parts = [];
        if(c.approved) parts.push(c.approved + ' approved');
        if(c.changes)  parts.push(c.changes + ' to fix');
        if(c.client)   parts.push(c.client + ' with client');
        if(c.kasper)   parts.push(c.kasper + ' for Kasper');
        if(c.draft)    parts.push(c.draft + ' draft');
        return parts.length ? `<span class="sm-appr-summary">${parts.join(' · ')}</span>` : '';
    }
    function _smApprovalHtml(s, id, surface){
        const st = _smApprNorm(s.approval);
        let actions = '';
        if(surface){
            if(st === 'client') actions = `<button class="sm-appr-btn primary" type="button" onclick="_smApprApprove('${id}')">Approve</button><button class="sm-appr-btn" type="button" onclick="_smApprClientChanges('${id}')">Request a change</button>`;
            else if(st === 'approved') actions = `<span class="sm-appr-note">You approved this${s.client_approved_at ? ' · ' + _smEsc(_smApprFmt(s.client_approved_at)) : ''}</span><button class="sm-appr-link" type="button" onclick="_smApprUnapprove('${id}')">Undo</button>`;
            else if(st === 'changes') actions = `<span class="sm-appr-note">Change requested — we're on it.</span><button class="sm-appr-btn primary" type="button" onclick="_smApprApprove('${id}')">Approve anyway</button>`;
        } else {
            if(st === 'draft') actions = `<button class="sm-appr-btn primary" type="button" onclick="_smApprSend('${id}')">Send for Kasper review</button>`;
            else if(st === 'kasper') actions = `<button class="sm-appr-btn primary" type="button" onclick="_smApprKasper('${id}')">Approve &amp; send to client</button><button class="sm-appr-link" type="button" onclick="_smApprReject('${id}')">Send back</button>`;
            else if(st === 'client') actions = `<span class="sm-appr-note">Awaiting client${s.kasper_approved_at ? ' · Kasper OK ' + _smEsc(_smApprFmt(s.kasper_approved_at)) : ''}</span><button class="sm-appr-link" type="button" onclick="_smApprRevert('${id}')">Back to draft</button>`;
            else if(st === 'approved') actions = `<span class="sm-appr-note">Approved by client${s.client_approved_at ? ' · ' + _smEsc(_smApprFmt(s.client_approved_at)) : ''}</span><button class="sm-appr-link" type="button" onclick="_smApprRevert('${id}')">Reopen</button>`;
            else if(st === 'changes') actions = `<button class="sm-appr-btn primary" type="button" onclick="_smApprResend('${id}')">Re-send to client</button><button class="sm-appr-link" type="button" onclick="_smApprRevert('${id}')">Back to draft</button>`;
        }
        return `<div class="sm-appr">${_smApprPill(s, surface)}<div class="sm-appr-actions">${actions}</div></div>`;
    }
    function _smApprApply(id, next, stamp){
        const s = _smFind(id); if(!s) return;
        s.approval = next;
        const now = new Date().toISOString();
        if(stamp === 'kasper'){ s.kasper_approved_at = now; s.kasper_approved_by = _smCurrentAuthor(); }
        if(stamp === 'client'){ s.client_approved_at = now; s.client_approved_by = _smCurrentAuthor(); }
        _smRenderBody();
        _smFlushCardSave(id);
    }
    function _smApprSend(id){ _smApprApply(id, 'kasper'); _smFlash('Sent for Kasper review'); }
    function _smApprKasper(id){ _smApprApply(id, 'client', 'kasper'); _smFlash('Approved — sent to the client'); }
    function _smApprReject(id){ _smApprApply(id, 'draft'); _smFlash('Sent back to draft'); }
    function _smApprRevert(id){ _smApprApply(id, 'draft'); _smFlash('Moved back to draft'); }
    function _smApprResend(id){ _smApprApply(id, 'client'); _smFlash('Re-sent to the client'); }
    function _smApprApprove(id){ _smApprApply(id, 'approved', 'client'); _smFlash('Approved — thank you!'); }
    function _smApprUnapprove(id){ _smApprApply(id, 'client'); _smFlash('Approval undone'); }
    function _smApprClientChanges(id){ _smChangeReqPending = id; openSmComments(id); }
    function _smDriveImg(input){
        if(!input) return '';
        input = input.trim();
        // A direct (non-Drive) image URL is used as-is.
        if(/^https?:/i.test(input) && !/drive\.google\.com|docs\.google\.com/i.test(input)) return input;
        const m = input.match(/[-\w]{25,}/);
        const fileId = m ? m[0] : input;
        return 'https://drive.google.com/thumbnail?id=' + fileId + '&sz=w800';
    }
    function _smImgError(img){
        img.style.display = 'none';
        const wrap = img.closest('.sm-frame');
        if(wrap && !wrap.querySelector('.sm-empty')){
            const d = document.createElement('div');
            d.className = 'sm-empty';
            d.innerHTML = '<div>Image not accessible</div><div class="sm-ratio">Check Drive sharing</div>';
            wrap.appendChild(d);
        }
    }

    /* ---- prefs + cache + seen ---- */
    function _smLoadPrefs(){ try { return JSON.parse(localStorage.getItem(SM_PREFS_KEY) || '{}') || {}; } catch(e){ return {}; } }
    function _smSavePrefs(){ try { localStorage.setItem(SM_PREFS_KEY, JSON.stringify({ client: smState.client, kind: smState.kind })); } catch(e){} }
    function _smCacheKey(slug){ return SM_CACHE_PREFIX + slug; }
    const SM_CACHE_TTL_MS = 7 * 24 * 60 * 60 * 1000;   // parity with CAL_CACHE_TTL_MS / SXR_CACHE_TTL_MS
    function _smCacheRead(slug){ try { const r = localStorage.getItem(_smCacheKey(slug)); if(!r) return null; const o = JSON.parse(r); if(!o || !o.at || (Date.now() - Number(o.at)) > SM_CACHE_TTL_MS) return null; return Array.isArray(o.samples) ? o.samples.map(_smNormalize) : null; } catch(e){ return null; } }
    function _smCacheWrite(slug, samples){
        const payload = JSON.stringify({ samples, at: Date.now() });
        try { localStorage.setItem(_smCacheKey(slug), payload); return; } catch(e){}
        // Quota hit — evict the other clients' sample caches and retry once; if
        // it still fails, drop this slug's cache so a stale snapshot can't
        // outlive fresh data (a deleted card would flash on every refresh).
        try {
            for(let i = localStorage.length - 1; i >= 0; i--){
                const k = localStorage.key(i);
                if(k && k.indexOf(SM_CACHE_PREFIX) === 0 && k !== _smCacheKey(slug)) localStorage.removeItem(k);
            }
            localStorage.setItem(_smCacheKey(slug), payload);
        } catch(e){
            try { localStorage.removeItem(_smCacheKey(slug)); } catch(e2){}
        }
    }
    function _smGetSeen(){ try { return JSON.parse(localStorage.getItem(SM_SEEN_KEY) || '{}') || {}; } catch(e){ return {}; } }
    function _smMarkSeen(id){ const seen = _smGetSeen(); const s = _smFind(id); seen[id] = (s ? _smLastCommentAt(s) : '') || new Date().toISOString(); try { localStorage.setItem(SM_SEEN_KEY, JSON.stringify(seen)); } catch(e){} }

    function _smNormalize(row){
        row = row || {};
        let comments = [];
        if(Array.isArray(row.comments)) comments = row.comments;
        else if(typeof row.comments === 'string' && row.comments.trim()){ try { const p = JSON.parse(row.comments); if(Array.isArray(p)) comments = p; } catch(e){} }
        return {
            id: String(row.id || ''),
            kind: SM_KINDS.includes(row.kind) ? row.kind : 'reel',
            order_index: Number(row.order_index || 0),
            label: row.label || '',
            media_url: row.media_url || '',
            creative_direction: row.creative_direction || row.rationale || '',
            hide_creative_direction: _smTruthy(row.hide_creative_direction),
            comments: comments,
            status: row.status || 'Active',
            approval: _smApprNorm(row.approval),
            kasper_approved_at: row.kasper_approved_at || '',
            kasper_approved_by: row.kasper_approved_by || '',
            client_approved_at: row.client_approved_at || '',
            client_approved_by: row.client_approved_by || '',
            created_at: row.created_at || '',
            updated_at: row.updated_at || ''
        };
    }

    /* ===================================================================
     * CONTENT SAMPLES v2 — Supabase realtime (clone of the calendar's
     * _calV2* runtime; see docs/archive/CALENDAR_REALTIME_MIGRATION.md). Hidden behind
     * ?sv2=1 until the flip. Reads come from the content_samples table over
     * REST with a realtime subscription; writes still flow through the
     * samples-* n8n webhooks (which dual-write the Sheet + Supabase), so the
     * Sheet stays a lossless mirror and rollback = ?sv2=0 / revert. Any
     * Supabase failure falls back to samples-get, so v2 can never blank the
     * board.
     * =================================================================== */
    let _smV2FlagCache = null;
    function _smV2Enabled() {
        if (_smV2FlagCache !== null) return _smV2FlagCache;
        // Phase 3 (2026-06-15): v2 is now the DEFAULT. With no query param it is
        // ON unless this browser opted out via ?sv2=0 (sticky kill-switch).
        // ?sv2=1 force-enables and clears a prior opt-out. Rollback for everyone
        // = flip this default back to false; rollback for one browser = ?sv2=0.
        // Writes still dual-write to the Sheet, so a flip back is lossless.
        let on = true;
        try {
            const q = new URLSearchParams(location.search).get('sv2');
            if (q === '0' || q === 'false') { on = false; try { localStorage.setItem(SM_V2_KILL_KEY, '1'); localStorage.removeItem(SM_V2_LS_KEY); } catch {} }
            else if (q === '1' || q === 'true') { on = true; try { localStorage.setItem(SM_V2_LS_KEY, '1'); localStorage.removeItem(SM_V2_KILL_KEY); } catch {} }
            else { on = (localStorage.getItem(SM_V2_KILL_KEY) !== '1'); }
        } catch { on = true; }
        _smV2FlagCache = on;
        return on;
    }
    function _smV2Ready() {
        return _smV2Enabled() && !!CAL_SUPABASE_URL && !!CAL_SUPABASE_ANON_KEY;
    }
    /* Own supabase-js client (gated on _smV2Ready so it's fully decoupled from
       the calendar's flag), reusing the calendar's generic UMD loader so the lib
       is fetched at most once. Any failure resolves to null → callers fall back. */
    let _smV2ClientObj = null;
    let _smV2ClientPromise = null;
    function _smV2Client() {
        if (!_smV2Ready()) return Promise.resolve(null);
        if (_smV2ClientObj) return Promise.resolve(_smV2ClientObj);
        if (_smV2ClientPromise) return _smV2ClientPromise;
        _smV2ClientPromise = _calV2LoadLib().then(lib => {
            if (!lib || !lib.createClient) return null;
            _smV2ClientObj = lib.createClient(CAL_SUPABASE_URL, CAL_SUPABASE_ANON_KEY, {
                auth: { persistSession: false, autoRefreshToken: false },
                realtime: { params: { eventsPerSecond: 5 } }
            });
            return _smV2ClientObj;
        }).catch(e => { console.warn('[Samples v2] supabase-js init failed', e); _smV2ClientPromise = null; return null; });
        return _smV2ClientPromise;
    }
    /* Read one client's samples from Supabase REST, shaped like samples-get
       ({ ok, samples[] }). On ANY failure, fall back to the webhook. */
    async function _smV2FetchSamples(slug, signal) {
        // Archived rows are dropped right after this fetch (loadSamples filters
        // them) — exclude them server-side too (NULL-safe or= form).
        const url = CAL_SUPABASE_URL + '/rest/v1/content_samples?select=*&or=(status.is.null,status.neq.Archived)&client=eq.' + encodeURIComponent(slug) + '&limit=5000';
        try {
            const resp = await fetch(url, {
                headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' },
                signal: signal || undefined
            });
            if (!resp.ok) throw new Error('Supabase HTTP ' + resp.status);
            const rows = await resp.json();
            if (!Array.isArray(rows)) throw new Error('Supabase: unexpected payload');
            return { ok: true, samples: rows };
        } catch (e) {
            if (e && e.name === 'AbortError') throw e;
            console.warn('[Samples v2] Supabase read failed — falling back to samples-get', e);
            const resp = await fetch(SAMPLES_GET_URL + '?client=' + encodeURIComponent(slug) + '&_t=' + Date.now(), signal ? { signal } : undefined);
            return resp.json();
        }
    }
    /* Realtime lifecycle: one channel per client; switching clients (or leaving
       Samples) tears it down. A change coalesces into one debounced background
       reload — suppressed while it's the echo of our own write, and deferred
       while the user is actively editing (Notes modal open or a field focused)
       so it can never clobber an in-progress edit or the caret. */
    let _smV2Channel = null, _smV2SubSlug = null, _smV2RtTimer = null;
    let _smV2RtPending = false, _smV2SubscribedOnce = false;
    let _smLastLocalWriteAt = 0;       // when we last saved locally — used to ignore our own realtime echo
    function _smEditingBusy() {
        if (_smOpenCommentsId) return true;            // Notes modal open
        const ae = document.activeElement;
        return !!(ae && ae.closest && ae.closest('.sm-card') && /^(TEXTAREA|INPUT)$/.test(ae.tagName));
    }
    async function _smV2EnsureSubscribed(slug) {
        if (!_smV2Ready() || !slug) return;
        if (_smV2SubSlug === slug && _smV2Channel) return;
        _smV2Teardown();
        const client = await _smV2Client();
        if (!client) return;
        if (smClientSlug(smState.client) !== slug) return; // client switched during lib load
        _smV2SubSlug = slug; _smV2SubscribedOnce = false;
        try {
            _smV2Channel = client
                .channel('sm-' + slug)
                .on('postgres_changes', { event: '*', schema: 'public', table: 'content_samples', filter: 'client=eq.' + slug }, () => _smV2OnRealtimeChange(slug))
                .subscribe((status) => {
                    if (status === 'SUBSCRIBED') {
                        // A re-subscribe means the socket had dropped (a suspended
                        // background tab that woke up); realtime doesn't replay the
                        // missed events, so pull one catch-up snapshot. Skip the
                        // FIRST subscribe — the load that opened the channel is current.
                        if (_smV2SubscribedOnce) _smV2OnRealtimeChange(slug);
                        _smV2SubscribedOnce = true;
                    } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
                        console.warn('[Samples v2] realtime status:', status);
                    }
                });
        } catch (e) {
            console.warn('[Samples v2] realtime subscribe failed', e);
            _smV2Channel = null; _smV2SubSlug = null;
        }
    }
    function _smV2OnRealtimeChange(slug) {
        if (smClientSlug(smState.client) !== slug) return;
        if (_smV2RtTimer) clearTimeout(_smV2RtTimer);
        _smV2RtTimer = setTimeout(function tick() {
            _smV2RtTimer = null;
            if (smClientSlug(smState.client) !== slug) return;
            // Suppress the echo of our OWN just-made write (a whole-row save
            // round-trips back as a realtime event a second or two later;
            // reloading then would only flicker the strip). Re-arm and re-check
            // so the reload lands once WE'VE settled. A teammate's change while
            // we're idle is never suppressed (we didn't just write).
            const sinceLocal = Date.now() - _smLastLocalWriteAt;
            if (sinceLocal < SM_RT_SELF_ECHO_MS) { _smV2RtTimer = setTimeout(tick, SM_RT_SELF_ECHO_MS - sinceLocal); return; }
            // Never disrupt active editing: if the Notes modal is open or a sample
            // field is focused, defer (serviced on close / blur / load-end).
            if (_smEditingBusy() || smState.loading) { _smV2RtPending = true; return; }
            _smV2RtPending = false;
            loadSamples({ background: true, skipCache: true });
        }, SM_V2_RT_DEBOUNCE_MS);
    }
    function _smV2ServicePending() { if (_smV2RtPending && _smV2SubSlug) _smV2OnRealtimeChange(_smV2SubSlug); }
    function _smV2Teardown() {
        if (_smV2RtTimer) { clearTimeout(_smV2RtTimer); _smV2RtTimer = null; }
        if (_smV2Channel) {
            try {
                if (_smV2ClientObj && typeof _smV2ClientObj.removeChannel === 'function') _smV2ClientObj.removeChannel(_smV2Channel);
                else if (typeof _smV2Channel.unsubscribe === 'function') _smV2Channel.unsubscribe();
            } catch {}
        }
        _smV2Channel = null; _smV2SubSlug = null;
    }
    /* Console helper for verification: window.smV2Status(). */
    window.smV2Status = function () { return { flag: _smV2Enabled(), ready: _smV2Ready(), keySet: !!CAL_SUPABASE_ANON_KEY, subscribed: !!_smV2Channel, slug: _smV2SubSlug }; };

    /* ---- comment view helpers ---- */
    function _smVisibleComments(s){
        const all = Array.isArray(s.comments) ? s.comments : [];
        const live = all.filter(c => !c.deleted);
        if(!_smClientSurface()) return live;            // SMM sees everything
        const hiddenRoots = new Set(live.filter(c => !c.parent_id && c.audience === 'internal').map(c => c.id));
        return live.filter(c => c.parent_id ? !hiddenRoots.has(c.parent_id) : c.audience !== 'internal');
    }
    function _smRoots(list){ return list.filter(c => !c.parent_id).sort((a,b) => String(a.created_at).localeCompare(String(b.created_at))); }
    function _smReplies(list, rootId){ return list.filter(c => c.parent_id === rootId).sort((a,b) => String(a.created_at).localeCompare(String(b.created_at))); }
    function _smOpenCount(s){ return _smRoots(_smVisibleComments(s)).length; }
    function _smLastCommentAt(s){ let m = ''; _smVisibleComments(s).forEach(c => { if((c.created_at || '') > m) m = c.created_at || ''; }); return m; }
    function _smHasUnread(s){
        const list = _smVisibleComments(s); if(!list.length) return false;
        const seen = _smGetSeen()[s.id] || '';
        const last = list.slice().sort((a,b) => String(a.created_at).localeCompare(String(b.created_at))).pop();
        return !!last && String(last.created_at) > String(seen) && last.role !== _smCommentRole();
    }

    /* ---- entry points ---- */
    function renderSamplesView(){ return `<div class="samples-view" id="smView">${_smLoaderHtml()}</div>`; }
    function _smLoaderHtml(){ return _svLoadingSkeletonHtml('samples', { label: 'Loading samples' }); }

    function mountSamplesView(){
        document.body.classList.remove('sm-modal-open');
        const prefs = _smLoadPrefs();
        const pins = _calGetPins();
        if(_isClientLink && _smLinkClient){
            smState.client = _smLinkClient; smState.embedded = true; smState.mode = 'client';
        } else if(_smFocusRequest && _smFocusRequest.client && WL_CLIENT_NAMES.includes(_smFocusRequest.client)){
            smState.client = _smFocusRequest.client; smState.embedded = false; smState.mode = 'editor';
            if(!pins.includes(smState.client)){ pins.push(smState.client); _calSavePins(pins); }
        } else {
            let initial = null;
            // Same as the calendar: trust pins (the durable open-tabs list) over
            // the sheet-driven WL_CLIENT_NAMES allowlist, which may not have
            // loaded yet on the samples fast path — otherwise a sheet-only last
            // client (e.g. one not in the hardcoded seed) is skipped on reopen.
            if(prefs.client && pins.includes(prefs.client)) initial = prefs.client;
            else if(pins.length > 0) initial = pins[0];
            else if(prefs.client && WL_CLIENT_NAMES.includes(prefs.client)) initial = prefs.client;
            smState.client = initial; smState.embedded = false; smState.mode = 'editor';
        }
        smState.kind = SM_KINDS.includes(prefs.kind) ? prefs.kind : 'reel';
        smState.focusCard = (_smFocusRequest && _smFocusRequest.cardId) ? _smFocusRequest.cardId : null;
        _smFocusRequest = null;
        smState.samples = []; smState.error = null; smState.loading = false;
        _smSyncUrl();
        _smRenderShell();
        if(smState.client) loadSamples(); else _smRenderBody();
    }

    async function loadSamples(opts){
        opts = opts || {};
        const bg = !!opts.background;            // realtime-triggered reload: no loader, no focus jump
        const client = smState.client;
        if(!client){ smState.samples = []; _smRenderBody(); return; }
        const slug = smClientSlug(client);
        if(!opts.skipCache){
            const cached = _smCacheRead(slug);
            if(cached && cached.length){ smState.samples = cached.filter(s => String(s.status||'').toLowerCase() !== 'archived'); smState.loading = false; if(!bg) _smRenderBody(); }
        }
        if(!bg){ smState.loading = !smState.samples.length; if(smState.loading) _smRenderBody(); }
        smState.error = null;
        try {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 12000);
            let data;
            if(_smV2Ready()){
                data = await _smV2FetchSamples(slug, ctrl.signal);   // Supabase REST (falls back to samples-get on any error)
            } else {
                const resp = await fetch(SAMPLES_GET_URL + '?client=' + encodeURIComponent(slug) + '&_t=' + Date.now(), { signal: ctrl.signal });
                if(!resp.ok) throw new Error('HTTP ' + resp.status);
                data = await resp.json();
            }
            clearTimeout(timer);
            const rows = Array.isArray(data) ? data : (data.samples || data.posts || (data.json && (data.json.samples || data.json.posts)) || []);
            if(smState.client !== client) return;   // user switched clients mid-flight
            smState.samples = (rows || []).map(_smNormalize).filter(s => String(s.status||'').toLowerCase() !== 'archived');
            smState.loading = false; smState.error = null;
            _smCacheWrite(slug, smState.samples);
            _smRenderBody();
            if(!bg) setTimeout(_smApplyFocus, 120);
            // Phase 2: open (or re-point) the realtime subscription for this client.
            // Idempotent (keyed on slug); a change deferred mid-load is serviced now.
            if(_smV2Ready()){
                _smV2EnsureSubscribed(slug);
                if(_smV2RtPending){ _smV2RtPending = false; _smV2OnRealtimeChange(slug); }
            }
        } catch(e){
            if(smState.client !== client) return;
            smState.loading = false;
            if(!smState.samples.length){ smState.error = 'offline'; }   // nothing cached, nothing live
            _smRenderBody();
            if(!bg) setTimeout(_smApplyFocus, 120);
        }
    }

    function _smApplyFocus(){
        if(!smState.focusCard) return;
        const id = smState.focusCard;
        const s = _smFind(id);
        if(s && s.kind !== smState.kind){ smState.kind = s.kind; _smSavePrefs(); _smRenderShell(); _smRenderBody(); }
        const card = document.querySelector(`.sm-card[data-id="${_smCssId(id)}"]`);
        if(card){ card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }); card.classList.add('is-flash'); setTimeout(() => card.classList.remove('is-flash'), 1500); }
        smState.focusCard = null;
    }

    /* ---- shell / toolbar ---- */
    function _smRenderShell(){
        const view = document.getElementById('smView');
        if(!view) return;
        const clientLink = _isClientLink;
        const leftHtml = clientLink
            ? `<div class="sm-embed-title"><strong>${_smEsc(smState.client || '')}</strong><span>Content samples</span></div>`
            : `<div class="sm-tabs" id="smTabs"></div>`;
        const kindToggle = `<div class="sm-seg${clientLink ? ' sm-seg-lg' : ''}" role="tablist">${SM_KINDS.map(k =>
            `<button type="button" class="sm-seg-btn${smState.kind === k ? ' active' : ''}" onclick="setSmKind('${k}')">${SM_KIND_META[k].label}<span class="sm-seg-badge">${SM_KIND_META[k].badge}</span></button>`
        ).join('')}</div>`;
        const shareBtn = (!clientLink && smState.client) ? `<button class="sm-share-btn" id="smShareBtn" type="button" onclick="smCopyShareLink()" title="Copy a client-facing link to these samples"><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M9.5 1L13 4.5M13 4.5L9.5 8M13 4.5H5.5C3.57 4.5 2 6.07 2 8V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Copy client link</button>` : '';
        const toolbarRight = clientLink ? kindToggle : `<div class="sm-toolbar-right">${kindToggle}${shareBtn}</div>`;
        view.innerHTML = `
            <div class="sm-toolbar${clientLink ? ' sm-toolbar-client' : ''}">
                <div class="sm-toolbar-left">${leftHtml}</div>
                ${toolbarRight}
            </div>
            <div class="sm-body" id="smBody">${_smLoaderHtml()}</div>
            <div class="sm-comments-overlay" id="smCommentsOverlay" data-backdrop-dismiss onclick="if(event.target===this&&this._backdropPressBegan)closeSmComments()">
                <div class="sm-comments-modal" id="smCommentsModal" role="dialog" aria-modal="true"></div>
            </div>
            <div class="sm-flash" id="smFlash"></div>`;
        if(!clientLink){ _smRenderTabs(); _smWireOutsideSearchClose(); }
    }

    function _smRenderTabs(){
        const el = document.getElementById('smTabs');
        if(!el) return;
        const pins = _calGetPins();
        const active = smState.client;
        const tabHtml = pins.map(name => {
            const isA = name === active;
            return `<button type="button" class="sm-tab${isA ? ' active' : ''}" style="--tab-h:${_calClientHue(name)}" onclick="onSmTabClick(${_jsAttrArg(name)})"><span class="sm-tab-dot"></span><span>${_smEsc(name)}</span><span class="sm-tab-x" onclick="event.stopPropagation();onSmTabRemove(${_jsAttrArg(name)})" title="Remove tab"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></span></button>`;
        }).join('');
        const plus = `<svg viewBox="0 0 16 16" fill="none"><line x1="8" y1="2.5" x2="8" y2="13.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><line x1="2.5" y1="8" x2="13.5" y2="8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`;
        el.innerHTML = `<button type="button" class="cal-tab-scroll-btn left" tabindex="-1" aria-label="Scroll clients left" onclick="_calTabScrollBy('smTabsScroll',-1)">${_calChevron(-1)}</button>`
            + `<div class="sm-tabs-scroll" id="smTabsScroll" onscroll="_calUpdateTabScroll('smTabsScroll')">${tabHtml}</div>`
            + `<button type="button" class="cal-tab-scroll-btn right" tabindex="-1" aria-label="Scroll clients right" onclick="_calTabScrollBy('smTabsScroll',1)">${_calChevron(1)}</button>`
            + `<div class="sm-tab-add-wrap" id="smTabAddWrap"><button type="button" class="sm-tab-add" onclick="onSmTabAddClick(event)" title="Add client">${plus}${pins.length ? '' : '<span>Add client</span>'}</button><div class="sm-tab-search" id="smTabSearch" hidden><input type="text" id="smClientSearch" placeholder="Search clients…" autocomplete="off" oninput="_smRenderClientSearch(this.value)" onkeydown="_smSearchKey(event)"><div class="sm-tab-results" id="smClientResults"></div></div></div>`;
        _calScrollTabStripToActive('smTabsScroll');
        _calUpdateTabScroll('smTabsScroll');
    }

    function onSmTabClick(name){ if(!name || name === smState.client) return; onSmClientChange(name); }
    function onSmTabRemove(name){
        const pins = _calGetPins().filter(n => n !== name);
        _calSavePins(pins);
        if(smState.client === name){
            _smFlushAllPending();
            const next = pins[0] || null;
            smState.client = next; smState.samples = []; _smSavePrefs();
            _smSyncUrl();
            _smRenderShell();
            if(next) loadSamples(); else _smRenderBody();
        } else { _smRenderTabs(); }
    }
    function onSmTabAddClick(e){
        e.stopPropagation();
        const panel = document.getElementById('smTabSearch');
        if(!panel) return;
        const willShow = panel.hidden;
        panel.hidden = !willShow;
        if(willShow){ _smRenderClientSearch(''); const inp = document.getElementById('smClientSearch'); if(inp){ inp.value = ''; setTimeout(() => inp.focus(), 10); } }
    }
    function _smRenderClientSearch(q){
        const box = document.getElementById('smClientResults');
        if(!box) return;
        q = (q || '').toLowerCase().trim();
        const pins = _calGetPins();
        let names = WL_CLIENT_NAMES.filter(n => !pins.includes(n));
        if(q) names = names.filter(n => n.toLowerCase().includes(q));
        names = names.sort().slice(0, 40);
        box.innerHTML = names.length
            ? names.map((n,i) => `<button type="button" class="sm-tab-result${i === 0 ? ' active' : ''}" onclick="onSmPickClient(${_jsAttrArg(n)})">${_smEsc(n)}</button>`).join('')
            : `<div class="sm-tab-empty">No clients found</div>`;
    }
    function _smSearchKey(e){
        if(e.key === 'Enter'){ const first = document.querySelector('#smClientResults .sm-tab-result'); if(first) first.click(); }
        else if(e.key === 'Escape'){ const p = document.getElementById('smTabSearch'); if(p) p.hidden = true; }
    }
    function onSmPickClient(name){
        if(!wlIsAllowedClient(name)) return;
        const canon = wlCanonicalClient(name) || name;
        const pins = _calGetPins();
        if(!pins.includes(canon)){ pins.push(canon); _calSavePins(pins); }
        const panel = document.getElementById('smTabSearch'); if(panel) panel.hidden = true;
        onSmClientChange(canon);
    }
    function _smSyncUrl(){
        if(_isClientLink) return;   // client share links own their URL (?c=…&t=…)
        try {
            const base = location.pathname + location.search.replace(/#.*$/, '');
            const hash = smState.client ? ('#samples/' + smClientSlug(smState.client)) : '#samples';
            // Keep client out of history.state: the #samples/<slug> hash already
            // carries it for the boot router, and a non-null state.client forces
            // the boot onto the slow (analytics-awaiting) path — the refresh flash.
            history.replaceState({ nav: 'samples', client: null }, '', base + hash);
        } catch(e){}
    }
    function onSmClientChange(name){
        _smFlushAllPending();
        smState.client = name; smState.samples = []; smState.error = null; smState.focusCard = null;
        _smSavePrefs();
        _smSyncUrl();
        _smRenderShell();
        loadSamples();
    }
    function _smWireOutsideSearchClose(){
        if(_smOutsideWired) return;
        _smOutsideWired = true;
        document.addEventListener('mousedown', e => {
            const wrap = document.getElementById('smTabAddWrap');
            const panel = document.getElementById('smTabSearch');
            if(panel && !panel.hidden && wrap && !wrap.contains(e.target)) panel.hidden = true;
        });
    }

    /* ---- body / strip ---- */
    function _smPickClientHtml(){
        return `<div class="sm-pick-client"><div class="sm-pick-title">Pick a client to see their samples</div><div>Use the <strong>+ Add client</strong> button above to choose one — each client has their own set of samples.</div></div>`;
    }
    function _smRenderBody(){
        const body = document.getElementById('smBody');
        if(!body) return;
        if(!smState.client){ body.innerHTML = _smPickClientHtml(); return; }
        if(smState.loading && !smState.samples.length){ body.innerHTML = _smLoaderHtml(); return; }
        const meta = SM_KIND_META[smState.kind];
        const surface = _smClientSurface();
        let items = smState.samples.filter(s => s.kind === smState.kind);
        if(surface) items = items.filter(s => SM_CLIENT_VISIBLE_APPR.has(_smApprNorm(s.approval)));
        items = items.sort((a,b) => a.order_index - b.order_index);
        const plus = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
        const addBtn = surface ? '' : (items.length
            ? `<button class="sm-card-add" type="button" onclick="addSampleCard()" title="Add a ${meta.single}">${plus}</button>`
            : `<button class="sm-card-add is-hero" type="button" onclick="addSampleCard()">${plus}<span>Add the first ${meta.single}</span></button>`);
        const intro = '';
        const offline = smState.error === 'offline'
            ? `<div class="sm-client-intro" style="border-color:var(--sv-border-f4c2d5);color:var(--sv-fg-a81950);background:var(--sv-bg-fdf0f5);">Couldn't reach the server — anything you change is saved on this device and will sync once it's back.</div>`
            : '';
        let main;
        if(surface && !items.length){
            main = `<div class="sm-empty-state">No ${meta.label.toLowerCase()} to review yet — check back soon.</div>`;
        } else {
            main = `<div class="sm-strip" id="smStrip">${items.map(s => _smRenderCard(s)).join('')}${addBtn}</div>`;
        }
        body.innerHTML = `
            <div class="sm-section-head">
                <div class="sm-section-title">${_smEsc(meta.title)}</div>
            </div>
            ${intro}${offline}${main}`;
        if(!surface) _smWireDrag();
    }

    function _smRenderCard(s){
        const id = _smEscAttr(s.id);
        const ro = _smClientSurface();
        const isReel = s.kind === 'reel';
        const hasMedia = !!String(s.media_url || '').trim();
        const labelText = s.label || (isReel ? 'Reel' : 'Thumbnail');
        const open = _smOpenCount(s);
        const unread = _smHasUnread(s);
        const dir = s.creative_direction || '';
        const grip = ro ? '' : `<span class="sm-card-grip" title="Drag to reorder"><svg viewBox="0 0 16 16" fill="currentColor"><circle cx="6" cy="4" r="1.4"/><circle cx="10" cy="4" r="1.4"/><circle cx="6" cy="8" r="1.4"/><circle cx="10" cy="8" r="1.4"/><circle cx="6" cy="12" r="1.4"/><circle cx="10" cy="12" r="1.4"/></svg></span>`;
        const tools = ro ? '' : `<button class="sm-card-tool" type="button" onclick="_smCopyCardLink(event,'${id}')" title="Copy link to this sample"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9a2.5 2.5 0 0 0 3.5 0L13 6.5a2.5 2.5 0 0 0-3.5-3.5L8 4.5"/><path d="M9 7a2.5 2.5 0 0 0-3.5 0L3 9.5a2.5 2.5 0 0 0 3.5 3.5L8 11.5"/></svg></button><button class="sm-card-tool del" type="button" onclick="_smDeleteCard('${id}')" title="Delete sample"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>`;
        const labelEl = ro
            ? `<span class="sm-card-label">${_smEsc(labelText)}</span>`
            : `<input class="sm-card-label" value="${_smEscAttr(labelText)}" data-id="${id}" onblur="_smOnLabelBlur(this)" onkeydown="if(event.key==='Enter')this.blur()" maxlength="40">`;
        const mediaField = ro ? '' : `<div class="sm-field">
                <div class="sm-field-label">${isReel ? 'Frame.io URL' : 'Google Drive image URL or ID'}</div>
                <div class="sm-media-row">
                    <input class="sm-input" type="text" value="${_smEscAttr(s.media_url)}" placeholder="${isReel ? 'https://f.io/… or app.frame.io/reviews/…' : 'Drive link, file ID, or image URL'}">
                    <button class="sm-media-save" type="button" onclick="_smOnMediaSave(this)">Save</button>
                </div>
            </div>`;
        const hideDir = !!s.hide_creative_direction;
        const directionField = ro
            ? (hideDir ? '' : `<div class="sm-field"><div class="sm-field-label">Creative direction</div><div class="sm-readonly-direction${dir ? '' : ' is-empty'}">${dir ? _smEsc(dir) : 'No notes yet'}</div></div>`)
            : `<div class="sm-field"><div class="sm-field-label sm-dir-head"><span>Creative direction</span><button type="button" class="sm-dir-toggle${hideDir ? ' is-hidden' : ''}" data-id="${id}" onclick="_smToggleDir(this)" title="${hideDir ? 'Hidden from the client — click to show it' : 'Visible to the client — click to hide it'}">${_smEyeIcon(hideDir)}<span>${hideDir ? 'Hidden from client' : 'Visible to client'}</span></button></div><textarea class="sm-textarea" rows="3" data-id="${id}" placeholder="What's the style / approach for this ${isReel ? 'reel' : 'thumbnail'}?" oninput="_smOnDirInput(this)" onblur="_smOnDirBlur(this)">${_smEsc(dir)}</textarea></div>`;
        return `<div class="sm-card" data-id="${id}"${ro ? '' : ' draggable="true"'}>
            <div class="sm-card-top">
                ${grip}
                <div class="sm-card-label-wrap"><span class="sm-card-dot${hasMedia ? ' has' : ''}"></span>${labelEl}</div>
                <div class="sm-card-tools">${tools}</div>
            </div>
            <div class="sm-frame">${_smMediaHtml(s, isReel, hasMedia)}</div>
            <div class="sm-card-body">
                ${mediaField}${directionField}
                <div class="sm-card-foot">
                    ${_smCommentsBtnHtml(s, id, open, unread)}
                    ${_svSaveIndHtml(id)}
                </div>
                ${_smApprovalHtml(s, id, ro)}
            </div>
        </div>`;
    }

    function _smMediaHtml(s, isReel, hasMedia){
        if(!hasMedia){
            const ico = isReel
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M4 17l5-5 4 4 3-3 4 4"/></svg>`;
            return `<div class="sm-empty">${ico}<div>${isReel ? 'No video yet' : 'No thumbnail yet'}</div><div class="sm-ratio">9 : 16</div></div>`;
        }
        if(isReel){
            const embed = _smVideoEmbed(s.media_url);
            const openLabel = _smIsFrameIo(s.media_url) ? 'Open in Frame.io' : 'Open video';
            const linkIco = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5H3.5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-3"/><path d="M9.5 2.5H13.5V6.5"/><path d="M13.5 2.5L7.5 8.5"/></svg>`;
            const open = `<a class="sm-open-btn" href="${_smEscAttr(s.media_url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${linkIco}${openLabel}</a>`;
            if(embed && embed.kind === 'iframe')
                return `<iframe src="${_smEscAttr(embed.src)}" allow="autoplay; fullscreen; picture-in-picture; clipboard-write" referrerpolicy="no-referrer-when-downgrade" title="${_smEscAttr(s.label || 'Reel')}"></iframe>${open}`;
            if(embed && embed.kind === 'video')
                return `<video src="${_smEscAttr(embed.src)}" controls playsinline preload="metadata"></video>${open}`;
            // No embeddable player (Frame.io & co.) → click-to-open poster, new tab.
            const host = _smLinkHost(s.media_url);
            return `<a class="sm-video-poster" href="${_smEscAttr(s.media_url)}" target="_blank" rel="noopener" title="${_smEscAttr(openLabel)}">
                <span class="sm-video-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span>
                <span class="sm-video-cta">${_smEsc(openLabel)}</span>
                ${host ? `<span class="sm-video-host">${_smEsc(host)} · opens in a new tab</span>` : ''}
            </a>`;
        }
        const src = _smDriveImg(s.media_url);
        const open = `<a class="sm-open-btn" href="${_smEscAttr(s.media_url)}" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5H3.5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-3"/><path d="M9.5 2.5H13.5V6.5"/><path d="M13.5 2.5L7.5 8.5"/></svg>Open</a>`;
        return `<img src="${_smEscAttr(src)}" alt="${_smEscAttr(s.label || 'Thumbnail')}" loading="lazy" onerror="_smImgError(this)">${open}`;
    }

    /* ---- field handlers ---- */
    function _smOnLabelBlur(el){ const s = _smFind(el.dataset.id); if(!s) return; const v = el.value.trim(); if(v === s.label) return; s.label = v; _smFlushCardSave(s.id); }
    function _smOnDirInput(el){ const s = _smFind(el.dataset.id); if(!s) return; s.creative_direction = el.value; _smScheduleSave(s.id, 900); }
    function _smOnDirBlur(el){ const s = _smFind(el.dataset.id); if(!s) return; s.creative_direction = el.value; _smFlushCardSave(s.id); }
    function _smEyeIcon(hidden){
        return hidden
            ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
            : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
    }
    // Toggle whether the client sees this sample's creative direction. Editor-only.
    function _smToggleDir(btn){
        const s = _smFind(btn.dataset.id); if(!s) return;
        s.hide_creative_direction = !s.hide_creative_direction;
        const hidden = s.hide_creative_direction;
        btn.classList.toggle('is-hidden', hidden);
        btn.title = hidden ? 'Hidden from the client — click to show it' : 'Visible to the client — click to hide it';
        btn.innerHTML = _smEyeIcon(hidden) + '<span>' + (hidden ? 'Hidden from client' : 'Visible to client') + '</span>';
        _smFlash(hidden ? 'Creative direction hidden from client' : 'Creative direction now visible to client');
        _smFlushCardSave(s.id);
    }
    function _smOnMediaSave(btn){
        const card = btn.closest('.sm-card'); if(!card) return;
        const s = _smFind(card.dataset.id); if(!s) return;
        const input = card.querySelector('.sm-media-row .sm-input');
        const v = input ? input.value.trim() : '';
        s.media_url = v;
        const frame = card.querySelector('.sm-frame'); if(frame) frame.innerHTML = _smMediaHtml(s, s.kind === 'reel', !!v);
        const dot = card.querySelector('.sm-card-dot'); if(dot) dot.classList.toggle('has', !!v);
        _smFlushCardSave(s.id);
    }

    /* ---- add / delete / reorder ---- */
    function addSampleCard(){
        if(_smClientSurface() || !smState.client) return;
        const kind = smState.kind;
        const sameKind = smState.samples.filter(s => s.kind === kind).length;
        const maxOrder = smState.samples.reduce((m,s) => Math.max(m, Number(s.order_index || 0)), 0);
        const now = new Date().toISOString();
        const blank = { id: _smMintId('s'), kind, order_index: maxOrder + 1, label: (kind === 'reel' ? 'Reel ' : 'Thumbnail ') + (sameKind + 1), media_url: '', creative_direction: '', hide_creative_direction: false, comments: [], status: 'Active', approval: 'draft', kasper_approved_at: '', kasper_approved_by: '', client_approved_at: '', client_approved_by: '', created_at: now, updated_at: now };
        smState.samples.push(blank);
        _smRenderBody();
        setTimeout(() => {
            const card = document.querySelector(`.sm-card[data-id="${_smCssId(blank.id)}"]`);
            if(card){ card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }); const inp = card.querySelector('.sm-input'); if(inp) inp.focus(); }
        }, 60);
        _smFlushCardSave(blank.id);
    }
    function _smDeleteCard(id){
        const s = _smFind(id); if(!s) return;
        showConfirm('Delete this sample?', 'It will be removed for the client too. This can\'t be undone.', () => {
            smState.samples = smState.samples.filter(x => x.id !== id);
            if(smState.client) _smCacheWrite(smClientSlug(smState.client), smState.samples);
            _smRenderBody();
            const client = smState.client;
            _smLastLocalWriteAt = Date.now();
            if(client) fetch(SAMPLES_UPSERT_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client: smClientSlug(client), sample: { id, status: 'Archived', updated_at: new Date().toISOString() } }) }).catch(() => {});
            _smFlash('Sample deleted');
        }, 'Delete');
    }
    function _smWireDrag(){
        const strip = document.getElementById('smStrip'); if(!strip) return;
        let dragId = null;
        strip.querySelectorAll('.sm-card[draggable="true"]').forEach(card => {
            card.addEventListener('dragstart', e => { dragId = card.dataset.id; card.classList.add('sm-dragging'); if(e.dataTransfer) e.dataTransfer.effectAllowed = 'move'; });
            card.addEventListener('dragend', () => { card.classList.remove('sm-dragging'); strip.querySelectorAll('.sm-drop-before').forEach(c => c.classList.remove('sm-drop-before')); dragId = null; });
            card.addEventListener('dragover', e => { e.preventDefault(); if(card.dataset.id !== dragId) card.classList.add('sm-drop-before'); });
            card.addEventListener('dragleave', () => card.classList.remove('sm-drop-before'));
            card.addEventListener('drop', e => { e.preventDefault(); card.classList.remove('sm-drop-before'); if(dragId && card.dataset.id !== dragId) _smReorder(dragId, card.dataset.id); });
        });
    }
    function _smReorder(dragId, beforeId){
        const arr = smState.samples;
        const from = arr.findIndex(s => s.id === dragId);
        if(from < 0) return;
        const [moved] = arr.splice(from, 1);
        const to = arr.findIndex(s => s.id === beforeId);
        arr.splice(to < 0 ? arr.length : to, 0, moved);
        arr.forEach((s,i) => s.order_index = i + 1);
        if(smState.client) _smCacheWrite(smClientSlug(smState.client), arr);
        _smRenderBody();
        _smPersistReorder();
    }
    async function _smPersistReorder(){
        const client = smState.client; if(!client) return;
        const items = smState.samples.map(s => ({ id: s.id, order_index: s.order_index }));
        _smLastLocalWriteAt = Date.now();
        try { await fetch(SAMPLES_REORDER_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client: smClientSlug(client), items }) }); } catch(e){}
    }

    /* ---- persistence ---- */
    function _smScheduleSave(id, delay){ clearTimeout(_smPendingTimers[id]); _smPendingTimers[id] = setTimeout(() => _smFlushCardSave(id), delay == null ? 700 : delay); }
    function _smFlushAllPending(){ Object.keys(_smPendingTimers).forEach(id => { if(_smPendingTimers[id]){ clearTimeout(_smPendingTimers[id]); _smPendingTimers[id] = null; _smFlushCardSave(id); } }); }
    function _smSetSaving(id, status){
        const card = document.querySelector(`.sm-card[data-id="${_smCssId(id)}"]`); if(!card) return;
        const el = card.querySelector(`[data-sv-save-ind="${_smCssId(id)}"]`); if(!el) return;
        // Drive the reusable modern indicator. Samples-Old has no server-error
        // state (a failed save falls back to a local cache), so "local" shows the
        // green check with a "Saved on device" tooltip rather than a red error.
        if(status === 'saving') _svSaveIndApply(el, 'saving');
        else if(status === 'ok') _svSaveIndApply(el, 'saved');
        else if(status === 'local') _svSaveIndApply(el, 'saved', 'Saved on device — will sync when back online');
        else _svSaveIndApply(el, 'idle');
    }
    async function _smFlushCardSave(id){
        clearTimeout(_smPendingTimers[id]); _smPendingTimers[id] = null;
        const client = smState.client;
        const s = _smFind(id);
        if(!s || !client) return;
        s.updated_at = new Date().toISOString();
        _smLastLocalWriteAt = Date.now();   // open the self-echo window before the realtime echo lands
        _smCacheWrite(smClientSlug(client), smState.samples);
        _smSetSaving(id, 'saving');
        const wire = { id: s.id, kind: s.kind, order_index: s.order_index, label: s.label, media_url: s.media_url, creative_direction: s.creative_direction, hide_creative_direction: s.hide_creative_direction ? 'TRUE' : 'FALSE', comments: _smStringify(s.comments), status: s.status || 'Active', approval: _smApprNorm(s.approval), kasper_approved_at: s.kasper_approved_at || '', kasper_approved_by: s.kasper_approved_by || '', client_approved_at: s.client_approved_at || '', client_approved_by: s.client_approved_by || '', created_at: s.created_at, updated_at: s.updated_at };
        try {
            const resp = await fetch(SAMPLES_UPSERT_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client: smClientSlug(client), sample: wire }) });
            if(!resp.ok) throw new Error('HTTP ' + resp.status);
            _smSetSaving(id, 'ok');
            _smLastLocalWriteAt = Date.now();   // refresh: the realtime echo fires just after this success
            _smV2ServicePending();
        } catch(e){ _smSetSaving(id, 'local'); }
    }

    /* ---- comments ---- */
    let _smOpenCommentsId = null, _smReplyTarget = null, _smComposeAudience = 'client', _smRootDraft = '', _smChangeReqPending = null;
    const _smReplyDrafts = {};
    function _smCommentsBtnHtml(s, id, open, unread){
        const ico = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h11a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H7l-3 2.5V12H2.5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z"/></svg>`;
        return `<button type="button" class="sm-comments-btn${open > 0 ? ' has-open' : ''}" onclick="openSmComments('${id}')" title="Notes & feedback">${ico}<span>Notes</span><span class="sm-comments-count">${open || ''}</span>${unread ? '<span class="sm-comments-dot"></span>' : ''}</button>`;
    }
    function _smRefreshCommentsBtn(id){
        const card = document.querySelector(`.sm-card[data-id="${_smCssId(id)}"]`); if(!card) return;
        const old = card.querySelector('.sm-comments-btn'); const s = _smFind(id); if(!old || !s) return;
        const tmp = document.createElement('div'); tmp.innerHTML = _smCommentsBtnHtml(s, _smEscAttr(id), _smOpenCount(s), _smHasUnread(s));
        old.replaceWith(tmp.firstElementChild);
    }
    function openSmComments(id){
        const s = _smFind(id); if(!s) return;
        _smOpenCommentsId = id; _smReplyTarget = null; _smRootDraft = ''; for(const k in _smReplyDrafts) delete _smReplyDrafts[k];
        _smComposeAudience = 'client';
        _smMarkSeen(id);
        const ovl = document.getElementById('smCommentsOverlay'); if(!ovl) return;
        ovl.classList.add('open'); document.body.classList.add('sm-modal-open');
        _smRenderCommentsModal();
        setTimeout(() => { const f = document.getElementById('smCmFeed'); if(f) f.scrollTop = f.scrollHeight; const ta = document.getElementById('smCmComposer'); if(ta) ta.focus(); }, 30);
    }
    function closeSmComments(){
        _smCaptureDraft();
        const ovl = document.getElementById('smCommentsOverlay'); if(ovl) ovl.classList.remove('open');
        document.body.classList.remove('sm-modal-open');
        const id = _smOpenCommentsId; _smOpenCommentsId = null; _smReplyTarget = null; _smChangeReqPending = null;
        if(id){ _smMarkSeen(id); _smRefreshCommentsBtn(id); }
        _smV2ServicePending();   // a realtime change deferred while the modal was open can land now
    }
    function _smCaptureDraft(){ const ta = document.getElementById('smCmComposer'); if(!ta) return; if(_smReplyTarget) _smReplyDrafts[_smReplyTarget] = ta.value; else _smRootDraft = ta.value; }
    function _smRenderCommentsModal(){
        const modal = document.getElementById('smCommentsModal'); const id = _smOpenCommentsId;
        if(!modal || !id) return;
        const s = _smFind(id); if(!s){ closeSmComments(); return; }
        const list = _smVisibleComments(s);
        const roots = _smRoots(list);
        const meRole = _smCommentRole();
        const fmt = t => { if(!t) return ''; try { return new Date(t).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); } catch(e){ return ''; } };
        const row = (c, isReply) => {
            const author = c.author || (c.role === 'client' ? 'Client' : 'Synchro Social');
            const internalTag = (!isReply && c.audience === 'internal' && !_smClientSurface()) ? `<span class="sm-cm-role" style="background:var(--sv-bg-fef3c7);color:var(--sv-fg-92400e);">Internal</span>` : '';
            const canDelete = !_smClientSurface() || c.role === meRole;
            const acts = [];
            if(!isReply) acts.push(`<button class="sm-cm-action" onclick="_smBeginReply('${_smEscAttr(c.id)}')">Reply</button>`);
            if(canDelete) acts.push(`<button class="sm-cm-action del" onclick="_smDeleteComment('${_smEscAttr(c.id)}')">Delete</button>`);
            return `<div class="sm-cm-row ${c.role === 'client' ? 'is-client' : 'is-smm'}${isReply ? ' is-reply' : ''}">
                <div class="sm-cm-avatar">${_smEsc((author.trim()[0] || '?').toUpperCase())}</div>
                <div class="sm-cm-bubble">
                    <div class="sm-cm-meta"><span class="sm-cm-author">${_smEsc(author)}</span><span class="sm-cm-role">${c.role === 'client' ? 'Client' : 'SMM'}</span>${internalTag}<span class="sm-cm-time">${_smEsc(fmt(c.created_at))}</span></div>
                    <div class="sm-cm-text">${_smEsc(c.body)}</div>
                    <div class="sm-cm-actions">${acts.join('')}</div>
                </div>
            </div>`;
        };
        const feed = roots.length
            ? roots.map(r => `<div class="sm-cm-thread">${row(r, false)}${_smReplies(list, r.id).map(rep => row(rep, true)).join('')}</div>`).join('')
            : `<div class="sm-cm-empty">${_smClientSurface() ? 'No notes yet — add the first one below.' : 'No notes yet. Leave a note for the client, or keep an internal one.'}</div>`;
        const replyCtx = _smReplyTarget ? (() => { const r = list.find(c => c.id === _smReplyTarget); return `<div class="sm-cm-reply-ctx"><span>Replying to ${_smEsc((r && r.author) || 'comment')}</span><button onclick="_smBeginReply(null)">Cancel</button></div>`; })() : '';
        const audience = (!_smClientSurface() && !_smReplyTarget) ? `<div class="sm-cm-audience"><button class="sm-cm-aud-btn${_smComposeAudience === 'client' ? ' active' : ''}" onclick="_smSetAudience('client')">Visible to client</button><button class="sm-cm-aud-btn${_smComposeAudience === 'internal' ? ' active' : ''}" onclick="_smSetAudience('internal')">Internal note</button></div>` : '';
        const draft = _smReplyTarget ? (_smReplyDrafts[_smReplyTarget] || '') : (_smRootDraft || '');
        modal.innerHTML = `
            <div class="sm-cm-head">
                <div class="sm-cm-title">Notes<span>${_smEsc(s.label || (s.kind === 'reel' ? 'Reel' : 'Thumbnail'))}</span></div>
                <div class="sm-cm-head-actions"><button class="sm-cm-close" onclick="closeSmComments()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button></div>
            </div>
            <div class="sm-cm-feed" id="smCmFeed">${feed}</div>
            <div class="sm-cm-composer">
                ${replyCtx}${audience}
                <div class="sm-cm-composer-row">
                    <textarea id="smCmComposer" rows="1" placeholder="${_smChangeReqPending === id ? 'Describe the change, then hit Send…' : (_smClientSurface() ? 'Add a note or request a change…' : 'Write a note…')}" oninput="_smComposerInput(this)" onkeydown="_smComposerKey(event)">${_smEsc(draft)}</textarea>
                    <button class="sm-cm-send" id="smCmSend" onclick="_smSubmitComposer()"${draft.trim() ? '' : ' disabled'}>Send</button>
                </div>
            </div>`;
    }
    function _smComposerInput(ta){ const b = document.getElementById('smCmSend'); if(b) b.disabled = !ta.value.trim(); ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 140) + 'px'; }
    function _smComposerKey(e){ if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); _smSubmitComposer(); } else if(e.key === 'Escape' && _smReplyTarget){ e.preventDefault(); _smBeginReply(null); } }
    function _smBeginReply(rootId){ _smCaptureDraft(); _smReplyTarget = rootId || null; const f = document.getElementById('smCmFeed'); const sc = f ? f.scrollTop : null; _smRenderCommentsModal(); const f2 = document.getElementById('smCmFeed'); if(f2 && sc != null) f2.scrollTop = sc; const ta = document.getElementById('smCmComposer'); if(ta) ta.focus(); }
    function _smSetAudience(a){ _smComposeAudience = a; _smCaptureDraft(); _smRenderCommentsModal(); const ta = document.getElementById('smCmComposer'); if(ta) ta.focus(); }
    function _smSubmitComposer(){
        const id = _smOpenCommentsId; if(!id) return;
        _smCaptureDraft();
        const body = (_smReplyTarget ? (_smReplyDrafts[_smReplyTarget] || '') : (_smRootDraft || '')).trim();
        if(!body) return;
        const parentId = _smReplyTarget;
        // A "Request a change" only takes effect once the client actually sends
        // a note — flip the card to "changes" here, not when the button was first
        // clicked. The flush inside _smAppendComment then persists both at once.
        let flippedToChanges = false;
        if(_smChangeReqPending === id && _smClientSurface()){
            const s = _smFind(id);
            if(s && _smApprNorm(s.approval) === 'client'){ s.approval = 'changes'; flippedToChanges = true; }
            _smChangeReqPending = null;
        }
        _smAppendComment(id, parentId, body);
        if(parentId) delete _smReplyDrafts[parentId]; else _smRootDraft = '';
        _smReplyTarget = null;
        _smRenderCommentsModal();
        if(flippedToChanges) _smRenderBody();
        setTimeout(() => { const f = document.getElementById('smCmFeed'); if(f) f.scrollTop = f.scrollHeight; }, 0);
    }
    function _smAppendComment(id, parentId, body){
        const s = _smFind(id); if(!s) return;
        const now = new Date().toISOString();
        const role = _smCommentRole();
        const msg = { id: _smMintId('c'), parent_id: parentId || null, author: _smCurrentAuthor(), role, body, created_at: now, updated_at: now };
        if(!parentId) msg.audience = role === 'client' ? 'client' : _smComposeAudience;
        s.comments = Array.isArray(s.comments) ? s.comments.slice() : [];
        s.comments.push(msg);
        _smFlushCardSave(id);
        _smMarkSeen(id);
        _smRefreshCommentsBtn(id);
    }
    function _smDeleteComment(cid){
        const id = _smOpenCommentsId; const s = _smFind(id); if(!s) return;
        showConfirm('Delete this note?', 'This can\'t be undone.', () => {
            const now = new Date().toISOString();
            (s.comments || []).forEach(c => { if(c.id === cid || c.parent_id === cid){ c.deleted = true; c.updated_at = now; } });
            _smFlushCardSave(id); _smRenderCommentsModal(); _smRefreshCommentsBtn(id);
        }, 'Delete');
    }

    /* ---- toggles + share ---- */
    function setSmKind(k){ if(!SM_KINDS.includes(k) || smState.kind === k) return; smState.kind = k; _smSavePrefs(); _smRenderShell(); _smRenderBody(); }
    function setSmMode(m){ if((m !== 'editor' && m !== 'client') || smState.mode === m) return; smState.mode = m; _smRenderShell(); _smRenderBody(); }
    function _smCopyCardLink(e, id){
        if(e){ e.preventDefault(); e.stopPropagation(); }
        if(!smState.client) return;
        const url = `${location.origin}${location.pathname}#samples/${smClientSlug(smState.client)}/${encodeURIComponent(id)}`;
        const btn = e && e.currentTarget;
        const done = () => { if(!btn) return; const o = btn.innerHTML; btn.classList.add('copied'); btn.innerHTML = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.5L6 11l5.5-7"/></svg>`; setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = o; }, 1500); };
        if(navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, () => window.prompt('Copy link:', url));
        else window.prompt('Copy link:', url);
    }
    async function smCopyShareLink(){
        if(!smState.client) return;
        let url; try { url = await _syncviewIssueClientShareUrl(smState.client, 'samples'); } catch(e) { showToast((e&&e.message)||'Could not issue a secure client link'); return; }
        const done = () => { const b = document.getElementById('smShareBtn'); if(!b) return; const o = b.dataset.orig || b.innerHTML; b.dataset.orig = o; b.classList.add('copied'); b.innerHTML = `<svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7L5.5 10.5L12 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Link copied`; setTimeout(() => { b.classList.remove('copied'); b.innerHTML = o; }, 2200); };
        if(navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, () => window.prompt('Copy this link:', url));
        else window.prompt('Copy this link:', url);
    }

    /* True for ctrl/cmd/shift/alt-clicks (and non-primary buttons): the user
       wants the browser's own link behaviour — open in new tab/window — so
       inline nav handlers must NOT preventDefault. The hrefs are real hash
       routes that init() restores in the new tab. */
    function _modClick(e) { return !!(e && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e.button && e.button !== 0))); }
    function _resolveRetiredSamplesRoute(page) {
        const route = String(page || '');
        return route === 'samples' || route.startsWith('samples/') ? 'sample-reviews' : page;
    }
    /* Park the sliding pill under the active header tab.
       offsetLeft/offsetTop are measured against #headerNav (position: relative,
       so it is the offset parent) — the same scrolled coordinate space the pill
       is absolutely positioned in, which is why the pill stays glued to its tab
       while the strip scrolls horizontally.
       Fail-soft by contract: if anything is missing or the active tab is not
       rendered (client-link header removal, a hidden flag tab, a zero-width
       first paint), we drop `pill-ready` and the app falls back to the original
       per-button .active background. This must never throw — the boot probes
       fail on any console error. `animate` defaults to "animate unless this is
       the first placement", so the pill appears parked rather than flying in. */
    function _navPillSync(animate) {
        try {
            // While the pre-paint gate is still up, the CSS route highlight owns
            // the active look and the .active CLASS may still be on the statically
            // marked tab. Establishing the pill here would park it under the wrong
            // tab and make the first real route animate a fly-in, so wait for
            // navTo()/render() to lift the gate.
            if (document.documentElement.hasAttribute('data-boot-nav')) return;
            const nav = document.getElementById('headerNav');
            if (!nav) return;
            const pill = nav.querySelector(':scope > .header-nav-pill');
            if (!pill) return;
            const active = nav.querySelector(':scope > .header-nav-btn.active');
            if (!active || !active.getClientRects().length || !active.offsetWidth) {
                nav.classList.remove('pill-ready');
                return;
            }
            const first = !nav.classList.contains('pill-ready');
            const shouldAnimate = animate === undefined ? !first : !!animate;
            if (!shouldAnimate) pill.style.transition = 'none';
            pill.style.width = active.offsetWidth + 'px';
            pill.style.height = active.offsetHeight + 'px';
            pill.style.transform = 'translate(' + active.offsetLeft + 'px, ' + active.offsetTop + 'px)';
            nav.classList.add('pill-ready');
            if (!shouldAnimate) requestAnimationFrame(() => { try { pill.style.transition = ''; } catch (e) {} });
        } catch (e) {}
    }
    // Re-measure on anything that can change a tab's width or position: viewport
    // changes, the webfont swapping in, and tabs revealed later by a flag.
    try {
        window.addEventListener('resize', () => _navPillSync(false));
        if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
            document.fonts.ready.then(() => _navPillSync(false)).catch(() => {});
        }
    } catch (e) {}
    /* PER-TAB FAVICON (owner request 2026-08-21: "whenever we are in a tab the
       favicon should change to the respective one").

       Keyed on the ROUTE, never on the visible label -- the label/route split
       is deliberate here ('SyncLinear' is route `production`; 'Submit' is route
       `linear`) and AGENTS.md forbids deriving routing from what a tab says.
       A route with no owner-designed icon (kasper, tiktok-pilot, time-off, and
       every client-owned screen) falls back to the SyncView mark, so the tab
       icon is never left showing art from the previous section.

       Deliberately NOT duplicated into the pre-paint boot gate: that script
       must never throw and never log (see the block at the top of <head>), and
       test/boot-gate-parity.js exists to catch a drifted copy. The cost is a
       sub-second default-mark flash on a hard refresh into a deep link, which
       self-corrects the moment navTo runs. */
    const SYNCVIEW_DEFAULT_FAVICON = 'syncview-favicon.png';
    const SYNCVIEW_TAB_FAVICONS = {
        home: 'nav-icons/analytics-favicon.png',
        production: 'nav-icons/synclinear-favicon.png',
        linear: 'nav-icons/submit-favicon.png',
        templates: 'nav-icons/templates-favicon.png',
        'filming-plans': 'nav-icons/filming-plans-favicon.png',
        workload: 'nav-icons/workload-favicon.png',
        calendar: 'nav-icons/calendar-favicon.png',
        'sample-reviews': 'nav-icons/samples-favicon.png',
        'tiktok-upload': 'nav-icons/tiktok-favicon.png',
        // The two onboarding-facing routes keep SynchroSocial branding, which
        // the entry router already applies; naming them here keeps navTo from
        // overwriting it with the SyncView default.
        onboarding: 'synchro-social-favicon.png',
    };
    function _syncviewFaviconFor(page) {
        return SYNCVIEW_TAB_FAVICONS[String(page || '')] || SYNCVIEW_DEFAULT_FAVICON;
    }
    function _syncviewApplyTabFavicon(page) {
        try {
            let link = document.querySelector('link[rel="icon"]');
            if (!link) {
                link = document.createElement('link');
                link.rel = 'icon';
                document.head.appendChild(link);
            }
            const next = _syncviewFaviconFor(page);
            link.type = 'image/png';
            // Assigning an identical href still restarts the fetch in some
            // browsers, which makes the tab icon blink on every re-render.
            if (link.getAttribute('href') !== next) link.setAttribute('href', next);
        } catch (e) {}
    }
    /* A teardown whose fragment has not run yet has nothing mounted, so there
       is nothing to tear down. Boot can call navTo() before a later fragment's
       top-level `let`s initialise (a fragment moved or turned into a module,
       phase C), and reading one then throws "Cannot access X before
       initialization". Unguarded, that aborted navTo() half way: ?intake=1 kept
       its loading skeleton forever once #1551 made the boot router stand down
       after any navTo(). Only that load-order error is absorbed; any other
       error still throws. */
    function _navTeardownSafe(fn) {
        try { fn(); }
        catch (e) {
            if (e instanceof ReferenceError && /before initiali[sz]ation|uninitiali[sz]ed variable/i.test(String(e.message || ''))) return;
            throw e;
        }
    }
    function navTo(page, push = true) {
        if (page !== 'kasper' && typeof _analyticsReleaseExtras === 'function') _analyticsReleaseExtras();
        if (_isClientLink) {
            const cap = _syncviewClientEntryCapability;
            if (cap && cap.verified && cap.view === 'sample-reviews' && _resolveRetiredSamplesRoute(page) === 'sample-reviews') {
                mountSxrClientView(cap.client);
                return;
            }
            // Client-owned documents never fall through to staff Home,
            // Production, generic SXR, or any hash route.
            _syncviewInvalidClientLinkScreen();
            return;
        }
        _syncviewNavEpoch++; // Phase D: tell a still-loading boot router that someone has moved on.
        if (page === 'brief') page = 'home';
        // Client intake link locks the whole SPA to the Linear submission flow,
        // so every navigation (back button, restored hash, logo) lands on it.
        if (document.body.classList.contains('intake-mode')) page = 'linear';
        if (document.body.classList.contains('onboarding-mode')) page = 'onboarding';
        // Routing has decided: hand off from the pre-paint boot gate (the
        // <head> boot script's data-boot-nav tag) to the real nav toggles below.
        document.documentElement.removeAttribute('data-boot-nav');
        document.documentElement.removeAttribute('data-boot-subtab');
        if (page === 'time-off' && !_ptoEnabled()) page = 'home';
        page = _resolveRetiredSamplesRoute(page); // Samples Old Phase 1: route to Samples New; keep legacy code dormant.
        if (page === 'production' && !_prodAccessAllowed()) page = 'home';
        currentNav = page;
        // Guarded: on a FULL localStorage (a heavy user whose caches filled the
        // quota) this setItem throws QuotaExceededError, and unguarded it aborted
        // the REST of navTo — so every tab click silently did nothing until the
        // user cleared storage. Persisting the last tab is a nice-to-have; never
        // let it break navigation. (Every other localStorage write here is
        // likewise wrapped — this one was the lone gap.)
        try {
            if (_isSmmWeeklyRoute(page)) {
                if (_isSmmWeeklyRoute(localStorage.getItem(NAV_KEY))) localStorage.removeItem(NAV_KEY);
            } else {
                localStorage.setItem(NAV_KEY, page);
            }
        } catch (e) {}
        document.getElementById('navHome').classList.toggle('active', page === 'home');
        document.getElementById('navLinear').classList.toggle('active', page === 'linear');
        const navProd = document.getElementById('navProd');
        if (navProd) navProd.classList.toggle('active', page === 'production');
        const navTpl = document.getElementById('navTemplates');
        if (navTpl) navTpl.classList.toggle('active', page === 'templates');
        const navFp = document.getElementById('navFilmingPlans');
        if (navFp) navFp.classList.toggle('active', page === 'filming-plans');
        const navWl = document.getElementById('navWorkload');
        if (navWl) navWl.classList.toggle('active', page === 'workload');
        const navCal = document.getElementById('navCalendar');
        if (navCal) navCal.classList.toggle('active', page === 'calendar');
        const navSamp = document.getElementById('navSamples');
        if (navSamp) navSamp.classList.toggle('active', page === 'samples');
        const navTk = document.getElementById('navTiktokUpload');
        if (navTk) navTk.classList.toggle('active', page === 'tiktok-upload');
        const navKp = document.getElementById('navKasper');
        if (navKp) navKp.classList.toggle('active', page === 'kasper');
        const navTtp = document.getElementById('navTiktokPilot');
        if (navTtp) navTtp.classList.toggle('active', page === 'tiktok-pilot');
        const navSxr = document.getElementById('navSxr'); if (navSxr) navSxr.classList.toggle('active', page === 'sample-reviews'); // SXR_LINE
        const navTimeOff = document.getElementById('navTimeOff'); if (navTimeOff) navTimeOff.classList.toggle('active', page === 'time-off'); // menu-only route; intentionally no visible nav button
        _syncviewApplyTabFavicon(page);
        const activeHeaderNav = document.querySelector('#headerNav > .header-nav-btn.active');
        if (activeHeaderNav && activeHeaderNav.getClientRects().length && typeof activeHeaderNav.scrollIntoView === 'function') {
            requestAnimationFrame(() => activeHeaderNav.scrollIntoView({ block: 'nearest', inline: 'nearest' }));
        }
        _navPillSync();
        // The standalone Calendar page hides the page header (pageTop) and drops
        // the toolbar straight under the sticky nav, so the global .main top
        // gutter reads as dead space. Tag the body so we can tighten that band
        // (and the toolbar margins) for this page only — see body.cal-page CSS.
        document.body.classList.toggle('cal-page', page === 'calendar');
        if (page === 'sample-reviews') document.body.classList.add('cal-page'); // SXR_LINE
        // Production is the one viewport-owned page: body scroll is disabled so
        // the inner scrollers of the module are the only scrollbars. Every non-navTo
        // route (render(), the popstate client branch) must clear this class.
        document.body.classList.toggle('prod-page', page === 'production');
        document.body.classList.toggle('smm-weekly-mode', _isSmmWeeklyRoute(page));

        // Tear down the TikTok-upload polling timer whenever we leave the page so
        // it doesn't keep hitting the queue webhook in the background.
        if (page !== 'tiktok-upload' && typeof _tkTeardown === 'function') _navTeardownSafe(_tkTeardown);
        // Same teardown for the gated first-party TikTok Pilot tab's poller.
        if (page !== 'tiktok-pilot' && typeof _ttpTeardown === 'function') _navTeardownSafe(_ttpTeardown);
        // Same for Kasper review's 30 s background poller + visibility listeners.
        if (page !== 'kasper' && typeof _kasperTeardown === 'function') _navTeardownSafe(_kasperTeardown);
        // Phase 2: drop the calendar's Supabase realtime subscription when
        // leaving the calendar so it isn't held open in the background.
        if (page !== 'calendar' && typeof _calV2Teardown === 'function') _navTeardownSafe(_calV2Teardown);
        /* LEAVING THE CALENDAR ENDS THE FOCUS PIN. onCalViewChange drops it when
           you leave the Sheet and _calSetClient drops it when the client
           changes, but neither fires when you navigate to Home or another
           top-level route — and coming back to the SAME pinned client is a
           no-op switch, so the pin survived the round trip and kept forcing one
           card past the saved month, status and ready-only filters long after
           the reader had moved on. Codex P2 on PR 1252; the third and last way
           it can go stale. (Written "PR 1252", not with a hash: the hardcoded-
           colour guard reads a four-hex-digit token after a # as a colour
           literal, which is a fair reading and cost one CI cycle to learn.) */
        if (page !== 'calendar') calState.focusPid = null;
        /* Codex review, PR for item 176 (fourth pass, generalized on the
         * seventh): a card link's "Opening linked card…" toast has no
         * reason to follow the reader onto an unrelated page once they've
         * left the calendar — it would otherwise sit there, for up to ~21s,
         * saying something about a page that is no longer showing. Same
         * leaving-the-calendar signal as focusPid just above. Seventh pass:
         * navTo is not the only exit — render() and the state.client
         * popstate branch both bypass it too (their own comments say so),
         * so this is a shared function, not inline here, called from every
         * route that already shares the _calV2Teardown line beside it. */
        if (typeof _calAbandonLinkOnCalendarExit === 'function') _calAbandonLinkOnCalendarExit(page === 'calendar');
        if (page !== 'sample-reviews' && typeof _sxrV2Teardown === 'function') _navTeardownSafe(_sxrV2Teardown); // SXR_LINE
        // Leaving Samples while its Notes modal is open would otherwise leave
        // the body scroll-locked; clear the lock on every navigation away.
        if (page !== 'samples') document.body.classList.remove('sm-modal-open');
        // Phase 2: drop the Samples Supabase realtime subscription when leaving.
        if (page !== 'samples' && typeof _smV2Teardown === 'function') _navTeardownSafe(_smV2Teardown);
        if (page !== 'workload' && typeof _wlV2Teardown === 'function') _navTeardownSafe(_wlV2Teardown);

        const state = {nav: page, client: null};
        // Templates keeps the selected client + active tab in the URL / history
        // state so a refresh or back/forward restores exactly where you were —
        // navTo otherwise resets the hash to #templates and drops the client,
        // which made a second refresh fall back to the index. The client rides in
        // the hash (#templates/<client>); the tab rides in state (survives reload).
        if (page === 'templates' && _templatesSelected) { state.templatesClient = _templatesSelected; state.templatesTab = _templatesActiveTab; }
        if (page === 'onboarding') {
            // Standalone onboarding form gets a clean path URL, served on GitHub Pages via the
            // 404.html redirect. The AI funnel keeps its own /ai_onboarding_form path so the two
            // forms are individually shareable. Guarded: replaceState to a different path throws
            // on file:// (local tests), which we can safely ignore.
            try { history.replaceState(state, '', OB_VARIANT === 'ai' ? '/ai_onboarding_form' : '/onboarding_form'); } catch (e) {}
        } else {
            let hash = (page !== 'home' ? '#' + page : '');
            if (page === 'templates' && _templatesSelected) hash = '#templates/' + encodeURIComponent(_templatesSelected);
            // Same for Kasper's subtab: writing a bare #kasper here is what made
            // every reload of a Kasper subtab land on review (speed map
            // 2026-09-23 §7) -- the first load rendered the subtab, then this
            // line erased it from the URL the reload reads.
            if (page === 'kasper' && typeof _kasperState !== 'undefined' && _kasperState
                && _kasperState.tab && _kasperState.tab !== 'review') hash = '#kasper/' + _kasperState.tab;
            const query = new URLSearchParams(location.search);
            if (page === 'production') query.set('prod', '1');
            else query.delete('prod');
            const queryText = query.toString();
            const url = location.pathname + (queryText ? '?' + queryText : '') + hash;
            if (push) history.pushState(state, '', url);
            else history.replaceState(state, '', url);
        }

        const pageTop = document.getElementById('pageTop');
        const content = document.getElementById('content');

        if (page === 'linear') {
            pageTop.style.display = 'none';
            content.innerHTML = renderLinearView();
            if (!linearProjects.length && !linearProjectsLoading) fetchLinearProjects();
            loadLinearPlanMap();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'production') {
            pageTop.style.display = 'none';
            content.innerHTML = renderProductionView();
            mountProductionView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'templates') {
            pageTop.style.display = 'none';
            content.innerHTML = renderTemplatesView();
            mountTemplatesView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'filming-plans') {
            pageTop.style.display = 'none';
            content.innerHTML = renderFilmingPlansView();
            mountFilmingPlansView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'workload') {
            pageTop.style.display = 'none';
            content.innerHTML = renderWorkloadShell();
            initWorkloadView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'time-off') {
            pageTop.style.display = 'none';
            content.innerHTML = renderTimeOffView();
            mountTimeOffView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'calendar') {
            pageTop.style.display = 'none';
            content.innerHTML = renderCalendarView();
            mountCalendar();
            window.scrollTo({ top: 0, behavior: 'instant' });
        // >>> SXR_BEGIN
        } else if (page === 'sample-reviews') {
            pageTop.style.display = 'none';
            content.innerHTML = renderSxrView();
            mountSxrView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        // <<< SXR_END
        } else if (page === 'samples') {
            pageTop.style.display = 'none';
            content.innerHTML = renderSamplesView();
            mountSamplesView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'tiktok-upload') {
            pageTop.style.display = 'none';
            content.innerHTML = renderTiktokUploadView();
            mountTiktokUploadView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'tiktok-pilot') {
            pageTop.style.display = 'none';
            content.innerHTML = renderTiktokPilotView();
            mountTiktokPilotView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'smm-weekly-report') {
            pageTop.style.display = 'none';
            content.innerHTML = renderSmmWeeklyReportFormView();
            mountSmmWeeklyReportFormView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'smm-weekly-reports') {
            pageTop.style.display = 'none';
            content.innerHTML = renderSmmWeeklyReportsView();
            mountSmmWeeklyReportsView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'kasper') {
            pageTop.style.display = 'none';
            content.innerHTML = renderKasperView();
            mountKasperView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else if (page === 'onboarding') {
            pageTop.style.display = 'none';
            content.innerHTML = renderOnboardingView();
            mountOnboardingView();
            window.scrollTo({ top: 0, behavior: 'instant' });
        } else {
            pageTop.style.display = '';
            render('all');
        }
    }

