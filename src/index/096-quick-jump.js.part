import { currentNav } from './065-core-nav-intake-state.js';
import { WL_CLIENT_NAMES, wlCanonicalClient } from './070-core-client-names.js';
import { navTo } from './092-core-submit-form-navigation.js';
import { SV_CLIENT_FOLLOW_TABS, svOpenAnalytics, svSharedClientGet, svSharedClientNote } from './095-shared-client.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
    /* QUICK JUMP (owner decision 2026-09-27). Press / anywhere, type part of a
     * client and a tab ("luna cal"), press Enter: that client becomes the
     * shared client and the tab opens on it. A tab alone ("workload") just
     * opens the tab; a client alone opens it on the tab you are on (or the
     * Calendar when you are on a team tab).
     *
     * Staff only (body.sv-shared-client, which client links never get), never
     * while typing in a field, and never on SyncLinear, whose own "/" opens its
     * search palette and keeps doing so. */
    const SV_JUMP_TABS = [
        { page: 'calendar', label: 'Calendar', nav: 'navCalendar', words: ['calendar', 'cal'] },
        { page: 'sample-reviews', label: 'Samples', nav: 'navSxr', words: ['samples', 'sample', 'sxr'] },
        { page: 'templates', label: 'Templates', nav: 'navTemplates', words: ['templates', 'template', 'tpl'] },
        { page: 'filming-plans', label: 'Filming Plans', nav: 'navFilmingPlans', words: ['filming', 'plans', 'plan', 'fp'] },
        { page: 'tiktok-upload', label: 'TikTok Upload', nav: 'navTiktokUpload', words: ['tiktok', 'upload', 'tt'] },
        { page: 'home', label: 'Analytics', nav: 'navHome', words: ['analytics', 'stats'] },
        { page: 'workload', label: 'Workload', nav: 'navWorkload', words: ['workload', 'wl'] },
        { page: 'production', label: 'SyncLinear', nav: 'navProd', words: ['synclinear', 'linear', 'issues'] },
        { page: 'linear', label: 'Submit', nav: 'navLinear', words: ['submit'] },
        { page: 'kasper', label: 'Kasper', nav: 'navKasper', words: ['kasper'] },
    ];
    function _svJumpTabVisible(t) {
        const el = document.getElementById(t.nav);
        return !!el && el.getClientRects().length > 0 && getComputedStyle(el).display !== 'none';
    }
    // A token names a tab when it is a prefix (2+ letters) of one of its words.
    function _svJumpTabFor(token) {
        if (!token || token.length < 2) return null;
        return SV_JUMP_TABS.find(t => _svJumpTabVisible(t) && t.words.some(w => w.startsWith(token))) || null;
    }
    function _svJumpClients(q) {
        const all = [...new Set(WL_CLIENT_NAMES.map(n => { try { return wlCanonicalClient(n) || n; } catch (e) { return n; } }))];
        const words = String(q || '').toLowerCase().split(/\s+/).filter(Boolean);
        if (!words.length) return [];
        const scored = all.map(n => {
            const low = n.toLowerCase();
            if (!words.every(w => low.includes(w))) return null;
            const starts = low.startsWith(words[0]) || low.split(/\s+/).some(p => p.startsWith(words[0]));
            return { n, score: starts ? 0 : 1 };
        }).filter(Boolean);
        return scored.sort((a, b) => a.score - b.score || a.n.localeCompare(b.n)).map(s => s.n).slice(0, 7);
    }
    // Every reading of the query, best first: { client, tab }.
    function svQuickJumpOptions(query) {
        const tokens = String(query || '').trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (!tokens.length) return [];
        const here = SV_JUMP_TABS.find(t => t.page === currentNav && SV_CLIENT_FOLLOW_TABS.includes(t.page));
        const fallbackTab = here || SV_JUMP_TABS[0];
        const out = [];
        const seen = new Set();
        const add = (client, tab) => {
            const key = (client || '') + '\u0000' + tab.page;
            if (seen.has(key)) return;
            seen.add(key);
            out.push({ client, tab });
        };
        // Try each token as the tab word (last token first: "luna cal").
        for (let i = tokens.length - 1; i >= 0; i--) {
            const tab = _svJumpTabFor(tokens[i]);
            if (!tab) continue;
            const rest = tokens.filter((_, j) => j !== i).join(' ');
            if (!rest) { add(null, tab); continue; }
            if (!SV_CLIENT_FOLLOW_TABS.includes(tab.page)) continue;
            _svJumpClients(rest).forEach(c => add(c, tab));
        }
        // The whole query as a client, on the tab you are on.
        _svJumpClients(tokens.join(' ')).forEach(c => add(c, fallbackTab));
        return out.slice(0, 8);
    }
    function svQuickJumpGo(opt) {
        if (!opt || !opt.tab) return;
        svQuickJumpClose();
        if (opt.client) {
            svSharedClientNote(opt.client);
            // A card link for another client (#calendar/<slug>/<card>) would
            // outlive the jump in the address and reopen the old client on reload.
            try {
                if (/^#(calendar|sample-reviews)\//.test(location.hash)) history.replaceState(history.state, '', location.pathname + location.search);
            } catch (e) {}
        }
        if (opt.tab.page === 'home') svOpenAnalytics();
        else navTo(opt.tab.page);
    }

    let _svJumpActive = 0;
    let _svJumpOpts = [];
    let _svJumpReturnFocus = null;
    function _svJumpRender() {
        const input = document.getElementById('svJumpInput');
        const list = document.getElementById('svJumpList');
        if (!input || !list) return;
        _svJumpOpts = svQuickJumpOptions(input.value);
        if (_svJumpActive >= _svJumpOpts.length) _svJumpActive = 0;
        const cur = svSharedClientGet();
        list.innerHTML = _svJumpOpts.length
            ? _svJumpOpts.map((o, i) => `<div class="sv-jump-row${i === _svJumpActive ? ' is-active' : ''}" role="option" id="svJumpOpt${i}" aria-selected="${i === _svJumpActive}" data-sv-jump="${i}">
                    <span class="sv-jump-client">${o.client ? _calEsc(o.client) : '<span class="sv-jump-muted">Open tab</span>'}</span>
                    <span class="sv-jump-tab">${_calEsc(o.tab.label)}</span>
                </div>`).join('')
            : `<div class="sv-jump-empty">${input.value.trim() ? 'Nothing matches. Try part of a client name and a tab, like “' + _calEscAttr(cur ? cur.split(/\s+/)[0].toLowerCase() : 'client') + ' cal”.' : 'Type part of a client and a tab, then press Enter.'}</div>`;
        input.setAttribute('aria-activedescendant', _svJumpOpts.length ? 'svJumpOpt' + _svJumpActive : '');
    }
    function svQuickJumpOpen() {
        const box = document.getElementById('svJump');
        if (!box) return;
        _svJumpReturnFocus = document.activeElement;
        box.hidden = false;
        const input = document.getElementById('svJumpInput');
        _svJumpActive = 0;
        if (input) { input.value = ''; _svJumpRender(); input.focus(); }
    }
    function svQuickJumpClose() {
        const box = document.getElementById('svJump');
        if (!box || box.hidden) return;
        box.hidden = true;
        try { if (_svJumpReturnFocus && document.contains(_svJumpReturnFocus)) _svJumpReturnFocus.focus(); } catch (e) {}
        _svJumpReturnFocus = null;
    }
    function _svJumpWire() {
        const box = document.getElementById('svJump');
        if (!box || box.dataset.wired === '1') return;
        box.dataset.wired = '1';
        const input = document.getElementById('svJumpInput');
        input.addEventListener('input', () => { _svJumpActive = 0; _svJumpRender(); });
        input.addEventListener('keydown', e => {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                if (!_svJumpOpts.length) return;
                _svJumpActive = (_svJumpActive + (e.key === 'ArrowDown' ? 1 : -1) + _svJumpOpts.length) % _svJumpOpts.length;
                _svJumpRender();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                svQuickJumpGo(_svJumpOpts[_svJumpActive]);
            } else if (e.key === 'Escape') {
                e.preventDefault();
                svQuickJumpClose();
            }
        });
        // Keep keyboard focus inside the dialog; Escape closes from anywhere in it.
        box.addEventListener('keydown', e => {
            if (e.key === 'Tab') { e.preventDefault(); input.focus(); }
            else if (e.key === 'Escape' && e.target !== input) { e.preventDefault(); svQuickJumpClose(); }
        });
        box.addEventListener('mousedown', e => {
            const row = e.target.closest('[data-sv-jump]');
            if (row) { e.preventDefault(); svQuickJumpGo(_svJumpOpts[Number(row.getAttribute('data-sv-jump'))]); return; }
            if (e.target === box) svQuickJumpClose();
        });
        document.addEventListener('keydown', e => {
            if (!(e.key === '/' || e.code === 'Slash') || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
            if (!document.body.classList.contains('sv-shared-client')) return;   // staff only; never on client links
            if (document.getElementById('prodRoot')) return;                     // SyncLinear keeps its own "/"
            const a = document.activeElement;
            if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.tagName === 'SELECT' || a.isContentEditable)) return;
            // Another dialog on screen owns the keyboard.
            const openDialog = [...document.querySelectorAll('[role="dialog"], .confirm-overlay')]
                .some(el => !box.contains(el) && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden');
            if (openDialog) return;
            if (!box.hidden) return;
            e.preventDefault();
            svQuickJumpOpen();
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', _svJumpWire);
    else _svJumpWire();

    window.svQuickJumpOpen = svQuickJumpOpen;
