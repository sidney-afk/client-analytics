import { currentNav } from './065-core-nav-intake-state.js';
import { _isClientLink } from './260-production-refresh-boot.js';
import { clientMap } from './040-shared-briefs.js';
import { wlState } from './066-core-workload-state.js';
    /* PHONE SHELL FOR THE STAFF SCREENS (TikTok and Instagram Upload,
       Analytics, Workload, SyncLinear; approved mock-up, layout A).
       On a phone these screens drop the logo header and nav row and show a
       title with Tabs and More beside it. Nothing is built at desktop widths:
       the bar is created only while the viewport is 767px or narrower, and
       every action (nav links, client picker, theme, staff menu) is the
       existing control, reached by clicking it. */
    const FPH_SCREENS = {
        'tiktok-upload': { title: () => (document.getElementById('tkPlatInstagram')?.classList.contains('on') ? 'Instagram Upload' : 'TikTok Upload'), client: true },
        home: { title: () => 'Analytics', client: true },
        workload: { title: () => 'Workload', client: false },
        production: { title: () => 'Linear', client: false }
    };
    const FPH_MQ = window.matchMedia('(max-width: 767px)');
    let _fphBar = null;
    let _fphRaf = 0;
    const FPH_ICON = {
        chev: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg>',
        dots: '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><circle cx="4" cy="10" r="1.7"/><circle cx="10" cy="10" r="1.7"/><circle cx="16" cy="10" r="1.7"/></svg>',
        close: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"/></svg>',
        go: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 5 5-5 5"/></svg>',
        check: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8"/></svg>'
    };
    function _fphScreen() {
        if (_isClientLink || !document.body) return null;
        if (document.body.classList.contains('intake-mode') || document.body.classList.contains('onboarding-mode')) return null;
        // Booting into Today: currentNav still reads its default ('home')
        // until Today opens; do not show the Analytics bar in the meantime.
        if (currentNav !== 'today' && document.documentElement.getAttribute('data-boot-nav') === 'today') return null;
        return FPH_SCREENS[currentNav] || null;
    }
    function _fphEsc(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
    function _fphBuild() {
        if (_fphBar) return;
        const main = document.getElementById('mainWrap');
        if (!main || !main.parentNode) return;
        const bar = document.createElement('div');
        bar.className = 'fph-bar';
        bar.id = 'fphBar';
        bar.innerHTML = '<h1 class="fph-title" id="fphTitle"></h1><div class="fph-actions">'
            + '<button type="button" class="fph-btn" id="fphTabsBtn" aria-haspopup="dialog" aria-controls="fphTabs">Tabs ' + FPH_ICON.chev + '</button>'
            + '<button type="button" class="fph-btn fph-btn-icon" id="fphMoreBtn" aria-haspopup="dialog" aria-controls="fphMore" aria-label="More">' + FPH_ICON.dots + '</button></div>'
            + '<dialog class="fph-menu" id="fphTabs" aria-labelledby="fphTabsTitle"></dialog>'
            + '<dialog class="fph-menu" id="fphMore" aria-labelledby="fphMoreTitle"></dialog>';
        main.parentNode.insertBefore(bar, main);
        bar.querySelector('#fphTabsBtn').addEventListener('click', () => _fphOpen('fphTabs'));
        bar.querySelector('#fphMoreBtn').addEventListener('click', () => _fphOpen('fphMore'));
        bar.querySelectorAll('dialog').forEach(d => d.addEventListener('click', ev => {
            if (ev.target === d || ev.target.closest('[data-fph-close]')) d.close();
        }));
        _fphBar = bar;
    }
    function _fphMenuHead(id, title) {
        return '<div class="fph-menu-head"><h2 id="' + id + 'Title">' + _fphEsc(title) + '</h2><button type="button" data-fph-close aria-label="Close ' + _fphEsc(title.toLowerCase()) + '">' + FPH_ICON.close + '</button></div>';
    }
    function _fphVisible(el) { return !!el && el.style.display !== 'none' && !el.hidden; }
    function _fphOpen(id) {
        const dialog = document.getElementById(id);
        if (!dialog || dialog.open) return;
        dialog.innerHTML = _fphMenuHead(id, id === 'fphTabs' ? 'Tabs' : 'More') + '<div class="fph-menu-body"></div>';
        const body = dialog.querySelector('.fph-menu-body');
        const proxy = (label, el) => {
            if (!el || el.hidden || el.disabled) return;
            const b = document.createElement('button'); b.type = 'button'; b.className = 'fph-row';
            b.innerHTML = '<span>' + _fphEsc(label) + '</span>' + FPH_ICON.go;
            b.addEventListener('click', () => { dialog.close(); setTimeout(() => el.click(), 0); }); body.append(b);
        };
        if (id === 'fphTabs') window.svStaffPhoneMenus.tabs(body, dialog, 'fph-row');
        else {
            if (currentNav === 'production') {
                proxy('Search', document.querySelector('.prod-search-btn'));
                document.querySelectorAll('.prod-side .prod-nav').forEach(nav => {
                    const team = nav.querySelector('.prod-team-name');
                    nav.querySelectorAll('.prod-nav-btn').forEach(btn => {
                        const label = btn.textContent.replace(/\s+/g, ' ').trim();
                        if (label) proxy(team ? team.textContent.trim() + ': ' + label : label, btn);
                    });
                });
            }
            window.svStaffPhoneMenus.more(body, dialog, 'fph-row');
        }
        dialog.showModal();
    }
    // Workload days: each day cell is labelled "Sat, 3 Oct 2026" so the week and month can read as a day-by-day list.
    function _fphLabelDays() {
        document.querySelectorAll('.workload-day[data-wl-day]:not([data-fph-day])').forEach(cell => {
            const p = String(cell.getAttribute('data-wl-day')).split('-');
            const t = new Date(Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])));
            if (isNaN(t.getTime())) return;
            cell.setAttribute('data-fph-day', t.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).replace(/^(\w+) /, '$1, '));
        });
    }
    /* Text arrows and crosses on these controls (never a post's own text) are drawn as icons on a phone. */
    const FPH_GLYPHS = { '\u2190': 'left', '\u2192': 'right', '\u2191': 'up', '\u2193': 'down', '\u2197': 'upright', '\u2039': 'chev-left', '\u203A': 'chev-right', '\u25BE': 'chev-down', '\u21BB': 'refresh', '\u00D7': 'x' };
    const FPH_GLYPH_RE = new RegExp('([' + Object.keys(FPH_GLYPHS).join('') + '])');
    const FPH_GLYPH_SCOPE = '.tk-photo-btn, .tk-q-x, .back-btn, .m-delta, .platform-handle-link, .workload-overview-heading span, .workload-toolbar button, .dd-arrow, .wl-refresh-icon, .wl-client-search-clear, .overview-table thead th span';
    function _fphIconify() {
        document.querySelectorAll(FPH_GLYPH_SCOPE).forEach(el => {
            [...el.childNodes].forEach(node => {
                if (node.nodeType !== 3 || !FPH_GLYPH_RE.test(node.nodeValue)) return;
                const frag = document.createDocumentFragment();
                node.nodeValue.split(FPH_GLYPH_RE).forEach(part => {
                    if (FPH_GLYPHS[part]) {
                        const icon = document.createElement('span');
                        icon.className = 'fph-gl fph-gl-' + FPH_GLYPHS[part];
                        icon.setAttribute('aria-hidden', 'true');
                        frag.appendChild(icon);
                    } else if (part) frag.appendChild(document.createTextNode(part));
                });
                node.replaceWith(frag);
            });
        });
    }
    // Workload: the refresh button moves into the title row (same button, same click handler).
    function _fphWorkloadChrome() {
        const heading = document.querySelector('.workload-calendar-heading');
        const refresh = document.querySelector('.workload-toolbar [data-wl-nav="refresh"]');
        if (!heading || !refresh) return;
        heading.querySelectorAll('.fph-wl-refresh').forEach(old => old.remove());
        refresh.classList.add('fph-wl-refresh');
        heading.insertBefore(refresh, heading.querySelector('.workload-weekend-notice'));
    }
    // These are separate post groups, even when their client and count match.
    // Keep each native destination and add its post context only on a phone.
    const _fphWorkloadLabels = new Map();
    function _fphWorkloadPostLabels(phone) {
        for (const [chip, original] of _fphWorkloadLabels) {
            if (!chip.isConnected || !phone) {
                chip.querySelector('.fph-workload-post')?.remove();
                if (original === null) chip.removeAttribute('aria-label'); else chip.setAttribute('aria-label', original);
                _fphWorkloadLabels.delete(chip);
            }
        }
        if (!phone) return;
        document.querySelectorAll('.workload-overview-status-clients').forEach(group => {
            const chips = [...group.querySelectorAll('.wl-now-client-chip')];
            for (const chip of chips) {
                if (chip.querySelector('.fph-workload-post') || chips.filter(other => other.dataset.wlClient === chip.dataset.wlClient).length < 2) continue;
                const id = chip.dataset.wlParentId;
                const parent = wlState.parentById.get(id);
                const sub = wlState.allActiveSubs.find(item => item.parentId === id);
                const label = parent?.title || parent?.identifier || sub?.parentIdentifier;
                if (!label) continue;
                const context = document.createElement('span');
                context.className = 'fph-workload-post'; context.textContent = label;
                _fphWorkloadLabels.set(chip, chip.getAttribute('aria-label'));
                chip.querySelector('.wl-now-client-chip-name')?.appendChild(context);
                chip.setAttribute('aria-label', chip.getAttribute('aria-label') + ' · ' + label);
            }
        });
    }
    /* Analytics: every client gets its rank (the page numbers only the first three), and a 30 day views total of 0 beside a
       positive gain is shown as a dash with its reason: the total is today's count minus the count from 30 days ago, so a
       0 next to a gain cannot be a real total. */
    const FPH_VIEWS_REASON = 'No 30 day total yet: today\u2019s count matches the count from 30 days ago, so the total cannot be told apart from missing data.';
    function _fphAnalyticsRanks() {
        document.querySelectorAll('.cards-grid .client-card').forEach((card, i) => {
            const head = card.querySelector('.card-head > div');
            if (!head || head.querySelector('.card-rank')) return;
            const badge = document.createElement('span');
            badge.className = 'card-rank card-rank-n';
            badge.textContent = String(i + 1);
            head.insertBefore(badge, head.firstChild);
        });
        document.querySelectorAll('.overview-table tbody tr').forEach((row, i) => {
            const inner = row.querySelector('td .cell-inner');
            if (!inner || inner.querySelector('.top-rank-badge')) return;
            const badge = document.createElement('span');
            badge.className = 'top-rank-badge fph-rank';
            badge.textContent = String(i + 1);
            inner.insertBefore(badge, inner.firstChild);
        });
    }
    function _fphViewsDash() {
        const dash = (valEl, label) => {
            if (!valEl || valEl.getAttribute('data-fph-views')) return;
            valEl.setAttribute('data-fph-views', '1');
            valEl.textContent = '\u2014';
            valEl.setAttribute('title', FPH_VIEWS_REASON);
            valEl.setAttribute('aria-label', label + ': ' + FPH_VIEWS_REASON);
        };
        document.querySelectorAll('.card-metric').forEach(box => {
            const label = box.querySelector('.card-metric-label');
            const val = box.querySelector('.card-metric-val');
            const gain = box.querySelector('.card-metric-gain.up');
            if (label && val && gain && /views last 30d/i.test(label.textContent) && val.textContent.trim() === '0') dash(val, label.textContent.trim());
        });
        document.querySelectorAll('.metric-block').forEach(box => {
            const label = box.querySelector('.m-label');
            const val = box.querySelector('.m-value');
            const gain = box.querySelector('.m-delta.up, .m-delta.gain, .m-delta.pos');
            const delta = box.querySelector('.m-delta');
            const positive = gain || (delta && /^\s*\u2191|\+/.test(delta.textContent));
            if (label && val && positive && /views last 30d/i.test(label.textContent) && val.textContent.trim() === '0') dash(val, label.textContent.trim());
        });
    }
    const _fphAccountCopy = new WeakMap();
    const _fphDisconnectedCopy = new WeakMap();
    function _fphBrowseWords(on) {
        const pattern = on ? /\bclick to (browse|add)\b/g : /\btap to (browse|add)\b/g;
        const replacement = on ? 'tap to $1' : 'click to $1';
        document.querySelectorAll('.tk-drop-title').forEach(label => {
            [...label.childNodes].forEach(node => {
                if (node.nodeType !== 3) return;
                const text = node.nodeValue.replace(pattern, replacement);
                if (text !== node.nodeValue) node.nodeValue = text;
            });
        });
        document.querySelectorAll('.tk-profile-line').forEach(line => {
            const warning = line.querySelector('.tk-warn-chip');
            if (warning) {
                if (on) {
                    if (!_fphDisconnectedCopy.has(line)) _fphDisconnectedCopy.set(line, [...line.childNodes].filter(node => node !== warning));
                    const guidance = ' Ask an admin to connect this client in Clients, Publishing before uploading.';
                    if (line.textContent !== warning.textContent + guidance) line.replaceChildren(warning, document.createTextNode(guidance));
                } else if (_fphDisconnectedCopy.has(line)) {
                    line.replaceChildren(warning, ..._fphDisconnectedCopy.get(line));
                    _fphDisconnectedCopy.delete(line);
                }
                return;
            }
            const chip = line.querySelector('.tk-profile-chip'), label = line.firstChild;
            if (!chip || label?.nodeType !== 3) return;
            if (!_fphAccountCopy.has(line)) {
                if (!/^Posts to Post For Me account\s*$/.test(label.nodeValue)) return;
                _fphAccountCopy.set(line, { label: label.nodeValue, chip: chip.textContent });
            }
            const original = _fphAccountCopy.get(line);
            const client = line.getAttribute('data-tk-picked-client') || '';
            const handle = String(clientMap[client]?.tiktok_handle || '').trim().replace(/^@+/, '');
            const phoneAccount = on && currentNav === 'tiktok-upload'
                && !document.getElementById('tkPlatInstagram')?.classList.contains('on') && client;
            const text = phoneAccount ? (handle ? 'Posting to ' : 'Posting for ') : original.label;
            const account = phoneAccount ? (handle ? '@' + handle : client) : original.chip;
            if (label.nodeValue !== text) label.nodeValue = text;
            if (chip.textContent !== account) chip.textContent = account;
        });
    }
    // Canvas labels cannot inherit CSS. Keep the native options per axis,
    // including a phone-to-desktop crossing, without touching Chart defaults
    // or client review charts. The plugin also covers native series rebuilds.
    const _fphAxisOriginals = new WeakMap();
    let _fphChartPlugin = false;
    function _fphChartAxes(chart) {
        const phone = FPH_MQ.matches && _fphScreen() === FPH_SCREENS.home
            && !!chart.canvas?.closest('.client-view');
        const rootStyle = getComputedStyle(document.documentElement);
        let originals = _fphAxisOriginals.get(chart);
        if (phone && !originals) { originals = new Map(); _fphAxisOriginals.set(chart, originals); }
        let changed = false;
        for (const [axis, scale] of Object.entries(chart.config.options.scales || {})) {
            const ticks = scale.ticks;
            if (!ticks) continue;
            if (phone && !originals.has(axis)) {
                originals.set(axis, { font: ticks.font, color: ticks.color,
                    themeColor: ticks.color === rootStyle.getPropertyValue('--chart-axis').trim() });
            }
            const original = originals?.get(axis);
            if (!original) continue;
            const color = rootStyle.getPropertyValue(phone ? '--text-secondary' : '--chart-axis').trim();
            const font = phone ? { ...original.font, size: 13 } : original.font;
            const restoredColor = phone || original.themeColor ? color : original.color;
            if (ticks.font?.size !== font?.size || ticks.color !== restoredColor) {
                if (font === undefined) delete ticks.font; else ticks.font = font;
                if (restoredColor === undefined) delete ticks.color; else ticks.color = restoredColor;
                changed = true;
            }
        }
        if (!phone) _fphAxisOriginals.delete(chart);
        return changed;
    }
    function _fphCharts() {
        if (!window.Chart) return;
        if (!_fphChartPlugin) {
            window.Chart.register({ id: 'staffPhoneAnalyticsAxes',
                beforeInit(chart) { _fphChartAxes(chart); },
                beforeUpdate(chart) { _fphChartAxes(chart); } });
            _fphChartPlugin = true;
        }
        Object.values(window.Chart.instances).forEach(chart => {
            if (_fphChartAxes(chart)) chart.update('none');
        });
    }
    const _fphNameEditors = new Map();
    function _fphNameEditorSize(editor) {
        editor.style.height = 'auto';
        editor.style.height = Math.max(44, editor.scrollHeight) + 'px';
    }
    function _fphNameEditorsSync() {
        const phone = FPH_MQ.matches;
        for (const [editor, original] of _fphNameEditors) {
            if (!editor.isConnected) { _fphNameEditors.delete(editor); continue; }
            if (phone) { _fphNameEditorSize(editor); continue; }
            const focused = document.activeElement === editor;
            original.value = editor.value;
            editor.replaceWith(original);
            if (focused) original.focus({preventScroll:true});
            _fphNameEditors.delete(editor);
        }
        if (!phone) return;
        document.querySelectorAll('#calView[data-pocket-staff-phone] input.cal-fld-name, #sxrView[data-pocket-staff-samples] input.cal-fld-name').forEach(original => {
            const editor = document.createElement('textarea');
            for (const attr of original.attributes) if (attr.name !== 'type' && attr.name !== 'value') editor.setAttribute(attr.name, attr.value);
            editor.rows = 1;
            editor.setAttribute('data-pocket-title', '');
            editor.setAttribute('aria-label', 'Post title');
            editor.value = original.value;
            editor.addEventListener('input', () => {
                editor.value = editor.value.replace(/[\r\n]+/g, ' ');
                _fphNameEditorSize(editor);
            }, true);
            editor.addEventListener('keydown', event => {
                if (event.key === 'Enter' && !event.isComposing) { event.preventDefault(); editor.blur(); }
            });
            const focused = document.activeElement === original;
            original.replaceWith(editor);
            _fphNameEditors.set(editor, original);
            _fphNameEditorSize(editor);
            if (focused) editor.focus({preventScroll:true});
        });
    }

    function _fphSync() {
        _fphRaf = 0;
        _fphNameEditorsSync();
        const cfg = _fphScreen();
        const on = !!cfg && FPH_MQ.matches;
        _fphWorkloadPostLabels(on && currentNav === 'workload');
        _fphBrowseWords(on);
        const root = document.documentElement;
        if (on) {
            _fphBuild();
            if (_fphBar) _fphBar.hidden = false;
            const title = document.getElementById('fphTitle');
            const text = cfg.title();
            if (title && title.textContent !== text) title.textContent = text;
            // The warning glyph is a text character; on a phone the icon is
            // drawn by the layout instead, so the character is dropped.
            document.querySelectorAll('.tk-warn-chip').forEach(chip => {
                const t = chip.firstChild;
                if (t && t.nodeType === 3 && /^\u26A0\uFE0F?\s*/.test(t.nodeValue)) t.nodeValue = t.nodeValue.replace(/^\u26A0\uFE0F?\s*/, '');
            });
            if (currentNav === 'workload') { _fphLabelDays(); _fphWorkloadChrome(); }
            _fphIconify();
            if (currentNav === 'home') { _fphAnalyticsRanks(); _fphViewsDash(); }
            root.classList.add('fph-on');
            root.setAttribute('data-fph', currentNav);
        } else {
            root.classList.remove('fph-on');
            root.removeAttribute('data-fph');
            // The bar stays in the page once built; hide it so it never shows,
            // unstyled, on a screen it does not belong to.
            if (_fphBar) { _fphBar.querySelectorAll('dialog[open]').forEach(d => d.close()); _fphBar.hidden = true; }
        }
        _fphCharts();
    }
    function _fphQueue() { if (!_fphRaf) _fphRaf = requestAnimationFrame(_fphSync); }
    function _fphInit() {
        const nav = document.getElementById('headerNav');
        const main = document.getElementById('mainWrap');
        if (!nav || !main) return;
        const watch = new MutationObserver(_fphQueue);
        watch.observe(nav, { attributes: true, attributeFilter: ['class'], subtree: true });
        // The Upload page swaps its platform inside the same route.
        watch.observe(main, { attributes: true, attributeFilter: ['class'], childList: true, subtree: true });
        watch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        if (FPH_MQ.addEventListener) FPH_MQ.addEventListener('change', _fphQueue);
        _fphQueue();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', _fphInit);
    else _fphInit();
