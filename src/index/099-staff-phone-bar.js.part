                    change.setAttribute('aria-label', 'Change client'); change.dataset.proxy = 'svClientBadge';
                    change.innerHTML = '<span><strong>Change client</strong><small>' + esc(svSharedClientGet() || 'No client selected') + '</small></span>' + next;
                    change.addEventListener('click', event => { event.stopPropagation(); dialog.close(); setTimeout(() => window.svPhoneOpenClientPicker(), 0); });
                    body.append(change);
                }
                body.append(grid);
            },
            more(body, dialog, cls) {
