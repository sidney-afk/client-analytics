    /* STAFF PHONE BAR (Pocket phone design, approved layout A "Expanded").
     *
     * On a phone, supported staff screens (including personal Time Off)
     * drop the wide desktop header and show one title row instead: the screen
     * name on the left, Tabs and More on the right. Tabs lists every tab the
     * header shows today; More holds the header's account, appearance and
     * client controls. Nothing here is a new action: every row presses the
     * existing header control (same permissions, same handlers).
     *
     * The bar is created only on a phone-width screen showing a supported
     * tabs, and removed again everywhere else, so desktop widths never get a
     * single new element. Its look is the STAFF-PHONE block in
     * 020-styles-surfaces, every rule of which is phone-capped and rooted at
     * `body:has(.pocket-staff-bar)`.
     *
     * Menu-only Time Off is identified by its mounted root, not a new nav tab.
     * Other staff screens join by adding their nav id to POCKET_STAFF_PAGES. */
    (function () {
        const POCKET_STAFF_PAGES = { navToday: 'Today', navTemplates: 'Templates', navFilmingPlans: 'Filming Plans', navLinear: 'Submit' };
        const phone = window.matchMedia ? window.matchMedia('(max-width: 767px)') : null;
        const chevron = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg>';
        const dots = '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><circle cx="4" cy="10" r="1.7"/><circle cx="10" cy="10" r="1.7"/><circle cx="16" cy="10" r="1.7"/></svg>';
        const close = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9"/></svg>';
        const next = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 5 5-5 5"/></svg>';
        const tick = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 10.5 3.6 3.6 7.4-8"/></svg>';
        /* ONE PHONE DATE FORMAT: "Sat, 3 Oct 2026". Returns '' on anything wider
           than a phone (and on a bad date), so every caller keeps its own desktop
           wording by writing  window.svPhoneDate(d) || <its existing text>.
           Locale-independent on purpose: the same words on every phone. */
        /* True on a phone-width staff page (never a client link, never the public intake or onboarding form).
           Render code that words or sizes something differently on phones asks this; wider screens get false,
           so their output stays exactly what it was. */
        window.svIsStaffPhone = function () {
            return !!(phone && phone.matches) && !document.documentElement.classList.contains('boot-client')
                && !document.body.classList.contains('intake-mode') && !document.body.classList.contains('onboarding-mode');
        };
        const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        window.svPhoneDate = function (value) {
            if (!phone || !phone.matches || document.documentElement.classList.contains('boot-client')) return '';
            const d = value instanceof Date ? value : new Date(/^\d{4}-\d{2}-\d{2}$/.test(String(value || '')) ? value + 'T12:00:00' : value);
            return isNaN(d) ? '' : DAYS[d.getDay()] + ', ' + d.getDate() + ' ' + MONTHS[d.getMonth()] + ' ' + d.getFullYear();
        };
        const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        function activeNavId() {
            const a = document.querySelector('#headerNav > .header-nav-btn.active');
            return a ? a.id : '';
        }
        function wanted() {
            if (!phone || !phone.matches) return '';
            if (document.documentElement.classList.contains('boot-client')) return '';
            if (document.body.classList.contains('intake-mode') || document.body.classList.contains('onboarding-mode')) return '';
            if (document.querySelector('#content > .pto-wrap')) return 'Time Off';
            return POCKET_STAFF_PAGES[activeNavId()] || '';
        }
        function dialogHtml(kind, title) {
            return '<dialog class="pocket-staff-sheet" id="pocketStaff' + kind + '" aria-labelledby="pocketStaff' + kind + 'Title">'
                + '<div class="pocket-staff-sheet-head"><h2 id="pocketStaff' + kind + 'Title">' + title + '</h2>'
                + '<button type="button" class="pocket-staff-sheet-close" aria-label="Close ' + title.toLowerCase() + '">' + close + '</button></div>'
                + '<div class="pocket-staff-sheet-body" id="pocketStaff' + kind + 'Body"></div></dialog>';
        }
        // The visible tab label, widened to the full name when the header only abbreviates it (Filming, TikTok).
        function tabLabel(el) {
            const text = (el.textContent || '').replace(/\s+/g, ' ').trim();
            const full = (el.getAttribute('aria-label') || '').trim();
            return full && full.toLowerCase().indexOf(text.toLowerCase()) === 0 ? full : text;
        }

        // The same rows, labels and native destinations on every staff phone.
        // Helpers create no DOM at desktop widths or on client links.
        window.svStaffPhoneMenus = {
            label(el) {
                const labels = { navFilmingPlans: 'Filming Plans', navTiktokUpload: 'Upload', navProd: 'Linear' };
                return labels[el.id] || tabLabel(el);
            },
            tabs(body, dialog, cls) {
                dialog.classList.add('sv-phone-sheet');
                body.replaceChildren();
                document.querySelectorAll('#headerNav > .header-nav-btn').forEach(native => {
                    if (native.hidden || native.style.display === 'none') return;
                    const b = document.createElement('button'); b.type = 'button'; b.className = cls || '';
                    b.innerHTML = '<span>' + esc(this.label(native)) + '</span>' + (native.classList.contains('active') ? tick : next);
                    b.disabled = native.disabled; b.dataset.nav = native.id;
                    if (native.classList.contains('active')) b.setAttribute('aria-current', 'page');
                    b.addEventListener('click', event => { event.stopPropagation(); dialog.close(); native.click(); }); body.append(b);
                });
            },
            more(body, dialog, cls) {
                dialog.classList.add('sv-phone-sheet');
                // The native opener prepares identity handlers and permission state.
                // Keep its header popover closed; its actions are proxied below.
                const account = control('headerMenuButton'), popover = document.getElementById('staffAccountPopover');
                if (account && popover) {
                    // The opener re-reads the stored theme and status colors; keep what is on screen.
                    const root = document.documentElement, theme = root.dataset.theme, palette = root.dataset.statusPalette;
                    if (popover.hidden) account.click();
                    if (!popover.hidden) account.click();
                    if (root.dataset.theme !== theme) _syncviewApplyTheme(theme === 'dark' ? 'dark' : 'light', false);
                    if (root.dataset.statusPalette !== palette) _syncviewApplyStatusPalette(palette === 'classic' ? 'classic' : 'vibrant');
                }
                const group = document.createElement('div'); group.className = 'sv-phone-proxies';
                const title = document.createElement('p'); title.className = 'sv-phone-tools'; title.textContent = 'Tools'; group.append(title);
                const proxy = (label, el, picker) => {
                    if (!el || el.hidden || el.style.display === 'none') return;
                    const b = document.createElement('button'); b.type = 'button'; b.className = cls || '';
                    b.disabled = !!el.disabled;
                    // Names the native control this row stands in for (the sheet's own click handler skips proxy rows).
                    if (el.id) b.dataset.proxy = el.id;
                    b.innerHTML = '<span>' + esc(label) + '</span>' + next;
                    b.addEventListener('click', () => { dialog.close(); setTimeout(() => picker ? window.svPhoneOpenClientPicker() : el.click(), 0); }); group.append(b);
                };
                proxy('Change client', document.getElementById('svClientBadge'), true);
                proxy('Quick jump', document.querySelector('.sv-jump-touch'));
                proxy(document.documentElement.dataset.theme === 'dark' ? 'Light appearance' : 'Dark appearance', control('themeToggle'));
                proxy(document.documentElement.dataset.statusPalette === 'classic' ? 'Current status colors' : 'Original status colors', control('statusPaletteToggle'));
                // A sheet whose own tools already open this client's credentials (Calendar) lists them once.
                const ownCredentials = body.querySelector('[data-staff-capability="credentials"]:not([hidden])');
                [['headerTimeOffMenuItem', 'Time Off'], ['headerOnboardingMenuItem', 'Onboarding'], ['headerCredentialsMenuItem', 'Client Credentials']]
                    .forEach(p => { if (!(ownCredentials && p[0] === 'headerCredentialsMenuItem')) proxy(p[1], control(p[0])); });
                proxy((document.getElementById('staffIdentityMenuLabel')?.textContent || '').trim() || 'Staff menu', control('staffIdentitySignOut'));
                body.prepend(group);
            }
        };
        window.svPhoneOpenClientPicker = function () {
            if (!window.svIsStaffPhone()) return;
            if (document.querySelector('.sv-phone-client-sheet[open]')) return;
            const pop = document.getElementById('svClientPop'), badge = document.getElementById('svClientBadge');
            if (!pop || !badge) return;
            const parent = pop.parentNode, nextNode = pop.nextSibling;
            const focus = document.activeElement;
            const dialog = document.createElement('dialog'); dialog.className = 'sv-phone-client-sheet';
            dialog.setAttribute('aria-labelledby', 'svPhoneClientTitle');
            dialog.innerHTML = '<div class="sv-phone-client-head"><h2 id="svPhoneClientTitle">Choose client</h2><button type="button" aria-label="Close choose client">' + close + '</button></div>';
            document.body.append(dialog);
            if (pop.hidden) badge.click(); dialog.append(pop); dialog.showModal();
            const finish = () => { if (dialog.open) dialog.close(); };
            dialog.querySelector('button').addEventListener('click', finish);
            dialog.addEventListener('click', e => {
                if (e.target === dialog) { finish(); return; }
                // Popover clicks keep their native handler; the header's outside-click
                // listener must not dismiss this sheet when its close control is used.
                e.stopPropagation();
            });
            const watch = new MutationObserver(() => { if (pop.hidden) finish(); }); watch.observe(pop, { attributes: true, attributeFilter: ['hidden'] });
            const resize = () => { if (!phone.matches) finish(); }; phone.addEventListener('change', resize);
            dialog.addEventListener('close', () => {
                watch.disconnect(); phone.removeEventListener('change', resize);
                pop.hidden = true; badge.setAttribute('aria-expanded', 'false'); badge.classList.remove('is-open');
                parent.insertBefore(pop, nextNode?.parentNode === parent ? nextNode : null); dialog.remove();
                if (focus?.isConnected && focus.checkVisibility()) focus.focus();
            }, { once: true });
            document.getElementById('svClientSearch')?.focus();
        };

        function control(id) {
            const el = document.getElementById(id);
            return el && !el.hidden && el.style.display !== 'none' ? el : null;
        }
        function open(kind) {
            const dialog = document.getElementById('pocketStaff' + kind);
            if (!dialog || dialog.open) return;
            const body = document.getElementById('pocketStaff' + kind + 'Body');
            if (kind === 'Tabs') window.svStaffPhoneMenus.tabs(body, dialog, 'pocket-staff-row');
            else { body.replaceChildren(); window.svStaffPhoneMenus.more(body, dialog, 'pocket-staff-row'); }
            dialog.showModal();
        }
        function wireBar(bar) {
            bar.querySelector('.pocket-staff-tabs-btn').addEventListener('click', () => open('Tabs'));
            bar.querySelector('.pocket-staff-more-btn').addEventListener('click', () => open('More'));
            bar.querySelectorAll('dialog').forEach(dialog => {
                dialog.querySelector('.pocket-staff-sheet-close').addEventListener('click', () => dialog.close());
                dialog.addEventListener('click', ev => {
                    if (ev.target === dialog) { dialog.close(); return; }
                    const r = ev.target.closest('.pocket-staff-row');
                    if (!r || r.closest('.sv-phone-proxies') || !r.dataset.nav && !r.dataset.proxy && !r.dataset.proxySel) return;
                    const target = r.dataset.nav ? document.getElementById(r.dataset.nav)
                        : r.dataset.proxy ? document.getElementById(r.dataset.proxy)
                        : r.dataset.proxySel ? document.querySelector(r.dataset.proxySel) : null;
                    dialog.close();
                    // After the sheet has closed, so focus and any popover it opens land on the page.
                    if (target) setTimeout(() => target.click(), 0);
                });
            });
        }
        function sync() {
            const title = wanted();
            let bar = document.getElementById('pocketStaffBar');
            if (!title) {
                if (bar) bar.remove();
                return;
            }
            if (!bar) {
                const main = document.getElementById('mainWrap');
                if (!main) return;
                bar = document.createElement('div');
                bar.id = 'pocketStaffBar';
                bar.className = 'pocket-staff-bar';
                bar.innerHTML = '<h1 class="pocket-staff-title"></h1><div class="pocket-staff-actions">'
                    + '<button type="button" class="pocket-staff-tabs-btn" aria-haspopup="dialog" aria-controls="pocketStaffTabs">Tabs ' + chevron + '</button>'
                    + '<button type="button" class="pocket-staff-more-btn" aria-label="More options" aria-haspopup="dialog" aria-controls="pocketStaffMore">' + dots + '</button></div>'
                    + dialogHtml('Tabs', 'Tabs') + dialogHtml('More', 'More');
                main.parentNode.insertBefore(bar, main);
                wireBar(bar);
            }
            const h1 = bar.querySelector('.pocket-staff-title');
            if (h1.textContent !== title) h1.textContent = title;
        }
        function start() {
            const nav = document.getElementById('headerNav');
            if (!nav) return;
            new MutationObserver(sync).observe(nav, { subtree: true, attributes: true, attributeFilter: ['class'] });
            // Menu-only routes have no active header tab. Observe route mounts,
            // including a delayed module load, without watching form repainting.
            const content = document.getElementById('content');
            if (content) new MutationObserver(sync).observe(content, { childList: true });
            if (phone && phone.addEventListener) phone.addEventListener('change', sync);
            sync();
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
        else start();
    })();
