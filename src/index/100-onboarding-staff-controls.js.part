        const wrap = document.getElementById(id + 'Wrap');
        if (!wrap) return;
        if (wrap.classList.contains('open')) _svSelectClose(id, true);
        else _svSelectOpen(id, false);
    }
    function _svSelectKeydown(event, id) {
        const key = event.key;
