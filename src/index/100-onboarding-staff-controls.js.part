        if ((key === 'Enter' || key === ' ') && open && focused >= 0) { event.preventDefault(); options[focused].click(); return; }
        if ((key === 'Enter' || key === ' ') && event.target.id === id + 'Btn') { event.preventDefault(); _svSelectOpen(id, 'first'); return; }
