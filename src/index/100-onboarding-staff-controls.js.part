            // into an isolated VM by test/workload-plan-failclosed.js, where the
            // gate helpers are not defined.
            if (typeof _syncviewStaffGateRequired === 'function' && _syncviewStaffGateRequired()) _syncviewOpenStaffGate();
            return;
