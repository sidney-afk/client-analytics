    const PTO_FLAG_KEY = 'pto_v1';
    const SYNCVIEW_STAFF_IDENTITY_KEY = 'syncview_staff_identity_v1';
    const SYNCVIEW_STAFF_PROMPT_SESSION_KEY = 'syncview_staff_identity_prompted_v1';
