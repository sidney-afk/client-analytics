import { _writeUiTrackSave } from './120-calendar-flags-write-repair.js';
import { WL_CLIENT_NAMES, getClientRoster, wlNormalizeClient } from './070-core-client-names.js';
import { CAL_SUPABASE_ANON_KEY, SMM_WEEKLY_REPORTS_URL, _syncviewRequireStaffIdentity, _syncviewStaffIdentityForHeaders } from './100-onboarding-staff-controls.js';
import { _jsAttrArg } from './131-core-html.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    const SRP_OVERALL = ['On track', 'Minor friction', 'Needs your attention', 'Blocked'];
    const SRP_OBSTACLE = ['Handling it', 'Need your input', 'Need you to act'];
    const SRP_MOOD = ['Great', 'Fine', 'Cooling', 'Concerned'];
    const SRP_SCHEDULE = ['Ahead', 'On track', 'Slightly behind', 'At risk'];
    const SRP_PERFORMANCE = ['Numbers up', 'Flat', 'Down', 'Too early to tell'];
    const _srpState = { managers: [], managersLoaded: false, currentWeek: '', lastSubmitted: null, reports: [], weeks: [], filters: { week: '', smm: '', client: '', status: '' }, loadError: '' };
    const SRP_ICON_CHEV = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5 6 7.5l3-3"/></svg>';
    const SRP_ICON_CHECK = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2 5 8.7 9.5 3.5"/></svg>';
    let _srpOpenSelectId = null;

    function _srpEsc(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
    function _srpSlug(value) {
        try { if (typeof wlNormalizeClient === 'function') return wlNormalizeClient(String(value || '')); } catch (e) {}
        return String(value || '').toLowerCase().replace(/[^a-z0-9&]+/g, '');
    }
    function _srpDateISO(date) {
        const d = date instanceof Date ? date : new Date(date);
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + day;
    }
    function _srpWeekStartISO(value) {
        const d = value ? new Date(String(value).slice(0, 10) + 'T12:00:00') : new Date();
        const day = d.getDay();
        const diff = day === 0 ? -6 : 1 - day;
        d.setDate(d.getDate() + diff);
        return _srpDateISO(d);
    }
    function _srpWeekLabel(iso) {
        if (!iso) return 'Current week';
        const start = new Date(iso + 'T12:00:00');
        const end = new Date(start);
        end.setDate(start.getDate() + 6);
        const fmt = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' });
        const endFmt = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
        return fmt.format(start) + ' - ' + endFmt.format(end);
    }
    function _srpDateTimeLabel(value) {
        if (!value) return '';
        try { return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(value)); } catch (e) { return String(value); }
    }
    function _srpClientRoster() {
        try {
            if (typeof getClientRoster === 'function') return getClientRoster();
            if (Array.isArray(WL_CLIENT_NAMES)) return [...new Set(WL_CLIENT_NAMES)].sort((a, b) => a.localeCompare(b));
        } catch (e) {}
        return [];
    }
    async function _srpApi(params, options) {
        const opts = options || {};
        const method = (opts.method || 'GET').toUpperCase();
        let action = String(params && params.action || '');
        if (method !== 'GET' && opts.body) {
            try { action = String((JSON.parse(opts.body) || {}).action || 'submit'); } catch (e) { action = 'submit'; }
        }
        const capability = action === 'reports' || action === 'sync_managers'
            ? 'weekly-report-manage'
            : 'weekly-report-submit';
        const ident = await _syncviewRequireStaffIdentity(capability);
        let url = SMM_WEEKLY_REPORTS_URL;
        if (method === 'GET') {
            const qs = new URLSearchParams();
            Object.entries(params || {}).forEach(([k, v]) => { if (v != null && v !== '') qs.set(k, v); });
            const s = qs.toString();
            if (s) url += '?' + s;
        }
        const headers = Object.assign({
            Accept: 'application/json',
            apikey: CAL_SUPABASE_ANON_KEY,
            Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY
        }, opts.headers || {});
        headers['X-Syncview-Key'] = ident.key;
        if (method !== 'GET') headers['Content-Type'] = 'application/json';
        const send = () => fetch(url, Object.assign({}, opts, { method, headers }));
        // Reading options and reports is not a save; a POST is.
        const resp = await (method === 'GET' ? send() : _writeUiTrackSave('weekly_reports', ('weekly_report_' + action).slice(0, 40), {}, send));
        let data = null;
        try { data = await resp.json(); } catch (e) {}
        if (!resp.ok) {
            const err = new Error((data && (data.message || data.error)) || ('HTTP ' + resp.status));
            err.status = resp.status;
            err.payload = data;
            throw err;
        }
        return data || {};
    }
    async function _srpLoadOptions() {
        const data = await _srpApi({ action: 'options' });
        _srpState.managers = Array.isArray(data.managers) ? data.managers : [];
        _srpState.managersLoaded = true;
        _srpState.currentWeek = data.current_week_start || _srpWeekStartISO();
        return data;
    }
    function _srpRadioGroup(name, values, selected) {
        return `<div class="srp-radios">${values.map((v, i) => `<label class="srp-pill"><input type="radio" name="${_srpEsc(name)}" value="${_srpEsc(v)}"${(selected || (!selected && i === 0)) === v ? ' checked' : ''}><span>${_srpEsc(v)}</span></label>`).join('')}</div>`;
    }
    function _srpSelectHtml(id, name, items, selectedValue, placeholder, opts) {
        opts = opts || {};
        items = Array.isArray(items) ? items : [];
        const active = items.find(x => String(x.value) === String(selectedValue));
        const label = active ? active.label : (placeholder || 'Choose');
        const hiddenName = name ? ` name="${_srpEsc(name)}"` : '';
        const disabled = opts.disabled ? ' is-disabled' : '';
        const optionHtml = items.length
            ? items.map(x => {
                const on = active && String(x.value) === String(active.value);
                return `<button class="srp-select-option${on ? ' active' : ''}" type="button" data-srp-select-option data-value="${_srpEsc(x.value)}" data-label="${_srpEsc(x.label)}" onclick="_srpPickSelect(event, ${_jsAttrArg(id)}, ${_jsAttrArg(x.value)}, ${_jsAttrArg(x.label)})"><span>${_srpEsc(x.label)}</span>${on ? SRP_ICON_CHECK : ''}</button>`;
            }).join('')
            : `<div class="srp-select-option" style="cursor:default;color:var(--text-muted);">${_srpEsc(opts.emptyLabel || 'No options')}</div>`;
        return `<div class="srp-select-wrap${disabled}" id="${_srpEsc(id)}Wrap" data-srp-select>
            <button class="srp-select-trigger" type="button" id="${_srpEsc(id)}Btn" aria-haspopup="listbox" aria-expanded="false" onclick="_srpToggleSelect(event, ${_jsAttrArg(id)})"><span id="${_srpEsc(id)}Label">${_srpEsc(label)}</span>${SRP_ICON_CHEV}</button>
            <input type="hidden" class="srp-select-value" id="${_srpEsc(id)}"${hiddenName} value="${_srpEsc(active ? active.value : '')}" data-label="${_srpEsc(active ? active.label : '')}">
            <div class="srp-select-menu" id="${_srpEsc(id)}Menu" role="listbox">${optionHtml}</div>
        </div>`;
    }
    function _srpCloseSelect(id) {
        id = id || _srpOpenSelectId;
        if (!id) return;
        const wrap = document.getElementById(id + 'Wrap');
        const btn = document.getElementById(id + 'Btn');
        if (wrap) wrap.classList.remove('open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (_srpOpenSelectId === id) {
            document.removeEventListener('mousedown', _srpSelectOutside);
            document.removeEventListener('keydown', _srpSelectKeydown);
            _srpOpenSelectId = null;
        }
    }
    function _srpSelectOutside(e) { if (!e.target.closest('[data-srp-select]')) _srpCloseSelect(); }
    function _srpSelectKeydown(e) { if (e.key === 'Escape') _srpCloseSelect(); }
    function _srpToggleSelect(e, id) {
        if (e) e.stopPropagation();
        const wrap = document.getElementById(id + 'Wrap');
        const btn = document.getElementById(id + 'Btn');
        if (!wrap || !btn || wrap.classList.contains('is-disabled')) return;
        const opening = !wrap.classList.contains('open');
        if (_srpOpenSelectId && _srpOpenSelectId !== id) _srpCloseSelect(_srpOpenSelectId);
        wrap.classList.toggle('open', opening);
        btn.setAttribute('aria-expanded', opening ? 'true' : 'false');
        if (opening) {
            _srpOpenSelectId = id;
            setTimeout(() => {
                document.addEventListener('mousedown', _srpSelectOutside);
                document.addEventListener('keydown', _srpSelectKeydown);
            }, 0);
        } else _srpCloseSelect(id);
    }
    function _srpPickSelect(e, id, value, label) {
        if (e) e.stopPropagation();
        const input = document.getElementById(id);
        const lab = document.getElementById(id + 'Label');
        const menu = document.getElementById(id + 'Menu');
        if (input) {
            input.value = value;
            input.dataset.label = label || '';
            input.dispatchEvent(new Event('change', { bubbles: true }));
        }
        if (lab) lab.textContent = label || '';
        if (menu) menu.querySelectorAll('[data-srp-select-option]').forEach(btn => {
            const on = btn.getAttribute('data-value') === String(value);
            btn.classList.toggle('active', on);
            const span = btn.querySelector('span');
            btn.innerHTML = (span ? span.outerHTML : `<span>${_srpEsc(btn.getAttribute('data-label') || label || '')}</span>`) + (on ? SRP_ICON_CHECK : '');
        });
        _srpCloseSelect(id);
    }
    function _srpCountControlHtml() {
        return `<div class="srp-count-control">
            <button class="srp-count-btn" type="button" data-srp-count-step="-1" aria-label="Decrease content shipped">-</button>
            <input class="srp-count-input" id="srpContentCount" name="content_count" type="number" min="0" step="1" inputmode="numeric" placeholder="0">
            <button class="srp-count-btn" type="button" data-srp-count-step="1" aria-label="Increase content shipped">+</button>
        </div>`;
    }
    function _srpSkeletonHtml(kind) {
        const fields = kind === 'reports'
            ? `<div class="srp-skel-grid"><span class="srp-skel-pill"></span><span class="srp-skel-pill"></span><span class="srp-skel-pill"></span><span class="srp-skel-pill"></span></div><span class="srp-skel-box"></span><span class="srp-skel-box"></span>`
            : `<div class="srp-skel-grid">
                <span class="srp-skel-field"><span class="srp-skel-line short"></span><span class="srp-skel-pill"></span></span>
                <span class="srp-skel-field"><span class="srp-skel-line short"></span><span class="srp-skel-pill"></span></span>
                <span class="srp-skel-field full"><span class="srp-skel-line medium"></span><span class="srp-skel-pill"></span></span>
                <span class="srp-skel-field full"><span class="srp-skel-line long"></span><span class="srp-skel-pill"></span></span>
                <span class="srp-skel-field"><span class="srp-skel-line medium"></span><span class="srp-skel-pill"></span></span>
                <span class="srp-skel-field"><span class="srp-skel-line medium"></span><span class="srp-skel-pill"></span></span>
            </div>`;
        return `<div class="srp-card" aria-busy="true"><div class="srp-skeleton">
            <div class="srp-skel-head"><span class="srp-skel-circle"></span><span style="display:grid;gap:8px;flex:1;"><span class="srp-skel-line medium"></span><span class="srp-skel-line short"></span></span></div>
            ${fields}
        </div></div>`;
    }
    function renderSmmWeeklyReportFormView() {
        return `<main class="srp-wrap form" id="smmWeeklyReportMount">
            <div class="srp-head"><div><div class="srp-kicker">SyncView</div><h1 class="srp-title">Weekly client report</h1><p class="srp-sub">Submit one report per client for the current Monday-Sunday week.</p></div></div>
            ${_srpSkeletonHtml('form')}
        </main>`;
    }
    async function mountSmmWeeklyReportFormView() {
        _srpState.lastSubmitted = null;
        _srpState.loadError = '';
        _srpPaintFormShell('Loading form...');
        try {
            await _srpLoadOptions();
            _srpPaintForm();
        } catch (e) {
            _srpState.loadError = e.message || 'Could not load the form.';
            _srpPaintForm();
        }
    }
    function _srpPaintFormShell(text) {
        const mount = document.getElementById('smmWeeklyReportMount');
        if (!mount) return;
        mount.innerHTML = `<div class="srp-head"><div><div class="srp-kicker">SyncView</div><h1 class="srp-title">Weekly client report</h1><p class="srp-sub">Submit one report per client for the current Monday-Sunday week.</p></div></div>${_srpSkeletonHtml('form')}`;
    }
    function _srpPaintForm() {
        const mount = document.getElementById('smmWeeklyReportMount');
        if (!mount) return;
        if (_srpState.lastSubmitted) {
            const r = _srpState.lastSubmitted;
            mount.innerHTML = `<div class="srp-card srp-done"><div class="srp-done-icon">OK</div><h1 class="srp-title">Report submitted</h1><p class="srp-sub" style="margin-left:auto;margin-right:auto;">${_srpEsc(r.smm_name)} submitted ${_srpEsc(r.client_name)} for ${_srpEsc(_srpWeekLabel(r.week_start_date))}.</p><div class="srp-actions" style="justify-content:center;"><button class="srp-btn secondary" type="button" id="srpAnother">Submit another client</button></div></div>`;
            const btn = document.getElementById('srpAnother');
            if (btn) btn.addEventListener('click', () => { _srpState.lastSubmitted = null; _srpPaintForm(); });
            return;
        }
        const managers = _srpState.managers || [];
        const week = _srpState.currentWeek || _srpWeekStartISO();
        const managerItems = managers.map(m => ({ value: m.slug || _srpSlug(m.name), label: m.name || m.slug }));
        mount.innerHTML = `<div class="srp-head"><div><div class="srp-kicker">SyncView</div><h1 class="srp-title">Weekly client report</h1><p class="srp-sub">Submit one report per client for ${_srpEsc(_srpWeekLabel(week))}.</p></div></div>
            <form class="srp-card" id="srpForm" autocomplete="off">
                <input type="hidden" name="week_start_date" value="${_srpEsc(week)}">
                <input type="hidden" name="client_name" id="srpClientName">
                <input type="hidden" name="client_slug" id="srpClientSlug">
                <div class="srp-grid">
                    <div class="srp-field" data-field="smm_slug"><label class="srp-label" for="srpSmmBtn">Name</label>${_srpSelectHtml('srpSmm', 'smm_slug', managerItems, '', managers.length ? 'Select SMM' : 'No SMMs synced yet', { disabled: !managers.length, emptyLabel: 'No SMMs synced yet' })}</div>
                    <div class="srp-field" data-field="week_start_date"><label class="srp-label">Week</label><input class="srp-input" readonly value="${_srpEsc(_srpWeekLabel(week))}"></div>
                    <div class="srp-field full" data-field="client_name" id="srpClientField"><label class="srp-label" for="srpClientSearch">Client name</label><input class="srp-input" id="srpClientSearch" type="search" placeholder="Search client" autocomplete="off"><div class="srp-search-results" id="srpClientResults" style="display:none;"></div></div>
                    <div class="srp-field full" data-field="overall_status"><span class="srp-label">Overall status this week</span>${_srpRadioGroup('overall_status', SRP_OVERALL, 'On track')}</div>
                    <div class="srp-field full" data-field="what_done"><label class="srp-label" for="srpWhatDone">What got done this week?</label><input class="srp-input" id="srpWhatDone" name="what_done" maxlength="240" placeholder="Filmed 3 reels, scheduled week's posts"></div>
                    <div class="srp-field" data-field="content_count"><label class="srp-label" for="srpContentCount">Content shipped this week</label>${_srpCountControlHtml()}</div>
                    <div class="srp-field" data-field="biggest_win"><label class="srp-label" for="srpBiggestWin">Biggest win this week</label><input class="srp-input" id="srpBiggestWin" name="biggest_win" maxlength="240"></div>
                    <div class="srp-field full" data-field="biggest_obstacle"><label class="srp-label" for="srpBiggestObstacle">Biggest obstacle or risk this week</label><input class="srp-input" id="srpBiggestObstacle" name="biggest_obstacle" maxlength="240" placeholder="None"></div>
                    <div class="srp-field full" data-field="obstacle_support"><span class="srp-label">Is the obstacle something you can solve, or do you need me?</span>${_srpRadioGroup('obstacle_support', SRP_OBSTACLE, 'Handling it')}</div>
                    <div class="srp-field full" data-field="client_mood"><span class="srp-label">Client mood/relationship temperature</span>${_srpRadioGroup('client_mood', SRP_MOOD, 'Fine')}</div>
                    <div class="srp-field full" data-field="client_requests"><label class="srp-label" for="srpClientRequests">Any client requests or asks that came in this week?</label><input class="srp-input" id="srpClientRequests" name="client_requests" maxlength="240" placeholder="None"></div>
                    <div class="srp-field full" data-field="deliverables_schedule"><span class="srp-label">Are we on schedule for this client's deliverables this week?</span>${_srpRadioGroup('deliverables_schedule', SRP_SCHEDULE, 'On track')}</div>
                    <div class="srp-field" data-field="performance_signal"><span class="srp-label">Performance signal</span>${_srpRadioGroup('performance_signal', SRP_PERFORMANCE, 'Too early to tell')}</div>
                    <div class="srp-field"><label class="srp-label" for="srpPerformanceContext">Performance context</label><input class="srp-input" id="srpPerformanceContext" name="performance_context" maxlength="240" placeholder="Reel hit 40K, above avg"></div>
                    <div class="srp-field full" data-field="anything_else"><label class="srp-label" for="srpAnythingElse">Anything I should know that isn't captured above?</label><input class="srp-input" id="srpAnythingElse" name="anything_else" maxlength="300" placeholder="Nothing"></div>
                </div>
                ${_srpState.loadError ? `<div class="srp-error" style="display:block;">${_srpEsc(_srpState.loadError)}</div>` : '<div class="srp-error" id="srpFormError"></div>'}
                <div class="srp-actions"><button class="srp-btn" type="submit" ${managers.length && !_srpState.loadError ? '' : 'disabled'}>Submit report</button></div>
            </form>`;
        _srpWireForm();
    }
    function _srpWireForm() {
        const form = document.getElementById('srpForm');
        const search = document.getElementById('srpClientSearch');
        const results = document.getElementById('srpClientResults');
        if (!form) return;
        form.addEventListener('submit', _srpSubmitReport);
        form.addEventListener('input', e => { const f = e.target && e.target.closest ? e.target.closest('.srp-field') : null; if (f) f.classList.remove('srp-missing'); _srpSetFormError(''); });
        form.addEventListener('change', e => { const f = e.target && e.target.closest ? e.target.closest('.srp-field') : null; if (f) f.classList.remove('srp-missing'); _srpSetFormError(''); });
        form.querySelectorAll('[data-srp-count-step]').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById('srpContentCount');
                if (!input) return;
                const step = Number(btn.getAttribute('data-srp-count-step')) || 0;
                const next = Math.max(0, (Number(input.value) || 0) + step);
                input.value = String(next);
                input.dispatchEvent(new Event('input', { bubbles: true }));
            });
        });
        if (search && results) {
            search.addEventListener('input', () => { document.getElementById('srpClientName').value = ''; document.getElementById('srpClientSlug').value = ''; _srpPaintClientResults(search.value); });
            search.addEventListener('focus', () => _srpPaintClientResults(search.value));
            search.addEventListener('keydown', e => {
                if (e.key !== 'Enter') return;
                const name = _srpFirstClientMatch(search.value);
                if (!name) return;
                e.preventDefault();
                _srpPickFormClient(name);
            });
            results.addEventListener('click', e => {
                const btn = e.target.closest('[data-client-name]');
                if (!btn) return;
                _srpPickFormClient(btn.getAttribute('data-client-name') || '');
            });
        }
        _srpEnsureClientOutsideWired();
    }
    function _srpEnsureClientOutsideWired() {
        if (document._srpClientOutsideWired) return;
        document._srpClientOutsideWired = true;
        document.addEventListener('click', e => {
            [
                ['srpClientField', 'srpClientResults'],
                ['srpClientFilterField', 'srpClientFilterResults']
            ].forEach(([boxId, resId]) => {
                const box = document.getElementById(boxId);
                const res = document.getElementById(resId);
                if (box && res && !box.contains(e.target)) res.style.display = 'none';
            });
        });
    }
    function _srpClientMatches(query) {
        const q = String(query || '').trim().toLowerCase();
        const roster = _srpClientRoster();
        return q ? roster.filter(n => n.toLowerCase().includes(q)).slice(0, 10) : roster.slice(0, 10);
    }
    function _srpFirstClientMatch(query) {
        const matches = _srpClientMatches(query);
        return matches.length ? matches[0] : '';
    }
    function _srpPaintClientResults(query, resultsId) {
        const results = document.getElementById(resultsId || 'srpClientResults');
        if (!results) return;
        const matches = _srpClientMatches(query);
        results.innerHTML = matches.length
            ? matches.map(n => `<button type="button" class="srp-search-option" data-client-name="${_srpEsc(n)}">${_srpEsc(n)}</button>`).join('')
            : '<div class="srp-search-option empty">No clients found</div>';
        results.style.display = 'block';
    }
    function _srpPickFormClient(name) {
        const search = document.getElementById('srpClientSearch');
        const results = document.getElementById('srpClientResults');
        if (!name || !search) return;
        search.value = name;
        document.getElementById('srpClientName').value = name;
        document.getElementById('srpClientSlug').value = _srpSlug(name);
        if (results) results.style.display = 'none';
        const fld = document.querySelector('[data-field="client_name"]');
        if (fld) fld.classList.remove('srp-missing');
    }
    function _srpSetFormError(message) {
        const el = document.getElementById('srpFormError');
        if (!el) return;
        el.textContent = message || '';
        el.style.display = message ? 'block' : 'none';
    }
    async function _srpSubmitReport(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const data = new FormData(form);
        const smmSlug = String(data.get('smm_slug') || '');
        const manager = (_srpState.managers || []).find(m => String(m.slug || _srpSlug(m.name)) === smmSlug);
        const payload = {
            week_start_date: data.get('week_start_date'),
            smm_slug: smmSlug,
            smm_name: manager ? (manager.name || manager.slug || '') : '',
            client_name: data.get('client_name'),
            client_slug: data.get('client_slug'),
            overall_status: data.get('overall_status'),
            what_done: String(data.get('what_done') || '').trim(),
            content_count: data.get('content_count') === '' ? null : Number(data.get('content_count')),
            biggest_win: String(data.get('biggest_win') || '').trim(),
            biggest_obstacle: String(data.get('biggest_obstacle') || '').trim(),
            obstacle_support: data.get('obstacle_support'),
            client_mood: data.get('client_mood'),
            client_requests: String(data.get('client_requests') || '').trim(),
            deliverables_schedule: data.get('deliverables_schedule'),
            performance_signal: data.get('performance_signal'),
            performance_context: String(data.get('performance_context') || '').trim(),
            anything_else: String(data.get('anything_else') || '').trim()
        };
        const required = ['smm_slug', 'client_name', 'overall_status', 'what_done', 'content_count', 'biggest_win', 'biggest_obstacle', 'obstacle_support', 'client_mood', 'client_requests', 'deliverables_schedule', 'performance_signal', 'anything_else'];
        let missing = false;
        form.querySelectorAll('.srp-missing').forEach(el => el.classList.remove('srp-missing'));
        required.forEach(k => {
            const v = payload[k];
            const bad = v == null || v === '' || (k === 'content_count' && (!Number.isFinite(v) || v < 0));
            if (bad) {
                missing = true;
                const field = form.querySelector('[data-field="' + k + '"]');
                if (field) field.classList.add('srp-missing');
            }
        });
        if (missing) { _srpSetFormError('Please fill in every required field.'); return; }
        const submit = form.querySelector('button[type="submit"]');
        if (submit) { submit.disabled = true; submit.textContent = 'Submitting...'; }
        try {
            const resp = await _srpApi(null, { method: 'POST', body: JSON.stringify({ action: 'submit', report: payload }) });
            _srpState.lastSubmitted = resp.report || payload;
            _srpPaintForm();
        } catch (e) {
            const duplicate = e.status === 409 || (e.payload && e.payload.error === 'already_submitted');
            _srpSetFormError(duplicate ? 'This SMM already submitted a report for this client this week.' : (e.message || 'Could not submit the report.'));
        } finally {
            if (submit) { submit.disabled = false; submit.textContent = 'Submit report'; }
        }
    }
    function renderSmmWeeklyReportsView() {
        return `<main class="srp-wrap" id="smmWeeklyReportsMount">
            <div class="srp-head"><div><div class="srp-kicker">Kasper view</div><h1 class="srp-title">SMM weekly reports</h1><p class="srp-sub">Review reports by week, social media manager, and client.</p></div></div>
            ${_srpSkeletonHtml('reports')}
        </main>`;
    }
    async function mountSmmWeeklyReportsView() {
        const params = _srpHashParams();
        _srpState.filters.week = params.get('week') || _srpState.currentWeek || _srpWeekStartISO();
        _srpState.filters.smm = params.get('smm') || '';
        _srpState.filters.client = params.get('client') || '';
        _srpState.filters.status = params.get('status') || '';
        await _srpLoadReports();
    }
    function _srpHashParams() {
        const raw = String(svRoute.hash() || '').replace(/^#/, '');
        const i = raw.indexOf('?');
        return new URLSearchParams(i >= 0 ? raw.slice(i + 1) : '');
    }
    /* SAVED COPY, the way Filming Plans and Workload do it. The reports page
       used to show a skeleton until both of its reads answered (the managers
       list and the week's reports, ~1 s each on top of sign-in). It now paints
       the last answer it saw for the same week and SMM filter at once and
       refreshes behind. The copy is bound to the signed-in staff member and
       role (never the key), read only once the identity has verified, capped
       in size and age, and dropped on sign-out by _srpPurgeSensitiveState.
       Client links never read or write it.

       The managers list is also fetched once per page load now, not again on
       every week or SMM change: it is the roster of SMMs, not per-week data. */
    const SRP_SAVED_KEY = 'syncview_smmWeeklyReportsCache_v1';
    const SRP_SAVED_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
    const SRP_SAVED_MAX_BYTES = 900 * 1024;
    const SRP_SAVED_MAX_VIEWS = 8;
    let _srpLoadSeq = 0;
    let _srpOptionsFetched = false;
    let _srpPaintedSig = '';
    function _srpSavedOwner() {
        if (typeof _isClientLink !== 'undefined' && _isClientLink) return '';
        const ident = _syncviewStaffIdentityForHeaders();
        return ident && ident.member && ident.member.id ? String(ident.role || '') + ':' + String(ident.member.id) : '';
    }
    function _srpSavedViewKey() {
        return String(_srpState.filters.week || '') + '|' + String(_srpState.filters.smm || '');
    }
    function _srpSavedLoad(owner) {
        try {
            const o = JSON.parse(localStorage.getItem(SRP_SAVED_KEY) || 'null');
            return o && o.owner === owner && o.views && typeof o.views === 'object' ? o : null;
        } catch (e) { return null; }
    }
    function _srpSavedRead(viewKey) {
        const owner = _srpSavedOwner();
        if (!owner) return null;
        const o = _srpSavedLoad(owner);
        const v = o && o.views[viewKey];
        if (!v || !Array.isArray(v.reports) || !(Date.now() - Number(v.at) < SRP_SAVED_MAX_AGE_MS)) return null;
        return { view: v, options: o.options || null };
    }
    function _srpSavedWrite(viewKey, data, options) {
        try {
            const owner = _srpSavedOwner();
            if (!owner) return;
            const o = _srpSavedLoad(owner) || { owner, views: {} };
            if (options && Array.isArray(options.managers)) o.options = { managers: options.managers, current_week_start: options.current_week_start || '' };
            o.views[viewKey] = { at: Date.now(), reports: Array.isArray(data.reports) ? data.reports : [], weeks: Array.isArray(data.weeks) ? data.weeks : [] };
            const keys = Object.keys(o.views).sort((a, b) => Number(o.views[b].at) - Number(o.views[a].at));
            keys.slice(SRP_SAVED_MAX_VIEWS).forEach(k => { delete o.views[k]; });
            const json = JSON.stringify(o);
            if (json.length > SRP_SAVED_MAX_BYTES) { localStorage.removeItem(SRP_SAVED_KEY); return; }
            localStorage.setItem(SRP_SAVED_KEY, json);
        } catch (e) {}
    }
    function _srpPurgeSensitiveState() {
        try { localStorage.removeItem(SRP_SAVED_KEY); } catch (e) {}
        _srpLoadSeq++;
        _srpOptionsFetched = false;
        _srpPaintedSig = '';
        _srpState.reports = [];
        _srpState.weeks = [];
        _srpState.managers = [];
        _srpState.managersLoaded = false;
    }
    function _srpDataSig() {
        return JSON.stringify([_srpSavedViewKey(), _srpState.reports, _srpState.weeks, _srpState.managers, _srpState.currentWeek]);
    }
    function _srpPaintIfChanged() {
        const sig = _srpDataSig();
        if (sig === _srpPaintedSig && document.getElementById('srpReportStats')) return;
        const mount = document.getElementById('smmWeeklyReportsMount');
        const active = document.activeElement;
        // Someone typing in the client filter keeps their caret: refresh only
        // the numbers and the cards. Any other focus (Refresh, a select) gets
        // the full paint, so a new manager or week reaches the toolbar.
        if (mount && active && active.id === 'srpClientFilter' && document.getElementById('srpReportStats')) { _srpPaintReportResults(); _srpPaintedSig = ''; return; }
        else _srpPaintReports();
        _srpPaintedSig = sig;
    }
    function _srpStaleNote(text) {
        const stats = document.getElementById('srpReportStats');
        let note = document.getElementById('srpStaleNote');
        if (!text) { if (note) note.remove(); return; }
        if (!stats) return;
        if (!note) {
            note = document.createElement('div');
            note.id = 'srpStaleNote';
            note.className = 'srp-empty';
            note.setAttribute('role', 'status');
            stats.parentNode.insertBefore(note, stats);
        }
        note.textContent = text;
    }
    async function _srpLoadReports() {
        const seq = ++_srpLoadSeq;
        const mount = document.getElementById('smmWeeklyReportsMount');
        const viewKey = _srpSavedViewKey();
        let painted = false;
        let savedAt = 0;
        try {
            await _syncviewRequireStaffIdentity('weekly-report-manage');
            if (seq !== _srpLoadSeq) return;
            const saved = _srpSavedRead(viewKey);
            if (saved) {
                if (!_srpState.managersLoaded && saved.options) {
                    _srpState.managers = Array.isArray(saved.options.managers) ? saved.options.managers : [];
                    if (!_srpState.currentWeek) _srpState.currentWeek = saved.options.current_week_start || '';
                }
                _srpState.reports = saved.view.reports;
                _srpState.weeks = saved.view.weeks;
                _srpPaintIfChanged();
                savedAt = Number(saved.view.at) || 0;
                painted = true;
            }
        } catch (e) {}
        const liveMount = document.getElementById('smmWeeklyReportsMount');
        if (!painted && liveMount) {
            _srpPaintedSig = '';
            liveMount.innerHTML = `<div class="srp-head"><div><div class="srp-kicker">Kasper view</div><h1 class="srp-title">SMM weekly reports</h1><p class="srp-sub">Review reports by week, social media manager, and client.</p></div></div>${_srpSkeletonHtml('reports')}`;
        }
        try {
            const needOptions = !_srpOptionsFetched;
            const [options, data] = await Promise.all([
                needOptions ? _srpLoadOptions().then(o => { _srpOptionsFetched = true; return o; }).catch(() => ({})) : Promise.resolve(null),
                _srpApi({ action: 'reports', week: _srpState.filters.week, smm: _srpState.filters.smm })
            ]);
            if (seq !== _srpLoadSeq) return;
            if (!_srpState.filters.week) _srpState.filters.week = (options && options.current_week_start) || _srpState.currentWeek || _srpWeekStartISO();
            _srpState.reports = Array.isArray(data.reports) ? data.reports : [];
            _srpState.weeks = Array.isArray(data.weeks) ? data.weeks : [];
            _srpSavedWrite(viewKey, data, options && _srpState.managersLoaded ? { managers: _srpState.managers, current_week_start: _srpState.currentWeek } : null);
            _srpPaintIfChanged();
            _srpStaleNote('');
        } catch (e) {
            if (seq !== _srpLoadSeq) return;
            if (painted) {
                // Keep the saved cards, but never let them pass for live data.
                _srpStaleNote('Showing reports saved ' + (_srpDateTimeLabel(savedAt) || 'earlier') + '. Could not refresh: ' + String(e && e.message || e));
                return;
            }
            const m = document.getElementById('smmWeeklyReportsMount') || mount;
            if (m) m.innerHTML = `<div class="srp-head"><div><div class="srp-kicker">Kasper view</div><h1 class="srp-title">SMM weekly reports</h1></div></div><div class="srp-empty">Could not load reports: ${_srpEsc(e.message || e)}</div>`;
        }
    }
    function _srpReportModel() {
        const f = _srpState.filters;
        const currentWeek = _srpState.currentWeek || _srpWeekStartISO();
        const q = String(f.client || '').trim().toLowerCase();
        const rows = (_srpState.reports || []).filter(r => {
            if (f.status && r.overall_status !== f.status) return false;
            if (q && String(r.client_name || '').toLowerCase().indexOf(q) === -1) return false;
            return true;
        });
        const uniqueManagers = new Set(rows.map(r => r.smm_slug || r.smm_name).filter(Boolean)).size;
        const uniqueClients = new Set(rows.map(r => r.client_slug || r.client_name).filter(Boolean)).size;
        const shipped = rows.reduce((sum, r) => sum + (Number(r.content_count) || 0), 0);
        const attention = rows.filter(r => r.overall_status === 'Needs your attention' || r.overall_status === 'Blocked').length;
        const needsKasper = rows.filter(r => r.obstacle_support === 'Need your input' || r.obstacle_support === 'Need you to act').length;
        const groups = new Map();
        rows.forEach(r => {
            const key = r.smm_name || r.smm_slug || 'Unassigned';
            if (!groups.has(key)) groups.set(key, []);
            groups.get(key).push(r);
        });
        return { currentWeek, rows, uniqueManagers, uniqueClients, shipped, attention, needsKasper, groups };
    }
    function _srpSummaryHtml(model) {
        return `<div class="srp-summary">
            <div class="srp-metric"><strong>${model.rows.length}</strong><span>Reports</span></div>
            <div class="srp-metric"><strong>${model.uniqueManagers}</strong><span>SMMs</span></div>
            <div class="srp-metric"><strong>${model.uniqueClients}</strong><span>Clients</span></div>
            <div class="srp-metric"><strong>${model.shipped}</strong><span>Shipped</span></div>
            <div class="srp-metric"><strong>${model.attention}</strong><span>Attention</span></div>
            <div class="srp-metric"><strong>${model.needsKasper}</strong><span>Need Kasper</span></div>
        </div>`;
    }
    function _srpReportResultsHtml(model) {
        return model.rows.length ? Array.from(model.groups.entries()).map(([name, items]) => _srpReportGroup(name, items)).join('') : '<div class="srp-empty">No reports match these filters.</div>';
    }
    function _srpPaintReportResults() {
        const model = _srpReportModel();
        const stats = document.getElementById('srpReportStats');
        const results = document.getElementById('srpReportResults');
        const sub = document.getElementById('srpReportsSub');
        if (stats) stats.innerHTML = _srpSummaryHtml(model);
        if (results) results.innerHTML = _srpReportResultsHtml(model);
        if (sub) sub.textContent = _srpWeekLabel(_srpState.filters.week || model.currentWeek);
    }
    function _srpPaintReports() {
        const mount = document.getElementById('smmWeeklyReportsMount');
        if (!mount) return;
        const f = _srpState.filters;
        const currentWeek = _srpState.currentWeek || _srpWeekStartISO();
        const weekList = [...new Set([currentWeek, f.week, ...(_srpState.weeks || [])].filter(Boolean))].sort((a, b) => b.localeCompare(a));
        const managers = _srpState.managers || [];
        const model = _srpReportModel();
        const weekItems = weekList.map(w => ({ value: w, label: _srpWeekLabel(w) }));
        const smmItems = [{ value: '', label: 'All SMMs' }, ...managers.map(m => ({ value: m.slug || _srpSlug(m.name), label: m.name || m.slug }))];
        const statusItems = [{ value: '', label: 'All statuses' }, ...SRP_OVERALL.map(s => ({ value: s, label: s }))];
        mount.innerHTML = `<div class="srp-head"><div><div class="srp-kicker">Kasper view</div><h1 class="srp-title">SMM weekly reports</h1><p class="srp-sub">${_srpEsc(_srpWeekLabel(f.week || currentWeek))}</p></div></div>
            <div class="srp-toolbar">
                ${_srpSelectHtml('srpWeekFilter', '', weekItems, f.week || currentWeek, 'Current week')}
                ${_srpSelectHtml('srpSmmFilter', '', smmItems, f.smm, 'All SMMs')}
                <div class="srp-filter-field" id="srpClientFilterField"><input class="srp-input" id="srpClientFilter" type="search" value="${_srpEsc(f.client)}" placeholder="Filter client" autocomplete="off"><div class="srp-search-results" id="srpClientFilterResults" style="display:none;"></div></div>
                ${_srpSelectHtml('srpStatusFilter', '', statusItems, f.status, 'All statuses')}
                <button class="srp-btn secondary" type="button" id="srpRefreshReports">Refresh</button>
            </div>
            <div id="srpReportStats">${_srpSummaryHtml(model)}</div>
            <div id="srpReportResults">${_srpReportResultsHtml(model)}</div>`;
        _srpWireReports();
    }
    function _srpReportGroup(name, items) {
        items.sort((a, b) => String(a.client_name || '').localeCompare(String(b.client_name || '')));
        return `<section class="srp-group"><h2 class="srp-group-title">${_srpEsc(name)}</h2><div class="srp-report-list">${items.map(_srpReportCard).join('')}</div></section>`;
    }
    function _srpStatusClass(status) {
        if (status === 'Blocked' || status === 'Needs your attention') return ' alert';
        if (status === 'Minor friction') return ' warn';
        return '';
    }
    function _srpDetail(label, value, full) {
        return `<div class="srp-answer${full ? ' full' : ''}"><span class="k">${_srpEsc(label)}</span><span class="v">${_srpEsc(value || '-')}</span></div>`;
    }
    function _srpReportCard(r) {
        const performance = [r.performance_signal, r.performance_context].filter(Boolean).join(' - ');
        return `<article class="srp-report">
            <div class="srp-report-top"><div><div class="srp-report-client">${_srpEsc(r.client_name || r.client_slug)}</div><div class="srp-report-meta">Submitted ${_srpEsc(_srpDateTimeLabel(r.submitted_at))}</div></div><span class="srp-status${_srpStatusClass(r.overall_status)}">${_srpEsc(r.overall_status)}</span></div>
            <div class="srp-detail-grid">
                ${_srpDetail('Done', r.what_done, true)}
                ${_srpDetail('Content shipped', r.content_count)}
                ${_srpDetail('Biggest win', r.biggest_win)}
                ${_srpDetail('Obstacle / risk', r.biggest_obstacle, true)}
                ${_srpDetail('Support needed', r.obstacle_support)}
                ${_srpDetail('Client mood', r.client_mood)}
                ${_srpDetail('Client requests', r.client_requests, true)}
                ${_srpDetail('Schedule', r.deliverables_schedule)}
                ${_srpDetail('Performance', performance)}
                ${_srpDetail('Other notes', r.anything_else, true)}
            </div>
        </article>`;
    }
    function _srpWireReports() {
        const week = document.getElementById('srpWeekFilter');
        const smm = document.getElementById('srpSmmFilter');
        const client = document.getElementById('srpClientFilter');
        const status = document.getElementById('srpStatusFilter');
        const refresh = document.getElementById('srpRefreshReports');
        const updateHash = () => {
            const qs = new URLSearchParams();
            if (_srpState.filters.week) qs.set('week', _srpState.filters.week);
            if (_srpState.filters.smm) qs.set('smm', _srpState.filters.smm);
            if (_srpState.filters.client) qs.set('client', _srpState.filters.client);
            if (_srpState.filters.status) qs.set('status', _srpState.filters.status);
            history.replaceState(null, '', '#smm-weekly-reports' + (qs.toString() ? '?' + qs.toString() : ''));
        };
        if (week) week.addEventListener('change', () => { _srpState.filters.week = week.value; updateHash(); _srpLoadReports(); });
        if (smm) smm.addEventListener('change', () => { _srpState.filters.smm = smm.value; updateHash(); _srpLoadReports(); });
        if (client) {
            client.addEventListener('input', () => { _srpState.filters.client = client.value; updateHash(); _srpPaintReportResults(); _srpPaintClientResults(client.value, 'srpClientFilterResults'); });
            client.addEventListener('focus', () => _srpPaintClientResults(client.value, 'srpClientFilterResults'));
            client.addEventListener('keydown', e => {
                if (e.key !== 'Enter') return;
                const name = _srpFirstClientMatch(client.value);
                if (!name) return;
                e.preventDefault();
                _srpPickReportClientFilter(name, updateHash);
            });
            const filterResults = document.getElementById('srpClientFilterResults');
            if (filterResults) filterResults.addEventListener('click', e => {
                const btn = e.target.closest('[data-client-name]');
                if (!btn) return;
                _srpPickReportClientFilter(btn.getAttribute('data-client-name') || '', updateHash);
            });
        }
        if (status) status.addEventListener('change', () => { _srpState.filters.status = status.value; updateHash(); _srpPaintReportResults(); });
        if (refresh) refresh.addEventListener('click', () => { _srpOptionsFetched = false; _srpLoadReports(); });
        _srpEnsureClientOutsideWired();
    }
    function _srpPickReportClientFilter(name, updateHash) {
        const client = document.getElementById('srpClientFilter');
        const results = document.getElementById('srpClientFilterResults');
        if (!name || !client) return;
        client.value = name;
        _srpState.filters.client = name;
        if (typeof updateHash === 'function') updateHash();
        _srpPaintReportResults();
        if (results) results.style.display = 'none';
    }

    // ---- window exports (generated by `node scripts/check-modules.js --write-window-exports`; do not edit) ----
    Object.assign(window, {
        _srpPickSelect, _srpToggleSelect
