       pipeline. It is SMM-set ONLY -- nothing computes it, and In Progress
       stays the default for every new component. */
    const CAL_STATUSES  = ['N/A','In Progress','For SMM Approval','Kasper Approval','Client Approval','Tweaks Needed','Approved','Scheduled','Posted'];
    /* Worst → best. Overall card status is the lowest-priority sub-status.
       Must stay in lock-step with the n8n linear-status-sync PRIORITY table.
       N/A is DELIBERATELY absent: a lane marked not-applicable must not drag
       the card's overall status in either direction, and computeOverallStatus
       skips anything without a priority. Adding it here would also break the
       lock-step above. */
    const CAL_PRIORITY = { 'Tweaks Needed':0,'In Progress':1,'For SMM Approval':2,'Kasper Approval':3,'Client Approval':4,'Approved':5,'Scheduled':6,'Posted':7 };
    const CAL_COMPONENTS = ['video','graphic','caption'];
    /* Review components: the set that flows through the review panels, the
       Kasper queue, the Notes feed and unread/seen tracking. The YouTube TITLE
       is one of these — but is DELIBERATELY kept OUT of CAL_COMPONENTS above, so
       it never enters computeOverallStatus / _calIsClientReady / any overall-
       status machinery. See docs/features/YOUTUBE_TITLE_REVIEW_DESIGN.md. Iterate this list
       (via _calComponentsFor) for review/Notes/queue; iterate CAL_COMPONENTS for
       anything that feeds the overall status. */
    const CAL_REVIEW_COMPONENTS = ['video','graphic','caption','title'];
    /* The title reuses the existing status vocabulary, minus the publishing-only
       states (Scheduled / Posted) that don't apply to a title. */
    const CAL_TITLE_STATUSES = ['In Progress','For SMM Approval','Kasper Approval','Client Approval','Tweaks Needed','Approved'];
    /* Title review applies to YouTube cards only. */
    function _calIsYouTubeCard(post) { return _calPostPlatforms(post).includes('youtube'); }
    /* Per-client, cross-device toggle for the title-review feature (mirrors
       collab mode; lives in calState.settings). */
    function _calIsTitleReviewOn() { return !!(calState.settings && calState.settings.title_review); }
    /* Has the title been engaged in review (a sub-status was set)? Data-driven,
       so cross-client surfaces (the Kasper queue) work WITHOUT a per-client
       settings lookup: title_status can only be non-empty if an SMM whose
       feature was on set it. */
    function _calTitleEngaged(post) { return !!String((post && post.title_status) || '').trim(); }
    /* Components active for a post on the REVIEW / Notes / queue surfaces. The
       title joins only when it's an engaged YouTube card. (The SMM calendar's
       status row uses _calTitlePillShown instead, so the SMM can engage the
       title before it carries any status.) */
    function _calComponentsFor(post) {
        return (_calIsYouTubeCard(post) && _calTitleEngaged(post)) ? CAL_REVIEW_COMPONENTS : CAL_COMPONENTS;
    }
    /* Does the SMM calendar show a title status pill for this card? Toggle-gated
       (calState.settings is the right client in the calendar view), OR whenever
       the title already carries review state — so an in-flight review stays
       visible even if the feature is later toggled off. */
    function _calTitlePillShown(post) {
        return _calIsYouTubeCard(post) && (_calIsTitleReviewOn() || _calTitleEngaged(post));
    }
    /* Map any legacy / external status string onto the current set.
       "Draft" was retired — those posts become "In Progress". */
    function _calNormStatus(s) {
        const v = String(s || '').trim();
        if (!v || /^draft$/i.test(v)) return 'In Progress';
        if (/^(for )?kasper approval$/i.test(v)) return 'Kasper Approval';
        if (/^smm approval$/i.test(v)) return 'For SMM Approval';
        const m = CAL_STATUSES.find(x => x.toLowerCase() === v.toLowerCase());
        return m || v;
    }
    /* Compute the overall card status from its three sub-statuses using the
       lower-priority-wins rule. One sub in "Tweaks Needed" forces the
       whole card to "Tweaks Needed". */
    function computeOverallStatus(p) {
        if (!p) return 'In Progress';
        const subs = CAL_COMPONENTS.map(c => _calNormStatus(p[c + '_status'] || 'In Progress'));
        /* A card whose every lane is non-ranking -- today that means all three
           marked N/A -- has nothing to roll up, and the reduce below would
           fall through to its 'Posted' seed and report an untouched card as
           published. Expressed against CAL_PRIORITY rather than the N/A helper
           on purpose: computeOverallStatus is extracted and executed standalone
           by several suites, so it must not reach for identifiers outside the
           scope it already needs. */
        if (subs.every(s => CAL_PRIORITY[s] == null)) return subs[0] || 'In Progress';
        return subs.reduce((acc, s) => (CAL_PRIORITY[s] != null && CAL_PRIORITY[acc] != null && CAL_PRIORITY[s] < CAL_PRIORITY[acc]) ? s : acc, 'Posted');
    }
    /* Clears approval timestamps that no longer reflect the current state.
       Called whenever a sub-status changes. The rule: if a component's
       sub-status drops below "Client Approval" (i.e. is now Tweaks Needed,
       In Progress, For SMM Approval, or Kasper Approval), its
       client_<comp>_approved_at is stale and must be cleared so the row
       doesn't read "approved by client at <date>" while the UI shows it as
       awaiting approval. The overall kasper_approved_at is cleared when
       no component is at-or-above Client Approval anymore. `pending` is
       the _calPendingEdits[pid] bucket so the cleared values get written
       back to the sheet on the next flush. */
    function _calClearStaleApprovals(post, pending) {
        if (!post) return;
        const above = new Set(['Client Approval', 'Approved', 'Scheduled', 'Posted']);
        CAL_COMPONENTS.forEach(c => {
            const sub = _calNormStatus(post[c + '_status'] || '');
            const stampKey = 'client_' + c + '_approved_at';
            if (!above.has(sub) && post[stampKey]) {
                post[stampKey] = '';
                if (pending) pending[stampKey] = '';
            }
        });
        // Title follows the same stale-client-stamp rule, but stands apart from
        // CAL_COMPONENTS (it never feeds the overall status or kasper_approved_at).
        if (String(post.title_status || '').trim() && !above.has(_calNormStatus(post.title_status || '')) && post.client_title_approved_at) {
            post.client_title_approved_at = '';
            if (pending) pending.client_title_approved_at = '';
        }
        if (post.kasper_approved_at) {
            const anyAbove = CAL_COMPONENTS.some(c => above.has(_calNormStatus(post[c + '_status'] || '')));
            if (!anyAbove) {
                post.kasper_approved_at = '';
                if (pending) pending.kasper_approved_at = '';
            }
        }
    }
    /* Parses a sheet column that holds a JSON comments array. Falls back to
       a legacy plaintext value (seeded as a single SMM note) so existing
       data is never lost during the per-component tweaks migration. */
    function _calLoadCommentsField(post, fieldName, legacyFallback) {
        // The component this column belongs to, for the incomplete-read signal.
        const component = String(fieldName || '').replace(/_tweaks$/, '');
        const direct = post && post['_' + fieldName + '_parsed'];
        if (Array.isArray(direct)) {
            const kept = direct.filter(c => c && c.id);
            _prodMarkLegacyReadIncomplete(post, component, kept.length !== direct.length);
            return kept;
        }
        const raw = String((post && post[fieldName] != null) ? post[fieldName] : '').trim();
        const consumed = (raw && raw.startsWith('[')) ? raw : '';
        if (consumed) {
            try {
                const parsed = JSON.parse(consumed);
                if (Array.isArray(parsed)) {
                    const kept = parsed.filter(c => c && c.id);
                    // Rows without an id are DROPPED here, and the dropped row
                    // may be perfectly readable content — a body with real
                    // feedback and no id. The column still holds it, so the
                    // read is incomplete, not empty. Cleared on a clean read so
                    // a repaired column stops holding the card.
                    _prodMarkLegacyReadIncomplete(post, component, kept.length !== parsed.length);
                    return kept;
                }
                // JSON-shaped but not an array: nothing is loaded, yet the
                // column holds readable text.
                _prodMarkLegacyReadIncomplete(post, component, true);
            } catch {
                // Unparseable JSON. The seed path below deliberately skips a
                // consumed column, so this content reaches no reader at all.
                _prodMarkLegacyReadIncomplete(post, component, true);
            }
        }
        const fb = String(legacyFallback == null ? '' : legacyFallback).trim();
        if (!raw && !fb) return [];
        const seed = consumed ? '' : (raw || fb);
        if (!seed) return [];
        return [{
            id: 'c_legacy_' + Math.random().toString(36).slice(2, 8),
            parent_id: null,
            author: 'Legacy import — please send to Sidney before deleting',
            role: 'smm',
            body: seed, created_at: '', done: false, done_at: '', done_by: '',
            source: 'legacy_tweaks_column_seed',
            source_field: fieldName,
            seeded_at: new Date().toISOString()
        }];
    }
    /* Idempotent migration of a post row from the legacy single-status shape
       to per-component (video / graphic / caption) sub-statuses + comments.
       Existing rows with only `status` set get all three sub-statuses
       seeded to that value so workflow position is preserved. `tweaks`
       column content seeds video_comments so historical feedback isn't
       lost. The overall `status` is recomputed from the sub-statuses. */
