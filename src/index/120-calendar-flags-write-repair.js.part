    const WRITE_REFUSAL_BEACON_IDS = ['id', 'client_slug', 'card', 'component', 'comment', 'parent'];
    const WRITE_REFUSAL_BEACON_MAX = 20;
    let _writeRefusalBeaconBudget = WRITE_REFUSAL_BEACON_MAX;
    function _writeRefusalBeacon(surface, outcome, item, error) {
        if (outcome !== 'ui_write_failure' || _writeRefusalBeaconBudget <= 0) return;
        _writeRefusalBeaconBudget--;
        try {
            const context = _writeUiDiagnosticIds(item);
            const identifiers = {};
            for (const key of WRITE_REFUSAL_BEACON_IDS) {
                if (typeof context[key] === 'string' && context[key]) identifiers[key] = context[key];
            }
            // The REAL status, or none at all. A hardcoded one would write a
            // number into the receipt that no refusal ever returned, and the
            // function defaults an absent status rather than inventing one.
            const status = error && Number.isInteger(error.status) && error.status >= 400 && error.status <= 599
                ? error.status : null;
            const claim = {
                action: 'browser_claim', surface: String(surface || ''),
                operation: item && item.kind, code: error && error.code, identifiers
            };
            if (status !== null) claim.status = status;
            const body = JSON.stringify(claim);
            if (new TextEncoder().encode(body).length > 2048) return;
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 1500);
            fetch(WRITE_REFUSAL_BEACON_URL, {
                method: 'POST', headers: { 'content-type': 'application/json' },
                body, credentials: 'omit', keepalive: true, signal: controller.signal
            }).catch(() => {}).finally(() => clearTimeout(timer));
        } catch (e) {}
    }
    function _writeUiQueueDiagnostic(surface, outcome, item, error) {
        _writeRefusalBeacon(surface, outcome, item, error);
        try {
            const rows = JSON.parse(localStorage.getItem(WRITE_UI_QUEUE_DIAG_KEY) || '[]');
            const list = Array.isArray(rows) ? rows : [];
            list.push(Object.assign({
                at: new Date().toISOString(), surface: String(surface || ''),
                kind: String(item && item.kind || ''), outcome: String(outcome || ''),
                code: String(error && error.code || error && error.message || '').slice(0, 80)
            }, _writeUiDiagnosticIds(item)));
            localStorage.setItem(WRITE_UI_QUEUE_DIAG_KEY, JSON.stringify(list.slice(-50)));
        } catch (e) {}
    }
    window.peekWriteUiQueueDiagnostics = function () {
        try { const rows = JSON.parse(localStorage.getItem(WRITE_UI_QUEUE_DIAG_KEY) || '[]'); return Array.isArray(rows) ? rows : []; }
        catch (e) { return []; }
    };
    /* Every refusal the write path can produce, resolved to what the operator
       can actually DO about it.

       This notification used to carry four codes and collapse every other
       refusal into one sentence that ended "try the action again". That is the
       worst available answer for the largest group by far: a runtime flag, a
       permission decision or a malformed payload refuses IDENTICALLY on every
       attempt, so the only instruction the user received was the one action
       guaranteed to fail — and the precise code the gateway had already
       computed was discarded at the very last step, leaving the user nothing to
       report and support nothing to search for.

       So a code now resolves to a CLASS that states whether retrying can help
       and what to do instead, and the raw code is appended to every message. An
       unmapped code — a gateway refusal added later, a transport error, a code
       this table has never seen — still reaches the user verbatim instead of
       being flattened into "try again". */
    const WRITE_UI_FAILURE_CLASS_TEXT = {
        identity: {
            title: 'Write not saved',
            text: 'Your sign-in is no longer accepted by the write service. Sign in again, then repeat the action.'
        },
        access: {
            title: 'Write refused',
            text: 'Your account is not permitted to make this change on this item. Retrying will not change that — ask an SMM or the owner to make it, quoting this code.'
        },
        blocked: {
            title: 'Write refused',
            text: 'A current system setting refuses this write. It will refuse every retry — send this code to the owner so the setting can be checked.'
        },
        conflict: {
            title: 'Write not saved',
            text: 'Someone else changed this item first, so the write was declined instead of overwriting them. Reload, read the current state, then redo your change.'
        },
        // Both reload messages name the note box first on purpose: a REPLY or
        // EDIT draft lives only in this tab (only a new root note is mirrored to
        // sessionStorage), so advising a reload without that warning would
        // destroy the very text the failed write was trying to save.
        reload: {
            title: 'Write not saved',
            text: 'This page is holding an out-of-date copy of the item. Copy anything still in the note box, reload the page, then repeat the action.'
        },
        /* The link, not the tab. `artifact_not_resolvable` sat in `reload`
           until 2026-08-16, so a Graphics card with no usable deliverable link
           told its designer to reload the page — advice that cannot work and
           that loops them until they give up. The gateway already ships
           `guidance` and `asset_state` in this refusal; this class is what
           makes the dialog say the true thing when it does not. */
        artifact: {
            title: 'Add the deliverable link first',
            text: 'SMM approval needs a link to the finished work on this card. Add it to the card\'s Thumbnail link — a Google Drive file or folder, a Frame.io link, or a Dropbox file or folder — then request approval again.'
        },
        repair: {
            title: 'Write paused safely',
            // 2026-08-28: this text used to promise that reload always
            // resolves; for a receipt-less checkpoint that was false — no
            // number of reloads could clear it. Superseded checkpoints now
            // self-heal on load; the surviving held case genuinely needs the
            // owner, so say so instead of promising a reload can do it.
            text: 'The recovery checkpoint for this write is inconsistent, so nothing was committed. Copy anything still in the note box, then reload — a checkpoint the server has moved past clears itself on load. If the message persists after a reload, your typed text is safe in this browser but unsaved: copy it out and tell the owner.'
        },
        storage: {
            title: 'Write paused safely',
            text: 'This browser cannot checkpoint recovery data. Free browser storage, then try again.'
        },
        wait: {
            title: 'Write not saved',
            text: 'A service the write depends on did not answer, and nothing was committed. Try again in a moment; if it keeps failing, send this code to the owner.'
        },
        bug: {
            title: 'Write refused',
            text: 'The app sent something the write service rejected. Retrying will not help — send this code to the owner.'
        }
    };
    const WRITE_UI_FAILURE_CODE_CLASS = (() => {
        const map = Object.create(null);
        const add = (klass, codes) => { for (const code of codes) map[code] = klass; };
        // Who you are. Re-authenticating is the fix.
        add('identity', [
            'credentials_required', 'ambiguous_credentials', 'invalid_staff_key',
            'invalid_client_token', 'ambiguous_client_token', 'invalid_test_override',
            'roster_actor_required', 'roster_actor_not_unique'
        ]);
        // What you are allowed to do. A different person has to do it.
        add('access', [
            'operation_forbidden', 'comment_forbidden', 'comment_parent_forbidden',
            'client_scope_mismatch', 'client_inactive', 'asset_scope_forbidden',
            'assignee_scope_forbidden', 'description_scope_forbidden',
            'skip_graphic_generation_forbidden', 'test_client_scope_required',
            'test_project_scope_required', 'test_scope_service_only',
            'assignment_scope_forbidden',
            'native_label_scope_forbidden'
        ]);
        // A runtime flag or routing decision. Only the owner can move it.
        add('blocked', [
            'legacy_parity_disabled', 'legacy_parity_not_allowed', 'legacy_parity_required',
            'team_is_linear_authoritative', 'legacy_resume_lease_revoked',
            'test_client_scope_ambiguous', 'graphics_brief_server_owned',
            'intake_assignee_override_not_allowed', 'label_not_applicable',
            'label_selection_out_of_catalog', 'production_create_batch_scope',
            'production_create_parent_nested', 'production_create_parent_route',
            'production_create_parent_scope', 'production_create_closed',
            'native_label_catalog_config_invalid',
            'native_label_catalog_held',
            'native_label_catalog_unverified'
        ]);
        // Someone else won the race.
        add('conflict', [
            'write_conflict', 'idempotency_conflict', 'intent_conflict',
            'component_fill_team_occupied', 'component_fill_card_archived',
            'intake_id_conflict', 'repair_principal_conflict', 'status_reapply_required',
            'repair_status_not_applied', 'legacy_tweak_delivery_unconfirmed'
        ]);
        // This tab is holding a stale card, thread or link.
        add('reload', [
            'native_link_required', 'canonical_comment_read_required', 'comment_cas_required',
            'cas_required', 'entity_not_found', 'entity_scope_unavailable',
            'legacy_link_ambiguous', 'identity_repair_required',
            'batch_not_found', 'batch_not_active', 'batch_team_mismatch',
            'batch_client_mismatch',
            /* A fill names a card and the sibling it is completing. All three
               of these mean the tab's picture of that pairing has moved on --
               the sibling is gone, it no longer carries this card, or its sort
               position changed under the request. Reloading is the fix, and
               the only fix; nothing about the person's intent was wrong. */
            'component_fill_sibling_missing', 'component_fill_card_mismatch',
            'component_fill_sort_mismatch', 'component_fill_card_missing',
            'source_repair_receipt_required', 'status_commit_required',
            'create_parent_not_found', 'batch_parent_mapping_missing',
            'batch_parent_mapping_ambiguous', 'native_label_state_incomplete',
            'native_label_catalog_changed'
        ]);
        // The local repair journal for this write does not line up.
        add('repair', [
            'repair_context_unavailable', 'repair_storage_unknown', 'repair_intent_unavailable',
            'repair_checkpoint_missing', 'repair_payload_invalid', 'repair_payload_mismatch',
            'repair_receipt_target_mismatch', 'repair_comment_receipt_mismatch',
            'reconcile_receipt_invalid'
        ]);
        add('storage', ['repair_storage_unavailable']);
        // The card's deliverable link is missing or unsupported. Reloading
        // cannot fix that and never could; adding a usable link can.
        add('artifact', ['artifact_not_resolvable']);
        // Transient: a dependency was unreachable and nothing was committed.
        add('wait', [
            'authority_unavailable', 'service_unavailable', 'write_failed',
            'native_write_failed', 'native_response_refresh_failed', 'idempotent_result_missing',
            'outbox_checkpoint_missing', 'drainer_unavailable', 'client_scope_unavailable',
            'entity_lookup_unavailable', 'deliverable_lookup_unavailable',
            'deliverable_repair_unavailable',
            'comment_lookup_unavailable', 'comment_parent_lookup_unavailable',
            'comment_dependency_lookup_unavailable', 'comment_receipt_lookup_unavailable',
            'idempotency_lookup_unavailable', 'identity_guard_unavailable',
            'roster_lookup_unavailable', 'client_auth_unavailable', 'client_lookup_unavailable',
            'legacy_parity_gate_unavailable', 'team_authority_unknown',
            'status_mapping_unavailable', 'linear_issue_unavailable',
            'linear_issue_team_unavailable', 'linear_team_mapping_unavailable',
            'project_mapping_missing', 'project_mapping_ambiguous',
            'project_mapping_validation_unavailable', 'test_project_mapping_unavailable',
            'batch_lookup_unavailable', 'batch_parent_lookup_unavailable',
            'reconcile_receipt_unavailable', 'reconcile_comment_unavailable',
            'reconcile_current_row_unavailable', 'native_replay_status_unavailable',
            'native_replay_read_unavailable', 'native_replay_clock_unavailable',
            'repair_lock_unavailable', 'legacy_outbox_lock_unavailable',
            'legacy_tweak_target_lock_unavailable', 'legacy_tweak_confirmation_pending',
            'legacy_outbox_finalize_failed', 'legacy_outbox_finalize_unverified',
            'legacy_committed_tweak_retire_failed', 'legacy_committed_tweak_retire_unverified',
            'asset_context_unavailable', 'asset_evidence_unavailable',
            'assignee_load_unavailable', 'assignee_lookup_unavailable',
            'assignee_provider_unavailable', 'video_assignee_pool_unavailable',
            'graphics_default_assignee_unavailable', 'create_parent_lookup_unavailable',
            'create_replay_lookup_unavailable', 'graphic_generation_unavailable',
            'graphic_generation_failed', 'label_catalog_unavailable',
            'label_catalog_incomplete', 'label_selection_incomplete',
            'native_label_catalog_config_unavailable',
            'native_label_catalog_malformed',
            'native_label_catalog_unavailable'
        ]);
        // A payload this UI built, which the gateway will reject every time.
        add('bug', [
            'invalid_json', 'invalid_entity', 'invalid_surface', 'invalid_surface_operation',
            'unsupported_operation', 'unsupported_action', 'unsupported_batch_operation',
            'method_not_allowed', 'entity_id_required', 'client_slug_required',
            'valid_request_id_required', 'valid_comment_id_required',
            'invalid_source_edited_at', 'invalid_comment_action', 'invalid_comment_audience',
            'invalid_comment_parent', 'invalid_comment_round', 'invalid_native_comment_id',
            'comment_root_required', 'invalid_status', 'invalid_team', 'invalid_description',
            'invalid_due_date', 'invalid_label_ids', 'repair_operation_unsupported',
            'repair_status_invalid', 'reconcile_operation_unsupported',
            'invalid_artifact_url', 'invalid_expected_batch_updated_at',
            /* The panel only ever offers a slot that PROD_ASSET_SPECS marks
               writable, and the filming plan is not one, so reaching this means
