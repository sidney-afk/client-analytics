        if (s === 'approved') return 'approved';
        if (s.includes('smm')) return 'smm_approval';
        if (s.includes('kasper')) return 'kasper_approval';
        if (s.includes('client')) return 'client_approval';
        if (s === 'backlog') return 'backlog';
        if (s === 'todo' || s === 'to do') return 'todo';
        if (s.includes('progress') || s.includes('process')) return 'in_progress';
        if (s.includes('cancel')) return 'canceled';
        if (s.includes('duplicate')) return 'duplicate';
