        },
        invalid_intake_item_name: {
            title: 'Post name too long',
            text: 'One of the post names is longer than a sub-issue title can carry. Shorten it, then create the post again.'
        },
        client_credentials_required: {
            title: 'Write not saved',
            text: 'This client link needs a current review token. Ask your SMM for a fresh link, then try again.'
        },
        /* The three public-submission refusals. These reach a CLIENT or a
           VIDEOGRAPHER on the Submit link, never staff, so they say what to do
           in plain words and never name a role, a flag or a gateway. All three
           are refused BEFORE anything is created, which is why each one can
           promise that nothing was sent. */
        public_intake_too_large: {
            title: 'Submission not sent',
            text: 'That is more videos than one submission can carry. Send them in a couple of smaller batches instead — nothing was sent, so nothing is duplicated.'
        },
        public_intake_rate_limited: {
            title: 'Submission not sent',
            text: 'A lot of submissions have arrived for this client in the last hour. Wait a few minutes and send again — nothing was sent, and what you typed is still here.'
