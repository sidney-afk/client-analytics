            case 'credentials_required':
            case 'ambiguous_credentials':
            case 'invalid_staff_key':
                return 'Your staff sign-in is no longer valid. Sign in again, then copy the link.';
            case 'staff_required':
                return 'Only a signed-in staff account can create a client link.';
            case 'inactive_client':
                return 'This client has no active roster row yet. Create their public.clients row (new-client runbook step 6f), then copy the link.';
            case 'review_token_missing':
                return 'Could not issue this client a review token. Ask an admin to run scripts/provision-client-access.js --apply.';
            case 'authorization_unavailable':
            case 'service_unavailable':
