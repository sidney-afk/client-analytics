            smm_approval: 'For SMM Approval', kasper_approval: 'Kasper Approval',
            client_approval: 'Client Approval', tweak: 'Tweaks Needed',
            approved: 'Approved', scheduled: 'Scheduled', posted: 'Posted',
            canceled: 'Canceled', duplicate: 'Duplicate'
