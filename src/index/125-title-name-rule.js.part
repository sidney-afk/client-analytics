import { CAL_SUPABASE_ANON_KEY, CAL_SUPABASE_URL } from './100-onboarding-staff-controls.js';
import { _writeUiQueueDiagnostic } from './120-calendar-flags-write-repair.js';
import { calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
import { _calIsBlankId } from './160-calendar-organize-ui.js';
import { _prodCanWrite, _prodIssue, _prodToast } from './220-production-attribution-views.js';
import { _prodGatewayWrite, _prodWriteErrorText } from './230-production-create-comments.js';
import { _isClientLink, _prodRender } from './260-production-refresh-boot.js';
    /* ── Title name rule (browser copy) ──────────────────────────────────
       The one rule for splitting and renaming sub-issue titles
       (`[Sample ]Video|Thumbnail N[ — name]`). The source is
       supabase/functions/_shared/title-name-rule.mjs; the SQL copy is
       `syncview_title_*` in migrations/2026-09-23-rename-propagation.sql.
       test/title-name-rule-drift.js runs one fixture table through all
       three and fails on any difference, so edit all three together.
       Everything between the BEGIN/END markers is evaluated by that test. */
    // SYNC_TITLE_RULE BEGIN
    const SYNC_TITLE_RULE = (function () {
        const TITLE_SEPARATOR = ' \u2014 ';
        const NAME_MAX = 160;
        const WS = '\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff';
        const LINE_BREAKS = '\\n\\r\\u2028\\u2029';
        const TITLE_SOURCE = '^(Sample )?(Video|Thumbnail) ([1-9][0-9]*)(?:' + TITLE_SEPARATOR + '([^' + LINE_BREAKS + ']+))?$';
        const WS_RUN = new RegExp('[' + WS + ']+', 'g');
        const WS_EDGE = new RegExp('^[' + WS + ']+|[' + WS + ']+$', 'g');
        const TITLE_RE = new RegExp(TITLE_SOURCE);
        function trimText(value) {
            return String(value == null ? '' : value).replace(WS_EDGE, '');
        }
        function cleanName(value) {
            return trimText(String(value == null ? '' : value).replace(WS_RUN, ' '));
        }
        function nameLength(value) {
            return Array.from(String(value == null ? '' : value)).length;
        }
        function titleParts(title) {
            const match = TITLE_RE.exec(trimText(title));
            if (!match) return null;
            return { sample: !!match[1], kind: match[2], ordinal: Number(match[3]), digits: match[3], name: trimText(match[4] || '') };
        }
        function nameOfTitle(title) {
            const parts = titleParts(title);
            return parts ? parts.name : trimText(title);
        }
        function renameTitle(oldTitle, newName) {
            const name = cleanName(newName);
            if (nameLength(name) > NAME_MAX) return { ok: false, reason: 'name_too_long' };
            const before = trimText(oldTitle);
            const parts = titleParts(before);
            let title;
            if (parts) {
                title = (parts.sample ? 'Sample ' : '') + parts.kind + ' ' + parts.digits
                    + (name ? TITLE_SEPARATOR + name : '');
            } else {
                if (!name) return { ok: false, reason: 'empty_name_not_propagated' };
                if (titleParts(name)) return { ok: false, reason: 'name_would_look_numbered' };
                title = name;
            }
            return { ok: true, title, changed: title !== before };
        }
        return Object.freeze({
            TITLE_SEPARATOR, NAME_MAX,
            RULE_SOURCE: Object.freeze({ whitespace: WS, lineBreaks: LINE_BREAKS, title: TITLE_SOURCE }),
            trimText, cleanName, nameLength, titleParts, nameOfTitle, renameTitle
        });
    })();
    // SYNC_TITLE_RULE END

    /* ── Rename propagation (browser side) ────────────────────────────────
       A rename is recorded by the database when the card (or, in release 2,
       the sub-issue) saves, and a background drain applies it to the other
       side (migrations/2026-09-23-rename-propagation.sql). The browser only:
         * pokes the drain right after a rename, so the other side usually
           follows within a second instead of at the next scheduled run;
         * reads the "name syncing" state for the cards on screen;
         * re-queues a rename that gave up, when someone presses Retry.
       None of these can affect the save itself: they run after it, every
       failure is swallowed, and the scheduled drain is the backstop. */
    const RENAME_PROP_ACTIVE = { pending: 1, deferred: 1 };
    function _renamePropHeaders() {
        return {
            apikey: CAL_SUPABASE_ANON_KEY,
            authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY,
            'content-type': 'application/json'
        };
    }
    async function _renamePropPoke() {
        try {
            const res = await fetch(CAL_SUPABASE_URL + '/rest/v1/rpc/rename_propagation_poke', {
                method: 'POST', headers: _renamePropHeaders(), body: '{}'
            });
            return res.ok ? await res.json() : null;
        } catch (_) { return null; }
    }
    // Latest propagation state per source id: Map(id -> { id: outboxId, state }).
    // sourceKind is 'card', 'sample_card' or 'deliverable'.
    async function _renamePropStatus(sourceKind, ids) {
        const out = new Map();
        const list = Array.from(new Set((ids || []).map(v => String(v || '').trim()).filter(Boolean)));
        if (!list.length) return out;
        try {
            for (let i = 0; i < list.length; i += 100) {
                const chunk = list.slice(i, i + 100).map(v => '"' + v.replace(/"/g, '') + '"').join(',');
                const url = CAL_SUPABASE_URL + '/rest/v1/rename_propagation_status_v1?select=id,source_id,state'
                    + '&source_kind=eq.' + encodeURIComponent(sourceKind)
                    + '&source_id=in.(' + encodeURIComponent(chunk) + ')';
                const res = await fetch(url, { headers: _renamePropHeaders() });
                if (!res.ok) return out; // not applied yet, or unavailable: show nothing
                for (const row of await res.json()) out.set(String(row.source_id), { id: row.id, state: row.state });
            }
        } catch (_) { /* the marker is optional; never let it break a render */ }
        return out;
    }
    // 'syncing' | 'failed' | '' for a status entry.
    function _renamePropMarker(entry) {
        if (!entry) return '';
        if (RENAME_PROP_ACTIVE[entry.state]) return 'syncing';
        return entry.state === 'failed' ? 'failed' : '';
    }
    async function _renamePropRetry(outboxId) {
        try {
            const res = await fetch(CAL_SUPABASE_URL + '/rest/v1/rpc/rename_propagation_retry', {
                method: 'POST', headers: _renamePropHeaders(), body: JSON.stringify({ p_id: Number(outboxId) })
            });
            if (!res.ok) return false;
            const retried = await res.json();
            if (retried === true) _renamePropPoke();
            return retried === true;
        } catch (_) { return false; }
    }

    /* ── Calendar "name syncing" marker (staff only) ──────────────────────
       A small note beside a card's name while its rename is still on its way
       to the linked sub-issues, and "Name didn't sync · Retry" if the drain
       gave up (the drain has already written the server logbook; this adds
       the local WR-101 ring entry once per attempt). Clients never see it.
       Everything here is best-effort: a failed read shows nothing. */
    const _calNameSyncLogged = new Set();
    // Cards THIS page renamed. The marker reads status only for these, so a
    // render caused by anything else (boot, a BFCache restore, a forced-meta
    // refresh, a realtime echo) makes no request at all -- the boot suite
    // requires settled restore traffic to stay synthetic.
    const _calNameSyncWatched = new Set();
    let _calNameSyncTimer = null;
    function _calNameSyncSlotHtml(pid) {
        return `<span class="cal-name-sync" data-name-sync="${pid}" hidden></span>`;
    }
    function _calNameSyncLinked(post) {
        return !!(post && !_calIsBlankId(post.id) && (post.video_deliverable_id || post.graphic_deliverable_id));
    }
    function _calNameSyncPaint(pid, entry) {
        const marker = _renamePropMarker(entry);
        document.querySelectorAll('[data-name-sync]').forEach(el => {
            if (el.getAttribute('data-name-sync') !== pid) return;
            if (!marker) { el.hidden = true; el.textContent = ''; el.className = 'cal-name-sync'; return; }
            el.hidden = false;
            el.className = 'cal-name-sync is-' + marker;
            if (marker === 'syncing') {
                el.textContent = 'Name syncing…';
                el.title = 'The new name is being copied to the linked sub-issues.';
            } else {
                el.textContent = '';
                el.title = 'The new name could not be copied to the linked sub-issues.';
                const label = document.createElement('span');
                label.textContent = 'Name didn’t sync · ';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'cal-name-sync-retry';
                btn.textContent = 'Retry';
                btn.onclick = (ev) => { ev.stopPropagation(); _calNameSyncRetry(pid, entry.id); };
                el.append(label, btn);
            }
        });
        if (marker === 'failed' && entry && !_calNameSyncLogged.has(entry.id)) {
            _calNameSyncLogged.add(entry.id);
            try {
                _writeUiQueueDiagnostic('calendar', 'rename_propagation_failed',
                    { kind: 'rename', id: pid, client_slug: calClientSlug(calState.client) }, null);
            } catch (_) { /* the ring is optional */ }
        }
    }
    async function _calNameSyncRefresh(pids) {
        if (_isClientLink) return new Map();
        const ids = (pids || []).filter(Boolean);
        const status = await _renamePropStatus('card', ids);
        ids.forEach(pid => {
            const entry = status.get(pid);
            _calNameSyncPaint(pid, entry);
            // Settled (or unreadable): stop reading for this card on later renders.
            if (!_renamePropMarker(entry)) _calNameSyncWatched.delete(String(pid));
        });
        return status;
    }
    // After a calendar render: repaint the marker for cards this page renamed
    // (a render replaces the card DOM, and with it the marker).
    function _calNameSyncScheduleRefresh() {
        if (_isClientLink || !_calNameSyncWatched.size) return;
        if (_calNameSyncTimer) clearTimeout(_calNameSyncTimer);
        _calNameSyncTimer = setTimeout(() => {
            _calNameSyncTimer = null;
            const onScreen = new Set();
            document.querySelectorAll('[data-name-sync]').forEach(el => onScreen.add(el.getAttribute('data-name-sync')));
            const ids = Array.from(_calNameSyncWatched).filter(pid => onScreen.has(pid));
            if (ids.length) _calNameSyncRefresh(ids);
        }, 400);
    }
    // After a staff rename saves: nudge the drain, then watch this card
    // until its rename settles (or hand over to the next render's refresh).
    async function _calNameSyncAfterSave(pid) {
        const post = (calState.posts || []).find(p => p.id === pid);
        if (_isClientLink || !_calNameSyncLinked(post)) return;
        _calNameSyncWatched.add(String(pid));
        _calNameSyncPaint(pid, { state: 'pending' });
        await _renamePropPoke();
        for (let i = 0; i < 6; i++) {
            const status = await _calNameSyncRefresh([pid]);
            if (_renamePropMarker(status.get(pid)) !== 'syncing') return;
            await new Promise(res => setTimeout(res, 2500));
            await _renamePropPoke();
        }
    }
    async function _calNameSyncRetry(pid, outboxId) {
        _calNameSyncPaint(pid, { state: 'pending' });
        await _renamePropRetry(outboxId);
        _calNameSyncAfterSave(pid);
    }

    /* ── SyncLinear: rename a sub-issue (release 2) ───────────────────────
       The issue page's title becomes editable for anyone the gateway would
       let rename it (admin, SMM, and an editor on their own assigned
       sub-issue: _prodCanWrite(issue, 'title')). Only the NAME is edited;
       the `Video 4 —` prefix is shown but fixed, because the number is data.
       The save goes through production-write `title`; the linked card then
       follows through the database outbox, so this page only nudges the
       drain afterwards and never waits on it. */
    /* OPTIMISTIC RENAME (owner report 2026-09-23: the title went blank for
       about a second after clicking out, then came back). From the moment a
       rename is committed until the gateway answers, the issue page shows the
       NEW composed title -- prefix and all -- from this map, whatever re-renders
       in between; a refusal drops the entry and the old title comes back, with
       the reason in a toast. The only saving hint is a slight fade. */
    const _prodTitlePending = new Map();
    function _prodTitleShown(d) {
        const pending = d && _prodTitlePending.get(String(d.id));
        return pending ? pending.title : String(d && d.title || '');
    }
    function _prodTitlePaint(id) {
        const pending = _prodTitlePending.get(String(id));
        document.querySelectorAll('[data-prod-title-edit]').forEach(el => {
            if (el.getAttribute('data-prod-title-edit') !== String(id)) return;
            // An input still being typed in is left alone; one that was just
            // committed (clicked out of) is replaced by the title at once.
            const input = el.querySelector('input');
            if (input && document.activeElement === input) return;
            const issue = _prodIssue(id);
            el.textContent = _prodTitleShown(issue || { id, title: pending ? pending.title : '' }) || 'Untitled deliverable';
            el.classList.toggle('is-saving', !!pending);
        });
    }
    function _prodDetailTitleHtml(d) {
        const pending = !!(d && _prodTitlePending.has(String(d.id)));
        const title = _prodTitleShown(d) || 'Untitled deliverable';
        const canRename = !!(d && d.syntheticBatchParent !== true && _prodCanWrite(d, 'title'));
        if (!canRename && !pending) return '<h1 class="prod-detail-title">' + _calEsc(title) + '</h1>';
        return '<h1 class="prod-detail-title prod-title-editable' + (pending ? ' is-saving' : '') + '" tabindex="0" role="button"'
            + (pending ? ' aria-busy="true"' : '')
            + ' data-prod-title-edit="' + _calEscAttr(d.id) + '" title="Rename"'
            + ' onclick="_prodTitleEditStart(this)"'
            + ' onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();_prodTitleEditStart(this)}">'
            + _calEsc(title) + '</h1>';
    }
    function _prodTitleEditStart(el) {
        if (!el || el.querySelector('input')) return;
        const id = el.getAttribute('data-prod-title-edit');
        if (_prodTitlePending.has(String(id))) return; // one rename at a time
        const issue = _prodIssue(id);
        if (!issue) return;
        const parts = SYNC_TITLE_RULE.titleParts(issue.title);
        const prefix = parts ? (parts.sample ? 'Sample ' : '') + parts.kind + ' ' + parts.digits + SYNC_TITLE_RULE.TITLE_SEPARATOR : '';
        const name = SYNC_TITLE_RULE.nameOfTitle(issue.title);
        el.innerHTML = (prefix ? '<span class="prod-title-prefix">' + _calEsc(prefix) + '</span>' : '')
            + '<input class="prod-title-input" type="text" maxlength="400" aria-label="Sub-issue name" value="' + _calEscAttr(name) + '">';
        const input = el.querySelector('input');
        let done = false;
        const finish = (save) => {
            if (done) return;
            done = true;
            _prodTitleEditCommit(id, save ? input.value : null);
        };
        input.addEventListener('keydown', ev => {
            ev.stopPropagation();
            if (ev.key === 'Enter') { ev.preventDefault(); finish(true); }
            else if (ev.key === 'Escape') { ev.preventDefault(); finish(false); }
        });
        input.addEventListener('blur', () => finish(true));
        input.addEventListener('click', ev => ev.stopPropagation());
        input.focus();
        input.select();
    }
    async function _prodTitleEditCommit(id, value) {
        const issue = _prodIssue(id);
        if (!issue || value == null) { _prodRender(); return; }
        const check = SYNC_TITLE_RULE.renameTitle(issue.title, value);
        if (!check.ok) {
            _prodToast(check.reason === 'name_too_long'
                ? 'That name is too long (' + SYNC_TITLE_RULE.NAME_MAX + ' characters at most).'
                : check.reason === 'name_would_look_numbered'
                    ? 'That name looks like a numbered title. Choose a different name.'
                    : 'Type a name for this sub-issue.');
            _prodRender();
            return;
        }
        if (!check.changed) { _prodRender(); return; }
        const key = String(id);
        // Show the new title NOW, synchronously, before anything awaits or
        // re-renders; every render until the answer reads it from the map.
        _prodTitlePending.set(key, { title: check.title, previous: issue.title });
        _prodTitlePaint(key);
        let saved = false;
        try {
            const result = await _prodGatewayWrite(issue, 'title', { name: SYNC_TITLE_RULE.cleanName(value) });
            if (result === null) throw Object.assign(new Error('write_pending'), { code: 'write_pending' });
            saved = true;
        } catch (error) {
            _prodTitlePending.delete(key);
            _prodTitlePaint(key);
            _prodToast(error && error.code === 'write_pending'
                ? 'Another change to this sub-issue is still saving. Try again in a moment.'
                : _prodWriteErrorText(error, issue, 'title'));
        }
        if (saved) {
            // The gateway row is adopted by _prodGatewayWrite; keep the open
            // object in step too, so no frame can fall back to the old title.
            issue.title = check.title;
            _prodTitlePending.delete(key);
            _prodToast('Renamed. The card will follow.');
            _renamePropPoke();
        }
        _prodRender();
        _prodTitlePaint(key);
    }

export { _calNameSyncAfterSave, _calNameSyncScheduleRefresh, _calNameSyncSlotHtml, _prodDetailTitleHtml };
