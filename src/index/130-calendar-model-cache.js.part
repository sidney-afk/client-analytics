    function _calMigratePostShape(p) {
        if (!p || typeof p !== 'object') return p;
        const legacy = _calNormStatus(p.status || 'In Progress');
        const hasV = !!String(p.video_status   || '').trim();
        const hasG = !!String(p.graphic_status || '').trim();
        const hasC = !!String(p.caption_status || '').trim();
        // Only seed sub-statuses from the overall when this is a legacy row
        // with no sub-statuses at all. Otherwise a blank sub means "untouched"
        // — and seeding it from `status` (which is the worst-of) would clobber
        // an approved component the moment a sibling moved to Tweaks Needed.
        const isLegacyOnly = !hasV && !hasG && !hasC;
        p.video_status   = hasV ? _calNormStatus(p.video_status)   : (isLegacyOnly ? legacy : 'In Progress');
        p.graphic_status = hasG ? _calNormStatus(p.graphic_status) : (isLegacyOnly ? legacy : 'In Progress');
        p.caption_status = hasC ? _calNormStatus(p.caption_status) : (isLegacyOnly ? legacy : 'In Progress');
        // Title status is independent of the overall card status and is NEVER
        // seeded from the legacy `status`. It stays empty until an SMM engages
        // it, so existing / non-YouTube cards never surface a title review and
        // computeOverallStatus (which ignores it anyway) is unaffected.
        p.title_status = String(p.title_status || '').trim() ? _calNormStatus(p.title_status) : '';
        ['video_deliverable_id', 'graphic_deliverable_id'].forEach(k => { if (p[k] == null) p[k] = ''; });
        ['thumbnail_folder_url','thumbnail_folder_id','thumbnail_file_id','thumbnail_folder_resolved_at'].forEach(k => { if (p[k] == null) p[k] = ''; });
        p.video_comments   = _calLoadCommentsField(p, 'video_tweaks',   p.tweaks);
        p.graphic_comments = _calLoadCommentsField(p, 'graphic_tweaks', '');
        p.caption_comments = _calLoadCommentsField(p, 'caption_tweaks', '');
        p.title_comments   = _calLoadCommentsField(p, 'title_tweaks',   '');
        // Per-comment merge clock. Legacy comments (and any written before the
        // field existed) lack updated_at; seed it from created_at so newer-wins
        // comparisons in the CRDT merge are always well-defined and a later
        // resolve/delete reliably beats the original.
        [p.video_comments, p.graphic_comments, p.caption_comments, p.title_comments].forEach(arr => {
            if (Array.isArray(arr)) arr.forEach(c => { if (c && !c.updated_at) c.updated_at = c.created_at || ''; });
        });
        p.comments = p.video_comments;
        p.status = computeOverallStatus(p);
        // Seed the local Kasper-seen cache from the sheet's cross-device
        // `kasper_seen` column (CSV of components), so a device that's never
        // touched this post still knows which components have been to Kasper.
