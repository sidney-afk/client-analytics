        { key: 'pinterest', label: 'Pinterest', color: 'var(--sv-fg-e60023)',
          icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9.2-.8 1.2-5 1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.8-2.5.9 0 1.3.7 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.6 2.1-4.6 4.4 0 .9.3 1.8.8 2.3 0 .1 0 .2-.1.3l-.3 1.2c0 .2-.2.3-.4.1-1.2-.6-2-2.4-2-3.9 0-3.2 2.3-6.1 6.6-6.1 3.4 0 6.1 2.4 6.1 5.7 0 3.4-2.2 6.2-5.2 6.2-1 0-2-.5-2.3-1.1l-.6 2.4c-.2.9-.8 2-1.2 2.7.9.3 1.9.4 2.9.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>' },
    ];
    const CAL_PLATFORM_BY_KEY = Object.fromEntries(CAL_PLATFORMS.map(p => [p.key, p]));
    const CAL_ENABLED_PLATFORMS_KEY = 'syncview_cal_enabled_platforms_v1';
    function _calEnabledPlatformsLocal(slug) {
        if (!slug) return [];
        try {
            const raw = localStorage.getItem(CAL_ENABLED_PLATFORMS_KEY);
            const map = raw ? JSON.parse(raw) : {};
            const list = Array.isArray(map[slug]) ? map[slug] : [];
            return list.filter(k => CAL_PLATFORM_BY_KEY[k]);
        } catch { return []; }
    }
    function _calEnabledPlatforms(slug) {
        if (!slug) return [];
        // Prefer the shared settings row: it's persisted to the backend, so the
