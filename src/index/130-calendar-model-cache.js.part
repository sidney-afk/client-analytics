        const str = _calStringifyComments(list);
        if (comp === 'graphic') { post.graphic_comments = list; post.graphic_tweaks = str; return; }
        if (comp === 'caption') { post.caption_comments = list; post.caption_tweaks = str; return; }
        if (comp === 'title') { post.title_comments = list; post.title_tweaks = str; return; }
        post.video_comments = list;
        post.comments = list;
        post.video_tweaks = str;
        post.tweaks = str;
    }
