        // Default to ALL months (not the current month). Defaulting to the current
        // month silently hid every card scheduled in another month behind a small
        // warning chip, so cards looked "missing" until you noticed the filter.
        return 'all';
    }
    function _calShiftMonthIso(ym, n) {
        const [Y, M] = ym.split('-').map(Number);
