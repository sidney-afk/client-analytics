    function _calLinearUrlFor(post, comp) {
        if (!post) return '';
        if (comp === 'graphic') return String(post.graphic_linear_issue_id || '').trim();
        if (comp === 'caption' || comp === 'title') return '';
        return String(post.linear_issue_id || '').trim();
    }
    /* A production component is linked when either epoch can resolve it: the
       legacy Linear URL column or the native deliverable-id column. Keep every
       Kasper gate and staff pill lock on this one predicate so a native-only
