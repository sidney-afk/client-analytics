    function _calNormStatusFilter(v) {
        return (v === 'scheduled' || v === 'unscheduled') ? v : 'all';
    }
    function _calPostHasDate(p) {
        return !!String(p && p.scheduled_date || '').slice(0, 10);
    }
    function _calPostInStatusFilter(p, s) {
