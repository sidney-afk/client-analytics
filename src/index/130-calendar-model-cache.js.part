    function _calCompLinked(post, comp) {
        if (!post) return false;
        if (comp === 'graphic') return !!String(post.graphic_deliverable_id || '').trim();
        if (comp === 'video') return !!String(post.video_deliverable_id || '').trim();
        return true;
    }
    /* WHAT A COMPONENT PILL SHOULD DISPLAY (owner ruling 2026-08-20).
       A video/graphic slot with no Linear sub-issue has no work item behind
       it, so "In Progress" is a claim the card cannot support. The SMM card
       already greys and disables such a pill; the client had no signal at all.
       Both now read N/A.

       ONE helper for four render paths -- the calendar card, the samples card
       and both in-place pill updaters -- because they drift otherwise: an
       in-place update that recomputed the label from the stored status would
