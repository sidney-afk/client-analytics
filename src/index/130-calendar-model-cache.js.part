                <button type="button" class="cal-cap-tab${active === 'alt' ? ' is-active' : ''}" data-captab="alt" onclick="_calCapAltTabClick(event,'${pid}',this)" title="${canEdit ? _calEscAttr(platLabel) + ' caption — click while active to change the platform' : _calEscAttr(platLabel) + ' caption'}">${_calEsc(platLabel)}${canEdit ? `<span class="cal-cap-tab-chev">${chevIco}</span><span class="cal-cap-tab-x" onclick="_calAltCapRemove(event,'${pid}')" title="Remove the ${_calEscAttr(platLabel)} caption">${xIco}</span>` : ''}</button>
            </div>`;
        } else if (canEdit) {
