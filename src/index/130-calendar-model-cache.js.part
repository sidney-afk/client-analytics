    }
    function _calSetEnabledPlatforms(slug, list) {
        if (!slug) return;
        try {
            const raw = localStorage.getItem(CAL_ENABLED_PLATFORMS_KEY);
            const map = raw ? JSON.parse(raw) : {};
            map[slug] = (list || []).filter(k => CAL_PLATFORM_BY_KEY[k]);
            localStorage.setItem(CAL_ENABLED_PLATFORMS_KEY, JSON.stringify(map));
        } catch {}
    }
    function _calPostPlatforms(post) {
        const raw = String((post && post.platforms) || '').trim();
        if (!raw) return [];
        return raw.split(',').map(s => s.trim().toLowerCase()).filter(k => CAL_PLATFORM_BY_KEY[k]);
    }
    /* Alt caption — a second, platform-specific caption (e.g. a LinkedIn
