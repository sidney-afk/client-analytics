            </div>`;
        }
        const genBtn = canEdit ? _calCapGenBtnHtml(p) : '';
        return `${tabsHtml}
            <div class="cal-cap-wrap${active === 'alt' ? ' captab-off' : ''}" data-capwrap="main" onclick="_calCaptionWrapClick(event,this)">
                <textarea class="cal-fld-cap" rows="5" data-pid="${pid}" data-fld="caption" placeholder="Caption" oninput="_calOnCaptionInput(this)" onfocus="_calOnCaptionFocus(this)" onblur="_calOnCaptionBlur(this)" onkeydown="_calOnCaptionKey(event,this)"${!editableText ? ' readonly' : ''}>${_calEsc(p.caption)}</textarea>
                <div class="cal-cap-fade" aria-hidden="true"></div>
                ${capToggle}
                ${genBtn}
            </div>
            ${hasAlt ? `<div class="cal-cap-wrap${active === 'alt' ? '' : ' captab-off'}" data-capwrap="alt" onclick="_calCaptionWrapClick(event,this)">
                <textarea class="cal-fld-cap" rows="5" data-pid="${pid}" data-fld="caption_alt" placeholder="${_calEscAttr(platLabel)} caption" oninput="_calOnAltCapInput(this)" onfocus="_calOnCaptionFocus(this)" onblur="_calOnCaptionBlur(this)" onkeydown="_calOnCaptionKey(event,this)"${!editableText ? ' readonly' : ''}>${_calEsc(alt)}</textarea>
                <div class="cal-cap-fade" aria-hidden="true"></div>
                ${capToggle}
            </div>` : ''}`;
    }
    /* Rebuilds the caption block in place (tab row + both textareas) after a
       tab is added / removed / re-platformed. Preserves any typed-but-unsaved
       text by harvesting the live textarea values before the rebuild. */
    function _calCapBlockRepaint(pid, focusAlt) {
        const card = document.querySelector(`.cal-card[data-pid="${pid}"]`);
        const block = card ? card.querySelector(`[data-capblock="${pid}"]`) : null;
        const post = calState.posts.find(p => p.id === pid);
        if (!card || !block || !post) return;
        const vals = {};
        block.querySelectorAll('textarea[data-fld]').forEach(t => { vals[t.dataset.fld] = t.value; });
        const isBlank = _calIsBlankId(pid);
        const editableText = !_isClientLink || isBlank || _calIsCollabOn();
        block.innerHTML = _calCapBlockHtml(pid, post, editableText, isBlank);
        block.querySelectorAll('textarea[data-fld]').forEach(t => {
            if (vals[t.dataset.fld] != null) t.value = vals[t.dataset.fld];
            _calRefreshCaption(t, false);
        });
        if (focusAlt) {
            const ta = block.querySelector('[data-capwrap="alt"] textarea');
            if (ta) ta.focus();
        }
    }
    function _calCapTabSwitch(pid, which) {
        _calCapTabState.set(pid, which);
        const card = document.querySelector(`.cal-card[data-pid="${pid}"]`);
        if (!card) return;
        card.querySelectorAll('.cal-cap-tab[data-captab]').forEach(b => b.classList.toggle('is-active', b.dataset.captab === which));
        card.querySelectorAll('[data-capwrap]').forEach(w => w.classList.toggle('captab-off', w.dataset.capwrap !== which));
        const ta = card.querySelector(`[data-capwrap="${which}"] textarea`);
        if (ta) _calRefreshCaption(ta, false);
    }
    /* Alt tab: first click switches to it; clicking it again while active
       opens the platform picker (SMM only). The ✕ inside the tab removes. */
    function _calCapAltTabClick(e, pid, btn) {
        if (e && e.target.closest('.cal-cap-tab-x')) return;
        const active = _calCapTabState.get(pid) || 'main';
        if (active !== 'alt') { _calCapTabSwitch(pid, 'alt'); return; }
        if (_isClientLink) return;
        _calCapPlatMenu(e, pid, btn, 'change');
    }
    function _calCapTabAddMenu(e, pid, btn) { _calCapPlatMenu(e, pid, btn, 'add'); }
    /* Platform picker — portaled to <body> with the exact positioning and
       outside-click/scroll/resize close behaviour of the status menus (it
       rides the same _calOpenStatusMenu slot). */
    function _calCapPlatMenu(event, pid, triggerEl, mode) {
        if (event) { event.stopPropagation(); event.preventDefault(); }
        const menuKey = pid + '|altcap';
        if (_calOpenStatusMenu && _calOpenStatusMenu.key === menuKey) { _calCloseStatusMenu(); return; }
        _calCloseStatusMenu();
        const post = calState.posts.find(p => p.id === pid);
        if (!post || !triggerEl) return;
        const current = (mode === 'change') ? _calAltCapPlatKey(pid, post) : '';
        const menu = document.createElement('div');
        menu.className = 'cal-fld-status-menu';
        menu.innerHTML = `<div class="cal-cap-tab-menu-head">${mode === 'change' ? 'Platform for this caption' : 'Add a caption for…'}</div>`
            + CAL_PLATFORMS.map(pl => `<button type="button" class="cal-fld-status-item cal-cap-tab-menu-item${pl.key === current ? ' active' : ''}" onclick="_calCapPlatPick('${pid}','${pl.key}','${mode}')"><span class="cal-cap-tab-menu-ico" style="background:${pl.color}">${pl.icon}</span>${_calEsc(pl.label)}</button>`).join('');
        document.body.appendChild(menu);
        const rect = triggerEl.getBoundingClientRect();
        const menuW = Math.max(menu.offsetWidth, 200);
        const menuH = menu.offsetHeight;
        let left = rect.left;
        const maxLeft = window.innerWidth - menuW - 10;
        if (left > maxLeft) left = maxLeft;
        if (left < 10) left = 10;
        menu.style.left = left + 'px';
        const gap = 5;
        const spaceBelow = window.innerHeight - rect.bottom - 10;
        const spaceAbove = rect.top - 10;
        let top;
        if (menuH <= spaceBelow || spaceBelow >= spaceAbove) {
            /* Math.max floor: with a menu taller than the viewport the inner
               Math.min goes NEGATIVE and the top of the list leaves the screen.
               The CSS cap above makes that unreachable in practice; this is the
               second line of defence, because the cap depends on a stylesheet
               rule and this does not. */
            top = Math.max(10, Math.min(rect.bottom + gap, window.innerHeight - menuH - 10));
        } else {
            top = Math.max(10, rect.top - menuH - gap);
        }
        menu.style.top = top + 'px';
        menu.style.minWidth = '200px';
        requestAnimationFrame(() => menu.classList.add('open'));
        _calOpenStatusMenu = { pid, key: menuKey, comp: 'altcap', el: menu, triggerEl };
    }
    function _calCapPlatPick(pid, key, mode) {
        _calCloseStatusMenu();
        if (!CAL_PLATFORM_BY_KEY[key]) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        if (mode === 'add') {
            _calAltCapDraftPlat.set(pid, key);
            _calCapTabState.set(pid, 'alt');
            _calCapBlockRepaint(pid, true);
            return;
        }
        // Change the platform of an existing alt caption. The draft map is
        // always updated too: while the alt text is unsaved the tab label
        // resolves from the draft, so without this the new pick wouldn't
        // show. Persist only if the row already carries alt data.
        _calAltCapDraftPlat.set(pid, key);
        if (String(post.caption_alt || '').trim() || String(post.caption_alt_platform || '').trim()) {
            post.caption_alt_platform = key;
            if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
            _calPendingEdits[pid].caption_alt_platform = key;
            if (_calSaveTimers[pid]) clearTimeout(_calSaveTimers[pid]);
            _calSaveTimers[pid] = setTimeout(() => { _calSaveTimers[pid] = null; _calFlushCardSave(pid); }, CAL_SAVE_DEBOUNCE_MS);
        }
        _calCapBlockRepaint(pid, false);
    }
    /* Typing in the alt caption also queues the resolved platform key, so the
       label always travels with the text even when the tab is still a local
       draft (platform never explicitly saved). */
    function _calOnAltCapInput(ta) {
        if (_calClientFieldEditBlocked()) return;
        const pid = ta.dataset.pid;
        if (pid) {
            const post = calState.posts.find(p => p.id === pid);
            if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
            _calPendingEdits[pid].caption_alt_platform = _calAltCapPlatKey(pid, post);
        }
        _calOnCaptionInput(ta);
    }
    function _calAltCapRemove(e, pid) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (_isClientLink) return;   // alt-caption editing is SMM-only
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const doRemove = () => {
            const hadSaved = !!String(post.caption_alt || '').trim() || !!String(post.caption_alt_platform || '').trim();
            post.caption_alt = '';
            post.caption_alt_platform = '';
            _calAltCapDraftPlat.delete(pid);
            _calCapTabState.set(pid, 'main');
            if (hadSaved) {
                if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
                _calPendingEdits[pid].caption_alt = '';
                _calPendingEdits[pid].caption_alt_platform = '';
                if (_calSaveTimers[pid]) clearTimeout(_calSaveTimers[pid]);
                _calSaveTimers[pid] = setTimeout(() => { _calSaveTimers[pid] = null; _calFlushCardSave(pid); }, CAL_SAVE_DEBOUNCE_MS);
            } else if (_calPendingEdits[pid]) {
                delete _calPendingEdits[pid].caption_alt;
                delete _calPendingEdits[pid].caption_alt_platform;
            }
            _calCapBlockRepaint(pid, false);
        };
        // Only ask when there's text to lose — removing an empty draft tab
        // shouldn't nag.
        const card = document.querySelector(`.cal-card[data-pid="${pid}"]`);
        const liveTa = card ? card.querySelector('[data-capwrap="alt"] textarea') : null;
        const liveText = (liveTa ? liveTa.value : String(post.caption_alt || '')).trim();
        if (liveText) showConfirm(`Remove the ${_calAltCapLabel(post)} caption?`, 'Its text will be deleted from this post.', doRemove, 'Remove');
        else doRemove();
    }
    /* Per-card color tag — for grouping into batches. Four named colors plus
       the empty "no color" state. Persisted as post.color via the upsert. */
    const CAL_COLORS = ['red', 'amber', 'emerald', 'indigo'];
    const CAL_COLOR_HEX = { red: 'var(--sv-misc-ef4444)', amber: 'var(--sv-misc-f59e0b)', emerald: 'var(--sv-misc-10b981)', indigo: 'var(--sv-misc-6366f1)' };
    function _calPostColor(post) {
        const c = String((post && post.color) || '').toLowerCase();
        return CAL_COLORS.includes(c) ? c : '';
    }
    function _calColorTagHtml(post, ro) {
        const color = _calPostColor(post);
        // Read-only / client view: surface the colour as a passive, read-only
        // dot — but only when the SMM actually tagged the card (no colour, no
        // dot), and never the interactive picker.
        if (ro || _isClientLink) {
            if (!color) return '';
            return `<span class="cal-card-color-tag has-color is-readonly" data-color="${color}" title="Color tag — identifies which batch of content this post belongs to"><span class="cal-card-color-tag-dot"></span></span>`;
        }
        const pid = _calEscAttr(post.id);
        return `<button type="button" class="cal-card-color-tag${color ? ' has-color' : ''}"${color ? ` data-color="${color}"` : ''} title="Tag this card with a color" onclick="_calOpenColorPicker(event,'${pid}')"><span class="cal-card-color-tag-dot"></span></button>`;
    }
    let _calColorPickerOpenFor = null;
    function _calOpenColorPicker(e, pid) {
        if (e) e.stopPropagation();
        if (_calColorPickerOpenFor === pid) { _calCloseColorPicker(); return; }
        _calCloseColorPicker();
        const thumb = document.querySelector(`.cal-card[data-pid="${pid}"] .cal-card-thumb`);
        if (!thumb) return;
        const picker = document.createElement('div');
        picker.className = 'cal-card-color-picker is-open';
        picker.dataset.colorPickerPid = pid;
        picker.innerHTML = `
            <button type="button" class="cal-card-color-pick is-clear" data-color="" title="No color" onclick="_calSetCardColor(event,'${pid}','')"></button>
            ${CAL_COLORS.map(c => `<button type="button" class="cal-card-color-pick" data-color="${c}" style="background:${CAL_COLOR_HEX[c]}" title="${c}" onclick="_calSetCardColor(event,'${pid}','${c}')"></button>`).join('')}`;
        thumb.appendChild(picker);
        _calColorPickerOpenFor = pid;
        setTimeout(() => { document.addEventListener('click', _calMaybeCloseColorPicker, { capture: true }); }, 0);
    }
    function _calMaybeCloseColorPicker(e) {
        if (e.target.closest('.cal-card-color-picker')) return;
        if (e.target.closest('.cal-card-color-tag')) return;
        _calCloseColorPicker();
    }
    function _calCloseColorPicker() {
        document.querySelectorAll('.cal-card-color-picker').forEach(p => p.remove());
        document.removeEventListener('click', _calMaybeCloseColorPicker, { capture: true });
        _calColorPickerOpenFor = null;
    }
    function _calSetCardColor(e, pid, color) {
        if (e) e.stopPropagation();
        if (_isClientLink) return;   // colour tagging is SMM-only
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        post.color = String(color || '');
        if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
        _calPendingEdits[pid].color = post.color;
        // Reflect on every dot for this post (thumb, month, week) without a
        // full re-render so the change feels instant.
        document.querySelectorAll(`.cal-card[data-pid="${pid}"] .cal-card-color-tag`).forEach(tag => {
            if (post.color) { tag.classList.add('has-color'); tag.dataset.color = post.color; }
            else { tag.classList.remove('has-color'); tag.removeAttribute('data-color'); }
        });
        document.querySelectorAll(`.cal-month-pill[data-cal-move="${pid}"], .cal-week-card[data-cal-move="${pid}"]`).forEach(pill => {
            if (post.color) pill.setAttribute('data-color', post.color);
            else pill.removeAttribute('data-color');
        });
        _calCloseColorPicker();
        if (_calSaveTimers[pid]) clearTimeout(_calSaveTimers[pid]);
        _calSaveTimers[pid] = setTimeout(() => { _calSaveTimers[pid] = null; _calFlushCardSave(pid); }, 200);
    }
    /* ── Multi-select bulk colour ──────────────────────────────────────
       The colour select-mode swatch row (clear + the four named colours)
       shown in the bottom select bar; clicking one applies it to every
       selected card. Rendered disabled until at least one card is picked
       (see _calSyncSelectionUI). */
    function _calBulkColorSwatchesHtml() {
        const sw = (c) => `<button type="button" class="cal-bulk-color-swatch${c ? '' : ' is-clear'}" data-bulk-color="${c}"${c ? ` style="background:${CAL_COLOR_HEX[c]}"` : ''} title="${c ? ('Set ' + c) : 'Clear color'}" onclick="_calApplyBulkColor(event,'${c}')" disabled></button>`;
        return sw('') + CAL_COLORS.map(sw).join('');
    }
    /* Apply one colour (or clear) to every selected card at once. Mirrors the
       single-card picker's optimistic-then-persist path, but pools the saves
       (same bound as bulk archive) so a big selection doesn't spike n8n. */
    async function _calApplyBulkColor(e, color) {
        if (e) e.stopPropagation();
        if (_isClientLink) return;   // bulk colour tagging is SMM-only
        const value = CAL_COLORS.includes(color) ? color : '';
        const ids = Array.from(calState.selected).filter(id => id && !_calIsBlankId(id));
        if (!ids.length) return;
        ids.forEach(pid => {
            const post = calState.posts.find(p => p.id === pid);
            if (!post) return;
            post.color = value;
            if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
            _calPendingEdits[pid].color = value;
        });
        // Selection captured — drop out of select mode so the blue overlays and
        // the swatch bar clear, then repaint with the new dots in place.
        calState.selectMode = false;
        calState.selectAction = 'archive';
        calState.selected = new Set();
        calState.lastSel = null;
        document.querySelectorAll('.cal-toolbar .cal-select-btn').forEach(b => b.classList.remove('active'));
        _calRenderBody({ preserveScroll: true });
        // Persist through the same per-card flush the picker uses, pooled.
        ids.forEach(pid => { if (_calSaveTimers[pid]) { clearTimeout(_calSaveTimers[pid]); _calSaveTimers[pid] = null; } });
        const results = await _calRunPooled(ids, CAL_BULK_ARCHIVE_CONCURRENCY, pid => _calFlushCardSave(pid));
        const failed = results.filter(r => r.status === 'rejected').length;
        if (failed) showNotify('Some colors were not saved', failed + ' of ' + ids.length + " couldn't be saved — they'll retry on the next edit or refresh.");
        else showNotify('Color updated', ids.length + ' post' + (ids.length === 1 ? '' : 's') + ' set to ' + (value || 'no') + ' color.');
    }
    function _calPlatformsStripHtml(post, ro) {
        const slug = calClientSlug(calState.client);
        const enabled = _calEnabledPlatforms(slug);
        if (!enabled.length) return '';
        const active = new Set(_calPostPlatforms(post));
        // Client view shows only the selected platforms — no muted icons
        // for platforms that aren't part of this post. Drop the whole
        // strip if the post hasn't been tagged with any.
        const keys = ro ? enabled.filter(k => active.has(k)) : enabled;
        if (!keys.length) return '';
        const pid = _calEscAttr(post.id);
        const cells = keys.map(k => {
            const p = CAL_PLATFORM_BY_KEY[k];
            if (!p) return '';
            const on = active.has(k);
            const handler = ro ? '' : ` onclick="_calTogglePostPlatform(event,'${pid}','${k}')"`;
            const disabled = ro ? ' disabled' : '';
            const aria = `${p.label}${on ? ' (selected)' : ''}`;
            return `<button type="button" class="cal-card-platform-btn${on ? ' is-active' : ''}" data-platform="${k}" data-platform-pid="${pid}" title="${_calEscAttr(aria)}" aria-label="${_calEscAttr(aria)}"${handler}${disabled}>${p.icon}</button>`;
        }).join('');
        return `<div class="cal-card-platforms" data-platforms-strip="${pid}">${cells}</div>`;
    }
    function _calTogglePostPlatform(e, pid, key) {
        if (e) e.stopPropagation();
        if (_isClientLink) return;   // per-card platform tagging is SMM-only (client view is read-only)
        if (!CAL_PLATFORM_BY_KEY[key]) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const current = _calPostPlatforms(post);
        const i = current.indexOf(key);
        if (i >= 0) current.splice(i, 1); else current.push(key);
        const csv = current.join(',');
        post.platforms = csv;
        // Removing YouTube ends any title review on this card: title_status is
        // meaningful only on an engaged YouTube card, so leaving it set strands
        // an unreachable review state (it drops from every queue but persists in
        // the data, and would resurrect if YouTube were re-added). Clear the
        // status — the title_tweaks comment history is kept — and persist the
        // cleared value alongside the platform change.
        const _titleStranded = (key === 'youtube' && i >= 0 && _calTitleEngaged(post));
        if (_titleStranded) post.title_status = '';
        // Reflect on the strip without redrawing the whole card so the
        // toggle feels instant. Other strips for this post (if any) get
        // refreshed too.
        document.querySelectorAll(`[data-platforms-strip="${pid}"] [data-platform="${key}"]`).forEach(btn => {
            const on = current.includes(key);
            btn.classList.toggle('is-active', on);
            const p = CAL_PLATFORM_BY_KEY[key];
            const aria = `${p.label}${on ? ' (selected)' : ''}`;
            btn.setAttribute('title', aria);
            btn.setAttribute('aria-label', aria);
        });
        // Toggling YouTube while title review is on flips whether the title
        // status pill should show — that's structural (a pill added/removed),
        // which the in-place strip tweak above can't do, so redraw the card.
        // Also redraw when we just cleared a stranded title (its pill must go).
        if (key === 'youtube' && (_calIsTitleReviewOn() || _titleStranded)) {
            try { _calRenderBody({ preserveScroll: true }); } catch {}
        }
        if (_titleStranded) { try { showToast('Title review ended — YouTube removed from this card.'); } catch {} }
        // Persist via the usual debounced save path so the platforms field
        // rides on the next upsert with the rest of the post.
        if (!_calPendingEdits[pid]) _calPendingEdits[pid] = {};
        _calPendingEdits[pid].platforms = csv;
        if (_titleStranded) _calPendingEdits[pid].title_status = '';
        if (_calSaveTimers[pid]) clearTimeout(_calSaveTimers[pid]);
        _calSaveTimers[pid] = setTimeout(() => { _calSaveTimers[pid] = null; _calFlushCardSave(pid); }, CAL_SAVE_DEBOUNCE_MS);
    }
    function openCalPlatformsEditor() {
        if (_isClientLink) return;   // platform set is SMM-only (client sees the icons, can't edit them)
        if (!calState.client) return;
        const slug = calClientSlug(calState.client);
        const enabled = new Set(_calEnabledPlatforms(slug));
        const ovl = document.getElementById('calImportOverlay');
        const modal = document.getElementById('calImportModal');
        if (!ovl || !modal) return;
        ovl.classList.add('open');
        document.body.classList.add('cal-modal-open');
        const rowsHtml = CAL_PLATFORMS.map(p => `
            <label class="cal-platforms-row" data-platform-row="${p.key}">
                <input type="checkbox" data-platform-edit="${p.key}"${enabled.has(p.key) ? ' checked' : ''}>
                <span class="cal-platforms-row-icon" style="background:${p.color}">${p.icon}</span>
                <span class="cal-platforms-row-label">${_calEsc(p.label)}</span>
            </label>`).join('');
        modal.innerHTML = `
            <div class="cal-import-head">
                <button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                <h3>Platform</h3>
                <p>Pick which platforms appear as icons on every <strong>${_calEsc(calState.client)}</strong> card. Click an icon on a card to mark that the post is going to that platform.</p>
            </div>
            <div class="cal-import-body">
                <div class="cal-platforms-grid">${rowsHtml}</div>
            </div>
            <div class="cal-import-foot">
                <button class="cal-import-btn-ghost" onclick="closeCalImport()">Cancel</button>
                <button class="cal-import-btn-primary" onclick="_calSavePlatformsSelection()">Save</button>
            </div>`;
    }
    function _calSavePlatformsSelection() {
        const modal = document.getElementById('calImportModal');
        if (!modal || !calState.client) return;
        const slug = calClientSlug(calState.client);
        const picked = [];
        modal.querySelectorAll('input[data-platform-edit]').forEach(cb => {
            if (cb.checked) picked.push(cb.getAttribute('data-platform-edit'));
        });
        const apply = () => {
            _calSetEnabledPlatforms(slug, picked);   // localStorage first-paint cache
            // Persist to the shared settings row so the client view + other SMM devices
            // pick up the platform icons (was localStorage-only, so the client saw none).
            if (slug === calClientSlug(calState.client)) _calSaveSettings({ enabled_platforms: picked });
            closeCalImport();
            try { _calRenderBody({ preserveScroll: true }); } catch {}
        };
        // Saving an EMPTY set hides the platform strip AND the per-card platform
        // toggles on every card — on the client view and all devices — and it's
        // recoverable only by re-opening this editor. Confirm before wiping so a
        // stray "Save" with nothing ticked can't silently strip every card. The
        // platforms modal stays open behind the confirm, so Cancel returns the
        // user to their selection.
        if (!picked.length) {
            showConfirm('Hide all platform icons?',
                'No platforms are selected, so every card will show no platform tags — on the client view and all devices — until you pick at least one again here.',
                apply, 'Hide all');
            return;
        }
        apply();
    }

    const calState = {
        view: 'organizer',
        client: null,
        posts: [],
        loading: false,
        error: null,
        monthCursor: null,
        weekCursor: null,
        previewId: null,
        embedded: false,
        zoom: 'default',
        selectMode: false,
        selectAction: 'archive',
        selected: new Set(),
        lastSel: null,
        monthFilter: null,
        statusFilter: 'all',
        // How the Sheet strip is ordered: 'manual' (the drag-and-drop order
        // stored in order_index — the default and the only mode that existed
        // before) or 'date' (auto-organized by scheduled date). See
        // _calOrganizerSort: 'date' is a VIEW-ONLY sort. It never writes
        // order_index, so flipping back restores the manual order untouched.
        sortMode: 'manual',
        settings: { collab_mode: false, title_review: false },
    };

    /* Per-client calendar settings ride on a sentinel row inside the same
       Google Sheet tab the posts live on, written via the existing
       calendar-upsert-post webhook. id is fixed so the row is found/updated
       in place; the JSON payload lives in the `caption` cell (the only
       cell wide enough to hold structured data without a schema change).
       The row is split off from `json.posts` immediately on load so it never
       renders, never gets archived, and never participates in the
