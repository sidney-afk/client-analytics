    /* Returns the comments array for a given component. Falls back to the
       legacy `comments` field for any component when the sub-arrays haven't
       been seeded yet (defensive). */
    function _calCommentsFor(post, comp) {
        if (!post) return [];
        if (comp === 'graphic') return Array.isArray(post.graphic_comments) ? post.graphic_comments : [];
        if (comp === 'caption') return Array.isArray(post.caption_comments) ? post.caption_comments : [];
        if (comp === 'title') return Array.isArray(post.title_comments) ? post.title_comments : [];
        if (Array.isArray(post.video_comments)) return post.video_comments;
        return Array.isArray(post.comments) ? post.comments : [];
    }
    /* Per-message audience + type, with back-compat defaults for legacy rows
       (which carry neither field):
         · audience — who may see the thread. Messages authored by the TEAM
           (Kasper or the SMM) default to 'internal' (team-only); a client's
           own message defaults to 'client'. This default doubles as the safety
           net for historical review-tab change-requests that were saved with no
           audience tag: an SMM tweak must never be client-visible, so an
           untagged team message is internal by default. Anything genuinely
           meant for the client carries an explicit audience:'client', which
           always wins over the default. A thread's audience is set on its ROOT
           message; replies inherit it (see _calCommentsForView).
         · is_tweak — whether the message is a change-request that flips the
           component to Tweaks Needed and pings the editor. Every legacy
           message was a tweak, so absent the field we treat it as true. */
    function _calMsgAudience(c) {
        if (!c) return 'client';
        if (c.audience === 'internal' || c.audience === 'client') return c.audience;
        return (c.role === 'kasper' || c.role === 'smm') ? 'internal' : 'client';
    }
    function _calMsgIsTweak(c) {
        if (!c) return false;
        if (typeof c.is_tweak === 'boolean') return c.is_tweak;
        return true;
    }
    /* Revision number for a NEW change-request on this component: the Nth tweak
       (1-based), counting existing change-requests on the same component. Stamped
       on the tweak at creation so the UI can show "Tweak #2 / #3 …" — the
       "leave no room for error" history the title review (and every component)
       wants, without re-deriving it on every render. */
    function _calNextTweakRound(post, comp) {
        const list = _calCommentsFor(post, comp);
        if (!Array.isArray(list)) return 1;
        return list.filter(c => c && _calMsgIsTweak(c) && !c.deleted).length + 1;
    }
    /* Render-side wrapper: same data as _calCommentsFor, but the client-link
       view only ever sees threads addressed to the client. A thread's audience
       lives on its ROOT message and replies inherit it. We also hard-hide
       anything Kasper authored, belt-and-braces, so the client can never see
       internal review chatter even on a mis-tagged thread. Save/update paths
       keep using _calCommentsFor (unfiltered) — we hide from this one
       audience, we never *drop* messages from the row. */
    function _calCommentsForView(post, comp) {
        let list = _calCommentsFor(post, comp);
        if (!Array.isArray(list)) return [];
        // Tombstoned (soft-deleted) comments stay in storage so the delete
        // propagates and can't be resurrected by a stale merge or a laggy
        // poll, but they never render or count for anyone. `hidden` is the same
        // idea for audit-suppressed comments (e.g. legacy cross-client feedback
        // that bled onto the wrong client's row): the text is preserved in the
        // sheet (hide-not-delete) but never shown or counted. The save path uses
        // _calCommentsFor (unfiltered) so these are never written away.
        list = list.filter(c => c && (!c.deleted || c.canonical) && !c.hidden);
        if (!_isClientLink) return list;
