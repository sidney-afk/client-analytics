    function _calCapSecMeta(which, p) {
        const textIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>';
        if (which !== 'alt') return { label: 'Main caption', ico: textIco, color: 'var(--sv-fg-111110)' };
        const key = String((p && p.caption_alt_platform) || '').trim().toLowerCase();
        const pl = CAL_PLATFORM_BY_KEY[key];
        return { label: (pl ? pl.label : 'Alt') + ' caption', ico: pl ? pl.icon : textIco, color: pl ? pl.color : 'var(--sv-fg-111110)' };
    }
    function _calReviewCapCardHtml(which, p, text) {
        const m = _calCapSecMeta(which, p);
