        // audience (replies point straight at the root via parent_id).
        const byId = new Map();
        for (const c of list) if (c && c.id) byId.set(c.id, c);
        const rootAudience = (c) => {
            const root = (c.parent_id && byId.has(c.parent_id)) ? byId.get(c.parent_id) : c;
            return _calMsgAudience(root);
        };
        return list.filter(c => {
            if (!c) return false;
            if (c.role === 'kasper') return false;   // never expose Kasper authorship
            return rootAudience(c) === 'client';      // only client-addressed threads
        });
