     * One assignment point for the same reason `_calSetClient` is one
     * assignment point (see the deep-link focus tests, "seven assignments,
     * one of them remembering is not a rule"): a future call site that sets
     * `_calFocusRequest` directly gets none of this, silently, and this
     * exact feature has already broken twice from precisely that shape of
     * miss. */
    function _calSetFocusRequest(req) {
        _calFocusRequest = req;
        _calFocusRequestLoadFailed = false;
        if (req && req.cardId) {
            showToast('Opening linked card…', { duration: CAL_LOAD_TIMEOUT_MS + 1000 });
        }
    }
    /* Codex review, PR for item 176 (fourth pass): showToast/hideToast are a
     * SINGLE shared instance app-wide, so a bare hideToast() call here would
     * just as happily dismiss an unrelated toast that legitimately replaced
     * "Opening linked card…" in the interim — an Undo prompt, a save
     * confirmation — if that toast is still the one on screen when this
     * runs. Every hideToast() this feature calls goes through here instead,
     * checking the currently-shown toast is still OURS before touching it.
     *
     * Fifth pass: the first version of this check queried the DOM globally
     * (`document.querySelector('.sv-toast-msg')`), which is exactly wrong
     * during hideToast's own 220ms fade — it clears `_toastEl` and the
     * `show` class immediately but leaves the OLD element in the document
     * for that setTimeout, while showToast() appends the NEW element right
     * away with no such delay. A global query can return that dying old
     * element instead of the live one, so this checks `_toastEl` itself —
     * the one variable that is always the CURRENT toast, never a fading
     * leftover — not the DOM at large. */
    function _calHideOwnToast(expectedPrefix) {
        const el = _toastEl && _toastEl.querySelector('.sv-toast-msg');
        if (el && el.textContent && el.textContent.indexOf(expectedPrefix) === 0) hideToast();
    }
    /* A #calendar/<slug> deep link (e.g. a link handed over by another SMM)
       whose client wasn't in the allowlist yet when the fast-path router ran:
       WL_CLIENT_NAMES is seed-only until fetchAll folds in the Clients Info
       sheet, so a sheet-only client's slug can't be matched synchronously.
       mountCalendar holds the strip on its loader instead of opening the wrong
       last-used client, and _calResolvePendingDeepLink (run after fetchAll)
       opens the real client as a tab. Shape: { slug, cardId }. */
    let _calPendingDeepLink = null;
    /* Codex review on PR for OPEN_REPAIRS item 176: a card link for a
     * sheet-only client (not in the WL_CLIENT_NAMES seed) is recognized here,
     * before the roster that would resolve it to _calFocusRequest has even
     * loaded — so without its own announcement, exactly these links kept the
     * silence item 176 was meant to end, for as long as the ESSENTIALS read
     * takes instead of the calendar read. Same discipline as
     * _calSetFocusRequest, and the same reason: one assignment site. */
    function _calSetPendingDeepLink(v) {
        _calPendingDeepLink = v;
        if (v && v.cardId) {
            showToast('Opening linked card…', { duration: CAL_LOAD_TIMEOUT_MS + 1000 });
        }
    }
    /* Codex review, PR for item 176 (seventh pass): navTo is not the only
     * route out of the calendar. `render()` (client-profile tab switches)
     * and the `state.client` popstate branch both explicitly bypass navTo
     * — see their own "render() bypasses navTo()" / "never reaches navTo"
     * comments — while still tearing down _calV2Teardown right beside where
     * this is now called from too. One function, called from every exit
     * route that already shares that teardown line, for the same reason
     * _calSetClient owns every client assignment: a fourth exit path that
     * calls _calV2Teardown without calling this would get none of it,
     * silently — exactly how this pass's finding happened to the first two. */
    function _calAbandonLinkOnCalendarExit(stillOnCalendar) {
        if (stillOnCalendar) return;
        if ((_calFocusRequest && _calFocusRequest.cardId) || (_calPendingDeepLink && _calPendingDeepLink.cardId)) {
            _calHideOwnToast('Opening linked card');
        }
        _calSetFocusRequest(null);
        _calSetPendingDeepLink(null);
    }
    /* Card ids whose next save must NOT push back to Linear — used when a
       status was just pulled FROM Linear, so we don't bounce it back. */
    const _calNoLinearPush = new Set();
    /* Brand-new cards whose first save failed. They're kept on screen with a
       "Save failed" chip (instead of being deleted) and preserved through
       background polls, so a failed create is a visible, retryable state
       rather than a silent vanish. Cleared on a successful save or archive. */
    const _calFailedNewCards = new Set();

    function calClientSlug(name) { return wlNormalizeClient(name); }
    /* Standalone Content Calendar only: keep the browser URL in step with the
       client whose calendar is showing, as #calendar/<slug>. The hash router
       already lands on the right client from this shape (see the
       'calendar/' branch in the boot router), so copying the URL bar — not
       just the share button — hands someone the exact client's calendar.
       replaceState (not push) so flipping between client tabs doesn't pile up
       back-button history. The embedded calendar inside a client profile owns
       its own #<clientName> URL, so we never touch it. A live #calendar/<slug>/<cardId>
       card deep link is left intact when it already points at this client. */
    function _calSyncUrlClient() {
        if (calState.embedded || currentNav !== 'calendar') return;
        const base = location.pathname + location.search.replace(/#.*$/, '');
        if (!calState.client) {
            history.replaceState({ nav: 'calendar', client: null }, '', base + '#calendar');
            return;
        }
        const slug = calClientSlug(calState.client);
        const rawHash = location.hash.replace(/^#/, '');
        if (rawHash.startsWith('calendar/' + slug + '/')) return; // keep the card deep link
        history.replaceState({ nav: 'calendar', client: null }, '', base + '#calendar/' + slug);
    }
