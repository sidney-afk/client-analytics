        // a fresh draft tab.
        const saved = String((post && post.caption_alt_platform) || '').trim().toLowerCase();
        const hasText = !!String((post && post.caption_alt) || '').trim();
        if (hasText && saved) return saved;
        return _calAltCapDraftPlat.get(pid) || saved || 'linkedin';
    }
    function _calCapBlockHtml(pid, p, editableText, isBlank) {
        // `pid` arrives attr-escaped from _calCardHtml (same convention as
