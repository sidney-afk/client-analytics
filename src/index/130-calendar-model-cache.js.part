        if (active === 'alt' && !hasAlt) active = 'main';
        const platKey = _calAltCapPlatKey(pid, p);
        const platLabel = (CAL_PLATFORM_BY_KEY[platKey] || {}).label || 'Alt';
        const chevIco = `<svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5L5 6.5l3-3"/></svg>`;
        const xIco = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg>`;
        const capToggle = `<button type="button" class="cal-cap-toggle" tabindex="-1" hidden onclick="_calToggleCaption(this)" title="Expand / collapse"><span class="cal-cap-toggle-txt">Show more</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l5 5 5-5"/></svg></button>`;
        let tabsHtml = '';
        if (hasAlt) {
            tabsHtml = `<div class="cal-cap-tabs">
