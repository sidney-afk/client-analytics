                    <div class="sv-skeleton-stack">
                        ${_svSkel('sv-skeleton-line', 'width:' + (i === 1 ? '56%' : '72%') + ';')}
                        ${_svSkel('sv-skeleton-line', 'width:88%;')}
                        ${_svSkel('sv-skeleton-line', 'width:' + (i === 2 ? '48%' : '64%') + ';')}
                    </div>
                    ${_svSkel('sv-skeleton-pill', 'width:96px;height:30px;')}
                </div>`).join('')}
            </div>
        </div>`;
    }
    function _svSamplesSkeletonHtml(label) {
