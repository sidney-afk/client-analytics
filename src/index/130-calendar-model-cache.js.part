       for free. */
    async function _calToggleTitleReviewMode() {
        if (_isClientLink) return;   // kebab modes are SMM-only
        const slug = calClientSlug(calState.client);
        const next = !_calIsTitleReviewOn();
        const savePromise = _calSaveSettings({ title_review: next });
        _calSyncTitleReviewSwitch();
        try { _calRenderBody({ preserveScroll: true }); } catch {}
