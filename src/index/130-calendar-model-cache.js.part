    const _calCapTabState = new Map();     // pid -> 'main' | 'alt' (session-local active tab)
    const _calAltCapDraftPlat = new Map(); // pid -> platform picked for an alt tab whose text hasn't been saved yet
    function _calAltCapLabel(post) {
        const key = String((post && post.caption_alt_platform) || '').trim().toLowerCase();
        const p = CAL_PLATFORM_BY_KEY[key];
