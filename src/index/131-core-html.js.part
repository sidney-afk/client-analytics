    const SV_DRAFT_TTL_MS = 7 * 24 * 60 * 60 * 1000;
    const SV_DRAFT_MAX_CHARS = 100000;
    const SV_DRAFT_MAX_ENTRIES = 60;
    function _svDraftActive() { return !_isClientLink; }
    function _svDraftKey(surface, client, card, field) {
        return SV_DRAFT_PREFIX + [surface, client, card, field].map(x => encodeURIComponent(String(x == null ? '' : x))).join('|');
