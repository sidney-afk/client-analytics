    function _svLoadingSkeletonHtml(kind, opts) {
        opts = opts || {};
        if (kind === 'client-verify') return _svClientVerifySkeletonHtml();
        if (kind === 'client-brief') return _svClientBriefSkeletonHtml(opts.name || '');
        if (kind === 'analytics' || kind === 'analytics-overview') return _svAnalyticsSkeletonHtml(opts.name || '', 'overview');
        if (kind === 'analytics-client') return _svAnalyticsSkeletonHtml(opts.name || '', 'client');
        if (kind === 'workload') return _svWorkloadSkeletonHtml();
        if (kind === 'samples') return _svSamplesSkeletonHtml(opts.label);
        if (kind === 'samples-sheet') return _svSamplesSheetSkeletonHtml(opts.label);
        if (kind === 'samples-review') return _svSamplesReviewSkeletonHtml(opts.label);
