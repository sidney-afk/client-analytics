    }
    function _calBuildUrgentPatch(post, ping) {
        const issue = String((ping && ping.issue) || (post && post.linear_issue_id) || '').trim();
        return {
            id: post.id,
            video_urgent_pinged_at: String((ping && ping.sentAt) || new Date().toISOString()),
            video_urgent_status_at: String((post && post.video_status_at) || ''),
            video_urgent_issue: issue,
            video_urgent_editor: String((ping && ping.editor) || '')
        };
    }
    async function _calPersistUrgentSentForPost(clientOrSlug, post, ping) {
        if (!post || !post.id) return null;
        const slug = calClientSlug(clientOrSlug);
        const patch = _calBuildUrgentPatch(post, ping || {});
        const resp = await fetch(CALENDAR_UPSERT_EF_URL, {
            method: 'POST',
            headers: _calUpsertHeaders('ui', CALENDAR_UPSERT_EF_URL),
            body: JSON.stringify({ client: slug, post: patch, comments_base_at: '' })
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok || !json || !json.ok) throw new Error((json && json.error) || ('HTTP ' + resp.status));
        const echo = (json && json.post && typeof json.post === 'object') ? json.post : patch;
        Object.assign(post, patch, echo);
        if (!String(post.video_status_at || '').trim() && String(post.video_urgent_status_at || '').trim()) {
            post.video_status_at = post.video_urgent_status_at;
        }
        return echo;
    }
    /* ── The Kasper half of the ping ──────────────────────────────────────
       Same four-column marker shape as the video ping, one card-level marker
       instead of a per-component one, because the ping means "this CARD is
       waiting on you" and Kasper's review card covers every component at once.
       `kasper_urgent_comp` records which pill fired it purely so the round key
       has a component to belong to (see _calKasperUrgentActive). */
    function _calBuildKasperUrgentPatch(post, comp, ping) {
        return {
            id: post.id,
            kasper_urgent_pinged_at: String((ping && ping.sentAt) || new Date().toISOString()),
            kasper_urgent_status_at: String((post && post[comp + '_status_at']) || ''),
            kasper_urgent_comp: comp,
            kasper_urgent_by: String((ping && ping.by) || _calUrgentActorName())
        };
    }
    function _calUrgentActorName() {
        try {
            if (_isClientLink) return 'Client';
            if (svRoute.hash() === '#kasper' || new URLSearchParams(svRoute.search()).get('Kasper') === '1') return 'Kasper';
        } catch (e) {}
        return 'SyncView';
    }
    /* Kasper works in his own tab, on a different device, from the SMM who
       fired the ping — so the marker has to be on the ROW, not in this session.
       Without the write the DM would arrive and his Urgent section would still
       be empty, which is the exact failure the editor ping's marker was added
       for on 2026-07-10. */
    async function _calPersistKasperUrgentForPost(clientOrSlug, post, comp, ping) {
        if (!post || !post.id) return null;
        const slug = calClientSlug(clientOrSlug);
        const patch = _calBuildKasperUrgentPatch(post, comp, ping || {});
        const resp = await fetch(CALENDAR_UPSERT_EF_URL, {
            method: 'POST',
            headers: _calUpsertHeaders('ui', CALENDAR_UPSERT_EF_URL),
            body: JSON.stringify({ client: slug, post: patch, comments_base_at: '' })
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok || !json || !json.ok) throw new Error((json && json.error) || ('HTTP ' + resp.status));
        const echo = (json && json.post && typeof json.post === 'object') ? json.post : patch;
        Object.assign(post, patch, echo);
        // Mirror of the video ping's back-fill: on a row whose component has no
        // change-stamp yet, adopt the one the server settled on so the local
        // copy agrees with what the round key will compare against next paint.
        if (!String(post[comp + '_status_at'] || '').trim() && String(post.kasper_urgent_status_at || '').trim()) {
            post[comp + '_status_at'] = post.kasper_urgent_status_at;
        }
        // A card with two components at Kasper Approval renders TWO buttons, and
        // the dispatcher only disables the one that was clicked. Without this the
        // sibling stays live and can fire a duplicate DM before the next render.
        // (Codex P2 on PR 1370 — the samples path already did this.)
        try { _calUpdateCardStatusDisplay(post.id); } catch (e) {}
        return echo;
    }
    /* Where the DM points: Kasper's Review tab, which lists calendar cards and
       samples together. Older messages that still say #kasper/samples open
       Review too (see _kasperResolveSubtab). */
    function _calKasperReviewUrl(surface) {
        return 'https://syncview.synchrosocial.com/#kasper';
    }
    /* Ping Kasper about a card parked at Kasper Approval. Reuses the SAME
       confirm → POST → latch dispatch as the editor ping; only the flavour
       differs. */
    async function _calSendKasperUrgentSlack(event, pid) {
        if (event) { event.preventDefault(); event.stopPropagation(); }
        // Live re-read, not the boot cache: the switch must stop an open tab.
        // Pass the CLIENT -- a bare call asks the roster about nobody, which
        // fails closed on every click of a button that rendered fine.
        if (!(await _kasperUrgentPingOnLive(calState && calState.client))) { showNotify('Urgent pings are off', 'The Kasper urgent ping is currently disabled. Nothing was sent.'); return; }
        const btn = (event && event.currentTarget) ? event.currentTarget : null;
        if (btn && btn.dataset.urgentSent === '1') {
            showNotify('Already sent', _urgentKind('kasper').alreadySent);
            return;
        }
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const comp = _calKasperUrgentPingComp(post);
        if (!comp) {
            showNotify('Not waiting on Kasper', 'Nothing on this card is at Kasper Approval right now, so there is nothing to ping him about.');
            return;
        }
        _calUrgentSlackDispatch(btn, String(post.linear_issue_id || '').trim(), String(calState.client || '').trim(), post.name, {
            kind: 'kasper',
            payload: { url: _calKasperReviewUrl('calendar'), surface: 'calendar', component: comp },
            persist: (ping) => _calPersistKasperUrgentForPost(calState.client, post, comp, ping)
        });
    }
    /* Which component the ping is recorded against. The button can be clicked
       on any pill at Kasper Approval, but a card with several of them still
       gets ONE marker — first in component order wins, so two SMMs clicking
       different pills on the same card cannot produce two different rounds. */
    function _calKasperUrgentPingComp(post) {
        return CAL_REVIEW_COMPONENTS.find(c => _calShowKasperUrgent(post, c)) || '';
    }
    function _calSendUrgentSlack(event, pid) {
        if (event) { event.preventDefault(); event.stopPropagation(); }
        const btn = (event && event.currentTarget) ? event.currentTarget : null;
        if (btn && btn.dataset.urgentSent === '1') {
            showNotify('Already sent', 'An urgent ping for this video was already sent in this session.');
            return;
        }
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const issue = String(post.linear_issue_id || '').trim();
        if (!String(post.video_deliverable_id || '').trim()) {
            showNotify(URGENT_EDITOR_NEEDS_NATIVE.title, URGENT_EDITOR_NEEDS_NATIVE.text);
            return;
        }
        const sourceClient = calState.client;
        _calUrgentSlackDispatch(btn, issue, String(sourceClient || '').trim(), post.name, {
            native: String(post.video_deliverable_id || '').trim() ? { action: 'native_urgent_dispatch', client_slug: calClientSlug(calState.client),
                deliverable_id: _writeUiNativeId(post, 'video'), card_id: String(post.id), surface: 'calendar', video_status_at: String(post.video_status_at || '') } : null,
            currentClientSlug: () => calClientSlug(calState.client),
            currentPost: () => calState.posts.find(p => p.id === pid),
            persist: (ping) => _calPersistUrgentSentForPost(sourceClient, post, ping)
        });
    }
    /* Four staff surfaces share confirmation and delivery handling. Native
       identity goes only to the authenticated gateway; legacy URL-only cards
       are refused before any request (B2 retired the send-urgent-slack webhook);
       the Kasper flavour keeps its own webhook.
       A local hold prevents blind resubmission after uncertain native delivery.
       It is not a global delivery receipt. */
    async function _calCheckQueuedUrgent(btn, native, opts, attemptKey, holdValue, issue) {
        try {
            const headers = _syncviewEfHeaders({ 'Content-Type': 'application/json',
                apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY }, WRITE_UI_PRODUCTION_WRITE_URL);
            const reply = await fetch(WRITE_UI_PRODUCTION_WRITE_URL, { method: 'POST', headers,
                body: JSON.stringify(Object.assign({}, native, { action: 'native_urgent_status' })), signal: AbortSignal.timeout(10000) });
            const status = await reply.json().catch(() => null);
            if (!reply.ok || !status || status.ok !== true) throw new Error('urgent_status_unavailable');
            if (status.delivery === 'sent' && status.sent === true) {
                try { if (localStorage.getItem(attemptKey) === holdValue) localStorage.removeItem(attemptKey); } catch (e) {}
                if (btn) { btn.disabled = true; btn.textContent = 'Sent'; btn.dataset.urgentSent = '1'; btn.classList.add('is-sent'); }
                if (opts && typeof opts.persist === 'function') await opts.persist({ sentAt: new Date().toISOString(), issue, editor: '' });
                showNotify('Urgent ping sent', 'The queued urgent ping was delivered to #video-editing.'); return;
            }
            if (status.delivery === 'absent') {
                try { if (localStorage.getItem(attemptKey) === holdValue) localStorage.removeItem(attemptKey); } catch (e) {}
                if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                showNotify('Urgent ping not queued', 'Nothing was sent or remains queued for this round. You can send a new urgent ping.'); return;
            }
            if (status.delivery === 'pending' || status.delivery === 'retryable' || status.delivery === 'sending') {
                if (btn) { btn.disabled = true; btn.textContent = 'Queued'; }
                showNotify('Urgent ping queued', 'The urgent ping is queued for #video-editing. It is not marked Sent until Slack returns a receipt.'); return;
            }
            if (btn) { btn.disabled = true; btn.textContent = 'Check delivery'; }
            showNotify('Check delivery', 'The queued urgent ping needs an operator check before another message can be sent. Check #video-editing manually.');
        } catch (e) {
            if (btn) { btn.disabled = true; btn.textContent = 'Check delivery'; }
            showNotify('Check delivery', 'The queued urgent ping status could not be read. Check #video-editing manually before sending another message.');
        }
    }

    function _calUrgentSlackDispatch(btn, issue, client, name, opts) {
        const kind = (opts && opts.kind === 'kasper') ? 'kasper' : 'editor';
        const spec = _urgentKind(kind);
        const native = kind === 'editor' && opts && opts.native;
        // B2: the editor ping has no non-native lane any more. Refuse before any
        // confirm or request, visibly, so no caller can reach a legacy webhook.
        if (kind === 'editor' && !native) {
            showNotify(URGENT_EDITOR_NEEDS_NATIVE.title, URGENT_EDITOR_NEEDS_NATIVE.text); return;
        }
        const roundTime = native ? Date.parse(native.video_status_at) : NaN;
        const attemptKey = native ? 'syncview-native-urgent:v1:' + JSON.stringify(Object.assign({}, native,
            { video_status_at: Number.isFinite(roundTime) ? new Date(roundTime).toISOString() : native.video_status_at })) : '';
        let storageUnavailable = false;
        const retainedAttempt = () => {
            if (!native) return false;
            try { return !!localStorage.getItem(attemptKey); } catch (e) { storageUnavailable = true; return true; }
        };
        const showUnknown = () => {
            if (btn) { btn.disabled = true; btn.textContent = 'Check delivery'; }
            showNotify(storageUnavailable ? 'Delivery status unavailable' : 'Check delivery', storageUnavailable
                ? 'This browser cannot read its saved delivery status. Nothing new was sent. Check #video-editing manually before sending another message.'
                : 'An urgent ping may already have been sent for this round. Check #video-editing manually before sending another message.');
        };
        if (native && (typeof _isClientLink !== 'undefined' && _isClientLink)) {
            showNotify('Staff sign-in required', 'Sign in as staff to send an urgent ping.'); return;
        }
        if (retainedAttempt()) {
            let held = '';
            try { held = localStorage.getItem(attemptKey) || ''; } catch (e) {}
            let queued = null;
            try { queued = JSON.parse(held); } catch (e) {}
            if (queued && queued.state === 'delivery_queued') {
                _calCheckQueuedUrgent(btn, native, opts, attemptKey, held, issue); return;
            }
            showUnknown(); return;
        }
        showConfirm(
            spec.confirmTitle,
            native
                ? 'This posts an urgent tweak message in #video-editing and tags the currently assigned editor. Only use it for tweaks that need attention today.'
                : spec.confirmBody,
            () => {
                if (retainedAttempt()) { showUnknown(); return; }
                if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
                (async () => {
                    let attempted = false, knownNotSent = false, holdWritten = false, holdValue = '', nativeLane = !!native;
                    const releaseOwnHold = () => {
                        try {
                            if (holdWritten && localStorage.getItem(attemptKey) === holdValue) localStorage.removeItem(attemptKey);
                        } catch (ignore) {}
                    };
                    try {
                        // SLACK FIRST, for BOTH flavours: persist the display marker only
                        // after delivery succeeds. Native editor delivery additionally
                        // requires a receipt and retains queued or uncertain attempts.
                        // The pre-dialog read is not enough: the confirm can sit
                        // open indefinitely while the flag is flipped off. Ask
                        // again HERE, before the first side effect, or the
                        // rollback still cannot stop an open tab. (Codex P1 r3.)
                        if (kind === 'kasper' && typeof _kasperUrgentPingOnLive === 'function'
                            && !(await _kasperUrgentPingOnLive(client))) {
                            if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                            showNotify('Urgent pings are off', 'The Kasper urgent ping was disabled while this dialog was open. Nothing was saved and nothing was sent.');
                            return;
                        }
                        let resp;
                        if (nativeLane) {
                            // Retain before transport. This is a local recovery hold,
                            // not a cross-device delivery or exactly-once receipt.
                            holdValue = JSON.stringify({ state: 'delivery_unknown', attempt_id: crypto.randomUUID() });
                            localStorage.setItem(attemptKey, holdValue);
                            holdWritten = true;
                            const headers = _syncviewEfHeaders({ 'Content-Type': 'application/json',
                                apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY }, WRITE_UI_PRODUCTION_WRITE_URL);
                            const request = { method: 'POST', headers, body: JSON.stringify(native), signal: AbortSignal.timeout(30000) };
                            attempted = true;
                            resp = await fetch(WRITE_UI_PRODUCTION_WRITE_URL, request);
                        } else resp = await fetch(spec.url(), {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(Object.assign({ issue, client, name: String(name || '') }, (opts && opts.payload) || {}))
                        });
                        let j = null;
                        try { j = await resp.json(); } catch {}
                        /* THE PRE-DEPLOYMENT 400 IS THE LEGACY LANE, NOT A DELIVERY
                           DOUBT. This file ships to Pages on merge; the gateway that
                           knows `native_urgent_dispatch` ships later, on the F27
                           Section 4 dispatch. In between, the deployed gateway
                           answers `400 unsupported_action` with NO `delivery` field
                           -- a shape the live handler cannot produce for this action,
                           because it catches everything and always answers with one.
                           A 400 is also the one status no retry and no later state
                           can turn into a delivery: the request shape itself was
                           refused, so nothing was sent and nothing can be sent later.
                           Reading it as unknown would retain the hold and disable the
                           URGENT button for the length of that window on every card
                           that already works today. So the hold is released and a card
                           is told plainly that nothing was sent. The legacy webhook
                           fallback that used to sit here was retired in B2 (it
                           resolved the editor through Linear, whose keys are
                           revoked, so it could only fail). */
                        if (nativeLane && resp.status === 400 && j && j.ok === false
                            && j.error === 'unsupported_action' && j.delivery === undefined) {
                            nativeLane = false;
                            releaseOwnHold();
                            if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                            showNotify('Could not send urgent ping', 'Nothing was sent. The urgent ping service is not available yet, so post in #video-editing manually.');
                            return;
                        }
                        if (nativeLane) {
                            knownNotSent = !!(j && j.ok === false && j.delivery === 'not_sent' && j.retry_safe === true);
                            if (resp.status === 202 && j && j.ok === true && j.delivery === 'pending'
                                && typeof j.dispatch_id === 'string' && j.dispatch_id.trim()) {
                                holdValue = JSON.stringify({ state: 'delivery_queued', dispatch_id: j.dispatch_id });
                                localStorage.setItem(attemptKey, holdValue);
                                if (btn) { btn.disabled = true; btn.textContent = 'Queued'; }
                                showNotify('Urgent ping queued', 'The urgent ping is queued for #video-editing. It is not marked Sent until Slack returns a receipt.');
                                return;
                            }
                            if (!(resp.ok && j && j.ok === true && j.delivery === 'sent'
                                && typeof j.dispatch_id === 'string' && j.dispatch_id.trim()
                                && typeof j.slack_ts === 'string' && j.slack_ts.trim())) {
                                const refusal = new Error('native_urgent_unconfirmed');
                                if (knownNotSent) { refusal.code = String(j.error || 'native_urgent_unconfirmed'); refusal.status = resp.status; }
                                throw refusal;
                            }
                        }
                        if (!resp.ok || (j && j.ok === false)) throw new Error((j && j.error) || ('http ' + (resp && resp.status)));
                        let persistFailed = false;
                        const sentAt = new Date().toISOString();
                        const current = nativeLane && opts.currentPost ? opts.currentPost() : null;
                        const sameRound = !nativeLane || !!(current && opts.currentClientSlug && opts.currentClientSlug() === native.client_slug
                            && String(current.id) === native.card_id
                            && _writeUiNativeId(current, 'video') === native.deliverable_id
                            && String(current.video_status_at || '') === native.video_status_at
                            && _calNormStatus(current.video_status || '') === 'Tweaks Needed');
                        if (!sameRound) {
                            if (btn) { btn.disabled = true; btn.textContent = 'Earlier round sent'; }
                            showNotify('Urgent ping sent', 'The ping was sent for the original video round. The current card changed, so its Sent marker was not updated.'); return;
                        }
                        if (sameRound && opts && typeof opts.persist === 'function') {
                            try {
                                await opts.persist({ sentAt, issue, editor: (j && j.editor) || '' });
                            } catch (persistErr) {
                                persistFailed = true;
                                try { console.warn('[Urgent] Sent Slack ping but could not persist marker', persistErr); } catch {}
                            }
                        }
                        if (btn) { btn.disabled = true; btn.textContent = 'Sent'; btn.dataset.urgentSent = '1'; btn.classList.add('is-sent'); }
                        const who = (j && j.editor) ? (' — pinged ' + j.editor) : '';
                        showNotify(spec.sentTitle, spec.sentWhere + who + (persistFailed ? '. The Sent state may not persist until the row saves.' : '.'));
                    } catch (e) {
                        if (nativeLane && attempted && !knownNotSent) { showUnknown(); return; }
                        if (nativeLane && !attempted) {
                            releaseOwnHold();
                            if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                            showNotify('Could not prepare urgent ping', 'Nothing was sent. This browser could not retain the delivery attempt. Check browser storage before trying again.'); return;
                        }
                        if (nativeLane && knownNotSent) {
                            releaseOwnHold();
                            if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                            const code = e.code || 'native_urgent_unconfirmed';
                            const guidance = _writeUiFailureText('urgent ping', code, e.status);
                            showNotify(guidance.title, guidance.text + ' (code: ' + code + ')');
                            return;
                        }
                        if (btn) { btn.disabled = false; btn.textContent = 'URGENT'; }
                        showNotify('Could not send', spec.failBody);
                    }
                })();
            },
            spec.confirmCta
        );
    }
    /* ── Parent-link detection ───────────────────────────────────────────
       A card must link the VID/GRA sub-issue, never the parent issue:
       status pushes, the URGENT ping and the editor Workload all operate
       on sub-issues only, so "Tweaks Needed" pushed onto a parent is
       invisible to the editor (this is how Kasper's personal-calendar
       tweaks went missing from the Workload). Linear identifiers known to
       be parents are collected here; a card whose link matches gets the
       same orange thumb banner as an unlinked card, asking for the
       sub-issue link instead. Populated two ways: instantly when a paste's
       linear-subissues lookup comes back with children, and on calendar
       load from the workload's cached linear-issues feed (so cards linked
       to a parent in an earlier session still show the banner). */
    const _calParentLinks = new Set();
    /* Sub-issue meta we use to drive the "incomplete sub-issue" banner: a
       sub-issue should always carry a project (the client), a due date and
       an assignee (editor). When any are missing, the same orange thumb
       banner that flags unlinked / parent-linked cards calls it out so the
       SMM notices before the post slips into the editor's workload.
       Populated from the workload's cached Linear feed the same way
       _calParentLinks is, and keyed by identifier (e.g. "VID-123"). */
    const _calLinearMetaByIdent = new Map();
    /* The parent-link + "incomplete sub-issue" banners are driven by Linear
       metadata (project / due date / editor) that does NOT live on the Supabase
       row, so it can't ride the realtime stream. Persist it (per browser, keyed
       by Linear identifier) so the banner is correct INSTANTLY on load — no
       blank-until-the-Linear-feed-lands flicker, and it survives a refresh
       instead of being rebuilt from a fetch every time. It is only refreshed
       from Linear on real foreground / tab-return loads (cache-first, with the
       force-fetch throttled below) — never on a timer and never on a realtime
       tick — so an idle open tab costs nothing on n8n. */
    const CAL_LINEAR_META_LS_KEY = 'syncview_calLinearMeta_v2';
    const CAL_LINEAR_META_TTL_MS = 7 * 24 * 60 * 60 * 1000;
    let _calLinearMetaHydrated = false;
    function _calSetLinearMetaHydrated(value) { _calLinearMetaHydrated = value; }
    /* The force-fetch throttle (CAL_LINEAR_META_FORCE_MIN_MS), the ident-set
       signature (_calLinearStatusMetaSig / _calLinearStatusMetaAt) and the
       unsupported-backend latch (_calStatusMetaUnsupported) were removed with
       the linear-issue-statuses fetch itself on 2026-09-22 -- there is no
       longer a Linear request to throttle or to switch off. The persisted
       copy above (LS key + TTL) is what the banners read now.
       See OPEN_REPAIRS 236. */
