        const sent = _calUrgentSentForCurrentRound(post, k);
        const cls = 'cal-urgent-btn' + (extraClass ? ' ' + extraClass : '') + (sent ? ' is-sent' : '');
        const preClick = stopPropagation ? 'event.stopPropagation();' : '';
