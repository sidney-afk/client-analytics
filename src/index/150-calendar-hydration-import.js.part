    function _calHydrateLinearMeta() {
        if (_calLinearMetaHydrated) return;
        const authority = _writeUiAuthoritySnapshot();
        if (!authority) return;
        _calLinearMetaHydrated = true;
        try {
            const data = JSON.parse(localStorage.getItem(CAL_LINEAR_META_LS_KEY) || 'null');
            if (!data || typeof data !== 'object') return;
            if (!data.savedAt || (Date.now() - data.savedAt) > CAL_LINEAR_META_TTL_MS) return;
            if (Array.isArray(data.parents)) data.parents.forEach(id => { if (id && _writeUiIdentifierAllowed(id, authority)) _calParentLinks.add(String(id)); });
            if (data.meta && typeof data.meta === 'object') {
                for (const k of Object.keys(data.meta)) {
                    const m = data.meta[k];
                    if (m && typeof m === 'object' && _writeUiIdentifierAllowed(k, authority)) _calLinearMetaByIdent.set(k, { hasProject: !!m.hasProject, hasDue: !!m.hasDue, hasEditor: !!m.hasEditor });
                }
            }
        } catch {}
    }
    function _calPersistLinearMeta() {
        try {
            const authority = _writeUiAuthoritySnapshot();
            if (!authority) return;
            const meta = {};
            _calLinearMetaByIdent.forEach((v, k) => { if (_writeUiIdentifierAllowed(k, authority)) meta[k] = { hasProject: !!v.hasProject, hasDue: !!v.hasDue, hasEditor: !!v.hasEditor }; });
            localStorage.setItem(CAL_LINEAR_META_LS_KEY, JSON.stringify({ schema: 2, savedAt: Date.now(), parents: Array.from(_calParentLinks).filter(id => _writeUiIdentifierAllowed(id, authority)), meta }));
        } catch {}
    }
    function _calPruneLinearMetaForAuthority() {
        const authority = _writeUiAuthoritySnapshot();
        if (!authority) return;
        Array.from(_calParentLinks).forEach(id => { if (!_writeUiIdentifierAllowed(id, authority)) _calParentLinks.delete(id); });
        Array.from(_calLinearMetaByIdent.keys()).forEach(id => { if (!_writeUiIdentifierAllowed(id, authority)) _calLinearMetaByIdent.delete(id); });
    }
    function _calIdentFromUrl(url) {
        // Linear links can carry a raw UUID instead of ABC-123. A loose match
        // fabricates a garbage ident from inside the UUID (e.g. "A-94" out of
        // ...be1a-94e6...), and one garbage id poisons the whole aliased batch
        // that the linear-issue-statuses webhook sends to Linear (F139). URL
        // inputs must take the ident from their /issue/<ident> segment; bare
        // inputs must BE an ident.
        const s = String(url || '');
        const seg = s.match(/\/issue\/([^/?#]+)/i);
        const cand = (seg ? seg[1] : s).trim();
        const m = cand.match(/^([A-Za-z]+-\d+)$/);
        return m ? m[1].toUpperCase() : '';
    }
    function _calIsParentLinked(url) {
        const id = _calIdentFromUrl(url);
        return !!id && _calParentLinks.has(id);
    }
    /* For a card linked to a real sub-issue (not a parent), return which of
       project / due date / editor are missing on the Linear side. Returns null
       if the card has no link, the link points to a parent, the sub-issue meta
       hasn't been seen yet, or nothing is missing. Video takes precedence over
       graphic. The meta is sourced straight from Linear (see
       _calRefreshParentLinkFlags), so "project" reflects the issue's (or its
       parent's) ACTUAL Linear project: a genuinely project-less sub-issue is
       flagged; one that has or inherits a project is not. */
    function _calLinearMissingForCard(p) {
        if (!p) return null;
        const slots = [
            { comp: 'video',   url: p.linear_issue_id },
            { comp: 'graphic', url: p.graphic_linear_issue_id }
        ];
        for (const { comp, url } of slots) {
            const ident = _calIdentFromUrl(url);
            if (!ident) continue;
            /* OPEN_REPAIRS item 62: a SyncView-authoritative component drops out
               of this banner, exactly as it already drops out of the
               parent-linked banner rendered beside it. The banner asks the SMM
               to open the Linear issue and fill in a missing project, due date
               or editor -- and for a flipped team that edit is detect-only now,
               so it is silently discarded. The due date it names is read
               natively post-flip, so a blank on the Linear side is not even the
               field that matters any more. Measured 2026-08-30, hours after
               F1(video): of the live non-TEST cards carrying a link, three
               video sub-issues reported a missing due date and would have shown
               this. Keyed on authority, not on the word video, so a rollback
               restores the banner with no edit. */
            if (_writeUiLinkSlotSealed(comp)) continue;
            if (_calParentLinks.has(ident)) continue;
            const meta = _calLinearMetaByIdent.get(ident);
            if (!meta) continue;
            const missing = [];
            if (!meta.hasProject) missing.push('project');
            if (!meta.hasDue)     missing.push('due date');
            if (!meta.hasEditor)  missing.push('editor');
            if (missing.length) return { comp, url, missing };
        }
        return null;
    }
    /* Reads linear_issue_url for a set of deliverable ids. The anon role is
       granted this column. A non-OK response or a throw yields an empty map,
       which the caller reads as nothing to adopt. Ids are quoted for the
       PostgREST in.(...) list with split/join rather than a regex literal, for
       the same reason the crosswalk reader does it. */
    async function _calFetchDeliverableLinkRows(ids) {
        const wanted = [...new Set((ids || []).map(id => String(id || '').trim()).filter(Boolean))];
        if (!wanted.length) return new Map();
        if (!CAL_SUPABASE_URL || !CAL_SUPABASE_ANON_KEY) return new Map();
        const list = wanted.map(id => '"' + String(id).split('"').join('\\"') + '"').join(',');
        const url = CAL_SUPABASE_URL + '/rest/v1/deliverables?select=id,card_id,linear_issue_url'
            + '&id=in.(' + encodeURIComponent(list) + ')';
        try {
            const response = await fetch(url, {
                cache: 'no-store',
                headers: {
                    apikey: CAL_SUPABASE_ANON_KEY,
                    Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY,
                    Accept: 'application/json'
                }
            });
            if (!response.ok) return new Map();
            const payload = await response.json();
            if (!Array.isArray(payload)) return new Map();
            const rows = new Map();
            payload.forEach(row => {
                const id = String((row && row.id) || '').trim();
                if (id) rows.set(id, row);
            });
            return rows;
        } catch (_e) {
            return new Map();
        }
    }
    /* Adopt a Linear link the card should already have had.
     *
     * A natively created card is written ONCE, at materialization, taking its
     * Linear URL from the create response. When the mirror has not finished by
     * then the card is written with an empty link and nothing ever fills it in:
     * the sub-issue lands in Linear seconds later, the card just cannot point
     * at it, permanently, and the only visible symptom is a missing link on a
     * card that looks otherwise fine. Measured 2026-08-17: 2 of the 6 natively
     * created cards carried a deliverable whose linear_issue_url was set while
     * the card link stayed blank.
     *
     * The deliverable is the authority: it holds linear_issue_url and it names
     * its card_id. Adoption only ever FILLS an empty slot and only from a
     * deliverable that is unbound or bound to this exact card, so neither a
     * deliberate manual link nor another card can be clobbered. The card
     * binding is re-read after the lookup await, because the card can be
     * linked, re-pointed, or archived while it is in flight.
     */
    async function _calAdoptDeliverableLinks(loadRun, slug) {
        if (!_calLoadRunCurrent(loadRun)) return 0;
        const wanted = new Map();
        for (const post of calState.posts || []) {
            if (!post) continue;
            for (const component of ['video', 'graphic']) {
                const field = component === 'video' ? 'linear_issue_id' : 'graphic_linear_issue_id';
                if (String(post[field] || '').trim()) continue;
                const deliverableId = _writeUiNativeId(post, component);
                if (!deliverableId || wanted.has(deliverableId)) continue;
                wanted.set(deliverableId, { pid: post.id, component, field });
            }
        }
        if (!wanted.size) return 0;
        const rows = await _calFetchDeliverableLinkRows([...wanted.keys()]);
        if (!_calLoadRunCurrent(loadRun) || !rows.size) return 0;
        let adopted = 0;
        for (const [deliverableId, slot] of wanted) {
            const row = rows.get(deliverableId);
            const url = String((row && row.linear_issue_url) || '').trim();
            if (!url) continue;
            const boundCard = String((row && row.card_id) == null ? '' : row.card_id).trim();
            if (boundCard && boundCard !== slot.pid) continue;
            const post = (calState.posts || []).find(p => p && p.id === slot.pid);
            if (!post || String(post[slot.field] || '').trim()) continue;
            if (_writeUiNativeId(post, slot.component) !== deliverableId) continue;
            try {
                const resp = await _calUpsertFetch(slug, { client: slug, post: { id: post.id, [slot.field]: url } });
                const json = await resp.json().catch(() => ({}));
                if (!json || json.ok !== true) continue;
                post[slot.field] = url;
                adopted += 1;
            } catch (error) {
                console.warn('[Calendar] could not adopt the deliverable link for ' + slot.component, error);
            }
        }
        if (adopted && _calLoadRunCurrent(loadRun)) {
            try { _calCacheWrite(slug, calState.posts); } catch {}
            /* _calSchedulePendingRender only ARMS the interval; the interval's
               first tick clears itself unless _calPendingBackgroundRender is
               already true. Calling it alone therefore repainted nothing on a
               foreground load, so an adopted link reached the row, the cache and
               the database while the card on screen kept showing "no sub-issue"
               until some later render happened to run. Set the flag when the cal
               is busy, and repaint straight away when it is not. */
            if (_calIsCalBusy()) {
                _calPendingBackgroundRender = true;
                _calSchedulePendingRender();
            } else {
                _calRenderBody({ preserveScroll: true });
            }
        }
        return adopted;
    }
    /* Banner metadata (Linear project / due date / editor + sub-vs-parent) used
       to be re-fetched from the `linear-issue-statuses` n8n webhook on every
       foreground and tab-return calendar load. That webhook is revoked on
       2026-09-27, so the fetch is gone -- see OPEN_REPAIRS 236 for the
       measurement and the three-part dependency proof behind the removal.

       What remains is the PERSISTED copy: the banners keep rendering from
       whatever the last successful fetch wrote to localStorage, and
       `_calLinearMissingForCard` already fails OPEN for an ident it holds no
       meta for (`if (!meta) continue;`), so a card with no persisted entry
       shows no completeness banner rather than a wrong one. Both production
       lanes are SyncView-authoritative today, which already seals every slot
       out of these banners (`_writeUiLinkSlotSealed`, OPEN_REPAIRS 62) -- the
       fetch was answering questions whose answers were discarded.

       `force` is kept in the signature so the two call sites stay legible and
       a future NATIVE meta source can reuse the foreground/return distinction
       without re-plumbing them. */
    async function _calRefreshParentLinkFlags(loadRun, force) {
        if (!_calLoadRunCurrent(loadRun)) return;
        _calHydrateLinearMeta();
    }

    /* `_calSyncStatusFromLinear` (link-time status adoption through the
       `linear-subissues` webhook) was removed 2026-09-23 (B2). A pasted link
       is saved as before; the card's status stays whatever SyncView holds,
       because SyncView is the status authority. */
    /* Per-card, per-component "the user just changed this locally" clock.
       Lets the post-load Linear reconcile skip cards/components whose
       sub-status was mutated locally within the grace window — Linear's
       state is eventually-consistent, so without this guard the reconcile
       silently flips a freshly-approved component back to whatever stale
       state Linear still reports. */
    const _calLocalStatusAt = Object.create(null);
    const CAL_LOCAL_STATUS_GRACE_MS = 5 * 60 * 1000;
    function _calMarkLocalStatus(pid, comp) {
        _calLocalStatusAt[pid + '|' + (comp || '')] = Date.now();
        if (comp) _calLocalStatusAt[pid + '|'] = Date.now();
    }
    function _calIsLocalStatusFresh(pid, comp) {
        const ts = _calLocalStatusAt[pid + '|' + (comp || '')] || _calLocalStatusAt[pid + '|'] || 0;
        return ts && (Date.now() - ts) < CAL_LOCAL_STATUS_GRACE_MS;
    }
    /* Same idea, but cross-session: trust the sheet's updated_at as a
       "someone just touched this from another tab/browser" signal. Without
       this, the SMM's reconcile would clobber a client approval made in a
       different browser the moment Linear hasn't caught up yet. */
    function _calIsRowRecentlyTouched(post) {
        if (!post || !post.updated_at) return false;
        const t = Date.parse(post.updated_at);
        if (!isFinite(t)) return false;
        return (Date.now() - t) < CAL_LOCAL_STATUS_GRACE_MS;
    }

    /* Import from Linear and Bulk Linear sync were removed 2026-09-23
       (B2, docs/ops/B2_LINEAR_CLEANUP_PLAN.md). Both read the n8n
       `linear-subissues` webhook, which can only fail now that Linear is no
       longer a work surface and its API keys are revoked. Posts are created
       natively (Create Post / Import from Excel); sub-issues are never made
       from here. */

    /* Bulk-upsert a batch of new posts to the calendar sheet. Sends them
       one at a time with a small gap between calls — the n8n upsert
       workflow appears to ack the HTTP response before the Sheets write
       fully commits, so back-to-back calls were racing and silently
       dropping rows (or storing them with the wrong order_index). After
       the initial loop the sheet is queried, and any id that didn't land
       is re-sent — up to a few retry passes — until every post is on
       the sheet or we've stopped making progress. */
    async function _calBulkUpsertPosts(posts, progFn) {
        const sendOne = async (post) => {
            try {
                const _bulkSlug = calClientSlug(calState.client);
                const resp = await _calUpsertFetch(_bulkSlug, { client: _bulkSlug, post });
                const json = await resp.json();
                return !!json.ok;
            } catch (e) { return false; }
        };
        const sendBatch = async (batch, label) => {
            for (let i = 0; i < batch.length; i++) {
                await sendOne(batch[i]);
                if (progFn) progFn(i + 1, batch.length, label);
                if (i + 1 < batch.length) await new Promise(r => setTimeout(r, 350));
            }
        };
        // Initial pass: sequential POSTs with a small inter-call gap.
        await sendBatch(posts, null);
        // Verify + retry up to a few rounds. The drop rate is small and
        // independent per call, so two extra rounds is enough to converge
        // in practice.
        let retried = 0, missingAfterRetry = 0;
        const MAX_RETRY_ROUNDS = 3;
        let lastMissingCount = posts.length;
        for (let round = 0; round < MAX_RETRY_ROUNDS; round++) {
            const verify = await _calFetchPostsForVerify();
            if (!verify) break;
            const serverIds = new Set(verify.map(p => String(p.id)));
            const missing = posts.filter(p => !serverIds.has(String(p.id)));
            if (!missing.length) { missingAfterRetry = 0; break; }
            // Stop if a retry round didn't shrink the missing set — the
            // backend is rejecting these specific posts, not racing.
            if (round > 0 && missing.length >= lastMissingCount) {
                missingAfterRetry = missing.length;
                break;
            }
            lastMissingCount = missing.length;
            await sendBatch(missing, `Re-sending ${missing.length} that didn't land…`);
            retried += missing.length;
            missingAfterRetry = missing.length;   // pessimistic until we verify again next loop
        }
        // Treat anything that made it through retry as "succeeded" for the
        // caller's summary line.
        const done = posts.length;
        const failed = missingAfterRetry;
        return { done, failed, retried, missingAfterRetry };
    }
    async function _calFetchPostsForVerify() {
        // Verify against the active write target. Unflagged clients still write
        // n8n/Sheets, so calendar-get is the right confirmation source. EF
        // clients write directly to calendar_posts, so reading the Sheet would
        // false-fail and re-send rows that already landed.
        try {
            const slug = calClientSlug(calState.client);
            if (_calUpsertUseEf(slug)) {
                const baseUrl = CAL_SUPABASE_URL + '/rest/v1/calendar_posts?select=*&client=eq.' + encodeURIComponent(slug);
                return await _calSupabaseFetchAllRows(baseUrl);
            }
            const resp = await fetch(CALENDAR_GET_URL + '?client=' + encodeURIComponent(slug) + '&_t=' + Date.now());
            const json = await resp.json();
            return json.ok ? (json.posts || []) : null;
        } catch (e) {
            console.warn('[Calendar] import verification read failed', e);
            return null;
        }
    }

    function _calRenderImportPick() {
        const modal = document.getElementById('calImportModal');
        if (!modal) return;
        modal.innerHTML = `
            <div class="cal-import-head">
                <button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                <h3>Import posts from Excel</h3>
                <p>In your Google Sheet choose <strong>File ▸ Download ▸ Microsoft Excel (.xlsx)</strong>, then drop that file here. You'll match the columns on the next step.</p>
            </div>
            <div class="cal-import-body">
                <label class="cal-import-drop" id="calImportDrop">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                    <div class="cal-import-drop-title">Choose an .xlsx file</div>
                    <div class="cal-import-drop-sub">or drag it onto this box</div>
                    <input type="file" accept=".xlsx,.xls" id="calImportFile" hidden>
                </label>
                <div id="calImportErr"></div>
            </div>
            <div class="cal-import-foot">
                <button class="cal-import-btn-ghost" onclick="closeCalImport()">Cancel</button>
            </div>`;
        const input = document.getElementById('calImportFile');
        input.addEventListener('change', () => { if (input.files[0]) _calHandleImportFile(input.files[0]); });
        const drop = document.getElementById('calImportDrop');
        ['dragover','dragenter'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.style.borderColor = 'var(--sv-border-111)'; }));
        ['dragleave'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.style.borderColor = ''; }));
        drop.addEventListener('drop', e => { e.preventDefault(); drop.style.borderColor = ''; const f = e.dataTransfer.files[0]; if (f) _calHandleImportFile(f); });
    }

    async function _calHandleImportFile(file) {
        const errBox = document.getElementById('calImportErr');
        if (errBox) errBox.innerHTML = `<div class="cal-import-info">Reading ${_calEsc(file.name)}…</div>`;
        try {
            const XLSX = await _calLoadXLSX();
            const buf = await file.arrayBuffer();
            const wb = XLSX.read(new Uint8Array(buf), { type: 'array', cellDates: true });
            if (!wb.SheetNames.length) throw new Error('That workbook has no sheets.');
            _calImportWorkbook = wb;
            if (wb.SheetNames.length > 1) {
                _calRenderImportSheetPick();
            } else {
                _calLoadImportSheet(wb.SheetNames[0]);
            }
        } catch (e) {
            if (errBox) errBox.innerHTML = `<div class="cal-import-err">${_calEsc(e.message || 'Could not read that file')}</div>`;
        }
    }

    /* Parse one sheet from the loaded workbook and continue into the
       column-matching step. Errors surface in the sheet-picker (if we
       came from there) or in the upload step. */
    function _calLoadImportSheet(name) {
        const wb = _calImportWorkbook;
        if (!wb) return;
        const errBox = document.getElementById('calImportErr');
        try {
            const XLSX = window.XLSX;
            const ws = wb.Sheets[name];
            if (!ws) throw new Error('That sheet is empty.');
            const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '', raw: true, blankrows: false });
            if (!aoa.length) throw new Error('That sheet looks empty.');
            _calImportForcedLayout = null;   // fresh sheet → trust auto-detect again
            const parsed = _calDetectSheetLayout(aoa);
            _calImportAoa = aoa;
            _calImportSheetName = name;
            _calImportRows = parsed.rows;
            _calImportHeaders = parsed.headers;
            _calImportLayout = parsed.transposed ? 'columns' : 'rows';
            _calRenderImportMap();
        } catch (e) {
            if (errBox) errBox.innerHTML = `<div class="cal-import-err">${_calEsc(e.message || 'Could not read that sheet')}</div>`;
        }
    }

    /* Escape hatch for when auto-detect guesses the orientation wrong:
       re-parse the same sheet reading posts the other way (one per row ⇄ one
       per column) and rebuild the match step. The current mapping is only
       replaced once the forced re-parse succeeds, so a layout that yields no
       posts leaves the user where they were with an explanation. */
    function _calFlipImportLayout() {
        if (!_calImportAoa) return;
        const next = _calImportLayout === 'columns' ? 'rows' : 'columns';
        const errBox = document.getElementById('calImportErr');
        try {
            const parsed = _calDetectSheetLayout(_calImportAoa, next);
            _calImportForcedLayout = next;
            _calImportRows = parsed.rows;
            _calImportHeaders = parsed.headers;
            _calImportLayout = parsed.transposed ? 'columns' : 'rows';
            _calRenderImportMap();
        } catch (e) {
            if (errBox) errBox.innerHTML = `<div class="cal-import-err">Reading one per ${next === 'columns' ? 'column' : 'row'} didn't work — ${_calEsc(e.message || 'no posts found that way')}.</div>`;
        }
    }

    /* Step 1.5: when the workbook has multiple sheets, make the user pick
       which one holds the posts. Auto-picking the first sheet bites us
       when the calendar tab is sheet 2+ (e.g. a cover sheet or per-channel
       tabs like "Tiktok"/"Instagram"). */
    function _calRenderImportSheetPick() {
        const modal = document.getElementById('calImportModal');
        const wb = _calImportWorkbook;
        if (!modal || !wb) return;
        const XLSX = window.XLSX;
        const sheets = wb.SheetNames.map(name => {
            let rowCount = 0;
            try {
                const ws = wb.Sheets[name];
                if (ws) {
                    const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '', raw: true, blankrows: false });
                    rowCount = aoa.filter(r => r.some(c => String(c).trim() !== '')).length;
                }
            } catch (_) {}
            return { name, rowCount };
        });
        const rowsHtml = sheets.map(s => {
            const hint = s.rowCount ? `${s.rowCount} non-empty row${s.rowCount === 1 ? '' : 's'}` : 'empty';
            return `<button type="button" class="cal-import-pick-row cal-import-sheet-row" onclick="_calLoadImportSheet(${_calEscAttr(JSON.stringify(s.name))})">
                <span class="cal-import-pick-name">${_calEsc(s.name)}</span>
                <span class="cal-import-pick-date">${_calEsc(hint)}</span>
            </button>`;
        }).join('');
        modal.innerHTML = `
            <div class="cal-import-head">
                <button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                <h3>Pick a sheet</h3>
                <p>This workbook has ${sheets.length} sheets — choose the one with the posts you want to import.</p>
            </div>
            <div class="cal-import-body">
                <div class="cal-import-pick-list">${rowsHtml}</div>
                <div id="calImportErr"></div>
            </div>
            <div class="cal-import-foot">
                <button class="cal-import-btn-ghost" onclick="_calRenderImportPick()">Back</button>
            </div>`;
    }

    /* Figure out how the spreadsheet is laid out. Most calendars put one
       post per row with field names across the top, but plenty put field
       names down the first column and one post per column. We score both
       the best-filled row and the best-filled column against the known
       calendar field names, and whichever matches more wins. */
    function _calDetectSheetLayout(aoa, forced) {
        const norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        // Map every alias → the field it belongs to, so a candidate line is
        // scored by how many DISTINCT fields it matches, not raw cells. This
        // stops a data line from masquerading as a header just because one
        // value repeats — e.g. a row full of "Scheduled" statuses would
        // otherwise rack up hits against the *date* alias "scheduled".
        const aliasKey = new Map();
        CAL_IMPORT_FIELDS.forEach(f => {
            [...f.aliases, f.label, f.key].forEach(a => { const n = norm(a); if (n) aliasKey.set(n, f.key); });
        });
        const distinctHits = cells => {
            const keys = new Set();
            cells.forEach(c => { const k = aliasKey.get(norm(c)); if (k) keys.add(k); });
            return keys.size;
        };
        const filled = cells => cells.filter(c => String(c).trim() !== '').length;
        // How "header-like" a line looks: real label lines are all-distinct
        // (Date, Status, Caption…); data value lines repeat themselves.
        const uniqRatio = cells => {
            const v = cells.map(c => String(c).trim()).filter(Boolean);
            return v.length ? new Set(v).size / v.length : 0;
        };

        const nRows = aoa.length;
        const nCols = aoa.reduce((m, r) => Math.max(m, r.length), 0);
        const cols = [];
        for (let c = 0; c < nCols; c++) cols.push(aoa.map(r => r[c] ?? ''));

        // Score each candidate header line by how many distinct fields it
        // matches first, then by how full it is — so the real header line
        // wins even when a data line is just as long.
        const bestLine = (lines, cap) => {
            let idx = 0, score = -1;
            for (let i = 0; i < Math.min(lines.length, cap); i++) {
                const sc = distinctHits(lines[i]) * 1000 + filled(lines[i]);
                if (sc > score) { score = sc; idx = i; }
            }
            return idx;
        };
        const rIdx = bestLine(aoa, 15);
        const cIdx = bestLine(cols, 15);

        const rowHits = distinctHits(aoa[rIdx] || []);
        const colHits = distinctHits(cols[cIdx] || []);
        let transposed;
        if (forced === 'columns') transposed = true;
        else if (forced === 'rows') transposed = false;
        else if (colHits !== rowHits) transposed = colHits > rowHits;
        else {
            // Tie on field matches (common with off-template label words):
            // labels almost always live in the leading row/column, and read
            // more header-like than a data line. Default to rows otherwise.
            const leadCol = cIdx === 0, leadRow = rIdx === 0;
            if (leadCol && !leadRow) transposed = true;
            else if (leadRow && !leadCol) transposed = false;
            else transposed = uniqRatio(cols[cIdx] || []) > uniqRatio(aoa[rIdx] || []);
        }

        const buildHeaders = (line) => {
            const names = [], idx = [];
            line.forEach((h, i) => {
                const name = String(h).trim();
                if (!name) return;
                let u = name, n = 2;
                while (names.includes(u)) { u = `${name} (${n})`; n++; }
                names.push(u); idx.push(i);
            });
            return { names, idx };
        };

        let headers, rows;
        if (transposed) {
            const built = buildHeaders(cols[cIdx]);
            headers = built.names;
            rows = [];
            for (let c = 0; c < nCols; c++) {
                if (c === cIdx) continue;
                const colCells = cols[c];
                if (!built.idx.some(ri => String(colCells[ri] ?? '').trim() !== '')) continue;
                const obj = {};
                headers.forEach((hn, k) => { obj[hn] = colCells[built.idx[k]] ?? ''; });
                rows.push(obj);
            }
        } else {
            const built = buildHeaders(aoa[rIdx]);
            headers = built.names;
            rows = [];
            for (let i = rIdx + 1; i < nRows; i++) {
                const arr = aoa[i] || [];
                if (!filled(arr)) continue;
                const obj = {};
                headers.forEach((hn, k) => { obj[hn] = arr[built.idx[k]] ?? ''; });
                rows.push(obj);
            }
        }
        if (headers.length < 2) throw new Error("Couldn't find the column names in that sheet.");
        if (!rows.length) throw new Error('Found the headers but no posts to import.');
        return { headers, rows, transposed };
    }

    function _calRenderImportMap() {
        const modal = document.getElementById('calImportModal');
        if (!modal) return;
        const headers = _calImportHeaders;
        const norm = s => String(s||'').toLowerCase().replace(/[^a-z0-9]/g,'');
        const guess = (field) => {
            for (const h of headers) { if (field.aliases.some(a => norm(a) === norm(h))) return h; }
            for (const h of headers) { const nh = norm(h); if (nh && field.aliases.some(a => nh.includes(norm(a)) || norm(a).includes(nh))) return h; }
            return '';
        };
        const rowsHtml = CAL_IMPORT_FIELDS.map(f => {
            const sel = guess(f);
            // Default the toggle: required fields stay on, optional fields
            // are on iff we matched a column. The user can flip either way.
            const on = f.req || !!sel;
            const opts = ['<option value="">— none —</option>']
                .concat(headers.map(h => `<option value="${_calEscAttr(h)}"${h===sel?' selected':''}>${_calEsc(h)}</option>`)).join('');
            return `<div class="cal-import-map-row${on ? '' : ' is-off'}" data-import-row="${f.key}">
                <input type="checkbox" class="cal-import-skip-chk" data-import-skip="${f.key}"${on ? ' checked' : ''}${f.req ? ' disabled title="Required field"' : ' title="Include this column"'} onchange="_calToggleImportField(this)">
                <label>${_calEsc(f.label)}${f.req?' <span class="req">*</span>':''}</label>
                <select data-import-field="${f.key}"${on ? '' : ' disabled'}>${opts}</select>
            </div>`;
        }).join('');
        modal.innerHTML = `
            <div class="cal-import-head">
                <button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                <h3>Match the columns</h3>
                <p>Matches were guessed from your column names — adjust anything that's off. Only <strong>Post name</strong> is required (red *); everything else can be left as <em>— none —</em> or unchecked to skip. Posts import into <strong>${_calEsc(calState.client)}</strong>'s calendar.</p>
            </div>
            <div class="cal-import-body">
                <div class="cal-import-info">${_calImportRows.length} post${_calImportRows.length!==1?'s':''} found${_calImportSheetName ? ` in sheet <strong>${_calEsc(_calImportSheetName)}</strong>` : ''} — read ${_calImportLayout === 'columns' ? 'one per column (field names down the side)' : 'one per row (field names across the top)'}. Posts with an empty name are skipped.<br><span class="cal-import-flip-note">Wrong — these options look like cell values?</span> <button type="button" class="cal-import-flip" onclick="_calFlipImportLayout()">Read one per ${_calImportLayout === 'columns' ? 'row' : 'column'} instead</button></div>
                ${rowsHtml}
                <div id="calImportErr"></div>
            </div>
            <div class="cal-import-foot">
                <button class="cal-import-btn-ghost" onclick="${_calImportWorkbook && _calImportWorkbook.SheetNames.length > 1 ? '_calRenderImportSheetPick()' : '_calRenderImportPick()'}">Back</button>
                <button class="cal-import-btn-primary" id="calImportGo" onclick="_calProceedToImportSelect()">Next: pick posts</button>
            </div>`;
    }

    /* Step 3: pick which rows to actually import. The SMM almost always
       wants to skip a few rows (filming-plan placeholders, blanks the
       map step couldn't filter out, etc.) — letting them deselect by
       name is far less destructive than editing the spreadsheet. */
    function _calToggleImportField(cb) {
        const key = cb.getAttribute('data-import-skip');
        const row = cb.closest('.cal-import-map-row');
        const sel = row && row.querySelector('select[data-import-field="' + key + '"]');
        if (!sel) return;
        sel.disabled = !cb.checked;
        if (row) row.classList.toggle('is-off', !cb.checked);
    }
    function _calProceedToImportSelect() {
        const modal = document.getElementById('calImportModal');
        if (!modal || !_calImportRows) return;
        const map = {};
        modal.querySelectorAll('select[data-import-field]').forEach(s => {
            if (s.disabled) return;   // toggle off → skip this column entirely
            if (s.value) map[s.dataset.importField] = s.value;
        });
        const errBox = document.getElementById('calImportErr');
        if (!map.name) { if (errBox) errBox.innerHTML = `<div class="cal-import-err">Pick which column holds the post name — it's required.</div>`; return; }
        _calImportMap = map;
        // Default: every row with a non-empty mapped name is pre-selected.
        const named = [];
        _calImportRows.forEach((row, i) => {
            const n = String(row[map.name] ?? '').trim();
            if (n) named.push(i);
        });
        if (!named.length) {
            if (errBox) errBox.innerHTML = `<div class="cal-import-err">No rows had a value in the selected name column — adjust the mapping.</div>`;
            return;
        }
        _calImportSelectedIdx = new Set(named);
        _calRenderImportSelect();
    }

    function _calRenderImportSelect() {
        const modal = document.getElementById('calImportModal');
        if (!modal || !_calImportRows || !_calImportMap) return;
        const map = _calImportMap;
        const named = [];
        _calImportRows.forEach((row, i) => {
            const n = String(row[map.name] ?? '').trim();
            if (n) named.push({ idx: i, name: n, date: map.scheduled_date ? _calCoerceDate(row[map.scheduled_date]) : '' });
        });
        const sel = _calImportSelectedIdx || new Set();
        const allOn = named.every(r => sel.has(r.idx));
        const rowsHtml = named.map(r => {
            const checked = sel.has(r.idx) ? ' checked' : '';
            const dateHtml = r.date ? `<span class="cal-import-pick-date">${_calEsc(r.date)}</span>` : '';
            return `<label class="cal-import-pick-row">
                <input type="checkbox" data-import-pick="${r.idx}"${checked} onchange="_calToggleImportRow(this)">
                <span class="cal-import-pick-name">${_calEsc(r.name)}</span>
                ${dateHtml}
            </label>`;
        }).join('');
        modal.innerHTML = `
            <div class="cal-import-head">
                <button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                <h3>Pick posts to import</h3>
                <p>Uncheck any rows you don't want as cards on <strong>${_calEsc(calState.client)}</strong>'s calendar.</p>
            </div>
            <div class="cal-import-body">
                <div class="cal-import-pick-bar">
                    <span class="cal-import-pick-count" id="calImportPickCount">${sel.size} of ${named.length} selected</span>
                    <button class="cal-import-pick-toggle" type="button" onclick="_calToggleAllImportRows(${allOn ? 'false' : 'true'})">${allOn ? 'Deselect all' : 'Select all'}</button>
                </div>
                <div class="cal-import-pick-list">${rowsHtml}</div>
                <div id="calImportErr"></div>
            </div>
            <div class="cal-import-foot">
                <button class="cal-import-btn-ghost" onclick="_calRenderImportMap()">Back</button>
                <button class="cal-import-btn-primary" id="calImportGo" onclick="_calRunImport()"${sel.size ? '' : ' disabled'}>Import ${sel.size} post${sel.size === 1 ? '' : 's'}</button>
            </div>`;
    }

    function _calToggleImportRow(cb) {
        if (!_calImportSelectedIdx) return;
        const i = parseInt(cb.getAttribute('data-import-pick'), 10);
        if (isNaN(i)) return;
        if (cb.checked) _calImportSelectedIdx.add(i); else _calImportSelectedIdx.delete(i);
        const n = _calImportSelectedIdx.size;
        const totalRow = document.querySelectorAll('.cal-import-pick-row').length;
        const cnt = document.getElementById('calImportPickCount');
        if (cnt) cnt.textContent = n + ' of ' + totalRow + ' selected';
        const btn = document.getElementById('calImportGo');
        if (btn) {
            btn.disabled = n === 0;
            btn.textContent = 'Import ' + n + ' post' + (n === 1 ? '' : 's');
        }
        const tog = document.querySelector('.cal-import-pick-toggle');
        if (tog) tog.textContent = (n === totalRow) ? 'Deselect all' : 'Select all';
    }

    function _calToggleAllImportRows(on) {
        if (!_calImportRows || !_calImportMap || !_calImportSelectedIdx) return;
        _calImportSelectedIdx.clear();
        if (on) {
            _calImportRows.forEach((row, i) => {
                const n = String(row[_calImportMap.name] ?? '').trim();
                if (n) _calImportSelectedIdx.add(i);
            });
        }
        _calRenderImportSelect();
    }

    async function _calRunImport() {
        const modal = document.getElementById('calImportModal');
        if (!modal || !_calImportRows || !_calImportMap || !_calImportSelectedIdx) return;
        const map = _calImportMap;
        const errBox = document.getElementById('calImportErr');
        const statusByLower = new Map(CAL_STATUSES.map(s => [s.toLowerCase(), s]));
        statusByLower.set('draft', 'In Progress');
        statusByLower.set('for kasper approval', 'Kasper Approval');
        statusByLower.set('smm approval', 'For SMM Approval');
        statusByLower.set('scheduled', 'Scheduled');
        statusByLower.set('queued', 'Scheduled');
        statusByLower.set('queue', 'Scheduled');
        let baseOrder = calState.posts.reduce((m,p) => Math.max(m, Number(p.order_index||0)), 0);
        const posts = [];
        _calImportRows.forEach((row, i) => {
            if (!_calImportSelectedIdx.has(i)) return;
            const name = String(row[map.name] ?? '').trim();
            if (!name) return;
            baseOrder++;
            const post = { id: _calMintId(), order_index: baseOrder, name, scheduled_date: '', status: 'In Progress', asset_url: '', thumbnail_url: '', caption: '', cta: '', tweaks: '' };
            if (map.scheduled_date) post.scheduled_date = _calCoerceDate(row[map.scheduled_date]);
            if (map.status) { const st = String(row[map.status] ?? '').trim().toLowerCase(); if (statusByLower.has(st)) post.status = statusByLower.get(st); }
            ['thumbnail_url','asset_url','caption','cta','tweaks'].forEach(k => { if (map[k]) post[k] = String(row[map[k]] ?? '').trim(); });
            posts.push(post);
        });
        if (!posts.length) { if (errBox) errBox.innerHTML = `<div class="cal-import-err">Pick at least one post to import.</div>`; return; }
        modal.innerHTML = `
            <div class="cal-import-head"><button class="cal-import-x" type="button" onclick="closeCalImport()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button><h3>Importing…</h3></div>
            <div class="cal-import-body"><div class="cal-import-progress" id="calImportProg">Importing 0 / ${posts.length}…</div></div>
            <div class="cal-import-foot"><button class="cal-import-btn-primary" id="calImportDone" disabled onclick="closeCalImport();loadCalendarPosts();">Done</button></div>`;
        const result = await _calBulkUpsertPosts(posts, (done, total, extra) => {
            const prog = document.getElementById('calImportProg');
            if (prog) prog.textContent = extra ? extra : `Importing ${done} / ${total}…`;
        });
        const saved = result.done - result.failed;
        const prog = document.getElementById('calImportProg');
        if (prog) {
            const missingNote = result.missingAfterRetry > 0
                ? ` ${result.missingAfterRetry} couldn't be confirmed — try those again.`
                : (result.retried > 0 ? ` (${result.retried} re-sent after the first write didn't land.)` : '');
            prog.textContent = result.failed
                ? `Imported ${saved} of ${posts.length}. ${result.failed} row${result.failed !== 1 ? 's' : ''} couldn't be saved — try those again.${missingNote}`
                : `Imported ${saved} post${saved !== 1 ? 's' : ''}.${missingNote}`;
        }
        const doneBtn = document.getElementById('calImportDone');
        if (doneBtn) doneBtn.disabled = false;
    }

    /* Stale-while-revalidate cache for the calendar. Last successful
       calendar-get response per client is stashed in localStorage so the
       view stays usable when the backend is choked (the Linear form burst
       can saturate n8n's executor for ~2 min). On every render we prime
       the strip from cache, then revalidate against the network — on
       failure we keep the cached view and show a small "couldn't refresh"
       badge instead of blanking to a full-page error. */
    const CAL_CACHE_KEY_PREFIX = 'syncview_calCache_v2:';
    const CAL_CACHE_TTL_MS = 7 * 24 * 60 * 60 * 1000;
    function _calCacheKey(slug) { return CAL_CACHE_KEY_PREFIX + slug; }
    function _calCacheRead(slug) {
        try {
            const authority = _writeUiAuthoritySnapshot();
            if (!authority) return null;
            const raw = localStorage.getItem(_calCacheKey(slug));
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (!parsed || !Array.isArray(parsed.posts) || !parsed.savedAt) return null;
            const hasRepair = parsed.posts.some(post => post && post._writeUiRetrySourceAt);
            if (!hasRepair && Date.now() - Number(parsed.savedAt) > CAL_CACHE_TTL_MS) return null;
            return Object.assign({}, parsed, { posts: _writeUiFilterCachedPosts(parsed.posts, authority) });
        } catch { return null; }
    }
    function _calCacheWrite(slug, posts, options) {
        if (!slug || !Array.isArray(posts)) return false;
        const key = _calCacheKey(slug);
        let priorRepairs = [];
        try {
            const prior = JSON.parse(localStorage.getItem(key) || '{}');
            const cleared = new Set(options && Array.isArray(options.clearRepairIds) ? options.clearRepairIds : []);
            priorRepairs = (Array.isArray(prior.posts) ? prior.posts : []).filter(post => post && post.id && post._writeUiRetrySourceAt && !cleared.has(post.id));
        } catch (e) {}
        const repairById = new Map(priorRepairs.map(post => [post.id, post]));
        const durablePosts = posts.map(post => (post && post._writeUiRetrySourceAt) ? post : (repairById.get(post && post.id) || post));
        const durableIds = new Set(durablePosts.map(post => post && post.id));
        priorRepairs.forEach(post => { if (!durableIds.has(post.id)) durablePosts.push(post); });
        // Persist the current collab/settings alongside the posts so the next
        // cold load can render the right shape without waiting for the network.
        const settings = Object.assign({}, CAL_SETTINGS_DEFAULTS, calState.settings || {});
        // Never persist the canonical crosswalk verdicts or read statuses: they
        // are live-lookup derived, and a copy rehydrated up to 7 days later
        // would be a stale authorization (a link repaired, broken or re-pointed
        // since the snapshot still reading as its old verdict, or a stale
        // `ready` letting an empty projection act).
        const payload = JSON.stringify({
            schema: 2,
            posts: _prodStripEphemeralCanonicalPosts(durablePosts),
            settings,
            savedAt: Date.now()
        });
        try { localStorage.setItem(key, payload); return true; }
        catch (e) {
            // QuotaExceededError or similar — drop oldest entries with our
            // prefix until the write fits.
            try {
                const entries = [];
                for (let i = 0; i < localStorage.length; i++) {
                    const k = localStorage.key(i);
                    if (!k || !k.startsWith(CAL_CACHE_KEY_PREFIX)) continue;
                    let savedAt = 0;
                    try { savedAt = Number(JSON.parse(localStorage.getItem(k) || '{}').savedAt) || 0; } catch {}
                    entries.push({ k, savedAt });
                }
                entries.sort((a, b) => a.savedAt - b.savedAt);
                for (const { k } of entries) {
                    if (k === key) continue;
                    localStorage.removeItem(k);
                    try { localStorage.setItem(key, payload); return true; } catch {}
                }
            } catch {}
            // Still failing (quota held by keys outside our prefix) — drop this
            // slug's cache rather than keep a stale snapshot seeding every boot
            // paint (same drop-on-final-fail as _sxrCacheWrite/_smCacheWrite).
            if (!priorRepairs.length) try { localStorage.removeItem(key); } catch {}
            return false;
        }
    }

    /* ============================================================
       CALENDAR v2 (Supabase realtime) — Phase 2 runtime
       ------------------------------------------------------------
       Read path: when fully configured, the calendar reads its posts
       from Supabase REST (same { ok, posts[] } shape as calendar-get,
       so the whole downstream pipeline — settings split, dedupe,
       normalize, LWW merge, render, cache — is reused unchanged) and
       subscribes to Postgres-changes realtime so a teammate's edit
       shows up without the 90 s poll. Writes still go through the
       n8n upsert webhook (Phase 1 dual-writes them to Supabase), so
       Linear sync / caption automation are untouched; the realtime
       echo is what surfaces them to every other viewer.
       Everything here is inert unless ?v2=1 AND the anon key is set.
       ============================================================ */
    /* Debug logging for the v2 realtime/merge/save path — gated, OFF by
       default. Turn on per session in the console with `_calV2Debug = true`,
       or with ?v2debug=1 (sticky); ?v2debug=0 clears it. Produces zero output
       for normal users. Added 2026-06-14 to diagnose the Kasper→SMM
       status-revert/clobber (a stale local copy winning the merge, then being
       saved back over a fresh approval). */
    let _calV2DebugLS = null;
    function _calV2DebugOn() {
        if (window._calV2Debug === true) return true;
        if (window._calV2Debug === false) return false;
        if (_calV2DebugLS !== null) return _calV2DebugLS;
        let on = false;
        try {
            const q = new URLSearchParams(location.search).get('v2debug');
            if (q === '1') { on = true; localStorage.setItem('syncview_cal_v2debug', '1'); }
            else if (q === '0') { on = false; localStorage.removeItem('syncview_cal_v2debug'); }
            else on = (localStorage.getItem('syncview_cal_v2debug') === '1');
        } catch {}
        _calV2DebugLS = on;
        return on;
    }
    function _calV2Log() {
        try {
            if (!_calV2DebugOn()) return;
            const a = ['[calV2 ' + new Date().toISOString().slice(11, 23) + ']'];
            for (let i = 0; i < arguments.length; i++) a.push(arguments[i]);
            console.log.apply(console, a);
        } catch (e) {}
    }
    let _calV2FlagCache = null;
    function _calV2Enabled() {
        if (_calV2FlagCache !== null) return _calV2FlagCache;
        // Phase 3 (2026-06-14): v2 is now the DEFAULT. With no query param it is
        // ON unless this browser opted out via ?v2=0 (which sets a sticky
        // kill-switch). ?v2=1 force-enables and clears a prior opt-out.
        // Rollback for everyone = flip this default back to false; rollback for
        // one browser = ?v2=0.
        let on = true;
        try {
            const q = new URLSearchParams(location.search).get('v2');
            if (q === '0' || q === 'false') { on = false; try { localStorage.setItem(CAL_V2_KILL_KEY, '1'); localStorage.removeItem(CAL_V2_LS_KEY); } catch {} }
            else if (q === '1' || q === 'true') { on = true; try { localStorage.setItem(CAL_V2_LS_KEY, '1'); localStorage.removeItem(CAL_V2_KILL_KEY); } catch {} }
            else { on = (localStorage.getItem(CAL_V2_KILL_KEY) !== '1'); }
        } catch { on = true; }
        _calV2FlagCache = on;
        return on;
    }
    function _calV2Ready() {
        return _calV2Enabled() && !!CAL_SUPABASE_URL && !!CAL_SUPABASE_ANON_KEY;
    }
    /* Lazy-load supabase-js (UMD) the first time the realtime path is
       actually used — never on a normal load — then memoize the client.
       Any failure resolves to null so callers fall back to the n8n read. */
    let _calV2LibPromise = null;
    let _calV2ClientObj = null;
    let _calV2ClientPromise = null;
    function _calV2LoadLib() {
        if (window.supabase && window.supabase.createClient) return Promise.resolve(window.supabase);
        if (_calV2LibPromise) return _calV2LibPromise;
        _calV2LibPromise = new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = CAL_SUPABASE_LIB_URL; s.async = true;
            s.onload = () => resolve((window.supabase && window.supabase.createClient) ? window.supabase : null);
            s.onerror = () => { _calV2LibPromise = null; reject(new Error('supabase-js failed to load')); };
            document.head.appendChild(s);
        });
        return _calV2LibPromise;
    }
    function _calV2Client() {
        if (!_calV2Ready()) return Promise.resolve(null);
        if (_calV2ClientObj) return Promise.resolve(_calV2ClientObj);
        if (_calV2ClientPromise) return _calV2ClientPromise;
        _calV2ClientPromise = _calV2LoadLib().then(lib => {
            if (!lib || !lib.createClient) return null;
            _calV2ClientObj = lib.createClient(CAL_SUPABASE_URL, CAL_SUPABASE_ANON_KEY, {
                auth: { persistSession: false, autoRefreshToken: false },
                realtime: { params: { eventsPerSecond: 5 } }
            });
            return _calV2ClientObj;
        }).catch(e => { console.warn('[Calendar v2] supabase-js init failed', e); _calV2ClientPromise = null; return null; });
        return _calV2ClientPromise;
    }
    /* PostgREST caps every response at the project's db-max-rows (1000 here)
       no matter how large a `limit` the client asks for, so a single read
       silently drops every row past the first 1000 — which once the table
       crossed 1000 rows hid freshly-added cards from Kasper's unscoped queue
       (and would hide a heavy client's cards from the calendar). Page through
       with KEYSET (cursor) pagination — immune to the offset-window drift that
       skips/dups rows when the LIVE table is written between page reads.

       COMPOUND cursor on (id, client): `id` is NOT globally unique — the same
       id is reused across different clients (rows are keyed by (client, id), not
       id alone; e.g. a template applied to several clients reuses one id). An
       id-only cursor (`id=gt.X`) would skip every sibling of a same-id group
       that happened to straddle a 1000-row page boundary. (id, client) IS
       unique, so the compound cursor "(id,client) > (curId,curClient)" never
       skips or duplicates a row. Requires the caller's `select` to include id
       AND client — the production callers use `select=*`. The `signal` threads
       the caller's abort/timeout through every page. Caller passes a URL WITHOUT
