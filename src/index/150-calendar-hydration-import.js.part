    async function _calSupabaseFetchAllRows(baseUrl, signal) {
        const sep = baseUrl.indexOf('?') >= 0 ? '&' : '?';
        const headers = { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' };
        const enc = encodeURIComponent;
        const all = [];
        let curId = null, curClient = null;
        for (let page = 0; page < 100000; page++) {     // hard ceiling: 100,000,000 rows
            let pageUrl = baseUrl + sep + 'order=id.asc,client.asc&limit=' + CAL_SUPABASE_PAGE;
            if (curId != null) {
                // (id, client) strictly greater than the last row seen
                pageUrl += '&or=(id.gt.' + enc(curId) + ',and(id.eq.' + enc(curId) + ',client.gt.' + enc(curClient == null ? '' : curClient) + '))';
