            }
            // Centre horizontally in the strip but never yank the page
            // vertically (block:center scrolled the whole page down on open).
            card.scrollIntoView({ behavior: 'auto', inline: 'center', block: 'nearest' });
            // One correction for the shift that happens AFTER the scroll rather
            // than during it -- late thumbnails, a re-render, a lazy row. Guarded
            // on the element still being in the document so a repaint that
            // replaced the card cannot scroll to a detached node.
            setTimeout(() => {
                if (!document.body.contains(card)) return;
                const box = card.getBoundingClientRect();
                const width = window.innerWidth || document.documentElement.clientWidth || 0;
                if (box.right <= 0 || box.left >= width) {
                    card.scrollIntoView({ behavior: 'auto', inline: 'center', block: 'nearest' });
                }
            }, 400);
        };
        requestAnimationFrame(focusWhenPainted);
    }

    /* ── The Organize menu ──────────────────────────────────────────────────
       One toolbar pill holding everything that decides WHAT the Sheet shows
       and IN WHAT ORDER: the ordering mode (manual vs auto-by-date), the month
       filter, and the content filter. Before this it was two separate pills
       ("All months" / "All content") with no ordering control at all.

       The trigger stays informative so collapsing three controls into one menu
       doesn't cost at-a-glance state: it names whatever is non-default
       ("By date · July 2026") and only falls back to the word "Organize" when
       everything sits at its default. */
    function _calOrganizeTriggerLabel() {
        const parts = [];
        if (_calIsAutoSortOn()) parts.push('By date');
        const m = _calNormMonthFilter(calState.monthFilter);
        if (m !== 'all') parts.push(_calMonthLabel(m));
        const s = _calNormStatusFilter(calState.statusFilter);
        if (s !== 'all') parts.push(_calStatusFilterLabel(s));
        return parts.length ? parts.join(' · ') : 'Organize';
    }
    function _calOrganizeIsActive() {
        return _calIsAutoSortOn()
            || _calNormMonthFilter(calState.monthFilter) !== 'all'
            || _calNormStatusFilter(calState.statusFilter) !== 'all';
    }
    /* Order section. The row is a real ARIA switch, and its own label is the
       help trigger (shared data-tip) rather than an info icon beside it — see
       docs/features/UI_DESIGN_STANDARDS.md, "Explain through the label". */
    function _calOrganizeOrderSectionHtml() {
        const on = _calIsAutoSortOn();
        const tip = 'Orders the Sheet by scheduled date — oldest first, with unscheduled posts at the end. '
            + 'Your own drag-and-drop order is kept exactly as it is; turn this off to get it back.';
        return `<button type="button" class="dropdown-item cal-org-toggle" role="menuitemcheckbox" aria-checked="${on ? 'true' : 'false'}"
                data-sv-explain data-tip="${_calEscAttr(tip)}" onclick="onCalSortModeToggle(event)">
            <span class="cal-org-toggle-txt">
                <span class="cal-org-toggle-name">Auto-organize by date</span>
                <span class="cal-org-toggle-sub">${on ? 'Oldest first · unscheduled last' : 'Off — your drag order'}</span>
            </span>
            <span class="cal-kebab-switch${on ? ' is-on' : ''}" id="calOrgSortSwitch" aria-hidden="true"></span>
        </button>`;
    }
    function _calOrganizeMonthSectionHtml() {
        const cur = _calNormMonthFilter(calState.monthFilter);
        const today = _calCurrentMonthIso();
        const prev  = _calShiftMonthIso(today, -1);
        const next  = _calShiftMonthIso(today,  1);
        const isPreset = cur === 'all' || cur === prev || cur === today || cur === next;
        const mkItem = (val, label, tag) => `<button type="button" class="dropdown-item${val === cur ? ' active' : ''}" role="menuitemradio" aria-checked="${val === cur ? 'true' : 'false'}" onclick="onCalMonthFilterChange('${val}')"><span>${_calEsc(label)}</span>${tag || ''}</button>`;
        const customLabel = !isPreset ? `Custom · ${_calMonthLabel(cur)}` : 'Custom…';
        const customVal = !isPreset ? cur : '';
        const customItem = `<div class="dropdown-item cal-month-filter-custom${!isPreset ? ' active' : ''}">
            <span>${_calEsc(customLabel)}</span>
            <input type="month" class="cal-month-filter-custom-input" value="${_calEscAttr(customVal)}" onchange="onCalMonthFilterChange(this.value)" onclick="event.stopPropagation()" aria-label="Pick a month">
        </div>`;
        return [
            mkItem('all', 'All months'),
            mkItem(prev,  _calMonthLabel(prev),  '<span class="cal-month-filter-tag">Previous</span>'),
            mkItem(today, _calMonthLabel(today), '<span class="cal-month-filter-tag">This month</span>'),
            mkItem(next,  _calMonthLabel(next),  '<span class="cal-month-filter-tag">Next</span>'),
            customItem,
        ].join('');
    }
    function _calOrganizeContentSectionHtml() {
        const cur = _calNormStatusFilter(calState.statusFilter);
        return ['all', 'scheduled', 'unscheduled'].map(val =>
            `<button type="button" class="dropdown-item${val === cur ? ' active' : ''}" role="menuitemradio" aria-checked="${val === cur ? 'true' : 'false'}" onclick="onCalStatusFilterChange('${val}')"><span>${_calStatusFilterLabel(val)}</span></button>`
        ).join('');
    }
    function _calOrganizeHtml() {
        if (!calState.client || calState.view !== 'organizer') return '';
        const chev = `<svg class="dd-arrow" width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 3.5L5 7l3.5-3.5"/></svg>`;
        const tune = `<svg class="cal-org-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M2 4.5h4.2M11.3 4.5H14M2 11.5h2.7M9.8 11.5H14"/><circle cx="8.7" cy="4.5" r="2.1"/><circle cx="7.3" cy="11.5" r="2.1"/></svg>`;
        return `<div class="cal-month-filter cal-organize" id="calOrganizeWrap">
            ${_calMonthWarnChipHtml()}
            <button type="button" class="dropdown-trigger${_calOrganizeIsActive() ? ' is-filtered' : ''}" id="calOrganizeBtn" onclick="_calToggleOrganizeMenu(event)" title="Choose how the Sheet is ordered and which posts it shows" aria-haspopup="menu" aria-expanded="false">
                ${tune}<span class="cal-org-trigger-txt">${_calEsc(_calOrganizeTriggerLabel())}</span>${chev}
            </button>
            <div class="dropdown-menu cal-org-menu" id="calOrganizeMenu" role="menu" aria-label="Organize the Sheet">
                <div class="cal-org-sec" id="calOrgSecOrder">Order</div>
                <div role="group" aria-labelledby="calOrgSecOrder">${_calOrganizeOrderSectionHtml()}</div>
                <div class="cal-org-sep" role="separator"></div>
                <div class="cal-org-sec" id="calOrgSecMonth">Month</div>
                <div role="group" aria-labelledby="calOrgSecMonth">${_calOrganizeMonthSectionHtml()}</div>
                <div class="cal-org-sep" role="separator"></div>
                <div class="cal-org-sec" id="calOrgSecContent">Content</div>
                <div role="group" aria-labelledby="calOrgSecContent">${_calOrganizeContentSectionHtml()}</div>
            </div>
        </div>`;
    }
    function _calSetOrganizeOpen(open, opts) {
        const menu = document.getElementById('calOrganizeMenu');
        const btn  = document.getElementById('calOrganizeBtn');
        if (!menu || !btn) return;
        menu.classList.toggle('open', !!open);
        btn.classList.toggle('open', !!open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) _calWireOrganizeDismiss();
        else if (opts && opts.focusTrigger) btn.focus();
    }
    function _calToggleOrganizeMenu(e) {
        if (e) e.stopPropagation();
        const menu = document.getElementById('calOrganizeMenu');
        if (!menu) return;
        _calSetOrganizeOpen(!menu.classList.contains('open'));
    }
    /* One persistent pair of document listeners rather than a per-open closure.

       The click listener runs in the CAPTURE phase deliberately. Half the
       controls on a card stop click propagation (thumb, caption, link fields,
       status pills), so a bubble-phase listener never sees a click that lands
       on one — the menu would stay stuck open over the strip until you clicked
       some inert patch of page. Capture sees every click before any of them.

       The detached-target guard covers the other direction: a capture-phase
       listener elsewhere may re-render the control mid-dispatch, and a target
       that is no longer in the document can't be tested for containment. */
    let _calOrgDismissWired = false;
    function _calWireOrganizeDismiss() {
        if (_calOrgDismissWired) return;
        _calOrgDismissWired = true;
        document.addEventListener('click', (ev) => {
            const menu = document.getElementById('calOrganizeMenu');
            if (!menu || !menu.classList.contains('open')) return;
            const t = ev.target;
            if (t && t.nodeType === 1 && !t.isConnected) return;   // node this click just re-rendered
            const wrap = document.getElementById('calOrganizeWrap');
            if (wrap && wrap.contains(t)) return;
            _calSetOrganizeOpen(false);
        }, true);
        document.addEventListener('keydown', (ev) => {
            if (ev.key !== 'Escape') return;
            const menu = document.getElementById('calOrganizeMenu');
            if (!menu || !menu.classList.contains('open')) return;
            _calSetOrganizeOpen(false, { focusTrigger: true });
        });
    }
    /* Rebuild the pill in place, preserving whether the menu was open — the
       menu is a settings panel, so changing one thing in it shouldn't slam it
       shut before you change the next. */
