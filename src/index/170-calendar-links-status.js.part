        if (typeof _svSyncStepper === 'function') _svSyncStepper('calNativePostCount');
        _calNativeSyncReceipt();
    }
    function _calSetNativePostMode(mode) {
        const state = _calNativePostState;
        if (!state || !['video', 'thumbnail', 'both'].includes(mode)) return;
        const selected = document.querySelector('input[name="calNativeBatchChoice"]:checked');
        state.batchChoice = selected
            ? { value: selected.value, batchId: String(selected.dataset.batchId || '') }
            : null;
        state.mode = mode;
        _calRenderNativePostChoice();
    }
    function _calSetNativePostEditor() {
        const state = _calNativePostState;
        if (!state) return;
        // sv-select writes the chosen value into a hidden input named by its id.
        const input = document.getElementById('calNativeEditor');
        const chosen = String(input && input.value || '');
        if (chosen && !(state.videoEditors || []).some(editor => editor.id === chosen)) return;
        // Preserve the batch radio the same way the mode switch does, since
        // this also re-renders the whole dialog body.
        const selected = document.querySelector('input[name="calNativeBatchChoice"]:checked');
        state.batchChoice = selected
            ? { value: selected.value, batchId: String(selected.dataset.batchId || '') }
            : null;
        state.videoEditorId = chosen;
        _calRenderNativePostChoice();
    }
    /* Option E (2026-08-18): the previous-batch dropdown is the source of
       truth for WHICH batch; this keeps the card's radio carrying the same
       data-batch-id the submit path has always read. Touching the dropdown
       also selects the card, so picking a batch never needs a second click.
       A label does not forward clicks on an interactive descendant to its
       radio, hence the explicit mousedown hook. */
    function _calNativePrevBatchPick(sel, check) {
        const radio = document.getElementById('calNativePrevBatchRadio');
        if (!radio || !sel) return;
        radio.dataset.batchId = String(sel.value || '');
        if (check) radio.checked = true;
        /* A REFUSAL OUTLIVES THE THING IT REFUSED (Codex P2 on PR 1353).
           Nothing hid this box again except a full re-render, so after Create
           said the search matched no batches, clearing the query re-aimed the
           radio and left the dialog showing a chosen batch above a message
           insisting none was chosen. Every complaint the box can hold here is
           about the batch that WAS aimed at -- no target, or one this post
           shape cannot use -- so re-aiming is exactly the moment it stops
           being true. The tab switch already clears it: the render emits this
           element hidden. */
        const errorBox = document.getElementById('calNativePostError');
        if (errorBox) { errorBox.hidden = true; errorBox.textContent = ''; }
        _calNativeSyncReceipt();
    }
    /*
     * FILTER THE BATCH LIST BY NAME (owner request 2026-08-26: "could we make
     * it so people can also search by name").
     *
     * A <select> already type-aheads, but only by PREFIX — and every option
     * here begins with the same client name ("Jenna Phillips Ballard · …",
     * "JENNA PB | …"), so typing J cycles uselessly through all of them. What
     * people actually know is the middle of the name: "episode 09".
     *
     * Rebuilds the option list rather than hiding <option> elements, because
     * `display:none` on an option is ignored by Safari — hiding would look
     * right in Chrome and silently do nothing on a Mac, which is the same
     * class of bug as the cap this replaces.
     */
    function _calNativeBatchMatches(batch, query) {
        const q = String(query || '').trim().toLowerCase();
        if (!q) return true;
        const name = _calNativeBatchDisplayName(batch).toLowerCase();
        // Every whitespace-separated term must appear somewhere in the name, so
        // "ep 09" and "09 episode" both find "JENNA PB | Episode 09".
        return q.split(/\s+/).filter(Boolean).every(term => name.includes(term));
    }
    function _calNativeBatchFilter(input) {
        const state = _calNativePostState;
        if (!state || !input) return;
        state.batchFilter = String(input.value || '');
        const select = document.querySelector('.cal-native-batch-select');
        const empty = document.getElementById('calNativeBatchFilterEmpty');
        if (!select) return;
        const mode = ['video', 'thumbnail', 'both'].includes(state.mode) ? state.mode : 'both';
        const all = _calNativeBatchLists(state.batchOptions, mode, state.batchPostCounts).compatible;
        const shown = all.filter(batch => _calNativeBatchMatches(batch, state.batchFilter));
        const keep = String(select.value || '');
        select.innerHTML = _calNativeBatchOptionsHtml(shown, all, state.batchPostCounts,
            shown.some(batch => String(batch.id || '') === keep) ? keep : String(shown.length ? shown[0].id || '' : ''));
        select.disabled = !shown.length;
        if (empty) empty.style.display = shown.length ? 'none' : '';
        // Keep the radio pointing at whatever the select now shows, so a
        // filtered-then-submitted post cannot append to a batch nobody sees.
        if (shown.length) { _calNativePrevBatchPick(select, false); _calNativeSyncReceipt(); return; }
        /* ZERO MATCHES LEFT A LIVE TARGET (Codex P1 on PR 1353). Disabling the
           select was not enough: the radio kept the id of the last batch the
           list showed and stayed checked, so Create still appended the post to
           a batch the no-match line said was not there. Clearing the id is the
           safety half -- the submit path's own guard then refuses, because it
           resolves the batch by that id before it writes anything. */
        const stale = document.getElementById('calNativePrevBatchRadio');
        if (stale) stale.dataset.batchId = '';
        _calNativeSyncReceipt();
    }
    /* Below this many batches the list is short enough to read at a glance and
       a search box is just another control in the way. Above it, scanning is
       the problem the box exists to solve. */
    const CAL_NATIVE_BATCH_FILTER_MIN = 6;
    /* Assigned during render and reused by the filter, so the filtered list and
       the first paint can never drift into two different option formats. */
    let _calNativeBatchOptionsHtml = () => '';
    function _calSetNativeBatchOptionsHtml(value) { _calNativeBatchOptionsHtml = value; }
    const CAL_NATIVE_BATCH_COUNT_TIMEOUT_MS = 4000;
    /* Every uuid these batches record as a PARENT.
     *
     * The B1 import writes a deliverable row for the parent issue itself and
     * files it inside the batch, so a batch parent is indistinguishable from
     * work by row shape alone. This set is the distinguisher, and it is read
     * from the batch rows already in hand, so no consumer needs a second
     * network round trip to be correct. */
    function _calNativeParentUuids(batches) {
        const uuids = new Set();
        (Array.isArray(batches) ? batches : []).forEach(batch => {
            const parents = batch && batch.linear_parent_ids;
            if (!parents || typeof parents !== 'object') return;
            const entries = Array.isArray(parents) ? parents : Object.keys(parents).map(key => parents[key]);
            entries.forEach(entry => {
                const uuid = String(entry && (entry.uuid || entry.id || entry.linear_issue_id) || '').trim();
                if (uuid) uuids.add(uuid);
            });
        });
        return uuids;
    }
