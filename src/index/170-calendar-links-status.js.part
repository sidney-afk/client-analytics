        const names = document.getElementById('calNativePostNames');
        if (names) names.innerHTML = _calNativePostNamesHtml(state, state.postCount, mode);
        const input = document.getElementById('calNativePostCount');
        if (input && String(state.postCount) !== String(input.value) && document.activeElement !== input) {
