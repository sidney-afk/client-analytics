    function _calSetNativePostCount(raw) {
        const state = _calNativePostState;
        if (!state) return;
        const mode = ['video', 'thumbnail', 'both'].includes(state.mode) ? state.mode : 'both';
        const max = _calNativePostCountMax(mode);
        const parsed = Math.floor(Number(raw));
        state.postCount = (!Number.isFinite(parsed) || parsed < 1) ? 1 : Math.min(parsed, max);
        /* One field per post, so the list has to follow the count. This is a
           surgical rebuild rather than _calRenderNativePostChoice() because the
           stepper can be held down: a full re-render per repeat would throw the
           dialog away under the pointer. Typed names survive it -- they live in
           state.postNames, and _calNativePostNamesFor keeps the ones the count
           has stepped past, so 3 -> 1 -> 3 gives the third name back. */
        const namesLabel = document.getElementById('calNativePostNamesLabel');
        if (namesLabel) namesLabel.innerHTML = (state.postCount === 1 ? 'Post name' : 'Post names')
