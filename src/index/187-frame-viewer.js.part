import { CAL_SUPABASE_ANON_KEY, CAL_SUPABASE_URL, _syncviewRequireStaffIdentity } from './100-onboarding-staff-controls.js';
import { _calRuntimeFlagClient, _calRuntimeFlagRawMembers, _calRuntimeFlagSlug, _syncviewEfHeaders } from './120-calendar-flags-write-repair.js';
import { calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    /* WATCH HERE: a card's Frame.io video, inside SyncView, behind the frame_viewer_clients switch.

       ONE view for the video and its notes (owner, 2026-10-16): the card's Notes dialog, with the player on the
       left and the notes on the right (on a phone the video on top and the notes below). It opens the same way
       from every door: the Notes button, the Sheet thumbnail's play icon, the Review tab's video preview and
       Kasper's "Watch here". Staff, Kasper and the client link get the same view; a client link never sees the
       Frame.io comments (the frameio-view function only gives it the playable address of its own card).

       Opening it never plays anything: the video plays only when the person presses play, the button at the
       bottom centre of the player. Until the address arrives the poster shows with a quiet loading line, and the
       Frame.io comments (staff) arrive as rows in the notes list, in time order with the notes, each marked
       "Frame.io"; a comment's video time jumps the player there.

       This file owns the player and the Frame.io comments; the Notes dialog (190) owns the notes and asks this
       file for the stage (svFrameStageMount) and for the Frame.io rows (svFrameFeed). Read only: replying to a
       Frame.io comment stays in Frame.io, and nothing the function returns is saved by the page.

       If anything fails, the player says so in a sentence, with Try again, and the Frame.io link keeps working. */
    const FRAMEIO_VIEW_EF_URL = CAL_SUPABASE_URL + '/functions/v1/frameio-view';
    const FV_FETCH_MS = 45000;
    // The three link shapes the function understands. Anything else gets no player.
    const FV_LINK_RE = /https?:\/\/(?:f\.io\/[A-Za-z0-9_-]{3,40}|next\.frame\.io\/(?:share|project)\/[0-9a-f-]{36}[^\s<>"']*)/i;
    function _fvLinkOf(raw) {
        const m = String(raw || '').match(FV_LINK_RE);
        return m ? m[0].replace(/[),.;]+$/, '') : '';
    }
    const FV_PLAY_ICO = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 2.7v10.6a.5.5 0 0 0 .76.43l8.6-5.3a.5.5 0 0 0 0-.86l-8.6-5.3a.5.5 0 0 0-.76.43z"/></svg>';

    /* WHO SEES IT: one runtime flag row, read the way the per-client flags are read (a bounded read with the
       public key, then a realtime channel). Key frame_viewer_clients, value { "all": false, "clients": [...] }.
       It fails closed: a missing row, a value of the wrong shape, a failed read or a deleted row all mean hidden.
       The list lives only in the database, never in this repo. A client link never reads it at all.

       The buttons are always drawn (so a later flip needs no repaint of the cards) but carry the hidden
       attribute unless the flag allows their card's client; hidden is display none, so with the flag off the
       page looks exactly as it did before the viewer existed. */
    const FRAME_VIEWER_FLAG_KEY = 'frame_viewer_clients';
    const FV_FLAG_TIMEOUT_MS = 4000;
    const FV_FLAG_RETRY_MS = 30000;
    let _fvFlag = { all: false, clients: new Set() };
    let _fvFlagPromise = null;
    let _fvFlagChannel = null;
    let _fvFlagTriedAt = 0;
    let _fvFlagRead = false;   // the switch has been read once (on or off); until then nobody knows whether a card gets the player

    // The flag row's value to the answer. Only exact shapes open anything: all must be literally true, and the
    // clients must be a list of strings.
    function _fvFlagParse(value) {
        if (!value || typeof value !== 'object' || Array.isArray(value)) return { all: false, clients: new Set() };
        const members = _calRuntimeFlagRawMembers(value) || [];
        return { all: value.all === true, clients: new Set(members.map(m => _calRuntimeFlagSlug(m)).filter(Boolean)) };
    }
    function _fvFlagSlugOf(clientOrSlug) {
        let slug = '';
        try { slug = calClientSlug(String(clientOrSlug == null ? '' : clientOrSlug)); } catch (e) { slug = ''; }
        return slug || '';
    }
    function _fvEnabledFor(clientOrSlug) {
        if (_fvFlag.all === true) return true;
        const slug = _fvFlagSlugOf(clientOrSlug);
        return !!slug && _fvFlag.clients.has(slug);
    }
    function _fvSyncButtons() {
        document.querySelectorAll('.fv-gated').forEach((b) => {
            if (_fvEnabledFor(b.getAttribute('data-fv-client'))) b.removeAttribute('hidden');
            else b.setAttribute('hidden', '');
        });
        document.querySelectorAll('[data-fv-tile]').forEach((t) => {
            const on = _fvEnabledFor(t.getAttribute('data-fv-client'));
            if (on) { t.setAttribute('data-fv-on', ''); t.setAttribute('aria-label', 'Watch the video with its notes'); }
            else { t.removeAttribute('data-fv-on'); t.setAttribute('aria-label', 'Open video'); }
        });
    }
    function _fvFlagSet(value) {
        _fvFlagRead = true;
        _fvFlag = _fvFlagParse(value);
        _fvSyncButtons();
        // The Notes view re-checks its player: the switch turning on or off for its card shows or removes it.
        try { window.dispatchEvent(new Event('sv-frame-switch')); } catch (e) {}
    }
    async function _fvFlagFetch() {
        if (!CAL_SUPABASE_URL || !CAL_SUPABASE_ANON_KEY) { _fvFlagSet(null); return; }
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timer = ctrl ? setTimeout(() => { try { ctrl.abort(); } catch (e) {} }, FV_FLAG_TIMEOUT_MS) : null;
        try {
            const url = CAL_SUPABASE_URL + '/rest/v1/syncview_runtime_flags?select=value&key=eq.' + encodeURIComponent(FRAME_VIEWER_FLAG_KEY) + '&limit=1';
            const resp = await fetch(url, { cache: 'no-store', signal: ctrl ? ctrl.signal : undefined, headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' } });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const rows = await resp.json();
            if (!Array.isArray(rows)) throw new Error('shape');
            _fvFlagSet(rows[0] && rows[0].value ? rows[0].value : null);
        } catch (e) {
            _fvFlagSet(null);
            _fvFlagPromise = null;   // a later render may try again (not sooner than FV_FLAG_RETRY_MS)
            console.warn('[Frame viewer] switch unreadable; the viewer stays hidden', e && e.message);
        } finally { if (timer) clearTimeout(timer); }
    }
    async function _fvFlagSubscribe() {
        if (_fvFlagChannel) return;
        const client = await _calRuntimeFlagClient();
        if (!client || _fvFlagChannel) return;
        try {
            _fvFlagChannel = client
                .channel('syncview-frame-viewer-flag')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'syncview_runtime_flags', filter: 'key=eq.' + FRAME_VIEWER_FLAG_KEY }, (payload) => {
                    // A delete arrives with no new row: that is off.
                    const row = payload && payload.new ? payload.new : null;
                    _fvFlagSet(row && row.value ? row.value : null);
                })
                .subscribe();
        } catch (e) {
            console.warn('[Frame viewer] realtime subscribe failed', e);
            _fvFlagChannel = null;
        }
    }
    // Once per page (again after a failed read, at most every 30 seconds). Client link pages read it too, because
    // the Review tab's video preview opens the same view for them; the server checks the same switch before it answers.
    /* Before a view that may hold the player paints (session Curtain Nine, owner feedback 2026-10-17): starts reading
       the switch, and answers null when it is already read, or a promise that settles when it is (or after `ms`).
       The Notes view on a switched-on client link waits on it, so it never paints the old dialog first. */
    function svFrameFlagWait(ms) {
        _fvPrimeFlag();
        if (_fvFlagRead || !_fvFlagPromise) return null;
        return Promise.race([_fvFlagPromise.catch(() => null), new Promise(r => setTimeout(r, Math.max(0, ms || 0)))]);
    }
    function _fvPrimeFlag() {
        if (_fvFlagPromise) return;
        if (Date.now() - _fvFlagTriedAt < FV_FLAG_RETRY_MS && _fvFlagTriedAt) return;
        _fvFlagTriedAt = Date.now();
        _fvFlagPromise = _fvFlagFetch();
        _fvFlagPromise.then(() => _fvFlagSubscribe()).catch(() => null);
    }
    /* THE DOORS. The Sheet thumbnail's play icon and Kasper's "Watch here" (staff only), and the Review tab's video
       preview (staff and client link). They are always drawn (so a later flip of the switch needs no repaint) but do
       nothing new unless the switch allows their card's client: the icon and the button carry the hidden attribute,
       and the preview stays a plain link to the video, exactly as before the viewer existed. With the switch on, each
       one opens the card's Notes view with the player (svOpenCardNotes, 326). Pointing at one (hover, focus, press,
       touch) starts the slow part at once: the function's answer and the first bytes of the video are fetched while
       the click is still on its way (svFrameIntent). */
    // No hover tooltip on a door (owner, 2026-10-17: no "Watch the video with its notes" over the player); the play
    // icon keeps that sentence as its spoken name, and "Watch here" says what it does on its face.
    function _fvOpenerHtml(rawLink, title, cls, client, inner, label, cardId) {
        if (_isClientLink) return '';
        const link = _fvLinkOf(rawLink);
        if (!link || !cardId) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const hidden = _fvEnabledFor(who) ? '' : ' hidden';
        return `<button type="button" class="${_calEscAttr(cls)} fv-gated" data-fv-client="${_calEscAttr(who)}" data-fv-link="${_calEscAttr(link)}" data-fv-title="${_calEscAttr(title || '')}" data-fv-card="${_calEscAttr(cardId || '')}"${hidden}${label ? ` aria-label="${_calEscAttr(label)}"` : ''} onpointerenter="svFrameIntent(this,120)" onfocus="svFrameIntent(this,0)" onpointerdown="svFrameIntent(this,0)" ontouchstart="svFrameIntent(this,0)" onclick="event.stopPropagation();svFrameOpen(this)">${inner}</button>`;
    }
    function svFrameWatchBtnHtml(rawLink, title, cls, client, cardId) {
        return _fvOpenerHtml(rawLink, title, cls || 'fv-watch-btn', client, `${FV_PLAY_ICO}<span>Watch here</span>`, '', cardId);
    }
    // The Sheet's thumbnail: a small play icon, top centre, shown on hover (always on a phone).
    function svFramePlayIconHtml(rawLink, title, client, cardId) {
        return _fvOpenerHtml(rawLink, title, 'cal-thumb-play', client, FV_PLAY_ICO, 'Watch the video with its notes', cardId);
    }
    // A card's link can change while its thumbnail stays on screen: keep the icon pointing at the card's current video.
    function svFrameSyncPlayIcon(thumbDiv, post) {
        if (_isClientLink || !thumbDiv) return;
        const want = _fvLinkOf(post && post.asset_url);
        const cur = thumbDiv.querySelector('.cal-thumb-play');
        if (cur && want && cur.getAttribute('data-fv-link') === want) { cur.setAttribute('data-fv-title', (post && post.name) || ''); return; }
        if (cur) cur.remove();
        if (want) thumbDiv.insertAdjacentHTML('beforeend', svFramePlayIconHtml(post.asset_url, post.name, post.client, post.id));
    }
    /* AUTOPLAY FROM A PLAY BUTTON (owner, 2026-10-17 23:20, session Curtain Seven). A video opened from a play button
       (a card's play icon on Sheet, Month and Week, the Review tab's preview, Kasper's "Watch here") starts playing
       at once; one opened from the notes (the Notes button, a note's link, Messages) waits for its play button, as
       before. The door leaves this mark for the card; the Notes view's player takes it when it mounts for that card
       (svFrameStageMount), and any other mount clears it. */
    let _fvAutoIntent = null;
    const FV_AUTO_MS = 20000;
    function _fvMarkAutoplay(pid) { _fvAutoIntent = pid ? { pid, at: Date.now() } : null; }
    async function svFrameOpen(btn) {
        if (_isClientLink || !btn || !btn.getAttribute) return;
        const pid = btn.getAttribute('data-fv-card') || '';
        if (!pid || !_fvLinkOf(btn.getAttribute('data-fv-link'))) return;
        _fvMarkAutoplay(pid);
        // A click can land before the switch has been read: wait for that one read (bounded), then decide.
        _fvPrimeFlag();
        if (_fvFlagPromise) { try { await _fvFlagPromise; } catch (e) {} }
        if (!_fvEnabledFor(btn.getAttribute('data-fv-client'))) return;
        if (typeof window.svOpenCardNotes !== 'function') return;
        btn.setAttribute('aria-busy', 'true');
        try { await window.svOpenCardNotes(btn.getAttribute('data-fv-client') || '', pid); }
        finally { btn.removeAttribute('aria-busy'); }
    }

    /* THE REVIEW TAB: the video preview stays a normal link to the video; with the switch on it is marked data-fv-on
       and a click opens the Notes view with the player instead (a modified click still opens the link). */
    function svFrameTileAttrs(rawLink, client, cardId, poster) {
        const link = _fvLinkOf(rawLink);
        if (!link) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const on = _fvEnabledFor(who);
        return ` data-fv-tile${on ? ' data-fv-on' : ''} data-fv-client="${_calEscAttr(who)}" data-fv-link="${_calEscAttr(link)}" data-fv-card="${_calEscAttr(cardId || '')}" data-fv-poster="${_calEscAttr(poster || '')}" onpointerenter="svFrameIntent(this,120)" onpointerdown="svFrameIntent(this,0)" ontouchstart="svFrameIntent(this,0)" onclick="return svFrameTileOpen(event,this)"`;
    }
    function svFrameTileLabelHtml(rawLink) {
        if (!_fvLinkOf(rawLink)) return '<span class="cal-review-video-label">Open video ↗</span>';
        return '<span class="cal-review-video-label fv-lbl-off">Open video ↗</span><span class="cal-review-video-label fv-lbl-on">Watch video</span>';
    }
    function svFrameTileOpen(ev, tile) {
        if (!tile) return true;
        if (ev && (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.altKey || ev.button === 1)) return true;
        // A click before the switch has been read must not be lost to the old link: hold it for the one bounded read,
        // then open the viewer or the link, whichever the switch says (the Sheet's door on a client link can be
        // clicked straight after the page paints).
        if (!tile.hasAttribute('data-fv-on') && !_fvFlagRead && _fvFlagPromise && tile.hasAttribute('data-fv-tile')) {
            if (ev && ev.preventDefault) ev.preventDefault();
            if (ev && ev.stopPropagation) ev.stopPropagation();
            const href = tile.getAttribute('href') || '';
            /* Wait at most 0.7 s: a link opened later than that, from a network callback, can be blocked as a popup
               (Safari keeps a click's permission for about 1 s). If the switch has not answered by then, the click
               opens the link, as it did before the viewer existed (Codex review of PR 2209). */
            let done = false;
            const decide = () => {
                if (done) return; done = true;
                if (_fvFlagRead && _fvEnabledFor(tile.getAttribute('data-fv-client'))) { tile.setAttribute('data-fv-on', ''); svFrameTileOpen(null, tile); }
                else if (href) window.open(href, '_blank', 'noopener');
                else { const host = tile.closest && tile.closest('button'); if (host) host.click(); }   // a Month or Week thumbnail with the viewer off: the click was held, so it opens the small preview now
            };
            _fvFlagPromise.catch(() => null).then(decide);
            setTimeout(decide, 700);
            return false;
        }
        if (!tile.hasAttribute('data-fv-on')) return true;
        const pid = tile.getAttribute('data-fv-card') || '';
        if (!pid || !_fvLinkOf(tile.getAttribute('data-fv-link')) || typeof window.svOpenCardNotes !== 'function') return true;
        if (ev && ev.preventDefault) ev.preventDefault();
        if (ev && ev.stopPropagation) ev.stopPropagation();
        _fvMarkAutoplay(pid);
        window.svOpenCardNotes(tile.getAttribute('data-fv-client') || '', pid);
        return false;
    }
    /* THE CLIENT'S MONTH AND WEEK THUMBNAILS (owner decision, 2026-10-18): a click on a post's thumbnail opens the same
       view the Sheet's video button opens (video left, notes right). A post with no video opens nothing, and says
       nothing: the click is swallowed so it does not fall through to the small preview behind it. With the switch off
       the click behaves as before. Client link only; the staff Calendar draws its own play icon. */
    function svFrameThumbAttrs(rawLink, client, cardId) {
        if (!_isClientLink) return '';
        if (!cardId || !_fvLinkOf(rawLink)) {
            _fvPrimeFlag();
            return ` data-fv-none data-fv-client="${_calEscAttr(_fvFlagSlugOf(client || (calState && calState.client) || ''))}" onclick="return svFrameThumbOpen(event,this)"`;
        }
        return svFrameTileAttrs(rawLink, client, cardId, '').replace('onclick="return svFrameTileOpen(event,this)"', 'onclick="return svFrameThumbOpen(event,this)"');
    }
    function svFrameThumbOpen(ev, el) {
        if (!el) return true;
        if (!el.hasAttribute('data-fv-tile')) {
            // No video: with the viewer on for this client the click opens nothing and does not fall through to the
            // small preview. With the switch off (or not read yet) the thumbnail behaves as before.
            if (!_fvFlagRead || !_fvEnabledFor(el.getAttribute('data-fv-client'))) return true;
            if (ev && ev.stopPropagation) ev.stopPropagation();
            return false;
        }
        return svFrameTileOpen(ev, el);
    }
    // The keyboard's way to the same door: Enter or Space on a client's Month or Week post (a click with no pointer,
    // detail 0) opens the viewer when the post has a video and the switch allows it. True when it did.
    function svFrameKeyDoor(ev, post) {
        if (!_isClientLink || !ev || ev.detail !== 0 || !post || !post.querySelector) return false;
        const tile = post.querySelector('[data-fv-tile]');
        return !!tile && svFrameTileOpen(ev, tile) === false;
    }
    // The small link under the preview (hidden unless the switch is on for this card's client).
    function svFrameIoLinkHtml(rawLink, client) {
        const link = _fvLinkOf(rawLink);
        if (!link) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const hidden = _fvEnabledFor(who) ? '' : ' hidden';
        return `<a class="fv-frameio-link fv-gated" data-fv-client="${_calEscAttr(who)}" href="${_calEscAttr(link)}" target="_blank" rel="noopener noreferrer"${hidden}>Watch in Frame.io ↗</a>`;
    }

    /* THE PLAYER, inside the Notes view.
         start    the full-size file (the best one the link allows), or the small proxy on a slow connection;
         wait     no first frame within 4 seconds, or playback stalling for 2.5 seconds: carry on from the same
                  second with the small proxy (and say so quietly);
         warm     pointing at the opener already fetched the address and the first bytes into a video element that
                  is handed over on open, so the first frame is mostly there before the click. It is only
                  loaded, never played: nothing plays until the person presses play. */
    const FV_START_MS = 4000;
    const FV_STALL_MS = 2500;
    const FV_PRE_TTL_MS = 45000;
    const FV_PRE = new Map();
    let _fvIntentTimer = 0;

    function _fvSlowLine() {
        try {
            const c = navigator.connection;
            if (!c) return false;
            if (c.saveData) return true;
            if (/^(slow-2g|2g|3g)$/.test(c.effectiveType || '')) return true;
            return typeof c.downlink === 'number' && c.downlink > 0 && c.downlink < 3;
        } catch (e) { return false; }
    }
    /* WHICH FILE (Encore, 2026-10-16). Frame.io gives up to three: "high_quality" (its full-size H.264 copy),
       "efficient" (a small H.264 copy) and "original" (the upload itself). A phone's upload is often HEVC (H.265),
       which Chrome on Windows usually plays as sound only, so the original is used only when Frame.io has no H.264
       copy at all. The order is decided here as well as on the server, so a card never starts on the original while a
       copy exists. */
    function svFramePickRendition(vdata) {
        const r = (vdata && vdata.renditions) || {};
        const hq = r.high_quality || '', small = r.efficient || '', orig = r.original || '';
        const full = hq || (vdata && vdata.url && vdata.url !== orig && vdata.url !== small ? vdata.url : '') || small || (vdata && vdata.url) || orig;
        const name = full === hq && hq ? 'high_quality' : (full === small && small ? 'efficient' : (full === orig && orig ? 'original' : 'address'));
        return { full, small: small && small !== full ? small : '', original: orig && orig !== full ? orig : '', name };
    }
    function _fvDowngrade(video) {
        const ctl = video._fvCtl;
        if (!ctl || !ctl.small || ctl.level === 'small') return;
        const at = video.currentTime || 0, was = !video.paused;
        ctl.level = 'small'; ctl.gen++; ctl.pictureOk = false;
        clearTimeout(video._fvStartT); clearTimeout(video._fvStallT); clearTimeout(video._fvPicT); video._fvPicT = 0;
        video.addEventListener('loadedmetadata', () => { try { if (at > 0) video.currentTime = at; } catch (e) {} if (was) { const p = video.play(); if (p && p.catch) p.catch(() => {}); } }, { once: true });
        video.src = ctl.small;
        video.setAttribute('data-fv-file', 'efficient');
        video.dispatchEvent(new Event('fv-smaller'));
    }
    /* SOUND BUT NO PICTURE. A file whose video the browser cannot decode (HEVC on most Windows Chrome) still plays its
       sound: no error is raised, the time moves, and not one frame is drawn. While playing, once the time has moved a
       second and no frame has been decoded, the next file is used from the same second: the small H.264 copy, or, when
       the original was all there was, nothing better exists and the player says so. */
    function _fvDecodedFrames(video) {
        try {
            if (typeof video.getVideoPlaybackQuality === 'function') return video.getVideoPlaybackQuality().totalVideoFrames;
            if (typeof video.webkitDecodedFrameCount === 'number') return video.webkitDecodedFrameCount;
        } catch (e) {}
        return -1;
    }
    function _fvNoPicture(video) {
        if (!video || video.paused || video.currentTime < 1) return false;
        if (video.readyState >= 1 && video.videoWidth === 0) return true;
        if (_fvDecodedFrames(video) !== 0) return false;
        // Some WebKit builds leave both frame counters at zero even while drawing a picture. A readable current
        // frame is stronger evidence. An audio-only file has no dimensions; a missing image leaves the pixel clear.
        // Cross-origin media may forbid this read: keep the existing counter-based fallback in that case.
        try {
            const c = document.createElement('canvas'); c.width = c.height = 1;
            const ctx = c.getContext('2d'); ctx.drawImage(video, 0, 0, 1, 1);
            if (ctx.getImageData(0, 0, 1, 1).data[3] > 0) return false;
        } catch (e) {}
        return true;
    }
    function _fvWatchPicture(video) {
        clearTimeout(video._fvPicT);
        const ctl = video._fvCtl;
        if (!ctl || ctl.pictureOk) return;
        const gen = ctl.gen;
        video._fvPicT = setTimeout(() => {
            const c = video._fvCtl;
            if (!c || c.gen !== gen || c.pictureOk || video.paused) return;
            if (!_fvNoPicture(video)) { if (video.currentTime >= 1) c.pictureOk = true; else _fvWatchPicture(video); return; }
            if (c.small && c.level !== 'small') { _fvDowngrade(video); return; }
            video.dispatchEvent(new Event('fv-nopicture'));
        }, 1200);
    }
    // A media error on the full-size file (an encoding the browser cannot play, or a failure of that file alone): the small
    // proxy is tried before the address is refreshed or the video given up on. True when it took over.
    function _fvTryEfficient(video) {
        const ctl = video && video._fvCtl;
        if (!ctl || !ctl.small || ctl.level === 'small') return false;
        _fvDowngrade(video);
        return true;
    }
    function _fvWire(video) {
        if (video._fvWired) return video;
        video._fvWired = true;
        video.addEventListener('loadeddata', () => { if (video._fvCtl) video._fvCtl.got = true; clearTimeout(video._fvStartT); });
        video.addEventListener('waiting', () => {
            const ctl = video._fvCtl;
            if (!ctl || !ctl.got || ctl.level !== 'full' || !ctl.small) return;
            clearTimeout(video._fvStallT);
            video._fvStallT = setTimeout(() => { if (video.readyState < 3) _fvDowngrade(video); }, FV_STALL_MS);
        });
        ['playing', 'canplay', 'pause', 'seeked'].forEach((ev) => video.addEventListener(ev, () => clearTimeout(video._fvStallT)));
        video.addEventListener('playing', () => _fvWatchPicture(video));
        video.addEventListener('timeupdate', () => { if (!video._fvPicT && video._fvCtl && !video._fvCtl.pictureOk) _fvWatchPicture(video); });
        return video;
    }
    function _fvNewVideo() {
        const v = document.createElement('video');
        v.setAttribute('playsinline', ''); v.playsInline = true; v.preload = 'auto';
        return _fvWire(v);
    }
    // Start (or restart after a new address) a video element: the small file first only on a slow connection.
    function _fvStart(video, vdata, resumeAt) {
        const pick = svFramePickRendition(vdata);
        const small = pick.small;
        const first = (_fvSlowLine() && small) ? small : pick.full;
        const prev = video._fvCtl;
