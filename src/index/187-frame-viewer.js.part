import { CAL_SUPABASE_ANON_KEY, CAL_SUPABASE_URL, _syncviewRequireStaffIdentity } from './100-onboarding-staff-controls.js';
import { _calRuntimeFlagClient, _calRuntimeFlagRawMembers, _calRuntimeFlagSlug, _syncviewEfHeaders } from './120-calendar-flags-write-repair.js';
import { calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    /* WATCH HERE: a card's Frame.io video, inside SyncView. Three ways in, all behind the frame_viewer_clients switch:
         - the Review tab's video preview plays the video in place (staff and client link; no comments);
         - the Sheet's thumbnail has a small play icon that opens the pop-up below (staff only);
         - Kasper's review keeps its "Watch here" button for the same pop-up (staff only).
       The rest of this comment describes the pop-up.

       ONE viewer, opened from the Calendar card, the SMM review panel and Kasper's review. Every
       "Watch here" button carries the card's video link; the viewer asks the frameio-view function
       (a staff key is required; client links never get the button or the viewer) for a fresh playable
       address and the comments, and plays them in our own player. Read only: replying stays in Frame.io
       (the buttons open the video there), and nothing the function returns is saved by the page.

       If anything fails, the viewer says so in a sentence and the normal Frame.io link keeps working:
       the link is in the header from the first frame, before anything has loaded. */
    const FRAMEIO_VIEW_EF_URL = CAL_SUPABASE_URL + '/functions/v1/frameio-view';
    const FV_FETCH_MS = 45000;
    // The three link shapes the function understands. Anything else gets no button.
    const FV_LINK_RE = /https?:\/\/(?:f\.io\/[A-Za-z0-9_-]{3,40}|next\.frame\.io\/(?:share|project)\/[0-9a-f-]{36}[^\s<>"']*)/i;
    const FV_INLINE_RETRY_LIMIT = 1;
    const FV_STATE = { open: false, seq: 0, link: '', title: '', card: '', poster: '', data: null, rec: null, frio: null, notes: [], opener: null, retried: false, resumeAt: 0 };

    function _fvLinkOf(raw) {
        const m = String(raw || '').match(FV_LINK_RE);
        return m ? m[0].replace(/[),.;]+$/, '') : '';
    }
    const FV_PLAY_ICO = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 2.7v10.6a.5.5 0 0 0 .76.43l8.6-5.3a.5.5 0 0 0 0-.86l-8.6-5.3a.5.5 0 0 0-.76.43z"/></svg>';

    /* WHO SEES IT: one runtime flag row, read the way the per-client flags are read (a bounded read with the
       public key, then a realtime channel). Key frame_viewer_clients, value { "all": false, "clients": [...] }.
       It fails closed: a missing row, a value of the wrong shape, a failed read or a deleted row all mean hidden.
       The list lives only in the database, never in this repo. A client link never reads it at all.

       The buttons are always drawn (so a later flip needs no repaint of the cards) but carry the hidden
       attribute unless the flag allows their card's client; hidden is display none, so with the flag off the
       page looks exactly as it did before the viewer existed. */
    const FRAME_VIEWER_FLAG_KEY = 'frame_viewer_clients';
    const FV_FLAG_TIMEOUT_MS = 4000;
    const FV_FLAG_RETRY_MS = 30000;
    let _fvFlag = { all: false, clients: new Set() };
    let _fvFlagPromise = null;
    let _fvFlagChannel = null;
    let _fvFlagTriedAt = 0;

    // The flag row's value to the answer. Only exact shapes open anything: all must be literally true, and the
    // clients must be a list of strings.
    function _fvFlagParse(value) {
        if (!value || typeof value !== 'object' || Array.isArray(value)) return { all: false, clients: new Set() };
        const members = _calRuntimeFlagRawMembers(value) || [];
        return { all: value.all === true, clients: new Set(members.map(m => _calRuntimeFlagSlug(m)).filter(Boolean)) };
    }
    function _fvFlagSlugOf(clientOrSlug) {
        let slug = '';
        try { slug = calClientSlug(String(clientOrSlug == null ? '' : clientOrSlug)); } catch (e) { slug = ''; }
        return slug || '';
    }
    function _fvEnabledFor(clientOrSlug) {
        if (_fvFlag.all === true) return true;
        const slug = _fvFlagSlugOf(clientOrSlug);
        return !!slug && _fvFlag.clients.has(slug);
    }
    function _fvSyncButtons() {
        document.querySelectorAll('.fv-gated').forEach((b) => {
            if (_fvEnabledFor(b.getAttribute('data-fv-client'))) b.removeAttribute('hidden');
            else b.setAttribute('hidden', '');
        });
        // A video already playing in place goes when the switch turns off for its client: it stops and says where to watch.
        document.querySelectorAll('.fv-inline').forEach((box) => {
            if (_fvEnabledFor(box.getAttribute('data-fv-client'))) return;
            const v = box.querySelector('video');
            if (v) { try { v.pause(); } catch (e) {} v.removeAttribute('src'); try { v.load(); } catch (e) {} }
            box._fvSeq = (box._fvSeq || 0) + 1;
            const open = box.getAttribute('data-fv-link') || '';
            box.innerHTML = `<div class="fv-inline-state"><div class="fv-state-text">Watching here has been switched off.</div><div class="fv-state-actions"><a class="fv-btn fv-btn-ghost fv-btn-small" href="${_calEscAttr(open)}" target="_blank" rel="noopener noreferrer">Open in Frame.io</a></div></div>`;
        });
        document.querySelectorAll('[data-fv-tile]').forEach((t) => {
            const on = _fvEnabledFor(t.getAttribute('data-fv-client'));
            if (on) { t.setAttribute('data-fv-on', ''); t.setAttribute('aria-label', 'Play video'); }
            else { t.removeAttribute('data-fv-on'); t.setAttribute('aria-label', 'Open video'); }
        });
    }
    function _fvFlagSet(value) {
        _fvFlag = _fvFlagParse(value);
        _fvSyncButtons();
    }
    async function _fvFlagFetch() {
        if (!CAL_SUPABASE_URL || !CAL_SUPABASE_ANON_KEY) { _fvFlagSet(null); return; }
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timer = ctrl ? setTimeout(() => { try { ctrl.abort(); } catch (e) {} }, FV_FLAG_TIMEOUT_MS) : null;
        try {
            const url = CAL_SUPABASE_URL + '/rest/v1/syncview_runtime_flags?select=value&key=eq.' + encodeURIComponent(FRAME_VIEWER_FLAG_KEY) + '&limit=1';
            const resp = await fetch(url, { cache: 'no-store', signal: ctrl ? ctrl.signal : undefined, headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' } });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const rows = await resp.json();
            if (!Array.isArray(rows)) throw new Error('shape');
            _fvFlagSet(rows[0] && rows[0].value ? rows[0].value : null);
        } catch (e) {
            _fvFlagSet(null);
            _fvFlagPromise = null;   // a later render may try again (not sooner than FV_FLAG_RETRY_MS)
            console.warn('[Frame viewer] switch unreadable; the viewer stays hidden', e && e.message);
        } finally { if (timer) clearTimeout(timer); }
    }
    async function _fvFlagSubscribe() {
        if (_fvFlagChannel) return;
        const client = await _calRuntimeFlagClient();
        if (!client || _fvFlagChannel) return;
        try {
            _fvFlagChannel = client
                .channel('syncview-frame-viewer-flag')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'syncview_runtime_flags', filter: 'key=eq.' + FRAME_VIEWER_FLAG_KEY }, (payload) => {
                    // A delete arrives with no new row: that is off.
                    const row = payload && payload.new ? payload.new : null;
                    _fvFlagSet(row && row.value ? row.value : null);
                })
                .subscribe();
        } catch (e) {
            console.warn('[Frame viewer] realtime subscribe failed', e);
            _fvFlagChannel = null;
        }
    }
    // Once per page (again after a failed read, at most every 30 seconds). Client link pages read it too, because
    // the Review tab's inline player is theirs as well; the server checks the same switch before it answers.
    function _fvPrimeFlag() {
        if (_fvFlagPromise) return;
        if (Date.now() - _fvFlagTriedAt < FV_FLAG_RETRY_MS && _fvFlagTriedAt) return;
        _fvFlagTriedAt = Date.now();
        _fvFlagPromise = _fvFlagFetch();
        _fvFlagPromise.then(() => _fvFlagSubscribe()).catch(() => null);
    }
    /* The pop-up openers every staff surface drops in. Empty for a client link page, and for a card whose video
       link is not a Frame.io link, so nothing about those pages changes. Pointing at one (hover, focus, press,
       touch) starts the slow part of the open at once: the function's answer and the first bytes of the video
       are fetched while the click is still on its way (svFrameIntent). */
    function _fvOpenerHtml(rawLink, title, cls, client, inner, label, cardId) {
        if (_isClientLink) return '';
        const link = _fvLinkOf(rawLink);
        if (!link) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const hidden = _fvEnabledFor(who) ? '' : ' hidden';
        return `<button type="button" class="${_calEscAttr(cls)} fv-gated" data-fv-client="${_calEscAttr(who)}" data-fv-link="${_calEscAttr(link)}" data-fv-title="${_calEscAttr(title || '')}" data-fv-card="${_calEscAttr(cardId || '')}"${hidden}${label ? ` aria-label="${_calEscAttr(label)}"` : ''} onpointerenter="svFrameIntent(this,120)" onfocus="svFrameIntent(this,0)" onpointerdown="svFrameIntent(this,0)" ontouchstart="svFrameIntent(this,0)" onclick="event.stopPropagation();svFrameViewerOpen(this)" title="Watch the video and read its comments here">${inner}</button>`;
    }
    function svFrameWatchBtnHtml(rawLink, title, cls, client, cardId) {
        return _fvOpenerHtml(rawLink, title, cls || 'fv-watch-btn', client, `${FV_PLAY_ICO}<span>Watch here</span>`, '', cardId);
    }
    // The Sheet's thumbnail: a small play icon, top centre, shown on hover (always on a phone).
    function svFramePlayIconHtml(rawLink, title, client, cardId) {
        return _fvOpenerHtml(rawLink, title, 'cal-thumb-play', client, FV_PLAY_ICO, 'Watch the video here', cardId);
    }
    // A card's link can change while its thumbnail stays on screen: keep the icon pointing at the card's current video.
    function svFrameSyncPlayIcon(thumbDiv, post) {
        if (_isClientLink || !thumbDiv) return;
        const want = _fvLinkOf(post && post.asset_url);
        const cur = thumbDiv.querySelector('.cal-thumb-play');
        if (cur && want && cur.getAttribute('data-fv-link') === want) { cur.setAttribute('data-fv-title', (post && post.name) || ''); return; }
        if (cur) cur.remove();
        if (want) thumbDiv.insertAdjacentHTML('beforeend', svFramePlayIconHtml(post.asset_url, post.name, post.client, post.id));
    }

    /* THE REVIEW TAB: the video preview plays in place. The tile stays a normal link to the video; with the switch
       on it is marked data-fv-on, its label says "Play video" and a click plays the video where the preview was.
       With the switch off (or any other kind of link) none of this applies and the tile opens the link in a new
       tab exactly as before. */
    function svFrameTileAttrs(rawLink, client, cardId, poster) {
        const link = _fvLinkOf(rawLink);
        if (!link) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const on = _fvEnabledFor(who);
        return ` data-fv-tile${on ? ' data-fv-on' : ''} data-fv-client="${_calEscAttr(who)}" data-fv-link="${_calEscAttr(link)}" data-fv-card="${_calEscAttr(cardId || '')}" data-fv-poster="${_calEscAttr(poster || '')}" onpointerenter="svFrameIntent(this,120)" onpointerdown="svFrameIntent(this,0)" ontouchstart="svFrameIntent(this,0)" onclick="return svFrameInlinePlay(event,this)"`;
    }
    function svFrameTileLabelHtml(rawLink) {
        if (!_fvLinkOf(rawLink)) return '<span class="cal-review-video-label">Open video ↗</span>';
        return '<span class="cal-review-video-label fv-lbl-off">Open video ↗</span><span class="cal-review-video-label fv-lbl-on">Play video</span>';
    }
    // The small link under the preview (hidden unless the switch is on for this card's client).
    function svFrameIoLinkHtml(rawLink, client) {
        const link = _fvLinkOf(rawLink);
        if (!link) return '';
        _fvPrimeFlag();
        const who = _fvFlagSlugOf(client || (calState && calState.client) || '');
        const hidden = _fvEnabledFor(who) ? '' : ' hidden';
        return `<a class="fv-frameio-link fv-gated" data-fv-client="${_calEscAttr(who)}" href="${_calEscAttr(link)}" target="_blank" rel="noopener noreferrer"${hidden}>Watch in Frame.io ↗</a>`;
    }

    /* THE NOTES: the card's own SyncView notes on the video, shown in the same list as the Frame.io comments. The
       Review code (which knows how to name an author) registers the provider; this file never reads notes itself. */
    let _fvNotesProvider = null;
    function svFrameSetNotesProvider(fn) { _fvNotesProvider = typeof fn === 'function' ? fn : null; }
    function _fvNotesFor(cardId) {
        if (!cardId || !_fvNotesProvider) return [];
        try { const out = _fvNotesProvider(cardId); return Array.isArray(out) ? out : []; } catch (e) { return []; }
    }

    /* THE PLAYER, shared by the pop-up and the Review tab's in-place player.
         start    the full-size file (the best one the link allows), or the small proxy on a slow connection;
         wait     no first frame within 4 seconds, or playback stalling for 2.5 seconds: carry on from the same
                  second with the small proxy (and say so quietly);
         warm     pointing at the opener already fetched the address and the first bytes into a video element that
                  is handed over on open, so the first frame is mostly there before the click. */
    const FV_START_MS = 4000;
    const FV_STALL_MS = 2500;
    const FV_PRE_TTL_MS = 45000;
    const FV_PRE = new Map();
    let _fvIntentTimer = 0;

    function _fvSlowLine() {
        try {
            const c = navigator.connection;
            if (!c) return false;
            if (c.saveData) return true;
            if (/^(slow-2g|2g|3g)$/.test(c.effectiveType || '')) return true;
            return typeof c.downlink === 'number' && c.downlink > 0 && c.downlink < 3;
        } catch (e) { return false; }
    }
    function _fvDowngrade(video) {
        const ctl = video._fvCtl;
        if (!ctl || !ctl.small || ctl.level === 'small') return;
        const at = video.currentTime || 0, was = !video.paused;
        ctl.level = 'small'; ctl.gen++;
        clearTimeout(video._fvStartT); clearTimeout(video._fvStallT);
        video.addEventListener('loadedmetadata', () => { try { if (at > 0) video.currentTime = at; } catch (e) {} if (was) { const p = video.play(); if (p && p.catch) p.catch(() => {}); } }, { once: true });
        video.src = ctl.small;
        video.dispatchEvent(new Event('fv-smaller'));
    }
    function _fvWire(video) {
        if (video._fvWired) return video;
        video._fvWired = true;
        video.addEventListener('loadeddata', () => { if (video._fvCtl) video._fvCtl.got = true; clearTimeout(video._fvStartT); });
        video.addEventListener('waiting', () => {
            const ctl = video._fvCtl;
            if (!ctl || !ctl.got || ctl.level !== 'full' || !ctl.small) return;
            clearTimeout(video._fvStallT);
            video._fvStallT = setTimeout(() => { if (video.readyState < 3) _fvDowngrade(video); }, FV_STALL_MS);
        });
        ['playing', 'canplay', 'pause', 'seeked'].forEach((ev) => video.addEventListener(ev, () => clearTimeout(video._fvStallT)));
        return video;
    }
    function _fvNewVideo() {
        const v = document.createElement('video');
        v.setAttribute('playsinline', ''); v.playsInline = true; v.preload = 'auto';
        return _fvWire(v);
    }
    // Start (or restart after a new address) a video element: the small file first only on a slow connection.
    function _fvStart(video, vdata, resumeAt) {
        const r = (vdata && vdata.renditions) || {};
        const small = r.efficient && r.efficient !== vdata.url ? r.efficient : '';
        const first = (_fvSlowLine() && small) ? small : vdata.url;
        const prev = video._fvCtl;
        const ctl = video._fvCtl = { small, level: first === small && small ? 'small' : 'full', got: false, gen: prev ? prev.gen + 1 : 1 };
        clearTimeout(video._fvStartT); clearTimeout(video._fvStallT);
        if (resumeAt > 0) video.addEventListener('loadedmetadata', () => { try { video.currentTime = resumeAt; } catch (e) {} }, { once: true });
        video.src = first;
        if (ctl.level === 'full' && small) {
            const gen = ctl.gen;
            video._fvStartT = setTimeout(() => { if (video._fvCtl && video._fvCtl.gen === gen && !video._fvCtl.got) _fvDowngrade(video); }, FV_START_MS);
        }
        return video;
    }
    function _fvStop(video) {
        if (!video) return;
        clearTimeout(video._fvStartT); clearTimeout(video._fvStallT);
        try { video.pause(); } catch (e) {}
        video.removeAttribute('src');
        try { video.load(); } catch (e) {}
    }
    // Sound on if the browser allows it; otherwise muted, and onMuted() shows the "tap for sound" control.
    function _fvAutoplay(video, onMuted) {
        video.muted = false;
        const p = video.play();
        if (p && p.catch) p.catch(() => {
            video.muted = true;
            const q = video.play();
            if (q && q.catch) q.catch(() => {});
            if (onMuted) onMuted();
        });
    }

    // ---- asking the function. The address and the comments are two requests, sent side by side, so the video
    // never waits for the comments (and a client link never asks for comments at all).
    async function _fvRequest(body) {
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timer = ctrl ? setTimeout(() => { try { ctrl.abort(); } catch (e) {} }, FV_FETCH_MS) : null;
        try {
            const resp = await fetch(FRAMEIO_VIEW_EF_URL, {
                method: 'POST',
                headers: _syncviewEfHeaders({ 'Content-Type': 'application/json' }, FRAMEIO_VIEW_EF_URL),
                body: JSON.stringify(body),
                signal: ctrl ? ctrl.signal : undefined
            });
            const json = await resp.json().catch(() => null);
            return { status: resp.status, json };
        } catch (e) {
            return { status: 0, json: null, aborted: !!(ctrl && e && e.name === 'AbortError') };
        } finally { if (timer) clearTimeout(timer); }
    }
    function _fvFailText(res) {
        if (res.json && res.json.message) return res.json.message;
        if (res.status === 401 || res.status === 403) return _isClientLink ? 'This video could not be loaded here.' : 'Your staff sign-in was not accepted for this. Sign in again and retry.';
        if (res.aborted) return 'Frame.io took too long to answer.';
        if (!res.status) return 'The video could not be loaded. Check your connection.';
        return 'The video could not be loaded from Frame.io.';
    }
    async function _fvFetchVideo(link, cardId) {
        // A client link sends only the card's id (and its own token, added by _syncviewEfHeaders): the server decides
        // from the card which video this client may play, and never answers with comments.
        const res = await _fvRequest(_isClientLink ? { card_id: cardId } : { link, part: 'video' });
        const j = res.json;
        if (res.status === 200 && j && j.ok && j.video && j.video.url) return { ok: true, video: j.video, open_url: j.open_url || '' };
        return { ok: false, message: _fvFailText(res), status: res.status };
    }
    async function _fvFetchComments(link) {
        const res = await _fvRequest({ link, part: 'comments' });
        const j = res.json;
        if (res.status === 200 && j && j.ok && Array.isArray(j.comments)) return { ok: true, data: j };
        return { ok: false };
    }
    function _fvDispose(rec) {
        if (rec && rec.warm) { _fvStop(rec.warm); rec.warm = null; }
    }
    // The address (and its warmed video element) for a link. Reused for 45 seconds, so the hover before a click
    // does the work; a retry asks again (fresh).
    function _fvGetVideo(link, cardId, fresh) {
        const key = link + '|' + (_isClientLink ? cardId : '');
        const hit = FV_PRE.get(key);
        if (!fresh && hit && Date.now() - hit.at < FV_PRE_TTL_MS) return hit;
        if (hit) _fvDispose(hit);
        FV_PRE.forEach((r, k) => { if (Date.now() - r.at >= FV_PRE_TTL_MS && !r.adopted) { _fvDispose(r); FV_PRE.delete(k); } });
        const rec = { at: Date.now(), video: null, comments: null, warm: null, adopted: false };
        rec.video = _fvFetchVideo(link, cardId).then((res) => {
            if (!res.ok) { if (FV_PRE.get(key) === rec) FV_PRE.delete(key); return res; }
            rec.open = res.open_url;
            if (!rec.adopted && FV_PRE.get(key) === rec) {
                const v = _fvNewVideo();
                v.muted = true;
                _fvStart(v, res.video, 0);
                rec.warm = v;
                setTimeout(() => { if (!rec.adopted) _fvDispose(rec); }, FV_PRE_TTL_MS);
            }
            return res;
        });
        FV_PRE.set(key, rec);
        return rec;
    }
    // Pointing at an opener (staff pop-up icon, or either Review tile). Hover waits 120 ms so a mouse passing over
    // does not fetch; focus, press and touch start at once.
    function svFrameIntent(el, delay) {
        if (!el || !el.getAttribute) return;
        const tile = el.hasAttribute('data-fv-tile');
        if (tile ? !el.hasAttribute('data-fv-on') : (el.hidden || _isClientLink)) return;
        if (!tile && !_fvEnabledFor(el.getAttribute('data-fv-client'))) return;
        const link = _fvLinkOf(el.getAttribute('data-fv-link'));
        if (!link) return;
        const cardId = el.getAttribute('data-fv-card') || '';
        const go = () => {
            const rec = _fvGetVideo(link, cardId, false);
            if (!tile && !_isClientLink && !rec.comments) rec.comments = _fvFetchComments(link);
        };
        clearTimeout(_fvIntentTimer);
        if (delay > 0) _fvIntentTimer = setTimeout(go, delay); else go();
    }

    // ---- the Review tab's in-place player
    function _fvInlineState(box, kind, text, withRetry) {
        const st = box.querySelector('.fv-inline-state');
        if (!st) return;
        if (kind === 'ready') { st.innerHTML = ''; st.hidden = true; return; }
        st.hidden = false;
        st.className = 'fv-inline-state' + (kind === 'loading' ? ' is-loading' : '');
        if (kind === 'loading') { st.innerHTML = '<div class="fv-spin" aria-hidden="true"></div>'; return; }
        const open = box.getAttribute('data-fv-link') || '';
        st.innerHTML = `<div class="fv-state-text fv-state-bad">${_calEsc(text || 'The video could not be loaded.')}</div>
            <div class="fv-state-actions">${withRetry ? '<button type="button" class="fv-btn fv-btn-small" onclick="svFrameInlineRetry(this)">Try again</button>' : ''}<a class="fv-btn fv-btn-ghost fv-btn-small" href="${_calEscAttr(open)}" target="_blank" rel="noopener noreferrer">Open in Frame.io</a></div>`;
    }
    async function _fvInlineLoad(box, resumeAt, fresh) {
        const seq = (box._fvSeq = (box._fvSeq || 0) + 1);
        // Every load and reload checks the switch first.
        if (!_fvEnabledFor(box.getAttribute('data-fv-client'))) { _fvInlineState(box, 'error', 'Watching here has been switched off.', false); return; }
        _fvInlineState(box, 'loading');
        const link = box.getAttribute('data-fv-link') || '';
        if (!_isClientLink) { try { await _syncviewRequireStaffIdentity('frame-view'); } catch (e) { _fvInlineState(box, 'error', 'Your staff sign-in was not accepted for this. Sign in again and retry.', true); return; } }
        const rec = _fvGetVideo(link, box.getAttribute('data-fv-card') || '', !!fresh);
        const res = await rec.video;
        if (seq !== box._fvSeq || !document.contains(box)) return;
        if (!res.ok) { _fvInlineState(box, 'error', res.message, true); return; }
        const old = box.querySelector('video');
        let video = old;
        if (rec.warm && !rec.adopted) { video = rec.warm; rec.adopted = true; rec.warm = null; old.replaceWith(video); }
        else if (old._fvCtl) _fvStart(old, res.video, resumeAt || 0);
        else _fvStart(old, res.video, resumeAt || 0);
        video.className = 'fv-inline-video'; video.controls = true;
        const poster = box.getAttribute('data-fv-poster') || '';
        if (poster) video.poster = poster;
        box._fvVideo = video;
        if (!video._fvInlineWired) {
            video._fvInlineWired = true;
            video.addEventListener('loadeddata', () => { if (box._fvSeq === seq || true) _fvInlineState(box, 'ready'); });
            video.addEventListener('fv-smaller', () => box.setAttribute('data-fv-small', ''));
            video.addEventListener('volumechange', () => { const b = box.querySelector('.fv-unmute'); if (b && !video.muted) b.hidden = true; });
            video.addEventListener('error', () => {
                if (!video.getAttribute('src')) return;
                // The address is signed and expires: ask once for a new one and carry on from the same second.
                if ((box._fvRetries || 0) < FV_INLINE_RETRY_LIMIT) { box._fvRetries = (box._fvRetries || 0) + 1; _fvInlineLoad(box, video.currentTime || 0, true); return; }
                _fvInlineState(box, 'error', 'This video could not be played here. It may need a different format.', true);
            });
        }
        if (video.readyState >= 2) _fvInlineState(box, 'ready');
        _fvAutoplay(video, () => { const b = box.querySelector('.fv-unmute'); if (b) b.hidden = false; });
    }
    function svFrameInlinePlay(ev, tile) {
        // Switched off, or a modified click (new tab, new window): the link just opens.
        if (!tile || !tile.hasAttribute('data-fv-on')) return true;
        if (ev && (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.altKey || ev.button === 1)) return true;
        const link = _fvLinkOf(tile.getAttribute('data-fv-link'));
        if (!link) return true;
        if (ev && ev.preventDefault) ev.preventDefault();
        if (ev && ev.stopPropagation) ev.stopPropagation();
        document.querySelectorAll('.fv-inline-video').forEach((v) => { try { v.pause(); } catch (e) {} });
        const box = document.createElement('div');
        box.className = 'cal-review-video-tile fv-inline';
        box.setAttribute('data-fv-link', link);
        box.setAttribute('data-fv-client', tile.getAttribute('data-fv-client') || '');
        box.setAttribute('data-fv-card', tile.getAttribute('data-fv-card') || '');
        box.setAttribute('data-fv-poster', tile.getAttribute('data-fv-poster') || '');
        box.innerHTML = '<video class="fv-inline-video" controls playsinline preload="auto"></video><div class="fv-inline-state is-loading" role="status"></div><button type="button" class="fv-unmute" hidden onclick="svFrameUnmute(this)">Tap for sound</button>';
        _fvWire(box.querySelector('video'));
        const poster = box.getAttribute('data-fv-poster');
        if (poster) box.querySelector('video').poster = poster;
        tile.replaceWith(box);
        _fvInlineLoad(box, 0, false);
        return false;
    }
    function svFrameInlineRetry(btn) {
        const box = btn && btn.closest ? btn.closest('.fv-inline') : null;
        if (!box) return;
        box._fvRetries = 0;
        _fvInlineLoad(box, 0, true);
    }
    function svFrameUnmute(btn) {
        const host = btn && btn.closest ? btn.closest('.fv-inline, .fv-player') : null;
        const v = host ? host.querySelector('video') : null;
        if (v) { v.muted = false; if (v.paused) { const p = v.play(); if (p && p.catch) p.catch(() => {}); } }
        btn.hidden = true;
    }

    // ---- the pop-up (Sheet icon, Kasper's row)
    // Escape closes it wherever the focus is (it can be on nothing after a button inside the viewer is replaced).
    function _fvKey(e) { if (e.key === 'Escape' && FV_STATE.open) { e.stopPropagation(); svFrameViewerClose(); } }

    function _fvEl() { return document.getElementById('fvOverlay'); }
    function _fvPart(sel) { const el = _fvEl(); return el ? el.querySelector(sel) : null; }
    function _fvTime(sec) {
        const s = Math.max(0, Math.floor(Number(sec) || 0));
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
        return (h ? h + ':' + String(m).padStart(2, '0') : String(m)) + ':' + String(r).padStart(2, '0');
    }
    function _fvAgo(iso) {
        const t = Date.parse(iso);
        if (!t) return '';
        const d = Math.max(0, Date.now() - t), day = 86400000;
        if (d < 3600000) return Math.max(1, Math.round(d / 60000)) + ' min ago';
        if (d < day) return Math.round(d / 3600000) + ' h ago';
        if (d < 30 * day) return Math.round(d / day) + ' d ago';
        return new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    }
    const FV_EXT_ICO = '<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5h3.5V6M11.5 2.5 6.5 7.5"/><path d="M10 8.5v2a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h2"/></svg>';

    function _fvBuild() {
        if (_fvEl()) return _fvEl();
        const el = document.createElement('div');
        el.id = 'fvOverlay';
        el.className = 'fv-overlay';
        el.setAttribute('role', 'dialog');
        el.setAttribute('aria-modal', 'true');
        el.setAttribute('aria-labelledby', 'fvTitle');
        el.innerHTML = `<div class="fv-panel" data-orient="landscape">
            <div class="fv-head">
                <h2 class="fv-title" id="fvTitle"></h2>
                <a class="fv-open-link" id="fvOpenLink" target="_blank" rel="noopener noreferrer"><span>Open in Frame.io</span>${FV_EXT_ICO}</a>
                <button type="button" class="fv-close" aria-label="Close" onclick="svFrameViewerClose()"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8"/></svg></button>
            </div>
            <div class="fv-body">
                <div class="fv-stage">
                    <div class="fv-player" id="fvPlayer" data-state="loading">
                        <div class="fv-state" id="fvState" role="status"></div>
                        <button type="button" class="fv-unmute" id="fvUnmute" hidden onclick="svFrameUnmute(this)">Tap for sound</button>
                    </div>
                    <div class="fv-markers" id="fvMarkers" aria-hidden="true"></div>
                </div>
                <aside class="fv-side" aria-label="Comments">
                    <div class="fv-side-head"><span class="fv-side-title">Comments</span><span class="fv-count" id="fvCount"></span></div>
                    <div class="fv-list" id="fvList"></div>
                </aside>
            </div>
        </div>`;
        // A press that began on the backdrop and ended on it closes the viewer; a drag out of the panel does not.
        el.setAttribute('data-backdrop-dismiss', '');
        el.addEventListener('click', (e) => { if (e.target === el && el._backdropPressBegan) svFrameViewerClose(); });
        document.body.appendChild(el);
        return el;
    }

    function _fvSetState(kind, text, withRetry) {
        const box = _fvPart('#fvState');
        const player = _fvPart('#fvPlayer');
        if (!box || !player) return;
        player.setAttribute('data-state', kind);
        if (kind === 'ready') { box.innerHTML = ''; return; }
        if (kind === 'loading') { box.innerHTML = '<div class="fv-spin" aria-hidden="true"></div>'; return; }
        box.innerHTML = `<div class="fv-state-text fv-state-bad">${_calEsc(text || 'The video could not be loaded.')}</div>
            ${withRetry ? '<div class="fv-state-actions"><button type="button" class="fv-btn" onclick="svFrameViewerReload()">Try again</button></div>' : ''}`;
    }

    // The card's SyncView notes and the Frame.io comments, one list, oldest first. Each says where it came from.
    function _fvEntries() {
        const out = [];
        const frio = FV_STATE.frio;
        if (frio && frio.ok) {
            (frio.data.comments || []).forEach((c) => out.push({
                src: 'frameio', id: c.id, author: c.author || '', text: c.text, created_at: c.created_at, time: c.time_seconds == null ? null : c.time_seconds,
                done: !!c.done, replies: (c.replies || []).map((r) => ({ author: r.author || '', text: r.text, created_at: r.created_at })),
            }));
        }
        const notes = FV_STATE.notes || [];
        const byParent = new Map();
        notes.forEach((n) => { if (n.parent_id) { const a = byParent.get(n.parent_id) || []; a.push(n); byParent.set(n.parent_id, a); } });
        notes.filter((n) => !n.parent_id || !notes.some((m) => m.id === n.parent_id)).forEach((n) => out.push({
            src: 'syncview', id: n.id, author: n.author || '', text: n.text, created_at: n.created_at, time: null, done: !!n.done,
            replies: (byParent.get(n.id) || []).sort((a, b) => String(a.created_at).localeCompare(String(b.created_at))).map((r) => ({ author: r.author || '', text: r.text, created_at: r.created_at })),
        }));
        out.sort((a, b) => (Date.parse(a.created_at) || 0) - (Date.parse(b.created_at) || 0));
        return out;
    }
    function _fvRenderList() {
        const list = _fvPart('#fvList'), count = _fvPart('#fvCount');
        if (!list) return;
        const frio = FV_STATE.frio;
        const items = _fvEntries();
        if (count) count.textContent = items.length ? String(items.length) : '';
        const who = (a) => (a ? _calEsc(a) : '<span class="fv-guest">Guest reviewer</span>');
        const html = items.map((c) => {
            const t = c.time;
            const chip = t == null ? '' : `<span class="fv-time">${_fvTime(t)}</span>`;
            const replies = c.replies.map((r) => `<div class="fv-reply"><div class="fv-r-top"><span class="fv-c-by">${who(r.author)}</span><span class="fv-c-when">${_calEsc(_fvAgo(r.created_at))}</span></div><div class="fv-c-text">${_calEsc(r.text)}</div></div>`).join('');
            const head = `<div class="fv-c-top">${chip}<span class="fv-c-by">${who(c.author)}</span><span class="fv-c-when">${_calEsc(_fvAgo(c.created_at))}</span>${c.done ? '<span class="fv-done">Done</span>' : ''}<span class="fv-src">${c.src === 'frameio' ? 'Frame.io' : 'SyncView'}</span></div><div class="fv-c-text">${_calEsc(c.text)}</div>`;
            const main = t == null
                ? `<div class="fv-c-main fv-c-static">${head}</div>`
                : `<button type="button" class="fv-c-main" onclick="svFrameViewerSeek(this)" title="Jump to ${_fvTime(t)}">${head}</button>`;
            return `<li class="fv-c fv-src-${c.src}${c.done ? ' is-done' : ''}" data-id="${_calEscAttr(c.id)}"${t == null ? '' : ` data-t="${t}"`}>${main}${replies ? `<div class="fv-replies">${replies}</div>` : ''}</li>`;
        }).join('');
        let tail = '';
        if (!frio) tail = '<div class="fv-skel"></div>' + (items.length ? '' : '<div class="fv-skel"></div><div class="fv-skel fv-skel-short"></div>');
        else if (!frio.ok) tail = '<div class="fv-note fv-note-bad">The Frame.io comments could not be loaded.<div><button type="button" class="fv-btn fv-btn-small" onclick="svFrameViewerReload()">Try again</button></div></div>';
        else {
            if (frio.data.comments_error) tail += '<div class="fv-note fv-note-bad">The Frame.io comments could not be loaded just now.</div>';
            if (frio.data.comments_truncated) tail += '<div class="fv-note">Showing the first Frame.io comments only. The rest are in Frame.io.</div>';
            if (frio.data.reply_names_partial) tail += '<div class="fv-note">Some reply names are not shown.</div>';
            if (!items.length) tail += '<div class="fv-note">No comments yet.</div>';
        }
        list.innerHTML = (html ? `<ul class="fv-c-list">${html}</ul>` : '') + tail;
        _fvTick();
    }

    function _fvMarkers() {
        const track = _fvPart('#fvMarkers'), v = _fvPart('#fvVideo');
        if (!track) return;
        const frio = FV_STATE.frio;
        const dur = (v && isFinite(v.duration) && v.duration > 0) ? v.duration : ((FV_STATE.data && FV_STATE.data.duration_seconds) || 0);
        const list = (frio && frio.ok && frio.data.comments) || [];
        if (!dur || !list.length) { track.innerHTML = ''; return; }
        track.innerHTML = list.filter((c) => c.time_seconds != null && c.time_seconds <= dur)
            .map((c) => `<button type="button" class="fv-mark" style="left:${Math.min(100, (c.time_seconds / dur) * 100).toFixed(2)}%" data-id="${_calEscAttr(c.id)}" data-t="${c.time_seconds}" onclick="svFrameViewerSeek(this)" aria-label="Comment at ${_calEscAttr(_fvTime(c.time_seconds))}"></button>`).join('');
    }

    function _fvTick() {
        const v = _fvPart('#fvVideo'), list = _fvPart('#fvList');
        if (!v || !list) return;
        let now = null;
        list.querySelectorAll('.fv-c.fv-src-frameio[data-t]').forEach((li) => {
            if (Number(li.getAttribute('data-t')) <= v.currentTime + 0.25) now = li;
        });
        list.querySelectorAll('.fv-c.is-now').forEach((li) => { if (li !== now) li.classList.remove('is-now'); });
        if (now) now.classList.add('is-now');
    }

    function svFrameViewerSeek(btn) {
        const holder = btn.closest('[data-t]') || btn;
        const t = Number(holder.getAttribute('data-t'));
        const v = _fvPart('#fvVideo');
        if (!v || !isFinite(t)) return;
        v.currentTime = t;
        const p = v.play();
        if (p && p.catch) p.catch(() => {});
        _fvTick();
    }

    // Vertical videos use the height and sit beside the comments; wide ones keep the wide layout.
    function _fvOrient(w, h) {
        const panel = _fvPart('.fv-panel'), player = _fvPart('#fvPlayer');
        if (!panel || !player || !(w > 0) || !(h > 0)) return;
        panel.setAttribute('data-orient', h > w * 1.05 ? 'portrait' : 'landscape');
        player.style.setProperty('--fv-ar', (w / h).toFixed(4));
        player.setAttribute('data-sized', '');
    }

    function _fvShowVideo(res, rec) {
        const player = _fvPart('#fvPlayer');
        FV_STATE.data = res.video;
        const open = res.open_url || FV_STATE.link;
        _fvPart('#fvOpenLink').setAttribute('href', open);
        let v = null;
        if (rec && rec.warm && !rec.adopted) { v = rec.warm; rec.adopted = true; rec.warm = null; }
        const fresh = !v;
        if (!v) v = _fvNewVideo();
        v.id = 'fvVideo'; v.className = 'fv-video'; v.controls = true;
        if (FV_STATE.poster) v.poster = FV_STATE.poster;
        const old = _fvPart('#fvVideo');
        if (old && old !== v) { _fvStop(old); old.remove(); }
        if (!v.isConnected || v.parentNode !== player) player.insertBefore(v, player.firstChild);
        if (!v._fvPopWired) {
            v._fvPopWired = true;
            v.addEventListener('timeupdate', _fvTick);
            v.addEventListener('loadedmetadata', () => { _fvOrient(v.videoWidth, v.videoHeight); _fvMarkers(); });
            v.addEventListener('loadeddata', () => { if (FV_STATE.open) _fvSetState('ready'); });
            v.addEventListener('volumechange', () => { const b = _fvPart('#fvUnmute'); if (b && !v.muted) b.hidden = true; });
            v.addEventListener('fv-smaller', () => { player.setAttribute('data-small', ''); });
            v.addEventListener('error', _fvVideoFailed);
        }
        if (fresh) _fvStart(v, res.video, FV_STATE.resumeAt);
        FV_STATE.resumeAt = 0;
        if (v.readyState >= 1 && v.videoWidth) _fvOrient(v.videoWidth, v.videoHeight);
        if (v.readyState >= 2) _fvSetState('ready');
        _fvMarkers();
        _fvAutoplay(v, () => { const b = _fvPart('#fvUnmute'); if (b) b.hidden = false; });
    }

    async function _fvLoad(fresh) {
        const seq = ++FV_STATE.seq;
        _fvSetState('loading');
        FV_STATE.frio = null;
        FV_STATE.notes = _fvNotesFor(FV_STATE.card);
        _fvRenderList();
        const markers = _fvPart('#fvMarkers'); if (markers) markers.innerHTML = '';
        const rec = _fvGetVideo(FV_STATE.link, FV_STATE.card, !!fresh);
        FV_STATE.rec = rec;
        // The comments are asked for beside the video (or already were, when the pointer reached the icon first).
        if (!rec.comments || fresh) rec.comments = _fvFetchComments(FV_STATE.link);
        rec.comments.then((c) => { if (seq !== FV_STATE.seq || !FV_STATE.open) return; FV_STATE.frio = c; _fvRenderList(); _fvMarkers(); });
        const res = await rec.video;
        if (seq !== FV_STATE.seq || !FV_STATE.open) return;
        if (!res.ok) { _fvSetState('error', res.message, true); return; }
        _fvShowVideo(res, rec);
    }

    /* The video address is signed and expires. If the player stops with an error, ask once for a new one and
       carry on from the same second; a second failure is shown as a normal error. */
    function _fvVideoFailed() {
        const v = _fvPart('#fvVideo');
        if (!FV_STATE.open || !v || !v.getAttribute('src')) return;
        if (!FV_STATE.retried) {
            FV_STATE.retried = true;
            FV_STATE.resumeAt = v.currentTime || 0;
            _fvLoad(true);
            return;
        }
        _fvSetState('error', 'This video could not be played here. It may need a different format.', true);
    }

    function _fvPosterOf(btn) {
        const given = btn.getAttribute('data-fv-poster');
        if (given) return given;
        try { const img = btn.closest('.cal-card-thumb') && btn.closest('.cal-card-thumb').querySelector('img'); return img ? (img.currentSrc || img.src || '') : ''; } catch (e) { return ''; }
    }

    async function svFrameViewerOpen(btn) {
        if (_isClientLink) return;
        const link = _fvLinkOf(btn && btn.getAttribute && btn.getAttribute('data-fv-link'));
        if (!link) return;
        // A click can land before the switch has been read: wait for that one read (bounded), then decide.
        _fvPrimeFlag();
        if (_fvFlagPromise) { try { await _fvFlagPromise; } catch (e) {} }
        if (!_fvEnabledFor(btn.getAttribute('data-fv-client'))) return;
        try { await _syncviewRequireStaffIdentity('frame-view'); } catch (e) { return; }
        FV_STATE.opener = btn || null;
        FV_STATE.link = link;
        FV_STATE.card = btn.getAttribute('data-fv-card') || '';
        FV_STATE.title = btn.getAttribute('data-fv-title') || '';
        FV_STATE.poster = _fvPosterOf(btn);
        FV_STATE.data = null;
        FV_STATE.retried = false;
        FV_STATE.resumeAt = 0;
        FV_STATE.open = true;
        const el = _fvBuild();
        _fvPart('#fvTitle').textContent = FV_STATE.title || 'Video';
        _fvPart('#fvOpenLink').setAttribute('href', link);
        const panel = _fvPart('.fv-panel'), player = _fvPart('#fvPlayer');
        panel.setAttribute('data-orient', 'landscape');
        player.removeAttribute('data-sized'); player.removeAttribute('data-small'); player.style.removeProperty('--fv-ar');
        player.style.backgroundImage = FV_STATE.poster ? `url("${FV_STATE.poster.replace(/["\\\n]/g, '')}")` : '';
        const unmute = _fvPart('#fvUnmute'); if (unmute) unmute.hidden = true;
        const stale = _fvPart('#fvVideo'); if (stale) { _fvStop(stale); stale.remove(); }
        if (FV_STATE.poster) { const im = new Image(); im.onload = () => { if (FV_STATE.open && !_fvPart('#fvVideo')) _fvOrient(im.naturalWidth, im.naturalHeight); }; im.src = FV_STATE.poster; }
        el.classList.add('open');
        document.body.classList.add('fv-lock');
        document.addEventListener('keydown', _fvKey, true);
        const close = _fvPart('.fv-close'); if (close) close.focus();
        _fvLoad(false);
    }

    function svFrameViewerReload() {
        if (!FV_STATE.open) return;
        FV_STATE.retried = false;
        const v = _fvPart('#fvVideo');
        FV_STATE.resumeAt = (v && v.currentTime) || 0;
        _fvLoad(true);
    }

    function svFrameViewerClose() {
        const el = _fvEl();
        FV_STATE.open = false;
        FV_STATE.seq++;
        if (!el) return;
        const v = el.querySelector('#fvVideo');
        if (v) { _fvStop(v); v.remove(); }
        el.classList.remove('open');
        document.body.classList.remove('fv-lock');
        document.removeEventListener('keydown', _fvKey, true);
        const back = FV_STATE.opener;
        FV_STATE.opener = null;
        if (back && document.contains(back) && back.focus) { try { back.focus(); } catch (e) {} }
    }

    // ---- window exports (generated by `node scripts/check-modules.js --write-window-exports`; do not edit) ----
    Object.assign(window, {
        svFrameInlinePlay, svFrameInlineRetry, svFrameIntent, svFrameUnmute, svFrameViewerClose,
        svFrameViewerOpen, svFrameViewerReload, svFrameViewerSeek
    });
export {
  svFrameIoLinkHtml, svFramePlayIconHtml, svFrameSetNotesProvider, svFrameSyncPlayIcon, svFrameTileAttrs, svFrameTileLabelHtml, svFrameWatchBtnHtml
