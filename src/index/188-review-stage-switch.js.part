import { _syncviewApplyTheme, clientViewTab, svArea, svAreaApi, svFetchRetryOnce } from './040-shared-briefs.js';
import { render } from './050-market-briefs.js';
import { CAL_SUPABASE_ANON_KEY, CAL_SUPABASE_URL, _syncviewStaffIdentityForHeaders } from './100-onboarding-staff-controls.js';
import { _calRuntimeFlagRawMembers, _calRuntimeFlagSlug } from './120-calendar-flags-write-repair.js';
import { _calSetFocusRequest, calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calRenderBody } from './160-calendar-organize-ui.js';
import { _isClientLink, _syncviewClientEntryCapability } from './260-production-refresh-boot.js';
import { _kasperPaintReview, _kasperState } from './305-core-kasper-shared.js';
import { svFrameFlagWait } from './187-frame-viewer.js';
import { navTo } from './092-core-submit-form-navigation.js';
import { currentNav } from './065-core-nav-intake-state.js';
    /* THE NEW REVIEW PAGE (layout C, "Guided stage"), behind two switches. Session Marquee, 2026-10-17.

       This file is the small, always-loaded half: it reads the switches and answers "show the new page here?".
       The page itself (195-review-stage.js.part) is its own on-demand area, "reviewstage", fetched only when a
       switch says yes, so nobody else downloads it.

       The switches are rows in syncview_runtime_flags, read once per page with the public key (a bounded read that
       fails closed, the way frame_viewer_clients is read in 187). Missing, unreadable or the wrong shape all mean the
       old page, exactly as before this file existed:
         review_stage_client_pages       { "clients": [...] } or { "all": true }: the client's review link and the SMM's
                                    Calendar Review tab for those clients.
         review_stage_kasper_staff  { "staff": [...] }: the Kasper tab's Review Session, only for the signed-in staff
                                    member whose id or full name is listed.
         review_help_video_url      { "url": "..." }: whether the "?" shows on the client page. It opens the public
                                    start page (/start#review) in a new tab; the address itself is no longer played.
                                    Empty or missing hides the button.
         review_stage_kasper_layout2 { "staff": [...] }: Kasper's Review Session in its second layout (session Easel,
                                    2026-10-20): every part of the card on stage at once, one always-visible list of
                                    waiting cards on the left. Same listing rule as review_stage_kasper_staff (id or full
                                    name of the signed-in staff member), and it only changes the layout of a page that
                                    switch already shows: it needs review_stage_kasper_staff to list the same person, and
                                    it applies on wide screens only (1360 px and up). Missing, unreadable or the wrong shape: today's layout.
         kasper_fast_boot           { "staff": [...] }: Kasper's tab boots fast (session Quick, 2026-10-20): no "Refreshing"
                                    pill, the player's switch and the review page's code are fetched at boot instead of when
                                    the first card paints, and the first card's video is warmed while the list is still
                                    loading. Same listing rule as the switches above (id or full name). Missing, unreadable
                                    or the wrong shape: Kasper's tab exactly as it was.
         workload_calm_staff        { "staff": [...] } and/or { "all": true }: the calm Workload calendar (session Calm,
                                    2026-10-18). "staff" lists the signed-in staff members (id or full name) who get it;
                                    { "all": true } gives it to every signed-in staff member, so a new team member needs
                                    no edit (session Calm Six, 2026-10-20). Only the exact boolean true counts. Never the
                                    client link. Missing, unreadable or the wrong shape: the Workload calendar exactly
                                    as it was.
         unread_badges_v2           { "staff": [...] }: the round-5 unread badges, Notes and Messages (session Beacon,
                                    2026-10-24, 327). Same listing rule as the switches above (id or full name of the
                                    signed-in staff member). Never the client link. Missing, unreadable or the wrong
                                    shape: today's badges, Notes and Messages exactly as they were.
         thumbnail_title_buttons_staff { "staff": [...] }: the Production "Thumbnail titles" and "Write title" buttons
                                    (session Titlecard, 2026-10-23, OPEN_REPAIRS 481). Same listing rule (id or full
                                    name of the signed-in staff member). Missing, unreadable or the wrong shape: no buttons.
         analytics_hidden           { "hidden": false } brings Analytics back for everyone (the staff bar's Analytics
                                    tab, the client link's Analytics / Content Calendar toggle). Missing, unreadable,
                                    { "hidden": true } or any other shape: Analytics is hidden (owner, 2026-10-17
                                    23:20, session Curtain Seven). Read at boot, in the same request as the switches.
       The lists live only in the database, never in this repository. */
    const RS_FLAG_KEYS = ['review_stage_client_pages', 'review_stage_kasper_staff', 'review_help_video_url', 'analytics_hidden', 'workload_calm_staff', 'review_stage_kasper_layout2', 'kasper_fast_boot', 'thumbnail_title_buttons_staff', 'unread_badges_v2'];
    const RS_FLAG_TIMEOUT_MS = 4000;
    const RS_FLAG_RETRY_MS = 30000;
    let _rsFlags = { loaded: false, all: false, clients: new Set(), staff: new Set(), calm: new Set(), calmAll: false, layout2: new Set(), fast: new Set(), ttb: new Set(), unread: new Set(), help: '', analytics: false };
    let _rsFlagPromise = null;
    let _rsFlagTriedAt = 0;
    let _rsFlagFailed = false;

    function _rsParse(rows) {
        const by = {};
        (Array.isArray(rows) ? rows : []).forEach(r => { if (r && typeof r.key === 'string') by[r.key] = r.value; });
        const c = by.review_stage_client_pages;
        const okObj = v => !!v && typeof v === 'object' && !Array.isArray(v);
        const members = okObj(c) ? (_calRuntimeFlagRawMembers(c) || []) : [];
        const s = by.review_stage_kasper_staff;
        const staff = okObj(s) && Array.isArray(s.staff) ? s.staff.filter(x => typeof x === 'string' && x.trim()).map(x => x.trim().toLowerCase()) : [];
        const w = by.workload_calm_staff;
        const calm = okObj(w) && Array.isArray(w.staff) ? w.staff.filter(x => typeof x === 'string' && x.trim() && x.trim() !== '*').map(x => x.trim().toLowerCase()) : [];
        const calmAll = okObj(w) && w.all === true;
        const l2 = by.review_stage_kasper_layout2;
        const layout2 = okObj(l2) && Array.isArray(l2.staff) ? l2.staff.filter(x => typeof x === 'string' && x.trim()).map(x => x.trim().toLowerCase()) : [];
        const fb = by.kasper_fast_boot;
        const fast = okObj(fb) && Array.isArray(fb.staff) ? fb.staff.filter(x => typeof x === 'string' && x.trim()).map(x => x.trim().toLowerCase()) : [];
        const ub = by.unread_badges_v2;
        const unread = okObj(ub) && Array.isArray(ub.staff) ? ub.staff.filter(x => typeof x === 'string' && x.trim()).map(x => x.trim().toLowerCase()) : [];
        const tt = by.thumbnail_title_buttons_staff;
        const ttb = okObj(tt) && Array.isArray(tt.staff) ? tt.staff.filter(x => typeof x === 'string' && x.trim()).map(x => x.trim().toLowerCase()) : [];
        const h = by.review_help_video_url;
        const help = okObj(h) && typeof h.url === 'string' && /^https:\/\//i.test(h.url.trim()) ? h.url.trim() : '';
        const a = by.analytics_hidden;
        return {
            loaded: true,
            all: okObj(c) && c.all === true,
            clients: new Set(members.map(m => _calRuntimeFlagSlug(m)).filter(Boolean)),
            staff: new Set(staff),
            calm: new Set(calm),
            calmAll,
            layout2: new Set(layout2),
            fast: new Set(fast),
            unread: new Set(unread),
            ttb: new Set(ttb),
            help,
            // Only the exact { "hidden": false } shows Analytics.
            analytics: okObj(a) && a.hidden === false,
        };
    }
    async function _rsFetch() {
        if (!CAL_SUPABASE_URL || !CAL_SUPABASE_ANON_KEY) return;
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timer = ctrl ? setTimeout(() => { try { ctrl.abort(); } catch (e) {} }, RS_FLAG_TIMEOUT_MS) : null;
        try {
            const url = CAL_SUPABASE_URL + '/rest/v1/syncview_runtime_flags?select=key,value&key=in.(' + RS_FLAG_KEYS.join(',') + ')';
            const resp = await svFetchRetryOnce(url, { cache: 'no-store', signal: ctrl ? ctrl.signal : undefined, headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' } });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const rows = await resp.json();
            if (!Array.isArray(rows)) throw new Error('shape');
            const next = _rsParse(rows);
            // Analytics shown, or hidden where this browser last saw it shown: the open page draws again too.
            const changed = next.all || next.clients.size || next.staff.size || next.calm.size || next.calmAll || next.layout2.size || next.fast.size || next.ttb.size || next.unread.size || next.analytics || svAnalyticsSeenShown() || _wlCalmHintHas();
            _rsFlags = next;
            _rsHintSave(next);
            _wlCalmHintSave(next);
            _rsKasperFastHintSave(next);
            _rsFlagFailed = false;
            _rsAnalyticsSync();
            // Something switched on: the open page draws again, now as the new page.
            if (changed) { try { window.dispatchEvent(new Event('sv-review-stage-switch')); } catch (e) {} }
        } catch (e) {
            _rsFlags = { loaded: false, all: false, clients: new Set(), staff: new Set(), calm: new Set(), calmAll: false, layout2: new Set(), fast: new Set(), ttb: new Set(), unread: new Set(), help: '', analytics: false };
            _rsFlagFailed = true;
            _rsAnalyticsSync();
            _rsFlagPromise = null;
            console.warn('[Review page] switch unreadable; the old page stays', e && e.message);
        } finally {
            if (timer) clearTimeout(timer);
            // The Review tab showed a loader while the answer was on its way (below): draw it again now, whatever the
            // answer, so a switched-off or unreadable answer brings the old list back.
            if (_wlCalmPendingShown) {
                _wlCalmPendingShown = false;
                if (!svWorkloadCalmOn()) { try { window.dispatchEvent(new Event('sv-review-stage-switch')); } catch (e) {} }
            }
            if (_rsKasperPendingShown) {
                _rsKasperPendingShown = false;
                if (!svRsKasperOn()) { try { window.dispatchEvent(new Event('sv-review-stage-switch')); } catch (e) {} }
            }
            if (_rsPendingShown) {
                _rsPendingShown = false;
                const drawn = _rsFlags.loaded && (_rsFlags.all || _rsFlags.clients.size || _rsFlags.staff.size);
                if (!drawn) { try { window.dispatchEvent(new Event('sv-review-stage-switch')); } catch (e) {} }
            }
        }
    }
    /* The last answer this browser saw, kept as a hint (owner feedback 2026-10-17 23:00 UTC; review of #2167): the
       live read takes 1.5 to 3.7 s, so an SMM who clicks Review soon after the Calendar opens would get the old list
       painted for that long. While the read is still on its way and the hint lists this client, the Review tab shows
       the Calendar's loader instead of the old list. The hint never shows the new page by itself (only the live answer
       does), and a client it does not list keeps today's instant old list, so a switched-off client sees no change. */
    const RS_HINT_KEY = 'sv-rs-on-clients';
    let _rsPendingShown = false;
    function _rsHintSave(f) {
        try { localStorage.setItem(RS_HINT_KEY, JSON.stringify(Object.assign(f.all ? { all: true } : { clients: Array.from(f.clients) }, { help: !!f.help }))); } catch (e) {}
    }
    function _rsHintHas(client) {
        try {
            const h = JSON.parse(localStorage.getItem(RS_HINT_KEY) || 'null');
            if (!h || typeof h !== 'object') return false;
            if (h.all === true) return true;
            const slug = calClientSlug(String(client || ''));
            return !!slug && Array.isArray(h.clients) && h.clients.includes(slug);
        } catch (e) { return false; }
    }
    // The Review tab asks this before it draws the old list: true means "show the loader, the answer is coming".
    function svRsCalPending() {
        if (_rsFlags.loaded || !_rsFlagPromise) return false;
        if (!calState || !calState.client || calState.loading || calState.error) return false;
        if (calState.view !== 'review' && calState.view !== 'smmreview') return false;
        if (!_rsHintHas(calState.client)) return false;
        _rsPendingShown = true;
        return true;
    }
    function _rsPrime() {
        if (_rsFlagPromise) return;
        if (_rsFlagTriedAt && Date.now() - _rsFlagTriedAt < RS_FLAG_RETRY_MS) return;
        _rsFlagTriedAt = Date.now();
        _rsFlagPromise = _rsFetch();
        _rsAnalyticsSync();
    }
    // A bare client link (no v=) asks this beside its link check (260): the answer decides whether the link opens on
    // Analytics or on the Content Calendar, so the page shows its neutral check screen until it is in. Never rejects;
    // bounded by RS_FLAG_TIMEOUT_MS, and an unreadable switch reads as off.
    function svRsFlagsReady() {
        _rsPrime();
        return _rsFlagPromise || Promise.resolve();
    }
    // Did this visit's switch read come back? (A failed or timed-out read is not an answer: 260 keeps what this
    // browser remembered about the link instead of forgetting it, so the next visit still paints in its saved theme.)
    function svRsFlagsLoaded() { return !!_rsFlags.loaded; }
    function _rsClientOn(client) {
        _rsPrime();
        if (!_rsFlags.loaded) return false;
        if (_rsFlags.all) return true;
        let slug = '';
        try { slug = calClientSlug(String(client || '')); } catch (e) { slug = ''; }
        return !!slug && _rsFlags.clients.has(slug);
    }
    // The Calendar's Review tab (a client link, or the SMM's Review tab) for a switched-on client, once its cards
    // are loaded. Anything else is the old page.
    function svRsCalOn() {
        if (!calState || !calState.client || calState.loading || calState.error) return false;
        if (calState.view !== 'review' && calState.view !== 'smmreview') return false;
        if (!document.getElementById('calView')) return false;
        return _rsClientOn(calState.client);
    }
    /* THE CLIENT LINK, WHOLE PAGE (owner feedback, 2026-10-17, session Curtain Two). For a switched-on client the
       new page's header is the client link's only header on all four tabs (Review, Sheet, Month, Week): the old
       Analytics / Content Calendar toggle and the old calendar bar step aside, the pill toggle and the sun/moon
       button stay in one place, and the old bar's own tools (Organize and the card size) move into a fixed slot of
       that header on Sheet, Month and Week. The page has no frame around it, and there is no Analytics at all. */
    const RS_CLIENT_TABS = ['review', 'organizer', 'month', 'week'];
    function svRsClientFull() {
        // A failed card read keeps the page: the header stays and the calendar's own error and retry show under it.
        if (!_isClientLink || !calState || !calState.client) return false;
        if (!RS_CLIENT_TABS.includes(calState.view)) return false;
        if (!document.getElementById('calView')) return false;
        return _rsClientOn(calState.client);
    }
    // No Analytics for a switched-on client (the company dropped client analytics): render() asks this before it
    // draws a client link, and sends an Analytics route to the Content Calendar instead. Since 2026-10-17 (session
    // Curtain Seven) that is every client link while analytics_hidden hides Analytics (its default).
    /* Is the new review page on for this client link? Not the same question as svRsClientNoAnalytics, which is also
       true for every link while Analytics is hidden for everyone. */
    function svRsClientReviewOn(client) {
        return !!_isClientLink && _rsClientOn(client);
    }
    function svRsClientNoAnalytics(client) {
        return !!_isClientLink && (svAnalyticsHidden() || _rsClientOn(client));
    }
    /* ANALYTICS IS GONE FOR EVERYONE (owner, 2026-10-17 23:20, session Curtain Seven), behind one switch so it can
       come back: hidden unless analytics_hidden reads exactly { "hidden": false }. Hidden, the staff bar's Analytics
       tab and the client link's Analytics / Content Calendar toggle are not drawn (CSS keyed on html.sv-analytics-on,
       which only a "shown" answer adds), and a client link's Analytics address opens the Content Calendar. No code
       is removed. A "shown" answer is remembered in this browser, so until this visit's read is in, a browser that last
       saw Analytics shown keeps it (as fast as before), and every other browser hides it at once; a failed read keeps
       what this browser last saw, so nobody is left on Analytics with the toggle hidden. */
    const RS_ANALYTICS_SEEN_KEY = 'sv-analytics-shown';
    function _rsAnalyticsShown() {
        if (_rsFlags.loaded) return !!_rsFlags.analytics;
        // An unreadable switch keeps what this browser last saw: a client who opened on Analytics (shown before) is
        // never left there with the toggle hidden (review of #2179, Lighthouse).
        return svAnalyticsSeenShown();
    }
    function svAnalyticsHidden() {
        _rsPrime();
        return !_rsAnalyticsShown();
    }
    /* Staff are never shown Analytics while it is hidden (session Detour, 2026-10-18): the staff bar has no tab for
       it, so a page that still opened on it would leave the person with nothing to identify or leave it by. Every
       staff route that used to end on Analytics asks this and opens the Content Calendar instead. */
    function svStaffNoAnalytics() {
        return !_isClientLink && svAnalyticsHidden();
    }
    // A staff route moved to the Calendar only because the switch had not been read yet (a browser that never saw
    // Analytics shown): when the read then says shown, within a few seconds and with the person still there, it goes
    // back to Analytics as if it had waited. Any later navigation clears the mark.
    let _rsStaffMove = null;
    function svStaffMarkMove(client) {
        _rsStaffMove = (!_rsFlags.loaded && !_rsFlagFailed) ? { client: client ? String(client) : '', at: Date.now() } : null;
    }
    function svStaffClearMove() { _rsStaffMove = null; }
    // A client link moved off Analytics only because the switch had not been read yet (a browser that never saw
    // Analytics shown): when the read then says shown, within a few seconds of the decision, the link goes back to
    // Analytics as if it had waited (Codex review on #2179). Later than that, the person is already using the calendar.
    const RS_ANALYTICS_RESTORE_MS = 10000;
    let _rsAnalyticsDefaultMove = null;
    function svAnalyticsMarkDefaultMove(client) {
        _rsAnalyticsDefaultMove = (!_rsFlags.loaded && !_rsFlagFailed && client) ? { client: String(client), at: Date.now() } : null;
    }
    function _rsAnalyticsRestore() {
        const mv = _rsAnalyticsDefaultMove;
        _rsAnalyticsDefaultMove = null;
        if (!mv || !_isClientLink || Date.now() - mv.at > RS_ANALYTICS_RESTORE_MS || svRsClientNoAnalytics(mv.client)) return;
        const cap = _syncviewClientEntryCapability;
        if (!cap || !cap.verified || cap.client !== mv.client || (clientViewTab[cap.client] || cap.view) !== 'calendar') return;
        if (typeof window.setClientViewTab === 'function') window.setClientViewTab(encodeURIComponent(cap.client), 'analytics');
    }
    function svAnalyticsSeenShown() {
        try { return localStorage.getItem(RS_ANALYTICS_SEEN_KEY) === '1'; } catch (e) { return false; }
    }
    function _rsAnalyticsSync() {
        const on = _rsAnalyticsShown();
        document.documentElement.classList.toggle('sv-analytics-on', on);
        try { if (on) localStorage.setItem(RS_ANALYTICS_SEEN_KEY, '1'); else if (_rsFlags.loaded) localStorage.removeItem(RS_ANALYTICS_SEEN_KEY); } catch (e) {}
    }
    // The old bar's tools ride in the new header through a slot: this holder is a plain child of the page's host,
    // so the site's own styles and handlers still apply to them. Only the client link with the switch on uses it.
    let _rsToolsEl = null;
    function svRsToolsEl() {
        if (!_rsToolsEl) {
            _rsToolsEl = document.createElement('div');
            _rsToolsEl.className = 'sv-rs-tools';
            _rsToolsEl.setAttribute('slot', 'tools');
        }
        return _rsToolsEl;
    }
    // A fresh calendar shell is about to be drawn: the old bar in the holder is stale (the shell draws a new one).
    function svRsToolsDrop() {
        if (_rsToolsEl) _rsToolsEl.replaceChildren();
    }
    // The calendar shell has just been drawn: on a switched-on client link its new bar goes straight to the header.
    function svRsToolsAdopt() {
        if (svRsClientFull()) _rsToolsSync(true);
    }
    // Takes the calendar's own bar (and, on a phone, its "More" button) into the holder, or gives it back.
    function _rsToolsSync(full) {
        const cv = document.getElementById('calView');
        const el = svRsToolsEl();
        if (full) {
            if (!cv) return;
            const bar = cv.querySelector(':scope > .cal-toolbar');
            const more = cv.querySelector(':scope > .pocket-client-calendar > .pocket-cal-heading-actions');
            if (!bar && !more) return;
            el.replaceChildren();
            if (bar) el.appendChild(bar);
            if (more) el.appendChild(more);
            return;
        }
        if (!el.firstChild) return;
        const bar = el.querySelector(':scope > .cal-toolbar');
        const more = el.querySelector(':scope > .pocket-cal-heading-actions');
        if (cv && bar && !cv.querySelector(':scope > .cal-toolbar')) {
            const pocket = cv.querySelector(':scope > .pocket-client-calendar');
            if (pocket) pocket.after(bar); else cv.prepend(bar);
        }
        if (cv && more) { const pocket = cv.querySelector(':scope > .pocket-client-calendar'); if (pocket) pocket.appendChild(more); }
        el.replaceChildren();
    }
    // Kasper's Review Session, only for the staff member the switch names. Until the server has confirmed who is
    // signed in the answer is no.
    function svRsKasperOn() {
        _rsPrime();
        if (!_rsFlags.loaded || !_rsFlags.staff.size || _isClientLink) return false;
        let who = null;
        try { who = _syncviewStaffIdentityForHeaders(); } catch (e) { who = null; }
        const m = who && who.member;
        if (!m) return false;
        const id = String(m.id || '').trim().toLowerCase(), name = String(m.name || '').trim().toLowerCase();
        return (!!id && _rsFlags.staff.has(id)) || (!!name && _rsFlags.staff.has(name));
    }
    // Kasper's second layout (all parts at once, a list on the left): only where his Review Session is already on, and
    // only for the staff member review_stage_kasper_layout2 names. Until both are read the answer is no: today's layout.
    function svRsKasperLayout2On() {
        if (!svRsKasperOn() || !_rsFlags.layout2.size) return false;
        return _rsListed(_rsFlags.layout2);
    }
    /* FAST BOOT FOR KASPER'S TAB (session Quick, 2026-10-20), behind kasper_fast_boot { "staff": [...] }. The last list
       this browser saw is kept as a hint, so the first second of a visit already knows whether this person is on it
       (the live answer takes 1.5 to 3.7 s). The hint only ever turns the speed-ups on; it never shows a page by itself,
       and a read that fails or names nobody clears it. */
    const RS_KASPER_FAST_KEY = 'sv-kasper-fast';
    // The hint holds both lists: who gets the fast boot, and who the review page's own switch named (the loader below
    // only helps where that page will really come).
    function _rsKasperFastHintSave(f) {
        try { if (f.fast.size) localStorage.setItem(RS_KASPER_FAST_KEY, JSON.stringify({ fast: Array.from(f.fast), stage: Array.from(f.staff) })); else localStorage.removeItem(RS_KASPER_FAST_KEY); } catch (e) {}
    }
    function _rsKasperFastHintHas(key) {
        try {
            const h = JSON.parse(localStorage.getItem(RS_KASPER_FAST_KEY) || 'null');
            const list = h && Array.isArray(h[key || 'fast']) ? h[key || 'fast'] : [];
            return list.length > 0 && _rsListed(new Set(list.filter(x => typeof x === 'string')));
        } catch (e) { return false; }
    }
    // Is the fast boot on for the signed-in staff member? The live answer once it is in, the hint until then.
    function svRsKasperFast() {
        if (_isClientLink) return false;
        _rsPrime();
        if (_rsFlags.loaded) return _rsFlags.fast.size > 0 && _rsListed(_rsFlags.fast);
        // An unreadable switch is an answer of no for this visit; the hint stays for the next one.
        return !_rsFlagFailed && _rsKasperFastHintHas();
    }
    // Called once at boot (260), after the server has said who is signed in and the route is read: on Kasper's tab, start the slow parts now (the
    // review page's code and the player's switch) instead of when the first card paints after the list has loaded.
    function svRsKasperBoot(hashRaw, stateNav) {
        try {
            if (_isClientLink || !svRsKasperFast()) return;
            // Where this page is about to open: the address's own route, else the tab a reload keeps in the history entry.
            // Never the saved tab: a bare address opens Today whatever the last visit used.
            const hash = String(hashRaw || '').toLowerCase();
            const nav = hash ? hash.split('/')[0] : String(stateNav || '');
            if (nav !== 'kasper') return;
            // Only the Review Session needs them: another tool's address (#kasper/hiring-process, #kasper/replies ...), or
            // a reload that restores another tool, opens without them. Old aliases (#kasper/samples) count as Review.
            let sub = hash ? (hash.split('/')[1] || '') : '';
            if (!sub) { try { sub = localStorage.getItem('syncview_kasper_subtab_v1') || ''; } catch (e) { sub = ''; } }
            if (sub && sub !== 'review' && sub !== 'samples') return;   // 'samples' is the old name of the Review Session (_kasperResolveSubtab)
            // The review page's code only if the last read named this person for it too (else it can never mount here).
            if (_rsKasperFastHintHas('stage')) svArea('reviewstage').catch(() => {});
            svFrameFlagWait(0);
        } catch (e) {}
    }
    // While the switch read is still on its way and the hint says the new page is coming for this person, the list holds
