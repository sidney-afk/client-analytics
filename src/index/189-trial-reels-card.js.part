import { showConfirm, showNotify, showToast } from './040-shared-briefs.js';
import { CAL_SUPABASE_ANON_KEY, CAL_SUPABASE_URL } from './100-onboarding-staff-controls.js';
import { _syncviewEfHeaders, _writeUiRecordFailure } from './120-calendar-flags-write-repair.js';
import { _calPendingEdits, calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
import { _calV2Client } from './150-calendar-hydration-import.js';
import { _calLinkFieldHtml, _calRenderBody, onCalViewChange } from './160-calendar-organize-ui.js';
import { _calFlushCardSave } from './170-calendar-links-status.js';
import { svTrialReelsOn } from './188-review-stage-switch.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    /* TRIAL REELS ON THE STAFF CARD (session Trials, 2026-10-27; docs/features/TRIAL_REELS_PLAN.md, approved as #2352).

       One video, several versions (Video A to G) that differ in the text hook, each posted as an Instagram trial reel,
       the winner kept after 24 h. Behind trial_reels_pages (188), staff Calendar only here; a client link never draws
       any of this. Everything lives inside today's Video row, so a collapsed card is exactly today's height:
         - off: today's row plus a faint switch before the pencil;
         - on: "Video · 5" with a tiny state ("2/4 approved", "On trial · 17 h left", a muted trophy once the 24 h are
           up, or just "Video C" once a winner is picked), the switch, and a small arrow that opens the versions under it;
         - opened: "Video A"… each with its link, an edit pencil, a drop control, a label only where it says something
           the row does not (owner: no visual noise), and, once the 24 h are up, a trophy ("Make this the winner").
       The winner is made at once and today's toast offers Undo, as Kasper's approve does; there is no confirm.

       Writes: the versions and the switch go to the trial-reels function. The card's one link (the version on the
       card: Video A, then the winner) is written only through today's paths: Production's attach (production-write
       "attachment") when the card has a video sub-issue, otherwise today's card link save. The function refuses the
       version's copy until the card carries the link, so the card, Production and the log never disagree. */
    const TRIAL_REELS_EF_URL = CAL_SUPABASE_URL + '/functions/v1/trial-reels';
    const TRL_PROD_WRITE_URL = CAL_SUPABASE_URL + '/functions/v1/production-write';
    const TRL_LIST_TTL_MS = 30000;
    const TRL_TROPHY = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v3.5a3 3 0 0 1-6 0z"/><path d="M5 3.5H3a2 2 0 0 0 2 2.5M11 3.5h2a2 2 0 0 1-2 2.5"/><path d="M8 9v2.5M5.5 13.5h5M6.5 11.5h3"/></svg>';
    const TRL_CHEV = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5"/></svg>';
    const TRL_GO = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h4v4"/><path d="M13 3 7 9"/><path d="M12 9.5V13H3V4h3.5"/></svg>';
    const TRL_NEWCUT = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.5"/><path d="M13 2.5v3h-3"/></svg>';
    const TRL_PENCIL = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.4 2.6l2 2L6 12l-2.6.6L4 10z"/></svg>';
    const TRL_DROP = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>';
    const TRL_BACK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6H11a2.5 2.5 0 0 1 0 5H8"/><path d="M7 4 5 6l2 2"/></svg>';
    // What the function's refusals mean, in a sentence a person can act on.
    const TRL_ERRORS = {
        attach_first: 'The card still carries another link for this version. Save the card\'s Video link first, then try again.',
        not_enabled: 'Trial reels are not switched on for this client.',
        trial_reels_off: 'Turn Trial reels on for this card first.',
        main_version: 'The version on the card cannot be dropped.',
        last_live_version: 'This is the last version left, so it cannot be dropped.',
        version_not_change_asked: 'This version is not waiting for a new cut.',
        version_on_trial: 'This version is out on trial, so it cannot change now.',
        // One rule, one sentence (Trialeyes, 2026-10-29): plain text and another site get the same answer.
        link_not_https: 'Paste a Frame.io, Google Drive or Dropbox link to the video.',
        link_host_unsupported: 'Paste a Frame.io, Google Drive or Dropbox link to the video.',
        nothing_approved: 'No version is approved yet.',
        conflict: 'Someone changed this version a moment ago. It has been reloaded; try again.',
        write_failed: 'The video sub-issue could not be read or saved, so nothing changed. Try again in a moment.',
        change_open: 'This version has a change asked. Paste its new cut first, then it can be approved.',
        stage_order: 'This version still needs the SMM\'s OK first.',
        version_has_no_link: 'This version has no link yet. Paste its Frame.io link first.',
        link_used_by_another_version: 'Another version already has this link. Each version needs its own.',
        not_all_approved: 'Every version must be approved before the trial starts.',
        trial_not_over: 'The 24 h trial is not over yet.',
        card_posted: 'This post is already Posted, so the winner cannot change.',
        trial_starts_when_posted: 'The 24 h trial starts by itself when the card is set to Posted.',
        role_not_allowed: 'Your key cannot do this. Ask the SMM.',
        no_letter_left: 'This card already has seven versions, Video A to Video G.',
        post_id_too_long: 'This card cannot take versions. Tell the SyncView team.',
    };

    const _trlCards = {};        // client slug -> { at, cards: { pid: shape }, promise }
    const _trlOpen = new Set();  // pids whose versions list is open
    const _trlEditing = {};      // pid -> letter being edited
    const _trlDraft = {};        // pid -> { letter, text, err }: a link the page refused, kept in its field with why
    const _trlPostedAsked = new Set();   // pid|Posted time: the one re-read a Posted card gets
    /* Each version link's sharing check, the same one Production's Assets run (trial-reels read with probe: true): kept
       per link, so a dead Frame.io link is said on its row once checked, not only when the player fails on it
       (Trialeyes E4, 2026-10-29). Checked after a link is saved, and once per card when its list first opens. */
    const _trlLinkState = {};    // pid|letter -> { url, state }
    const _trlChecked = new Set(), _trlChecking = new Set();
    function _trlCheckLinks(pid, again) {
        const post = _trlPost(pid);
        if (!post || _trlChecking.has(pid) || (!again && _trlChecked.has(pid))) return;
        _trlChecked.add(pid); _trlChecking.add(pid);
        svTrialCall({ action: 'read', client: _trlSlug(post.client || calState.client), post_id: pid, probe: true })
            .then(json => {
                const st = (json && json.link_states) || {};
                for (const v of (json && json.versions) || []) if (st[v.letter] && v.frame_url) _trlLinkState[pid + '|' + v.letter] = { url: String(v.frame_url), state: String(st[v.letter].state || '') };
                _trlRepaintField(pid);
            })
            .catch(() => {})
            .finally(() => _trlChecking.delete(pid));
    }
    // A link the check found dead or locked: its row says so (the words of Production's Assets row).
    function _trlLinkBadHtml(pid, v) {
        const k = _trlLinkState[pid + '|' + v.letter];
        if (!k || !v.frame_url || k.url !== String(v.frame_url) || ['dropped', 'lost', 'winner'].includes(v.status)) return '';
        if (k.state === 'expired') return '<span class="trl-lab" data-l="link not found" title="This link does not open a video. Paste the right link for Video ' + _calEscAttr(v.letter) + '.">link not found</span>';
        if (k.state === 'permission_denied') return '<span class="trl-lab" data-l="no access" title="This link asks for a sign-in. Share it so anyone with the link can view it.">no access</span>';
        return '';
    }
    const _trlBusy = new Set();  // pid|action in flight
    /* Every action answers at once (owner, 2026-10-27: "everything should feel fast"). The row is drawn from the last
       server answer with the changes still in flight laid over it; a change leaves the list when its answer lands, so
       a refusal puts the row back by itself, and the refusal is said in words (never a silent success). The writes of
       one card go out one after another, in click order. */
    const _trlPending = {};      // pid -> [{ apply(shape) -> shape }] changes shown but not answered yet
    const _trlQueue = {};        // pid -> the card's write chain
    const _trlWroteAt = {};      // pid -> when its last write was answered (an older list read must not undo it)
    const _trlDirty = new Set(); // pids whose repaint waits for the link being typed in their list

    function _trlSlug(client) {
        try { return calClientSlug(String(client || '')); } catch (e) { return ''; }
    }
    function _trlStaffOn(post) {
        return !_isClientLink && !!post && !!post.id && svTrialReelsOn(post.client || calState.client);
    }
    async function svTrialCall(body, surface) {
        const resp = await fetch(TRIAL_REELS_EF_URL, {
            method: 'POST', cache: 'no-store',
            headers: _syncviewEfHeaders({ apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, 'Content-Type': 'application/json', Accept: 'application/json' }, TRIAL_REELS_EF_URL),
            body: JSON.stringify(body),
        });
        let json = {};
        try { json = await resp.json(); } catch (e) { json = {}; }
        if (!resp.ok || !json || json.ok !== true) {
            const err = new Error(String((json && json.error) || ('http_' + resp.status)));
            err.code = String((json && json.error) || 'request_failed');
            // Every refused trial-reels write lands in the write-refusal log, like the Calendar's saves (a read does not).
            if (body.action !== 'list' && body.action !== 'read') _writeUiRecordFailure(surface || 'calendar', 'trial_reels_' + body.action, err, { http_status: resp.status });
            throw err;
        }
        return json;
    }
    // What a client is told: plain words, never a server code or the team's words (Allactions, 2026-10-28).
    const TRL_CLIENT_ERRORS = {
        conflict: 'This changed a moment ago. It has been reloaded; try again.',
        change_open: 'This version is waiting for its new cut.',
        stage_order: 'Your team is still looking at this version.',
        version_on_trial: 'This version is already out, so it cannot change now.',
        version_dropped: 'Your team took this version out.',
    };
    function svTrialErrorText(e) {
        const code = String((e && e.code) || (e && e.message) || 'request_failed');
        if (_isClientLink) return TRL_CLIENT_ERRORS[code] || 'This did not save. Check your connection and try again in a moment.';
        return TRL_ERRORS[code] || ('The server answered "' + code + '". Nothing was changed.');
    }
    function _trlSay(e, what) {
        showNotify(what + ' did not save', svTrialErrorText(e));
    }
    /* The client's Sheet and Month (the Supervisor's ruling, 2026-10-29): a trial card looked like any card, and nothing
       said there were several versions. A small muted "3 versions" tag beside the title (the live versions the client
       still has to answer) opens the Review page on that card, at its first waiting version. It lives here, in the core
       part, as the Sheet and Month do (the review page's own part loads later). One read of the client's trial cards,
       kept 30 s; the Sheet or Month draws again when it lands. */
    const _trlTagCards = {};   // slug -> { at, cards, promise }
    let _trlWantPid = '';
    function _trlClientWaits(v) {
        if (v.status !== 'waiting' || v.client_pass_at || v.client_ok_at) return false;
        return v.ready === undefined || v.ready !== false;
    }
    function svTrialClientTagHtml(post, month) {
        if (!_isClientLink || !post || !post.id) return '';
        const slug = _trlSlug(post.client || calState.client);
        if (!slug || !svTrialReelsOn(slug)) return '';
        const e = _trlTagCards[slug] || (_trlTagCards[slug] = { at: 0, cards: {}, promise: null });
        if (!e.promise && Date.now() - e.at > TRL_LIST_TTL_MS) {
            e.promise = svTrialCall({ action: 'list', client: slug, post_id: '' })
                .then(json => { e.cards = (json && json.cards) || {}; }, () => {})
                .finally(() => {
                    const first = !e.at;
                    e.at = Date.now(); e.promise = null;
                    if (first && ['organizer', 'month'].includes(calState.view)) _calRenderBody({ preserveScroll: true });
                });
        }
        const shape = e.cards[post.id];
        if (!shape || !shape.enabled || !Array.isArray(shape.versions) || shape.versions.some(v => v.status === 'winner')) return '';
        const n = shape.versions.filter(_trlClientWaits).length;
        if (!n) return '';
        const words = n + (n === 1 ? ' version' : ' versions');
        const go = 'svTrialClientReview(\'' + _calEscAttr(post.id) + '\')';
        return month
            ? '<span class="cal-trial-tag" title="Review the versions" onclick="event.stopPropagation();' + go + '">' + words + '</span>'
            : '<button type="button" class="cal-trial-tag" title="Review the versions" onclick="' + go + '">' + words + '</button>';
    }
    function svTrialClientReview(pid) {
        _trlWantPid = String(pid || '');
        onCalViewChange('review');
    }
    // The card the tag asked the Review page to open ('' when none); `done` clears it once the page is on it (195).
    function svTrialReviewWanted(done) { const p = _trlWantPid; if (done) _trlWantPid = ''; return p; }
    /* Every trial card of a client, in one read, kept 30 s. The card draws as today until it arrives. */
    function _trlLoad(slug, force) {
        const e = _trlCards[slug] || (_trlCards[slug] = { at: 0, cards: {}, promise: null });
        if (e.promise || (!force && Date.now() - e.at < TRL_LIST_TTL_MS)) return e.promise || Promise.resolve(e);
        const began = Date.now(), first = !e.at;
        let changed = null, moved = [];
        e.promise = svTrialCall({ action: 'list', client: slug, post_id: '' })
            .then(json => {
                const cards = (json && json.cards) || {};
                // A card with a write in flight, or one answered after this read began, keeps its newer answer.
                for (const pid of Object.keys(e.cards)) {
                    if ((_trlPending[pid] || []).length || (_trlWroteAt[pid] || 0) > began) { if (e.cards[pid]) cards[pid] = e.cards[pid]; else delete cards[pid]; }
                }
                // Only the cards whose versions moved are drawn again (a refresh every 30 s must not redraw the rest),
                // and every card on trial: its countdown and the trophy follow the clock, not the server (Codex on PR 2409).
                const onTrial = c => !!(c && (c.versions || []).some(v => v.status === 'on trial'));
                const all = [...new Set(Object.keys(cards).concat(Object.keys(e.cards)))];
                moved = all.filter(pid => JSON.stringify(cards[pid] || null) !== JSON.stringify(e.cards[pid] || null));
                changed = all.filter(pid => onTrial(cards[pid]) || moved.includes(pid));
                e.cards = cards; e.at = Date.now(); return e;
            })
            .catch(() => { e.at = Date.now(); return e; })
            .finally(() => {
                e.promise = null;
                _trlListen();
                if (first || !changed) { _trlRepaintAll(slug); _trlNotesChanged(''); return; }
                changed.forEach(pid => _trlRepaintField(pid));
                // The Notes view follows only a card whose versions moved (it is drawn again, keeping what is typed).
                moved.forEach(pid => _trlNotesChanged(pid));
            });
        return e.promise;
    }
    /* A change said at once (owner, 2026-10-28: "if a client does something on the trial, like approves, it shows
       immediately on the calendar"). trial-reels broadcasts every change on the one channel trial-reels with only the
       first 12 hex of sha256(post_id) (a public channel names no client and no card); the staff Calendar hashes the
       trial cards it holds and reads a match again, that one card. Staff only. A missed message is caught by the 30 s
       refresh. */
    let _trlChannel = null;      // the channel, or a promise of it
    const _trlHeard = {};        // client slug|pid -> timer of the read it asked for
    const _trlHashes = new Map(); // pid -> its 12-hex hash
    const svTrialHash = pid => _trlHash(pid);
    async function _trlHash(pid) {
        if (_trlHashes.has(pid)) return _trlHashes.get(pid);
        const d = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(pid));
        const h = [...new Uint8Array(d)].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 12);
        _trlHashes.set(pid, h);
        return h;
    }
    /* Other pages that show trial cards hear the same broadcast (Trialtest, 2026-10-29: Production's Assets and a second
       client tab waited for their own refresh): each registers once, gets the 12-hex hash, and reads its own card again. */
    const _trlHooks = [];
    function svTrialOnChange(fn) {
        if (!_trlHooks.includes(fn)) _trlHooks.push(fn);
        _trlListen(true);
    }
    function _trlListen(any) {
        // The staff Calendar listens for its own cards; a page that registered a hook listens on a client link too
        // (the message carries only the hash, Supervisor's rule).
        if ((_isClientLink && !any && !_trlHooks.length) || _trlChannel || !(window.crypto && window.crypto.subtle)) return;
        _trlChannel = Promise.resolve().then(() => _calV2Client()).then(client => {
            if (!client || typeof client.channel !== 'function') { _trlChannel = null; return null; }
            const ch = client.channel('trial-reels', { config: { broadcast: { self: false, ack: false } } })
                .on('broadcast', { event: 'changed' }, msg => {
                    const h = String((msg && msg.payload && msg.payload.h) || '');
                    if (!/^[0-9a-f]{12}$/.test(h)) return;
                    if (!_isClientLink) _trlHeardHash(h).catch(() => {});
                    _trlHooks.forEach(fn => { try { fn(h); } catch (e) {} });
                });
            ch.subscribe();
            return ch;
        }).catch(() => { _trlChannel = null; return null; });
    }
    async function _trlHeardHash(h) {
        if (!/^[0-9a-f]{12}$/.test(h)) return;
        // From the cards on screen, each with its own client: a card id is unique only within a client, so another
        // client's card cached earlier under the same id is never the one read (Codex on PR 2412).
        for (const post of calState.posts || []) {
            const slug = _trlSlug(post.client || calState.client), e = slug && _trlCards[slug];
            if (e && e.cards && e.cards[post.id] && await _trlHash(post.id) === h) _trlHeardChange(slug, post.id);
        }
    }
    function _trlHeardChange(slug, pid) {
        // Several changes in a burst (Approve all) read the card once.
        const key = slug + '|' + pid;
        clearTimeout(_trlHeard[key]);
        _trlHeard[key] = setTimeout(() => {
            delete _trlHeard[key];
            const began = Date.now();
            svTrialCall({ action: 'read', client: slug, post_id: pid }).then(json => {
                const e = _trlCards[slug];
                // This page's own write in flight, or answered after the read began, keeps its newer answer.
                if (!e || (_trlPending[pid] || []).length || (_trlWroteAt[pid] || 0) > began) return;
                const was = JSON.stringify(e.cards[pid] || null);
                if (json && json.enabled) { const c = Object.assign({}, json); delete c.ok; delete c.video_deliverable_id; e.cards[pid] = c; } else delete e.cards[pid];
                if (JSON.stringify(e.cards[pid] || null) === was) return;
                _trlRepaintField(pid);
                _trlNotesChanged(pid);
            }).catch(() => {});
        }, 120);
    }
    /* Kasper's queue (330) starts the trial read of each of its clients the moment the queue arrives, before the review
       page's own code has loaded (owner, 2026-10-28: the "TRIAL 3 versions" tiles "appeared really late"). The review
       page (194) then reads from this same list (svTrialListShared), so a staff page asks once per client. */
    function svTrialPrime(clients) {
        if (_isClientLink) return;
        const seen = new Set();
        (clients || []).forEach(c => {
            const slug = _trlSlug(c);
            if (slug && !seen.has(slug) && svTrialReelsOn(slug)) { seen.add(slug); _trlLoad(slug); }
        });
    }
    // The staff list of one client, shared with the review page: { at, cards } once read (a failed read has no cards).
    function svTrialListShared(slug, force) {
        return Promise.resolve(_trlLoad(slug, !!force)).then(e => ({ at: e.at, cards: Object.assign({}, e.cards) }));
    }
    /* The card reads its versions again by itself (owner, 2026-10-28: "I approved one of them, but in the SMM's
       calendar I don't see that it's approved"). A client's answer on the review link writes only the versions, which
       send the Calendar no live change, so while a trial card is on screen the list is read every 30 s, and at once
       when the tab comes back after that long. Staff Calendar only; nothing for a client link or a hidden tab. */
    function _trlRefresh(minAge) {
        if (_isClientLink || (typeof document !== 'undefined' && document.visibilityState === 'hidden')) return;
        if (!document.querySelector('#calView .cal-link-post.trl-main')) return;
        Object.keys(_trlCards).forEach(slug => {
            const e = _trlCards[slug];
            if (e.at && !e.promise && Date.now() - e.at >= minAge && Object.values(e.cards).some(c => c && c.enabled)) _trlLoad(slug, true);
        });
    }
    try {
        // Looked at every 5 s, read once the list is 30 s old: a read that landed late never doubles the wait.
        setInterval(() => _trlRefresh(TRL_LIST_TTL_MS), 5000);
        document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') _trlRefresh(2000); });
    } catch (e) {}
    function _trlShape(post) {
        const slug = _trlSlug(post.client || calState.client);
        const e = _trlCards[slug];
        if (!e || !e.at) { if (slug) _trlLoad(slug); return _trlView(null, post.id); }
        if (Date.now() - e.at > TRL_LIST_TTL_MS) _trlLoad(slug);
        return _trlView(e.cards[post.id] || null, post.id);
    }
    // The last answer with the changes in flight laid over it (each change is written to be applied twice safely).
    function _trlView(base, pid) {
        const ops = _trlPending[pid];
        if (!ops || !ops.length) return base;
        let s = base ? JSON.parse(JSON.stringify(base)) : null;
        for (const op of ops) s = op.apply(s) || s;
        return s;
    }
    /* Show `apply` now, run `task` after the card's earlier writes, and drop the change when it settles: kept by the
       answer the task stored, or gone with the refusal (the task says it in words). Answers the task's result. */
    /* A trial write still on its way: leaving the page asks first (Trialeyes E7, 2026-10-29: a reload 80 ms after
       Enter lost a new version silently). */
    window.addEventListener('beforeunload', e => {
        if (!Object.keys(_trlPending).some(pid => (_trlPending[pid] || []).length)) return;
        e.preventDefault();
        e.returnValue = '';
    });
    function _trlOptimistic(pid, apply, task) {
        const op = { apply };
        (_trlPending[pid] || (_trlPending[pid] = [])).push(op);
        _trlRepaintField(pid);
        const run = () => Promise.resolve().then(task).catch(() => null).then(res => {
            const ops = _trlPending[pid] || [];
            const i = ops.indexOf(op);
            if (i >= 0) ops.splice(i, 1);
            _trlWroteAt[pid] = Date.now();
            _trlRepaintField(pid);
            return res;
        });
        const next = (_trlQueue[pid] || Promise.resolve()).then(run, run);
        _trlQueue[pid] = next;
        return next;
    }
    const _trlFind = (s, letter) => ((s && s.versions) || []).find(x => x.letter === letter) || null;
    /* What the function would refuse about a link in any case, said before anything moves (no flash of a link that then
       goes away). The same hosts as logic.mjs cleanLink (LINK_HOSTS). */
    const TRL_LINK_HOSTS = ['frame.io', 'app.frame.io', 'next.frame.io', 'f.io', 'drive.google.com', 'dropbox.com', 'www.dropbox.com'];
    function _trlLinkError(link) {
        if (!link) return '';
        if (link.length > 2048 || !/^https:\/\/[^\s<>"']+$/i.test(link)) return 'link_not_https';
        let u;
        try { u = new URL(link); } catch (e) { return 'link_not_https'; }
        if (u.username || u.password || !TRL_LINK_HOSTS.includes(u.hostname.toLowerCase().replace(/\.$/, '')) || u.pathname === '/') return 'link_host_unsupported';
        return '';
    }
    function _trlRepaintField(pid) {
        const post = (calState.posts || []).find(p => p.id === pid);
        const field = document.querySelector('.cal-link-field[data-pid-wrap="' + pid + '"][data-fld-wrap="asset_url"]');
        if (!post || !field || field.classList.contains('editing')) return;
        const list = field.nextElementSibling;
        // A link being typed in this list is never wiped by an answer landing for an earlier change: the repaint
        // waits for its save (which repaints).
        const typing = document.activeElement;
        if (list && list.classList.contains('trl-list') && typing && typing.classList.contains('trl-link-input') && list.contains(typing)) { _trlDirty.add(pid); return; }
        _trlDirty.delete(pid);
        if (list && list.classList.contains('trl-list')) list.remove();
        const input = field.querySelector('.cal-link-input');
        field.outerHTML = _calLinkFieldHtml(pid, 'asset_url', post.asset_url, input ? input.placeholder : 'Video URL (Frame.io / Drive)', false, false, post);
    }
    function _trlRepaintAll(slug) {
        (calState.posts || []).forEach(p => { if (_trlSlug(p.client || calState.client) === slug) _trlRepaintField(p.id); });
    }

    // ---- what the row says -------------------------------------------------------------------------------------
    const TRL_LIVE = v => v.status !== 'dropped';
    function _trlTrialUp(shape) {
        return !!shape.trial_ends_at && Date.parse(shape.trial_ends_at) <= Date.now()
            && shape.versions.some(v => v.status === 'on trial');
    }
    function _trlTiny(shape) {
        const vs = shape.versions || [];
        if (vs.some(v => v.status === 'winner')) return { text: '' };
        if (vs.some(v => v.status === 'on trial')) {
            if (_trlTrialUp(shape)) return { trophy: true };
            const ms = Math.max(0, Date.parse(shape.trial_ends_at || '') - Date.now());
            const hrs = Math.max(1, Math.ceil(ms / 3600000)) + ' h left';
            return { text: 'On trial · ' + hrs, html: '<span class="trl-state-w">On trial · </span>' + hrs, words: 'On trial, ' + hrs };
        }
        // A version the client passed on is not waiting for anyone's OK: the team drops it (owner, 2026-10-28).
        const live = vs.filter(v => TRL_LIVE(v) && !v.client_pass_at);
        // A version the client said "Not this one" to is the team's to drop: the collapsed row says so (Trialeyes E9).
        const passed = vs.filter(v => TRL_LIVE(v) && v.client_pass_at).length;
        const drop = passed ? ' · ' + passed + '<span class="trl-state-w"> dropped by the client</span><span class="trl-state-n"> dropped</span>' : '';
        const dropWords = passed ? ', ' + passed + ' dropped by the client' : '';
        if (!live.length) return passed ? { text: passed + ' dropped by the client', html: drop.slice(3), words: passed + ' dropped by the client' } : { text: '' };
        const n = live.filter(v => v.status === 'approved').length;
        return { text: n + '/' + live.length + ' approved' + (passed ? ' · ' + passed + ' dropped by the client' : ''), html: n + '/' + live.length + '<span class="trl-state-w"> approved</span>' + drop, words: n + ' of ' + live.length + ' approved' + dropWords };
    }
    /* No visual noise: a label shows only where it says something the row does not. One every live version shares is
       dropped (the collapsed row already says it), "lost" once there is a winner; "dropped", "winner" and "change
       asked" always stay. */
    function svTrialLabelShown(vs, v) {
        // Every version says where it stands (owner, 2026-10-28: "approved" on A and B, not blank); only "lost" stays
        // unsaid once there is a winner.
        return v.status !== 'lost';
    }
    /* Who said what, per stage, for a version's hover: "SMM: approved · Kasper: waiting · Client: approved". */
    function _trlStagesTitle(v) {
        const said = (ok, stage) => ok ? 'approved' : v.change_by === stage && v.status === 'change asked' ? 'change asked' : 'waiting';
        const client = v.client_pass_at ? 'dropped' : ['approved', 'on trial', 'winner', 'lost'].includes(v.status) || v.client_ok_at ? 'approved' : said(false, 'client');
        return 'SMM: ' + said(!!v.smm_ok_at, 'smm') + ' · Kasper: ' + said(!!v.kasper_ok_at, 'kasper') + ' · Client: ' + client;
    }

    /* A version's label: a pill, except "dropped", which is plain muted text (owner, 2026-10-27: still said, never a
       pill). sv-dropped-note is the one shared class; the card, Production and the review pages all use it. */
    function svTrialLabelHtml(status, v) {
        let s = String(status || '');
        // A waiting version that has passed a stage says where it is now (Trialeyes, 2026-10-29: an SMM-approved
        // version read "waiting" in the same grey as one nobody had seen), in the card status colours of that stage.
        if (v && s === 'waiting' && !v.client_pass_at) s = v.kasper_ok_at ? 'with client' : v.smm_ok_at ? 'with Kasper' : s;
        if (s === 'dropped') return '<span class="sv-dropped-note" data-l="dropped">dropped</span>';
        // The client said "Not this one" (owner, 2026-10-28): the team sees it and drops the version.
        if (v && v.client_pass_at && s === 'waiting') return '<span class="trl-lab" data-l="client dropped" title="' + _calEscAttr('The client dropped this version: take it off the card. ' + _trlStagesTitle(v)) + '">Client dropped</span>';
        return '<span class="trl-lab" data-l="' + _calEscAttr(s) + '"' + (v ? ' title="' + _calEscAttr(_trlStagesTitle(v)) + '"' : '') + '>' + _calEsc(s) + '</span>';
    }

    /* The switch alone, for a card whose switch is off (today's row plus this), with a small muted "Trial reels" word so
       it says what it is without a hover (Trialeyes E5, Supervisor's call, 2026-10-29: phones have no hover). '' when the page
       switch does not list the client, on a client link, or before the switch read is in. */
    function svTrialSwitchHtml(pid, post) {
        if (!_trlStaffOn(post)) return '';
        const shape = _trlShape(post);
        if (shape && shape.enabled) return '';
        const p = _calEscAttr(pid);
        return '<button type="button" class="trl-sw-slot" role="switch" aria-checked="false" title="Trial reels: off. Turn on to post this video as several versions"'
            + ' aria-label="Trial reels" onclick="svTrialToggle(\'' + p + '\',true)"><span class="trl-sw-word" aria-hidden="true">Trial reels</span><i class="trl-sw"></i></button>';
    }
    /* The whole Video row for a card whose switch is on; null otherwise (the caller draws today's row). */
    function svTrialVideoRowHtml(pid, v, post, parts) {
        if (!_trlStaffOn(post)) return null;
        const shape = _trlShape(post);
        if (!shape || !shape.enabled) return null;
        const vs = shape.versions || [];
        const winner = vs.find(x => x.status === 'winner');
        /* The card has just been set to Posted and its approved versions have not started yet: read this one card again
           now, so "On trial" (or the one version's win) shows at once, not on the next 30 s list (Trialeyes E15). */
        if (post.video_status === 'Posted' && vs.some(x => x.status === 'approved') && !vs.some(x => ['on trial', 'winner', 'lost'].includes(x.status))) {
            const k = pid + '|' + String(post.video_status_at || post.updated_at || '');
            if (!_trlPostedAsked.has(k)) { _trlPostedAsked.add(k); setTimeout(() => { _trlFresh(post).then(j => { if (j) _trlRepaintField(pid); }).catch(() => {}); }, 0); }
        }
        // With no version yet, the list stands open: its only row is where the first link is pasted.
        const open = _trlOpen.has(pid) || !vs.length;
        const tiny = _trlTiny(shape);
        // No live version: "Video", never "Video · 0" (Trialeyes E5); the count leaves out dropped versions, as
        // "1/1 approved" beside it does (Trialeyes E8, 2026-10-29).
        const live = vs.filter(TRL_LIVE).length;
        const main = winner ? 'Video ' + winner.letter : live ? 'Video · ' + live : 'Video';
        // The open-link icon only when there is a link to open.
        const ext = String(post.asset_url || '').trim() ? parts.extIco : '';
        const p = _calEscAttr(pid);
        // The row's parts are sibling buttons, styled as one row: the link (opens the video on the card), the state's
        // trophy once the 24 h are up, a quiet filler, the switch, the arrow and today's pencil.
        const busy = (_trlPending[pid] || []).length ? ' aria-busy="true"' : '';
        const row = '<div class="cal-link-field has-link cal-link-post trl-main' + (open ? ' trl-open' : '') + '" data-pid-wrap="' + p + '" data-fld-wrap="asset_url"' + busy + '>'
            + '<button type="button" class="cal-link-pill-open" onclick="_calOpenLink(\'' + p + '\',\'asset_url\')" title="' + _calEscAttr((ext ? 'Open the video' : 'No video link yet') + (tiny.words ? '. ' + tiny.words : '')) + '">' + ext
            + '<span class="cal-link-label"><span class="trl-main-label">' + _calEsc(main) + '</span>'
            + (tiny.html ? '<span class="trl-state">' + tiny.html + '</span>' : '') + '</span></button>'
            + (tiny.trophy ? '<button type="button" class="trl-state-ico" aria-label="Trial over: pick the winner" title="Trial over: pick the winner" onclick="svTrialOpen(\'' + p + '\',true)">' + TRL_TROPHY + '</button>' : '')
            + '<span class="trl-fill" aria-hidden="true"></span>'
            + '<button type="button" class="trl-sw-slot on" role="switch" aria-checked="true" aria-label="Trial reels" title="Trial reels: on" onclick="svTrialToggle(\'' + p + '\',false)"><i class="trl-sw"></i></button>'
            + '<button type="button" class="trl-chev" aria-expanded="' + open + '" aria-label="' + (open ? 'Hide the versions' : 'Show the versions') + '" title="' + (open ? 'Hide the versions' : 'Show the versions') + '" onclick="svTrialOpen(\'' + p + '\')">' + TRL_CHEV + '</button>'
            + '<button type="button" class="cal-link-edit" tabindex="-1" onclick="_calEditLink(\'' + p + '\',\'asset_url\')" title="Edit the link on the card">' + parts.pencil + '</button>'
            + parts.input + '</div>';
        return open ? row + _trlListHtml(pid, shape) : row;
    }
    function _trlListHtml(pid, shape) {
        const vs = shape.versions || [];
        if (vs.some(v => v.frame_url) && !_isClientLink) setTimeout(() => _trlCheckLinks(pid), 0);
        const p = _calEscAttr(pid);
        const up = _trlTrialUp(shape);
        const rows = vs.map(v => {
            const l = _calEscAttr(v.letter);
            if (_trlEditing[pid] === v.letter) {
                const dr = _trlDraft[pid] && _trlDraft[pid].letter === v.letter ? _trlDraft[pid] : null;
                return '<div class="trl-v trl-editing"><span class="trl-l">Video ' + _calEsc(v.letter) + '</span>'
                    + '<input class="trl-link-input" type="url" placeholder="Paste the Frame.io link" value="' + _calEscAttr(dr ? dr.text : v.frame_url || '') + '" data-pid="' + p + '" data-letter="' + l + '"'
                    + (dr ? ' aria-invalid="true" aria-describedby="trl-err-' + p + '"' : '')
                    + ' onkeydown="svTrialLinkKey(event,this)" onblur="svTrialLinkSave(this)" aria-label="Frame.io link for Video ' + l + '"></div>' + _trlErrHtml(pid, dr);
            }
            const link = v.frame_url ? '<a class="trl-go" href="' + _calEscAttr(v.frame_url) + '" target="_blank" rel="noopener noreferrer" title="Open Video ' + l + '">' + TRL_GO + '</a>' : '';
            // The name opens the version too, not only the small icon (owner, 2026-10-27). A version dropped before its
            // link was pasted asks for no link (Trialtest, 2026-10-28).
            const name = v.frame_url ? '<a class="trl-l trl-name" href="' + _calEscAttr(v.frame_url) + '" target="_blank" rel="noopener noreferrer" title="Open Video ' + l + '">Video ' + _calEsc(v.letter) + '</a>'
                : '<span class="trl-l">Video ' + _calEsc(v.letter) + '</span>' + (v.status === 'dropped' ? '' : '<button type="button" class="trl-paste" onclick="svTrialEdit(\'' + p + '\',\'' + l + '\')">Paste the Frame.io link</button>');
            // A version the server has not taken yet says so, not "waiting" (Trialeyes E7, 2026-10-29).
            const label = v._saving ? '<span class="trl-lab" data-l="saving" role="status">saving…</span>'
                : _trlLinkBadHtml(pid, v) || (svTrialLabelShown(vs, v) ? svTrialLabelHtml(v.status, v) : '<span class="trl-lab-gap"></span>');
            const decided = ['on trial', 'winner', 'lost'].includes(v.status);
            const tools = '<span class="trl-tools">'
                + (v.frame_url ? '<button type="button" class="trl-ico" title="Change the link" aria-label="Change the link of Video ' + l + '" onclick="svTrialEdit(\'' + p + '\',\'' + l + '\')">' + TRL_PENCIL + '</button>' : '')
                // Default (b): the new cut sits at the same Frame.io link, so it is said, not pasted (hover only).
                + (v.status === 'change asked' && v.frame_url ? '<button type="button" class="trl-ico" title="New cut ready" aria-label="New cut of Video ' + l + ' ready" onclick="svTrialNewCut(\'' + p + '\',\'' + l + '\')">' + TRL_NEWCUT + '</button>' : '')
                + (!decided && (!v.on_card || _trlNextLive(vs, v.letter)) ? (v.status === 'dropped'
                    ? '<button type="button" class="trl-ico" title="Bring back" aria-label="Bring back Video ' + l + '" onclick="svTrialDrop(\'' + p + '\',\'' + l + '\',true)">' + TRL_BACK + '</button>'
                    : '<button type="button" class="trl-ico" title="Drop this version" aria-label="Drop Video ' + l + '" onclick="svTrialDrop(\'' + p + '\',\'' + l + '\',false)">' + TRL_DROP + '</button>') : '')
                + '</span>';
            const pick = up && v.status === 'on trial'
                ? '<button type="button" class="trl-pick" title="Make this the winner" aria-label="Make this the winner" onclick="svTrialPick(\'' + p + '\',\'' + l + '\')">' + TRL_TROPHY + '</button>' : '';
            return '<div class="trl-v' + (v.status === 'dropped' ? ' trl-dropped' : '') + '">' + link + name + tools + label + pick + '</div>'
                + (v.status === 'dropped' ? '' : _trlElsewhereHtml(pid, v.frame_url));
        }).join('');
        // The 24 h start by themselves once the card is Posted (owner, 2026-10-28): no "Start the 24 h" link here.
        return '<div class="trl-list">' + rows + _trlAddHtml(pid, vs) + '</div>';
    }
    /* The next free letter (A to G), to add a version by pasting its link. Until 2026-10-27 a card listed only the
       versions the AI editor had logged, so a card it had not logged had nowhere to paste a link. Gone once the trial
       starts. */
    /* A version's link that another card of this client also carries (its Video link, or one of its versions): kept, as
       the team may mean it, and said under the row in a quiet line (Trialeyes E17, 2026-10-29). Only cards this page has
       loaded are looked at. */
    function _trlElsewhereHtml(pid, link) {
        link = String(link || '');
        if (!link) return '';
        const here = (calState.posts || []).find(p => p.id === pid);
        const slug = here && _trlSlug(here.client || calState.client);
        const cached = (slug && _trlCards[slug] && _trlCards[slug].cards) || {};
        const other = (calState.posts || []).find(p => p.id !== pid && (!here || p.client === here.client)
            && (String(p.asset_url || '') === link || ((cached[p.id] && cached[p.id].versions) || []).some(x => x.status !== 'dropped' && String(x.frame_url || '') === link)));
        if (!other) return '';
        const name = String(other.name || '').trim() || 'another card';
        return '<div class="trl-link-note">This link is also on \u201c' + _calEsc(name) + '\u201d.</div>';
    }
    // Why the page did not take a link, under its field (never a dialog, and the text stays to fix).
    function _trlErrHtml(pid, dr) {
        return dr ? '<div class="trl-link-err" id="trl-err-' + _calEscAttr(pid) + '" role="alert">' + _calEsc(dr.err) + '</div>' : '';
    }
    function _trlAddHtml(pid, vs) {
        if (vs.some(v => ['on trial', 'winner', 'lost'].includes(v.status))) return '';
        const used = new Set(vs.map(v => v.letter));
        const next = ['A', 'B', 'C', 'D', 'E', 'F', 'G'].find(l => !used.has(l));
        if (!next) return '';
        const p = _calEscAttr(pid);
        if (_trlEditing[pid] === '+') {
            const dr = _trlDraft[pid] && _trlDraft[pid].letter === '+' ? _trlDraft[pid] : null;
            return '<div class="trl-v trl-editing trl-add"><span class="trl-l">Video ' + next + '</span>'
                + '<input class="trl-link-input" type="url" placeholder="Paste the Frame.io link" value="' + _calEscAttr(dr ? dr.text : '') + '" data-pid="' + p + '" data-letter="+"'
                + (dr ? ' aria-invalid="true" aria-describedby="trl-err-' + p + '"' : '')
                + ' onkeydown="svTrialLinkKey(event,this)" onblur="svTrialLinkSave(this)" aria-label="Frame.io link for Video ' + next + '"></div>' + _trlErrHtml(pid, dr);
        }
        // A minimal "+ Add version" that opens the paste field (owner, 2026-10-28: no "Video E  Paste the Frame.io link").
        // No hover tip: the button says what it does, and the tip covered the row above (Trialeyes E6, 2026-10-29).
        return '<div class="trl-v trl-add"><button type="button" class="trl-paste trl-addbtn" aria-label="Add Video ' + next + ' by pasting its link" onclick="svTrialEdit(\'' + p + '\',\'+\')">+ Add version</button></div>';
    }

    // ---- actions -----------------------------------------------------------------------------------------------
    function _trlPost(pid) { return (calState.posts || []).find(p => p.id === pid) || null; }
    async function _trlRun(pid, key, body, what) {
        const post = _trlPost(pid);
        if (!post || _trlBusy.has(pid + '|' + key)) return null;
        const slug = _trlSlug(post.client || calState.client);
        _trlBusy.add(pid + '|' + key);
        try {
            const json = await svTrialCall(Object.assign({ client: slug, post_id: pid }, body));
            const e = _trlCards[slug] || (_trlCards[slug] = { at: Date.now(), cards: {}, promise: null });
            if (json.versions) e.cards[pid] = Object.assign({}, e.cards[pid] || {}, { enabled: true, winner_letter: json.winner_letter || null }, json);
            if (key === 'link') _trlCheckLinks(pid, true);
            return json;
        } catch (e) {
            // This one card read again now (a list read would keep the change still in flight over it).
            if (e && e.code === 'conflict') await _trlFresh(post);
            _trlSay(e, what);
            return null;
        } finally {
            _trlBusy.delete(pid + '|' + key);
            _trlRepaintField(pid);
        }
    }
    /* On: the row and its versions list show at once, the list open by itself so the paste row for the next version is
       right there (owner, 2026-10-27), seeded as the function seeds it (Video A is the card's link); then the one card
       is read, not the whole client's list. Off: today's row at once. A refusal puts the row back and says so. */
    function svTrialToggle(pid, on, sure) {
        const post = _trlPost(pid);
        if (!post) return Promise.resolve(null);
        /* One click on the switch with versions on the card asks first (Trialeyes E19, 2026-10-29: three approved
           versions vanished at a stray click). The versions are kept and come back if it is turned on again. */
        const had = !on && !sure && ((_trlShape(post) || {}).versions || []).filter(TRL_LIVE).length;
        if (had) {
            return new Promise(res => showConfirm('Turn off trial reels?', 'The ' + had + (had === 1 ? ' version is' : ' versions are') + ' kept and come back if you turn it on again.',
                () => res(svTrialToggle(pid, false, true)), 'Turn off'));
        }
        const slug = _trlSlug(post.client || calState.client);
        const seed = String(post.asset_url || '').trim();
        const wasOpen = _trlOpen.has(pid);
        if (on) _trlOpen.add(pid); else _trlOpen.delete(pid);
        return _trlOptimistic(pid, s => {
            if (!on) return Object.assign(s || { versions: [] }, { enabled: false });
            if (s && s.enabled) return s;
            return { enabled: true, winner_letter: null, versions: seed && !_trlLinkError(seed) ? [{ letter: 'A', status: 'waiting', frame_url: seed, on_card: true }] : [] };
        }, async () => {
            const json = await _trlRun(pid, 'switch', { action: 'switch_set', enabled: !!on }, 'Trial reels');
            if (!json) { if (wasOpen) _trlOpen.add(pid); else _trlOpen.delete(pid); return null; }
            const e = _trlCards[slug] || (_trlCards[slug] = { at: Date.now(), cards: {}, promise: null });
            if (!on) { delete e.cards[pid]; return json; }
            if (!(await _trlFresh(post))) await _trlLoad(slug, true);
            return json;
        });
    }
    function svTrialOpen(pid, force) {
        if (force || !_trlOpen.has(pid)) _trlOpen.add(pid); else _trlOpen.delete(pid);
        _trlRepaintField(pid);
    }
    function svTrialEdit(pid, letter) {
        _trlEditing[pid] = letter;
        _trlRepaintField(pid);
        const input = document.querySelector('.trl-link-input[data-pid="' + pid + '"]');
        if (input) { input.focus(); input.select(); }
    }
    function svTrialLinkKey(ev, input) {
        if (ev.key === 'Enter') { ev.preventDefault(); input.dataset.enter = '1'; input.blur(); }
        if (ev.key === 'Escape') { ev.preventDefault(); input.dataset.cancel = '1'; input.blur(); }
    }
    /* A link the page refuses before anything is sent: it stays in its field with the reason under it. Enter keeps the
       focus there to fix it; a click away leaves the field open with the text until Escape or a good link. */
    function _trlRefuse(input, pid, letter, link, code) {
        _trlDraft[pid] = { letter, text: link, err: TRL_ERRORS[code] || svTrialErrorText({ code }) };
        _trlEditing[pid] = letter;
        _trlRepaintField(pid);
        if (input.dataset.enter === '1') {
            const again = document.querySelector('.trl-link-input[data-pid="' + pid + '"]');
            if (again) { again.focus(); again.setSelectionRange(again.value.length, again.value.length); }
        }
    }
    /* The card's one link, through today's paths only. With a video sub-issue: Production's attach (it writes file_url
       and the database projects it onto the card's asset_url). Without one: today's card link save. Answers the
       sub-issue's clock after the attach ('' without a sub-issue). `since` (a clock this page's own attach answered)
       makes it a compare-and-swap: the attach lands only if nobody moved the sub-issue since, else write_conflict. */
    async function _trlSetCardLink(post, link, since) {
        const deliverableId = String(post.video_deliverable_id || '').trim();
        if (!deliverableId) {
            if (!_calPendingEdits[post.id]) _calPendingEdits[post.id] = {};
            _calPendingEdits[post.id].asset_url = link;
            post.asset_url = link;
            await _calFlushCardSave(post.id);
            return '';
        }
        const read = await fetch(CAL_SUPABASE_URL + '/rest/v1/production_deliverables_browser_v1?select=id,client_slug,updated_at&id=eq.' + encodeURIComponent(deliverableId), {
            cache: 'no-store', headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' },
        });
        const rows = read.ok ? await read.json().catch(() => []) : [];
        const row = Array.isArray(rows) ? rows[0] : null;
        if (!row || !row.updated_at) {
            const err = Object.assign(new Error('The video sub-issue could not be read'), { code: 'write_failed' });
            _writeUiRecordFailure('calendar', 'trial_reels_card_link', err, { http_status: read.status });
            throw err;
        }
        let requestId = '';
        try { requestId = 'trial:attachment:' + crypto.randomUUID(); } catch (e) { requestId = 'trial:attachment:' + Date.now().toString(36) + Math.random().toString(36).slice(2); }
        const resp = await fetch(TRL_PROD_WRITE_URL, {
            method: 'POST', cache: 'no-store',
            headers: _syncviewEfHeaders({ apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json', 'Content-Type': 'application/json' }, TRL_PROD_WRITE_URL),
            body: JSON.stringify({ operation: 'attachment', surface: 'production', entity: 'deliverable', id: deliverableId,
                client_slug: row.client_slug, request_id: requestId, source_edited_at: new Date().toISOString(),
                file_url: link, expected_updated_at: since || row.updated_at }),
        });
        const json = await resp.json().catch(() => ({}));
