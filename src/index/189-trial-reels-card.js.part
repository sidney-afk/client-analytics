    const TRL_RETRIES = 2;
    const TRL_RETRY_MS = 500;
    const TRL_RETRY_MAX_MS = 4000;
    const TRL_FAIL_COOL_MS = 10000;
    // Many clients in one read (list_many), at most this many a request; 'no' once the function says it does not know it.
    const TRL_BATCH_MAX = 50;
    let _trlBatch = '';
    const TRL_TROPHY = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v3.5a3 3 0 0 1-6 0z"/><path d="M5 3.5H3a2 2 0 0 0 2 2.5M11 3.5h2a2 2 0 0 1-2 2.5"/><path d="M8 9v2.5M5.5 13.5h5M6.5 11.5h3"/></svg>';
    const TRL_CHEV = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5"/></svg>';
    const TRL_GO = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h4v4"/><path d="M13 3 7 9"/><path d="M12 9.5V13H3V4h3.5"/></svg>';
    const TRL_NEWCUT = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.5"/><path d="M13 2.5v3h-3"/></svg>';
    const TRL_PENCIL = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.4 2.6l2 2L6 12l-2.6.6L4 10z"/></svg>';
    const TRL_DROP = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>';
    const TRL_BACK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6H11a2.5 2.5 0 0 1 0 5H8"/><path d="M7 4 5 6l2 2"/></svg>';
    // What the function's refusals mean, in a sentence a person can act on.
    const TRL_ERRORS = {
        attach_first: 'The card still carries another link for this version. Save the card\'s Video link first, then try again.',
        not_enabled: 'Trial reels are not switched on for this client.',
        trial_reels_off: 'Turn Trial reels on for this card first.',
        main_version: 'The version on the card cannot be dropped.',
        last_live_version: 'This is the last version left, so it cannot be dropped.',
        version_not_change_asked: 'This version is not waiting for a new cut.',
        version_on_trial: 'This version is out on trial, so it cannot change now.',
        // One rule, one sentence (Trialeyes, 2026-10-29): plain text and another site get the same answer.
        link_not_https: 'Paste a Frame.io, Google Drive or Dropbox link to the video.',
        link_host_unsupported: 'Paste a Frame.io, Google Drive or Dropbox link to the video.',
        nothing_approved: 'No version is approved yet.',
        conflict: 'Someone changed this version a moment ago. It has been reloaded; try again.',
        write_failed: 'The video sub-issue could not be read or saved, so nothing changed. Try again in a moment.',
        change_open: 'This version has a change asked. Paste its new cut first, then it can be approved.',
        stage_order: 'This version still needs the SMM\'s OK first.',
        version_has_no_link: 'This version has no link yet. Paste its Frame.io link first.',
        link_used_by_another_version: 'Another version already has this link. Each version needs its own.',
        not_all_approved: 'Every version must be approved before the trial starts.',
        trial_not_over: 'The 24 h trial is not over yet.',
        card_posted: 'This post is already Posted, so the winner cannot change.',
        trial_starts_when_posted: 'The 24 h trial starts by itself when the card is set to Posted.',
        role_not_allowed: 'Your key cannot do this. Ask the SMM.',
        no_letter_left: 'This card already has seven versions, Video A to Video G.',
        post_id_too_long: 'This card cannot take versions. Tell the SyncView team.',
        version_is_card: 'This version is the one on the card. Change its link from its own row, and its thumbnail and caption on the card.',
        thumbnail_not_https: 'Paste the thumbnail\'s https link.',
        thumbnail_too_long: 'This thumbnail link is too long. Paste a shorter link.',
        caption_too_long: 'A caption can be at most 4000 characters.',
        fields_off: 'Version thumbnails and captions are not switched on for this client.',
        fields_unavailable: 'Version thumbnails and captions are not ready yet. Tell the SyncView team.',
        version_dropped: 'This version was dropped. Bring it back first.',
        letter_twice: 'Each letter can take one video only.',
        link_twice: 'Each video can go to one letter only.',
        letter_invalid: 'Versions go from Video A to Video G.',
        too_many_versions: 'A card takes at most seven versions, Video A to Video G.',
        nothing_to_import: 'Give at least one video a letter first.',
        status_invalid: 'A version takes the card\'s statuses up to Approved. Scheduled and Posted are set on the card.',
        status_follows_card: 'The card was sent on as a whole, so this version follows the card. Set the card\'s Video status instead.',
    };

    const _trlCards = {};        // client slug -> { at, cards: { pid: shape }, promise }
    const _trlOpen = new Set();  // pids whose versions list is open
    const _trlEditing = {};      // pid -> letter being edited
    const _trlDraft = {};        // pid -> { letter, text, err }: a link the page refused, kept in its field with why
    const _trlPostedAsked = new Set();   // pid|Posted time: the one re-read a Posted card gets
    /* Each version link's sharing check, the same one Production's Assets run (trial-reels read with probe: true): kept
       per link, so a dead Frame.io link is said on its row once checked, not only when the player fails on it
       (Trialeyes E4, 2026-10-29). Checked after a link is saved, and once per card when its list first opens. */
    const _trlLinkState = {};    // pid|letter -> { url, state }
    const _trlChecked = new Set(), _trlChecking = new Set();
    function _trlCheckLinks(pid, again) {
        const post = _trlPost(pid);
        if (!post || _trlChecking.has(pid) || (!again && _trlChecked.has(pid))) return;
        _trlChecked.add(pid); _trlChecking.add(pid);
        svTrialCall({ action: 'read', client: _trlSlug(post.client || calState.client), post_id: pid, probe: true })
            .then(json => {
                const st = (json && json.link_states) || {};
                for (const v of (json && json.versions) || []) if (st[v.letter] && v.frame_url) _trlLinkState[pid + '|' + v.letter] = { url: String(v.frame_url), state: String(st[v.letter].state || '') };
                _trlRepaintField(pid);
            })
            .catch(() => {})
            .finally(() => _trlChecking.delete(pid));
    }
    // A link the check found dead or locked: its row says so (the words of Production's Assets row).
    function _trlLinkBadHtml(pid, v) {
        const k = _trlLinkState[pid + '|' + v.letter];
        // A version the client dropped keeps "Client dropped": the team takes it off the card either way (Trialtest).
        if (!k || !v.frame_url || k.url !== String(v.frame_url) || ['dropped', 'lost', 'winner'].includes(v.status) || v.client_pass_at) return '';
        if (k.state === 'expired') return '<span class="trl-lab" data-l="link not found" title="This link does not open a video. Paste the right link for Video ' + _calEscAttr(v.letter) + '.">link not found</span>';
        if (k.state === 'permission_denied') return '<span class="trl-lab" data-l="no access" title="This link asks for a sign-in. Share it so anyone with the link can view it.">no access</span>';
        return '';
    }
    const _trlBusy = new Set();  // pid|action in flight
    /* Every action answers at once (owner, 2026-10-27: "everything should feel fast"). The row is drawn from the last
       server answer with the changes still in flight laid over it; a change leaves the list when its answer lands, so
       a refusal puts the row back by itself, and the refusal is said in words (never a silent success). The writes of
       one card go out one after another, in click order. */
    const _trlPending = {};      // pid -> [{ apply(shape) -> shape }] changes shown but not answered yet
    const _trlQueue = {};        // pid -> the card's write chain
    const _trlWroteAt = {};      // pid -> when its last write was answered (an older list read must not undo it)
    const _trlDirty = new Set(); // pids whose repaint waits for the link being typed in their list

    function _trlSlug(client) {
        try { return calClientSlug(String(client || '')); } catch (e) { return ''; }
    }
    function _trlStaffOn(post) {
        return !_isClientLink && !!post && !!post.id && svTrialReelsOn(post.client || calState.client);
    }
    async function svTrialCall(body, surface) {
        let resp;
        try {
            resp = await fetch(TRIAL_REELS_EF_URL, {
            method: 'POST', cache: 'no-store',
            headers: _syncviewEfHeaders({ apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, 'Content-Type': 'application/json', Accept: 'application/json' }, TRIAL_REELS_EF_URL),
            body: JSON.stringify(body),
            });
        } catch (netErr) {
            // Never reached the function (offline, a dropped connection): worth a retry for a read. The browser's own
            // error is kept as it was (no new refusal code: a write's failure is recorded exactly as before).
            if (netErr && typeof netErr === 'object') { netErr.transient = true; netErr.status = 0; }
            throw netErr;
        }
        let json = {};
        try { json = await resp.json(); } catch (e) { json = {}; }
        if (!resp.ok || !json || json.ok !== true) {
            const err = new Error(String((json && json.error) || ('http_' + resp.status)));
            err.code = String((json && json.error) || 'request_failed');
            err.status = resp.status;
            // The platform's own refusal (429 RATE_LIMIT_EXCEEDED) and a gateway that could not answer are worth a retry.
            err.transient = resp.status === 429 || resp.status === 502 || resp.status === 503 || resp.status === 504;
            const after = Number(resp.headers && resp.headers.get ? resp.headers.get('retry-after') : NaN);
            if (after > 0) err.retryAfterMs = after * 1000;
            // Every refused trial-reels write lands in the write-refusal log, like the Calendar's saves (a read does not).
            if (body.action !== 'list' && body.action !== 'list_many' && body.action !== 'read') _writeUiRecordFailure(surface || 'calendar', 'trial_reels_' + body.action, err, { http_status: resp.status });
            throw err;
        }
        return json;
    }
    // What a client is told: plain words, never a server code or the team's words (Allactions, 2026-10-28).
    const TRL_CLIENT_ERRORS = {
        conflict: 'This changed a moment ago. It has been reloaded; try again.',
        change_open: 'This version is waiting for its new cut.',
        stage_order: 'Your team is still looking at this version.',
        version_on_trial: 'This version is already out, so it cannot change now.',
        version_dropped: 'Your team took this version out.',
    };
    function svTrialErrorText(e) {
        const code = String((e && e.code) || (e && e.message) || 'request_failed');
        if (_isClientLink) return TRL_CLIENT_ERRORS[code] || 'This did not save. Check your connection and try again in a moment.';
        return TRL_ERRORS[code] || ('The server answered "' + code + '". Nothing was changed.');
    }
    function _trlSay(e, what) {
        showNotify(what + ' did not save', svTrialErrorText(e));
    }
    /* The client's Sheet and Month (the Supervisor's ruling, 2026-10-29): a trial card looked like any card, and nothing
       said there were several versions. A small muted "3 versions" tag beside the title (the live versions the client
       still has to answer) opens the Review page on that card, at its first waiting version. It lives here, in the core
       part, as the Sheet and Month do (the review page's own part loads later). One read of the client's trial cards,
       kept 30 s; the Sheet or Month draws again when it lands. */
    const _trlTagCards = {};   // slug -> { at, cards, promise }
    let _trlWantPid = '';
    function _trlClientWaits(v) {
        if (v.status !== 'waiting' || v.client_pass_at || v.client_ok_at) return false;
        return v.ready === undefined || v.ready !== false;
    }
    function svTrialClientTagHtml(post, month) {
        if (!_isClientLink || !post || !post.id) return '';
        const slug = _trlSlug(post.client || calState.client);
        if (!slug || !svTrialReelsOn(slug)) return '';
        const e = _trlTagCards[slug] || (_trlTagCards[slug] = { at: 0, cards: {}, promise: null });
        if (!e.promise && Date.now() - e.at > TRL_LIST_TTL_MS) {
            e.promise = svTrialCall({ action: 'list', client: slug, post_id: '' })
                .then(json => { e.cards = (json && json.cards) || {}; }, () => {})
                .finally(() => {
                    const first = !e.at;
                    e.at = Date.now(); e.promise = null;
                    if (first && ['organizer', 'month'].includes(calState.view)) _calRenderBody({ preserveScroll: true });
                });
        }
        const shape = e.cards[post.id];
        if (!shape || !shape.enabled || !Array.isArray(shape.versions) || shape.versions.some(v => v.status === 'winner')) return '';
        const n = shape.versions.filter(_trlClientWaits).length;
        if (!n) return '';
        const words = n + (n === 1 ? ' version' : ' versions');
        const go = 'svTrialClientReview(\'' + _calEscAttr(post.id) + '\')';
        return month
            ? '<span class="cal-trial-tag" title="Review the versions" onclick="event.stopPropagation();' + go + '">' + words + '</span>'
            : '<button type="button" class="cal-trial-tag" title="Review the versions" onclick="' + go + '">' + words + '</button>';
    }
    function svTrialClientReview(pid) {
        _trlWantPid = String(pid || '');
        onCalViewChange('review');
    }
    // The card the tag asked the Review page to open ('' when none); `done` clears it once the page is on it (195).
    function svTrialReviewWanted(done) { const p = _trlWantPid; if (done) _trlWantPid = ''; return p; }
    /* A read (list or list_many), retried when the platform refused it or it never arrived (OPEN_REPAIRS 631): after
       Retry-After when the answer says, otherwise 0.5 s, then 1 s; never longer than 4 s. Any other refusal is final. */
    async function _trlRead(body) {
        for (let attempt = 0; ; attempt++) {
            try { return await svTrialCall(body); }
            catch (err) {
                if (!err || !err.transient || attempt >= TRL_RETRIES) throw err;
                const wait = Math.min(TRL_RETRY_MAX_MS, err.retryAfterMs || TRL_RETRY_MS * Math.pow(2, attempt));
                await new Promise(r => setTimeout(r, wait));
            }
        }
    }
    const svTrialRead = body => _trlRead(body);
    function _trlSignedIn() {
        /* The staff list needs a verified staff key: without one the function answers 401 and the page logs an error.
           Not read, so no versions, as with Trial reels off; the next draw after sign-in reads it (OPEN_REPAIRS 630). */
        try { return !!_syncviewStaffIdentityForHeaders(); } catch (err) { return false; }
    }
    // Does this client's list need a read now (none in flight, older than 30 s, not cooling off after a failed read)?
    function _trlDue(e, force) {
        if (e.promise) return false;
        if (e.failedAt && Date.now() - e.failedAt < TRL_FAIL_COOL_MS) return false;
        return !!force || Date.now() - e.at >= TRL_LIST_TTL_MS;
    }
    const _trlEntry = slug => _trlCards[slug] || (_trlCards[slug] = { at: 0, cards: {}, promise: null });
    /* Every trial card of a client, in one read, kept 30 s. The card draws as today until it arrives. `fetchList`
       answers { cards } for this client: its own list read, or its share of a list_many (_trlLoadMany). A read the
       platform refused or that never arrived keeps the cards already held and does not count as read (the client is
       read again after TRL_FAIL_COOL_MS); any other refusal counts as read, as before. */
    function _trlLoad(slug, force, fetchList) {
        const e = _trlEntry(slug);
        if (!_trlDue(e, force)) return e.promise || Promise.resolve(e);
        if (!_trlSignedIn()) return Promise.resolve(e);
        const began = Date.now(), first = !e.at;
        let changed = null, moved = [];
        e.promise = (fetchList ? fetchList() : _trlRead({ action: 'list', client: slug, post_id: '' }))
            .then(json => {
                const cards = (json && json.cards) || {};
                // A card with a write in flight, or one answered after this read began, keeps its newer answer.
                for (const pid of Object.keys(e.cards)) {
                    if ((_trlPending[pid] || []).length || (_trlWroteAt[pid] || 0) > began) { if (e.cards[pid]) cards[pid] = e.cards[pid]; else delete cards[pid]; }
                }
                // Only the cards whose versions moved are drawn again (a refresh every 30 s must not redraw the rest),
                // and every card on trial: its countdown and the trophy follow the clock, not the server (Codex on PR 2409).
                const onTrial = c => !!(c && (c.versions || []).some(v => v.status === 'on trial'));
                const all = [...new Set(Object.keys(cards).concat(Object.keys(e.cards)))];
                moved = all.filter(pid => JSON.stringify(cards[pid] || null) !== JSON.stringify(e.cards[pid] || null));
                changed = all.filter(pid => onTrial(cards[pid]) || moved.includes(pid));
                e.cards = cards; e.at = Date.now(); e.failedAt = 0; return e;
            })
            .catch(err => {
                if (err && err.transient) { e.failedAt = Date.now(); changed = []; return e; }
                e.at = Date.now(); return e;
            })
            .finally(() => {
                e.promise = null;
                _trlListen();
                if (first || !changed) { _trlRepaintAll(slug); _trlNotesChanged(''); return; }
                changed.forEach(pid => _trlRepaintField(pid));
                // The Notes view follows only a card whose versions moved (it is drawn again, keeping what is typed).
                moved.forEach(pid => _trlNotesChanged(pid));
            });
        return e.promise;
    }
    /* The lists of many clients (OPEN_REPAIRS 631): one list_many request for up to TRL_BATCH_MAX clients, instead of
       one request each (Kasper's queue asked 48 at once, and the platform refused part of such a burst with 429). A
       client the page switch leaves out comes back with no list, read as no trial cards, as a single list's 403 is. A
       function from before list_many answers 400 unknown_action: this page then asks one client at a time, as before
       (the deploy window). */
    function _trlLoadMany(slugs, force) {
        const due = [...new Set((slugs || []).filter(Boolean))].filter(slug => _trlDue(_trlEntry(slug), force));
        const rest = (slugs || []).filter(Boolean).map(slug => _trlCards[slug] && _trlCards[slug].promise).filter(Boolean);
        if (!due.length || !_trlSignedIn()) return Promise.all(rest).then(() => undefined);
        if (_trlBatch === 'no' || due.length === 1) return Promise.all(due.map(slug => _trlLoad(slug, force)).concat(rest)).then(() => undefined);
        const reads = [];
        for (let i = 0; i < due.length; i += TRL_BATCH_MAX) {
            const chunk = due.slice(i, i + TRL_BATCH_MAX);
            const many = _trlRead({ action: 'list_many', clients: chunk });
            many.catch(() => {});
            chunk.forEach(slug => reads.push(_trlLoad(slug, true, () => many.then(
                json => (json && json.clients && json.clients[slug]) || { cards: {} },
                err => {
                    if (!err || err.transient || (err.status !== 400 && err.code !== 'unknown_action')) throw err;
                    _trlBatch = 'no';
                    return _trlRead({ action: 'list', client: slug, post_id: '' });
                }))));
        }
        return Promise.all(reads.concat(rest)).then(() => undefined);
    }
    /* A change said at once (owner, 2026-10-28: "if a client does something on the trial, like approves, it shows
       immediately on the calendar"). trial-reels broadcasts every change on the one channel trial-reels with only the
       first 12 hex of sha256(post_id) (a public channel names no client and no card); the staff Calendar hashes the
       trial cards it holds and reads a match again, that one card. Staff only. A missed message is caught by the 30 s
       refresh. */
    let _trlChannel = null;      // the channel, or a promise of it
    const _trlHeard = {};        // client slug|pid -> timer of the read it asked for
    const _trlHashes = new Map(); // pid -> its 12-hex hash
    const svTrialHash = pid => _trlHash(pid);
    async function _trlHash(pid) {
        if (_trlHashes.has(pid)) return _trlHashes.get(pid);
        const d = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(pid));
        const h = [...new Uint8Array(d)].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 12);
        _trlHashes.set(pid, h);
        return h;
    }
    /* Other pages that show trial cards hear the same broadcast (Trialtest, 2026-10-29: Production's Assets and a second
       client tab waited for their own refresh): each registers once, gets the 12-hex hash, and reads its own card again. */
    const _trlHooks = [];
    function svTrialOnChange(fn) {
        if (!_trlHooks.includes(fn)) _trlHooks.push(fn);
        _trlListen(true);
    }
    function _trlListen(any) {
        // The staff Calendar listens for its own cards; a page that registered a hook listens on a client link too
        // (the message carries only the hash, Supervisor's rule).
        if ((_isClientLink && !any && !_trlHooks.length) || _trlChannel || !(window.crypto && window.crypto.subtle)) return;
        _trlChannel = Promise.resolve().then(() => _calV2Client()).then(client => {
            if (!client || typeof client.channel !== 'function') { _trlChannel = null; return null; }
            const ch = client.channel('trial-reels', { config: { broadcast: { self: false, ack: false } } })
                .on('broadcast', { event: 'changed' }, msg => {
                    const h = String((msg && msg.payload && msg.payload.h) || '');
                    if (!/^[0-9a-f]{12}$/.test(h)) return;
                    if (!_isClientLink) _trlHeardHash(h).catch(() => {});
                    _trlHooks.forEach(fn => { try { fn(h); } catch (e) {} });
                });
            ch.subscribe();
            return ch;
        }).catch(() => { _trlChannel = null; return null; });
    }
    async function _trlHeardHash(h) {
        if (!/^[0-9a-f]{12}$/.test(h)) return;
        // From the cards on screen, each with its own client: a card id is unique only within a client, so another
        // client's card cached earlier under the same id is never the one read (Codex on PR 2412).
        for (const post of calState.posts || []) {
            const slug = _trlSlug(post.client || calState.client), e = slug && _trlCards[slug];
            if (e && e.cards && e.cards[post.id] && await _trlHash(post.id) === h) _trlHeardChange(slug, post.id);
        }
    }
    function _trlHeardChange(slug, pid) {
        // Several changes in a burst (Approve all) read the card once.
        const key = slug + '|' + pid;
        clearTimeout(_trlHeard[key]);
        _trlHeard[key] = setTimeout(() => {
            delete _trlHeard[key];
            const began = Date.now();
            svTrialCall({ action: 'read', client: slug, post_id: pid }).then(json => {
                const e = _trlCards[slug];
                // This page's own write in flight, or answered after the read began, keeps its newer answer.
                if (!e || (_trlPending[pid] || []).length || (_trlWroteAt[pid] || 0) > began) return;
                const was = JSON.stringify(e.cards[pid] || null);
                if (json && json.enabled) { const c = Object.assign({}, json); delete c.ok; delete c.video_deliverable_id; e.cards[pid] = c; } else delete e.cards[pid];
                if (JSON.stringify(e.cards[pid] || null) === was) return;
                _trlRepaintField(pid);
                _trlNotesChanged(pid);
            }).catch(() => {});
        }, 120);
    }
    /* Kasper's queue (330) starts the trial read of each of its clients the moment the queue arrives, before the review
       page's own code has loaded (owner, 2026-10-28: the "TRIAL 3 versions" tiles "appeared really late"). The review
       page (194) then reads from this same list (svTrialListShared), so a staff page asks once per client. */
    function svTrialPrime(clients) {
        if (_isClientLink) return;
        const slugs = [...new Set((clients || []).map(c => _trlSlug(c)).filter(slug => slug && svTrialReelsOn(slug)))];
        _trlLoadMany(slugs).catch(() => {});
    }
    /* Per-version routing (plan section 5): Kasper's queue reads its trial clients' versions before it is cut, so a card
       already with the client still reaches him while one of its versions waits for him. Resolves when every read has
       landed or failed (a failed read leaves the queue as the card's status says). */
    function svTrialPrimeWait(clients) {
        if (_isClientLink) return Promise.resolve();
        const slugs = [...new Set((clients || []).map(c => _trlSlug(c)).filter(slug => slug && svTrialReelsOn(slug)))];
        return _trlLoadMany(slugs).catch(() => undefined);
    }
    /* Does a version of this staff card wait for this reviewer (`smm` or `kasper`), by the function's own `place`? False
       when the card is not a trial card, its versions are not read yet, or a winner is picked. */
    function svTrialWaitsWith(post, stage) {
        if (!post || !post.id || !_trlStaffOn(post)) return false;
        const slug = _trlSlug(post.client || calState.client), e = slug && _trlCards[slug];
        const shape = e && e.cards && e.cards[post.id];
        if (!shape || !shape.enabled || !Array.isArray(shape.versions) || shape.versions.some(v => v.status === 'winner')) return false;
        return shape.versions.some(v => v.place === stage);
    }
    // The staff list of one client, shared with the review page: { at, cards } once read (a failed read has no cards).
    function svTrialListShared(slug, force) {
        return Promise.resolve(_trlLoad(slug, !!force)).then(e => {
            // Never read, and the last try was refused or lost: say so, so the review page keeps what it holds (631).
            if (!e.at && e.failedAt) { const err = new Error('The trial versions could not be read yet.'); err.transient = true; throw err; }
            return { at: e.at, cards: Object.assign({}, e.cards) };
        });
    }
    // Many clients' lists at once (Today): one list_many request, then each client's { at, cards } as above.
    function svTrialListSharedMany(slugs, force) {
        return _trlLoadMany(slugs, !!force).catch(() => undefined).then(() => {
            const out = {};
            (slugs || []).forEach(slug => { const e = _trlCards[slug]; if (e) out[slug] = { at: e.at, cards: Object.assign({}, e.cards) }; });
            return out;
        });
    }
    /* The card reads its versions again by itself (owner, 2026-10-28: "I approved one of them, but in the SMM's
       calendar I don't see that it's approved"). A client's answer on the review link writes only the versions, which
       send the Calendar no live change, so while a trial card is on screen the list is read every 30 s, and at once
       when the tab comes back after that long. Staff Calendar only; nothing for a client link or a hidden tab.
       _isClientLink is declared in a later part (260); on a slow load the first tick can come before that part has
       run, and a bare read threw a ReferenceError every 5 s until it did (OPEN_REPAIRS 604). */
    function _trlRefresh(minAge) {
        if (typeof _isClientLink === 'undefined' || _isClientLink || (typeof document !== 'undefined' && document.visibilityState === 'hidden')) return;
        if (!document.querySelector('#calView .cal-link-post.trl-main')) return;
        Object.keys(_trlCards).forEach(slug => {
            const e = _trlCards[slug];
            if (e.at && !e.promise && Date.now() - e.at >= minAge && Object.values(e.cards).some(c => c && c.enabled)) _trlLoad(slug, true);
        });
    }
    try {
        // Looked at every 5 s, read once the list is 30 s old: a read that landed late never doubles the wait.
        setInterval(() => _trlRefresh(TRL_LIST_TTL_MS), 5000);
        document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') _trlRefresh(2000); });
    } catch (e) {}
    function _trlShape(post) {
        const slug = _trlSlug(post.client || calState.client);
        const e = _trlCards[slug];
        if (!e || !e.at) { if (slug) _trlLoad(slug); return _trlView(null, post.id); }
        if (Date.now() - e.at > TRL_LIST_TTL_MS) _trlLoad(slug);
        return _trlView(e.cards[post.id] || null, post.id);
    }
    // The last answer with the changes in flight laid over it (each change is written to be applied twice safely).
    function _trlView(base, pid) {
        const ops = _trlPending[pid];
        if (!ops || !ops.length) return _trlPostedView(base, pid);
        let s = base ? JSON.parse(JSON.stringify(base)) : null;
        for (const op of ops) s = op.apply(s) || s;
        return _trlPostedView(s, pid);
    }
    /* POSTED STARTS THE TRIAL, SHOWN AT ONCE (Sidney, 2026-10-31, Nightreel's Q4: "On trial" took about 7 s). The function
       starts the trial when it reads the card as Posted (logic.mjs autoTrialPatches), so the first read, made as the row is
       drawn, usually comes before the Posted save has landed and finds nothing to start. From the click, the row shows the
       start the function will make (every approved version on trial, 24 h), and the card is read again until the function
       says the trial started (or the card is no longer Posted). Not stored: it is only how the row reads meanwhile, and it
       goes away by itself if the Posted save is refused (the card's status goes back) or the reads stop. One version left
       in play is left to the function (it may make that one the winner at once). */
    const TRL_POSTED_READS_MS = [600, 1200, 2000, 3000, 4500, 6500, 9000, 13000, 18000];
    const _trlPostedShow = {};   // pid -> until (ms)
    const _trlStarted = s => ((s && s.versions) || []).some(v => ['on trial', 'winner', 'lost'].includes(v.status));
    function _trlPostedView(s, pid) {
        const until = _trlPostedShow[pid];
        if (!s || !until) return s;
        const post = _trlPost(pid);
        if (Date.now() > until || !post || post.video_status !== 'Posted' || _trlStarted(s)) return s;
        const vs = s.versions || [];
        const inPlay = vs.filter(v => v.status !== 'dropped' && !v.client_pass_at);
        const ready = inPlay.filter(v => v.status === 'approved');
        if (!ready.length || inPlay.length < 2) return s;
        const ends = new Date(Date.now() + 24 * 3600000).toISOString();
        const out = JSON.parse(JSON.stringify(s));
        for (const x of out.versions) if (x.status === 'approved' && !x.client_pass_at) Object.assign(x, { status: 'on trial', trial_ends_at: ends });
        out.trial_ends_at = out.trial_ends_at || ends;
        return out;
    }
    function _trlPostedFollow(post) {
        const pid = post.id;
        _trlPostedShow[pid] = Date.now() + TRL_POSTED_READS_MS[TRL_POSTED_READS_MS.length - 1] + 4000;
        let i = 0;
        const done = () => { delete _trlPostedShow[pid]; _trlRepaintField(pid); };
        const next = () => {
            if (i >= TRL_POSTED_READS_MS.length) { done(); return; }
            const wait = TRL_POSTED_READS_MS[i] - (i ? TRL_POSTED_READS_MS[i - 1] : 0);
            i++;
            setTimeout(() => {
                const cur = _trlPost(pid);
                if (!cur || cur.video_status !== 'Posted') { done(); return; }
                _trlFresh(cur).then(j => { if (j && _trlStarted(j)) done(); else next(); }).catch(next);
            }, wait);
        };
        _trlFresh(post).then(j => { if (j && _trlStarted(j)) done(); else { _trlRepaintField(pid); next(); } }).catch(next);
    }
    /* Show `apply` now, run `task` after the card's earlier writes, and drop the change when it settles: kept by the
       answer the task stored, or gone with the refusal (the task says it in words). Answers the task's result. */
    /* A trial write still on its way: leaving the page asks first (Trialeyes E7, 2026-10-29: a reload 80 ms after
       Enter lost a new version silently). */
    window.addEventListener('beforeunload', e => {
        if (!Object.keys(_trlPending).some(pid => (_trlPending[pid] || []).length)) return;
        e.preventDefault();
        e.returnValue = '';
    });
    function _trlOptimistic(pid, apply, task) {
        const op = { apply };
        (_trlPending[pid] || (_trlPending[pid] = [])).push(op);
        _trlRepaintField(pid);
        const run = () => Promise.resolve().then(task).catch(() => null).then(res => {
            const ops = _trlPending[pid] || [];
            const i = ops.indexOf(op);
            if (i >= 0) ops.splice(i, 1);
            _trlWroteAt[pid] = Date.now();
            _trlRepaintField(pid);
            return res;
        });
        const next = (_trlQueue[pid] || Promise.resolve()).then(run, run);
        _trlQueue[pid] = next;
        return next;
    }
    const _trlFind = (s, letter) => ((s && s.versions) || []).find(x => x.letter === letter) || null;
    /* What the function would refuse about a link in any case, said before anything moves (no flash of a link that then
       goes away). The same hosts as logic.mjs cleanLink (LINK_HOSTS). */
    const TRL_LINK_HOSTS = ['frame.io', 'app.frame.io', 'next.frame.io', 'f.io', 'drive.google.com', 'dropbox.com', 'www.dropbox.com'];
    function _trlLinkError(link) {
        if (!link) return '';
        if (link.length > 2048 || !/^https:\/\/[^\s<>"']+$/i.test(link)) return 'link_not_https';
        let u;
        try { u = new URL(link); } catch (e) { return 'link_not_https'; }
        if (u.username || u.password || !TRL_LINK_HOSTS.includes(u.hostname.toLowerCase().replace(/\.$/, '')) || u.pathname === '/') return 'link_host_unsupported';
        return '';
    }
    function _trlRepaintField(pid) {
        const post = (calState.posts || []).find(p => p.id === pid);
        const field = document.querySelector('.cal-link-field[data-pid-wrap="' + pid + '"][data-fld-wrap="asset_url"]');
        if (!post || !field || field.classList.contains('editing')) return;
        const list = field.nextElementSibling;
        // A link being typed in this list is never wiped by an answer landing for an earlier change: the repaint
        // waits for its save (which repaints).
        const typing = document.activeElement;
        if (list && list.classList.contains('trl-list') && typing && (typing.classList.contains('trl-link-input') || typing.classList.contains('trl-f-input')) && list.contains(typing)) { _trlDirty.add(pid); return; }
        _trlDirty.delete(pid);
        if (list && list.classList.contains('trl-list')) list.remove();
        const input = field.querySelector('.cal-link-input');
        field.outerHTML = _calLinkFieldHtml(pid, 'asset_url', post.asset_url, input ? input.placeholder : 'Video URL (Frame.io / Drive)', false, false, post);
    }
    function _trlRepaintAll(slug) {
        (calState.posts || []).forEach(p => { if (_trlSlug(p.client || calState.client) === slug) _trlRepaintField(p.id); });
    }

    // ---- what the row says -------------------------------------------------------------------------------------
    const TRL_LIVE = v => v.status !== 'dropped';
    function _trlTrialUp(shape) {
        return !!shape.trial_ends_at && Date.parse(shape.trial_ends_at) <= Date.now()
            && shape.versions.some(v => v.status === 'on trial');
    }
    function _trlTiny(shape) {
        const vs = shape.versions || [];
        if (vs.some(v => v.status === 'winner')) return { text: '' };
        if (vs.some(v => v.status === 'on trial')) {
            if (_trlTrialUp(shape)) return { trophy: true };
            const ms = Math.max(0, Date.parse(shape.trial_ends_at || '') - Date.now());
            const hrs = Math.max(1, Math.ceil(ms / 3600000)) + ' h left';
            return { text: 'On trial · ' + hrs, html: '<span class="trl-state-w">On trial · </span>' + hrs, words: 'On trial, ' + hrs };
        }
        // A version the client passed on is not waiting for anyone's OK: the team drops it (owner, 2026-10-28).
        const live = vs.filter(v => TRL_LIVE(v) && !v.client_pass_at);
        // A version the client said "Not this one" to is the team's to drop: the collapsed row says so (Trialeyes E9).
        const passed = vs.filter(v => TRL_LIVE(v) && v.client_pass_at).length;
        // On a narrow row (the card is about 190 px wide at every screen size) it steps back to "0/2 · 1 dropped", on one
        // line: the long form wrapped to three lines at 390 (Trialtest, live on PR 2452). The link's tooltip and
        // accessible name keep the whole phrase.
        const drop = passed ? ' · ' + passed + '<span class="trl-drop-w"> dropped by the client</span><span class="trl-drop-n"> dropped</span>' : '';
        const dropWords = passed ? ', ' + passed + ' dropped by the client' : '';
        if (!live.length) return passed ? { text: passed + ' dropped by the client', html: drop.slice(3), words: passed + ' dropped by the client' } : { text: '' };
        const n = live.filter(v => v.status === 'approved').length;
        return { text: n + '/' + live.length + ' approved' + (passed ? ' · ' + passed + ' dropped by the client' : ''), html: n + '/' + live.length + '<span class="trl-state-w"> approved</span>' + drop, words: n + ' of ' + live.length + ' approved' + dropWords };
    }
    /* No visual noise: a label shows only where it says something the row does not. One every live version shares is
       dropped (the collapsed row already says it), "lost" once there is a winner; "dropped", "winner" and "change
       asked" always stay. */
    function svTrialLabelShown(vs, v) {
        // Every version says where it stands (owner, 2026-10-28: "approved" on A and B, not blank); only "lost" stays
        // unsaid once there is a winner.
        return v.status !== 'lost';
    }
    /* Who said what, per stage, for a version's hover: "SMM: approved · Kasper: waiting · Client: approved". */
    function _trlStagesTitle(v) {
        const said = (ok, stage) => ok ? 'approved' : v.change_by === stage && v.status === 'change asked' ? 'change asked' : 'waiting';
        const client = v.client_pass_at ? 'dropped' : ['approved', 'on trial', 'winner', 'lost'].includes(v.status) || v.client_ok_at ? 'approved' : said(false, 'client');
        return 'SMM: ' + said(!!v.smm_ok_at, 'smm') + ' · Kasper: ' + said(!!v.kasper_ok_at, 'kasper') + ' · Client: ' + client;
    }

    /* A version's label: a pill, except "dropped", which is plain muted text (owner, 2026-10-27: still said, never a
       pill). sv-dropped-note is the one shared class; the card, Production and the review pages all use it. */
    function svTrialLabelHtml(status, v) {
        let s = String(status || '');
        // A waiting version that has passed a stage says where it is now (Trialeyes, 2026-10-29: an SMM-approved
        // version read "waiting" in the same grey as one nobody had seen), in the card status colours of that stage.
        // Per-version routing (Sidney, 2026-10-29): every version says whose it is, by the function's `place` ("with SMM",
        // "with Kasper", "with client"); a read without it goes by the stamps as before. A version with no link yet stays
        // "waiting": nobody has anything to look at.
        if (v && s === 'waiting' && !v.client_pass_at && v.frame_url) {
            const at = v.place || (v.kasper_ok_at ? 'client' : v.smm_ok_at ? 'kasper' : 'smm');
            s = at === 'client' ? 'with client' : at === 'kasper' ? 'with Kasper' : at === 'smm' ? 'with SMM' : s;
        }
        if (s === 'dropped') return '<span class="sv-dropped-note" data-l="dropped">dropped</span>';
        // The client said "Not this one" (owner, 2026-10-28): the team sees it and drops the version.
        if (v && v.client_pass_at && s === 'waiting') return '<span class="trl-lab" data-l="client dropped" title="' + _calEscAttr('The client dropped this version: take it off the card. ' + _trlStagesTitle(v)) + '">Client dropped</span>';
        return '<span class="trl-lab" data-l="' + _calEscAttr(s) + '"' + (v ? ' title="' + _calEscAttr(_trlStagesTitle(v)) + '"' : '') + '>' + _calEsc(s) + '</span>';
    }

    /* The switch alone, for a card whose switch is off (today's row plus this), with a small muted "Trial reels" word so
       it says what it is without a hover (Trialeyes E5, Supervisor's call, 2026-10-29: phones have no hover). '' when the page
       switch does not list the client, on a client link, or before the switch read is in. */
    function svTrialSwitchHtml(pid, post) {
        if (!_trlStaffOn(post)) return '';
        const shape = _trlShape(post);
        if (shape && shape.enabled) return '';
        const p = _calEscAttr(pid);
        return '<button type="button" class="trl-sw-slot" role="switch" aria-checked="false" title="Trial reels: off. Turn on to post this video as several versions"'
            + ' aria-label="Trial reels" onclick="svTrialToggle(\'' + p + '\',true)"><span class="trl-sw-word" aria-hidden="true">Trial reels</span><i class="trl-sw"></i></button>';
    }
    /* The whole Video row for a card whose switch is on; null otherwise (the caller draws today's row). */
    function svTrialVideoRowHtml(pid, v, post, parts) {
        if (!_trlStaffOn(post)) return null;
        const shape = _trlShape(post);
        if (!shape || !shape.enabled) return null;
        const vs = shape.versions || [];
        const winner = vs.find(x => x.status === 'winner');
        /* The card has just been set to Posted and its approved versions have not started yet: read this one card again
           now, so "On trial" (or the one version's win) shows at once, not on the next 30 s list (Trialeyes E15). */
        if (post.video_status === 'Posted' && vs.some(x => x.status === 'approved') && !vs.some(x => ['on trial', 'winner', 'lost'].includes(x.status))) {
            const k = pid + '|' + String(post.video_status_at || post.updated_at || '');
            if (!_trlPostedAsked.has(k)) { _trlPostedAsked.add(k); setTimeout(() => _trlPostedFollow(post), 0); }
        }
        // With no version yet, the list stands open: its only row is where the first link is pasted.
        const open = _trlOpen.has(pid) || !vs.length;
        const tiny = _trlTiny(shape);
        // No live version: "Video", never "Video · 0" (Trialeyes E5); the count leaves out dropped versions, as
        // "1/1 approved" beside it does (Trialeyes E8, 2026-10-29).
        const live = vs.filter(TRL_LIVE).length;
        const main = winner ? 'Video ' + winner.letter : live ? 'Video · ' + live : 'Video';
        // The open-link icon only when there is a link to open.
        const ext = String(post.asset_url || '').trim() ? parts.extIco : '';
        const p = _calEscAttr(pid);
        // The row's parts are sibling buttons, styled as one row: the link (opens the video on the card), the state's
        // trophy once the 24 h are up, a quiet filler, the switch, the arrow and today's pencil.
        const busy = (_trlPending[pid] || []).length ? ' aria-busy="true"' : '';
        const row = '<div class="cal-link-field has-link cal-link-post trl-main' + (open ? ' trl-open' : '') + '" data-pid-wrap="' + p + '" data-fld-wrap="asset_url"' + busy + '>'
            + '<button type="button" class="cal-link-pill-open" onclick="_calOpenLink(\'' + p + '\',\'asset_url\')" title="' + _calEscAttr((ext ? 'Open the video' : 'No video link yet') + (tiny.words ? '. ' + tiny.words : '')) + '"'
            + (tiny.words ? ' aria-label="' + _calEscAttr(main + '. ' + tiny.words + '. ' + (ext ? 'Open the video' : 'No video link yet')) + '"' : '') + '>' + ext
            + '<span class="cal-link-label"><span class="trl-main-label">' + _calEsc(main) + '</span>'
            + (tiny.html ? '<span class="trl-state' + (/dropped by the client/.test(tiny.text || '') ? ' trl-state-drop' : '') + '">' + tiny.html + '</span>' : '') + '</span></button>'
            + (tiny.trophy ? '<button type="button" class="trl-state-ico" aria-label="Trial over: pick the winner" title="Trial over: pick the winner" onclick="svTrialOpen(\'' + p + '\',true)">' + TRL_TROPHY + '</button>' : '')
            + '<span class="trl-fill" aria-hidden="true"></span>'
            + '<button type="button" class="trl-sw-slot on" role="switch" aria-checked="true" aria-label="Trial reels" title="Trial reels: on" onclick="svTrialToggle(\'' + p + '\',false)"><i class="trl-sw"></i></button>'
            + '<button type="button" class="trl-chev" aria-expanded="' + open + '" aria-label="' + (open ? 'Hide the versions' : 'Show the versions') + '" title="' + (open ? 'Hide the versions' : 'Show the versions') + '" onclick="svTrialOpen(\'' + p + '\')">' + TRL_CHEV + '</button>'
            + '<button type="button" class="cal-link-edit" tabindex="-1" onclick="_calEditLink(\'' + p + '\',\'asset_url\')" title="Edit the link on the card">' + parts.pencil + '</button>'
            + parts.input + '</div>';
        return open ? row + _trlListHtml(pid, shape) : row;
    }
    function _trlListHtml(pid, shape) {
        const vs = shape.versions || [];
        if (vs.some(v => v.frame_url) && !_isClientLink) setTimeout(() => _trlCheckLinks(pid), 0);
        const p = _calEscAttr(pid);
        const up = _trlTrialUp(shape);
        const rows = vs.map(v => {
            const l = _calEscAttr(v.letter);
            if (_trlEditing[pid] === v.letter) {
                const dr = _trlDraft[pid] && _trlDraft[pid].letter === v.letter ? _trlDraft[pid] : null;
                return '<div class="trl-v trl-editing"><span class="trl-l">Video ' + _calEsc(v.letter) + '</span>'
                    + '<input class="trl-link-input" type="url" placeholder="Paste the Frame.io link" value="' + _calEscAttr(dr ? dr.text : v.frame_url || '') + '" data-pid="' + p + '" data-letter="' + l + '"'
                    + (dr ? ' aria-invalid="true" aria-describedby="trl-err-' + p + '"' : '')
                    + ' onkeydown="svTrialLinkKey(event,this)" onblur="svTrialLinkSave(this)" aria-label="Frame.io link for Video ' + l + '"></div>' + _trlErrHtml(pid, dr);
            }
            const link = v.frame_url ? '<a class="trl-go" href="' + _calEscAttr(v.frame_url) + '" target="_blank" rel="noopener noreferrer" title="Open Video ' + l + '">' + TRL_GO + '</a>' : '';
            // The name opens the version too, not only the small icon (owner, 2026-10-27). A version dropped before its
            // link was pasted asks for no link (Trialtest, 2026-10-28).
            const name = v.frame_url ? '<a class="trl-l trl-name" href="' + _calEscAttr(v.frame_url) + '" target="_blank" rel="noopener noreferrer" title="Open Video ' + l + '">Video ' + _calEsc(v.letter) + '</a>'
                : '<span class="trl-l">Video ' + _calEsc(v.letter) + '</span>' + (v.status === 'dropped' ? '' : '<button type="button" class="trl-paste" onclick="svTrialEdit(\'' + p + '\',\'' + l + '\')">Paste the Frame.io link</button>');
            // A version the server has not taken yet says so, not "waiting" (Trialeyes E7, 2026-10-29).
            const label = v._saving ? '<span class="trl-lab" data-l="saving" role="status">saving…</span>'
                : _trlLinkBadHtml(pid, v) || (_trlStatusPickOn(_trlPost(pid), v) ? _trlStatusPickHtml(pid, v)
                    : svTrialLabelShown(vs, v) ? svTrialLabelHtml(v.status, v) : '<span class="trl-lab-gap"></span>');
            const decided = ['on trial', 'winner', 'lost'].includes(v.status);
            const tools = '<span class="trl-tools">'
                + (v.frame_url ? '<button type="button" class="trl-ico" title="Change the link" aria-label="Change the link of Video ' + l + '" onclick="svTrialEdit(\'' + p + '\',\'' + l + '\')">' + TRL_PENCIL + '</button>' : '')
                // Default (b): the new cut sits at the same Frame.io link, so it is said, not pasted (hover only).
                + (v.status === 'change asked' && v.frame_url ? '<button type="button" class="trl-ico" title="New cut ready" aria-label="New cut of Video ' + l + ' ready" onclick="svTrialNewCut(\'' + p + '\',\'' + l + '\')">' + TRL_NEWCUT + '</button>' : '')
                + (!decided && (!v.on_card || _trlNextLive(vs, v.letter)) ? (v.status === 'dropped'
                    ? '<button type="button" class="trl-ico" title="Bring back" aria-label="Bring back Video ' + l + '" onclick="svTrialDrop(\'' + p + '\',\'' + l + '\',true)">' + TRL_BACK + '</button>'
                    : '<button type="button" class="trl-ico" title="Drop this version" aria-label="Drop Video ' + l + '" onclick="svTrialDrop(\'' + p + '\',\'' + l + '\',false)">' + TRL_DROP + '</button>') : '')
                + '</span>';
            const pick = up && v.status === 'on trial'
                ? '<button type="button" class="trl-pick" title="Make this the winner" aria-label="Make this the winner" onclick="svTrialPick(\'' + p + '\',\'' + l + '\')">' + TRL_TROPHY + '</button>' : '';
            return '<div class="trl-v' + (v.status === 'dropped' ? ' trl-dropped' : '') + '">' + link + name + tools + label + pick + '</div>'
                + (v.status === 'dropped' ? '' : _trlFieldsHtml(pid, v) + _trlElsewhereHtml(pid, v.frame_url));
        }).join('');
        // The 24 h start by themselves once the card is Posted (owner, 2026-10-28): no "Start the 24 h" link here.
        return '<div class="trl-list">' + rows + _trlAddHtml(pid, vs) + '</div>';
    }
    /* The next free letter (A to G), to add a version by pasting its link. Until 2026-10-27 a card listed only the
       versions the AI editor had logged, so a card it had not logged had nowhere to paste a link. Gone once the trial
       starts. */
    /* A version's link that another card of this client also carries (its Video link, or one of its versions): kept, as
       the team may mean it, and said under the row in a quiet line (Trialeyes E17, 2026-10-29). Only cards this page has
       loaded are looked at. */
    function _trlElsewhereHtml(pid, link) {
        link = String(link || '');
        if (!link) return '';
        const here = (calState.posts || []).find(p => p.id === pid);
        const slug = here && _trlSlug(here.client || calState.client);
        const cached = (slug && _trlCards[slug] && _trlCards[slug].cards) || {};
        const other = (calState.posts || []).find(p => p.id !== pid && (!here || p.client === here.client)
            && (String(p.asset_url || '') === link || ((cached[p.id] && cached[p.id].versions) || []).some(x => x.status !== 'dropped' && String(x.frame_url || '') === link)));
        if (!other) return '';
        const name = String(other.name || '').trim() || 'another card';
        return '<div class="trl-link-note">This link is also on \u201c' + _calEsc(name) + '\u201d.</div>';
    }
    // Why the page did not take a link, under its field (never a dialog, and the text stays to fix).
    function _trlErrHtml(pid, dr) {
        return dr ? '<div class="trl-link-err" id="trl-err-' + _calEscAttr(pid) + '" role="alert">' + _calEsc(dr.err) + '</div>' : '';
    }
    function _trlAddHtml(pid, vs) {
        if (vs.some(v => ['on trial', 'winner', 'lost'].includes(v.status))) return '';
        const used = new Set(vs.map(v => v.letter));
        const next = ['A', 'B', 'C', 'D', 'E', 'F', 'G'].find(l => !used.has(l));
        const p = _calEscAttr(pid);
        // V2 (switch trial_versions_v2): "Import from Frame" beside it, once the card has its first version. It stays when
        // all seven letters are taken: an import can still give existing versions their new cuts (Codex on #2545).
        const impBtn = _trlImportOn(_trlPost(pid), vs) ? '<button type="button" class="trl-paste trl-addbtn" onclick="svTrialImportOpen(\'' + p + '\')">Import from Frame</button>' : '';
        if (!next) return impBtn ? '<div class="trl-v trl-add">' + impBtn + '</div>' : '';
        if (_trlEditing[pid] === '+') {
            const dr = _trlDraft[pid] && _trlDraft[pid].letter === '+' ? _trlDraft[pid] : null;
            return '<div class="trl-v trl-editing trl-add"><span class="trl-l">Video ' + next + '</span>'
                + '<input class="trl-link-input" type="url" placeholder="Paste the Frame.io link" value="' + _calEscAttr(dr ? dr.text : '') + '" data-pid="' + p + '" data-letter="+"'
                + (dr ? ' aria-invalid="true" aria-describedby="trl-err-' + p + '"' : '')
                + ' onkeydown="svTrialLinkKey(event,this)" onblur="svTrialLinkSave(this)" aria-label="Frame.io link for Video ' + next + '"></div>' + _trlErrHtml(pid, dr);
        }
        // A minimal "+ Add version" that opens the paste field (owner, 2026-10-28: no "Video E  Paste the Frame.io link").
        // No hover tip: the button says what it does, and the tip covered the row above (Trialeyes E6, 2026-10-29).
        const imp = impBtn ? '<span class="trl-add-sep" aria-hidden="true">·</span>' + impBtn : '';
        return '<div class="trl-v trl-add"><button type="button" class="trl-paste trl-addbtn" aria-label="Add Video ' + next + ' by pasting its link" onclick="svTrialEdit(\'' + p + '\',\'+\')">+ Add version</button>' + imp + '</div>';
    }

    // ---- actions -----------------------------------------------------------------------------------------------
    function _trlPost(pid) { return (calState.posts || []).find(p => p.id === pid) || null; }
    async function _trlRun(pid, key, body, what) {
        const post = _trlPost(pid);
        if (!post || _trlBusy.has(pid + '|' + key)) return null;
        const slug = _trlSlug(post.client || calState.client);
        _trlBusy.add(pid + '|' + key);
        try {
            const json = await svTrialCall(Object.assign({ client: slug, post_id: pid }, body));
            const e = _trlCards[slug] || (_trlCards[slug] = { at: Date.now(), cards: {}, promise: null });
            if (json.versions) e.cards[pid] = Object.assign({}, e.cards[pid] || {}, { enabled: true, winner_letter: json.winner_letter || null }, json);
            if (key === 'link') _trlCheckLinks(pid, true);
            return json;
        } catch (e) {
            // This one card read again now (a list read would keep the change still in flight over it).
            if (e && e.code === 'conflict') await _trlFresh(post);
            _trlSay(e, what);
            return null;
        } finally {
            _trlBusy.delete(pid + '|' + key);
            _trlRepaintField(pid);
        }
    }
    /* On: the row and its versions list show at once, the list open by itself so the paste row for the next version is
       right there (owner, 2026-10-27), seeded as the function seeds it (Video A is the card's link); then the one card
       is read, not the whole client's list. Off: today's row at once. A refusal puts the row back and says so. */
    function svTrialToggle(pid, on, sure) {
        const post = _trlPost(pid);
        if (!post) return Promise.resolve(null);
        /* One click on the switch with versions on the card asks first (Trialeyes E19, 2026-10-29: three approved
           versions vanished at a stray click). The versions are kept and come back if it is turned on again. */
        const had = !on && !sure && ((_trlShape(post) || {}).versions || []).filter(TRL_LIVE).length;
        if (had) {
            return new Promise(res => showConfirm('Turn off trial reels?', 'The ' + had + (had === 1 ? ' version is' : ' versions are') + ' kept and come back if you turn it on again.',
                () => res(svTrialToggle(pid, false, true)), 'Turn off'));
        }
        const slug = _trlSlug(post.client || calState.client);
        const seed = String(post.asset_url || '').trim();
        const wasOpen = _trlOpen.has(pid);
        if (on) _trlOpen.add(pid); else _trlOpen.delete(pid);
        return _trlOptimistic(pid, s => {
            if (!on) return Object.assign(s || { versions: [] }, { enabled: false });
            if (s && s.enabled) return s;
            return { enabled: true, winner_letter: null, versions: seed && !_trlLinkError(seed) ? [{ letter: 'A', status: 'waiting', frame_url: seed, on_card: true }] : [] };
        }, async () => {
            const json = await _trlRun(pid, 'switch', { action: 'switch_set', enabled: !!on }, 'Trial reels');
            if (!json) { if (wasOpen) _trlOpen.add(pid); else _trlOpen.delete(pid); return null; }
            const e = _trlCards[slug] || (_trlCards[slug] = { at: Date.now(), cards: {}, promise: null });
            if (!on) { delete e.cards[pid]; return json; }
            if (!(await _trlFresh(post))) await _trlLoad(slug, true);
            return json;
        });
    }
    function svTrialOpen(pid, force) {
        if (force || !_trlOpen.has(pid)) _trlOpen.add(pid); else _trlOpen.delete(pid);
        _trlRepaintField(pid);
    }
    function svTrialEdit(pid, letter) {
        _trlEditing[pid] = letter;
        _trlRepaintField(pid);
        const input = document.querySelector('.trl-link-input[data-pid="' + pid + '"]');
        if (input) { input.focus(); input.select(); }
    }
    function svTrialLinkKey(ev, input) {
        if (ev.key === 'Enter') { ev.preventDefault(); input.dataset.enter = '1'; input.blur(); }
        if (ev.key === 'Escape') { ev.preventDefault(); input.dataset.cancel = '1'; input.blur(); }
    }
    /* A link the page refuses before anything is sent: it stays in its field with the reason under it. Enter keeps the
       focus there to fix it; a click away leaves the field open with the text until Escape or a good link. */
    function _trlRefuse(input, pid, letter, link, code) {
        _trlDraft[pid] = { letter, text: link, err: TRL_ERRORS[code] || svTrialErrorText({ code }) };
        _trlEditing[pid] = letter;
        _trlRepaintField(pid);
        if (input.dataset.enter === '1') {
            const again = document.querySelector('.trl-link-input[data-pid="' + pid + '"]');
            if (again) { again.focus(); again.setSelectionRange(again.value.length, again.value.length); }
        }
    }
    /* The card's one link, through today's paths only. With a video sub-issue: Production's attach (it writes file_url
       and the database projects it onto the card's asset_url). Without one: today's card link save. Answers the
       sub-issue's clock after the attach ('' without a sub-issue). `since` (a clock this page's own attach answered)
       makes it a compare-and-swap: the attach lands only if nobody moved the sub-issue since, else write_conflict. */
    async function _trlSetCardLink(post, link, since) {
        const deliverableId = String(post.video_deliverable_id || '').trim();
        if (!deliverableId) {
            if (!_calPendingEdits[post.id]) _calPendingEdits[post.id] = {};
            _calPendingEdits[post.id].asset_url = link;
            post.asset_url = link;
            await _calFlushCardSave(post.id);
            return '';
        }
        const read = await fetch(CAL_SUPABASE_URL + '/rest/v1/production_deliverables_browser_v1?select=id,client_slug,updated_at&id=eq.' + encodeURIComponent(deliverableId), {
            cache: 'no-store', headers: { apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json' },
        });
        const rows = read.ok ? await read.json().catch(() => []) : [];
        const row = Array.isArray(rows) ? rows[0] : null;
        if (!row || !row.updated_at) {
            const err = Object.assign(new Error('The video sub-issue could not be read'), { code: 'write_failed' });
            _writeUiRecordFailure('calendar', 'trial_reels_card_link', err, { http_status: read.status });
            throw err;
        }
        let requestId = '';
        try { requestId = 'trial:attachment:' + crypto.randomUUID(); } catch (e) { requestId = 'trial:attachment:' + Date.now().toString(36) + Math.random().toString(36).slice(2); }
        const resp = await fetch(TRL_PROD_WRITE_URL, {
            method: 'POST', cache: 'no-store',
            headers: _syncviewEfHeaders({ apikey: CAL_SUPABASE_ANON_KEY, Authorization: 'Bearer ' + CAL_SUPABASE_ANON_KEY, Accept: 'application/json', 'Content-Type': 'application/json' }, TRL_PROD_WRITE_URL),
            body: JSON.stringify({ operation: 'attachment', surface: 'production', entity: 'deliverable', id: deliverableId,
                client_slug: row.client_slug, request_id: requestId, source_edited_at: new Date().toISOString(),
                file_url: link, expected_updated_at: since || row.updated_at }),
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok || !json || json.ok !== true || json.native_committed !== true) {
            const code = String((json && json.error && (json.error.code || json.error)) || ('http_' + resp.status));
            const err = Object.assign(new Error(code), { code, row: (json && json.row) || null });
            _writeUiRecordFailure('calendar', 'trial_reels_card_link', err, { http_status: resp.status });
            throw err;
        }
        post.asset_url = link;
        return String((json.row && json.row.updated_at) || '');
    }
    /* One card's versions read now, never the 30-second list (two staff pages can each hold an old one). Kept in the
       list for the repaint. null when the read fails. */
    async function _trlFresh(post) {
        const slug = _trlSlug(post.client || calState.client);
        try {
            const json = await svTrialCall({ action: 'read', client: slug, post_id: post.id });
            const e = _trlCards[slug] || (_trlCards[slug] = { at: Date.now(), cards: {}, promise: null });
            if (json && json.versions) e.cards[post.id] = Object.assign({}, e.cards[post.id] || {}, { enabled: true, winner_letter: json.winner_letter || null }, json);
            return json && json.versions ? json : null;
        } catch (e) { return null; }
    }
    // The link the card should carry by the function's own record: the winner's own link once one is picked (main_url:
    // its row shows the card's link, which may be the refused one), else the first live version's (Video A unless dropped).
    function _trlMainLink(shape) {
        const vs = (shape && shape.versions) || [];
        const w = vs.find(x => x.letter === shape.winner_letter) || vs.find(x => x.status === 'winner');
        if (w) return String(shape.main_url || w.frame_url || '');
        const v = vs.find(x => x.status !== 'dropped');
        return String((v && v.frame_url) || '');
    }
    function svTrialLinkSave(input) {
        const pid = input.dataset.pid, letter = input.dataset.letter;
        const cancel = input.dataset.cancel === '1';
        // The field drawn again around a refused link: its old copy leaving the page is not a second try.
        if (!input.isConnected && _trlDraft[pid] && _trlDraft[pid].text === String(input.value || '').trim()) return;
        delete _trlEditing[pid];
        delete _trlDraft[pid];
        const post = _trlPost(pid);
        const shape = post && _trlShape(post);
        const v = shape && _trlFind(shape, letter);
        const link = String(input.value || '').trim();
        if (letter === '+') { if (cancel || !post || !shape || !link) { _trlRepaintField(pid); return; } return _trlAdd(post, shape, link, input); }
        if (cancel || !post || !v || link === String(v.frame_url || '')) { _trlRepaintField(pid); return; }
        // What the function would refuse anyway is said before anything moves (Probe bug 12): a link it does not take,
        // a link another version has, and a version already decided (on trial, winner, lost).
        const what = 'Video ' + letter + "'s link";
        const bad = _trlLinkError(link)
            || ((shape.versions || []).some(x => x.letter !== letter && String(x.frame_url || '') === link) ? 'link_used_by_another_version' : '')
            || (['on trial', 'winner', 'lost'].includes(v.status) ? 'version_on_trial' : '');
        if (bad === 'version_on_trial') { _trlSay({ code: bad }, what); _trlRepaintField(pid); return; }
        if (bad) return _trlRefuse(input, pid, letter, link, bad);
        const apply = s => { const x = _trlFind(s, letter); if (x) x.frame_url = link || null; return s; };
        const wasChanged = v.status === 'change asked';
        if (!v.on_card) return _trlOptimistic(pid, apply, async () => {
            const json = await _trlRun(pid, 'link', { action: 'version_link_set', letter, link }, what);
            if (json && wasChanged) _trlBackToReview(pid, json);
            return json;
        });
        // The version on the card: today's path first, then the copy (the function checks they agree).
        return _trlOptimistic(pid, apply, async () => {
            const before = String(post.asset_url || '');
            let mine = '';
            try { mine = await _trlSetCardLink(post, link); }
            catch (e) { _trlSay(e, what); return null; }
            const json = await _trlRun(pid, 'link', { action: 'version_link_set', letter, link }, what);
            if (!json) await _trlAttachBack(post, before, mine, link);
            else if (wasChanged) _trlBackToReview(pid, json);
            return json;
        });
    }
    /* A new version. The first live one is the version on the card, so the card's link moves to it first through
       today's path (as for Video A), and goes back if the function then refuses. */
    function _trlAdd(post, shape, link, input) {
        const pid = post.id, vs = shape.versions || [];
        const what = 'The new version';
        _trlOpen.add(pid);   // the list stays open on the next "Add" (with no version it was open only for being empty)
        const used = new Set(vs.map(v => v.letter));
        const letter = ['A', 'B', 'C', 'D', 'E', 'F', 'G'].find(l => !used.has(l));
        const bad = _trlLinkError(link) || (vs.some(x => String(x.frame_url || '') === link) ? 'link_used_by_another_version' : '') || (letter ? '' : 'no_letter_left');
        if (bad && input && bad !== 'no_letter_left') return _trlRefuse(input, pid, '+', link, bad);
        if (bad) { _trlSay({ code: bad }, what); _trlRepaintField(pid); return; }
        const first = !vs.some(x => x.status !== 'dropped');
        return _trlOptimistic(pid, s => {
            const out = s || { enabled: true, winner_letter: null, versions: [] };
            out.versions = out.versions || [];
            if (!out.versions.some(x => x.frame_url === link)) out.versions.push({ letter, status: 'waiting', frame_url: link, on_card: first, _saving: true });
            return out;
        }, async () => {
            const before = String(post.asset_url || '');
            const move = first && link !== before;
            let mine = '';
            if (move) {
                try { mine = await _trlSetCardLink(post, link); }
                catch (e) { _trlSay(e, what); return null; }
            }
            const json = await _trlRun(pid, 'link', { action: 'version_add', link }, what);
            if (!json && move) await _trlAttachBack(post, before, mine, link);
            return json;
        });
    }
    // Today's attach of one link onto a card, for the review page's tiles (194): the version on the card is dropped there too.
    async function svTrialMoveCard(post, link) { return _trlSetCardLink(post, link); }
    /* The card's link moves only once the function says yes (Probe bugs 12 and 12b). After a refusal, the link this page
       attached goes back to what the card carried before, as a compare-and-swap on this page's own attach (a link
       someone else attached since stands), and the versions are read again, so the page shows the function's state. */
    async function _trlAttachBack(post, before, mine, now) {
        if (before && before !== now) {
            try { await _trlSetCardLink(post, before, mine); }
            catch (e) {
                if (String(e && e.code) === 'write_conflict') showNotify("Someone else just changed the card's Video link", 'Theirs stands. Look again before you change it.');
                else showNotify("The card's Video link was not put back", 'It now opens another version. Set the Video link by hand, then try again.');
            }
        }
        await _trlFresh(post);
        _trlRepaintField(post.id);
    }
    // The same put-back for the review page's tiles (194).
    async function svTrialAttachBack(post, before, mine, now) { return _trlAttachBack(post, before, mine, now); }
    // The live version after this one that has a link: where "on the card" moves when the version on the card is dropped.
    function _trlNextLive(vs, letter) {
        return (vs || []).find(x => x.letter !== letter && x.status !== 'dropped' && x.frame_url) || null;
    }
    /* V1 (plan docs/plans/2026-11-trial-and-posting/combined.md, Sidney's D1; switch trial_versions_v2): a version's
       status is set with the card's own status picker: the card's list up to and including Approved (N/A, Scheduled
       and Posted stay card-only: Drop covers N/A, and Posted starts the trial for the whole post), the card's menu and
       colours, and the card's rule that a review status needs something to review. Admin and SMM keys only, the line
       the trial-reels function holds too (narrower than the card for creatives, by Sidney's ask). The function stores
       the word in the review's own columns and logs it as trial_status; the card's status is never written here. */
    const TRL_STATUS_WORDS = CAL_STATUSES.slice(0, CAL_STATUSES.indexOf('Approved') + 1).filter(s => s !== 'N/A');
    const TRL_STATUS_REVIEW = ['For SMM Approval', 'Kasper Approval', 'Client Approval', 'Approved'];
    function _trlStatusPickOn(post, v) {
        return !!v && !!v.card_status && !v._saving && _trlStaffOn(post) && svTrialVersionsV2On(post.client || calState.client)
            && _syncviewStaffCan('trial-version-status');
    }
    function _trlStatusPickHtml(pid, v) {
        const l = _calEscAttr(v.letter), p = _calEscAttr(pid), s = String(v.card_status), word = _calEscAttr(s);
        return '<button type="button" class="trl-lab trl-st" data-l="' + word + '" aria-haspopup="menu" title="' + _calEscAttr(_trlStagesTitle(v)) + '"'
            + ' aria-label="Video ' + l + ' status: ' + word + '" onclick="svTrialStatusMenu(event,\'' + p + '\',\'' + l + '\',this)">' + _calEsc(s) + '</button>';
    }
    function svTrialStatusMenu(event, pid, letter, btn) {
        if (event) { event.stopPropagation(); event.preventDefault(); }
        const key = pid + '|trial-' + letter;
        if (_calOpenStatusMenu && _calOpenStatusMenu.key === key) { _calCloseStatusMenu(); return; }
        _calCloseStatusMenu();
        const post = _trlPost(pid);
        const shape = post && _trlShape(post);
        const v = shape && _trlFind(shape, letter);
        if (!v || !btn || !_trlStatusPickOn(post, v)) return;
        const noLink = !v.frame_url;
        const p = _calEscAttr(pid), l = _calEscAttr(letter);
        const menu = document.createElement('div');
        menu.className = 'cal-fld-status-menu';
        menu.innerHTML = _calStatusMenuTitleHtml('Video ' + letter + ' status') + TRL_STATUS_WORDS.map(s => {
            const blocked = noLink && TRL_STATUS_REVIEW.includes(s);
            const word = _calEscAttr(s);
            return '<button type="button" class="cal-fld-status-item cal-fld-status-' + _calStatusSlug(s) + (s === v.card_status ? ' active' : '') + '"'
                + (blocked ? ' disabled title="' + _calEscAttr(TRL_ERRORS.version_has_no_link) + '"' : '')
                + ' onclick="svTrialStatusPick(\'' + p + '\',\'' + l + '\',\'' + word + '\')">' + _calEsc(s) + '</button>';
        }).join('') + (noLink ? '<div class="cal-fld-status-note">' + _calEsc(TRL_ERRORS.version_has_no_link) + '</div>' : '');
        document.body.appendChild(menu);
        // Placed as the card's status menu is (170 _calStatusToggleMenu): under the pill, flipped up near the bottom.
        const rect = btn.getBoundingClientRect();
        const menuW = Math.max(menu.offsetWidth, 200), menuH = menu.offsetHeight, gap = 5;
        menu.style.left = Math.max(10, Math.min(rect.left, window.innerWidth - menuW - 10)) + 'px';
        const below = window.innerHeight - rect.bottom - 10, above = rect.top - 10;
        menu.style.top = (menuH <= below || below >= above
            ? Math.max(10, Math.min(rect.bottom + gap, window.innerHeight - menuH - 10))
            : Math.max(10, rect.top - menuH - gap)) + 'px';
        menu.style.minWidth = '200px';
        requestAnimationFrame(() => menu.classList.add('open'));
        _calSetOpenStatusMenu({ pid, key, comp: 'trial', el: menu, triggerEl: btn });
    }
    function svTrialStatusPick(pid, letter, status) {
        _calCloseStatusMenu();
        const post = _trlPost(pid);
        const shape = post && _trlShape(post);
        const v = shape && _trlFind(shape, letter);
        if (!v || !TRL_STATUS_WORDS.includes(status)) return;
        // In Progress and For SMM Approval are one state: a version with a link reads For SMM Approval.
        const want = status === 'In Progress' || status === 'For SMM Approval' ? (v.frame_url ? 'For SMM Approval' : 'In Progress') : status;
        if (want === v.card_status) return;
        const stored = status === 'Approved' ? 'approved' : status === 'Tweaks Needed' ? 'change asked' : 'waiting';
        return _trlOptimistic(pid, s => { const x = _trlFind(s, letter); if (x) Object.assign(x, { card_status: want, status: stored }); return s; },
            () => _trlRun(pid, 'status-' + letter, { action: 'version_status_set', letter, status }, 'Video ' + letter));
    }
    /* V3 (plan docs/plans/2026-11-trial-and-posting/combined.md row V3; switch trial_versions_v2): each version's own
       thumbnail and caption, under its row. Empty reads "Same as the card" (the function's rule: the version's own
       field, else the card's). The version on the card is the card: its two fields are the card's own, edited on the
       card. A version out on trial or decided shows them and cannot change them. An answered version that gets a new
       thumbnail or caption starts again through the SMM, as a new link does (the function decides and says so). */
    const _trlFieldEdit = {};   // pid -> { letter, k: 'thumbnail_url' | 'caption' } being typed
    function _trlFieldsOn(post) {
        return !!post && _trlStaffOn(post) && svTrialVersionsV2On(post.client || calState.client);
    }
    function _trlFieldsHtml(pid, v) {
        const post = _trlPost(pid);
        // A version that lost has nothing left to set or show: the card carries the winner's.
        if (!_trlFieldsOn(post) || v.status === 'lost') return '';
        if (v.on_card) return '<div class="trl-fields"><span class="trl-f-note">Thumbnail and caption: the card\'s own</span></div>';
        const p = _calEscAttr(pid), l = _calEscAttr(v.letter);
        const frozen = ['on trial', 'winner', 'lost'].includes(v.status);
        const ed = _trlFieldEdit[pid] && _trlFieldEdit[pid].letter === v.letter ? _trlFieldEdit[pid].k : '';
        const one = (k, word) => {
            const own = String(v[k] || '');
            if (ed === k) {
                const attrs = ' data-pid="' + p + '" data-letter="' + l + '" data-k="' + k + '" onkeydown="svTrialFieldKey(event,this)" onblur="svTrialFieldSave(this)"'
                    + ' aria-label="' + word + ' for Video ' + l + '"';
                return k === 'caption'
                    ? '<textarea class="trl-f-input trl-f-caption" rows="3" maxlength="4000" placeholder="Same as the card"' + attrs + '>' + _calEsc(own) + '</textarea>'
                    : '<input class="trl-f-input" type="url" placeholder="Same as the card: paste a thumbnail link" value="' + _calEscAttr(own) + '"' + attrs + '>';
            }
            const shown = own ? (k === 'caption' ? own.replace(/\s+/g, ' ').slice(0, 80) : 'own image') : 'Same as the card';
            // A Google Drive file page is shown as its image, the way the card shows its own thumbnail (V4 live walk, 3 Nov).
            const pic = k === 'thumbnail_url' && own ? ((() => { try { return _calDeriveThumb({ thumbnail_url: own }); } catch (e) { return ''; } })() || own) : '';
            const img = pic ? '<img class="trl-f-img" alt="" src="' + _calEscAttr(pic) + '" loading="lazy" onerror="this.hidden=true">' : '';
            const body = '<span class="trl-f-k">' + word + '</span>' + img + '<span class="trl-f-v' + (own ? '' : ' trl-f-same') + '">' + _calEsc(shown) + '</span>';
            return frozen ? '<span class="trl-f">' + body + '</span>'
                : '<button type="button" class="trl-f" title="' + _calEscAttr(own || ('Video ' + v.letter + ' uses the card\'s ' + word.toLowerCase())) + '"'
                    + ' onclick="svTrialFieldEdit(\'' + p + '\',\'' + l + '\',\'' + k + '\')">' + body + '</button>';
        };
        return '<div class="trl-fields">' + one('thumbnail_url', 'Thumbnail') + one('caption', 'Caption') + '</div>';
    }
    function svTrialFieldEdit(pid, letter, k) {
        _trlFieldEdit[pid] = { letter, k };
        _trlRepaintField(pid);
        const input = document.querySelector('.trl-f-input[data-pid="' + pid + '"]');
        if (input) { input.focus(); try { input.setSelectionRange(input.value.length, input.value.length); } catch (e) {} }
    }
    function svTrialFieldKey(ev, input) {
        // A caption takes new lines; Enter saves a thumbnail link, Cmd/Ctrl+Enter a caption, Escape leaves either as it was.
        if (ev.key === 'Enter' && (input.dataset.k !== 'caption' || ev.metaKey || ev.ctrlKey)) { ev.preventDefault(); input.blur(); }
        if (ev.key === 'Escape') { ev.preventDefault(); input.dataset.cancel = '1'; input.blur(); }
    }
    function svTrialFieldSave(input) {
        const pid = input.dataset.pid, letter = input.dataset.letter, k = input.dataset.k;
        if (!_trlFieldEdit[pid] || _trlFieldEdit[pid].letter !== letter || _trlFieldEdit[pid].k !== k) return;
        delete _trlFieldEdit[pid];
        const post = _trlPost(pid);
        const shape = post && _trlShape(post);
        const v = shape && _trlFind(shape, letter);
        const value = String(input.value || '').trim();
        if (input.dataset.cancel === '1' || !v || value === String(v[k] || '')) { _trlRepaintField(pid); return; }
        if (k === 'thumbnail_url' && value && !/^https:\/\/[^\s<>"']+$/i.test(value)) { _trlSay({ code: 'thumbnail_not_https' }, 'Video ' + letter + "'s thumbnail"); _trlRepaintField(pid); return; }
        const what = 'Video ' + letter + "'s " + (k === 'caption' ? 'caption' : 'thumbnail');
        return _trlOptimistic(pid, s => { const x = _trlFind(s, letter); if (x) x[k] = value || null; return s; }, async () => {
            const json = await _trlRun(pid, 'fields-' + letter, { action: 'version_fields_set', letter, [k]: value }, what);
            if (json && json.restarted) showToast('Video ' + letter + ' goes back to the SMM, then Kasper');
            return json;
        });
    }
    /* The winner's thumbnail and caption go on the card (its effective fields), through today's card save, as its video
       goes on through today's attach. Undo (the pick's toast, on this page only) puts back the card's own from before. */
    const _trlCardFieldsBefore = {};   // pid -> { before, wrote }: the card's fields before the pick, and what the pick wrote
    async function _trlSetCardFields(post, f) {
        const edits = {};
        for (const k of ['thumbnail_url', 'caption']) {
            const next = String((f && f[k]) || '');
            if (next !== String(post[k] || '')) edits[k] = next;
        }
        if (!Object.keys(edits).length) return true;
        if (!_calPendingEdits[post.id]) _calPendingEdits[post.id] = {};
        Object.assign(_calPendingEdits[post.id], edits);
        Object.assign(post, edits);
        // Today's card save answers a failure on the card (Save failed · Retry), not by throwing: read it back here.
        delete post._saveError;
        await _calFlushCardSave(post.id);
        const now = (calState.posts || []).find(p => p.id === post.id) || post;
        try { _calRenderBody({ preserveScroll: true }); } catch (e) {}
        return !now._saveError;
    }
    /* V2 (plan docs/plans/2026-11-trial-and-posting/combined.md row V2, variants.md 4.3; switch trial_versions_v2): import
       several versions' video links from one Frame share link. Step 1 takes the link; step 2 lists the folder's videos
       (frameio-view part "list": newest first, up to 50) under the folder's name and the card's name, so a wrong folder
       shows before anything is added, with one letter picker per video. Two videos never hold one letter. Nothing is
       written until "Add"; then every link goes in one write (trial-reels versions_import), all or nothing. The version
       on the card changes from its own row, never here. Staff only, like pasting a link. */
    const TRL_LETTERS = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
    const TRL_FRAME_VIEW_URL = CAL_SUPABASE_URL + '/functions/v1/frameio-view';
    let _trlImp = null;   // { pid, step: 'link' | 'list', link, busy, err, name, videos, truncated, picks: { file_id: letter } }
    function _trlImportOn(post, vs) {
        return !!post && _trlStaffOn(post) && svTrialVersionsV2On(post.client || calState.client)
            && (vs || []).some(v => v.status !== 'dropped') && !(vs || []).some(v => ['on trial', 'winner', 'lost'].includes(v.status));
    }
    /* A letter only when the file name clearly says one ("_A", " B.", "v2", "hook 3"); anything else starts on Skip. */
    function _trlGuessLetter(name) {
        const stem = String(name || '').replace(/\.[a-z0-9]{2,4}$/i, '');
        const n = stem.match(/(?:^|[\s_\-(])(?:v|ver|version|hook|take)[\s_\-]?([1-7])(?=$|[^0-9])/i);
        if (n) return TRL_LETTERS[Number(n[1]) - 1];
        const l = stem.match(/(?:^|[\s_\-(])([A-G])(?=$|[\s_\-.)])/);
        return l ? l[1] : '';
    }
    function _trlImpVersions() {
        const post = _trlImp && _trlPost(_trlImp.pid);
        const shape = post && _trlShape(post);
        return (shape && shape.versions) || [];
    }
    function svTrialImportOpen(pid) {
        _trlImp = { pid, step: 'link', link: '', busy: false, err: '', name: '', videos: [], truncated: false, picks: {} };
        let ovl = document.getElementById('trlImportOverlay');
        if (!ovl) {
            ovl = document.createElement('div');
            ovl.id = 'trlImportOverlay';
            ovl.className = 'cal-import-overlay';
            ovl.innerHTML = '<div class="cal-import-modal trl-imp" role="dialog" aria-modal="true" aria-labelledby="trlImpTitle"></div>';
            // The shared backdrop guard (040): closes only on a press that began on the backdrop itself (OPEN_REPAIRS 215).
            ovl.setAttribute('data-backdrop-dismiss', '');
            ovl.addEventListener('click', e => { if (e.target === ovl && ovl._backdropPressBegan) svTrialImportClose(); });
            document.body.appendChild(ovl);
        }
        ovl.classList.add('open');
        document.body.classList.add('cal-modal-open');
        svLayerOverlay('trl-import', '#trlImportOverlay', '#trlImportOverlay > *', () => svTrialImportClose());
        _trlImpRender();
        const input = document.getElementById('trlImpLink');
        if (input) input.focus();
    }
    function svTrialImportClose() {
        svLayerRelease('trl-import', { focus: true });
        const ovl = document.getElementById('trlImportOverlay');
        if (ovl) ovl.classList.remove('open');
        document.body.classList.remove('cal-modal-open');
        _trlImp = null;
    }
    function svTrialImportBack() {
        if (!_trlImp) return;
        if (_trlImp.step === 'list' && !_trlImp.busy) { _trlImp.step = 'link'; _trlImp.err = ''; _trlImpRender(); return; }
        svTrialImportClose();
    }
    const TRL_IMP_BACK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4L6 8l4 4"/></svg>';
    function _trlImpDuration(sec) {
        const n = Number(sec);
        if (!Number.isFinite(n) || n <= 0) return '';
        const t = Math.round(n);
        return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0');
    }
    function _trlImpRender() {
        const box = document.querySelector('#trlImportOverlay .trl-imp');
        if (!box || !_trlImp) return;
        const st = _trlImp;
        const post = _trlPost(st.pid);
        const head = (title, sub) => '<div class="cal-import-head trl-imp-head">'
            + '<button type="button" class="trl-imp-back" onclick="svTrialImportBack()">' + TRL_IMP_BACK + 'Back</button>'
            + '<button class="cal-import-x" type="button" onclick="svTrialImportClose()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>'
            + '<h3 id="trlImpTitle">' + _calEsc(title) + '</h3>' + (sub ? '<p>' + sub + '</p>' : '') + '</div>';
        const err = st.err ? '<div class="cal-import-err" role="alert">' + _calEsc(st.err) + '</div>' : '';
        if (st.step === 'link') {
            box.innerHTML = head('Import versions from Frame', 'Paste the Frame share link of the folder that holds the versions.')
                + '<div class="cal-import-body trl-imp-body">'
                + '<input id="trlImpLink" class="trl-imp-link" type="url" placeholder="https://f.io/..." value="' + _calEscAttr(st.link) + '" aria-label="Frame share link"'
                + ' onkeydown="if(event.key===\'Enter\'){event.preventDefault();svTrialImportList();}"' + (st.busy ? ' disabled' : '') + '>' + err
                + (st.busy ? _trlImpSkeleton() : '') + '</div>'
                + '<div class="cal-import-foot"><button type="button" class="cal-import-btn-ghost" onclick="svTrialImportClose()">Cancel</button>'
                + '<button type="button" class="cal-import-btn-primary" onclick="svTrialImportList()"' + (st.busy ? ' disabled' : '') + '>Show videos</button></div>';
            return;
        }
        const vs = _trlImpVersions();
        const onCard = (vs.find(v => v.on_card) || {}).letter || '';
        const taken = new Set(vs.map(v => v.letter));
        const count = Object.values(st.picks).filter(Boolean).length;
        const rows = st.videos.map((f, i) => {
            const pick = st.picks[f.file_id] || '';
            // The house picker (100 _svSelectHtml), never a browser-native select (AGENTS.md; Codex on #2545).
            const items = [{ value: '', label: 'Skip' }].concat(TRL_LETTERS.map(l => ({
                value: l, label: l === onCard ? l + ' · on the card' : taken.has(l) ? l + ' · replaces' : l, disabled: l === onCard,
            })));
            const thumb = f.thumbnail_url ? '<img class="trl-imp-thumb" alt="" loading="lazy" src="' + _calEscAttr(f.thumbnail_url) + '" onerror="this.hidden=true">' : '<span class="trl-imp-thumb" aria-hidden="true"></span>';
            const meta = f.processing ? 'Still processing in Frame' : _trlImpDuration(f.duration_seconds);
            return '<div class="trl-imp-row">' + thumb + '<div class="trl-imp-text"><div class="trl-imp-name" title="' + _calEscAttr(f.name || '') + '">' + _calEsc(f.name || 'Untitled video') + '</div>'
                + (meta ? '<div class="trl-imp-meta">' + _calEsc(meta) + '</div>' : '') + '</div>'
                + '<div class="trl-imp-pick" data-file="' + _calEscAttr(f.file_id) + '">' + _svSelectHtml('trlImpPick' + i, items, pick, 'Skip', { disabled: !!f.processing || st.busy, onchange: 'svTrialImportPick(' + i + ',this.value)' }) + '</div></div>';
        }).join('');
        const sub = 'Card: ' + _calEsc((post && post.name) || 'this card');
        box.innerHTML = head('Folder "' + (st.name || 'Frame') + '" · ' + st.videos.length + (st.videos.length === 1 ? ' video' : ' videos'), sub)
            + '<div class="cal-import-body trl-imp-body">'
            + (st.videos.length ? rows : '<div class="cal-import-info">This folder has no videos.</div>')
            + (st.truncated ? '<div class="trl-imp-note">Showing the 50 newest.</div>' : '') + err + '</div>'
            + '<div class="cal-import-foot"><button type="button" class="cal-import-btn-ghost" onclick="svTrialImportClose()">Cancel</button>'
            + '<button type="button" class="cal-import-btn-primary" onclick="svTrialImportAdd()"' + (!count || st.busy ? ' disabled' : '') + '>'
            + (st.busy ? 'Adding…' : count ? 'Add ' + count + (count === 1 ? ' version' : ' versions') : 'Add versions') + '</button></div>';
    }
    /* Loading: rows of the real shape (a thumbnail, two text bars, a picker). */
    function _trlImpSkeleton() {
        return '<div class="trl-imp-skel" role="status" aria-label="Reading the folder">' + Array.from({ length: 4 }, () =>
            '<div class="trl-imp-row"><span class="trl-imp-thumb sv-skeleton"></span><div class="trl-imp-text"><span class="trl-imp-bar sv-skeleton"></span><span class="trl-imp-bar trl-imp-bar-s sv-skeleton"></span></div><span class="trl-imp-pick sv-skeleton"></span></div>').join('') + '</div>';
    }
    async function svTrialImportList() {
        if (!_trlImp || _trlImp.busy) return;
        const input = document.getElementById('trlImpLink');
        const link = String((input && input.value) || _trlImp.link || '').trim();
        _trlImp.link = link;
        if (!/^https:\/\/[^\s<>"']+$/i.test(link)) { _trlImp.err = 'Paste a Frame share link (it starts with https://).'; _trlImpRender(); return; }
        Object.assign(_trlImp, { busy: true, err: '' });
        _trlImpRender();
        const st = _trlImp;
        let json = null, status = 0;
        try {
            const resp = await fetch(TRL_FRAME_VIEW_URL, {
                method: 'POST', cache: 'no-store',
                headers: _syncviewEfHeaders({ 'Content-Type': 'application/json' }, TRL_FRAME_VIEW_URL),
                body: JSON.stringify({ link, part: 'list' }),
            });
            status = resp.status;
            json = await resp.json().catch(() => null);
        } catch (e) { json = null; }
        if (_trlImp !== st) return;   // closed or reopened meanwhile
        st.busy = false;
        if (!json || json.ok !== true || !Array.isArray(json.videos)) {
            st.err = (json && typeof json.message === 'string' && json.message) || 'SyncView could not read this folder. In Frame, make a share link for it and paste that.';
            if (!json || json.ok !== true) _writeUiRecordFailure('calendar', 'trial_reels_import_list', Object.assign(new Error(String((json && json.error) || 'request_failed')), { code: String((json && json.error) || 'request_failed') }), { http_status: status });
            _trlImpRender();
            return;
        }
        const vs = _trlImpVersions();
        const onCard = (vs.find(v => v.on_card) || {}).letter || '';
        const picks = {};
        const used = new Set();
        for (const f of json.videos) {
            const g = f.processing ? '' : _trlGuessLetter(f.name);
            if (g && g !== onCard && !used.has(g)) { picks[f.file_id] = g; used.add(g); }
        }
        // One video: it takes the first free letter (variants.md 4.3).
        if (json.videos.length === 1 && !Object.keys(picks).length && !json.videos[0].processing) {
            const free = TRL_LETTERS.find(l => !vs.some(v => v.letter === l));
            if (free) picks[json.videos[0].file_id] = free;
        }
        Object.assign(st, { step: 'list', name: String(json.name || ''), videos: json.videos, truncated: !!json.truncated, picks });
        _trlImpRender();
    }
    /* Two videos never hold one letter: picking a taken letter moves it, and the other video goes back to Skip. */
    function svTrialImportPick(index, value) {
        if (!_trlImp || !_trlImp.videos[index]) return;
        const id = _trlImp.videos[index].file_id, letter = String(value || '');
        for (const k of Object.keys(_trlImp.picks)) if (letter && _trlImp.picks[k] === letter) delete _trlImp.picks[k];
        if (letter) _trlImp.picks[id] = letter; else delete _trlImp.picks[id];
        _trlImpRender();
    }
    function svTrialImportAdd() {
        const st = _trlImp;
        if (!st || st.busy) return;
        const items = st.videos.filter(f => st.picks[f.file_id]).map(f => ({ letter: st.picks[f.file_id], link: f.link }))
            .sort((a, b) => a.letter.localeCompare(b.letter));
        if (!items.length) return;
        const vs = _trlImpVersions();
        const answered = items.map(i => vs.find(v => v.letter === i.letter))
            .filter(v => v && v.frame_url && v.status !== 'change asked' && (v.status === 'approved' || v.smm_ok_at || v.kasper_ok_at || v.client_ok_at || v.client_pass_at));
        const go = async () => {
            st.busy = true; st.err = '';
            _trlImpRender();
            const json = await _trlRun(st.pid, 'import', { action: 'versions_import', items }, 'The import');
            if (_trlImp !== st) return;
            st.busy = false;
            if (!json) { _trlImpRender(); return; }
            svTrialImportClose();
            // The last asked-for new cut came in with the import: the card goes back to the SMM, as a pasted link does.
            _trlBackToReview(st.pid, json);
            _trlOpen.add(st.pid);
            _trlRepaintField(st.pid);
            showToast(items.length === 1 ? 'Video ' + items[0].letter + ' added from Frame' : items.length + ' versions added from Frame');
        };
        if (!answered.length) return go();
        const names = answered.map(v => 'Video ' + v.letter).join(', ');
        showConfirm('Replace answered versions?', names + (answered.length === 1 ? ' was' : ' were') + ' already answered. With a new video, ' + (answered.length === 1 ? 'it goes' : 'they go') + ' back to the SMM, then Kasper.', go, 'Replace and add');
    }
    /* Dropping the version on the card (default (c), awaiting the owner): today's attach first puts the next live
       version's link on the card, so it becomes the one on the card, then the old one drops. */
    function svTrialDrop(pid, letter, restore) {
        const post = _trlPost(pid);
        const shape = post && _trlShape(post);
        const v = shape && _trlFind(shape, letter);
        if (!v) return;
        const what = 'Video ' + letter;
        if (!restore && v.on_card) {
            const next = _trlNextLive(shape.versions, letter);
            if (!next) { showNotify('Video ' + letter + ' was not dropped', 'It is the only version with a link. Paste another version\'s link first.'); return; }
            const to = next.frame_url, onto = next.letter;
            return _trlOptimistic(pid, s => {
                const a = _trlFind(s, letter), b = _trlFind(s, onto);
                if (a) Object.assign(a, { status: 'dropped', on_card: false });
                if (b) b.on_card = true;
                return s;
            }, async () => {
                const before = String(post.asset_url || '');
                let mine = '';
                try { mine = await _trlSetCardLink(post, to); }
                catch (e) { _trlSay(e, what); return null; }
                const json = await _trlRun(pid, 'drop', { action: 'version_drop', letter }, what);
                if (!json) await _trlAttachBack(post, before, mine, to);
                return json;
            });
        }
        if (!restore && !(shape.versions || []).some(x => x.letter !== letter && x.status !== 'dropped')) { _trlSay({ code: 'last_live_version' }, what); return; }
        return _trlOptimistic(pid, s => { const x = _trlFind(s, letter); if (x) x.status = restore ? 'waiting' : 'dropped'; return s; },
            () => _trlRun(pid, 'drop', { action: restore ? 'version_restore' : 'version_drop', letter }, what));
    }
    /* The owner's choice (a), 2026-10-29 (OPEN_REPAIRS 587): a card waits in Tweaks Needed only while a version's change
       is open. When the last one's new cut is in, the card goes back to For SMM Approval through today's status pick, so
       the new cut takes the normal route (the SMM, then Kasper, then the client); the other versions keep their answers. */
    function _trlBackToReview(pid, json) {
        const post = _trlPost(pid);
        if (!post || !json || post.video_status !== 'Tweaks Needed') return false;
        const open = (json.versions || []).some(v => v.status === 'change asked' && !v.client_pass_at);
        if (open || typeof window._calStatusPick !== 'function') return false;
        window._calStatusPick(pid, 'For SMM Approval', 'video');
        return true;
    }
    function svTrialNewCut(pid, letter) {
        return _trlOptimistic(pid, s => { const x = _trlFind(s, letter); if (x) x.status = 'waiting'; return s; }, async () => {
            const json = await _trlRun(pid, 'newcut', { action: 'version_new_cut', letter }, 'Video ' + letter);
            if (json) showToast(_trlBackToReview(pid, json) ? 'Video ' + letter + ' is ready: the card goes back to the SMM' : 'Video ' + letter + ' goes back to the SMM, then Kasper');
            return json;
        });
    }
    function svTrialStart(pid) {
        const ends = new Date(Date.now() + 24 * 3600000).toISOString();
        return _trlOptimistic(pid, s => {
            for (const x of (s && s.versions) || []) if (x.status === 'approved') Object.assign(x, { status: 'on trial', trial_ends_at: ends });
            if (s) s.trial_ends_at = s.trial_ends_at || ends;
            return s;
        }, () => _trlRun(pid, 'start', { action: 'trial_start' }, 'The trial'));
    }
    /* The winner, at once; today's toast offers Undo (no confirm, owner 2026-10-26). */
    /* Two staff can pick at once (Probe, bug 9). The pick reads the versions now and stops if a winner is already
       picked or this version is no longer on trial; and if the function still refuses the winner after the attach,
       the put-back is a compare-and-swap on the sub-issue (below), so a stale page never overwrites another pick. */
    /* The toast and its Undo show on the click too (Sidney, 2026-10-31, Nightreel's Q3: it came about 4 s later, when the
       save returned). A refused pick takes the toast back, and the refusal says why in words. Undo pressed while the pick
       is still saving runs after it (the card's writes go one at a time); after a refused pick there is nothing to undo. */
    const _trlPickOut = {};   // pid -> { letter, refused }
    const TRL_WIN_WORDS = l => 'Video ' + l + ' is the winner';
    function svTrialPick(pid, letter) {
        if (!_trlPost(pid)) return;
        const pick = _trlPickOut[pid] = { letter, refused: false };
        showToast(TRL_WIN_WORDS(letter), { actionLabel: 'Undo', onAction: () => _trlUndoPick(pid) });
        // The winner shows at once; the race guard, the attach and the function follow (a refusal puts it back).
        return _trlOptimistic(pid, s => {
            for (const x of (s && s.versions) || []) {
                if (x.letter === letter) Object.assign(x, { status: 'winner', on_card: true });
                else { x.on_card = false; if (x.status === 'on trial') x.status = 'lost'; }
            }
            if (s) s.winner_letter = letter;
            return s;
        }, async () => {
            let json = null;
            try { json = await _trlPickNow(pid, letter); }
            catch (e) { showNotify('The winner was not picked', 'It did not save. Nothing changed. Try again.'); }
            if (!json) {
                pick.refused = true;
                const t = document.querySelector('.sv-toast .sv-toast-msg');
                if (t && t.textContent === TRL_WIN_WORDS(letter)) hideToast();
            }
            return json;
        });
    }
    async function _trlPickNow(pid, letter) {
        const post = _trlPost(pid);
        if (!post) return null;
        const fresh = await _trlFresh(post);
        const v = fresh && (fresh.versions || []).find(x => x.letter === letter);
        if (!fresh) { showNotify('The winner was not picked', 'The versions could not be read. Try again.'); return; }
        if (fresh.winner_letter || !v || v.status !== 'on trial') { _trlStale(pid); return; }
        if (!v.frame_url) { showNotify('Video ' + letter + ' has no link', 'Paste its Frame.io link first.'); return; }
        let mine = '';
        try { mine = await _trlSetCardLink(post, v.frame_url); }
        catch (e) { _trlSay(e, 'The winner'); return; }
        // V3: the winner's thumbnail and caption follow its video onto the card.
        const fieldsOn = _trlFieldsOn(post) && !!v.effective;
        const before = { thumbnail_url: post.thumbnail_url || '', caption: post.caption || '' };
        // A copy that did not save stops the pick (Codex on #2539): the card would keep the old thumbnail and caption
        // beside the winner's video. The fields and the video link go back, and nothing is picked.
        if (fieldsOn && !(await _trlSetCardFields(post, v.effective))) {
            await _trlSetCardFields(post, before);
            await _trlPutBack(post, mine, v.frame_url);
            showNotify('The winner was not picked', "The card's thumbnail and caption could not be saved, so nothing changed. Try again in a moment.");
            return null;
        }
        const json = await _trlRun(pid, 'pick', { action: 'winner_set', letter }, 'The winner');
        // The card already carries the winner's link: when the winner itself is refused, put the card's link back,
        // so the card and the versions never disagree (the refusal is already on screen).
        if (!json) {
            if (fieldsOn) await _trlSetCardFields(post, before);
            await _trlPutBack(post, mine, v.frame_url);
            return null;
        }
        if (fieldsOn) _trlCardFieldsBefore[pid] = { before, wrote: { thumbnail_url: v.effective.thumbnail_url || '', caption: v.effective.caption || '' } };
        return json;
    }
    function _trlStale(pid) {
        _trlRepaintField(pid);
        showNotify('Someone else just changed this trial', 'The versions are up to date now. Look again, then try again.');
    }
    /* Put the card's link back to what the function says it should carry (the winner's, else Video A's), never to
       what this page saw before (another staff member may have picked since). `mine` is the clock this page's own
       attach answered: the put-back lands only if nobody moved the sub-issue since; if someone did, theirs stands. */
    async function _trlPutBack(post, mine, now) {
        const fresh = await _trlFresh(post);
        const link = fresh ? _trlMainLink(fresh) : '';
        if (link && link !== now) {
            try { await _trlSetCardLink(post, link, mine); }
            catch (e) {
                if (String(e && e.code) === 'write_conflict') showNotify("Someone else just changed the card's Video link", 'Theirs stands. Look again before you change it.');
                else showNotify("The card's Video link was not put back", 'It now opens another version. Set the Video link by hand, then try again.');
            }
        }
        _trlRepaintField(post.id);
    }
    function _trlUndoPick(pid) {
        if (!_trlPost(pid)) return;
        return _trlOptimistic(pid, s => {
            const first = ((s && s.versions) || []).find(x => x.status !== 'dropped');
            for (const x of (s && s.versions) || []) {
                if (x.status === 'winner' || x.status === 'lost') x.status = 'on trial';
                x.on_card = x === first;
            }
            if (s) s.winner_letter = null;
            return s;
        }, () => _trlUndoNow(pid));
    }
    async function _trlUndoNow(pid) {
        const post = _trlPost(pid);
        if (!post) return null;
        const fresh = await _trlFresh(post);
        // Undo pressed while the pick was still saving, and the pick was refused: nothing was picked, and the refusal
        // already said so.
        const pk = _trlPickOut[pid];
        if (pk && pk.refused) { delete _trlPickOut[pid]; _trlRepaintField(pid); return; }
        if (!fresh) { showNotify('Undo did not happen', 'The versions could not be read. Try again.'); return; }
        if (!fresh.winner_letter) { _trlStale(pid); return; }
        // Back on trial the card carries the first live version again (Video A unless it was dropped).
        const a = (fresh.versions || []).find(x => x.status !== 'dropped');
        const link = String((a && a.frame_url) || '');
        if (!link) return;
        let mine = '';
        try { mine = await _trlSetCardLink(post, link); }
        catch (e) { _trlSay(e, 'Undo'); return; }
        const json = await _trlRun(pid, 'undo', { action: 'winner_undo' }, 'Undo');
        const kept = _trlCardFieldsBefore[pid];
        delete _trlCardFieldsBefore[pid];
        if (json && kept) {
            // Someone edited the card's thumbnail or caption since the pick: theirs stands, nothing is overwritten.
            const now = { thumbnail_url: String(post.thumbnail_url || ''), caption: String(post.caption || '') };
            if (now.thumbnail_url !== kept.wrote.thumbnail_url || now.caption !== kept.wrote.caption) {
                showNotify('The card\'s thumbnail and caption were not put back', 'The card was edited after the winner was picked; check its thumbnail and caption by hand.');
            } else await _trlSetCardFields(post, kept.before);
        }
        if (json) showToast('Back on trial');
        else await _trlPutBack(post, mine, link);   // the winner stands, so its link does too
        return json;
    }
// Production's Assets (245) read and write the same versions through the same calls and labels.

    // ---- the Notes player (190): one version at a time ------------------------------------------------------------
    /* With more than one version linked, the Notes view's player plays one version, picked in a small "Video A B C"
       switch under it (beside Open in Frame.io; a slim bar of its own on a phone), and its Frame.io comments follow the
       version on screen. The title and the "About the…" switch say "Video C", and a video note written while C is on
       screen starts "Video C:". Staff only, as the card's versions are. Once a winner is picked: today's player. */
    const _trlNotesCur = {};   // pid -> letter on screen
    function _trlNotesChanged(pid) {
        try { window.dispatchEvent(new CustomEvent('sv-trial-notes', { detail: { pid } })); } catch (e) {}
    }
    function _trlNotesVersions(post) {
        if (!_trlStaffOn(post)) return null;
        const shape = _trlShape(post);
        if (!shape || !shape.enabled) return null;
        const vs = shape.versions || [];
        if (vs.some(v => v.status === 'winner')) return null;
        const linked = vs.filter(v => v.status !== 'dropped' && v.frame_url);
        return linked.length > 1 ? linked : null;
    }
    function _trlNotesCurOf(post, vs) {
        const had = vs.find(v => v.letter === _trlNotesCur[post.id]);
        if (had) return had;
        const v = vs.find(x => x.on_card) || vs[0];
        _trlNotesCur[post.id] = v.letter;
        return v;
    }
    /* A trial card the staff are looking at (any number of versions, before or after the pick): Notes marks it "Trial". */
    function svTrialCardOn(post) {
        if (!_trlStaffOn(post)) return false;
        const shape = _trlShape(post);
        return !!(shape && shape.enabled);
    }
    /* The letter on screen in the Notes view, or '' on every other card. */
    function svTrialNotesLetter(post) {
        const vs = post && _trlNotesVersions(post);
        return vs ? _trlNotesCurOf(post, vs).letter : '';
    }
    /* The post the Notes player plays: the version on screen's link in place of the card's. */
    function svTrialNotesPost(post) {
        const vs = post && _trlNotesVersions(post);
        if (!vs) return post;
        // _fvPortrait: a reel's 9:16 until the video says (187), never a wide box first.
        return Object.assign({}, post, { asset_url: _trlNotesCurOf(post, vs).frame_url, _fvPortrait: true });
    }
    function svTrialNotesSwitchHtml(post) {
        const vs = post && _trlNotesVersions(post);
        if (!vs) return '';
        const cur = _trlNotesCurOf(post, vs), p = _calEscAttr(post.id);
        return '<div class="trl-notes-sw" role="group" aria-label="Which version plays"><span class="cal-cm-audience-cap">Video</span><div class="cal-cm-aud-seg">'
            + vs.map(v => {
                const l = _calEscAttr(v.letter);
                return '<button type="button" class="cal-cm-aud-btn' + (v === cur ? ' is-active' : '') + '" aria-pressed="' + (v === cur) + '" aria-label="Video ' + l + '"'
                    + ' onclick="svTrialNotesPick(\'' + p + '\',\'' + l + '\')">' + l + '</button>';
            }).join('')
            + '</div></div>';
    }
    function svTrialNotesPick(pid, letter) {
        if (_trlNotesCur[pid] === letter) return;
        _trlNotesCur[pid] = letter;
        _trlNotesChanged(pid);
    }
    /* A note about the video, written while a version is on screen, names it. */
    function svTrialNotesBody(post, body) {
        const l = svTrialNotesLetter(post);
        return l && !/^Video [A-G]:/.test(body) ? 'Video ' + l + ': ' + body : body;
    }

    // ---- window exports (generated by `node scripts/check-modules.js --write-window-exports`; do not edit) ----
    Object.assign(window, {
        svTrialDrop, svTrialEdit, svTrialFieldEdit, svTrialFieldKey, svTrialFieldSave, svTrialImportAdd,
        svTrialImportBack, svTrialImportClose, svTrialImportList, svTrialImportOpen, svTrialImportPick,
        svTrialLinkKey, svTrialLinkSave, svTrialNewCut, svTrialNotesPick, svTrialOpen, svTrialPick,
        svTrialStatusMenu, svTrialStatusPick, svTrialToggle
    });

    /* PROTOTYPE, plan row 688 (?trialtabs=a|b|c). Throwaway branch, never merged: shows Sidney the three ways to draw one
       card with A/B/C version tabs on the real page. It only redraws what the card already shows: nothing it adds saves. */
    function _ttOpt() {
        try { const q = new URLSearchParams(location.search).get('trialtabs') || window.__trialtabs || ''; return /^[abc]$/i.test(q) ? q.toLowerCase() : ''; } catch (e) { return ''; }
    }
    const _ttSel = {};
    const _ttTone = v => v.status === 'dropped' || v.client_pass_at ? 'mute' : ['approved', 'on trial', 'winner'].includes(v.status) ? 'ok' : v.status === 'change asked' ? 'chg' : (v.place || 'smm');
    const TT_WORD = { ok: 'approved', chg: 'change asked', client: 'with client', kasper: 'with Kasper', smm: 'with SMM', mute: 'dropped' };
    const TT_CSS = `
[data-tone] { --tt: var(--text-muted); }
[data-tone="ok"] { --tt: var(--cal-status-approved-bg); }
[data-tone="chg"] { --tt: var(--cal-status-tweaks-needed-bg); }
[data-tone="client"] { --tt: var(--cal-status-client-approval-bg); }
[data-tone="kasper"] { --tt: var(--cal-status-kasper-approval-bg); }
[data-tone="smm"] { --tt: var(--cal-status-for-smm-approval-bg); }
.cal-card[data-tt] .trl-list, .cal-card[data-tt] .trl-chev, .cal-card[data-tt] .trl-state, .cal-card[data-tt] .trl-fill { display: none !important; }
.cal-card[data-tt] .trl-main { gap: 6px; }
.tt-x .tt-l { font-weight: 700; }
.tt-sw { display: inline-flex; align-items: center; gap: 6px; margin-left: 6px; flex: none; font-size: 12px; font-weight: 600; color: var(--text-secondary); }
.tt-sw .trl-sw-slot { display: inline-flex; align-items: center; border: 0; padding: 0; margin: 0; background: transparent; cursor: pointer; }
.tt-sw .trl-sw { position: relative; display: block; width: 24px; height: 14px; border-radius: 999px; background: var(--sv-slot-video-fg); }
.tt-sw .trl-sw::after { content: ""; position: absolute; top: 2px; left: 12px; width: 10px; height: 10px; border-radius: 50%; background: var(--sv-knob); }
.tt-pick.trl-v { display: inline-flex; align-items: center; margin-left: auto; padding: 0 4px 0 0; min-height: 0; border: 0; background: none; }
.cal-card[data-tt] .trl-main .cal-link-pill-open { flex: 1 1 auto; min-width: 0; }
.tt-a { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 10px; }
.tt-a button { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 11px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-raised); font: inherit; font-size: 13px; font-weight: 600; color: var(--text-secondary); cursor: pointer; }
.tt-a button i { width: 7px; height: 7px; border-radius: 50%; background: var(--tt); }
.tt-a button.on { color: var(--text-primary); border-color: var(--text-primary); box-shadow: inset 0 0 0 1px var(--text-primary); }
.tt-a button.tt-drop { color: var(--text-muted); border-style: dashed; }
.tt-a button.tt-add { color: var(--text-muted); padding: 0 10px; }
.tt-b { position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 3; display: flex; gap: 3px; padding: 3px; border-radius: 11px; background: rgba(255,255,255,.78); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.tt-b button { flex: 1; height: 28px; border: 0; border-radius: 8px; background: color-mix(in srgb, var(--tt) 30%, transparent); font: inherit; font-size: 13px; font-weight: 700; color: #3a3a37; position: relative; cursor: pointer; }
.tt-b button::after { content: ''; position: absolute; left: 32%; right: 32%; bottom: 4px; height: 3px; border-radius: 2px; background: var(--tt); }
.tt-b button.on { background: #fff; color: #111110; box-shadow: 0 1px 2px rgba(0,0,0,.14), inset 0 0 0 1.5px var(--tt); }
.tt-b button.tt-more { flex: 0 0 30px; background: transparent; color: #6b6b67; }
.tt-b button.tt-more::after { display: none; }
.tt-c { display: flex; gap: 8px; padding: 12px 16px 0; align-items: flex-start; }
.tt-c button { display: grid; justify-items: center; gap: 4px; border: 0; background: none; padding: 0; font: inherit; cursor: pointer; }
.tt-c .tt-p { width: 40px; height: 56px; border-radius: 7px; overflow: hidden; background: var(--surface-subtle); box-shadow: 0 0 0 1px var(--border); display: grid; place-items: center; color: var(--text-muted); font-size: 16px; }
.tt-c .tt-p img { width: 100%; height: 100%; object-fit: cover; display: block; }
.tt-c button.on .tt-p { box-shadow: 0 0 0 2px var(--surface-raised), 0 0 0 4px var(--text-primary); }
.tt-c .tt-n { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: var(--text-secondary); }
.tt-c .tt-n i { width: 6px; height: 6px; border-radius: 50%; background: var(--tt); }
.tt-c button.on .tt-n { color: var(--text-primary); }
.tt-c button.tt-drop .tt-p { opacity: .4; }
.tt-c button.tt-add .tt-p { background: transparent; box-shadow: none; border: 1px dashed var(--border); }
.tt-mk { display: flex; align-items: center; gap: 4px; margin-top: 3px; }
.tt-mk-a i { width: 6px; height: 6px; border-radius: 50%; background: var(--tt); }
.tt-mk-a b { display: inline-flex; align-items: center; gap: 3px; font-size: 10px; font-weight: 700; color: var(--text-secondary); }
.tt-mk-b { gap: 2px; width: 100%; max-width: 72px; }
.tt-mk-b i { flex: 1; height: 4px; border-radius: 2px; background: var(--tt); }
.tt-mk-c img, .tt-mk-c span { width: 12px; height: 17px; border-radius: 3px; object-fit: cover; box-shadow: 0 0 0 1.5px var(--surface-raised); margin-left: -6px; background: var(--surface-subtle); }
.tt-mk-c img:first-child { margin-left: 0; }
.tt-mk-c b { margin-left: 3px; font-size: 10px; font-weight: 700; color: var(--text-secondary); }
`;
    function _ttPic(v, post) {
        const th = String((v.effective && v.effective.thumbnail_url) || v.thumbnail_url || post.thumbnail_url || '').trim();
        if (!th) return '';
        try { return _calDeriveThumb({ thumbnail_url: th }) || th; } catch (e) { return th; }
    }
    function _ttLive(post) {
        const shape = post && _trlShape(post);
        if (!shape || !shape.enabled) return null;
        const vs = shape.versions || [];
        const live = vs.filter(v => v.status !== 'dropped');
        return live.length > 1 ? { live, dropped: vs.filter(v => v.status === 'dropped') } : null;
    }
    function svTrialTab(pid, letter) {
        _ttSel[pid] = letter;
        document.querySelectorAll('.cal-card[data-pid="' + CSS.escape(pid) + '"]').forEach(c => { delete c.dataset.tt; _ttCard(c); });
    }
    function _ttCard(card) {
        const pid = card.dataset.pid, post = _trlPost(pid), got = _ttLive(post);
        if (!got) return;
        const o = _ttOpt(), { live, dropped } = got;
        const sel = live.find(v => v.letter === _ttSel[pid]) || live.find(v => v.status !== 'approved') || live[0];
        const sig = o + '|' + sel.letter + '|' + live.map(v => v.letter + v.status + (v.place || '')).join(',');
        if (card.dataset.tt === sig && card.querySelector('.tt-x')) return;
        card.dataset.tt = sig;
        card.querySelectorAll('.tt-x').forEach(e => e.remove());
        const p = _calEscAttr(pid);
        const tip = v => 'Video ' + v.letter + ': ' + TT_WORD[_ttTone(v)];
        const go = v => ' onclick="event.stopPropagation();svTrialTab(\'' + p + '\',\'' + _calEscAttr(v.letter) + '\')"';
        let tabs = '';
        if (o === 'a') {
            tabs = '<div class="tt-x tt-a" role="group" aria-label="Versions">' + live.map(v => '<button type="button" class="' + (v === sel ? 'on' : '') + '" data-tone="' + _ttTone(v) + '" title="' + _calEscAttr(tip(v)) + '" aria-pressed="' + (v === sel) + '"' + go(v) + '><i></i>' + _calEsc(v.letter) + '</button>').join('')
                + (dropped.length ? '<button type="button" class="tt-drop" title="Dropped">' + dropped.map(v => _calEsc(v.letter)).join(' ') + '</button>' : '')
                + '<button type="button" class="tt-add" title="Add version" aria-label="Add version">+</button></div>';
        } else if (o === 'b') {
            tabs = '<div class="tt-x tt-b" role="group" aria-label="Versions">' + live.map(v => '<button type="button" class="' + (v === sel ? 'on' : '') + '" data-tone="' + _ttTone(v) + '" title="' + _calEscAttr(tip(v)) + '" aria-pressed="' + (v === sel) + '"' + go(v) + '>' + _calEsc(v.letter) + '</button>').join('')
                + '<button type="button" class="tt-more" title="Add, import or bring back a version" aria-label="More">···</button></div>';
        } else {
            tabs = '<div class="tt-x tt-c" role="group" aria-label="Versions">' + live.map(v => { const pic = _ttPic(v, post);
                return '<button type="button" class="' + (v === sel ? 'on' : '') + '" data-tone="' + _ttTone(v) + '" title="' + _calEscAttr(tip(v)) + '" aria-pressed="' + (v === sel) + '"' + go(v) + '><span class="tt-p">' + (pic ? '<img alt="" src="' + _calEscAttr(pic) + '">' : '') + '</span><span class="tt-n"><i></i>' + _calEsc(v.letter) + '</span></button>'; }).join('')
                + dropped.map(v => '<button type="button" class="tt-drop" title="Video ' + _calEscAttr(v.letter) + ': dropped"><span class="tt-p"></span><span class="tt-n">' + _calEsc(v.letter) + '</span></button>').join('')
                + '<button type="button" class="tt-add" title="Add version" aria-label="Add version"><span class="tt-p">+</span><span class="tt-n">&nbsp;</span></button></div>';
        }
        const thumb = card.querySelector('.cal-card-thumb'), body = card.querySelector('.cal-card-body'), title = card.querySelector('.cal-title-row');
        if (o === 'a' && title) title.insertAdjacentHTML('afterend', tabs);
        if (o === 'b' && thumb) thumb.insertAdjacentHTML('beforeend', tabs);
        if (o === 'c' && body) body.insertAdjacentHTML('beforebegin', tabs);
        // The picture, the Video row and the caption show the version on the tab.
        const pic = _ttPic(sel, post), img = thumb && thumb.querySelector('img');
        if (img && pic && img.getAttribute('src') !== pic) img.setAttribute('src', pic);
        const row = card.querySelector('.trl-main');
        if (row) {
            const lab = row.querySelector('.trl-main-label');
            if (lab) lab.textContent = 'Video ' + sel.letter;
            const sw = row.querySelector('.trl-sw-slot');
            if (sw && title && !title.querySelector('.tt-sw')) { const w = document.createElement('span'); w.className = 'tt-sw'; w.innerHTML = 'Trial'; w.appendChild(sw); title.appendChild(w); }
            const pill = _trlStatusPickOn(post, sel) ? _trlStatusPickHtml(pid, sel) : svTrialLabelHtml(sel.status, sel);
            const open = row.querySelector('.cal-link-pill-open');
            if (open) open.insertAdjacentHTML('afterend', '<span class="tt-x tt-pick trl-v">' + pill + '</span>');
        }
        const cap = card.querySelector('textarea.cal-fld-cap');
        if (cap) { const c = String((sel.effective && sel.effective.caption) || ''); if (cap.value !== c) cap.value = c; cap.readOnly = true; }
    }
    function _ttMarks() {
        document.querySelectorAll('.cal-month-pill[onclick*="openCalPreview"], .cal-week-card[onclick*="openCalPreview"]').forEach(el => {
            const m = /openCalPreview\('([^']+)'\)/.exec(el.getAttribute('onclick') || ''); if (!m) return;
            const post = _trlPost(m[1]), got = _ttLive(post); if (!got) return;
            const o = _ttOpt(), week = el.classList.contains('cal-week-card');
            if (el.dataset.tt === o && el.querySelector('.tt-mk')) return;
            el.dataset.tt = o;
            el.querySelectorAll('.tt-mk').forEach(e => e.remove());
            const live = got.live;
            const html = o === 'a' ? '<span class="tt-mk tt-mk-a">' + live.map(v => week ? '<b data-tone="' + _ttTone(v) + '"><i></i>' + _calEsc(v.letter) + '</b>' : '<i data-tone="' + _ttTone(v) + '"></i>').join('') + '</span>'
                : o === 'b' ? '<span class="tt-mk tt-mk-b">' + live.map(v => '<i data-tone="' + _ttTone(v) + '"></i>').join('') + '</span>'
                : '<span class="tt-mk tt-mk-c">' + live.map(v => { const pic = _ttPic(v, post); return pic ? '<img alt="" src="' + _calEscAttr(pic) + '">' : '<span></span>'; }).join('') + '<b>' + live.length + '</b></span>';
            const host = el.querySelector(week ? '.cal-week-card-body' : '.cal-month-pill-meta') || el;
            host.insertAdjacentHTML('beforeend', html);
        });
    }
    function _ttScan() {
        if (!_ttOpt() || _isClientLink) return;
