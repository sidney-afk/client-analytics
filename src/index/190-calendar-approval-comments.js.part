import { svLayerOpen, svLayerOverlay, svLayerRelease } from './041-core-layers.js';
import { dismissConfirm, showConfirm, showNotify, showToast, svBusyHtml, svBusyOn, svSpinHtml } from './040-shared-briefs.js';
import { svFrameFeed, svFrameNotesFeed, svFrameNotesLink, svFrameNotesUse, svFrameFlagWait, svFrameIoLinkHtml, svFrameStageMount, svFrameWarm, svFrameStageUnmount, svFrameTileAttrs, svFrameTileLabelHtml, svFrameTime } from './187-frame-viewer.js';
import { _svPhoneNotesPresentation } from './095-shared-client.js';
import {
  CAL_COMPONENTS, CAL_REVIEW_COMPONENTS, _calClearStaleApprovals, _calComponentsFor, _prodCrosswalkInFlight,
  _calIsYouTubeCard, _calNormStatus, _prodCommentAddRoutesLegacy, _writeUiBindRepairAck,
  _writeUiComponentHasWorkItem, _writeUiFailureSentence, _writeUiMergeCommittedBatch, _writeUiNativeId,
  _writeUiRecordFailure, _writeUiReportFailure, _writeUiSourceClientSlug, computeOverallStatus
} from './120-calendar-flags-write-repair.js';
import {
  _calCommentsFor, _calCommentsForView, _calCompLinked, _calLinearUrlFor, _calMsgAudience,
  _calMsgIsTweak, _calNextTweakRound, _calNoLinearPush, _calPendingEdits, _calPillDisplayStatus,
  _calReviewCapCardHtml, _calSetCommentsFor, calClientSlug, calState
} from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr, _jsAttrArg, _svDraftClear, _svDraftClearIf, _svDraftNoteHtml, _svDraftNorm, _svDraftRead, _svDraftSave } from './131-core-html.js';
import { _calParseIso } from './132-calendar-dates-ids.js';
import {
  _calApplyUrgentButtonState, _calPostLinearComment, _calShowKasperUrgent, _calUrgentButtonHtml,
  _writeUiApplySupersededTeamDelivery, _writeUiCommentActionFailureHtml,
  _writeUiCommitCardCommentLifecycle, _writeUiFlushDeferredLegacyTweak,
  _writeUiLegacyCommittedTweak, _writeUiLegacyInspectTargetTweak,
  _writeUiLegacyPinnedSourceTransport, _writeUiLegacyReconcileCommittedTweak,
  _writeUiLegacyRefreshActiveTweak, _writeUiLegacyTargetWithLock,
  _writeUiPersistCanonicalCommentProjection, _writeUiQueueDeferredLegacyTweak,
  _writeUiRequestTweakMarkLocalStatus, _writeUiRollbackRequestTweak,
  _writeUiScheduleDeferredLegacyTweak
} from './140-calendar-legacy-outbox.js';
import { _calMarkLocalStatus, _calV2Log } from './150-calendar-hydration-import.js';
import {
  _calClientCompPillsHtml, _calCompStatusLabel, _calDeriveThumb, _calDeriveThumbInfo,
  _calPhoneClient, _calPhoneSectionHtml,
  _calFolderOpenUrl, _calFrameOpenUrl, _calIsFolderLink, _calIsFrameLink, _calMiniLinkBadgeHtml,
  _calRenderBody, _calReviewFrameHtml, _calStaffPhoneActive, _calStatusLabel, _calThumbIconSvg, _calThumbImgTag,
  _kcardReuseThumbInto, _thumbCompareSlotHtml, onCalViewChange
} from './160-calendar-organize-ui.js';
import {
  _calAutoResolveDestStatus, _calFlushCardSave, _calReviewBlockReason, _calSmmApproveTo,
  _calStatusSlug
} from './170-calendar-links-status.js';
import {
  COMP_LABELS, _CAL_REVIEW_CFG, _calHasBeenToKasper, _calHasUnreadNotes,
  _calRecordKasperSeenOnPost, _calReviewComponentActive, _calReviewMode, _calReviewState,
  _calShowApprovedAfterTweaks, _notesMarkSeen
} from './180-calendar-native-post-media.js';
import { _calCrqBegin, _calCrqDone, _calCrqFailed, _calCrqHeld, _calCrqResend, _calCrqResolve } from './185-client-review-queue.js';
import { _prodCanonicalCommentGate, _prodClientCommentGatewayContext, _prodComments, _prodCommentsEmptyFeedHtml, _prodCommentsFeedHasRows, _prodProjectCanonicalCardComments } from './230-production-create-comments.js';
import { _isClientLink } from './260-production-refresh-boot.js';
import { _syncviewStaffIdentityForHeaders, _syncviewStaffRoster } from './100-onboarding-staff-controls.js';
import { svFrameCommentsInNotesOn, svRsCalOn, svRsCalPending, svRsCalSync, svRsClientReviewOn, svUnreadBadgesOn } from './188-review-stage-switch.js';
import { svTrialNotesBody, svTrialNotesLetter, svTrialNotesPost, svTrialNotesSwitchHtml } from './189-trial-reels-card.js';
import { _calLoaderHtml } from './133-core-loading-skeletons.js';
import { svuActive, svuNotesBtnHtml, svuNotesOpening } from './327-core-unread-badges.js';
    function _calHasMedia(p) {
        return !!(String((p && p.asset_url) || '').trim() || String((p && p.thumbnail_url) || '').trim());
    }
    // What media is still missing on a post awaiting SMM approval. Returns
    // null when there's nothing to flag (not awaiting approval, or both URLs
    // present); otherwise { video, thumb } booleans naming exactly what's
    // absent so the warning can say whether it's the video, the thumbnail, or
    // both. Drives the warning overlay on the card / banner on the preview /
    // dot on the month + week pills.
    function _calSmmMediaGap(p) {
        if (!p) return null;
        // A component is flagged once its sub-status moves past In Progress —
        // i.e. it's been sent for any kind of approval (For SMM Approval,
        // Kasper Approval, Client Approval, …) or beyond. At that point the
        // matching media URL must already be linked, so warn while it's empty.
        // The video sub-status governs the video URL; the thumbnail (graphic)
        // sub-status governs the thumbnail URL — each is independent.
        // N/A is not "past In Progress": it says the post will never have this
        // part, which is exactly what the warning itself tells people to set
        // ("If this post will never have one, set it to N/A"). Counting it kept
        // the warning on the card, and the post in Today's "Missing links",
        // with no way to clear either short of adding a link.
        const beyondProgress = s => { const st = _calNormStatus(s || ''); return st !== 'In Progress' && st !== 'N/A'; };
        const video = beyondProgress(p.video_status)   && !String(p.asset_url || '').trim();
        const thumb = beyondProgress(p.graphic_status) && !String(p.thumbnail_url || '').trim();
        if (!video && !thumb) return null;
        return { video, thumb };
    }
    function _calSmmMissingMedia(p) { return !!_calSmmMediaGap(p); }
    // Headline / body / tooltip tailored to the specific gap.
    function _calSmmWarnParts(gap) {
        if (!gap) return null;
        if (gap.video && gap.thumb) return {
            strong: 'No media linked.',
            rest: 'Add a video and a thumbnail URL before this can go for approval.',
            title: 'Sent for approval, but no video or thumbnail Frame link yet. Add them so it can be reviewed.'
        };
        if (gap.video) return {
            strong: 'No video linked.',
            rest: 'Add the video URL before this can go for approval.',
            title: "Sent for approval, but no video Frame link yet. Add it so it can be reviewed."
        };
        return {
            strong: 'No thumbnail linked.',
            rest: 'Add the thumbnail URL before this can go for approval.',
            title: "Sent for approval, but no thumbnail Frame link yet. Add it so it can be reviewed."
        };
    }
    function _calSmmWarnIconSvg() {
        return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
    }
    // Inline banner — used in the read-only preview popover where stacking it
    // in the body flow is fine.
    function _calSmmWarnBannerHtml(p) {
        const parts = _calSmmWarnParts(_calSmmMediaGap(p));
        if (!parts) return '';
        return `<div class="cal-smm-warn" title="${_calEscAttr(parts.title)}">${_calSmmWarnIconSvg()}<span><strong>${_calEsc(parts.strong)}</strong> ${_calEsc(parts.rest)}</span></div>`;
    }
    // Overlay variant — pinned in front of the card's thumbnail so the warning
    // never changes the card's height (it sits over the missing media instead
    // of pushing the body down).
    function _calSmmWarnOverlayHtml(p) {
        const parts = _calSmmWarnParts(_calSmmMediaGap(p));
        if (!parts) return '';
        return `<div class="cal-smm-warn cal-smm-warn-overlay" title="${_calEscAttr(parts.title)}">${_calSmmWarnIconSvg()}<span><strong>${_calEsc(parts.strong)}</strong> ${_calEsc(parts.rest)}</span></div>`;
    }
    function _calSmmWarnDotHtml(p) {
        const parts = _calSmmWarnParts(_calSmmMediaGap(p));
        const title = parts ? parts.title : 'Sent for approval, but no Frame link yet.';
        return `<span class="cal-smm-warn-dot" title="${_calEscAttr(title)}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>`;
    }

    /* Count of posts actually awaiting this surface's sign-off — i.e. at least
       one component sitting at the review status (Tweaks-Needed cards are
       waiting on the editor, not the reviewer, so they don't count). Drives
       the little number badge on the Review tab. Honours the SMM tab's
       no-media rule so the badge matches what the tab will actually show. */
    function _calApprovalBadgeCount(mode) {
        const reviewStatus = _CAL_REVIEW_CFG[mode].reviewStatus;
        return (calState.posts || []).reduce((n, p) => {
            /* Media-stranded cards are deliberately NOT counted here, and the
               choice is on the record because it looks like an oversight.
               This badge means "items you can review", and the list length is
               what a reader checks it against; counting cards the queue cannot
               render would make the two disagree and turn the badge into
               "items needing attention", which is a different promise. The
               stranded work is reported instead by the notice above the queue,
               which carries its own count -- see _calReviewStrandedNoticeHtml. */
            if (mode === 'smm' && !_calHasMedia(p)) return n;
            const awaiting = _calComponentsFor(p).some(c => _calNormStatus(p[c + '_status'] || '') === reviewStatus);
            return n + (awaiting ? 1 : 0);
        }, 0);
    }
    // Refresh the Review tab's badge in place (the toolbar isn't re-rendered on
    // every approve/tweak, so we patch the badge node directly).
    function _calUpdateReviewBadge() {
        document.querySelectorAll('.cal-view-btn').forEach(btn => {
            const v = btn.dataset.calView;
            if (v !== 'review' && v !== 'smmreview') return;
            const count = _calApprovalBadgeCount(v === 'smmreview' ? 'smm' : 'client');
            let badge = btn.querySelector('.cal-view-badge');
            if (count > 0) {
                if (!badge) { badge = document.createElement('span'); badge.className = 'cal-view-badge'; btn.appendChild(badge); }
                if (badge.textContent !== String(count)) badge.textContent = String(count);
            } else if (badge) {
                badge.remove();
            }
        });
    }

    function _calReviewItems() {
        const mode = _calReviewMode();
        return (calState.posts || []).filter(p => {
            const s = _calNormStatus(p.status || '');
            const phoneSaving = _calStaffPhoneActive() && mode === 'smm' && _calComponentsFor(p).some(c => _calReviewState.saving[p.id + '|' + c]);
            // The YouTube title is excluded from the overall status, so a card can
            // read Approved/Scheduled/Posted overall while its title is still
            // awaiting review on THIS surface. Don't hide those — otherwise a
            // title-only review never reaches the queue once the other three are
            // already approved.
            const surf = (mode === 'smm') ? 'smm' : 'client';
            const titlePending = _calIsYouTubeCard(p) && _calReviewComponentActive(p, 'title', surf);
            if ((s === 'Approved' || s === 'Scheduled' || s === 'Posted') && !titlePending && !phoneSaving) return false;
            // SMM Review tab: only posts with a component awaiting SMM
            // approval (or sent back for tweaks), AND that actually have
            // something to look at — a post with no video and no thumbnail
            // isn't ready for sign-off, so it stays hidden until media lands.
            if (mode === 'smm') {
                if (!_calHasMedia(p)) return false;
                return phoneSaving || _calComponentsFor(p).some(c => _calReviewComponentActive(p, c, 'smm'));
            }
            // A real tokened client sees only components exactly at Client
            // Approval. Tweaks Needed is retained only by the internal
            // non-client preview in _calReviewComponentActive; the real client
            // queue drops it until the revised work returns for approval.
            if (_isClientLink) {
                return _calComponentsFor(p).some(c => _calReviewComponentActive(p, c, 'client'));
            }
            return true;
        }).slice().sort((a, b) => {
            const ad = String(a.scheduled_date || '').slice(0,10);
            const bd = String(b.scheduled_date || '').slice(0,10);
            if (ad && bd) return ad.localeCompare(bd);
            if (ad && !bd) return -1;
            if (!ad && bd) return 1;
            return Number(a.order_index || 0) - Number(b.order_index || 0);
        });
    }

    /* Cards that ARE at SMM approval and are held out of the queue only because
       no media has landed yet.

       The gate is correct and stays: _calReviewCardHtml is built around media,
       so admitting one would render a review card offering approve and tweak
       on something there is nothing to look at. What was wrong is that the
       queue then said "Nothing waiting on SMM approval right now" and the badge
       said zero -- an absence claim about work that exists and is waiting.

       Measured 2026-08-30 over 695 non-archived posts: 11 have a component at
       For SMM Approval and exactly 1 is hidden this way. That one is a live
       client's only awaiting card, scheduled for the next working day, so for
       that client the queue was 100% wrong and the badge agreed with it. */
    function _calReviewStrandedForMedia() {
        if (_calReviewMode() !== 'smm') return [];
        return (calState.posts || []).filter(p => {
            if (!p) return false;
            const s = _calNormStatus(p.status || '');
            const titlePending = _calIsYouTubeCard(p) && _calReviewComponentActive(p, 'title', 'smm');
            if ((s === 'Approved' || s === 'Scheduled' || s === 'Posted') && !titlePending) return false;
            if (_calHasMedia(p)) return false;
            return _calComponentsFor(p).some(c => _calReviewComponentActive(p, c, 'smm'));
        });
    }
    function _calReviewStrandedNoticeHtml() {
        const stranded = _calReviewStrandedForMedia();
        if (!stranded.length) return '';
        const n = stranded.length;
        const names = stranded.slice(0, 4).map(p => _calEsc(String(p.name || p.id || 'Untitled'))).join(', ');
        const more = n > 4 ? ' and ' + (n - 4) + ' more' : '';
        return '<div class="cal-review-stranded" data-cal-review-stranded="' + n + '">'
            + n + (n === 1 ? ' post is' : ' posts are') + ' waiting on SMM approval but cannot be reviewed here yet, '
            + 'because no video or thumbnail has landed on ' + (n === 1 ? 'it' : 'them') + ' — '
            + names + more + '.</div>';
    }
    function renderCalReview() {
        // The new review page (188/195) draws beside #calView when its switch is on for this client.
        if (svRsCalOn()) { svRsCalSync(); return '<div class="sv-rs-slot" hidden></div>'; }
        // The switch answer is still on its way and this browser last saw the client switched on: a loader, not the
        // old list (188, svRsCalPending).
        if (svRsCalPending()) return _calLoaderHtml();
        const items = _calReviewItems();
        /* The notice sits ABOVE the queue in both states. An empty queue with
           stranded work is the case that made this necessary; a non-empty queue
           that is quietly missing a card is the same lie, just harder to see. */
        const stranded = _calReviewStrandedNoticeHtml();
        if (!items.length) {
            const msg = _calReviewMode() === 'smm'
                ? (stranded
                    ? 'Nothing can be reviewed here right now.'
                    : 'Nothing waiting on SMM approval right now — posts with a linked video or thumbnail will appear here when they reach the SMM Approval stage.')
                : 'Nothing to review right now — every post is either fully approved or already posted.';
            return `<div class="cal-review-wrap">${stranded}<div class="cal-empty">${msg}</div></div>`;
        }
        const cards = items.map(p => _calReviewCardHtml(p)).join('');
        return `<div class="cal-review-wrap">${stranded}<div class="cal-review-list">${cards}</div></div>`;
    }

    /* Plain-English summary of what the client needs to do (or what's being
       worked on for them) on this card. Drives the line that sits right
       under the title on the review card so a glance at the collapsed card
       answers "why is this in my queue?" without expanding. Bolds the
       component names so they stand out from the connecting words. */
    function _calReviewPendingLabel(p) {
        const mode = _calReviewMode();
        const reviewStatus = _CAL_REVIEW_CFG[mode].reviewStatus;
        // In-flight (Tweaks Needed) work is no longer surfaced to the client —
        // the same gate as _calReviewComponentActive, so the label never
        // advertises a component the client's queue itself has hidden. (The SMM
        // surface and the internal client-mode preview still see in-flight work.)
        const showInFlight = mode !== 'client' || !_isClientLink;
        const awaiting = [], inFlight = [];
        for (const c of _calComponentsFor(p)) {
            const cs = _calNormStatus(p[c + '_status'] || '');
            if (cs === reviewStatus) awaiting.push(c);
            else if (showInFlight && cs === 'Tweaks Needed') inFlight.push(c);
        }
        if (!awaiting.length && !inFlight.length) return '';
        const human = (list) => {
            const labels = list.map(c => `<span class="kcard-pending-strong">${_calEsc(COMP_LABELS[c])}</span>`);
            if (labels.length === 1) return labels[0];
            if (labels.length === 2) return labels[0] + ' and ' + labels[1];
            return labels.slice(0, -1).join(', ') + ', and ' + labels.slice(-1)[0];
        };
        const parts = [];
        if (awaiting.length) {
            const verb = awaiting.length === 1 ? ' needs' : ' need';
            parts.push(human(awaiting) + verb + (mode === 'smm' ? ' SMM approval' : ' your review'));
        }
        if (inFlight.length) {
            parts.push(mode === 'smm'
                ? ('tweaks requested on ' + human(inFlight))
                : ("we're working on your tweaks for " + human(inFlight)));
        }
        // First letter uppercase on the final sentence.
        const joined = parts.join(' · ');
        return joined.charAt(0).toUpperCase() + joined.slice(1);
    }

    function _calReviewCardHtml(p) {
        const pid = p.id;
        const escId = _calEscAttr(pid);
        const expanded = _calReviewState.expanded.has(pid);
        const info = _calDeriveThumbInfo(p);
        const thumbHtml = info.url
            ? _calThumbImgTag(info, '_calOnMiniThumbError')
            : info.frame
                ? _calMiniLinkBadgeHtml('kcard-thumb-fallback', info.frameKind)
                : `<span class="kcard-thumb-fallback">${_calThumbIconSvg()}</span>`;
        // Weekday included so the client can place the date without doing
        // mental arithmetic ("Sat 21 Jun 2026" reads faster than "21 Jun 2026").
        const dateStr = p.scheduled_date
            ? _calParseIso(String(p.scheduled_date).slice(0, 10)).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })
            : 'Unscheduled';
        const pendingLabel = _calReviewPendingLabel(p);
        // Component pills are gated by Collaborative mode — when off, only
        // finished states render here, so the pill row will usually be empty
        // for cards in the review queue. The pending label above carries
        // the same information in plain English regardless.
        const compPills = _calStaffPhoneActive()
            ? _calClientCompPillsHtml(Object.assign({}, p, ..._calComponentsFor(p).filter(c => _calReviewState.saving[p.id + '|' + c]).map(c => ({ [c + '_status']: 'Saving…' }))))
            : _calClientCompPillsHtml(p);
        const body = expanded ? _calReviewCardBody(p) : '';
        return `<div class="kcard cal-review-card${expanded ? ' expanded' : ''}" data-cal-review-pid="${escId}">
            <div class="kcard-strip" onclick="_calReviewToggleCard('${escId}')">
                <div class="kcard-thumb">${thumbHtml}</div>
                <div class="kcard-main">
                    <div class="kcard-title">${_calEsc(p.name || 'Untitled')}</div>
                    ${pendingLabel ? `<div class="kcard-pending">${pendingLabel}</div>` : ''}
                    <div class="kcard-line1"><span class="kcard-date">${_calEsc(dateStr)}</span></div>
                    ${compPills ? `<div class="cal-review-sub-row">${compPills}</div>` : ''}
                </div>
                <div class="kcard-actions" onclick="event.stopPropagation();">
                    ${_thumbCompareSlotHtml('calendar', p, true, 'review')}
                    <button class="kcard-open-sheet" type="button" onclick="_calReviewOpenInSheet('${escId}')" title="Open this card in the Sheet" aria-label="Open in Sheet"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M2.5 6h11M6.5 6v7"/></svg>${_calPhoneClient() ? '<span>Open in Sheet</span>' : ''}</button>
                    <button class="kcard-expand-btn" type="button" onclick="_calReviewToggleCard('${escId}')" aria-label="${expanded ? 'Collapse' : 'Expand'}"${_calPhoneClient() ? ` aria-expanded="${expanded}"` : ''}><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5l4 4 4-4"/></svg>${_calPhoneClient() ? `<span>${expanded ? 'Close' : 'Review'}</span>` : ''}</button>
                </div>
            </div>
            ${body}
        </div>`;
    }

    function _calReviewCardBody(p) {
        const escId = _calEscAttr(p.id);
        // A real tokened client gets panels only for components exactly at
        // Client Approval. The internal non-client preview may also retain
        // Tweaks Needed, as defined by _calReviewComponentActive.
        const _reviewMode = _calReviewMode();
        // A part whose change request is on its way stays on screen, so the
        // note just sent is in sight, marked "Sending…", until it is confirmed.
        const noteSending = c => !!_calReviewSendingNote(p.id, c);
        const activeComps = (_reviewMode === 'smm')
            ? _calComponentsFor(p).filter(c => _calReviewComponentActive(p, c, 'smm') || noteSending(c) || (_calStaffPhoneActive() && _calReviewState.saving[p.id + '|' + c]))
            : (_isClientLink
                ? _calComponentsFor(p).filter(c => _calReviewComponentActive(p, c, 'client') || noteSending(c))
                : _calComponentsFor(p));
        if (!activeComps.length) {
            return `<div class="cal-review-body" onclick="event.stopPropagation();"><div class="cal-empty" style="grid-column: 1 / -1; padding: 12px;">Nothing left to review on this post.</div></div>`;
        }
        const panels = activeComps.map((comp, i) => {
            const html = _calReviewPanelHtml(p, comp);
            if (!_calPhoneClient()) return html;
            const key = p.id + '|' + comp;
            const status = _calReviewState.saving[key] ? 'Sending…'
                : _calReviewState.errors[key] ? 'Save failed · retry inside'
                : _calReviewState.drafts[key] ? 'Note not sent'
                : _calNormStatus(p[comp + '_status']) === 'Client Approval' ? 'Awaiting your approval'
                : _calNormStatus(p[comp + '_status']);
            return _calPhoneSectionHtml('review:' + p.id, comp, COMP_LABELS[comp], status, html, i === 0);
        }).join('');
        const cols = activeComps.length;
        // 4 components (a YouTube card with title review on) lay out 2×2 instead
        // of a cramped 4-wide row; 1–3 keep their natural column count.
        const gridCols = cols >= 4 ? 2 : cols;
        return `<div class="cal-review-body" style="grid-template-columns: repeat(${gridCols}, minmax(0, 1fr));" onclick="event.stopPropagation();">
            ${panels}
        </div>`;
    }

    /* Sweep item 87.7. Approve greys out the instant a reviewer types into the
       draft box, and until now nothing said why -- the button just went
       unclickable under the cursor. The gate itself is correct and stays: an
       unsent draft and an approval are two different intents, and letting
       both fire at once is the actual defect this prevents. What was missing
       is the sentence, and it has to travel to two places for each of the
       four review surfaces -- the initial render AND the three per-keystroke
       updaters that toggle `disabled` without repainting -- or the title
       lies the moment someone types.
       Deliberately narrow: this fires ONLY for the draft-caused disablement.
       A surface that renders Approve disabled for another reason (already
       mid-tweak-cycle, saving) keeps its title empty exactly as before --
       stating "there is an unsent note" when there is none would be a new
       false claim in the same spot this fix is removing one from. */
    const REVIEW_APPROVE_DRAFT_TITLE = 'You have an unsent note. Press Comment to send it, or clear it, then approve.';
    function _calReviewPanelHtml(p, comp) {
        // A note being sent stays in sight (its thread shows it as "Sending…");
        // only an approve or a status change takes the panel over.
        const _noteSending = _noteOutboxFor(p.id, e => e.comp === comp && (e.kind === 'review-comment' || e.kind === 'request')).length > 0;
        if (_calStaffPhoneActive() && _calReviewState.saving[p.id + '|' + comp] && !_noteSending) {
            return `<div class="cal-review-panel" data-comp="${_calEscAttr(comp)}" data-state="pending"><div class="cal-review-panel-title">${_calEsc(COMP_LABELS[comp])}</div><div class="pocket-staff-cal-saving" role="status">${svBusyHtml('Saving…')}</div></div>`;
        }
        const escId = _calEscAttr(p.id);
        const escComp = _calEscAttr(comp);
        const subStatus = _calNormStatus(p[comp + '_status'] || '');
        const state = subStatus === 'Approved' ? 'approved'
                    : (subStatus === 'Tweaks Needed' ? 'tweaks'
                    : (subStatus === 'Scheduled' ? 'scheduled'
                    : (subStatus === 'Posted' ? 'posted' : 'pending')));
        // _calCommentsForView hides Kasper-role tweaks from the client-link
        // surface; SMM/Kasper sessions still see everything.
        // This person's review notes not confirmed yet: marked in the thread,
        // and shown even when the thread lost them (a refresh mid-send).
        const outboxById = new Map(_noteOutboxFor(p.id, e => e.comp === comp && e.kind === 'review-comment').map(e => [e.id, e]));
        const viewComments = _calCommentsForView(p, comp) || [];
        let comments = viewComments.map(c => outboxById.has(c.id) ? Object.assign({}, c, { _outbox: _noteOutboxAsComment(outboxById.get(c.id))._outbox, _outboxError: outboxById.get(c.id).error || '' }) : c)
            .concat([...outboxById.values()].filter(e => !viewComments.some(c => c && c.id === e.id)).map(_noteOutboxAsComment));
        // A change request on its way: its note, marked "Sending…" (or "Not
        // sent yet" while the client send queue holds it for a re-send).
        const reqNote = _calReviewSendingNote(p.id, comp);
        if (reqNote) {
            const mark = { _outbox: reqNote.held ? 'failed' : 'sending', _outboxError: reqNote.held ? 'Waiting for the connection.' : '', _outboxRequest: true };
            const found = !!reqNote.id && comments.some(c => c && c.id === reqNote.id);
            comments = found
                ? comments.map(c => c && c.id === reqNote.id ? Object.assign({}, c, mark) : c)
                : comments.concat([Object.assign({ id: reqNote.id || 'sending-' + comp, parent_id: null, author: reqNote.author, role: reqNote.role,
                    body: reqNote.body, created_at: reqNote.created_at, is_tweak: true, done: false }, mark)]);
        }
        // The per-panel Linear icon was visual noise — dropped. Linear linking
        // still lives on the Sheet/organizer cards for the SMM.
        const linkBadge = '';
        // Approved (and Posted) collapse to a single, minimal line — no
        // preview / no compose / no thread-by-default. Approving is
        // terminal from the client's seat; surfacing it as a full panel
        // wastes real estate. A click toggles back to the full view if
        // they want to see past comments or the asset link again.
        if (state === 'approved' || state === 'posted' || state === 'scheduled') {
            const checkIco = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8.5L6.5 12L13 4"/></svg>`;
            const wordAction = state === 'posted' ? 'Posted' : (state === 'scheduled' ? 'Scheduled' : 'Approved');
            const sub = state === 'posted' ? 'Live on the channel'
                      : (state === 'scheduled' ? 'Queued — going out on its scheduled date'
                      : 'Locked in — ready to schedule');
            return `<div class="cal-review-panel cal-review-panel-mini" data-comp="${escComp}" data-state="${state}">
                <span class="cal-review-mini-icon">${checkIco}</span>
                <span class="cal-review-mini-label">${_calEsc(COMP_LABELS[comp])} ${wordAction.toLowerCase()}</span>
                <span class="cal-review-mini-sub">${_calEsc(sub)}</span>
            </div>`;
        }
        const previewHtml = _calReviewComponentPreview(p, comp);
        const draftKey = p.id + '|' + comp;
        const draft = _calReviewState.drafts[draftKey] || '';
        const saving = !!_calReviewState.saving[draftKey];
        const err = _calReviewState.errors[draftKey] || '';
        // The reviewer can act only while the component is sitting at their
        // surface's approval status (or has been sent back for tweaks). On the
        // SMM Review tab that's "For SMM Approval"; on the client link it's
        // "Client Approval". A plain SMM Sheet view (no review surface) can
        // always act, matching the legacy behaviour.
        const _reviewMode = _calReviewMode();
        const _reviewStatus = _CAL_REVIEW_CFG[_reviewMode].reviewStatus;
        const canActClient = (_reviewMode === 'smm' || _isClientLink)
            ? (subStatus === _reviewStatus || subStatus === 'Tweaks Needed')
            : true;
        const hasDraft = !!draft.trim();
        const inTweaks = subStatus === 'Tweaks Needed';
        // Approve button is ALWAYS rendered when the client could in
        // principle approve (not yet Approved/Posted) — but it stays
        // disabled while they're drafting a tweak or while a tweak is
        // already pending the editor's revision, so the affordance is
        // visible without being misclickable. Removing it on draft was
        // jarring: the button vanished, then came back when she cleared
        // the textarea, which broke muscle memory.
        const showApprove = canActClient && subStatus !== 'Approved' && subStatus !== 'Scheduled' && subStatus !== 'Posted';
        const approveEnabled = showApprove && !saving && !hasDraft && !inTweaks;
        const tweakEnabled = canActClient && !saving && hasDraft;
        // Friendlier status copy: clients see "Awaiting your approval"
        // instead of the raw "Client Approval" enum, which reads like a
        // workflow term, not a prompt for action.
        const stateLabel = inTweaks ? 'Changes requested'
                         : (subStatus === 'Client Approval' ? 'Awaiting your approval'
                         : (subStatus === 'For SMM Approval' ? 'Awaiting SMM approval'
                         : subStatus));
        // Reword the compose placeholder once a tweak is already pending —
        // emphasises that the request was received and invites follow-ups.
        const placeholder = inTweaks
            ? 'The team is working on it. Anything else to add?'
            : 'Add a note or request a change…';
        const checkIco = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8.5L6.5 12L13 4"/></svg>`;
        const sendIco  = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5L13.5 8L9 12.5"/></svg>`;
        const resolvedIco = `<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5L5 9.5L10 3.5"/></svg>`;
        const threadHtml = comments && comments.length
            ? comments.map(c => {
                const author = _calNoteAuthorName(c, c.role === 'client' ? 'Client' : c.role === 'kasper' ? 'Kasper' : 'SMM');
                const isResolved = !!c.done;
                const resolvedBadge = isResolved
                    ? `<span class="cal-review-resolved-pill" title="Done${c.done_by ? ' by ' + _calEsc(c.done_by) : ''}${c.done_at ? ' · ' + _calEsc(_calFmtCommentTime(c.done_at)) : ''}">${resolvedIco}Resolved</span>`
                    : '';
                return `<div class="cal-review-comment cal-cm-${c.role || 'smm'}${c.parent_id ? ' is-reply' : ''}${isResolved ? ' is-resolved' : ''}${c._outbox ? ' is-outbox is-outbox-' + c._outbox : ''}">
                    <div class="cal-review-comment-head">
                        <strong>${_calEsc(author)}</strong>
                        <span class="cal-review-comment-time">${_calEsc(_calFmtCommentTime(c.created_at))}</span>
                        ${resolvedBadge}
                    </div>
                    <div class="cal-review-comment-body">${_calEsc(c.body || '')}</div>
                    ${_noteOutboxStatusHtml(c)}
                </div>`;
            }).join('')
            : `<div class="cal-review-comment-empty">No comments yet.</div>`;
        // The "awaiting approval" pill is just noise on every review surface —
        // the whole tab is the approval queue. Only keep the pill when it's
        // carrying real signal ("Changes requested" for a tweaks state).
        const statusPill = !inTweaks
            ? ''
            : `<span class="cal-review-panel-status">${_calEsc(stateLabel)}</span>`;
        // SMM only: has Kasper seen this yet? A brand-new component gets a
        // "First review" flag and the approve default points at Kasper; once
        // Kasper has touched it, the default flips to the client. The smart
        // default is the prominent button; the other route is the small
        // attached segment, so it's a one-click choice either way.
        const _seenByKasper = _reviewMode === 'smm' && _calHasBeenToKasper(p, comp);
        const firstReviewBadge = (_reviewMode === 'smm' && showApprove && !_seenByKasper)
            ? `<span class="cal-review-firstpass" title="Not sent to Kasper yet">First review</span>`
            : '';
        // Tells the SMM this component was pre-cleared by Kasper when he asked
        // for the tweak — verify the edit was applied, then send to the client
        // (no Kasper re-review needed). SMM surface only.
        const aatBadge = (_reviewMode === 'smm' && _calShowApprovedAfterTweaks(p, comp))
            ? `<span class="cal-review-aat-pill" title="Kasper already approved this for the client. No more tweaks."><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg></span>`
            : '';
        let approveControl = '';
        if (showApprove) {
            if (_reviewMode === 'smm') {
                const primary = _seenByKasper ? 'client' : 'kasper';
                const alt = _seenByKasper ? 'kasper' : 'client';
                const lbl = d => d === 'kasper' ? 'Kasper' : 'Client';
                const dis = approveEnabled ? '' : 'disabled';
                // data-idle-title is the title this control shows WITHOUT a
                // draft in flight -- '' for the main segment, the routing
                // hint for the alt segment. The updater restores exactly this
                // on every keystroke, rather than guessing or blanking it.
                const mainIdle = '';
                const altIdle = 'Approve and send to ' + lbl(alt) + ' instead';
                approveControl = `<div class="cal-review-approve-split">
                    <button type="button" class="cal-review-approve-btn cal-review-approve-main" ${dis} data-idle-title="${_calEscAttr(mainIdle)}" title="${hasDraft ? _calEscAttr(REVIEW_APPROVE_DRAFT_TITLE) : _calEscAttr(mainIdle)}" onclick="_calReviewApprove('${escId}','${escComp}','${primary}')">${checkIco}<span class="cal-ap-verb">Approve</span><span class="cal-ap-route">${lbl(primary)}</span></button>
                    <button type="button" class="cal-review-approve-alt" ${dis} data-idle-title="${_calEscAttr(altIdle)}" title="${hasDraft ? _calEscAttr(REVIEW_APPROVE_DRAFT_TITLE) : _calEscAttr(altIdle)}" onclick="_calReviewApprove('${escId}','${escComp}','${alt}')">${lbl(alt)}</button>
                </div>`;
            } else {
                approveControl = `<button type="button" class="cal-review-approve-btn" ${approveEnabled ? '' : 'disabled'} data-idle-title="" title="${hasDraft ? _calEscAttr(REVIEW_APPROVE_DRAFT_TITLE) : ''}" onclick="_calReviewApprove('${escId}','${escComp}')">${checkIco}Approve ${_calEsc(COMP_LABELS[comp].toLowerCase())}</button>`;
            }
        }
        return `<div class="cal-review-panel" data-comp="${escComp}" data-state="${state}">
            <div class="cal-review-panel-head">
                <span class="cal-review-panel-title">${_calEsc(COMP_LABELS[comp])}</span>
                ${firstReviewBadge}
                ${aatBadge}
                <div class="cal-review-panel-head-right">${statusPill}${linkBadge}</div>
            </div>
            <div class="cal-review-panel-preview">${previewHtml}</div>
            ${approveControl}
            <div class="cal-review-panel-compose">
                <textarea class="cal-review-textarea" placeholder="${_calEscAttr(placeholder)}" data-cal-review-draft="${escId}|${escComp}" oninput="_calReviewOnDraftInput(this,'${escId}','${escComp}')" ${canActClient ? '' : 'readonly'}>${_calEsc(draft)}</textarea>
                <div class="cal-review-tweak-actions">
                    <button type="button" class="cal-review-comment-btn" ${tweakEnabled ? '' : 'disabled'} onclick="_calReviewComment('${escId}','${escComp}')" title="Ask or comment. This doesn’t change the status."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4.5h11v7h-6l-3 2.5v-2.5h-2z"/></svg>Comment</button>
                    <button type="button" class="cal-review-tweak-btn" ${tweakEnabled ? '' : 'disabled'} onclick="_calReviewRequestTweak('${escId}','${escComp}')">${sendIco}Request change</button>
                </div>
            </div>
            ${err ? `<div class="cal-review-panel-err">${_calEsc(err)}</div>` : ''}
            <div class="cal-review-thread">${threadHtml}</div>
        </div>`;
    }

    function _calReviewComponentPreview(p, comp) {
        if (comp === 'video') {
            const url = String(p.asset_url || '').trim();
            if (!url) return `<div class="cal-review-preview-empty">No video yet.</div>`;
            // With the viewer switched on for this card's client (frame_viewer_clients) the preview opens the card's
            // Notes view with the player, and a small "Watch in Frame.io" link sits under it; staff and client link
            // alike. Switched off, or not a Frame.io link: the tile opens the link exactly as it always did.
            const thumbUrl = _calDeriveThumb(p);
            const tileAttrs = svFrameTileAttrs(url, p.client, p.id, thumbUrl);
            const frameLink = svFrameIoLinkHtml(url, p.client);
            const label = svFrameTileLabelHtml(url);
            const withWatch = (tile) => (frameLink ? `<div class="fv-review-video">${tile}${frameLink}</div>` : tile);
            // Use the same thumbnail image as the graphic panel, blurred,
            // with "Open video" overlaid — keeps the video column the same
            // visual weight as the thumbnail column so the Approve buttons
            // line up across all three panels instead of the video row
            // collapsing to a tiny black button.
            if (!thumbUrl) {
                // No image to blur — fall back to a styled stand-in tile
                // so the column still has the same height.
                return withWatch(`<a class="cal-review-video-tile cal-review-video-tile-blank" href="${_calEscAttr(url)}" target="_blank" rel="noopener" aria-label="Open video"${tileAttrs}><span class="cal-review-video-overlay"><span class="cal-review-video-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>${label}</span></a>`);
            }
            return withWatch(`<a class="cal-review-video-tile" href="${_calEscAttr(url)}" target="_blank" rel="noopener" aria-label="Open video"${tileAttrs}><img class="cal-review-video-bg" src="${_calEscAttr(thumbUrl)}" alt="" onerror="this.style.display='none'"><span class="cal-review-video-overlay"><span class="cal-review-video-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>${label}</span></a>`);
        }
        if (comp === 'graphic') {
            const raw = String(p.thumbnail_url || '').trim();
            if (!raw) return `<div class="cal-review-preview-empty">No thumbnail yet.</div>`;
            const info = _calDeriveThumbInfo(p);
            const imgUrl = info.url;
            // Frame.io share/review links (no public image, block embedding) and
            // folder-of-images links (a Story's frames — no single image to show)
            // can't render as an <img> the way a Drive file link can. Surface the
            // same branded click-to-open card used on the calendar thumbnails so
            // the client can open it in a new tab.
            if (!imgUrl) {
                const linkKind = _calIsFrameLink(raw) ? 'frame' : (_calIsFolderLink(raw) ? 'folder' : '');
                if (linkKind) {
                    const openUrl = linkKind === 'folder' ? _calFolderOpenUrl(raw) : _calFrameOpenUrl(raw);
                    return `<div class="cal-review-preview-thumb">${_calReviewFrameHtml(openUrl, undefined, linkKind)}</div>`;
                }
            }
            // Click opens a full-screen lightbox of the thumbnail rather
            // than the Drive sharing URL — the client shouldn't be jumping
            // into Drive just to see a bigger version.
            const escPid = _calEscAttr(p.id);
            const imgInfo = imgUrl ? info : { url: raw, isDrive: /drive\.google\.com|docs\.google\.com/i.test(raw) };
            return `<div class="cal-review-preview-thumb"><button type="button" class="cal-review-preview-thumb-btn" onclick="_calOpenThumbLightbox('${escPid}')" aria-label="Open thumbnail full screen">${_calThumbImgTag(imgInfo, '_calOnReviewThumbError')}</button></div>`;
        }
        if (comp === 'title') {
            const t = String(p.name || '').trim();
            if (!t) return `<div class="cal-review-preview-empty">No title yet.</div>`;
            return `<div class="cal-review-preview-caption cal-review-preview-title">${_calEsc(t)}</div>`;
        }
        const cap = String(p.caption || '').trim();
        const alt = String(p.caption_alt || '').trim();
        if (!cap && !alt) return `<div class="cal-review-preview-empty">No caption yet.</div>`;
        if (!alt) return `<div class="cal-review-preview-caption">${_calEsc(cap)}</div>`;
        // Two captions — both belong to the same caption component, so one
        // Approve / Request change covers both. Each gets its own boxed,
        // icon-labelled card so the split is unmissable.
        return `<div class="cal-review-preview-captions">
            ${_calReviewCapCardHtml('main', p, cap)}
            ${_calReviewCapCardHtml('alt', p, alt)}
        </div>`;
    }

    function _calWireReviewExpand(/* root */) { /* no-op — handlers are inline */ }

    function _calReviewToggleCard(pid) {
        if (_calReviewState.expanded.has(pid)) _calReviewState.expanded.delete(pid);
        else {
            _calReviewState.expanded.add(pid);
        }
        _calReviewRepaintCard(pid);
    }

    function _calReviewRepaintCard(pid) {
        if (svRsCalOn()) { svRsCalSync(); return; }   // the new review page draws it (188/195)
        const sel = (window.CSS && CSS.escape) ? CSS.escape(pid) : pid;
        const el = document.querySelector('.cal-review-card[data-cal-review-pid="' + sel + '"]');
        const post = calState.posts.find(p => p.id === pid);
        if (!el || !post) return;
        const tmp = document.createElement('div');
        tmp.innerHTML = _calReviewCardHtml(post);
        if (tmp.firstElementChild) {
            _kcardReuseThumbInto(el, tmp.firstElementChild);   // keep the decoded thumbnail — no blink on approve/request-change
            el.replaceWith(tmp.firstElementChild);
        }
        _calUpdateReviewBadge();
    }

    /* Drop a review card out of the queue cleanly — used when the client's
       last outstanding action on a post is done, so the card has no reason
       to linger. Fades/collapses the card out, then removes it; if it was
       the last card in the list, re-renders the body so the empty state
       shows in its place. No intermediate "nothing left to review" stub. */
    function _calReviewRemoveCard(pid) {
        // The new review page (188/195) has no old card to remove: it draws the change itself. Without this an
        // approval that cleared the card's last part left the new page on "Saving" (session Curtain Nine).
        if (svRsCalOn()) { svRsCalSync(); _calUpdateReviewBadge(); return; }
        const sel = (window.CSS && CSS.escape) ? CSS.escape(pid) : pid;
        const el = document.querySelector('.cal-review-card[data-cal-review-pid="' + sel + '"]');
        if (!el) return;
        const list = el.closest('.cal-review-list');
        const finish = () => {
            el.remove();
            // If that was the final card, swap in the empty state rather than
            // leaving the list blank.
            if (!list || !list.querySelector('.cal-review-card')) {
                _calRenderBody({ preserveScroll: true });
            }
            _calUpdateReviewBadge();
        };
        // Collapse the card's height + fade it so the removal reads as
        // intentional. Falls back to an instant remove if the element can't
        // be measured (e.g. already detached).
        const h = el.offsetHeight;
        if (!h) { finish(); return; }
        el.style.overflow = 'hidden';
        el.style.height = h + 'px';
        el.style.transition = 'height .2s ease, opacity .15s ease, margin .2s ease';
        // Force a reflow so the starting height is committed before we
        // transition to zero.
        void el.offsetHeight;
        el.style.opacity = '0';
        el.style.height = '0px';
        el.style.marginTop = '0px';
        el.style.marginBottom = '0px';
        let done = false;
        const onEnd = () => { if (done) return; done = true; finish(); };
        el.addEventListener('transitionend', onEnd, { once: true });
        // Safety net in case transitionend doesn't fire.
        setTimeout(onEnd, 280);
    }

    function _calReviewOnDraftInput(ta, pid, comp) {
        const key = pid + '|' + comp;
        _calReviewState.drafts[key] = ta.value;
        delete _calReviewState.draftActionIds[key];
        const nowHasDraft = !!ta.value.trim();
        const phoneSummary = ta.closest('.pocket-cal-section')?.querySelector('.pocket-cal-section-status');
        if (phoneSummary) phoneSummary.textContent = _calReviewState.saving[key] ? 'Sending…' : _calReviewState.errors[key] ? 'Save failed · retry inside' : nowHasDraft ? 'Note not sent' : 'Awaiting your approval';
        // Don't repaint on every keystroke — just toggle the two action
        // buttons in place. Approve is gated off while a draft is in
        // flight (it's visible but unclickable), Request tweaks lights
        // up the instant there's text to send.
        const card = ta.closest('.cal-review-card');
        if (!card) return;
        const panel = card.querySelector('.cal-review-panel[data-comp="' + comp + '"]');
        if (!panel) return;
        panel.querySelectorAll('.cal-review-tweak-btn, .cal-review-comment-btn').forEach(b => {
            b.disabled = !nowHasDraft || !!_calReviewState.saving[key];
        });
        // Disable every approve control (the plain button, or both segments of
        // the SMM split button) while a tweak is being drafted.
        panel.querySelectorAll('.cal-review-approve-btn, .cal-review-approve-alt').forEach(b => {
            b.disabled = nowHasDraft || !!_calReviewState.saving[key];
            // data-idle-title is what render put there for the NON-draft
            // state (the alt segment routing hint, or empty for the others),
            // read back rather than reconstructed -- so restoring it can
            // never drift from what the render function actually said, and
            // clearing the draft returns the exact title that was there
            // before it existed.
            b.title = nowHasDraft ? REVIEW_APPROVE_DRAFT_TITLE : (b.getAttribute('data-idle-title') || '');
        });
    }

    /* Review-tab "Approve to Kasper / to client". The SMM's pick of Kasper or the client IS the answer: when the part
       still carries open change-requests they are marked done as part of the same send (sending a new version answers
       them), with no second pop-up (Settle, 2026-10-18; it used to ask "Tweaks resolved, where to next?" right after the
       SMM had already chosen where). The writes are exactly the ones the old pop-up made with every request ticked: the
       same canonical or card-JSON resolve, then the same approve. A toast says how many were marked done and offers
       Undo, which reopens exactly those. With NO open change-requests it routes directly, exactly as before. The client
       surface never resolves tweaks (_calCanResolveComment is SMM-only). */
    function _calReviewApprove(pid, comp, dest) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        if (_calReviewMode() === 'smm' && _calCanResolveComment()) {
            const open = _calOpenTweaksForComp(post, comp);
            if (open.length) {
                const key = pid + '|' + comp;
                if (_calReviewState.saving[key]) return;
                const pickDest = dest === 'client' ? 'client' : 'kasper';
                const ids = open.map(t => t.id);
                /* Refuse BEFORE anything is mutated. _calReviewApplyApprove
                   runs the same check, but by then _calResolveTweaksDone
                   has already marked the requests done and staged
                   them -- so a refused approve would leave the thread
                   resolved and the status where it was, which is the one
                   outcome nobody asked for. */
                const _blocked = _calReviewBlockReason(post, comp, _calSmmApproveTo(pickDest));
                if (_blocked) {
                    showNotify('Nothing to review yet', _blocked
                        + ' Nothing was changed — the change requests are still open.');
                    return;
                }
                const resolvedBefore = {
                    video_comments: post.video_comments,
                    graphic_comments: post.graphic_comments,
                    caption_comments: post.caption_comments,
                    title_comments: post.title_comments
                };
                // The toast waits for the server's answer, so it never says "done" for a send that was refused.
                const told = () => _calTellTweaksDone(pid, comp, ids);
                /* OPEN_REPAIRS: Mender. On a card whose notes are read from
                   the canonical thread, marking done here used to flip only
                   the legacy copy, so the Notes panel showed the requests
                   open again on the next read. Resolve them canonically
                   first, exactly as _calResolveLastTweak does, and stop if
                   any resolve is refused. */
                if (_prodCanonicalCommentGate(post, comp).linked) {
                    /* The old pop-up kept a second press out while the requests were being resolved; with no pop-up the
                       "saving" flag is not up until the resolves are done, so a double press would resolve twice and
                       send twice (two saves, two toasts). Hold the part until the approve has taken over. */
                    const closing = _calReviewState.closing || (_calReviewState.closing = {});
                    if (closing[key]) return;
                    closing[key] = true;
                    _calReviewResolveCanonical(post, comp, ids, pickDest).then(ok => {
                        if (!ok) return;
                        _calReviewApplyApprove(pid, comp, pickDest, resolvedBefore, told);
                    }).finally(() => { delete closing[key]; });
                    return;
                }
                if (_calCanonicalCrosswalkPending(post, comp)) return;
                _calResolveTweaksDone(post, comp, ids);
                _calReviewApplyApprove(pid, comp, pickDest, resolvedBefore, told);
                return;
            }
        }
        _calReviewApplyApprove(pid, comp, dest);
    }
    /* The toast after a send that marked change-requests done: "N change requests marked done" with Undo for a few
       seconds. Undo reopens exactly those requests (only the ones still done), the same way Notes' Reopen does. */
    function _calTellTweaksDone(pid, comp, ids) {
        const n = ids.length;
        showToast(n + ' change request' + (n === 1 ? '' : 's') + ' marked done', {
            actionLabel: 'Undo',
            duration: 6000,
            onAction: () => { _calReopenTweaks(pid, comp, ids); }
        });
    }
    async function _calReopenTweaks(pid, comp, ids) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post || !Array.isArray(ids) || !ids.length) return false;
        const want = new Set(ids);
        const list = _calCommentsFor(post, comp);
        const done = (Array.isArray(list) ? list : []).filter(c => c && !c.parent_id && want.has(c.id) && c.done && !c.deleted);
        if (!done.length) return false;
        if (_prodCanonicalCommentGate(post, comp).linked) {
            for (const comment of done) {
                const receipt = await _writeUiCommitCardCommentLifecycle('calendar', post, comp, comment, 'unresolve');
                if (!receipt) return false;
            }
            await _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
        } else {
            if (_calCanonicalCrosswalkPending(post, comp)) return false;
            const at = new Date().toISOString();
            const all = comp === 'video'
                ? (Array.isArray(post.comments) ? post.comments.slice() : _calLoadComments(post))
                : _calCommentsFor(post, comp).slice();
            for (const c of all) {
                if (c && !c.parent_id && want.has(c.id) && c.done) { c.done = false; c.done_at = ''; c.done_by = ''; c.updated_at = at; }
            }
            _calSetCommentsFor(post, comp, all);
            if (comp === 'video') post.comments = all;
            _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, { [comp + '_tweaks']: _calStringifyComments(all) });
            _calWatchNoteSave(pid);
        }
        _calRefreshCommentsBtn(pid);
        _calUpdateCardStatusDisplay(pid);
        _calReviewRepaintCard(pid);
        if (_calOpenCommentsPid === pid) { _calCaptureModalDrafts(); _calRenderCommentsModal({ keepFocus: true }); }
        return true;
    }
    async function _calReviewResolveCanonical(post, comp, ids, dest) {
        for (const id of (Array.isArray(ids) ? ids : [])) {
            const comment = _calCommentsFor(post, comp).find(row => row && row.id === id && !row.parent_id);
            if (!comment || comment.done || comment.deleted) continue;
            const receipt = await _writeUiCommitCardCommentLifecycle(
                'calendar', post, comp, comment, 'resolve', undefined, { resolveDestination: dest }
            );
            if (!receipt) return false;
        }
        await _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
        return true;
    }
    /* True (and tells the user) while the card's canonical link is still being
       looked up. A done/delete in that window used to fall through to a
       legacy-only write that the canonical thread never saw. Staff only:
       a client is never canonical on the Calendar. */
    function _calCanonicalCrosswalkPending(post, comp) {
        if (_isClientLink || !post || !_prodCrosswalkInFlight(post)) return false;
        if (!_writeUiNativeId(post, comp)) return false;
        showNotify('Notes are still loading', 'Nothing was changed. Try again in a moment.');
        return true;
    }
    // onSaved (optional): called once the server has confirmed the save, never after a refused one.
    function _calReviewApplyApprove(pid, comp, dest, resolvedBefore, onSaved) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const key = pid + '|' + comp;
        if (_calReviewState.saving[key]) return;
        const mode = _calReviewMode();
        const subKey = comp + '_status';
        // A client can only approve a component sitting on THEIR review surface
        // (Client Approval) or one they sent back for tweaks — never one still in
        // internal review (For SMM / Kasper Approval). Without this, a direct
        // _calReviewApprove call lets a client force a component straight to
        // Approved, skipping Kasper + the SMM's routing. The UI already hides the
        // button off-surface; this guards the handler. (SMM keeps its full control.)
        if (_isClientLink) {
            const cur = String(post[subKey] || '').trim().toLowerCase();
            if (cur !== 'client approval' && cur !== 'tweaks needed') return;
        }
        const prev = Object.assign({
            [subKey]: post[subKey],
            status: post.status,
            [`client_${comp}_approved_at`]: post[`client_${comp}_approved_at`],
            kasper_seen: post.kasper_seen,
        }, resolvedBefore || {});
        // Client approval is terminal (→ Approved). SMM approval routes the
        // component to the next reviewer the SMM picked: Kasper (default for a
        // brand-new post) or straight to the client. Only a client approval
        // stamps the client_<comp>_approved_at sign-off timestamp.
        let approveTo = _CAL_REVIEW_CFG[mode].approveTo;
        if (mode === 'smm') approveTo = _calSmmApproveTo(dest);
        // Routing to Kasper means this component has now appeared in Kasper
        // review — record it on the post's cross-device kasper_seen column so
        // every device (each SMM, Kasper) treats it as no-longer-brand-new.
        /* Approving a component ONTO someone else is still sending it for
           review, so it obeys the same rule. Guarded before the kasper_seen
           stamp, or the card would be marked seen for a review that never
           happened. */
        const _reviewBlocked = _calReviewBlockReason(post, comp, approveTo);
        if (_reviewBlocked) {
            showNotify('Nothing to review yet', _reviewBlocked);
            return false;
        }
        let _kasperSeenCsv = null;
        if (approveTo === 'Kasper Approval') _kasperSeenCsv = _calRecordKasperSeenOnPost(post, comp);
        post[subKey] = approveTo;
        _calV2Log('REVIEW approve →', pid, '| comp:', comp, '| →', approveTo, '| mode:', mode, 'dest:', dest);
        if (mode === 'client') post[`client_${comp}_approved_at`] = new Date().toISOString();
        post.status = computeOverallStatus(post);
        // Stamp updated_at locally so a background poll racing this write
        // can't fetch the still-stale row from the sheet and clobber the
        // optimistic state.
        post.updated_at = new Date().toISOString();
        _calReviewState.saving[key] = true;
        _calReviewState.errors[key] = '';
        delete _calReviewState.errorActionIds[key];
        // Stamp the local-mutation clock so the post-load Linear reconcile
        // doesn't immediately revert this change if Linear is still showing
        // the stale state.
        _calMarkLocalStatus(pid, comp);
        // If this approval was the LAST piece owed on this card (no component
        // left in play for this review surface), the card drops out of the
        // queue entirely — so remove it outright rather than first repainting
        // it to the collapsed "nothing left to review" mini-stub and waiting
        // on a delayed re-render. That collapse-then-vanish transition read as
        // a glitch. Otherwise just repaint the card so the approved component
        // lands as an instant mini panel.
        const clearsCard = (mode === 'smm' || _isClientLink)
            && !_calComponentsFor(post).some(c => _calReviewComponentActive(post, c, mode));
        // Keep the card mounted until the gateway acknowledges the status.
        // A failed native write must leave its retry surface visible.
        _calReviewRepaintCard(pid);
        // Fire-and-forget the save. The pending-edits map carries the
        // change, and _calFlushCardSave also handles the Linear push. We
        // surface errors via a repaint only if the network actually fails.
        _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, {
            [subKey]: post[subKey],
            status: post.status,
        }, mode === 'client' ? { [`client_${comp}_approved_at`]: post[`client_${comp}_approved_at`] } : {},
        _kasperSeenCsv != null ? { kasper_seen: _kasperSeenCsv } : {});
        // Client link: held in this browser until the server confirms (185).
        // Only the status and approval fields ride in the entry, with the
        // server status the client saw, so a re-send can check nothing moved.
        if (mode === 'client') _calCrqBegin('approve', pid, comp, {
            edits: { [subKey]: post[subKey], status: post.status,
                [`client_${comp}_approved_at`]: post[`client_${comp}_approved_at`] },
            prev: Object.assign({}, prev),
            serverStatus: { [comp]: prev[subKey] }
        });
        Promise.resolve(_calFlushCardSave(pid)).catch(e => {
            const current = calState.posts.find(p => p.id === pid) || post;
            current._saveError = _writeUiFailureSentence(e);
        }).then(() => {
            _calReviewState.saving[key] = false;
            const current = calState.posts.find(p => p.id === pid) || post;
            if (current._saveError) {
                if (mode === 'client' && _calCrqFailed(pid, comp, current._saveError)) return;
                if (!current._writeUiRetrySourceAt) Object.assign(current, prev);
                _calReviewState.errors[key] = current._saveError || 'Save failed';
                // A full render, not a repaint: the failed save's own render
                // can have dropped this card from the list already, and a
                // repaint only replaces a card that is still on screen.
                _calRenderBody({ preserveScroll: true });
                return;
            }
            if (mode === 'client') _calCrqDone(pid, comp);
            if (clearsCard) _calReviewRemoveCard(pid);
            else _calReviewRepaintCard(pid);
            if (typeof onSaved === 'function') onSaved();
        });
    }

    /* Leave a plain comment from a review panel — a conversation message that
       does NOT change the component's status and does NOT ping the editor.
       Mirrors _calReviewRequestTweak but without the Tweaks-Needed flip / Linear
       push. Client comments are client-visible; SMM comments default to internal
       (team-only) since the panel has no audience toggle. */
    // `parentId`: the client review page's Reply (195, polish): the note goes under that thread, on the card and, on a
    // linked part, through the same gateway comment add (which already carries a parent and checks it server-side).
    function _calReviewComment(pid, comp, parentId) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const key = pid + '|' + comp;
        const body = String(_calReviewState.drafts[key] || '').trim();
        if (!body || _calReviewState.saving[key]) return;
        const role = _calCommentRole();
        const _now = new Date().toISOString();
        // The note goes in the outbox first (its words survive a failed send
        // and a refresh), then in the thread, where it shows as "Sending…".
        const entry = _noteOutboxPut({
            id: _calMintCommentId(), surface: 'review', kind: 'review-comment', pid, comp, parent_id: parentId ? String(parentId) : null, body,
            author: _calCurrentAuthor(), author_member_id: _calCurrentAuthorId() || undefined, role,
            audience: (role === 'client') ? 'client' : 'internal', is_tweak: false,
            created_at: _now, at: Date.now(), state: 'sending'
        });
        _calReviewAddOutboxComment(post, entry);
        post.updated_at = _now;                 // no status change — it's a comment
        _calV2Log('REVIEW comment →', pid, '| comp:', comp, '| role:', _calCommentRole());
        _calReviewState.drafts[key] = '';
        _calReviewState.saving[key] = true;
        _calReviewState.errors[key] = '';
        delete _calReviewState.draftActionIds[key];
        delete _calReviewState.errorActionIds[key];
        _noteOutboxSend(entry.id).then(() => {
            _calReviewState.saving[key] = false;
            _calReviewRepaintCard(pid);
        });
    }
    /* The change request this part is sending, or null. Lives only while the
       part is saving; a held client request (no connection) says so. */
    function _calReviewSendingNote(pid, comp) {
        const key = pid + '|' + comp;
        const note = _calReviewState.sendingNotes[key];
        if (!note) return null;
        if (!_calReviewState.saving[key]) { delete _calReviewState.sendingNotes[key]; return null; }
        return Object.assign({}, note, { held: _isClientLink && _calCrqHeld(pid, comp) });
    }
    /* Put an outbox review comment in the card's local thread (once). */
    function _calReviewAddOutboxComment(post, entry) {
        const list = _calCommentsFor(post, entry.comp).slice();
        if (list.some(c => c && c.id === entry.id)) return list;
        list.push({
            id: entry.id,
            parent_id: entry.parent_id || null,
            author: entry.author,
            ...(entry.author_member_id ? { author_member_id: entry.author_member_id } : {}),
            role: entry.role,
            is_tweak: false,
            audience: entry.audience,
            body: entry.body,
            created_at: entry.created_at,
            updated_at: entry.created_at,
            done: false, done_at: '', done_by: '',
        });
        _calSetCommentsFor(post, entry.comp, list);
        if (entry.comp === 'video') post.comments = list;
        return list;
    }
    /* One try at saving a review comment: the card row is its only home (no
       work item gets it). The card save never rejects; it marks the card. */
    async function _calReviewCommentSend(entry) {
        const pid = entry.pid;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) throw new Error('This card is not loaded.');
        const list = _calReviewAddOutboxComment(post, entry);
        _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, {
            [entry.comp + '_tweaks']: _calStringifyComments(list),
        });
        await _calFlushCardSave(pid);
        const current = calState.posts.find(p => p.id === pid);
        // "Not saved yet: ..." is the chip the engine puts BACK after a save
        // that worked, for an older status, date or order change still
        // waiting on this card (_calRestoreFailedIntentChip). It is not this
        // comment failing, and saying so would invite a duplicate.
        if (current && current._saveError && !/^Not saved yet: /.test(String(current._saveError))) {
            throw new Error(String(current._saveError));
        }
        return true;
    }
    function _calReviewRequestTweak(pid, comp) {
        const initialPost = calState.posts.find(p => p.id === pid);
        if (!initialPost) return;
        const key = pid + '|' + comp;
        const rawDraft = String(_calReviewState.drafts[key] || '');
        const body = rawDraft.trim();
        if (!body || _calReviewState.saving[key]) return;
        if (_isClientLink) {
            const cur = String(initialPost[comp + '_status'] || '').trim().toLowerCase();
            if (cur !== 'client approval' && cur !== 'tweaks needed') return;
        }
        const _legacySlug = _writeUiSourceClientSlug('calendar', { post: initialPost });
        let attemptId = '';
        let action = null;
        let deferredLegacyAttempt = false;
        let deferredLegacySourceOnly = false;
        let deferredLegacyOutboxIds = [];
        // The queue stores this request's action id before the first send
        // (185), so a replay after a crash or reload reuses it.
        if (_isClientLink) _calCrqBegin('request', pid, comp, { body: rawDraft });
        // The note shows in the part's thread from the click, "Sending…". Its
        // id is learned under the target lock below (where the action identity
        // is minted or adopted), so the saved note then takes its place.
        _calReviewState.sendingNotes[key] = {
            id: String(_calReviewState.draftActionIds[key] || ''), body, role: _calCommentRole(),
            author: _calCurrentAuthor(), created_at: new Date().toISOString(), is_tweak: true
        };
        _calReviewState.saving[key] = true;
        _calReviewState.errors[key] = '';
        delete _calReviewState.errorActionIds[key];
        _calReviewRepaintCard(pid);

        // Begin the exact-target lock before reading ownership or constructing
        // any source snapshot. A waiting tab therefore cannot commit a list
        // captured before the first tab request became visible.
        Promise.resolve().then(() => _writeUiLegacyTargetWithLock(
            'calendar',
            _legacySlug,
            pid,
            comp,
            async () => {
                const post = calState.posts.find(p => p.id === pid);
                if (!post) throw new Error('This review item is no longer available');
                if (_isClientLink) {
                    const currentStatus = String(post[comp + '_status'] || '').trim().toLowerCase();
                    if (currentStatus !== 'client approval' && currentStatus !== 'tweaks needed') {
                        throw new Error('This item changed while your request was waiting. Your draft is preserved.');
                    }
                }
                attemptId = String(_calReviewState.draftActionIds[key] || '')
                    || _calMintCommentId();
                let inspection = await _writeUiLegacyInspectTargetTweak(
                    'calendar', _legacySlug, pid, comp, post, body, attemptId
                );
                inspection = await _writeUiLegacyRefreshActiveTweak('calendar', inspection);
                if (inspection.state === 'conflict') {
                    return { state: 'conflict', conflict: inspection, attempt_id: attemptId };
                }
                if (inspection.state === 'committed') {
                    return {
                        state: 'committed',
                        item: inspection.item,
                        ids: inspection.ids || [],
                        comment_id: inspection.comment_id,
                        source_only: inspection.source_only === true
                    };
                }

                const retryGate = inspection.state === 'active'
                    && inspection.pair && inspection.pair.gate
                    ? inspection.pair.gate
                    : null;
                const commentId = retryGate
                    ? String(retryGate.comment_id || '')
                    : attemptId;
                if (_calReviewState.sendingNotes[key]) _calReviewState.sendingNotes[key].id = commentId;
                const role = retryGate ? String(retryGate.comment_role || '') : _calCommentRole();
                const author = retryGate ? String(retryGate.comment_author || '') : _calCurrentAuthor();
                const audience = retryGate
                    ? String(retryGate.comment_audience || '')
                    : (role === 'client' ? 'client' : 'internal');
                const list = _calCommentsFor(post, comp).slice();
                const existing = list.find(comment =>
                    comment && String(comment.id || '') === commentId);
                if (existing && (
                    String(existing.body || '').trim() !== body
                    || String(existing.author || '') !== author
                    || String(existing.role || '') !== role
                    || String(existing.audience || '') !== audience
                    || existing.is_tweak !== true
                )) {
                    return {
                        state: 'conflict',
                        conflict: {
                            state: 'conflict',
                            comment_id: commentId,
                            delivered: false,
                            item: inspection.item || null,
                            reason: 'local_comment_signature_mismatch'
                        },
                        attempt_id: attemptId
                    };
                }

                const _now = retryGate && inspection.item && inspection.item.queuedAt
                    ? new Date(Number(inspection.item.queuedAt)).toISOString()
                    : new Date().toISOString();
                const newComment = existing || {
                    id: commentId,
                    parent_id: null,
                    author,
                    role,
                    is_tweak: true,
                    audience,
                    round: _calNextTweakRound(post, comp),
                    body,
                    created_at: _now,
                    updated_at: _now,
                    done: false,
                    done_at: '',
                    done_by: ''
                };
                const previousComments = list.map(comment => Object.assign({}, comment));
                const previousFields = {
                    [comp + '_status']: post[comp + '_status'],
                    status: post.status,
                    client_video_approved_at: post.client_video_approved_at,
                    client_graphic_approved_at: post.client_graphic_approved_at,
                    client_caption_approved_at: post.client_caption_approved_at,
                    client_title_approved_at: post.client_title_approved_at,
                    kasper_approved_at: post.kasper_approved_at,
                    updated_at: post.updated_at
                };
                if (!existing) list.push(newComment);
                _calSetCommentsFor(post, comp, list);
                post[comp + '_status'] = 'Tweaks Needed';
                _calV2Log('REVIEW request-change →', pid, '| comp:', comp, '| role:', role);
                post.status = computeOverallStatus(post);
                post.updated_at = new Date().toISOString();
                _calReviewState.drafts[key] = '';
                delete _calReviewState.draftActionIds[key];
                const localStatusMarker = _writeUiRequestTweakMarkLocalStatus('calendar', pid, comp);
                const repairEdits = {
                    [comp + '_status']: post[comp + '_status'],
                    status: post.status,
                    [comp + '_tweaks']: _calStringifyComments(list)
                };
                _calClearStaleApprovals(post, repairEdits);
                const optimisticFields = {};
                Object.keys(previousFields).forEach(field => {
                    optimisticFields[field] = post[field];
                });
                const mode = _calReviewMode();
                const clearsCard = (mode === 'smm' || _isClientLink)
                    && !_calComponentsFor(post).some(component =>
                        _calReviewComponentActive(post, component, mode));
                action = {
                    post,
                    newComment,
                    comment_id: commentId,
                    insertedComment: !existing,
                    previousComments,
                    previousFields,
                    optimisticFields,
                    localStatusMarker,
                    clearsCard,
                    rollbackApplied: false
                };
                _calReviewRepaintCard(pid);

                const acknowledgement = inspection.state === 'active'
                    || inspection.rearmed_team_delivery === true
                    ? { skipped: true, source_gate_retry: true, deferred_until_source_save: true }
                    : await _calPostLinearComment(_calLinearUrlFor(post, comp), body, newComment.author, {
                        post,
                        component: comp,
                        comment: newComment,
                        audience: _calMsgAudience(newComment),
                        isTweak: _calMsgIsTweak(newComment),
                        round: newComment.round,
                        repairEdits: Object.assign({}, repairEdits),
                        reserveStatusIntent: { status: post[comp + '_status'] },
                        deferLegacyUntilSourceSave: true
                    });
                const deferredLegacyComment =
                    !!(acknowledgement && acknowledgement.deferred_until_source_save);
                deferredLegacyAttempt = deferredLegacyComment;
                const committedBatch = Object.assign({}, repairEdits);
                _writeUiBindRepairAck(post, committedBatch, acknowledgement);
                if (deferredLegacyComment) {
                    const staged = await _writeUiQueueDeferredLegacyTweak(
                        'calendar',
                        post,
                        comp,
                        newComment,
                        body,
                        newComment.author,
                        repairEdits,
                        inspection
                    );
                    if (staged.state === 'conflict') {
                        return {
                            state: 'conflict',
                            conflict: staged,
                            attempt_id: attemptId,
                            action
                        };
                    }
                    deferredLegacySourceOnly = staged.source_only === true;
                    deferredLegacyOutboxIds = staged.ids || [];
                    if (staged.state === 'committed') {
                        return {
                            state: 'committed',
                            item: staged.item,
                            ids: deferredLegacyOutboxIds,
                            comment_id: staged.comment_id,
                            source_only: deferredLegacySourceOnly,
                            action
                        };
                    }
                    committedBatch._writeUiPinnedSourceTransport =
                        _writeUiLegacyPinnedSourceTransport('calendar', deferredLegacyOutboxIds);
                }

                const pending = _calPendingEdits[pid] || (_calPendingEdits[pid] = {});
                _writeUiMergeCommittedBatch(pending, committedBatch);
                /* Skip this save's own status push ONLY for a part with no work item.
                   The deferred record staged above is source-only since OPEN_REPAIRS 239:
                   it never touches the network. Before 239 it was a comment + status
                   pair that carried the status to Linear, so skipping the push here was
                   right then. Kept for a linked part, the skip meant a client request
                   whose comment could not use the front door (for example its flag read
                   timed out) changed the card and never reached the work item:
                   OPEN_REPAIRS 429. A linked part now always pushes its status to the
                   gateway, which either moves the work item or refuses out loud. */
                if (deferredLegacyOutboxIds.length && !_writeUiNativeId(post, comp)) _calNoLinearPush.add(pid + '|' + comp);
                await _calFlushCardSave(pid);
                return {
                    state: 'saved',
                    action,
                    ids: deferredLegacyOutboxIds,
                    deferred: deferredLegacyComment,
                    source_only: deferredLegacySourceOnly
                };
            }
        )).then(async outcome => {
            _calReviewState.saving[key] = false;
            const current = calState.posts.find(p => p.id === pid)
                || (action && action.post)
                || initialPost;
            if (outcome && outcome.state === 'conflict') {
                const targetConflict = outcome.conflict || {};
                if (outcome.action) {
                    _writeUiRollbackRequestTweak('calendar', current, comp, outcome.action);
                    outcome.action.rollbackApplied = true;
                }
                if (targetConflict.delivered
                    && targetConflict.item
                    && targetConflict.source_superseded !== true) {
                    _writeUiLegacyReconcileCommittedTweak('calendar', targetConflict.item);
                } else if (targetConflict.source_superseded !== true) {
                    _writeUiScheduleDeferredLegacyTweak('calendar');
                }
                _calReviewState.drafts[key] = rawDraft;
                _calReviewState.errors[key] = targetConflict.source_superseded === true
                    ? 'This request was saved, but a newer status was applied. Review the latest status before retrying.'
                    : (targetConflict.delivered
                        ? 'A change request from another tab was saved first. Your draft is preserved; review the latest status and retry.'
                        : 'Another change request for this item is still being confirmed. Your draft is preserved; retry after it finishes.');
                const failedActionId = String(outcome.action && outcome.action.comment_id
                    || outcome.attempt_id
                    || attemptId);
                _calReviewState.draftActionIds[key] = failedActionId;
                _calReviewState.errorActionIds[key] = failedActionId;
                if (_isClientLink) _calCrqFailed(pid, comp, _calReviewState.errors[key]);
                _calRenderBody({ preserveScroll: true });
                return;
            }
            if (outcome && outcome.state === 'committed') {
                if (outcome.action) {
                    _writeUiRollbackRequestTweak('calendar', current, comp, outcome.action);
                    outcome.action.rollbackApplied = true;
                }
                let committedDeliveryOutcome = null;
                let committedDeliveryPending = false;
                if (outcome.ids && outcome.ids.length) {
                    try {
                        committedDeliveryOutcome = await _writeUiFlushDeferredLegacyTweak(
                            'calendar', outcome.ids
                        );
                    } catch (error) {
                        if (String(error && error.code || '') === 'legacy_tweak_delivery_unconfirmed') {
                            throw error;
                        }
                        committedDeliveryPending = true;
                        _writeUiScheduleDeferredLegacyTweak('calendar');
                        _writeUiReportFailure('calendar', 'comment', error);
                    }
                }
                if ((outcome.item && outcome.item.team_delivery_superseded === true)
                    || (committedDeliveryOutcome && committedDeliveryOutcome.state === 'superseded')) {
                    _writeUiApplySupersededTeamDelivery(
                        'calendar', current, comp, outcome.action || action, key, rawDraft,
                        outcome.comment_id || attemptId
                    );
                    if (_isClientLink) _calCrqResolve(pid, comp);
                    return;
                }
                const sourceOnlySuperseded =
                    (outcome.item && outcome.item.source_only_superseded === true)
                    || (committedDeliveryOutcome
                        && committedDeliveryOutcome.state === 'source_only_superseded');
                _calReviewState.drafts[key] = '';
                _calReviewState.errors[key] = '';
                delete _calReviewState.draftActionIds[key];
                delete _calReviewState.errorActionIds[key];
                if (outcome.item) _writeUiLegacyReconcileCommittedTweak('calendar', outcome.item);
                _calRenderBody({ preserveScroll: true });
                if (_isClientLink && _calCrqDone(pid, comp)) return;
                showToast(sourceOnlySuperseded
                    ? 'Change request saved — a newer status was applied'
                    : (outcome.source_only
                        ? 'Change request already saved'
                        : (committedDeliveryPending
                            ? 'Change request saved — team delivery is being confirmed'
                            : 'Change request already saved')));
                return;
            }
            if (current._saveError) {
                const confirmed = _writeUiLegacyCommittedTweak(
                    'calendar', _legacySlug, pid, comp, current
                );
                if (confirmed && confirmed.delivered === true
                    && confirmed.team_delivery_superseded !== true && action
                    && confirmed.comment_id === String(action.comment_id || '')) {
                    if (!action.rollbackApplied) {
                        _writeUiRollbackRequestTweak('calendar', current, comp, action);
                        action.rollbackApplied = true;
                    }
                    _calReviewState.drafts[key] = '';
                    _calReviewState.errors[key] = '';
                    delete _calReviewState.draftActionIds[key];
                    delete _calReviewState.errorActionIds[key];
                    _writeUiLegacyReconcileCommittedTweak('calendar', confirmed.item);
                    _calRenderBody({ preserveScroll: true });
                    if (_isClientLink) _calCrqDone(pid, comp);
                    return;
                }
                if (deferredLegacyAttempt) _writeUiScheduleDeferredLegacyTweak('calendar');
                if (!current._writeUiRetrySourceAt && action) {
                    _writeUiRollbackRequestTweak('calendar', current, comp, action);
                    action.rollbackApplied = true;
                }
                _calReviewState.drafts[key] = rawDraft;
                _calReviewState.errors[key] = current._saveError || 'Save failed';
                _calReviewState.draftActionIds[key] = String(action && action.comment_id || attemptId);
                _calReviewState.errorActionIds[key] = String(action && action.comment_id || attemptId);
                if (_isClientLink) _calCrqFailed(pid, comp, current._saveError);
                _calRenderBody({ preserveScroll: true });
                return;
            }
            let deliveryPending = false;
            let deliveryOutcome = null;
            if (deferredLegacyOutboxIds.length) {
                try {
                    deliveryOutcome = await _writeUiFlushDeferredLegacyTweak(
                        'calendar', deferredLegacyOutboxIds
                    );
                } catch (error) {
                    if (String(error && error.code || '') === 'legacy_tweak_delivery_unconfirmed') {
                        throw error;
                    }
                    deliveryPending = true;
                    _writeUiScheduleDeferredLegacyTweak('calendar');
                    _writeUiReportFailure('calendar', 'comment', error);
                }
            }
            if (deliveryOutcome && deliveryOutcome.state === 'superseded') {
                _writeUiApplySupersededTeamDelivery(
                    'calendar', current, comp, action, key, rawDraft,
                    action && action.comment_id || attemptId
                );
                if (_isClientLink) _calCrqResolve(pid, comp);
                return;
            }
            if (deliveryOutcome && deliveryOutcome.state === 'source_only_superseded') {
                if (!action.rollbackApplied) {
                    _writeUiRollbackRequestTweak('calendar', current, comp, action);
                    action.rollbackApplied = true;
                }
                _calReviewState.drafts[key] = '';
                _calReviewState.errors[key] = '';
                delete _calReviewState.draftActionIds[key];
                delete _calReviewState.errorActionIds[key];
                _writeUiLegacyReconcileCommittedTweak('calendar', deliveryOutcome.item);
                _calRenderBody({ preserveScroll: true });
                if (_isClientLink) _calCrqDone(pid, comp);
                showToast('Change request saved — a newer status was applied');
                return;
            }
            if (action && action.clearsCard) _calReviewRemoveCard(pid);
            else _calReviewRepaintCard(pid);
            if (_isClientLink && !current._saveError && _calCrqDone(pid, comp)) return;
            if (_calCommentRole() === 'client' && !current._saveError) {
                showToast(deferredLegacySourceOnly
                    ? (deliveryPending
                        ? 'Change request saved — confirmation is still pending'
                        : 'Change request sent')
                    : (deliveryPending
                        ? 'Change request saved — team delivery is being confirmed'
                        : 'Change request sent — the team has been notified'));
            }
        }).catch(error => {
            if (deferredLegacyAttempt || deferredLegacyOutboxIds.length) {
                _writeUiScheduleDeferredLegacyTweak('calendar');
            }
            _calReviewState.saving[key] = false;
            const current = calState.posts.find(p => p.id === pid)
                || (action && action.post)
                || initialPost;
            const confirmed = _writeUiLegacyCommittedTweak(
                'calendar', _legacySlug, pid, comp, current
            );
            if (confirmed
                && confirmed.delivered === true
                && confirmed.team_delivery_superseded !== true
                && String(error && error.code || '') !== 'legacy_tweak_delivery_unconfirmed'
                && action
                && confirmed.comment_id === String(action.comment_id || '')) {
                if (!action.rollbackApplied) {
                    _writeUiRollbackRequestTweak('calendar', current, comp, action);
                    action.rollbackApplied = true;
                }
                _calReviewState.drafts[key] = '';
                _calReviewState.errors[key] = '';
                delete _calReviewState.draftActionIds[key];
                delete _calReviewState.errorActionIds[key];
                _writeUiLegacyReconcileCommittedTweak('calendar', confirmed.item);
                _calRenderBody({ preserveScroll: true });
                if (_isClientLink) _calCrqDone(pid, comp);
                return;
            }
            if (action && !action.rollbackApplied && !current._writeUiRetrySourceAt) {
                _writeUiRollbackRequestTweak('calendar', current, comp, action);
                action.rollbackApplied = true;
            }
            _calReviewState.drafts[key] = rawDraft;
            _writeUiReportFailure('calendar', 'comment', error);
            _calReviewState.errors[key] = _writeUiFailureSentence(error);
            _calReviewState.draftActionIds[key] = String(action && action.comment_id || attemptId);
            _calReviewState.errorActionIds[key] = String(action && action.comment_id || attemptId);
            if (_isClientLink) _calCrqFailed(pid, comp, _calReviewState.errors[key]);
            _calRenderBody({ preserveScroll: true });
        });
    }

    /* ── Read-only preview popover (Month/Week → click) ──────────── */
    function openCalPreview(id) {
        const p = calState.posts.find(x => x.id === id);
        if (!p) return;
        calState.previewId = id;
        const ovl = document.getElementById('calPreviewOverlay');
        const box = document.getElementById('calPreview');
        if (!ovl || !box) return;
        const thumb = _calDeriveThumb(p);
        const dateStr = p.scheduled_date
            ? _calParseIso(String(p.scheduled_date).slice(0, 10)).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })
            : 'Unscheduled';
        const linkify = (u) => {
            const v = String(u || '').trim();
            if (!v) return '<span class="empty">—</span>';
            return `<a href="${_calEscAttr(v)}" target="_blank" rel="noopener">${_calEsc(v)}</a>`;
        };
        const valOrEmpty = (v) => {
            const s = String(v || '').trim();
            return s ? _calEsc(s) : '<span class="empty">—</span>';
        };
        box.innerHTML = `
            ${thumb ? `<div class="cal-preview-thumb"><img src="${_calEscAttr(thumb)}" alt="" onerror="this.parentElement.style.display='none'"></div>` : ''}
            <div class="cal-preview-body">
                <div class="cal-preview-head">
                    <div class="cal-preview-title">${_calEsc(p.name || 'Untitled')}</div>
                    <button class="cal-preview-close" onclick="closeCalPreview()" title="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
                </div>
                <div class="cal-preview-meta">${_calClientCompPillsHtml(p)}<span>${_calEsc(dateStr)}</span></div>
                ${(!_isClientLink && _calSmmMissingMedia(p)) ? _calSmmWarnBannerHtml(p) : ''}
                <div class="cal-preview-row"><div class="cal-preview-label">Asset URL</div><div class="cal-preview-val">${linkify(p.asset_url)}</div></div>
                <div class="cal-preview-row"><div class="cal-preview-label">Thumbnail URL</div><div class="cal-preview-val">${linkify(p.thumbnail_url)}</div></div>
                <div class="cal-preview-row"><div class="cal-preview-label">Caption</div><div class="cal-preview-val">${valOrEmpty(p.caption)}</div></div>
                <div class="cal-preview-row"><div class="cal-preview-label">CTA</div><div class="cal-preview-val">${valOrEmpty(p.cta)}</div></div>
            </div>
            <div class="cal-preview-foot">
                <button class="cal-btn cal-btn-secondary" onclick="closeCalPreview()">Close</button>
                <button class="cal-btn cal-btn-secondary" onclick="closeCalPreview();openCalComments('${_calEscAttr(p.id)}')">Notes${_calOpenCommentCount(p) ? ` · ${_calOpenCommentCount(p)} open` : ''}</button>
                <button class="cal-btn cal-btn-primary" onclick="editInOrganizerFromPreview('${_calEscAttr(p.id)}')">Edit in Organizer</button>
            </div>
        `;
        ovl.classList.add('open');
        document.body.classList.add('cal-modal-open');
        if (!_isClientLink) svLayerOverlay('cal-preview', '#calPreviewOverlay', '#calPreview', () => closeCalPreview());
    }

    function closeCalPreview() {
        svLayerRelease('cal-preview', { focus: true });
        const ovl = document.getElementById('calPreviewOverlay');
        if (ovl) ovl.classList.remove('open');
        calState.previewId = null;
        document.body.classList.remove('cal-modal-open');
    }

    /* From a review card → jump to the Sheet and centre that card. Sets a
       transient focus pid so the Sheet shows the card even if the client's
       "ready only" filter (or an active month filter) would otherwise hide an
       in-review post; the focus clears when the user leaves the Sheet. */
    function _calReviewOpenInSheet(pid) {
        /* Through the one road every other view change takes. This used to
           switch the view by hand, which skipped what onCalViewChange also
           does: the Sheet came up with no Organize menu (so an active month
           filter could be neither seen nor changed), no Select buttons and no
           zoom, until "Sheet" was clicked again. The focus is set after, since
           it is what lets the card past the filters. */
        calState.focusPid = pid;
        if (calState.view !== 'organizer') onCalViewChange('organizer');
        else _calRenderBody();
        setTimeout(() => {
            const card = document.querySelector(`.cal-card[data-pid="${pid}"]`);
            if (!card) return;
            // Centre the card horizontally within the Sheet's strip only. The
            // Sheet is a horizontal rail, so we scroll the strip — never the
            // page vertically (scrollIntoView's block:center was yanking the
            // whole page down, which is what we don't want).
            const strip = document.getElementById('calStrip');
            if (strip) {
                const sRect = strip.getBoundingClientRect();
                const cRect = card.getBoundingClientRect();
                const target = strip.scrollLeft + (cRect.left - sRect.left) - (strip.clientWidth - card.offsetWidth) / 2;
                strip.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
            }
            card.classList.add('cal-card-flash');
            setTimeout(() => card.classList.remove('cal-card-flash'), 1700);
        }, 60);
    }

    function editInOrganizerFromPreview(id) {
        closeCalPreview();
        // Same road as _calReviewOpenInSheet, and the same focus: without it a
        // card the saved month or status filter hides (every card from the
        // Unscheduled tray under a month filter) was never rendered, and the
        // button did nothing at all.
        calState.focusPid = id;
        if (calState.view !== 'organizer') onCalViewChange('organizer');
        else _calRenderBody({ preserveScroll: true });
        setTimeout(() => {
            const card = document.querySelector(`.cal-card[data-pid="${id}"]`);
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                const nameInput = card.querySelector('.cal-fld-name');
                if (nameInput) nameInput.focus();
            }
        }, 50);
    }

    /* ── Threaded comments ─────────────────────────────────────────────
       Both the social media manager (internal view) and the client (share
       link) can comment, reply, and mark threads done. The role is
       auto-detected from the view: internal → SMM, share link → Client.

       Storage piggybacks on the existing `tweaks` column — the array is
       serialized to JSON inside that cell, so no new spreadsheet column is
       required. Legacy plaintext `tweaks` content is preserved by
       seeding it as the first comment on load.

       The modal is a Slack/Discord-style continuous feed: avatar + author +
       body, hover-revealed Reply/Mark-done actions, and a sticky composer
       at the bottom that lives on the same surface as the conversation. */
    let _calOpenCommentsPid = null;
    /* Reply form state survives re-renders inside the modal so typing into a
       reply box isn't wiped by a save round-trip. */
    let _calReplyTarget = null;
    const _calReplyDrafts = Object.create(null);
    /* AND THEY SURVIVE THE TAB, because a refused reply is the one thing in
       OPEN_REPAIRS 101 that cannot be reconstructed from anywhere else.

       A new ROOT note has been mirrored to sessionStorage per card since the
       modal gained drafts; a REPLY never was, and `openCalComments` wipes
       `_calReplyDrafts` wholesale on every open. So a reply whose write was
       refused survived only until the person closed the modal -- and closing
       the modal is exactly what someone does when a save fails and they go
       looking for why. The client's words were then gone, and the 50-row
       diagnostic ring does not carry the body, so nothing anywhere held them.

       One key per card holding a parentId -> text map, mirroring the
       `sv_noteDraft_<pid>` convention next to it rather than inventing a second
       one. Capped at REPLY_DRAFT_MAX parents, evicting the least recently
       written, because a card with a long thread could otherwise accumulate a
       draft per parent for the life of the tab. The TEXT is never truncated:
       a silently shortened draft is a worse outcome than a dropped one, since
       the person cannot see that it happened. */
    const CAL_REPLY_DRAFTS_PREFIX = 'sv_replyDrafts_';
    const CAL_REPLY_DRAFT_MAX = 20;
    function _calReplyDraftsLoad(pid) {
        if (!pid) return {};
        try {
            const raw = JSON.parse(sessionStorage.getItem(CAL_REPLY_DRAFTS_PREFIX + pid) || '{}');
            if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return {};
            const out = Object.create(null);
            for (const k of Object.keys(raw)) if (typeof raw[k] === 'string' && raw[k]) out[k] = raw[k];
            return out;
        } catch (e) { return {}; }
    }
    function _calReplyDraftsPersist(pid) {
        if (!pid) return;
        try {
            /* Object key order is insertion order for string keys, so trimming
               from the FRONT drops the least recently written -- a re-write of
               an existing parent does not move it, which is the behaviour we
               want: the cap is about how many threads are held, not about
               punishing someone for editing one of them. */
            const keys = Object.keys(_calReplyDrafts).filter(k => _calReplyDrafts[k]);
            const kept = keys.slice(-CAL_REPLY_DRAFT_MAX);
            if (!kept.length) { sessionStorage.removeItem(CAL_REPLY_DRAFTS_PREFIX + pid); return; }
            const map = {};
            for (const k of kept) map[k] = _calReplyDrafts[k];
            sessionStorage.setItem(CAL_REPLY_DRAFTS_PREFIX + pid, JSON.stringify(map));
        } catch (e) {}
    }
    let _calEditTarget = null;
    const _calEditDrafts = Object.create(null);
    let _calRootDraft = '';
    /* A new note typed and not yet sent is kept in the shared draft store for
       staff (it survives a new tab and a reload, for 7 days) and in
       sessionStorage on a client link, as it always was. It is dropped when the
       server ACKNOWLEDGES the note. If the page went away while a note was on
       its way, the restore looks in the thread first and drops the draft when
       the note is already there: restoring it would send it twice. */
    let _calRootDraftRestored = '';   // '' | 'restored' | 'sending'
    function _calNoteInThread(post, text) {
        const want = _svDraftNorm(text);
        if (!want || !post) return false;
        return CAL_COMPONENTS.some(c => {
            const list = c === 'video' ? (Array.isArray(post.comments) ? post.comments : []) : _calCommentsFor(post, c);
            return Array.isArray(list) && list.some(m => m && _svDraftNorm(m.body) === want);
        });
    }
    function _calNoteDraftGet(pid) {
        _calRootDraftRestored = '';
        const post = calState.posts.find(p => p.id === pid);
        if (_isClientLink) {
            let t = '', sending = '';
            try { t = sessionStorage.getItem('sv_noteDraft_' + pid) || ''; sending = sessionStorage.getItem('sv_noteSending_' + pid) || ''; } catch (e) {}
            // Only a note that was ON ITS WAY is checked against the thread; an ordinary unsent draft that happens to repeat an old note is kept.
            if (t && sending === t && _calNoteInThread(post, t)) {
                try { sessionStorage.removeItem('sv_noteDraft_' + pid); sessionStorage.removeItem('sv_noteSending_' + pid); } catch (e) {}
                return '';
            }
            return t;
        }
        const d = _svDraftRead('cal', calClientSlug(calState.client), pid, 'note');
        if (!d) return '';
        if (d.meta && d.meta.sending && _calNoteInThread(post, d.text)) { _svDraftClear('cal', calClientSlug(calState.client), pid, 'note'); return ''; }
        _calRootDraftRestored = d.meta && d.meta.sending ? 'sending' : 'restored';
        return d.text;
    }
    function _calNoteDraftSet(pid, text, meta) {
        if (!pid) return;
        if (_isClientLink) {
            try {
                if (text) sessionStorage.setItem('sv_noteDraft_' + pid, text); else sessionStorage.removeItem('sv_noteDraft_' + pid);
                if (text && meta && meta.sending) sessionStorage.setItem('sv_noteSending_' + pid, text); else sessionStorage.removeItem('sv_noteSending_' + pid);
            } catch (e) {}
            return;
        }
        _svDraftSave('cal', calClientSlug(calState.client), pid, 'note', text, meta);
    }
    /* The server acknowledged `body`: drop the draft only if it IS that text. */
    function _calNoteDraftClearIfSent(pid, body) {
        if (_isClientLink) {
            try {
                if ((sessionStorage.getItem('sv_noteDraft_' + pid) || '').trim() === String(body || '').trim()) {
                    sessionStorage.removeItem('sv_noteDraft_' + pid);
                    sessionStorage.removeItem('sv_noteSending_' + pid);
                }
            } catch (e) {}
            return;
        }
        _svDraftClearIf('cal', calClientSlug(calState.client), pid, 'note', body);
    }
    function _calNoteDraftDiscard() {
        const pid = _calOpenCommentsPid;
        if (!pid) return;
        _calNoteDraftSet(pid, '');
        _calRootDraft = '';
        _calRootDraftRestored = '';
        _calRenderCommentsModal();
    }
    /* Audience for the NEXT new root note an SMM sends from the Notes modal:
       'internal' (team-only — you + Kasper, hidden from the client) or 'client'
       (shared with the client). Defaults to 'internal' so nothing reaches the
       client unless it's deliberately shared. Resets each time the modal opens.
       Replies don't use this — they inherit their thread root's audience. */
    let _calComposeAudience = 'internal';
    /* Whether the NEXT new root the CLIENT sends is a change request (→ Tweaks
       Needed) or a plain comment (no status change). Defaults to comment, so a
       reply or a question never moves the status. SMM modal posts are always
       comments (they request changes from the review panel). Resets on open. */
    let _calComposeIsTweak = false;
    /* Component the NEXT new root note targets, chosen in the Notes composer's
       picker (Part B): video | graphic | caption | title. Default 'video'
       (preserves the old hardcoded target + the SMM's muscle memory). Replies
       ignore this — they inherit their parent thread's component. Resets to
       'video' each time the modal opens. */
    let _calComposeComp = 'video';
    const _CAL_LOCK_ICO = '<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6.5" width="8" height="5" rx="1"/><path d="M4.75 6.5V5a2.25 2.25 0 0 1 4.5 0v1.5"/></svg>';
    const _CAL_EYE_ICO = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8s-2.4 4.5-6.5 4.5S1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/></svg>';
    /* Threads folded with the rail on the left. Kept while the page is open. */
    const _calCollapsedThreads = new Set();
    function _calToggleThreadCollapse(rootId) {
        const id = String(rootId || '');
        if (!id) return;
        if (_calCollapsedThreads.has(id)) _calCollapsedThreads.delete(id);
        else _calCollapsedThreads.add(id);
        _calCaptureModalDrafts();
        _calRenderCommentsModal();
    }
    /* The audience icon inside the staff composer: lock = Kasper / team (the
       default), eye = the client can see it. Client turns the box blue and
       switches off "Request change", which is always team only. */
    function _calSetComposeAudience(val) {
        _calComposeAudience = (val === 'client') ? 'client' : 'internal';
        _calPaintComposeAudience();
    }
    function _calToggleComposeAudience() {
        _calSetComposeAudience(_calComposeAudience === 'client' ? 'internal' : 'client');
    }
    function _calPaintComposeAudience() {
        const toClient = _calComposeAudience === 'client';
        const box = document.querySelector('#calCommentsModal .cal-cm-composer[data-cm-staff-root]');
        if (!box) return;
        box.classList.toggle('is-to-client', toClient);
        const btn = box.querySelector('.cal-cm-aud-icon');
        if (btn) {
            btn.innerHTML = toClient ? _CAL_EYE_ICO : _CAL_LOCK_ICO;
            btn.setAttribute('aria-pressed', toClient ? 'true' : 'false');
            btn.title = toClient ? 'The client can see this. Click for team only.' : 'Team only. Click to write to the client.';
            btn.setAttribute('aria-label', btn.title);
        }
        const more = box.querySelector('.cal-cm-send-more');
        if (more) {
            more.disabled = toClient;
            more.title = toClient ? 'Change requests are team only' : 'More send options';
        }
        _calCloseSendMenu();
        const hint = document.querySelector('#calCommentsModal [data-cm-quiet]');
        if (hint) hint.textContent = _calComposeQuietLine();
        const ta = document.getElementById('calCommentComposer');
        if (ta && !_calReplyTarget && !_calEditTarget) ta.placeholder = _calComposePlaceholder('smm');
    }
    function _calComposeQuietLine() {
        const open = _calComposeComp === 'video' && calState && Array.isArray(calState.posts) ? calState.posts.find(p => p.id === _calOpenCommentsPid) : null;
        const letter = open ? svTrialNotesLetter(open) : '';
        const comp = letter ? 'Video ' + letter : (COMP_LABELS[_calComposeComp] || 'Video');
        return _calComposeAudience === 'client'
            ? 'The client will see this · ' + comp
            : 'Team only · ' + comp;
    }
    function _calCloseSendMenu() {
        svLayerRelease('cal-sendmenu');
        const menu = document.querySelector('#calCommentsModal .cal-cm-send-menu');
        if (menu) menu.hidden = true;
        const more = document.querySelector('#calCommentsModal .cal-cm-send-more');
        if (more) more.setAttribute('aria-expanded', 'false');
    }
    function _calToggleSendMenu(ev) {
        if (ev) ev.stopPropagation();
        const menu = document.querySelector('#calCommentsModal .cal-cm-send-menu');
        const more = document.querySelector('#calCommentsModal .cal-cm-send-more');
        if (!menu || !more || more.disabled) return;
        menu.hidden = !menu.hidden;
        more.setAttribute('aria-expanded', menu.hidden ? 'false' : 'true');
        if (!menu.hidden) {
            const item = menu.querySelector('button');
            if (item) item.focus();
            svLayerOpen({
                key: 'cal-sendmenu',
            holdRefresh: false,   // lives outside the redrawn card list
                region: () => document.querySelector('#calCommentsModal .cal-cm-send-menu'),
                opener: () => document.querySelector('#calCommentsModal .cal-cm-send-more'),
                isOpen: () => { const m = document.querySelector('#calCommentsModal .cal-cm-send-menu'); return !!m && !m.hidden; },
                close: () => _calCloseSendMenu(),
            });
        } else svLayerRelease('cal-sendmenu');
    }
    /* "Request change" from the split Send button. Reuses the review panel's
       request lane as is (status to Tweaks Needed, editor told, round number,
       conflict and retry handling), so Notes and the review panel can never
       disagree about what a change request does. Always team only. */
    async function _calSubmitComposerAsTweak() {
        _calCloseSendMenu();
        const pid = _calOpenCommentsPid;
        if (!pid || _calReplyTarget || _calEditTarget || _calComposeAudience === 'client') return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        _calCaptureModalDrafts();
        const body = String(_calRootDraft || '').trim();
        if (!body) return;
        const comp = _calComponentsFor(post).indexOf(_calComposeComp) >= 0 ? _calComposeComp : 'video';
        const key = pid + '|' + comp;
        if (_calReviewState.saving[key]) return;
        _calReviewState.drafts[key] = body;
        _calRootDraft = '';
        _calRootDraftRestored = '';
        _calNoteDraftSet(pid, '');
        _calReviewRequestTweak(pid, comp);
        if (_calOpenCommentsPid === pid) _calRenderCommentsModal();
        // The lane reports on the review card; mirror its answer here.
        for (let i = 0; i < 600 && _calReviewState.saving[key]; i++) {
            await new Promise(resolve => setTimeout(resolve, 100));
        }
        const error = _calReviewState.errors[key];
        if (error) {
            if (_calOpenCommentsPid === pid && !_calRootDraft) {
                _calRootDraft = String(_calReviewState.drafts[key] || body);
                _calNoteDraftSet(pid, _calRootDraft);
            }
            showNotify('Change request not sent', error);
        }
        if (_calOpenCommentsPid === pid) _calRenderCommentsModal();
    }
    function _calSetComposeIsTweak(val) {
        _calComposeIsTweak = !!val;
        const seg = document.querySelector('[data-cm-toggle="tweak"]');
        if (seg) seg.querySelectorAll('.cal-cm-aud-btn').forEach(b =>
            b.classList.toggle('is-active', (b.dataset.tweak === '1') === _calComposeIsTweak));
        const ta = document.getElementById('calCommentComposer');
        if (ta && !_calReplyTarget) ta.placeholder = _calComposeIsTweak ? 'Describe the change you need…' : _calComposePlaceholder('client');
    }
    /* Pick which deliverable the next new root note is about (Part B picker).
       Validated against the card's ACTIVE review components (_calComponentsFor)
       so the picker can never target a component the card doesn't have — and a
       note can't land on a thread that wouldn't render in the feed. */
    function _calSetComposeComp(val) {
        const post = calState.posts.find(p => p.id === _calOpenCommentsPid);
        const allowed = post ? _calComponentsFor(post) : CAL_COMPONENTS;
        _calComposeComp = (allowed.indexOf(val) >= 0) ? val : 'video';
        const seg = document.querySelector('[data-cm-toggle="comp"]');
        if (seg) seg.querySelectorAll('.cal-cm-aud-btn').forEach(b =>
            b.classList.toggle('is-active', b.dataset.comp === _calComposeComp));
        const hint = document.querySelector('#calCommentsModal [data-cm-quiet]');
        if (hint) hint.textContent = _calComposeQuietLine();
    }
    /* Resolved (done) change-requests are history — hidden from the live feed
       until the user opens the history toggle (top-right of the modal). */
    let _calShowResolved = false;
    function _calToggleShowResolved() {
        _calShowResolved = !_calShowResolved;
        _calCaptureModalDrafts();
        _calRenderCommentsModal();
    }
    /* Composer prompt that names the recipient, so picking the toggle visibly
       changes who you're writing to. */
    function _calComposePlaceholder(role) {
        if (role === 'client') return 'Message your Synchro Social team…';
        return _calComposeAudience === 'client' ? 'Message to the client…' : 'Message to Kasper / the team…';
    }

    function _calStringifyComments(arr) {
        const list = Array.isArray(arr) ? arr.filter(c => c && c.id) : [];
        return list.length ? JSON.stringify(list) : '';
    }
    /* Per-comment last-write-wins clock. Comments live in a single per-component
       cell that both the client and the SMM/Kasper rewrite wholesale, so the
       same comment can exist in two browsers' copies with divergent resolution
       state. Each comment carries an updated_at that bumps on every change;
       merges keep the copy with the newer stamp. (Falls back to created_at for
       legacy comments written before this field existed.) */
    function _calCommentStamp(c) { return String((c && (c.updated_at || c.created_at)) || ''); }
    /* Union two comment lists by id for DISPLAY. For an id on both sides keep
       the newer-stamped copy (so a stale write can't un-resolve a comment or
       drop a fresh edit); ids on only one side are kept (a comment the other
       surface just added). The server upsert is authoritative for deletions —
       it 3-way-merges against each writer's last-seen base — so this client
       union may briefly show a just-deleted comment until the next fetch, which
       is strictly safer than the old whole-cell overwrite that silently lost
       comments. */
    function _calMergeCommentLists(a, b) {
        const out = new Map();
        const absorb = (list) => {
            if (!Array.isArray(list)) return;
            for (const c of list) {
                if (!c || !c.id) continue;
                const prev = out.get(c.id);
                if (!prev || _calCommentStamp(c) >= _calCommentStamp(prev)) {
                    if (prev && prev.deleted && !c.deleted) _calV2Log('COMMENT resurrection →', c.id, '| a live copy (stamp', _calCommentStamp(c), ') overrode a tombstone (stamp', _calCommentStamp(prev), ')');
                    out.set(c.id, c);
                }
            }
        };
        absorb(a); absorb(b);
        return Array.from(out.values());
    }
    /* Merge the per-component comment threads of `other` into `winner` in place
       so neither side's comments/resolutions are lost when a poll picks one row
       over the other. Returns winner. */
    function _calMergePostComments(winner, other) {
        if (!winner || !other) return winner;
        for (const comp of _calComponentsFor(winner)) {
            const merged = _calMergeCommentLists(_calCommentsFor(winner, comp), _calCommentsFor(other, comp));
            _calSetCommentsFor(winner, comp, merged);
        }
        if (Array.isArray(winner.video_comments)) winner.comments = winner.video_comments;
        return winner;
    }
    /* Returns the canonical comments array for a post. Reads from
       `post.comments` (in-memory, already parsed) if present; otherwise
       parses the `tweaks` storage cell. Legacy plaintext tweaks are
       converted into a single seeded note so existing data isn't lost. */
    function _calLoadComments(post) {
        if (Array.isArray(post.video_comments)) return post.video_comments.filter(c => c && c.id);
        if (Array.isArray(post.comments)) return post.comments.filter(c => c && c.id);
        const fromVideoCol = String(post.video_tweaks == null ? '' : post.video_tweaks).trim();
        const raw = fromVideoCol || String(post.tweaks == null ? '' : post.tweaks).trim();
        if (!raw) return [];
        if (raw.startsWith('[')) {
            try {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) return parsed.filter(c => c && c.id);
            } catch {}
        }
        return [{
            id: 'c_legacy_' + Math.random().toString(36).slice(2, 8),
            parent_id: null,
            author: 'Legacy import — please send to Sidney before deleting',
            role: 'smm',
            body: raw, created_at: '', done: false, done_at: '', done_by: '',
            source: 'legacy_tweaks_column_seed',
            source_field: fromVideoCol ? 'video_tweaks' : 'tweaks',
            seeded_at: new Date().toISOString()
        }];
    }
    function _calCommentRole() { return _isClientLink ? 'client' : 'smm'; }
    function _calCurrentAuthor() {
        if (_isClientLink) return calState.client ? String(calState.client) : 'Client';
        return 'Synchro Social';
    }
    /* Who wrote a staff note. The note keeps the shared 'Synchro Social'
       author and gains author_member_id: only the id, never a name or email,
       because the client link downloads these card columns. Staff screens look
       the name up in the staff roster; the client link always says
       'Synchro team'. */
    function _calCurrentAuthorId() {
        if (_isClientLink) return '';
        try {
            const identity = _syncviewStaffIdentityForHeaders();
            return String(identity && identity.member && identity.member.id || '');
        } catch (e) { return ''; }
    }
    let _calStaffNames = null;
    let _calStaffNamesLoading = false;
    function _calStaffNameById(id) {
        id = String(id || '');
        if (!id || _isClientLink) return '';
        if (_calStaffNames) return _calStaffNames.get(id) || '';
        if (!_calStaffNamesLoading) {
            _calStaffNamesLoading = true;
            Promise.resolve().then(() => _syncviewStaffRoster()).then(rows => {
                _calStaffNames = new Map((rows || []).map(r => [String(r.id), String(r.name || '')]));
                try { window.dispatchEvent(new Event('sv-staff-names')); } catch (e) {}
            }).catch(() => { _calStaffNamesLoading = false; });
        }
        return '';
    }
    function _calNoteAuthorName(c, fallback) {
        c = c || {};
        const role = String(c.role || '').toLowerCase();
        if (_isClientLink) return role === 'client' ? String(c.author || fallback || 'Client') : 'Synchro team';
        if (role !== 'client') {
            const named = _calStaffNameById(c.author_member_id);
            if (named) return named;
        }
        return String(c.author || fallback || '');
    }
    window.addEventListener('sv-staff-names', () => {
        try { if (_calOpenCommentsPid) _calRenderCommentsModal(); } catch (e) {}
    });
    function _calMintCommentId() { return 'c_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 7); }

    /* NOTE OUTBOX: a note shows the moment it is sent, and is never lost
       (owner, 2026-10-15: a note with Request changes "took a long time to
       send"; measured: the Notes dialog waited about 2.4 s for two server
       calls before showing the note, Messages about 4 to 6 s).

       Every note gets its id at the click, and that id is the one sent to the
       server on every try. The gateway keeps one comment per id
       (`native_comment_id`) and the card save merges comments by id, so a
       retry, a double click or a re-send after a refresh can never make a
       second note.

       Until the server confirms it, the note is kept here, in this browser's
       storage, with its words: it is drawn in the thread as "Sending…", and if
       the send fails (or the page was closed or refreshed mid-send) as "Not
       sent" with Retry. Retry sends the same id again. An entry is removed
       only when the server confirmed it, or the person discards it.

       Entries belong to one sender: the client link of one client, or one
       staff member. Nothing here is shown to anyone else. */
    const NOTE_OUTBOX_KEY = 'sv-note-outbox-v1';
    const NOTE_OUTBOX_MAX_AGE_MS = 14 * 24 * 60 * 60 * 1000;
    // Notes whose send is running in this tab (an entry in storage that is
    // "sending" but not here was interrupted: a refresh or a closed tab).
    const _noteOutboxLive = new Set();
    // One send at a time per card, in click order: each send builds on the
    // card's thread as the one before it left it.
    const _noteOutboxChains = new Map();
    function _noteOutboxOwner() {
        try {
            if (_isClientLink) return 'client:' + calClientSlug(calState.client);
            return 'staff:' + (_calCurrentAuthorId() || _calCurrentAuthor() || '');
        } catch (e) { return ''; }
    }
    function _noteOutboxRead() {
        try {
            const all = JSON.parse(localStorage.getItem(NOTE_OUTBOX_KEY) || '{}');
            return all && typeof all === 'object' && !Array.isArray(all) ? all : {};
        } catch (e) { return {}; }
    }
    function _noteOutboxWrite(all) {
        try {
            const now = Date.now();
            Object.keys(all).forEach(id => { if (!all[id] || now - Number(all[id].at || 0) > NOTE_OUTBOX_MAX_AGE_MS) delete all[id]; });
            if (Object.keys(all).length) localStorage.setItem(NOTE_OUTBOX_KEY, JSON.stringify(all));
            else localStorage.removeItem(NOTE_OUTBOX_KEY);
        } catch (e) {}
    }
    function _noteOutboxGet(id) {
        const e = _noteOutboxRead()[id];
        return e && e.owner === _noteOutboxOwner() ? e : null;
    }
    function _noteOutboxPut(entry) {
        const all = _noteOutboxRead();
        all[entry.id] = Object.assign({}, all[entry.id] || {}, entry, { owner: _noteOutboxOwner() });
        _noteOutboxWrite(all);
        return all[entry.id];
    }
    function _noteOutboxSet(id, patch) {
        const all = _noteOutboxRead();
        if (!all[id]) return null;
        all[id] = Object.assign(all[id], patch);
        _noteOutboxWrite(all);
        return all[id];
    }
    function _noteOutboxDrop(id) {
        const all = _noteOutboxRead();
        if (!all[id]) return;
        delete all[id];
        _noteOutboxWrite(all);
    }
    /* This sender's waiting notes on one card, oldest first. An entry that says
       "sending" while no send runs in this tab was cut off mid-send: it reads
       as not sent, so the person can send it again (same id, no double). */
    function _noteOutboxFor(pid, filter) {
        const owner = _noteOutboxOwner();
        return Object.values(_noteOutboxRead())
            // A confirmed Messages reply waits only for the inbox refresh.
            .filter(e => e && e.pid === pid && e.owner === owner && (!filter || filter(e))
                && !(e.state === 'sent' && !_noteOutboxLive.has(e.id) && Date.now() - Number(e.at || 0) > 60000))
            .map(e => (e.state === 'sending' && !_noteOutboxLive.has(e.id))
                ? Object.assign({}, e, { state: 'failed', error: e.error || 'The page was closed before this was confirmed.' })
                : e)
            .sort((a, b) => Number(a.at || 0) - Number(b.at || 0));
    }
    /* The note as the thread draws it: the same fields a saved note has, plus
       its outbox state. */
    function _noteOutboxAsComment(e) {
        return {
            id: e.id, parent_id: e.parent_id || null, author: e.author, author_member_id: e.author_member_id,
            role: e.role, body: e.body, created_at: e.created_at, updated_at: e.created_at,
            audience: e.audience, is_tweak: !!e.is_tweak, done: false,
            _outbox: e.state === 'failed' ? 'failed' : (e.state === 'sent' ? 'sent' : 'sending'),
            _outboxError: e.error || ''
        };
    }
    function _noteOutboxInList(post, id) {
        if (!post || !id) return false;
        return CAL_REVIEW_COMPONENTS.some(c => {
            const list = c === 'video' ? (Array.isArray(post.comments) ? post.comments : _calLoadComments(post)) : _calCommentsFor(post, c);
            return Array.isArray(list) && list.some(m => m && m.id === id);
        });
    }
    /* The small line under a waiting note: "Sending…", or "Not sent" with
       Retry and Discard. */
    function _noteOutboxStatusHtml(c) {
        if (!c || !c._outbox || c._outbox === 'sent') return '';
        // Round 7 (switch unread_badges_v2): a spinner, never the word "Sending…" (owner, 2026-10-24).
        if (c._outbox === 'sending' && svBusyOn()) return `<div class="sv-note-outbox is-sending">${svSpinHtml('Sending')}</div>`;
        if (c._outbox === 'sending') return `<div class="sv-note-outbox is-sending" role="status"><span class="sv-note-outbox-dot" aria-hidden="true"></span>Sending…</div>`;
        if (c._outboxRequest) {
            return `<div class="sv-note-outbox is-failed" role="alert"><span>Not sent yet. It will be sent when the connection is back.</span>
            <button type="button" class="sv-note-outbox-retry" onclick="_noteOutboxRetryRequest()">Tap to retry</button></div>`;
        }
        const idArg = _jsAttrArg(c.id);
        return `<div class="sv-note-outbox is-failed" role="alert"><span>Not sent.</span>
            <button type="button" class="sv-note-outbox-retry" onclick="_noteOutboxRetry(${idArg})">Tap to retry</button>
            <button type="button" class="sv-note-outbox-discard" onclick="_noteOutboxDiscard(${idArg})">Discard</button></div>`;
    }
    // Redraw whatever shows this card's notes.
    function _noteOutboxRepaint(pid) {
        try { if (_calOpenCommentsPid === pid) _calRenderCommentsModal(); } catch (e) {}
        try { _calReviewRepaintCard(pid); } catch (e) {}
        try { _calRefreshCommentsBtn(pid); } catch (e) {}
        try { window.dispatchEvent(new CustomEvent('sv-note-outbox', { detail: { pid } })); } catch (e) {}
    }
    /* Staff: the card's comments are linked to production. A client link: the
       verified client write context for this Calendar card (the read gate says
       "not linked" for every client Calendar card, because canonical client
       reads are Samples-only, but the client write is a separate predicate). */
    async function _noteReviewGoesToGateway(pid, comp) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post || !(comp === 'video' || comp === 'graphic')) return false;
        if (_isClientLink) return !!(await _prodClientCommentGatewayContext('calendar', post, comp));
        const gate = _prodCanonicalCommentGate(post, comp);
        return !!(gate && gate.linked);
    }
    /* Round 9 (owner, switch unread_badges_v2, staff only): a note sent in the moment the card's notes are still
       loading (the link check and the thread read that every opening runs) used to be refused with "Notes are still
       loading". It is now taken: it shows in the thread at once, as every note does, and is sent as soon as the
       loading ends (at most 10 s; after that the send runs and refuses as before). A read that failed still refuses. */
    function _calNotesStillLoading(post, gate) {
        return !_isClientLink && svUnreadBadgesOn() && !!post && _calCommentSendPending(post, gate) && gate.status !== 'error';
    }
    async function _calWaitNotesLoaded(pid, entry) {
        const until = Date.now() + 10000;
        while (Date.now() < until) {
            const post = calState.posts.find(p => p.id === pid);
            if (!post) return;
            const comp = entry.parent_id ? _calFindCompForCommentId(post, entry.parent_id) : (entry.comp || 'video');
            if (!_calNotesStillLoading(post, _prodCanonicalCommentGate(post, comp))) return;
            await new Promise(r => setTimeout(r, 100));
        }
    }
    /* Send (or re-send) one waiting note. Never awaited by a click. */
    function _noteOutboxSend(id) {
        const first = _noteOutboxGet(id);
        if (!first || _noteOutboxLive.has(id)) return Promise.resolve(false);
        _noteOutboxLive.add(id);
        _noteOutboxSet(id, { state: 'sending', error: '' });
        const pid = first.pid;
        const prev = _noteOutboxChains.get(pid) || Promise.resolve();
        const run = prev.catch(() => {}).then(async () => {
            const entry = _noteOutboxGet(id);
            if (!entry) return false;
            let ok = false, error = '';
            try {
                /* A plain review note on a card whose comments live in production
                   goes through the same gateway write as a Notes note, with the
                   id it already has. The card-row-only save left it with no
                   production row, so the note showed in review but not in Notes,
                   and typing it again there made a second copy under a new id. */
                if (entry.kind === 'review-comment' && !(await _noteReviewGoesToGateway(pid, entry.comp))) ok = await _calReviewCommentSend(entry);
                else {
                    if (entry.surface === 'msg' && typeof window._msgBeforeNoteSend === 'function') await window._msgBeforeNoteSend(entry);
                    await _calWaitNotesLoaded(pid, entry);
                    ok = await _calAppendComment(pid, entry.parent_id || null, entry.body, {
                        id: entry.id, comp: entry.comp || '', audience: entry.audience, isTweak: !!entry.is_tweak, background: true
                    });
                    const post = calState.posts.find(p => p.id === pid);
                    // A caption or title note lives only on the card row: its
                    // card save failing means it is not saved.
                    if (ok && post && post._saveError && !_writeUiComponentHasWorkItem(entry.comp || _calFindCompForCommentId(post, entry.id))
                        && !/^Not saved yet: /.test(String(post._saveError))) {
                        ok = false; error = post._saveError;
                    }
                }
            } catch (e) { ok = false; error = _writeUiFailureSentence(e); }
            if (!ok && !error) {
                const post = calState.posts.find(p => p.id === pid);
                error = (post && post._saveError) || 'It did not reach the server.';
            }
            if (ok) {
                if (entry.surface === 'msg') _noteOutboxSet(id, { state: 'sent', error: '' });
                else _noteOutboxDrop(id);
            } else {
                _noteOutboxSet(id, { state: 'failed', error: String(error || '').slice(0, 300) });
                // A plain review comment's card save does not go through the
                // gateway, so its refusal is logged here (the gateway paths
                // log their own).
                if (entry.kind === 'review-comment') {
                    _writeUiRecordFailure('calendar', 'comment', new Error(String(error || 'note_not_sent')), { note_outbox: 1 });
                }
            }
            return ok;
        }).finally(() => {
            _noteOutboxLive.delete(id);
            if (_noteOutboxChains.get(pid) === run) _noteOutboxChains.delete(pid);
            _noteOutboxRepaint(pid);
        });
        _noteOutboxChains.set(pid, run);
        _noteOutboxRepaint(pid);
        return run;
    }
    function _noteOutboxRetry(id) {
        const e = _noteOutboxGet(id);
        if (!e || _noteOutboxLive.has(id)) return;
        if (e.surface === 'msg' && typeof window._msgSendQueued === 'function') { window._msgSendQueued(id); return; }
        _noteOutboxSend(id);
    }
    // A held client change request is re-sent by the client send queue (185).
    function _noteOutboxRetryRequest() { _calCrqResend(); }
    function _noteOutboxDiscard(id) {
        const e = _noteOutboxGet(id);
        if (!e || _noteOutboxLive.has(id)) return;
        _noteOutboxDrop(id);
        // A review comment is already in the card's local thread; take it out
        // so the screen does not show a note the server never got.
        if (e.kind === 'review-comment') {
            const post = calState.posts.find(p => p.id === e.pid);
            if (post) {
                const list = _calCommentsFor(post, e.comp).filter(m => m && m.id !== e.id);
                _calSetCommentsFor(post, e.comp, list);
                if (e.comp === 'video') post.comments = list;
            }
        }
        _noteOutboxRepaint(e.pid);
    }
    function _calCommentRoots(arr) {
        return arr.filter(c => !c.parent_id && (!c.deleted || c.canonical) && !c.hidden)
            .sort((a, b) => String(a.created_at || '').localeCompare(String(b.created_at || '')));
    }
    function _calCommentReplies(arr, rootId) {
        return arr.filter(c => c.parent_id === rootId && (!c.deleted || c.canonical) && !c.hidden)
            .sort((a, b) => String(a.created_at || '').localeCompare(String(b.created_at || '')));
    }
    /* Count open / total threads across all three components (video, graphic,
       caption). Older code only looked at post.comments, missing client
       tweak requests on the thumbnail/caption components — so the SMM card
       showed "0 open" even after the client had requested changes. */
    function _calAllCommentLists(post) {
        if (!post) return [];
        const lists = [];
        for (const c of _calComponentsFor(post)) {
            // Use the view-filtered reader so the client's "Tweaks" badge
            // / open-comment count doesn't include Kasper-only entries.
            const list = _calCommentsForView(post, c);
            if (Array.isArray(list) && list.length) lists.push(list);
        }
        // Safety: the badge MUST walk the same source the modal renders from.
        // The old fallback to post.comments here let stale legacy data
        // (post.comments out-of-sync with the per-component arrays after a
        // manual Google-Sheets cell deletion, for example) produce a badge
        // counting comments the modal couldn't see — the "I see 2 tweaks but
        // when I open it nothing is there" bug. The per-component arrays are
        // the single source of truth; if all three are empty, there are no
        // tweaks to count, period.
        return lists;
    }
    /* Safety harness: count open tweak THREADS the same way the modal
       renders them — _calCommentRoots filters out deleted, hidden, and
       (in client view) Kasper-only entries before counting. Going through
       the same helper guarantees the badge can never overcount past what
       the modal will actually show, which was the root cause of the
       "Tweaks (N)" badge with an empty panel reported on Dr. Sonia's
       calendar after she cleared comment cells directly in Google Sheets. */
    function _calOpenCommentCount(post) {
        if (!post) return 0;
        let n = 0;
        for (const c of _calComponentsFor(post)) {
            const list = _calCommentsForView(post, c);
            if (!Array.isArray(list) || !list.length) continue;
            for (const root of _calCommentRoots(list)) {
                // Count only open change-requests (tweaks). A plain comment is
                // a conversation, not an open task, so it never adds to the
                // "N open" badge and isn't something to resolve.
                if (!root.deleted && _calMsgIsTweak(root) && !root.done) n++;
            }
        }
        return n;
    }
    /* Per-component: does this component carry at least one unresolved
       Kasper-authored tweak? Used by the Kasper review to decide whether
       the panel sticks around (Kasper has comments awaiting SMM action)
       even after the sub-status flipped to Tweaks Needed. */
    function _calCompHasUnresolvedKasperTweak(post, comp) {
        const list = _calCommentsFor(post, comp);
        if (!Array.isArray(list)) return false;
        // Only actual change-requests count — a plain Kasper comment (is_tweak
        // false) is discussion, not a tweak, so it must not masquerade as one
        // here (otherwise it inflates the tweak chip, lands the card in the
        // "tweaks pending" partition, and routes Finish as a hand-off).
        return list.some(x => x && x.role === 'kasper' && _calMsgIsTweak(x) && !x.done && !x.deleted);
    }
    /* Per-component visibility on the Kasper review queue. A panel
       only shows when (a) the component's sub-status is still at
       Kasper Approval, OR (b) the SMM has flipped it to Tweaks
       Needed but Kasper still has an unresolved tweak on it (the
       "re-review" hand-off). Anything past that — For SMM Approval,
       Client Approval, Approved, Posted — drops the component out
       of Kasper's view even if a stale tweak comment lingers, so
       SMM-driven status progressions can't be silently un-done. */
    function _calCompKasperVisible(post, comp) {
        // An unlinked thumbnail slot is not reviewable — mirror the SMM card,
        // which locks the pill until a GRA sub-issue is linked. Without this
        // gate a junk "Kasper Approval" graphic_status (e.g. written by the
        // Linear status sync through a since-removed wrong link) drags a
        // thumbnail panel into Kasper's queue that nobody can act on.
        // Caption is exempt (it never has a Linear issue) and video keeps its
        // status-only rule: the video file itself (asset_url) is reviewable
        // even when the Linear link is missing.
        if (comp === 'graphic' && !_calCompLinked(post, comp)) return false;
        const cs = _calNormStatus(post[comp + '_status'] || '');
        if (cs === 'Kasper Approval') return true;
        if (cs === 'Tweaks Needed' && _calCompHasUnresolvedKasperTweak(post, comp)) {
            // "Approve after tweaks" is Kasper's explicit pre-clearance: he is
            // done with this component and has consented to skip his own
            // re-review, so his tweak must NOT drag it back into his queue.
            // Without this the card returns the moment he clicks, because
            // "approve after tweaks" writes exactly the pair this clause
            // matches -- Tweaks Needed plus an unresolved tweak of his own.
            // The clause still earns its keep for a plain "Request change",
            // where he does want the card in front of him; and a later
            // request-change calls _calClearApprovedAfterTweaks, so a real
            // re-review hand-off keeps the card visible again.
            if (_calShowApprovedAfterTweaks(post, comp)) return false;
            return true;
        }
        return false;
    }
    function _calPostKasperVisible(post) {
        return _calComponentsFor(post).some(c => _calCompKasperVisible(post, c));
    }
    /* THE COMPONENTS KASPER'S EXPANDED CARD ACTUALLY RENDERS — the one
       definition, so the badge and the card can never disagree.

       _calCompKasperVisible answers "is this Kasper's work" and admits a
       component for one of two reasons: (1) it is at Kasper Approval and his
       decision is pending, or (2) it sits at Tweaks Needed carrying an
       unresolved tweak of his, where the panel is a thread view. Only reason
       (1) needs the content itself: there is no honest Approve over a video
       that was never attached or a caption nobody wrote, so an unreviewable
       component pending decision keeps its panel closed (and
       _kasperUndecidedComps scopes it out of the Finish gate in the same
       breath). Reason (2) is a conversation, and a conversation needs no file
       — its Approve button is already hidden by `showApprove`.

       Applying the content rule to BOTH reasons was caught by Codex on PR 1252:
       it re-created the very defect the tweak chip was written to kill — the
       badge saying "3" while the expanded card shows two threads. That is why
       the chip and the renderer read this function and not their own copy. */
    function _kasperPanelComps(post) {
        return _calComponentsFor(post).filter(c => {
            if (!_calCompKasperVisible(post, c)) return false;
            if (_calNormStatus(post[c + '_status'] || '') === 'Kasper Approval') return _kasperCompReviewable(post, c);
            return true;
        });
    }
    /* Open-tweak count for Kasper's review-card chip. Same tally as
       _calOpenCommentCount, but SCOPED to the components Kasper can actually
       see/act on (_calCompKasperVisible) — i.e. those at Kasper Approval or
       carrying an unresolved tweak of his. A client change-request on a
       component that never reached him (e.g. a thumbnail still at Tweaks
       Needed with no tweak of his) is correctly hidden from his expanded
       card, so it must not inflate the chip either: otherwise the badge says
       "3" while opening the card shows only 2 (the bug Kasper hit on Alli
       Schaper's Lion's Mane card). The shared _calOpenCommentCount stays
       whole-card for the SMM calendar, which does show every component. */
    function _kasperOpenTweakCount(post) {
        if (!post) return 0;
        let n = 0;
        for (const c of _kasperPanelComps(post)) {
            const list = _calCommentsForView(post, c);
            if (!Array.isArray(list) || !list.length) continue;
            for (const root of _calCommentRoots(list)) {
                if (_calMsgIsTweak(root) && !root.done) n++;
            }
        }
        return n;
    }
    /* Whole-card: any unresolved Kasper tweak across any component. Used
       for the Done-reviewing button visibility and the card-stays rule. */
    function _calPostHasUnresolvedKasperTweak(post) {
        return _calComponentsFor(post).some(c => _calCompHasUnresolvedKasperTweak(post, c));
    }
    /* Newest message timestamp across every component (ignores tombstones).
       Used to detect "has anyone replied since Kasper last caught up?". */
    function _calLatestMsgAt(post) {
        let max = '';
        for (const c of _calComponentsFor(post)) {
            const list = _calCommentsFor(post, c);
            if (!Array.isArray(list)) continue;
            for (const m of list) {
                if (!m || m.deleted) continue;
                const t = String(m.updated_at || m.created_at || '');
                if (t > max) max = t;
            }
        }
        return max;
    }
    /* Like _calLatestMsgAt but ranks by created_at ONLY — "when was the newest
       message CREATED", ignoring later updated_at bumps. Resolving a tweak
       (mark-done) bumps its updated_at to now; that must NOT read as a brand-new
       message for Kasper's finish/close re-surface checks, or a finished card
       bounces back to "Waiting" the instant the SMM resolves an old comment while
       another component is still in tweaks. Used ONLY by the finish/close
       re-surface logic + the finish stamp (kept symmetric so "seen up to here" and
       "is there something newer?" use the same basis); _calLatestMsgAt stays the
       updated_at-based merge / seen / unread clock everywhere else. */
    function _calLatestMsgCreatedAt(post) {
        let max = '';
        for (const c of _calComponentsFor(post)) {
            const list = _calCommentsFor(post, c);
            if (!Array.isArray(list)) continue;
            for (const m of list) {
                if (!m || m.deleted) continue;
                const t = String(m.created_at || '');
                if (t > max) max = t;
            }
        }
        return max;
    }
    /* Components Kasper still owes a DECISION on: anything still at Kasper
       Approval. Only an explicit decision clears it — approving (moves it past
       Kasper Approval) or requesting a change (flips it to Tweaks Needed). A
       comment does NOT count: it's just a question, the component is still
       genuinely pending his call, so the card stays in his queue (never
       finished into limbo) until he actually decides — typically after the SMM
       answers. This is what keeps "Finish reviewing" honest and order-proof. */
    /* Is this component reviewable RIGHT NOW — as distinct from
     * `_calCompKasperVisible`, which asks whether it is Kasper's WORK.
     *
     * EVERY component needs the thing it is reviewed BY; only where that thing
     * is stored differs. A video is watched, so it needs its `asset_url`; a
     * thumbnail is looked at, so it needs its `thumbnail_url`; a caption and a
     * title are READ, so they need their text — `caption` or `caption_alt`
     * for the caption, `name` for the title. Before this existed the question
     * was asked once about the whole card ("does it carry any media"), which a
     * caption cannot answer — see OPEN_REPAIRS 135. The first fix for that
     * over-corrected and let text through unconditionally, which Codex caught
     * on #1252: an empty caption at Kasper Approval was admitted, so Kasper was
     * offered an enabled Approve over the "No caption yet." placeholder and
     * could sign off content nobody had written. Missing is missing; the
     * storage is an implementation detail.
     *
     * It has to be applied in all THREE places or it makes things worse rather
     * than better: admission to the queue, which panels render, and which
     * components block "Finish reviewing". Admitting a card on its caption and
     * then rendering an enabled Approve over a video that does not exist would
     * trap Kasper on a card he cannot finish — caught in review. The
     * unlinked-graphic clause in _kasperUndecidedComps is the same shape and
     * the precedent for it, and that function's comment records why the finish
     * gate and the fresh-ask test must read one set and not two. */
    /* THE canonical answer to "does this component have the thing it is asking
       to be reviewed". Deliberately self-contained: six suites compile this
       function in isolation, so a dependency here breaks them all. The
       calendar's status gate delegates TO this rather than the other way round
       (_calCompHasContent). */
    function _kasperCompReviewable(post, comp) {
        if (comp === 'video') return String((post && post.asset_url) || '').trim() !== '';
        if (comp === 'graphic') return String((post && post.thumbnail_url) || '').trim() !== '';
        if (comp === 'title') return String((post && post.name) || '').trim() !== '';
        if (comp === 'caption') {
            return String((post && post.caption) || '').trim() !== ''
                || String((post && post.caption_alt) || '').trim() !== '';
        }
        return true;
    }
    /* THE COMPONENTS KASPER STILL HAS TO DECIDE — one question, not two.
     *
     * Two gates, same rule: a component he cannot act on is not undecided, it
     * is out of scope. A graphic slot with no GRA sub-issue is out of scope
     * (the SMM cannot even re-route it — the pill is locked without a link),
     * and a video or thumbnail whose file never arrived is out of scope for the
     * same reason: there is nothing to watch or look at.
     *
     * THIS WAS BRIEFLY SPLIT IN TWO AND THAT WAS WRONG. The idea was that "has
     * something been re-sent to me?" and "what stops me finishing?" were
     * different questions, the first media-blind. They are not, and the split
     * created a limbo Codex caught on #1252: on a card with a written caption
     * and a fileless video both at Kasper Approval, deciding the caption
     * emptied the (media-aware) finish gate, so Finish was allowed — while the
     * (media-blind) finished test still saw the video as a fresh re-route and
     * returned false forever. The card could never leave Waiting, and clicking
     * Finish again could not help. The no-tweak branch was worse: it removed
     * the card and logged it Approved with a component still undecided.
     *
     * The suite already stated the rule the split ignored: its G3 case is "an
     * ACTIONABLE component is back at Kasper Approval → fresh ask", and G4 is
     * the unlinked graphic that is NOT actionable and must not un-finish the
     * card. A fileless video is G4, not G3. Nothing is lost by scoping it out:
     * _kasperRenderStrandedNotice reports it to the SMM by name, which is the
     * person who can fix it. See OPEN_REPAIRS 135. */
    function _kasperUndecidedComps(post) {
        return _calComponentsFor(post).filter(c =>
            !(c === 'graphic' && !_calCompLinked(post, c))
            && _kasperCompReviewable(post, c)
            && _calNormStatus(post[c + '_status'] || '') === 'Kasper Approval');
    }
    function _calCommentTotal(post) {
        let n = 0;
        for (const list of _calAllCommentLists(post)) n += list.length;
        return n;
    }
    function _calFmtCommentTime(iso) {
        const t = Date.parse(iso || '');
        if (!isFinite(t)) return '';
        const diff = Date.now() - t;
        const mins = Math.round(diff / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        const hrs = Math.round(mins / 60);
        if (hrs < 24) return hrs + 'h ago';
        const days = Math.round(hrs / 24);
        if (days < 7) return days + 'd ago';
        const d = new Date(t);
        return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }
    function _calAvatarInitial(name, role) {
        const s = String(name || '').trim();
        if (s) return s.charAt(0).toUpperCase();
        return role === 'client' ? 'C' : 'S';
    }

    // "Approved after tweaks" badge — rendered to the right of the Tweaks pill
    // on a card. Shows when ANY component is currently pre-cleared by Kasper and
    // still in flight (see _calShowApprovedAfterTweaks; hidden once Approved/
    // Scheduled/Posted, though the flag stays in the sheet as history).
    function _calAatBadgeHtml(post) {
        if (!post || !_calComponentsFor(post).some(c => _calShowApprovedAfterTweaks(post, c))) return '';
        return `<span class="cal-aat-badge" title="Kasper already approved this. Check the edit was made, then send it to the client."><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg></span>`;
    }
    function _calCommentsBtnHtml(post, pid) {
        // The round-5 badges (327), for the staff members switch unread_badges_v2 names; everyone else: below, unchanged.
        if (typeof svuActive === 'function' && svuActive()) return svuNotesBtnHtml(post, pid);
        const open = _calOpenCommentCount(post);
        const unread = _calHasUnreadNotes(post);
        const cls  = (open > 0 ? ' has-open' : '') + (unread ? ' has-unread' : '');
        const tip  = unread ? 'New replies. Open Notes.'
                   // The count is open top-level change requests only (replies and
                   // closed ones are not counted), so the badge says "N open" and
                   // the tooltip names what is being counted.
                   : (open > 0 ? `${open} open tweak${open === 1 ? '' : 's'}` : 'Notes');
        const ico  = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h11a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H7l-3 2.5V12H2.5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z"/></svg>`;
        // Tweaks pill + "Approved after tweaks" badge are kept in one left-
        // aligned group so the badge sits right next to the pill (the footer is
        // space-between, which would otherwise fling the badge to the far right).
        return `<span class="cal-foot-tweaks" data-comments-wrap="${pid}"><button type="button" class="cal-comments-btn${cls}" data-comments-btn="${pid}" onclick="openCalComments('${pid}')" onpointerenter="svCardNotesIntent('${pid}',120)" onfocus="svCardNotesIntent('${pid}',0)" onpointerdown="svCardNotesIntent('${pid}',0)" title="${_calEscAttr(tip)}">${ico}<span class="cal-comments-label">Notes</span>${unread ? '<span class="cal-comments-dot" aria-label="New replies"></span>' : ''}<span class="cal-comments-count">${open} open</span></button>${_calAatBadgeHtml(post)}</span>`;
    }
    function _calRefreshCommentsBtn(pid) {
        const sel = (window.CSS && CSS.escape) ? CSS.escape(pid) : pid;
        const wrap = document.querySelector(`.cal-foot-tweaks[data-comments-wrap="${sel}"]`);
        if (!wrap) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        _calV2Log('BADGE refresh →', pid, '| unread:', _calHasUnreadNotes(post), '| open:', _calOpenCommentCount(post));
        const tmp = document.createElement('div');
        tmp.innerHTML = _calCommentsBtnHtml(post, pid);
        const next = tmp.firstElementChild;
        // Every background refresh runs this for every card: one that changes
        // nothing must not swap the node (it would drop focus and hover).
        if (next && next.isEqualNode(wrap)) return;
        wrap.replaceWith(next);
    }

    let _calNotesHeld = '';
    function openCalComments(pid) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        /* A switched-on client link opens the Notes view with the player, but only once the player's switch has been
           read. Opened before that, the old dialog painted for a moment and then turned into the new view (owner
           feedback 2026-10-17, session Curtain Nine), so the open waits for the switch (up to the switch read's 4 s cut-off). Only a client the new page is on for waits:
           with Analytics hidden for everyone, svRsClientNoAnalytics is true on every client link. */
        if (_isClientLink && svRsClientReviewOn(calState.client)) {
            const wait = svFrameFlagWait(2500);
            if (wait) {
                _calNotesHeld = pid;
                wait.then(() => { if (_calNotesHeld === pid) { _calNotesHeld = ''; openCalComments(pid); } });
                return;
            }
        }
        _calNotesHeld = '';
        _calOpenCommentsPid = pid;
        _calReplyTarget = null;
        _calEditTarget = null;
        for (const k of Object.keys(_calReplyDrafts)) delete _calReplyDrafts[k];
        for (const k of Object.keys(_calEditDrafts)) delete _calEditDrafts[k];
        /* Wiped first because the map is shared across cards and its keys are
           comment ids from whichever card was open last, then refilled from
           THIS card's own store. An edit draft is deliberately not restored:
           it is a change to text the server already holds, so losing it costs a
           retype and never costs the only copy of anything. */
        Object.assign(_calReplyDrafts, _calReplyDraftsLoad(pid));
        // A half-written note survives an accidental close (Esc, mis-click on
        // the backdrop): the draft is kept per card for the tab's lifetime
        // and cleared on send.
        _calRootDraft = _calNoteDraftGet(pid);
        _calComposeAudience = 'internal';   // safe default each open
        _calComposeIsTweak = false;         // default to a plain comment
        _calComposeComp = 'video';          // Part B: picker defaults to Video
        _calShowResolved = false;           // start on the live feed, not history
        if (typeof svuNotesOpening === 'function') svuNotesOpening(pid);            // 327 keeps what was new, for "Needs you" (switch unread_badges_v2 only)
        _notesMarkSeen(pid);                // opening = caught up; clears the unread dot
        _calNotesWarm(pid, true);           // the read the pointer already started, or a new one
        const ovl = _calEnsureCommentsOverlay();
        if (!ovl) return;
        ovl.classList.add('open');
        document.body.classList.add('cal-modal-open');
        svFrameNotesUse(svFrameCommentsInNotesOn());   // 187 keeps a card's Frame.io comments for 5 minutes (switch on only)
        _calNotesStageSync(post);
        _calCommentsLayerOpen(pid);
        const _calNm = document.getElementById('calCommentsModal');
        if (_calNm) _calNm.removeAttribute('data-feed-pid');   // a fresh opening starts at the newest message
        _calRenderCommentsModal();
        // Auto-scroll the feed to the latest message and focus the composer.
        setTimeout(() => {
            const feed = document.getElementById('calCommentsFeed');
            if (feed) feed.scrollTop = feed.scrollHeight;
            const ta = document.getElementById('calCommentComposer');
            if (ta && !_calNotesPhoneWithVideo()) ta.focus();
        }, 30);
    }
    /* NOTES AS FAST AS POSSIBLE (Encore, 2026-10-16). Opening the dialog used to start the notes read: the card's
       link check, then the thread itself, one after the other (about 0.2 s and then about 1.8 s on the server). Now
       pointing at a door (the Notes button, the play button, hover after 120 ms, focus or press at once) starts the
       same read, so most of it is done before the click lands; the open reuses a read that is running or finished in
       the last few seconds instead of asking twice; and the link check and the thread are asked for side by side
       (_prodProjectCanonicalCardComments). Rows already held are drawn at once, as before. */
    const CAL_NOTES_REUSE_MS = 5000;
    const _calNotesWarmRuns = new Map();
    let _calNotesIntentTimer = 0;
    // fromOpen: the dialog is opening. A read the pointer started (running, or finished in the last few seconds and not
    // yet used by an open) is reused once; every other open reads again, so a reopen still picks up new notes.
    function _calNotesWarm(pid, fromOpen) {
        const key = String(pid || '');
        if (!key || !calState || !Array.isArray(calState.posts) || !calState.posts.some(p => p.id === key)) return null;
        const prev = _calNotesWarmRuns.get(key);
        const fresh = prev && (prev.running || (!prev.used && Date.now() - prev.at < CAL_NOTES_REUSE_MS));
        if (fresh && (fromOpen ? !prev.used : true)) { if (fromOpen) prev.used = true; return prev.done; }
        if (!fromOpen && prev && prev.running) return prev.done;
        const run = { at: Date.now(), running: true, done: null, used: !!fromOpen };
        // Started NOW, not on the next tick: the projection marks the card's link check as running before its first
        // wait, and Send reads that mark. Deferred, the dialog opened (and Send could be pressed) in a moment that
        // said "nothing is loading", then the check started and the note was refused as "still loading"
        // (Probe, 2026-10-17, OPEN_REPAIRS 431). The async wrapper still turns a thrown error into a rejection.
        run.done = (async () => _prodProjectCanonicalCardComments('calendar', key))()
            .catch(() => false)
            .finally(() => { run.running = false; run.at = Date.now(); });
        _calNotesWarmRuns.set(key, run);
        return run.done;
    }
    // A door is being pointed at: start the notes (and, for a card with a playable video, the video) now.
    function svCardNotesIntent(pid, delay) {
        clearTimeout(_calNotesIntentTimer);
        const go = () => {
            _calNotesWarm(pid);
            const post = calState && Array.isArray(calState.posts) ? calState.posts.find(p => p.id === pid) : null;
            if (post) svFrameWarm(post);
        };
        if (delay > 0) _calNotesIntentTimer = setTimeout(go, delay); else go();
    }
    // 187 (the play doors) starts the notes read through this, without importing this file.
    window.svCardNotesWarm = _calNotesWarm;
    /* ONE VIEW FOR THE VIDEO AND ITS NOTES (owner, 2026-10-16). When the card's video is a Frame.io link and the
       frame_viewer_clients switch allows its client, the Notes dialog grows a player on its left (on a phone, on top):
       the stage, owned by 187. Every door opens this same view: the Notes button, the Sheet's play icon, the Review
       tab's video preview and Kasper's "Watch here" (svOpenCardNotes, 326). Nothing plays until the person presses
       play. Without such a video, or with the switch off, the dialog is exactly the Notes dialog it always was: the
       shell around it takes no room (display: contents). */
    function _calEnsureCommentsOverlay() {
        let ovl = document.getElementById('calCommentsOverlay');
        if (ovl) return ovl;
        // A page that never drew the Calendar (Kasper's board) gets the same dialog, once, on the body.
        const wrap = document.createElement('div');
        wrap.innerHTML = _calCommentsOverlayHtml();
        ovl = wrap.firstElementChild;
        document.body.appendChild(ovl);
        return ovl;
    }
    function _calCommentsOverlayHtml() {
        return `<div class="cal-comments-overlay" id="calCommentsOverlay" data-backdrop-dismiss onclick="if(event.target===this&&this._backdropPressBegan)closeCalComments()">
                <div class="cal-notes-shell" id="calNotesShell">
                    <div class="cal-notes-stage" id="calNotesStage" role="region" aria-label="Video" hidden></div>
                    <div class="cal-comments-modal" id="calCommentsModal" role="dialog" aria-modal="true" aria-labelledby="calCommentsTitle"></div>
                </div>
            </div>`;
    }
    function _calNotesStageSync(post) {
        const shell = document.getElementById('calNotesShell');
        const stage = document.getElementById('calNotesStage');
        if (!shell || !stage) return false;
        // Trial reels (189): the version on screen plays, and its switch sits under the player.
        const vp = post ? svTrialNotesPost(post) : post;
        const on = !!post && svFrameStageMount(stage, vp, _calDeriveThumb(post));
        if (!on) { svFrameStageUnmount(); stage.hidden = true; }
        shell.toggleAttribute('data-video', on);
        shell.querySelectorAll('.trl-notes-sw').forEach(n => (n.parentNode && n.parentNode.classList.contains('trl-notes-bar') ? n.parentNode : n).remove());
        const sw = on ? svTrialNotesSwitchHtml(post) : '';
        if (sw) {
            const foot = stage.querySelector('.fv-stage-foot');
            // Wide: beside "Open in Frame.io". Phone: the player's own buttons sit over the video, so a slim bar under it.
            if (foot && !(window.matchMedia && window.matchMedia('(max-width: 767px)').matches)) { foot.classList.add('trl-foot'); foot.insertAdjacentHTML('afterbegin', sw); }
            else stage.insertAdjacentHTML('afterend', '<div class="trl-notes-bar">' + sw + '</div>');
        }
        return on;
    }
    function _calNotesPhoneWithVideo() {
        const shell = document.getElementById('calNotesShell');
        return !!(shell && shell.hasAttribute('data-video') && window.matchMedia && window.matchMedia('(max-width: 767px)').matches);
    }
    // The Frame.io comments arrived (or failed), or the switch changed: the open card's view is drawn again, keeping
    // whatever is being typed.
    window.addEventListener('sv-frame-feed', (e) => {
        const pid = _calOpenCommentsPid;
        if (!pid || (e && e.detail && e.detail.pid && e.detail.pid !== pid)) return;
        // A Frame.io comments read for a link (frame_comments_in_notes_staff): only the open card's own link redraws.
        if (e && e.detail && e.detail.link && e.detail.link !== svFrameNotesLink(svTrialNotesPost(calState.posts.find(p => p.id === pid)))) return;
        _calCaptureModalDrafts();
        _calRenderCommentsModal({ keepFocus: true });
    });
    // The staff switches came in (188): a Notes view already open picks up frame_comments_in_notes_staff.
    window.addEventListener('sv-review-stage-switch', () => {
        if (!_calOpenCommentsPid || _isClientLink || !svFrameCommentsInNotesOn()) return;
        _calCaptureModalDrafts();
        _calRenderCommentsModal({ keepFocus: true });
    });
    // Trial reels (189): another version picked under the player, or the card's versions read: the player, its Frame.io
    // comments and the words that name the version follow, keeping whatever is being typed.
    window.addEventListener('sv-trial-notes', (e) => {
        const pid = _calOpenCommentsPid;
        if (!pid || (e && e.detail && e.detail.pid && e.detail.pid !== pid)) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        _calNotesStageSync(post);
        _calCaptureModalDrafts();
        _calRenderCommentsModal({ keepFocus: true });
    });
    window.addEventListener('sv-frame-switch', () => {
        const pid = _calOpenCommentsPid;
        if (!pid) return;
        const post = calState.posts.find(p => p.id === pid);
        const shell = document.getElementById('calNotesShell');
        const had = !!(shell && shell.hasAttribute('data-video'));
        if (_calNotesStageSync(post) === had && !had) return;
        _calCaptureModalDrafts();
        _calRenderCommentsModal({ keepFocus: true });
    });
    /* The Notes panel is a layer: Escape and a click on the backdrop close it
       (closeCalComments keeps the typed note as a draft, as before), and focus
       goes back to the card's Notes button. While a reply or an edit is being
       written, the first Escape leaves that reply or edit, as it always did,
       and the next one closes the panel. Staff only. */
    function _calCommentsLayerOpen(pid) {
        if (_isClientLink) return;
        svLayerOpen({
            key: 'cal-notes',
            holdRefresh: false,   // lives outside the redrawn card list
            region: '#calNotesShell',
            opener: () => document.querySelector('[data-comments-btn="' + (window.CSS && CSS.escape ? CSS.escape(pid) : pid) + '"]'),
            isOpen: () => !!document.querySelector('#calCommentsOverlay.open'),
            escape: () => {
                if (!(_calReplyTarget || _calEditTarget)) return false;
                if (_calEditTarget) _calBeginCommentEdit(null); else _calBeginReply(null);
                return true;
            },
            close: () => closeCalComments(),
        });
    }
    /* The client link has no layer stack (the staff pages' Escape rules are not wired there), so the Notes box only closed
       on Escape while its own message box had focus: with focus on the video's controls, a button or nowhere, Escape did
       nothing, and the "Your approval was not saved" box never closed on Escape at all (client gauntlet 2). Here the key
       closes whatever sits on top, the confirm or notice first, unless a field already used it. */
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || e.defaultPrevented || e.isComposing || !_isClientLink || !svRsClientReviewOn(calState.client)) return;   // the old client page (switch off) is left as it was
        const t = e.target, tag = ((t && t.tagName) || '').toLowerCase();
        if (tag === 'textarea' || tag === 'input' || (t && t.isContentEditable)) return;
        const c = document.getElementById('confirmOverlay');
        if (c && c.classList.contains('active')) { e.preventDefault(); dismissConfirm(); return; }
        const n = document.getElementById('calCommentsOverlay');
        if (n && n.classList.contains('open') && !(_calReplyTarget || _calEditTarget)) { e.preventDefault(); closeCalComments(); }
    });
    function closeCalComments() {
        _calEnterWhenReady = '';
        svLayerRelease('cal-notes');
        const ovlOpen = document.getElementById('calCommentsOverlay');
        if (!ovlOpen || !ovlOpen.classList.contains('open')) return;
        _calCaptureModalDrafts();
        const ovl = document.getElementById('calCommentsOverlay');
        if (ovl) ovl.classList.remove('open');
        document.body.classList.remove('cal-modal-open');
        _calNotesStageSync(null);
        const pid = _calOpenCommentsPid;
        _calOpenCommentsPid = null;
        _calReplyTarget = null;
        _calEditTarget = null;
        // Caught up while it was open — re-stamp seen and refresh the button so
        // the unread dot clears immediately.
        if (pid) { _notesMarkSeen(pid); _calRefreshCommentsBtn(pid); }
    }
    function _calCaptureModalDrafts() {
        const root = document.getElementById('calCommentsModal');
        if (!root) return;
        const composer = root.querySelector('#calCommentComposer');
        if (composer) {
            if (_calEditTarget) _calEditDrafts[_calEditTarget] = composer.value;
            else if (_calReplyTarget) {
                _calReplyDrafts[_calReplyTarget] = composer.value;
                _calReplyDraftsPersist(_calOpenCommentsPid);
            }
            else _calRootDraft = composer.value;
        }
    }

    function _calRenderCommentsModal(opts) {
        const pid = _calOpenCommentsPid;
        const modal = document.getElementById('calCommentsModal');
        if (!modal || !pid) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) { closeCalComments(); return; }
        const videoComments = Array.isArray(post.comments) ? post.comments : _calLoadComments(post);
        post.comments = videoComments;
        // Build a per-component view: each component contributes its own
        // thread set, tagged so the SMM can see (and reply to / resolve)
        // tweak requests from the client across video, thumbnail, and caption
        // in one feed. _calCommentsForView strips Kasper-role entries when
        // the viewer is on the client-link surface.
        const compThreads = _calComponentsFor(post).flatMap(c => {
            const list = _calCommentsForView(post, c);
            if (!Array.isArray(list) || !list.length) return [];
            return _calCommentRoots(list).map(r => ({ comp: c, list, root: r }));
        });
        // This person's notes still on their way (or not sent): roots join the
        // feed as their own threads, replies sit under the note they answer.
        const outboxReplies = new Map();
        // A send cut off by a refresh or a closed tab whose note the reloaded
        // thread now holds did arrive: its outbox entry has done its job. A
        // FAILED entry is never dropped here: a refused card save leaves the
        // note in this page's local thread, which is not a server receipt.
        // It goes only on a confirmed retry, or Discard.
        _noteOutboxFor(pid, e => !_noteOutboxLive.has(e.id) && e.state === 'sending' && _noteOutboxInList(post, e.id)).forEach(e => _noteOutboxDrop(e.id));
        // Waiting or refused notes already in the local thread keep their mark.
        const outboxMarks = new Map(_noteOutboxFor(pid, e => _noteOutboxInList(post, e.id)).map(e => [e.id, _noteOutboxAsComment(e)]));
        _noteOutboxFor(pid, e => !_noteOutboxInList(post, e.id)).forEach(e => {
            const c = _noteOutboxAsComment(e);
            if (!e.parent_id) { compThreads.push({ comp: e.comp || 'video', list: [c], root: c }); return; }
            if (!outboxReplies.has(e.parent_id)) outboxReplies.set(e.parent_id, []);
            outboxReplies.get(e.parent_id).push(c);
        });
        // The Frame.io comments on the card's video (staff, with the player open): one conversation with the notes,
        // in time order, each row marked "Frame.io". Read only: they are answered in Frame.io.
        // Switch frame_comments_in_notes_staff: without the player, the same rows come from 187's kept read.
        const fioNotesOn = svFrameCommentsInNotesOn();
        svFrameNotesUse(fioNotesOn);
        const fio = svFrameFeed(pid) || (fioNotesOn ? svFrameNotesFeed(svTrialNotesPost(post)) : null);
        if (fio && fio.state === 'ok') fio.comments.forEach(c => {
            const id = 'fio_' + String(c.id).replace(/[^A-Za-z0-9_-]/g, '');
            const root = { id, _fio: true, author: c.author, body: c.text, created_at: c.created_at, done: c.done, time: c.time };
            const list = [root].concat(c.replies.map((r, i) => ({ id: id + '_' + i, _fio: true, parent_id: id, author: r.author, body: r.text, created_at: r.created_at })));
            compThreads.push({ comp: 'frameio', list, root });
        });
        // Sort all roots chronologically across components.
        compThreads.sort((a, b) => String(a.root.created_at || '').localeCompare(String(b.root.created_at || '')));
        // Resolved threads (done change-requests) are history — hidden from the
        // live feed unless the user opens history via the top-right icon.
        const resolvedCount = compThreads.filter(e => e.root.done).length;
        const visibleThreads = _calShowResolved ? compThreads : compThreads.filter(e => !e.root.done);
        const trialLetter = svTrialNotesLetter(post);
        const postName = _calEsc(post.name || 'Untitled post') + (trialLetter ? ' · Video ' + _calEsc(trialLetter) : '');

        const renderFioRow = (c, isReply) => {
            const t = (!isReply && c.time != null && isFinite(c.time)) ? Math.max(0, Number(c.time)) : null;
            const tc = t == null ? '' : (fio && fio.seekable === false)
                ? `<span class="cal-cm-tc is-static" title="The moment in the video">${svFrameTime(t)}</span>`
                : `<button type="button" class="cal-cm-tc" onclick="svFrameSeek(${t})" title="Show this moment in the video">${svFrameTime(t)}</button>`;
            const doneTag = (!isReply && c.done) ? `<span class="cal-cm-done-tag">Resolved</span>` : '';
            return `<div class="cal-cm-row is-frameio${isReply ? ' is-reply' : ''}" data-cm-row="${c.id}"${t == null ? '' : ` data-fio-t="${t}"`}>
                <div class="cal-cm-avatar is-frameio">${c.author ? _calEsc(_calAvatarInitial(c.author)) : '?'}</div>
                <div class="cal-cm-body-col">
                    <div class="cal-cm-head-line">
                        <span class="cal-cm-author${c.author ? '' : ' is-guest'}">${_calEsc(c.author || 'Guest reviewer')}</span>
                        <span class="cal-cm-time">${_calEsc(_calFmtCommentTime(c.created_at))}</span>
                        ${doneTag}
                        ${isReply ? '' : '<span class="cal-cm-src-label" title="A comment left in Frame.io. Reply to it there.">Frame.io</span>'}
                    </div>
                    <div class="cal-cm-row-body">${tc}${_calEsc(c.body || '')}</div>
                </div>
            </div>`;
        };
        const renderRow = (c, isReply, comp) => {
            if (c._fio) return renderFioRow(c, isReply);
            if (!c._outbox && outboxMarks.has(c.id)) {
                const mark = outboxMarks.get(c.id);
                c = Object.assign({}, c, { _outbox: mark._outbox, _outboxError: mark._outboxError });
            }
            const roleCls = c.role === 'client' ? 'is-client' : 'is-smm';
            const author  = _calNoteAuthorName(c, c.role === 'client' ? 'Client' : 'SMM');
            const initial = _calAvatarInitial(author, c.role);
            const doneTag = (!isReply && c.done) ? `<span class="cal-cm-done-tag">Resolved</span>` : '';
            // Which deliverable — named, pushed to the top-right of the row to
            // use the empty space there instead of a cryptic colour dot.
            const compLabel = (!isReply && comp) ? `<span class="cal-cm-comp-label cal-cm-comp-${comp}">${_calEsc(COMP_LABELS[comp])}</span>` : '';
            // Internal threads get a bare lock icon — no word. No lock = the
            // client can see it.
            // Who the thread is for, as a small tag on the first message (staff
            // view only; the client only ever sees their own threads).
            const lock = (isReply || _isClientLink) ? ''
                : _calMsgAudience(c) === 'internal'
                ? `<span class="cal-cm-to-tag is-team" title="Team only. The client can’t see this.">${_CAL_LOCK_ICO}Team only</span>`
                : c.role === 'client' ? ''
                : `<span class="cal-cm-to-tag is-client" title="The client can see this thread.">To client</span>`;
            // Only change-requests get a tag — sits right after the name.
            const typeTag = (!isReply && _calMsgIsTweak(c))
                ? `<span class="cal-cm-type-tag is-tweak" title="Tweaks. Moves the card to Tweaks Needed.">Tweak${c.round ? ' #' + c.round : ''}</span>`
                : '';
            const editedTag = c.edited ? '<span class="prod-comment-edited">(edited)</span>' : '';
            const attachments = Array.isArray(c.attachments) && c.attachments.length
                ? '<div class="prod-comment-attachments">' + c.attachments.map(item =>
                    '<a class="prod-comment-attachment" href="' + _calEscAttr(item.url) + '" target="_blank" rel="noopener noreferrer">' + _calEsc(item.name || 'Attachment') + '</a>'
                ).join('') + '</div>'
                : '';
            return `<div class="cal-cm-row${isReply ? ' is-reply' : ''}${c._outbox ? ' is-outbox is-outbox-' + c._outbox : ''}" data-cm-row="${c.id}">
                <div class="cal-cm-avatar ${roleCls}">${_calEsc(initial)}</div>
                <div class="cal-cm-body-col">
                    <div class="cal-cm-head-line">
                        <span class="cal-cm-author">${_calEsc(author)}</span>
                        ${typeTag}
                        ${lock}
                        <span class="cal-cm-time">${_calEsc(_calFmtCommentTime(c.created_at))}</span>
                        ${doneTag}
                        ${compLabel}
                    </div>
                    <div class="cal-cm-row-body">${c.deleted ? 'Comment deleted.' : _calEsc(c.body || '')}${editedTag}${attachments}</div>
                    ${_noteOutboxStatusHtml(c)}
                </div>
                ${c._outbox ? '' : _calCommentActionsHtml(c, isReply, !c.canonical || (!post._calCommentActionBusy && _prodCanonicalCommentGate(post, comp || c.component).ready))}
            </div>`;
        };

        // Reddit-style: replies sit under the message they answer, with a thin
        // rail on the left that folds the thread to a "n replies" link.
        const renderThread = (entry) => {
            const replies = _calCommentReplies(entry.list, entry.root.id).concat(outboxReplies.get(entry.root.id) || []);
            outboxReplies.delete(entry.root.id);
            const rootArg = _jsAttrArg(entry.root.id);
            const collapsed = replies.length > 0 && _calCollapsedThreads.has(entry.root.id);
            const count = `${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`;
            const branch = !replies.length ? '' : `<div class="cal-cm-replies">
                    <button type="button" class="cal-cm-rail" onclick="_calToggleThreadCollapse(${rootArg})" aria-expanded="${collapsed ? 'false' : 'true'}" title="${collapsed ? 'Show' : 'Hide'} ${count}"><span class="cal-cm-sr">${collapsed ? 'Show' : 'Hide'} ${count}</span></button>
                    ${collapsed
                        ? `<button type="button" class="cal-cm-more-replies" onclick="_calToggleThreadCollapse(${rootArg})">${count}</button>`
                        : replies.map(r => renderRow(r, true, entry.comp)).join('')}
                </div>`;
            return `<div class="cal-cm-thread${entry.root.done ? ' is-done' : ''}${collapsed ? ' is-collapsed' : ''}" data-thread="${entry.root.id}">
                ${renderRow(entry.root, false, entry.comp)}
                ${branch}
            </div>`;
        };
        const roots = visibleThreads;
        const comments = videoComments;

        let emptyMsg = _calShowResolved
            ? `<div class="cal-comments-empty"><div class="cal-comments-empty-title">Nothing here</div>No resolved items.</div>`
            : (resolvedCount
                ? `<div class="cal-comments-empty"><div class="cal-comments-empty-title">All clear</div>No open notes — resolved items are in history (top right).</div>`
                : `<div class="cal-comments-empty"><div class="cal-comments-empty-title">No notes yet</div>Start the conversation — type below.</div>`);
        // While the Frame.io comments are on their way, rows shaped like the final ones stand in for them; no box.
        let fioTail = '';
        // Without the player (frame_comments_in_notes_staff) nothing stands in while they load (Notes paints as it
        // always did), and a failed read is one muted line.
        const fioQuiet = !!fio && fio.seekable === false;
        if (fio && fio.state === 'loading' && fioQuiet) fioTail = '';
        else if (fio && fio.state === 'error' && fioNotesOn) fioTail = '<div class="cal-cm-fio-note is-quiet" role="status">Frame.io comments could not be loaded.</div>';
        else if (fio && fio.state === 'loading') fioTail = _calFioSkeletonHtml();
        else if (fio && fio.state === 'error') fioTail = '<div class="cal-cm-fio-note">The Frame.io comments could not be loaded. <button type="button" class="cal-cm-fio-retry" onclick="svFrameFeedRetry()">Try again</button></div>';
        else if (fio) {
            if (fio.partial) fioTail += '<div class="cal-cm-fio-note">Some Frame.io comments could not be loaded just now.</div>';
            if (fio.truncated) fioTail += '<div class="cal-cm-fio-note">Showing the first Frame.io comments only. The rest are in Frame.io.</div>';
            if (fio.namesPartial) fioTail += '<div class="cal-cm-fio-note">Some Frame.io reply names are not shown.</div>';
        }
        // No notes yet and the Frame.io comments still loading: their stand-in rows say enough, no empty message.
        if (fio && fio.state === 'loading' && !fioQuiet) emptyMsg = '';
        const threadsHtml = roots.map(renderThread).join('');
        // A reply whose thread is not on screen (resolved, or history hidden)
        // still shows, on its own, so it is never out of sight while waiting.
        const strayReplies = [...outboxReplies.values()].flat().map(c => `<div class="cal-cm-thread">${renderRow(c, true, '')}</div>`).join('');
        if (roots.length || strayReplies) _prodCommentsFeedHasRows(post);
        const feedHtml = (roots.length || strayReplies) ? threadsHtml + strayReplies : _prodCommentsEmptyFeedHtml(post, 'calendar', emptyMsg);

        // History toggle (top-right): hidden unless there's something resolved.
        const histBtn = resolvedCount
            ? `<button class="cal-comments-hist${_calShowResolved ? ' is-active' : ''}" type="button" onclick="_calToggleShowResolved()" title="${_calShowResolved ? 'Hide resolved' : 'Show resolved (' + resolvedCount + ')'}" aria-label="Toggle resolved history"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4.5V8l2.5 1.5"/><path d="M2.6 8a5.4 5.4 0 1 0 1.5-3.7M2.5 3v2.2h2.2"/></svg>${_calShowResolved ? '' : `<span class="cal-comments-hist-count">${resolvedCount}</span>`}</button>`
            : '';
        const actionFailure = post._canonicalCommentActionError
            ? _writeUiCommentActionFailureHtml(
                post._canonicalCommentActionError,
                '_writeUiRetryCardCommentAction(\'calendar\',' + _jsAttrArg(pid) + ')'
            )
            : '';

        /* The conversation opens at its newest message and stays there while new ones arrive, unless the reader has
           scrolled up (Settle, 2026-10-18). Every redraw (the notes read landing, the Frame.io comments, a send) used to
           reset the feed to the top unless the caller asked to keep the focus, so a long thread opened part way up.
           A feed left by ANOTHER card (or by an earlier opening of this one) does not count as a place to keep. */
        const prevFeed = modal.getAttribute('data-feed-pid') === pid ? document.getElementById('calCommentsFeed') : null;
        const keep = !!(opts && opts.keepFocus);
        const hadFocus = !!(document.activeElement && document.activeElement.id === 'calCommentComposer');
        const atBottom = !prevFeed || prevFeed.scrollHeight - prevFeed.scrollTop - prevFeed.clientHeight < 40;
        const prevTop = prevFeed ? prevFeed.scrollTop : 0;
        modal.innerHTML = `
            <div class="cal-comments-head">
                <div class="cal-comments-head-text">
                    <h3 id="calCommentsTitle">${_calShowResolved ? 'Resolved' : 'Notes'}</h3>
                    <p>${postName}</p>
                </div>
                ${histBtn}
                <button class="cal-comments-close" type="button" onclick="closeCalComments()" aria-label="Close"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg></button>
            </div>
            ${actionFailure}
            <div class="cal-comments-feed" id="calCommentsFeed">
                <div class="cal-comments-feed-inner">${feedHtml}${fioTail}</div>
            </div>
            ${_calComposerHtml(post, comments)}`;
        _svPhoneNotesPresentation();
        modal.setAttribute('data-feed-pid', pid);
        {
            const feed = document.getElementById('calCommentsFeed');
            if (feed) {
                feed.scrollTop = atBottom ? feed.scrollHeight : prevTop;
                // Fonts and images settle a frame later and make the thread taller: follow it down, but only if the
                // reader has not moved the feed in the meantime.
                if (atBottom) requestAnimationFrame(() => {
                    const f = document.getElementById('calCommentsFeed');
                    if (f && f === feed && f.scrollHeight - f.scrollTop - f.clientHeight < 40) f.scrollTop = f.scrollHeight;
                });
            }
        }
        if (_calEnterWhenReady) {
            const queuedBtn = modal.querySelector('.cal-cm-send');
            if (_calEnterWhenReady !== pid) _calEnterWhenReady = '';
            else if (queuedBtn && !queuedBtn.hasAttribute('data-send-pending')) {
                _calEnterWhenReady = '';
                setTimeout(() => { if (_calOpenCommentsPid === pid) _calSubmitComposer(); }, 0);
            }
        }
        const ta = document.getElementById('calCommentComposer');
        if (ta) {
            _calAutosizeComposer(ta);
            // A redraw for the Frame.io comments leaves the focus where it was; on a phone with the video on top the
            // keyboard is not opened by itself.
            if (keep ? hadFocus : !_calNotesPhoneWithVideo()) {
                ta.focus();
                const v = ta.value; ta.value = ''; ta.value = v;
            }
        }
    }
    function _calFioSkeletonHtml() {
        const row = (long) => '<div class="cal-cm-skel-row"><span class="cal-cm-skel cal-cm-skel-avatar"></span><span class="cal-cm-skel-col"><span class="cal-cm-skel cal-cm-skel-line is-short"></span><span class="cal-cm-skel cal-cm-skel-line' + (long ? ' is-long' : '') + '"></span></span></div>';
        return '<div class="cal-cm-skeleton cal-cm-fio-skeleton" role="status" aria-busy="true" aria-label="Loading the Frame.io comments">' + row(true) + row(false) + '</div>';
    }

    function _calCanDeleteComment(c) {
        // SMM can delete anything; the client can only delete their own.
        return _calCommentRole() === 'smm' || c.role === 'client';
    }
    function _calCanResolveComment() {
        // Only the SMM resolves threads — the client never marks anything done.
        return _calCommentRole() === 'smm';
    }
    /* `threadReady` is false while this card's comment thread (the canonical
       store) is still loading. The write path refuses every lifecycle action in
       that window (canonical_comment_read_required): the refusal log showed
       real people clicking Edit, Reply or Mark done before the thread landed
       and getting a "reload" message for a click the page had offered them.
       So the buttons are drawn disabled until the read lands; the modal
       re-renders when it does. Legacy (non-canonical) comments are unaffected. */
    function _calCommentActionsHtml(c, isReply, threadReady = true) {
        if (c.deleted) return '';
        const wait = threadReady ? '' : ' disabled aria-disabled="true"';
        const waitTitle = title => threadReady ? title : 'Notes are still loading';
        const replyIco  = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4.5L1.5 8L5 11.5M1.5 8h7a4 4 0 0 1 4 4"/></svg>`;
        const checkIco  = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.5L6 11l5.5-7"/></svg>`;
        const undoIco   = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3.5L2 7l3.5 3.5M2 7h7a3.5 3.5 0 0 1 0 7"/></svg>`;
        const trashIco  = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4h9M5.5 4V2.5h3V4M3.5 4l.5 8.5h6L10.5 4M6 6.5v4M8 6.5v4"/></svg>`;
        // Replies share the parent thread's "done" state — only the root gets
        // the resolve toggle, and only the SMM ever sees that toggle.
        const rootId = isReply ? c.parent_id : c.id;
        const replyBtn = c.done ? '' : `<button class="cal-cm-action" type="button"${wait} onclick="_calBeginReply(${_jsAttrArg(rootId)})" title="${waitTitle('Reply')}">${replyIco}<span>Reply</span></button>`;
        const editBtn = c.canonical && c.can_edit
            ? `<button class="cal-cm-action" type="button"${wait} onclick="_calBeginCommentEdit(${_jsAttrArg(c.id)})" title="${waitTitle('Edit')}"><span>Edit</span></button>`
            : '';
        // Resolve toggle is only meaningful on a change-request (tweak). A plain
        // comment is a conversation, not a task, so it gets no "Mark done".
        const canResolve = c.canonical ? c.can_resolve : (_calCanResolveComment() && _calMsgIsTweak(c));
        const doneBtn  = (!isReply && canResolve)
            ? (c.done
                ? `<button class="cal-cm-action is-done-on" type="button"${wait} onclick="_calToggleCommentDone(${_jsAttrArg(c.id)})" title="${waitTitle('Reopen')}">${undoIco}<span>Reopen</span></button>`
                : `<button class="cal-cm-action" type="button"${wait} onclick="_calToggleCommentDone(${_jsAttrArg(c.id)})" title="${waitTitle('Mark thread done')}">${checkIco}<span>Mark done</span></button>`)
            : '';
        const canDelete = c.canonical ? c.can_delete : _calCanDeleteComment(c);
        const delBtn = canDelete
            ? `<button class="cal-cm-action is-danger" type="button"${wait} onclick="_calDeleteComment(${_jsAttrArg(c.id)})" title="${waitTitle('Delete')}">${trashIco}<span>Delete</span></button>`
            : '';
        if (!replyBtn && !editBtn && !doneBtn && !delBtn) return '';
        return `<div class="cal-cm-actions">${replyBtn}${editBtn}${doneBtn}${delBtn}</div>`;
    }

    /* Sending waits while this deliverable's canonical read is in flight, and
       while the card's crosswalk is being looked up, on every open: until that
       lookup lands, neither the store a note belongs in nor whether an earlier
       'ready' verdict still describes this card's binding is known. */
    function _calCommentSendPending(post, gate) {
        if (gate.linked && !gate.ready) return true;
        return _prodCrosswalkInFlight(post);
    }
    function _calComposerHtml(post, comments) {
        const role     = _calCommentRole();
        const author   = _calCurrentAuthor();
        const initial  = _calAvatarInitial(author, role);
        const roleCls  = role === 'client' ? 'is-client' : 'is-smm';
        const isReply  = !!_calReplyTarget;
        const isEdit   = !!_calEditTarget;
        // Reply target may live on any component's thread — look across all.
        const allLists = _calComponentsFor(post).map(c => c === 'video'
            ? (Array.isArray(post.comments) ? post.comments : _calLoadComments(post))
            : _calCommentsFor(post, c));
        const targetId = isEdit ? _calEditTarget : _calReplyTarget;
        const target   = targetId
            ? allLists.flatMap(l => l).find(c => c && c.id === targetId)
            : null;
        const draft    = isEdit
            ? (_calEditDrafts[_calEditTarget] || '')
            : isReply ? (_calReplyDrafts[_calReplyTarget] || '') : (_calRootDraft || '');
        const placeholder = isEdit
            ? 'Edit this note...'
            : isReply
            ? `Reply to ${target ? (_calNoteAuthorName(target, 'thread')) : 'thread'}…`
            : _calComposePlaceholder(role);
        const replyingTo = target
            ? `<div class="cal-cm-replying-to">${isEdit ? 'Editing' : 'Replying to'} <strong>${_calEsc(_calNoteAuthorName(target, 'thread'))}</strong> <button class="cal-cm-cancel-reply" type="button" onclick="${isEdit ? '_calBeginCommentEdit(null)' : '_calBeginReply(null)'}" title="Cancel"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="1" y1="1" x2="9" y2="9"/><line x1="9" y1="1" x2="1" y2="9"/></svg></button></div>`
            : '';
        const lockIco = `<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6.5" width="8" height="5" rx="1"/><path d="M4.75 6.5V5a2.25 2.25 0 0 1 4.5 0v1.5"/></svg>`;
        // SMM starting a NEW thread picks who can see it. A reply inherits its
        // root's audience, so the toggle only shows on a fresh root; the client
        // has no toggle (everything they post is shared with them by nature).
        const canonicalGate = _prodCanonicalCommentGate(post, (isReply || isEdit) && target
            ? _calFindCompForCommentId(post, target.id)
            : _calComposeComp);
        if (canonicalGate.linked && !canonicalGate.ready && canonicalGate.status === 'error') {
            return '<div class="cal-comments-empty"><div class="cal-comments-empty-title">Notes could not load</div>'
                + '<button type="button" class="prod-comment-state-action" onclick="_prodProjectCanonicalCardComments(\'calendar\',' + _jsAttrArg(post.id) + ')">Retry</button>'
                + '</div>';
        }
        /* While this exact deliverable's canonical read is still in flight the
           composer is drawn in full, so the first paint is the final layout,
           and only sending waits: the send button stays disabled (its tooltip
           says why) and _calAppendComment refuses on the same gate. No line of
           text is added under the box: it came and went and moved the layout
           (owner, 2026-10-16). Round 9 (switch unread_badges_v2, staff): Send no longer waits; the note is taken
           at once and goes when the notes have loaded (_calNotesStillLoading). */
        const sendPending = _calCommentSendPending(post, canonicalGate) && !_calNotesStillLoading(post, canonicalGate);
        // Staff starting a new thread: the audience lives INSIDE the box as one
        // icon (lock = team, eye = client) and "Request change" sits behind the
        // small arrow of the Send button, so the default (a comment to Kasper /
        // the team about the selected part) needs no clicks. A reply inherits
        // its root's audience and part, so it gets neither. The client has no
        // audience choice (everything they post is shared with them by nature).
        const staffRoot = !isReply && !isEdit && role !== 'client';
        // "To client" only where the client will actually read it: the card's
        // own notes (no canonical thread for this part) or a canonical thread
        // the client is authorized to read. A calendar client can never read a
        // canonical thread, so there it stays team only rather than vanish.
        const canPickClient = staffRoot && (!canonicalGate.linked || canonicalGate.client);
        if (!canPickClient && _calComposeAudience === 'client') _calComposeAudience = 'internal';
        const toClient = staffRoot && _calComposeAudience === 'client';
        const audienceIcon = canPickClient
            ? `<button type="button" class="cal-cm-aud-icon" onclick="_calToggleComposeAudience()" aria-pressed="${toClient ? 'true' : 'false'}" title="${toClient ? 'The client can see this. Click for team only.' : 'Team only. Click to write to the client.'}" aria-label="${toClient ? 'The client can see this. Click for team only.' : 'Team only. Click to write to the client.'}">${toClient ? _CAL_EYE_ICO : _CAL_LOCK_ICO}</button>`
            : '';
        // Client picks comment vs change request. Default comment, so a reply or
        // a question never flips the post to Tweaks Needed.
        const changeToggle = (!isReply && !isEdit && role === 'client')
            ? `<div class="cal-cm-audience" data-cm-toggle="tweak" role="group" aria-label="Comment or change request">
                <span class="cal-cm-audience-cap">This is a…</span>
                <div class="cal-cm-aud-seg">
                    <button type="button" class="cal-cm-aud-btn${!_calComposeIsTweak ? ' is-active' : ''}" data-tweak="0" onclick="_calSetComposeIsTweak(false)" title="Ask or comment. This doesn’t change the status.">Comment</button>
                    <button type="button" class="cal-cm-aud-btn${_calComposeIsTweak ? ' is-active' : ''}" data-tweak="1" onclick="_calSetComposeIsTweak(true)" title="Ask for tweaks. Moves the card to Tweaks Needed.">Request a change</button>
                </div>
            </div>`
            : '';
        // Component picker (Part B) — which deliverable this NEW root note is
        // about. Shown on a fresh root for the SMM and the client alike; replies
        // inherit their thread's component so they get no picker. Offers the
        // card's active review components (Title appears once the title is an
        // engaged review component); defaults to Video.
        const compPicker = !isReply && !isEdit
            ? `<div class="cal-cm-audience" data-cm-toggle="comp" role="group" aria-label="Which deliverable is this note about">
                <span class="cal-cm-audience-cap">About the…</span>
                <div class="cal-cm-aud-seg">${_calComponentsFor(post).map(c =>
                    `<button type="button" class="cal-cm-aud-btn${_calComposeComp === c ? ' is-active' : ''}" data-comp="${c}" onclick="_calSetComposeComp('${c}')" title="About the ${_calEscAttr(String(COMP_LABELS[c] || c).toLowerCase())}">${_calEsc(c === 'video' && svTrialNotesLetter(post) ? 'Video ' + svTrialNotesLetter(post) : (COMP_LABELS[c] || c))}</button>`
                ).join('')}</div>
            </div>`
            : '';
        const sendIco = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5L13.5 8L9 12.5"/></svg>`;
        const draftNote = (!isReply && !isEdit && draft && _calRootDraftRestored)
            ? _svDraftNoteHtml(`onclick="_calNoteDraftDiscard()"`, _calRootDraftRestored === 'sending' ? '(it may already have been sent: check the thread before sending again)' : '')
            : '';
        return `<div class="cal-cm-composer-wrap">
            ${replyingTo}
            ${draftNote}
            ${compPicker}
            ${changeToggle}
            <div class="cal-cm-composer${toClient ? ' is-to-client' : ''}"${staffRoot ? ' data-cm-staff-root="1"' : ''}>
                ${audienceIcon || `<div class="cal-cm-avatar ${roleCls}" style="width:28px;height:28px;border-radius:8px;font-size:0.72rem;">${_calEsc(initial)}</div>`}
                <textarea id="calCommentComposer" rows="1" placeholder="${_calEscAttr(placeholder)}" oninput="_calOnComposerInput(this)" onkeydown="_calOnComposerKey(event)">${_calEsc(draft)}</textarea>
                <div class="cal-cm-composer-actions${staffRoot ? ' is-split' : ''}">
                    <button class="cal-cm-send" type="button" onclick="_calSubmitComposer()" title="${sendPending ? 'You can send once the notes finish loading' : (isEdit ? 'Save edit' : 'Send') + ' (Enter)'}" ${sendPending ? 'data-send-pending="1" ' : ''}${draft.trim() && !sendPending ? '' : 'disabled'}>${sendIco}</button>
                    ${staffRoot ? `<button class="cal-cm-send-more" type="button" onclick="_calToggleSendMenu(event)" aria-haspopup="menu" aria-expanded="false" title="${toClient ? 'Change requests are team only' : 'More send options'}"${toClient || sendPending || !draft.trim() ? ' disabled' : ''}><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5L6 7.5L9 4.5"/></svg></button>
                    <div class="cal-cm-send-menu" role="menu" hidden><button type="button" role="menuitem" onclick="_calSubmitComposerAsTweak()"><strong>Request change</strong><span>Moves this part to Tweaks Needed. Team only.</span></button></div>` : ''}
                </div>
            </div>
            ${staffRoot ? `<div class="cal-cm-quiet" data-cm-quiet>${_calEsc(_calComposeQuietLine())}</div>` : ''}
        </div>`;
    }

    function _calAutosizeComposer(ta) {
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, 160) + 'px';
    }
    function _calOnComposerInput(ta) {
        _calAutosizeComposer(ta);
        if (_calEditTarget) _calEditDrafts[_calEditTarget] = ta.value;
        else if (_calReplyTarget) {
            _calReplyDrafts[_calReplyTarget] = ta.value;
            _calReplyDraftsPersist(_calOpenCommentsPid);
        }
        else {
            _calRootDraft = ta.value;
            _calNoteDraftSet(_calOpenCommentsPid, ta.value);
        }
        _calEnterWhenReady = '';
        const wrap = ta.closest('.cal-cm-composer');
        if (!wrap) return;
        const sendBtn = wrap.querySelector('.cal-cm-send');
        if (sendBtn) sendBtn.disabled = !ta.value.trim() || sendBtn.hasAttribute('data-send-pending');
        const moreBtn = wrap.querySelector('.cal-cm-send-more');
        if (moreBtn) moreBtn.disabled = !ta.value.trim() || _calComposeAudience === 'client'
            || (sendBtn && sendBtn.hasAttribute('data-send-pending'));
    }
    // The split Send menu closes on Escape or a click anywhere else: it is a
    // layer (see _calToggleSendMenu), so the shared handler does both.
    let _calEnterWhenReady = '';
    function _calOnComposerKey(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            // Enter follows the send button: nothing is sent while it waits.
            const sendBtn = e.target && e.target.closest && e.target.closest('.cal-cm-composer')
                ? e.target.closest('.cal-cm-composer').querySelector('.cal-cm-send') : null;
            if (sendBtn && sendBtn.hasAttribute('data-send-pending')) {
                // Enter inside the short window while the card's link is looked up used to do nothing at all
                // and say nothing: the words stayed in the box, unsent, and the person believed they had sent
                // them. It now counts as the send and goes the moment the notes finish loading.
                _calEnterWhenReady = _calOpenCommentsPid || '';
                return;
            }
            _calSubmitComposer();
        } else if (e.key === 'Escape' && (_calReplyTarget || _calEditTarget)) {
            e.preventDefault();
            if (_calEditTarget) _calBeginCommentEdit(null);
            else _calBeginReply(null);
        } else if (e.key === 'Escape' && _isClientLink) {
            // The client link's Notes panel opens with its message box focused, and it is not a staff layer: Escape
            // there closes the panel too (the typed note stays as a draft), as a click on the backdrop does
            // (card gauntlet, client side, "Other" 4; session Curtain Ten).
            e.preventDefault();
            e.stopPropagation();
            closeCalComments();
        }
    }
    function _calBeginReply(rootId) {
        _calCaptureModalDrafts();
        _calEditTarget = null;
        _calReplyTarget = rootId || null;
        // Hitting Reply re-renders the feed, which would otherwise reset its
        // scroll to the top. Keep the reader exactly where they were.
        const feed = document.getElementById('calCommentsFeed');
        const prevScroll = feed ? feed.scrollTop : null;
        _calRenderCommentsModal();
        const feed2 = document.getElementById('calCommentsFeed');
        if (feed2 && prevScroll != null) feed2.scrollTop = prevScroll;
    }
    function _calBeginCommentEdit(commentId) {
        _calCaptureModalDrafts();
        const post = calState.posts.find(p => p.id === _calOpenCommentsPid);
        const comp = post && commentId ? _calFindCompForCommentId(post, commentId) : '';
        const list = post && comp ? _calCommentsFor(post, comp) : [];
        const target = Array.isArray(list) ? list.find(c => c && c.id === commentId) : null;
        _calReplyTarget = null;
        _calEditTarget = target && target.canonical && target.can_edit ? commentId : null;
        if (_calEditTarget && _calEditDrafts[_calEditTarget] == null) {
            _calEditDrafts[_calEditTarget] = String(target.body || '');
        }
        _calRenderCommentsModal();
        return false;
    }
    /* One send at a time. The box keeps its text and stays live while a note
       is on its way, so a second Enter (or Enter then Send) used to post the
       same note twice, each copy overwriting the other's view of the thread. */
    let _calComposerSending = false;
    async function _calSubmitComposer() {
        if (_calComposerSending) return;
        _calComposerSending = true;
        try { return await _calSubmitComposerNow(); }
        finally { _calComposerSending = false; }
    }
    async function _calSubmitComposerNow() {
        const pid = _calOpenCommentsPid;
        if (!pid) return;
        _calCaptureModalDrafts();
        let body = (_calEditTarget
            ? (_calEditDrafts[_calEditTarget] || '')
            : _calReplyTarget ? (_calReplyDrafts[_calReplyTarget] || '') : (_calRootDraft || '')).trim();
        if (!body) return;
        if (_calEditTarget) {
            const editId = _calEditTarget;
            if (!await _calSaveCommentEdit(pid, editId, body)) return;
            delete _calEditDrafts[editId];
            _calEditTarget = null;
            _calRenderCommentsModal();
            return;
        }
        const parentId = _calReplyTarget;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        // Decided now, from what the person sees as they click: a send that
        // runs a moment later must not pick up a picker changed meanwhile.
        const comp = parentId
            ? _calFindCompForCommentId(post, parentId)
            : (_calComponentsFor(post).indexOf(_calComposeComp) >= 0 ? _calComposeComp : 'video');
        // Trial reels (189): a new note about the video names the version on screen ("Video C: ...").
        if (!parentId && comp === 'video') body = svTrialNotesBody(post, body);
        const gate = _prodCanonicalCommentGate(post, comp);
        if (((gate.linked && !gate.ready) || _calCommentSendPending(post, gate)) && !_calNotesStillLoading(post, gate)) {
            showNotify('Notes are still loading', 'Retry the canonical thread before sending.');
            return;
        }
        const role = _calCommentRole();
        const isTweak = !parentId && role === 'client' && _calComposeIsTweak;
        const now = new Date().toISOString();
        const entry = _noteOutboxPut({
            id: _calMintCommentId(), surface: 'notes', kind: parentId ? 'reply' : 'note',
            pid, comp: parentId ? '' : comp, parent_id: parentId || null, body,
            author: _calCurrentAuthor(), author_member_id: _calCurrentAuthorId() || undefined, role,
            audience: parentId ? undefined : (role === 'client' ? 'client' : _calComposeAudience),
            is_tweak: isTweak, round: isTweak ? _calNextTweakRound(post, comp) : undefined,
            created_at: now, at: Date.now(), state: 'sending'
        });
        // The words are safe in the outbox now: the box is free for the next note.
        if (parentId) { delete _calReplyDrafts[parentId]; _calReplyDraftsPersist(pid); }
        else { _calRootDraft = ''; _calRootDraftRestored = ''; _calNoteDraftSet(pid, ''); }
        _calReplyTarget = null;
        _noteOutboxSend(entry.id);
        if (_calOpenCommentsPid === pid) {
            _calRenderCommentsModal();
            setTimeout(() => {
                const feed = document.getElementById('calCommentsFeed');
                if (feed) feed.scrollTop = feed.scrollHeight;
            }, 0);
        }
    }
    /* Flush a comment-carrying save and, if it failed while the Notes modal is
       still open on that card, tell the user. The card's "Save failed" chip is
       the normal failure surface, but the open modal covers it — without this
       the user closes the modal believing the note was sent. Only an explicit
       native acknowledgement establishes that the note itself is safe; legacy
       edits/deletes can fail before anything was stored. */
    function _calWatchNoteSave(pid, nativeCommitted = false) {
        return Promise.resolve(_calFlushCardSave(pid)).then(() => {
            const p = calState.posts.find(x => x.id === pid);
            if (p && p._saveError && _calOpenCommentsPid === pid) {
                if (nativeCommitted) showNotify('Note saved; calendar copy pending', 'Your note was saved, but its calendar copy is not up to date. Refresh and check the note before trying again.');
                else showNotify('Note change not saved', 'The note change did not finish saving. Please refresh and check the note before trying again.');
            }
        });
    }
    /* `opts` comes from the note outbox: the note's own id (minted at the
       click and the same on every try), and the component, audience, change
       request flag and round the person chose when they clicked, so a send
       that runs later still sends what they sent. `background` means no
       pop-up: the outbox shows the outcome in the thread. */
    async function _calAppendComment(pid, parentId, body, opts) {
        const o = opts || {};
        const post = calState.posts.find(p => p.id === pid);
        if (!post) { if (o.background) throw new Error('This card is not loaded.'); return; }
        // Replies inherit the component of the parent thread so a reply to a
        // thumbnail tweak lands in graphic_tweaks (not video). A NEW root targets
        // the component the SMM/client picked in the composer (Part B), validated
        // against the card's active review components (default 'video').
        const comp = parentId
            ? _calFindCompForCommentId(post, parentId)
            : (o.comp && CAL_REVIEW_COMPONENTS.indexOf(o.comp) >= 0 ? o.comp
                : (_calComponentsFor(post).indexOf(_calComposeComp) >= 0 ? _calComposeComp : 'video'));
        const canonicalGate = _prodCanonicalCommentGate(post, comp);
        if ((canonicalGate.linked && !canonicalGate.ready) || _calCommentSendPending(post, canonicalGate)) {
            if (o.background) throw new Error('The notes were still loading.');
            showNotify('Notes are still loading', 'Retry the canonical thread before sending.');
            return false;
        }
        const arr = comp === 'video'
            ? (Array.isArray(post.comments) ? post.comments.slice() : _calLoadComments(post))
            : _calCommentsFor(post, comp).slice();
        const role = _calCommentRole();
        const _now = new Date().toISOString();
        const isRoot = !parentId;
        let nativeCommentCommitted = false;
        let committedBatch = null;
        const msg = {
            id: o.id || _calMintCommentId(),
            parent_id: parentId || null,
            author: _calCurrentAuthor(),
            ...(_calCurrentAuthorId() ? { author_member_id: _calCurrentAuthorId() } : {}),
            role: role,
            body: body,
            created_at: _now,
            updated_at: _now,
            done: false,
            done_at: '',
            done_by: ''
        };
        // Audience + type live on the thread ROOT; replies inherit them via the
        // root (the view filter resolves a reply's audience from its root), and a
        // reply is NEVER a change request. For a root: the SMM picks audience and
        // always posts a plain comment (they request changes from the review
        // panel); the client posts a comment by default and only flips status
        // when they explicitly pick "Request a change".
        if (isRoot) {
            const audience = o.audience === 'client' || o.audience === 'internal' ? o.audience : _calComposeAudience;
            msg.audience = (role === 'client') ? 'client' : audience;
            msg.is_tweak = (role === 'client') ? ('isTweak' in o ? !!o.isTweak : _calComposeIsTweak) : false;
            if (msg.is_tweak) msg.round = Number.isInteger(o.round) ? o.round : _calNextTweakRound(post, comp);
        }
        // Sent before and confirmed by the card (a retry after a lost answer):
        // the thread already has it, so nothing is added twice.
        const alreadyHere = !!(o.id && arr.some(c => c && c.id === o.id));
        if (comp === 'video' || comp === 'graphic') {
            const rootMsg = isRoot ? msg : arr.find(c => c && c.id === parentId);
            try {
                /* CANONICAL-WHERE-LINKED, LEGACY-WHERE-NOT — the add lane's
                   half of a rule its siblings already keep.

                   A card whose crosswalk does not validate has two comment
                   stores, and which one a message lands in was decided by two
                   different rules. The READ side, `_calToggleCommentDone` and
                   the delete confirm all branch on
                   `_prodCanonicalCommentGate(post, comp).linked` and hold an
                   unlinked card on the legacy card store — the rationale beside
                   the coverage hold says it outright: the legacy path "is the
                   one that still works on an uncovered card". ADD did not: it
                   routed on `_writeUiUseGatewayWhenReady` alone, i.e. on the
                   reroute allowlist, which knows a client slug and nothing
                   about this card.

                   That split is what breaks a thread in half. A client's root
                   on such a card fails `_prodClientCommentGatewayContext` and
                   is written to the card store, with no canonical row behind
                   it. A staff REPLY to that root is then routed to the gateway
                   by slug alone, the gateway looks for the parent it was never
                   given, and the reply is refused — while the catch below
                   discards the typed text before the local append can keep it.
                   Same card, same thread, two transports, and only the second
                   one fails.

                   So the answer travels with the write, computed HERE because
                   this is where the component the write actually uses is known
                   — a reply inherits `comp` from its parent thread, while the
                   transport collapses caption and title onto video — and
                   answered by `_prodCommentAddRoutesLegacy`, which asks the
                   CROSSWALK rather than the gate. The distinction is the whole
                   of the safety argument: the gate also says "not linked" for a
                   card with no deliverable id (whose refusal is deliberate) and
                   for a valid link the coverage invariant is holding, and
                   neither may be rerouted. Read the helper for the three states
                   it excludes and why. A callsite that passes no answer at all
                   — the review-tweak lane, the repair drain, Kasper — is
                   untouched. */
                const canonicalUnlinked = await _prodCommentAddRoutesLegacy('calendar', post, comp);
                const acknowledgement = await _calPostLinearComment(_calLinearUrlFor(post, comp), body, msg.author, {
                    post, component: comp, comment: msg, parentId: msg.parent_id,
                    audience: _calMsgAudience(rootMsg), isTweak: isRoot && _calMsgIsTweak(msg),
                    round: rootMsg && Number.isInteger(rootMsg.round) ? rootMsg.round : null,
                    canonicalUnlinked
                });
                committedBatch = {};
                _writeUiBindRepairAck(post, committedBatch, acknowledgement);
                nativeCommentCommitted = !!(acknowledgement && acknowledgement.native_committed);
                // Acknowledged: the draft must not come back after a reload and be sent a second time.
                if (isRoot) _calNoteDraftClearIfSent(pid, body);
            } catch (e) {
                if (o.background) {
                    _writeUiRecordFailure('calendar', 'comment', e, { note_outbox: 1 });
                    throw e;
                }
                _writeUiReportFailure('calendar', 'comment', e);
                return false;
            }
        }
        if (!alreadyHere) arr.push(msg);
        _calSetCommentsFor(post, comp, arr);
        if (comp === 'video') post.comments = arr;
        const fieldKey = comp + '_tweaks';
        _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, { [fieldKey]: _calStringifyComments(arr) });
        // Only a client's explicit change-REQUEST root flips status — a plain
        // comment or any reply leaves the status untouched.
        if (isRoot && role === 'client' && msg.is_tweak && !alreadyHere) _calApplyAutoStatus(pid, 'client_added', comp);
        if (committedBatch) _writeUiMergeCommittedBatch(_calPendingEdits[pid], committedBatch);
        // Part B — route a video/thumbnail note to its Linear sub-issue so the
        // editor / designer sees every piece of feedback in their inbox: BOTH
        // plain comments AND change-requests, roots AND replies (replies route
        // via the inherited parent component). Caption & title have no Linear —
        // gate explicitly on video/graphic so _calLinearUrlFor's video fallback
        // can never leak a caption/title note onto the video issue. Create-only
        // (edits/resolves/deletes never sync); audience-independent;
        // _calPostLinearComment no-ops on an unlinked issue (empty url).
        /* Round 9 (switch unread_badges_v2, staff): once the server holds the note (native_committed), the outbox
           lets go of it; the card's own copy saves behind it (about 0.9 s on calendar-card-write) and still says so
           if it fails. Before, "sending" stayed up for that save too. */
        const cardSave = _calWatchNoteSave(pid, nativeCommentCommitted);
        if (o.background && nativeCommentCommitted && !_isClientLink && svUnreadBadgesOn()) {
            cardSave.catch(() => {}).then(() => { _calRefreshCommentsBtn(pid); _calUpdateCardStatusDisplay(pid); });
        } else await cardSave;
        _calRefreshCommentsBtn(pid);
        _calUpdateCardStatusDisplay(pid);
        return true;
    }
    /* Find which component (video / graphic / caption) owns a given comment
       id. Lets SMM resolve / delete comments on any component's thread from
       the unified modal feed. */
    function _calFindCompForCommentId(post, commentId) {
        // Iterate the FULL review component set (not just the card's currently
        // active ones) so a reply always resolves to the right thread — e.g. a
        // title note routes back to 'title' even if the title later carries no
        // status. (Part B: keeps reply→component + Linear routing correct.)
        for (const c of CAL_REVIEW_COMPONENTS) {
            const list = c === 'video'
                ? (Array.isArray(post.comments) ? post.comments : _calLoadComments(post))
                : _calCommentsFor(post, c);
            if (Array.isArray(list) && list.some(x => x.id === commentId)) return c;
        }
        return 'video';
    }
    async function _calSaveCommentEdit(pid, commentId, body, retryCursor) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return false;
        const comp = _calFindCompForCommentId(post, commentId);
        const target = _calCommentsFor(post, comp).find(c => c && c.id === commentId);
        const gate = _prodCanonicalCommentGate(post, comp);
        if (!target || !target.canonical || !target.can_edit || !gate.linked || !gate.ready) return false;
        const receipt = await _writeUiCommitCardCommentLifecycle(
            'calendar', post, comp, target, 'edit', body, retryCursor
        );
        if (!receipt) return false;
        await _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
        return true;
    }
    function _calRetryCommentEdit(commentId, body, retryCursor) {
        const pid = _calOpenCommentsPid;
        if (!pid) return false;
        _calEditTarget = commentId;
        _calReplyTarget = null;
        _calEditDrafts[commentId] = String(body || '');
        _calSaveCommentEdit(pid, commentId, _calEditDrafts[commentId], retryCursor).then(saved => {
            if (!saved) {
                _calRenderCommentsModal();
                return;
            }
            delete _calEditDrafts[commentId];
            _calEditTarget = null;
            _calRenderCommentsModal();
        });
        return false;
    }
    function _calToggleCommentDone(rootId) {
        const pid = _calOpenCommentsPid;
        if (!pid) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const comp = _calFindCompForCommentId(post, rootId);
        const list = comp === 'video'
            ? (Array.isArray(post.comments) ? post.comments.slice() : _calLoadComments(post))
            : _calCommentsFor(post, comp).slice();
        const root = list.find(c => c.id === rootId && !c.parent_id);
        if (!root) return;
        const wasDone = !!root.done;
        // Resolving the LAST open SMM change-request routes the component onward
        // (client or Kasper) — the SMM must pick which FIRST. Defer the WHOLE
        // resolution (mark-done + status flip) until they confirm in the chooser,
        // so the comment doesn't vanish before the choice and Cancel can't
        // silently swallow it (nothing is applied on cancel). Count the OTHER
        // still-open change-requests, with this root excluded.
        const otherOpen = list.filter(c => !c.parent_id && !c.done && !c.deleted && _calMsgIsTweak(c) && c.id !== rootId).length;
        const deferToChooser = !wasDone && _calCommentRole() === 'smm' && otherOpen === 0;
        const canonicalGate = _prodCanonicalCommentGate(post, comp);
        if (canonicalGate.linked) {
            if (deferToChooser) {
                _calResolveLastTweak(pid, comp, rootId);
                return;
            }
            /* Owner repro 2026-09-25: Mark done saved, but the panel kept
               showing the thread open until the card-notes save that follows
               (_writeUiPersistCanonicalCommentProjection awaits it) finished,
               so a second click raced the refresh and was refused
               (canonical_comment_read_required). Now the card's actions stay
               disabled while this one is in flight, the thread is re-read and
               the panel redrawn the moment the write lands, and only then does
               the slower notes save run. */
            // The busy mark lives on the card itself: its comment actions render
            // disabled until this mark done / reopen settles.
            if (post._calCommentActionBusy) return;
            post._calCommentActionBusy = true;
            _calCaptureModalDrafts();
            _calRenderCommentsModal();
            const done = () => {
                post._calCommentActionBusy = false;
                if (_calOpenCommentsPid === pid) { _calCaptureModalDrafts(); _calRenderCommentsModal(); }
            };
            _writeUiCommitCardCommentLifecycle('calendar', post, comp, root, wasDone ? 'unresolve' : 'resolve')
                .then(async receipt => {
                    if (receipt) {
                        try {
                            await _prodComments.readCanonical(_writeUiNativeId(post, comp), { replace: true });
                            await _prodProjectCanonicalCardComments('calendar', post.id);
                        } catch (e) {}
                    }
                    done();
                    if (receipt) _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
                }, done);
            return;
        }

        if (_calCanonicalCrosswalkPending(post, comp)) return;
        // Flip the comment's done state (data only).
        const mutate = () => {
            if (wasDone) { root.done = false; root.done_at = ''; root.done_by = ''; }
            else { root.done = true; root.done_at = new Date().toISOString(); root.done_by = _calCurrentAuthor(); }
            // Bump the per-comment merge clock so this resolution change wins over
            // any stale copy another browser holds (cross-surface comment merge).
            root.updated_at = new Date().toISOString();
            _calSetCommentsFor(post, comp, list);
            if (comp === 'video') post.comments = list;
            _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, { [comp + '_tweaks']: _calStringifyComments(list) });
        };
        // Persist + refresh the modal/card after a mutation.
        const refresh = () => {
            _calWatchNoteSave(pid);
            _calRefreshCommentsBtn(pid);
            _calUpdateCardStatusDisplay(pid);
            _calCaptureModalDrafts();
            _calRenderCommentsModal();
            // Re-rendering rebuilds the feed and resets its scroll to the top. Keep
            // it pinned to the bottom (where the action happened and the composer
            // lives) — mirrors the post-send behaviour in _calSubmitComposer.
            setTimeout(() => {
                const feed = document.getElementById('calCommentsFeed');
                if (feed) feed.scrollTop = feed.scrollHeight;
            }, 0);
        };

        if (deferToChooser) {
            // Chooser first; the resolve (mark-done) + status flip + refresh happen
            // only on a route pick. Closing leaves the comment exactly as it was
            // (open) — the chooser owns the mark-done so cancel can't half-apply.
            _calResolveLastTweak(pid, comp, rootId);
            return;
        }
        mutate();
        refresh();
    }

    /* Delete a comment. SMM can delete anything; the client can only
       delete their own messages — this is enforced both here and in the
       button-visibility rules. Deleting a root cascades into its replies
       so the thread doesn't leave orphans. If an SMM delete clears the
       last open thread, the same Client-Approval auto-status applies. */
    // `confirmed`: the caller already asked (the client review page's own "Delete this note?", 195), so no second dialog.
    function _calDeleteComment(commentId, postId, confirmed) {
        const pid = postId || _calOpenCommentsPid;
        if (!pid) return;
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const comp = _calFindCompForCommentId(post, commentId);
        const arr = comp === 'video'
            ? (Array.isArray(post.comments) ? post.comments.slice() : _calLoadComments(post))
            : _calCommentsFor(post, comp).slice();
        const target = arr.find(c => c.id === commentId);
        if (!target || (target.canonical ? !target.can_delete : !_calCanDeleteComment(target))) return;
        const isRoot = !target.parent_id;
        const msg = target.canonical
            ? (isRoot
                ? "Delete this note? Replies remain in the thread under a deleted-note marker. This can't be undone."
                : "Delete this reply? A deleted-note marker remains. This can't be undone.")
            : isRoot
                ? "This deletes the message and every reply in this thread. This can't be undone."
                : "Delete this reply? This can't be undone.";
        const run = async () => {
            const canonicalGate = _prodCanonicalCommentGate(post, comp);
            if (canonicalGate.linked) {
                const receipt = await _writeUiCommitCardCommentLifecycle('calendar', post, comp, target, 'delete');
                if (receipt) await _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
                if (postId && svRsCalOn()) svRsCalSync();
                return;
            }
            if (_calCanonicalCrosswalkPending(post, comp)) return;
            // Soft-delete (tombstone) instead of dropping the comment. A bare
            // removal can be resurrected by any later merge that still carries
            // the live copy (a laggy background poll, the save echo, or the
            // other surface's row) — a union can't tell "deleted" from "not
            // yet seen". A tombstone carries a fresh updated_at, so newer-wins
            // keeps it dead everywhere; render/count filters hide it.
            const _delAt = new Date().toISOString();
            const next = arr.map(c => (
                (c.id === commentId || c.parent_id === commentId)
                    ? Object.assign({}, c, { deleted: true, updated_at: _delAt })
                    : c
            ));
            _calSetCommentsFor(post, comp, next);
            if (comp === 'video') post.comments = next;
            _calV2Log('COMMENT delete →', pid, '| comp:', comp, '| id:', commentId, '| live before/after:', arr.filter(c => !c.deleted).length, '→', next.filter(c => !c.deleted).length);
            const fieldKey = comp + '_tweaks';
            _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, { [fieldKey]: _calStringifyComments(next) });
            // Deleting a tweak just deletes it — it must NOT open the
            // resolve-destination chooser ("where to go next?"). That modal is
            // only for an explicit resolve/mark-done (see _calToggleCommentDone).
            // The component's status is left untouched here; the SMM moves it via
            // the status pill when ready.
            _calWatchNoteSave(pid);
            _calRefreshCommentsBtn(pid);
            _calUpdateCardStatusDisplay(pid);
            _calCaptureModalDrafts();
            _calRenderCommentsModal();
            if (postId && svRsCalOn()) svRsCalSync();
        };
        if (confirmed === true) run();
        else showConfirm('Delete tweak?', msg, run, 'Delete');
    }

    /* Resolve-tweaks destination chooser. When the SMM closes the last open
       change-request on a component, the cleared work no longer auto-routes to
       the client — she picks Kasper (internal re-review) or the client. The
       recommended route mirrors the SMM Review tab's smart default: if Kasper
       has already cleared this (his "approve after tweaks" pre-clearance) or
       has seen it before, default to the client; a component that's never been
       to Kasper defaults to Kasper. */
    let _calResolveDestCb = null;
    function _calResolveDestRecommend(post, comp) {
        if (!post) return 'client';
        if (_calShowApprovedAfterTweaks(post, comp)) return 'client';
        if (_calHasBeenToKasper(post, comp)) return 'client';
        return 'kasper';
    }
    /* Why the chooser recommends Kasper or the client — shown in the dialog so
       the SMM isn't second-guessing the default. Mirrors the recommend logic. */
    function _calResolveDestReason(post, comp) {
        if (!post) return '';
        if (_calShowApprovedAfterTweaks(post, comp)) return 'Kasper pre-cleared this after tweaks, so it can skip his re-review.';
        if (_calHasBeenToKasper(post, comp)) return 'Kasper has already reviewed this once.';
        return 'This hasn’t been to Kasper yet.';
    }
    /* Open (unresolved, undeleted) root change-requests on a component — the
       ones a route-onward should offer to mark done. Plain conversation comments
       (is_tweak false) are NOT change-requests and are never touched, so they
       can't be silently hidden by a resolve. */
    function _calOpenTweaksForComp(post, comp) {
        if (!post) return [];
        const list = _calCommentsFor(post, comp);
        if (!Array.isArray(list)) return [];
        return list.filter(c => c && !c.parent_id && !c.deleted && !c.done && _calMsgIsTweak(c));
    }
    /* Mark the given root change-requests done on a component — stamp
       done/done_by/done_at, bump the per-comment merge clock, and queue the
       component's tweaks JSON for the next save. Only the ids passed are
       touched, so the SMM's tick-selection in the chooser is honoured: an
       un-ticked change-request stays open. Returns true if anything changed. */
    function _calResolveTweaksDone(post, comp, ids) {
        if (!post || !Array.isArray(ids) || !ids.length) return false;
        const list = comp === 'video'
            ? (Array.isArray(post.comments) ? post.comments.slice() : _calLoadComments(post))
            : _calCommentsFor(post, comp).slice();
        const want = new Set(ids);
        const at = new Date().toISOString();
        const by = _calCurrentAuthor();
        let changed = false;
        for (const c of list) {
            if (c && !c.parent_id && want.has(c.id) && !c.done && !c.deleted) {
                c.done = true; c.done_at = at; c.done_by = by; c.updated_at = at; changed = true;
            }
        }
        if (!changed) return false;
        _calSetCommentsFor(post, comp, list);
        if (comp === 'video') post.comments = list;
        _calPendingEdits[post.id] = Object.assign(_calPendingEdits[post.id] || {}, { [comp + '_tweaks']: _calStringifyComments(list) });
        return true;
    }
    function _calShowResolveDest(opts) {
        opts = opts || {};
        const overlay = document.getElementById('resolveDestOverlay');
        const msg = document.getElementById('resolveDestMsg');
        const kBtn = document.getElementById('resolveDestKasper');
        const cBtn = document.getElementById('resolveDestClient');
        const aBtn = document.getElementById('resolveDestApprove');
        const openTweaks = (Array.isArray(opts.openTweaks) ? opts.openTweaks : []).filter(Boolean);
        // No overlay (e.g. a stripped DOM) → fall back to the recommended route and
        // resolve everything, so the caller still completes.
        if (!overlay || !kBtn || !cBtn || !aBtn) { if (opts.onChoose) opts.onChoose(opts.recommend || 'client', openTweaks.map(t => t.id)); return; }
        const compLabel = (COMP_LABELS[opts.comp] || 'this').toLowerCase();
        /* Only the Notes "mark done" on the LAST open change-request opens this (the Review tab no longer asks: its
           Kasper / client pick is the answer), so there is exactly one request and the route implies it. There is no
           plain "Approve" (the manager only sends to Kasper or the client). */
        const lead = openTweaks.length === 1 ? 'This change request will be marked done. ' : '';
        const toKasper = opts.recommend === 'kasper';
        const toApproved = opts.recommend === 'approved';
        if (msg) msg.textContent = lead + 'Then send the ' + compLabel + ' onward: '
            + (toApproved ? 'mark it approved — or to Kasper or the client first.'
               : toKasper ? 'to Kasper for approval — or straight to the client.'
                          : 'to the client for approval — or back to Kasper first.')
            + (opts.reason ? ' (' + opts.reason + ')' : '');
        // The recommended route is the primary (filled) button.
        kBtn.classList.toggle('primary', toKasper);
        cBtn.classList.toggle('primary', !toKasper && !toApproved);
        aBtn.classList.toggle('primary', toApproved);
        const allIds = () => openTweaks.map(t => t.id);
        _calResolveDestCb = (typeof opts.onChoose === 'function') ? opts.onChoose : null;
        const pick = (dest) => { const cb = _calResolveDestCb; const ids = allIds(); _calDismissResolveDest(); if (cb) cb(dest, ids); };
        kBtn.onclick = () => pick('kasper');
        cBtn.onclick = () => pick('client');
        aBtn.onclick = () => pick('approved');
        // "Mark done — don't change the status": resolve the change-request
        // but route nowhere (dest 'stay'). The same plain resolve every non-last
        // comment already gets — just reachable for the last one too.
        const stayBtn = document.getElementById('resolveDestStay');
        if (stayBtn) { stayBtn.hidden = false; stayBtn.onclick = () => pick('stay'); }
        overlay.classList.add('active');
        svLayerOverlay('cal-resolvedest', '#resolveDestOverlay', '#resolveDestOverlay .confirm-box', () => _calDismissResolveDest(), { openClass: 'active' });
    }
    // ✕ / backdrop click just closes the chooser — closing is non-destructive
    // (nothing is applied until a route is picked), so no confirm is needed.
    function _calDismissResolveDest() {
        svLayerRelease('cal-resolvedest', { focus: true });
        const overlay = document.getElementById('resolveDestOverlay');
        if (overlay) overlay.classList.remove('active');
        _calResolveDestCb = null;
    }
    /* Called when the SMM clears the LAST open change-request on a component via
       the Notes "mark done". It's the only one open, so the chooser shows no
       checklist — just the route. The resolve (mark-done) + status flip are
       DEFERRED into the route pick, so closing the chooser leaves the
       change-request open — recoverable by reopening the thread. The flush also
       pushes the new sub-status to the linked Linear issue. */
    function _calResolveLastTweak(pid, comp, rootId) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const root = _calOpenTweaksForComp(post, comp).find(c => c.id === rootId);
        _calShowResolveDest({
            comp: comp,
            recommend: _calResolveDestRecommend(post, comp),
            reason: _calResolveDestReason(post, comp),
            openTweaks: root ? [root] : [],
            onChoose: async (destPick, ids) => {
                /* Refuse BEFORE anything is resolved. _calApplyAutoStatus below
                   now returns false for an empty component, and its callers
                   ignore the return -- so without this the thread would close,
                   the status would silently stay put, and the SMM would be told
                   nothing. Same shape as the Review-tab path in
                   _calReviewApprove, found the same way: by asking what the gate
                   does to every caller rather than the one it was written for. */
                if (destPick !== 'stay') {
                    const _blocked = _calReviewBlockReason(post, comp, _calAutoResolveDestStatus(destPick));
                    if (_blocked) {
                        showNotify('Nothing to review yet', _blocked
                            + ' Nothing was changed — the change request is still open.');
                        return;
                    }
                }
                // Resolve only on a pick (closing never reaches here), THEN flip
                // the sub-status — unless the SMM chose "don't change the status"
                // (dest 'stay'), in which case it's a plain mark-done, no routing.
                const chosen = (ids && ids.length) ? ids : [rootId];
                const canonicalGate = _prodCanonicalCommentGate(post, comp);
                if (canonicalGate.linked) {
                    for (const id of chosen) {
                        const comment = _calCommentsFor(post, comp).find(row => row && row.id === id);
                        if (!comment) continue;
                        const receipt = await _writeUiCommitCardCommentLifecycle(
                            'calendar', post, comp, comment, 'resolve', undefined,
                            { resolveDestination: destPick }
                        );
                        if (!receipt) return;
                    }
                } else {
                    if (_calCanonicalCrosswalkPending(post, comp)) return;
                    _calResolveTweaksDone(post, comp, chosen);
                }
                if (destPick !== 'stay') _calApplyAutoStatus(pid, 'smm_resolved_last', comp, destPick);
                if (canonicalGate.linked) await _writeUiPersistCanonicalCommentProjection('calendar', post, comp);
                else _calWatchNoteSave(pid);
                _calRefreshCommentsBtn(pid);
                _calUpdateCardStatusDisplay(pid);
                _calCaptureModalDrafts();
                _calRenderCommentsModal();
            }
        });
    }

    /* Auto-status transitions driven by tweak activity. Returns true if a
       change was applied. Skips terminal states (Scheduled / Posted) so
       live content isn't accidentally bounced backward. For 'smm_resolved_last'
       the destination is the SMM's explicit pick ('client' | 'kasper') from the
       resolve chooser — there is no silent default. */
    function _calApplyAutoStatus(pid, trigger, comp, dest) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return false;
        if (post.status === 'Posted' || post.status === 'Scheduled') return false;
        const which = comp || 'video';
        const subKey = which + '_status';
        let next = null;
        if (trigger === 'client_added' && post[subKey] !== 'Tweaks Needed') {
            next = 'Tweaks Needed';
        } else if (trigger === 'smm_resolved_last') {
            const target = _calAutoResolveDestStatus(dest);
            if (post[subKey] !== target) next = target;
        }
        if (!next) return false;
        /* An AUTOMATIC route must not send an empty component for review. This
           is the path that moves a card along on its own, so it is the one most
           likely to strand a card without anybody choosing to -- and returning
           false leaves the component exactly where it was, which is the correct
           outcome: there is nothing to review. */
        if (_calReviewBlockReason(post, which, next)) return false;
        // Only the component the comment belongs to flips status. Overall
        // card status is recomputed from all three sub-statuses (lower-wins).
        post[subKey] = next;
        post.status = computeOverallStatus(post);
        post.updated_at = new Date().toISOString();
        _calPendingEdits[pid] = Object.assign(_calPendingEdits[pid] || {}, { [subKey]: next, status: post.status });
        // Routing to Kasper marks the cross-device kasper_seen flag (same as the
        // SMM Review tab's "Approve → Kasper") so every device stops treating
        // this component as brand-new.
        if (next === 'Kasper Approval') {
            const csv = _calRecordKasperSeenOnPost(post, which);
            if (csv != null) _calPendingEdits[pid].kasper_seen = csv;
        }
        _calClearStaleApprovals(post, _calPendingEdits[pid]);
        _calMarkLocalStatus(pid, which);
        return true;
    }
    /* Single source of truth for the URGENT ping affordance: Video only, only
       while it's actually at "Tweaks Needed", and only when there's a Linear
       sub-issue to resolve the editor from. Used by BOTH the full card render and
       the in-place status updater so the badge can never linger after the
       component leaves Tweaks Needed (it used to stick next to "For Client
       Approval" when a tweak was resolved + sent to the client in place). */
    function _calShowUrgent(p, c) {
        if (!p || c !== 'video') return false;
        if (_calNormStatus(p[c + '_status'] || '') !== 'Tweaks Needed') return false;
        const link = String(p[c === 'graphic' ? 'graphic_linear_issue_id' : 'linear_issue_id'] || '').trim();
        return !!(link || String(p.video_deliverable_id || '').trim());
    }
    /* Refresh just the status chip/dropdown on a card without re-rendering
       the whole calendar — used after an auto-status change so the card
       behind the tweaks modal updates immediately. */
    function _calUpdateCardStatusDisplay(pid) {
        const post = calState.posts.find(p => p.id === pid);
        if (!post) return;
        const sel = (window.CSS && CSS.escape) ? CSS.escape(pid) : pid;
        const wrap = document.querySelector(`.cal-fld-status-wrap[data-status-pid="${sel}"]`);
        if (wrap) {
            wrap.setAttribute('data-val', post.status);
            const lbl = wrap.querySelector('.cal-fld-status-label');
            if (lbl) lbl.textContent = _calStatusLabel(post.status);
        }
        // If the overall status is no longer Client Approval (e.g. the
        // client just added a tweak and the auto-status flipped a sub
        // to Tweaks Needed, which dropped overall out of Client Approval)
        // the green "Approve post" bar still hanging in the card body is
        // misleading. Remove it in place so the client can't approve a
        // card they've just requested changes on. It'll come back on
        // next full re-render if status returns to Client Approval.
        if (_isClientLink && post.status !== 'Client Approval') {
            const card = document.querySelector(`.cal-card[data-pid="${sel}"]`);
            const approveBar = card && card.querySelector('.cal-approve-bar');
            if (approveBar) approveBar.remove();
        }
        // Per-component sub-status pills — without this refresh, an auto-
        // status change from resolving the last tweak (or any in-place
        // mutation like _calApplyAutoStatus) would leave the pill DOM
        // stale and the dropdown's "active" highlight would disagree with
        // the visible label.
        for (const c of _calComponentsFor(post)) {
            const subWrap = document.querySelector(`.cal-fld-substatus-wrap[data-substatus-pid="${sel}"][data-substatus-comp="${c}"]`);
            if (!subWrap) continue;
            const cs = _calNormStatus(post[c + '_status'] || post.status || 'In Progress');
            // data-val stays the STORED status; only the visible pill is
            // substituted, and by the same helper the full render uses.
            const shown = _calPillDisplayStatus(post, c, cs);
            subWrap.setAttribute('data-val', cs);
            const trigger = subWrap.querySelector('.cal-fld-substatus-trigger');
            if (trigger) {
                // Replace any cal-fld-status-* class with the new slug so the
                // pill picks up the colour for the new state.
                Array.from(trigger.classList).forEach(cls => {
                    if (cls.startsWith('cal-fld-status-')) trigger.classList.remove(cls);
                });
                trigger.classList.add('cal-fld-status-' + _calStatusSlug(shown));
                const labelEl = trigger.querySelector('.cal-fld-substatus-label');
                if (labelEl) labelEl.textContent = labelEl.title = _calCompStatusLabel(post, c, shown);
            }
            // Reconcile the URGENT badge in place, same predicates as the full
            // render — otherwise it lingered next to "For Client Approval" after
            // a tweak was resolved and the component left Tweaks Needed. Both
            // flavours are reconciled here, and a pill that changes flavour
            // (Tweaks Needed → Kasper Approval) has its button REPLACED rather
            // than restyled: the two carry different handlers, and leaving the
            // old one in place is how a pill ends up pinging the wrong person.
            const showUrgent = _calShowUrgent(post, c);
            const showKasperUrgent = !showUrgent && _calShowKasperUrgent(post, c);
            const wantKind = showUrgent ? 'editor' : showKasperUrgent ? 'kasper' : '';
            subWrap.classList.toggle('has-urgent', !!wantKind);
            let urgentEl = subWrap.querySelector('.cal-urgent-btn');
            if (urgentEl && (urgentEl.dataset.urgentKind || 'editor') !== wantKind) {
                urgentEl.remove();
                urgentEl = null;
            }
            if (wantKind && !urgentEl) {
                subWrap.insertAdjacentHTML('beforeend', wantKind === 'kasper'
                    ? _calUrgentButtonHtml(pid, '_calSendKasperUrgentSlack', post, '', false, 'kasper')
                    : _calUrgentButtonHtml(pid, '_calSendUrgentSlack', post));
            } else if (wantKind && urgentEl) {
                _calApplyUrgentButtonState(urgentEl, post, wantKind);
            }
        }
        // Title status square (lives in the title row, not the sub-status row) —
        // keep its colour in lockstep with title_status on in-place / realtime
        // updates too, not just full re-renders.
        const titleSq = document.querySelector(`.cal-title-status-sq[data-substatus-pid="${sel}"][data-substatus-comp="title"]`);
        // The title's URGENT ping lives beside that square rather than on a
        // sub-status pill, so the pill loop above never sees it. Reconcile it
        // here with the same predicate and the same remove-and-rebuild rule.
        if (titleSq && titleSq.parentNode) {
            const wantTitleUrgent = _calShowKasperUrgent(post, 'title');
            let titleUrgentEl = titleSq.parentNode.querySelector(':scope > .cal-title-urgent-btn');
            if (titleUrgentEl && !wantTitleUrgent) { titleUrgentEl.remove(); titleUrgentEl = null; }
            if (wantTitleUrgent && !titleUrgentEl) {
                titleSq.insertAdjacentHTML('afterend', _calUrgentButtonHtml(pid, '_calSendKasperUrgentSlack', post, 'cal-title-urgent-btn', true, 'kasper'));
            } else if (wantTitleUrgent && titleUrgentEl) {
                _calApplyUrgentButtonState(titleUrgentEl, post, 'kasper');
            }
        }
        if (titleSq) {
            const tcs = _calNormStatus(post.title_status || 'In Progress');
            titleSq.setAttribute('data-val', tcs);
            Array.from(titleSq.classList).forEach(cls => { if (cls.startsWith('cal-fld-status-')) titleSq.classList.remove(cls); });
            titleSq.classList.add('cal-fld-status-' + _calStatusSlug(tcs));
            titleSq.setAttribute('title', 'YouTube title: ' + _calStatusLabel(tcs));
        }
        // The Review tab badge counts by status — keep it in lockstep with the
        // in-place status change too (back-port of the samples port's tail call;
        // without it a client change-request from the Notes modal left the badge
        // at the old count until the next full re-render). Before the early
        // return: the badge is toolbar DOM, independent of this card's element.
        if (typeof _calUpdateReviewBadge === 'function') _calUpdateReviewBadge();
        const card = document.querySelector(`.cal-card[data-pid="${sel}"]`);
        if (!card) return;
        const chip = card.querySelector('.cal-client-status');
        if (chip) chip.innerHTML = _calClientCompPillsHtml(post);
        const isPosted = String(post.status || '').toLowerCase() === 'posted';
        card.classList.toggle('cal-card-posted', isPosted);
    }

    // (Removed _setCalStatus / the #calStatusBadge header indicator.) It was a
    // flex child in .cal-toolbar-right that, on every reorder, popped to
    // "Saving…"/"Saved" and shifted the whole toolbar. Reorders now use the
    // non-displacing toast ("New order saved" / the error toast) for feedback,
    // and per-card saves already have their own in-card save chip. Don't
    // re-add a toolbar text badge — it reflows the controls next to it.

    // ---- window exports (generated by `node scripts/check-modules.js --write-window-exports`; do not edit) ----
    Object.assign(window, {
        _calBeginCommentEdit, _calBeginReply, _calDeleteComment, _calDismissResolveDest, _calNoteDraftDiscard,
        _calOnComposerInput, _calOnComposerKey, _calReviewApprove, _calReviewComment, _calReviewOnDraftInput,
        _calReviewOpenInSheet, _calReviewRequestTweak, _calReviewToggleCard, _calSetComposeComp,
        _calSetComposeIsTweak, _calSubmitComposer, _calSubmitComposerAsTweak, _calToggleCommentDone,
        _calToggleComposeAudience, _calToggleSendMenu, _calToggleShowResolved, _calToggleThreadCollapse,
        _noteOutboxDiscard, _noteOutboxRetry, _noteOutboxRetryRequest, closeCalComments, closeCalPreview,
        editInOrganizerFromPreview, openCalComments, openCalPreview, svCardNotesIntent
    });
export {
