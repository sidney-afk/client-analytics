  _CAL_LOCK_ICO, _calCommentSendPending, _calFindCompForCommentId,
  CAL_REPLY_DRAFT_MAX, REVIEW_APPROVE_DRAFT_TITLE, _calApplyAutoStatus, _calApprovalBadgeCount,
