    }
    function svTrialReviewApproveWord(m, mode) {
        return m && m.trial && !m.trial.winner ? 'Approve ' + _trvW(m) + _trvCurOf(m, mode).letter : '';
    }

    /* The page around the player, as the approved mock (mock-c1440, mock-c390; Probe E1 to E5):
         - above the player, only once a winner is picked: "Video C: the one we are posting" (Q8);
         - an arrow on each side of the player (desktop; on a phone the video is swiped left or right instead);
         - under the player, "Video A of 5" and a row of letter dots carrying this reviewer's answer on each version,
           with "Swipe for the next version" on a phone;
         - "Approve all (4 waiting)" at the bottom left, beside Finish reviewing, which counts versions.
       Each answers '' for today's page. */
    // One quiet word over the version's name, on every page that reviews a trial card's video (Sidney, 2026-10-27: "it
    // should say that it's a trial video"; no visual noise, so a small muted word and no pill). Not on the player's
    // badge: a 9:16 player on a wide page is too narrow for it, so the page hides the badge there.
    const TRV_TAG = '<span class="trv-tag">Trial</span>';
    // The client is told once, in plain words, why there are several versions (Trialeyes E11, 2026-10-29).
    const TRV_WHY = '<span class="trv-why">We\'ll test each version for 24 h and keep the best one.</span>';
    function svTrialReviewBarHtml(m, mode) {
        if (!m || !m.trial || !m.trial.winner) return '';
        return TRV_TAG + '<div class="trv"><span class="trv-n">' + _trvW(m) + _calEsc(m.trial.winner.letter) + ': the one we are posting</span></div>';
    }
    /* V4 (plan docs/plans/2026-11-trial-and-posting/combined.md row V4; switch trial_versions_v2): each version shows its
       own thumbnail and caption under its player (the read's `effective` set: its own, else the card's), one Approve on
       it covers its parts (195 approves the card's thumbnail and caption parts with the video, once the function says the
       stage is done), and Ask for a change picks the part: Video, Thumbnail or Caption. Off, or a read without
       `effective`, is today's page. */
    function svTrialReviewFieldsOn(m) {
        try { return !!(m && m.trial && !m.trial.winner && svTrialVersionsV2On(m.trial.slug)); } catch (e) { return false; }
    }
    /* VERSION TABS (plan row 688, option B, Sidney's pick 3 Nov; switch trial_versions_v2). With the switch on:
         - a version is named "Version A" ("Video" stays the name of the video part);
         - the review boards draw a trial card's versions as one segmented control, each segment coloured by where that
           version stands for this reviewer, in place of the dots and of Kasper's tiles;
         - the stage's own three parts show the selected version's Video, Thumbnail and Caption (its own, else the
           card's), each once: V4's separate thumbnail-and-caption block goes (Sidney: "why should he see 2 times a
           caption?");
         - a trial card carries a small "Trial" chip on the boards.
       Off, today's page word for word. */
    function _trvW(m) {
        try { return m && m.trial && svTrialVersionsV2On(m.trial.slug) ? 'Version ' : 'Video '; } catch (e) { return 'Video '; }
    }
    function _trvTabs(m) { return svTrialReviewFieldsOn(m) && m.trial.versions.length > 1; }
    // A change note names its version: "Video C: …" before the switch, "Version C: …" with it, either with a part.
    const _trvNoteRe = l => new RegExp('^(?:Video|Version) ' + l + '(?:, (?:thumbnail|caption))?:\\s*');
    const TRV_NAMED = /^(?:Video|Version) [A-G](?:, (?:thumbnail|caption))?:/;
    const TRV_SAY = { ok: 'approved', chg: 'change asked', wait: 'waiting for you', team: 'with the team', pass: 'not this one', cpass: 'client dropped' };
    // The segmented control: one segment per live version, the selected one raised, each coloured by its answer here.
    function _trvTabsHtml(m, mode, attr) {
        const stage = _trvStage(mode), cur = _trvCurOf(m, mode);
        return '<div class="trs" role="group" aria-label="Versions of this video">' + m.trial.versions.map(v => {
            const a = _trvAnswer(v, stage), l = _calEscAttr(v.letter), on = v === cur;
            return '<button type="button" class="trs-s' + (on ? ' on' : '') + '" data-a="' + a + '" data-stage="' + stage + '" ' + attr + '="' + l + '" aria-pressed="' + on + '"'
                + ' aria-label="Version ' + l + ', ' + TRV_SAY[a] + '"><i class="trs-d"></i><span class="trs-t"><span class="trs-w">Version&nbsp;</span>' + _calEsc(v.letter) + '</span></button>';
        }).join('') + '</div>';
    }
    function svTrialReviewWord(m) { return _trvW(m); }
    function svTrialReviewNoteRe(letter) { return _trvNoteRe(letter); }
    function svTrialReviewNamed(text) { return TRV_NAMED.test(String(text || '')); }
    /* What the stage's parts show for the selected version (null for today's page): its own thumbnail and caption, else
       the card's, whether it is the version on the card (whose caption the stage may edit as today), and its state. */
    function svTrialReviewPartView(m, mode) {
        if (!_trvTabs(m)) return null;
        const cur = _trvCurOf(m, mode), eff = (cur && cur.effective) || {};
        return { letter: cur.letter, onCard: !!cur.on_card, ownCaption: !!String(cur.caption || '').trim() || (eff.caption != null && String(eff.caption) !== String(m.caption || '')), thumb: _trvPicOf(m, cur), caption: eff.caption != null ? String(eff.caption) : String(m.caption || ''),
            answer: _trvAnswer(cur, _trvStage(mode)), status: cur.status, part: cur.status === 'change asked' ? (cur.change_part || 'video') : '', note: String(cur.change_note || '') };
    }
    // The quiet "Trial" chip a trial card carries on the review boards ('' for any other card, or with the switch off).
    function svTrialReviewChipHtml(m) { return _trvTabs(m) ? '<span class="trv-chip">Trial</span>' : ''; }
    // A Frame.io page is not a picture: the version's thumbnail then shows the card's derived poster, or nothing.
    const _trvIsPic = u => /^https:\/\//i.test(u) && !/^https:\/\/([^/]*\.)?(f\.io|frame\.io)(\/|$)/i.test(u);
    /* A version's own thumbnail is shown the way the card shows its own (_calDeriveThumb): a Google Drive file page, the
       team's usual thumbnail link, becomes its image address (V4 live walk, 3 Nov: a Drive link drew a broken image). */
    function _trvPicOf(m, v) {
        const eff = v && v.effective, th = String((eff && eff.thumbnail_url) || '').trim();
        if (!th) return '';
        if (th === String((m.post && m.post.thumbnail_url) || '').trim()) return String(m.thumb || '');
        let d = '';
        try { d = _calDeriveThumb({ thumbnail_url: th }) || ''; } catch (e) { d = ''; }
        return d || (_trvIsPic(th) ? th : '');
    }
    // A picture that does not load shows the quiet video mark under it, never a broken image or its alt text.
    const _trvImg = (src, alt) => '<img alt="' + _calEscAttr(alt) + '" src="' + _calEscAttr(src) + '" loading="lazy" onerror="this.hidden=true">';
    function svTrialReviewFieldsHtml(m, mode) {
        if (!svTrialReviewFieldsOn(m) || _trvTabs(m)) return '';
        const cur = _trvCurOf(m, mode), eff = cur && cur.effective;
        if (!eff || typeof eff !== 'object') return '';
        const pic = _trvPicOf(m, cur), cap = String(eff.caption || '').trim(), L = _calEsc(cur.letter);
        return '<div class="trv-fx" data-trv-fx="' + _calEscAttr(cur.letter) + '">'
            + '<span class="trv-fx-pic">' + TRV_PLAY + (pic ? _trvImg(pic, 'Thumbnail of ' + _trvW(m) + cur.letter) : '') + '</span>'
            + '<span class="trv-fx-t"><span class="trv-fx-l">' + _trvW(m) + L + '\'s thumbnail and caption</span>'
            + '<span class="trv-fx-cap' + (cap ? '' : ' none') + '">' + (cap ? _calEsc(cap) : 'No caption') + '</span></span></div>';
    }
    const TRV_PARTS = [['video', 'Video'], ['thumbnail', 'Thumbnail'], ['caption', 'Caption']];
    const _trvPart = p => (TRV_PARTS.some(x => x[0] === p) ? p : 'video');
    // The parts a change on a version can be about, above the change box ('' with the switch off).
    function svTrialReviewPartPickHtml(m, mode, letter, picked) {
        if (!svTrialReviewFieldsOn(m)) return '';
        const v = (letter && m.trial.versions.find(x => x.letter === letter)) || _trvCurOf(m, mode), p = _trvPart(picked);
        return '<div class="trv-parts" role="group" aria-label="Which part of ' + _trvW(m) + _calEscAttr(v.letter) + ' should change?"><span class="lbl">' + _trvW(m) + _calEsc(v.letter) + '</span>'
            + TRV_PARTS.map(([k, w]) => '<button type="button" class="trv-pt" data-trv-part="' + k + '" aria-pressed="' + (k === p) + '">' + w + '</button>').join('') + '</div>';
    }
    // The card's part a version's change goes on as today's change request: the thumbnail's is the graphic part.
    function svTrialReviewPartComp(part) { return part === 'thumbnail' ? 'graphic' : part === 'caption' ? 'caption' : 'video'; }
    function svTrialReviewUnderHtml(m, mode) {
        if (!m || !m.trial || m.trial.winner) return '';
        const vs = m.trial.versions, stage = _trvStage(mode), cur = _trvCurOf(m, mode);
        const busy = _trvBusy.has(m.id) ? '<span class="trv-busy" role="status">' + svBusyHtml('Saving…') + '</span>' : '';
        const cok = _trvClientOk(cur, stage) ? '<span class="trv-cok" title="The client approved ' + _trvW(m) + _calEscAttr(cur.letter) + '">Client approved</span>' : '';
        if (vs.length === 1) return TRV_TAG + '<div class="trv trv-under"><span class="trv-n">' + _trvW(m) + _calEsc(cur.letter) + '</span>' + cok + busy + '</div>' + svTrialReviewFieldsHtml(m, mode);
        if (_trvTabs(m)) return '<div class="trv trv-under trs-under">' + _trvTabsHtml(m, mode, 'data-trv-go') + cok + busy + '</div>';
        const dots = vs.map(v => {
            const a = _trvAnswer(v, stage);
            return '<button type="button" class="trv-dot' + (v === cur ? ' on' : '') + (a === 'ok' ? ' ok' : a === 'chg' ? ' chg' : a === 'team' ? ' team' : a === 'pass' || a === 'cpass' ? ' pass' : '') + '" data-trv-go="' + _calEscAttr(v.letter) + '" aria-label="Video ' + _calEscAttr(v.letter)
                + (a === 'ok' ? ', approved' : a === 'chg' ? ', change asked' : a === 'team' ? ', with the team' : a === 'pass' ? ', not this one' : a === 'cpass' ? ', client dropped' : ', waiting') + (_trvClientOk(v, stage) ? ', client approved' : '') + '"' + (v === cur ? ' aria-current="true"' : '') + '><i>' + _calEsc(v.letter) + '</i></button>';
        }).join('');
        return TRV_TAG + (mode === 'client' ? TRV_WHY : '') + '<div class="trv trv-under" role="group" aria-label="Versions of this video">'
            + '<span class="trv-swipe" aria-hidden="true">Swipe for the next version</span>'
            + '<span class="trv-n" aria-live="polite">Video ' + _calEsc(cur.letter) + ' <span class="trv-of">of ' + vs.length + '</span></span>'
            + cok
            + '<span class="trv-dots">' + dots + '</span>' + busy + '</div>' + svTrialReviewFieldsHtml(m, mode);
    }
    // The two arrows beside the player ('' with one version). They hide on a phone (CSS): there the video is swiped.
    function svTrialReviewArrowsHtml(m, mode) {
        if (!m || !m.trial || m.trial.winner || m.trial.versions.length < 2) return '';
        const vs = m.trial.versions, i = vs.indexOf(_trvCurOf(m, mode));
        const arrow = (d, on, label, side, path) => '<button type="button" class="trv-arr trv-side ' + side + '" data-trv-step="' + d + '" aria-label="' + label + '"' + (on ? '' : ' disabled') + '><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="' + path + '"/></svg></button>';
        return arrow(-1, i > 0, 'The version before', 'prev', 'M10 3 5 8l5 5') + arrow(1, i < vs.length - 1, 'The next version', 'next', 'M6 3l5 5-5 5');
    }
    function svTrialReviewAllHtml(m, mode) {
        if (!m || !m.trial || m.trial.winner) return '';
        const stage = _trvStage(mode), open = m.trial.versions.filter(v => _trvAnswer(v, stage) === 'wait');
        if (open.length < 2) return '';
        return '<button type="button" class="btn-quiet trv-all" data-trv-all="1"' + (_trvBusy.has(m.id) ? ' disabled' : '') + '>'
            + '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7"/></svg>'
            + 'Approve all (' + open.length + ' waiting)</button>';
    }
    // Finish reviewing counts versions in place of the video (plan section 5): null for today's count.
    function svTrialReviewCount(m, mode) {
        if (!m || !m.trial || m.trial.winner || m.trial.versions.length < 2) return null;
        const stage = _trvStage(mode), vs = m.trial.versions;
        return { done: vs.filter(v => _trvAnswer(v, stage) !== 'wait').length, total: vs.length };
    }
    // One step to the version before (-1) or after (1). False at either end, so the arrow keys can move on to the next part.
    function svTrialReviewStep(m, mode, d) {
        if (!m || !m.trial || m.trial.winner) return false;
        const vs = m.trial.versions, next = vs[vs.indexOf(_trvCurOf(m, mode)) + d];
        if (!next) return false;
        _trvCur[m.id] = next.letter; _trvMovedAt[m.id] = 0; _trvRepaint();
        return true;
    }
    function svTrialReviewBind(el, m, mode, onAll) {
        if (!el || !m || !m.trial || m.trial.winner) return;
        el.querySelectorAll('[data-trv-go]').forEach(b => b.addEventListener('click', () => { _trvCur[m.id] = b.dataset.trvGo; _trvMovedAt[m.id] = 0; _trvRepaint(); }));
        el.querySelectorAll('[data-trv-step]').forEach(b => b.addEventListener('click', () => svTrialReviewStep(m, mode, Number(b.dataset.trvStep))));
        el.querySelectorAll('[data-trv-all]').forEach(b => b.addEventListener('click', () => onAll()));
    }
    /* A phone swipes the video left (the next version) or right (the one before). Bound once on the stage; `model()`
       is the post on stage now. A swipe that starts on the player's own controls (its scrubber) is the player's. */
    function svTrialReviewSwipe(el, model, mode) {
        if (!el || el.__trvSwipe) return;
        el.__trvSwipe = true;
        let x0 = 0, y0 = 0, on = false;
        el.addEventListener('touchstart', e => {
            const t = e.touches && e.touches[0];
            on = !!t && e.touches.length === 1 && !(e.target.closest && e.target.closest('.fv-controls, input, button, a'));
            if (on) { x0 = t.clientX; y0 = t.clientY; }
        }, { passive: true });
        el.addEventListener('touchend', e => {
            if (!on) return;
            on = false;
            const t = e.changedTouches && e.changedTouches[0];
            if (!t) return;
            const dx = t.clientX - x0, dy = t.clientY - y0;
            if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
            svTrialReviewStep(model(), mode(), dx < 0 ? 1 : -1);
        }, { passive: true });
    }

    /* Approve answers AT ONCE (Sidney, 2026-10-27: "everything should feel fast"): the version reads approved here and
       the page moves on before the server answers. The answers of one card go to the server one at a time, in order,
       and only the last one's answer is drawn, so a second Approve right after is never undone by the first's answer.
       A refused answer puts the card back as the server has it and says so. Today's approve on the card still runs
       only once the server says the stage is done. */
    const _trvChain = {};     // post id -> the answer in flight (the next waits for it)
    const _trvSeq = {};       // post id -> how many answers were asked; only the latest one's reply is drawn
    function _trvLocal(m, mode, body) {
        const e = _trv[m.trial.slug], card = e && e.cards[m.id];
        if (!card || !Array.isArray(card.versions)) return null;
        const stage = _trvStage(mode), now = new Date().toISOString();
        const versions = card.versions.map(v => {
            const hit = body.kind === 'approve_all' ? _trvLive(v) && _trvAnswer(v, stage) === 'wait' : v.letter === body.letter && _trvAnswer(v, stage) === 'wait';
            if (!hit) return v;
            return Object.assign({}, v, stage === 'client' ? { status: 'approved', client_ok_at: now } : { [stage + '_ok_at']: now });
        });
        const before = card;
        e.cards[m.id] = Object.assign({}, card, { versions });
        return { before, versions };
    }
    function _trvAnswerCall(m, mode, body) {
        const seq = _trvSeq[m.id] = (_trvSeq[m.id] || 0) + 1;
        const run = async () => {
            _trvBusy.add(m.id); _trvRepaint();
            try {
                const json = await svTrialCall(Object.assign({ action: 'answer', client: m.trial.slug, post_id: m.id, stage: _trvStage(mode) }, body));
                const e = _trv[m.trial.slug];
                if (e && json.versions && seq === _trvSeq[m.id]) e.cards[m.id] = Object.assign({}, e.cards[m.id] || {}, json, { enabled: true });
                return json;
            } finally {
                if (seq === _trvSeq[m.id]) _trvBusy.delete(m.id);
                _trvRepaint();
            }
        };
        const p = (_trvChain[m.id] || Promise.resolve()).catch(() => {}).then(run);
        _trvChain[m.id] = p;
        p.catch(() => {}).finally(() => { if (_trvChain[m.id] === p) delete _trvChain[m.id]; });
        return p;
    }
    /* The owner's choice (a), 2026-10-29 (OPEN_REPAIRS 587): a change on one version keeps the card where it is while
       another live version still waits for this reviewer; only that version waits for its new cut. Once nothing waits
       for this reviewer and a change is open, the card goes to Tweaks Needed as today (the note already went). */
    function _trvOthersWait(versions, stage, except) {
        return (versions || []).some(v => v.letter !== except && _trvLive(v) && !v.client_pass_at && v.status !== 'change asked' && _trvAnswer(v, stage) === 'wait');
    }
    // After an answer that did not finish the stage: does the card now go to Tweaks Needed?
    function _trvSettlesToTweaks(versions, stage) {
        const vs = (versions || []).filter(v => _trvLive(v) && !v.client_pass_at);
        // Per-version routing: a version still on its way to a reviewer holds the card where it is.
        if (vs.some(v => ['smm', 'kasper', 'client', 'team'].includes(_trvPlace(v)))) return false;
        return !_trvOthersWait(versions, stage) && vs.some(v => v.status === 'change asked');
    }
    function _trvDone(json, mode) {
        const stage = _trvStage(mode);
        return stage === 'client' ? !!json.card_approvable : !!(json.stages_done && json.stages_done[stage]);
    }
    /* Approve the version on screen. `proceed` is today's approve on the video part; it runs only once the stage is done. */
    /* A second press right after the page moved on (a double click) lands on the next version's button: it is ignored
       for a moment, so one press answers one version (Allactions, 2026-10-28: a double click approved A and B; the
       likely reason Sidney's approve landed on Video B). */
    const TRV_SETTLE_MS = 700;
    const _trvMovedAt = {};   // post id -> when an answer last moved the page to the next version
    const _trvJustMoved = m => Date.now() - (_trvMovedAt[m.id] || 0) < TRV_SETTLE_MS;
    // `onAhead(letters)`: the card is already further on, so this answer moved versions only (the SMM's Review tab
    // then marks their own change requests done).
    async function svTrialReviewApprove(m, mode, proceed, all, toTweaks, onAhead) {
        if (!all && _trvJustMoved(m)) return;
        const letter = _trvCurOf(m, mode).letter, stage = _trvStage(mode), slug = m.trial.slug;
        const body = all ? { kind: 'approve_all' } : { kind: 'approve', letter };
        const local = _trvLocal(m, mode, body);
        if (local) {
            // On to the next version still waiting for this reviewer, now.
            const next = local.versions.filter(_trvLive).find(v => _trvAnswer(v, stage) === 'wait');
            if (next) { _trvCur[m.id] = next.letter; _trvMovedAt[m.id] = Date.now(); }
            _trvRepaint();
        }
        let json;
        try { json = await _trvAnswerCall(m, mode, body); }
        catch (e) {
            // Back as it was: this version on screen, the card as the server has it.
            const ent = _trv[slug];
            if (local && ent && ent.cards[m.id] && ent.cards[m.id].versions === local.versions) ent.cards[m.id] = local.before;
            _trvCur[m.id] = letter;
            _trvRepaint();
            showNotify(_trvW(m) + letter + ' was not approved', svTrialErrorText(e));
            _trvLoad(slug, true);
            return;
        }
        // A card already further on stays: this answer moved a version, not the card (per-version routing).
        const ahead = _trvCardAhead(m.post, stage);
        if (ahead && typeof onAhead === 'function') onAhead(all ? (json.versions || []).filter(v => _trvLive(v) && v.status !== 'change asked').map(v => v.letter) : [letter]);
        if (!ahead && _trvDone(json, mode)) { proceed(); return; }
        if (!ahead && typeof toTweaks === 'function' && _trvSettlesToTweaks(json.versions, stage)) toTweaks();
        if (!local) {
            const next = (json.versions || []).filter(_trvLive).find(v => _trvAnswer(v, stage) === 'wait');
            if (next) _trvCur[m.id] = next.letter;
        }
        _trvRepaint();
    }
    /* "Not this one" on the version on screen: at once, as Approve is; the page moves on to the next version still
       waiting. A refused pass puts the version back and says so. Once every other version is approved, `proceed` is
       today's approve on the video part (a passed version does not hold the card back). */
    async function svTrialReviewPass(m, mode, proceed, toTweaks) {
        if (_trvJustMoved(m) || !svTrialReviewCanPass(m, mode)) return;
        const letter = _trvCurOf(m, mode).letter, slug = m.trial.slug;
        const e = _trv[slug], card = e && e.cards[m.id];
        let before = null;
        if (card && Array.isArray(card.versions)) {
            before = card;
            const now = new Date().toISOString();
            const versions = card.versions.map(v => v.letter === letter ? Object.assign({}, v, { client_pass_at: now }) : v);
            e.cards[m.id] = Object.assign({}, card, { versions });
            const next = versions.filter(_trvLive).find(v => _trvAnswer(v, 'client') === 'wait');
            if (next) { _trvCur[m.id] = next.letter; _trvMovedAt[m.id] = Date.now(); }
            _trvRepaint();
        }
        let json;
        try { json = await _trvAnswerCall(m, mode, { kind: 'pass', letter }); }
        catch (err) {
            const ent = _trv[slug];
            if (before && ent) ent.cards[m.id] = before;
            _trvCur[m.id] = letter;
            _trvRepaint();
            const code = String((err && err.code) || '');
            showNotify(_trvW(m) + letter + ' was not saved', code === 'last_live_version' ? 'This is the last version left. Approve it or ask for a change.'
                : code === 'pass_unavailable' ? 'This is not ready yet. Tell your manager which version you do not want.' : svTrialErrorText(err));
            _trvLoad(slug, true);
            return;
        }
        if (_trvCardAhead(m.post, 'client')) return;
        if (_trvDone(json, mode)) proceed();
        else if (typeof toTweaks === 'function' && _trvSettlesToTweaks(json.versions, 'client')) toTweaks();
    }
    /* A change on the version on screen: today's change request goes at once, naming it, and the version's own change
       is written too. That write is kept in this browser until the function takes it, and sent again after every
       versions read, so a refused or lost one is never dropped (it is what restarts the version when its new cut lands). */
    const TRV_PENDING_KEY = 'syncview_trv_pending_v1';
    function _trvPendingRead() { try { const v = JSON.parse(localStorage.getItem(TRV_PENDING_KEY) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; } }
    function _trvPendingWrite(list) { try { if (list.length) localStorage.setItem(TRV_PENDING_KEY, JSON.stringify(list.map(j => Object.assign({ slug: j.slug, pid: j.pid, stage: j.stage, letter: j.letter, note: j.note, at: j.at }, j.part ? { part: j.part } : {})))); else localStorage.removeItem(TRV_PENDING_KEY); } catch (e) {} }
    let _trvPendingMem = null;   // the same list when storage is blocked
    const _trvPending = () => _trvPendingMem || (_trvPendingMem = _trvPendingRead());
    function _trvPendingSave() { _trvPendingWrite(_trvPending()); }
    async function _trvSendChange(job) {
        try {
            // V4: the part, only when the page named one (switch on); a write kept from before carries none.
            const json = await svTrialCall(Object.assign({ action: 'answer', client: job.slug, post_id: job.pid, stage: job.stage, kind: 'change', letter: job.letter, note: job.note }, job.part ? { part: job.part } : {}));
            const list = _trvPending(), i = list.indexOf(job);
            if (i >= 0) { list.splice(i, 1); _trvPendingSave(); }
            const e = _trv[job.slug];
            if (e && json.versions) e.cards[job.pid] = Object.assign({}, e.cards[job.pid] || {}, json, { enabled: true });
            _trvRepaint();
            if (typeof job.onLanded === 'function') { const f = job.onLanded; job.onLanded = null; try { f(json); } catch (err2) {} }
            return true;
        } catch (err) {
            // The version is gone, dropped or already decided: nothing left to record.
            if (['version_not_found', 'version_dropped', 'version_on_trial', 'trial_reels_off', 'not_enabled'].includes(String(err && err.code || ''))) {
                const list = _trvPending(), i = list.indexOf(job);
                if (i >= 0) { list.splice(i, 1); _trvPendingSave(); }
            } else _trvRetryLater(job);
            return false;
        }
    }
    /* A refused or lost write is tried again on its own, sooner first, while the page stays open (Trialtest, live on
       PR 2444: the retry waited for a versions read, and a client page left open never read again). A read that comes
       first sends it too (_trvFlush); one try at a time. */
    const TRV_RETRY_MS = [3000, 10000, 30000, 60000];
    function _trvRetryLater(job) {
        if (job.retryT || !_trvPending().includes(job)) return;
        const ms = TRV_RETRY_MS[Math.min(job.tries || 0, TRV_RETRY_MS.length - 1)];
        job.tries = (job.tries || 0) + 1;
        job.retryT = setTimeout(() => {
            job.retryT = 0;
            if (job.inFlight || !_trvPending().includes(job)) return;
            job.inFlight = true;
            _trvSendChange(job).finally(() => { job.inFlight = false; });
        }, ms);
    }
    // The connection is back: every kept write goes at once, not on its next timer.
    window.addEventListener('online', () => {
        _trvPending().filter(j => !j.inFlight).forEach(j => { clearTimeout(j.retryT); j.retryT = 0; j.inFlight = true; _trvSendChange(j).finally(() => { j.inFlight = false; }); });
    });
    function _trvFlush(slug) {
        _trvPending().filter(j => j.slug === slug && !j.inFlight).forEach(j => { j.inFlight = true; _trvSendChange(j).finally(() => { j.inFlight = false; }); });
    }
    // The version on screen now ('' when the card has no open trial): a change box remembers it when it opens.
    function svTrialReviewLetter(m, mode) {
        return m && m.trial && !m.trial.winner ? _trvCurOf(m, mode).letter : '';
    }
    /* `asked` is the version the change was asked on (the box remembers it when it opens, and the client's queue keeps
       it with each change): a change sent after a look at another version is still about the one it was asked on
       (Probe bugs 10 and 10b). Without it, the version on screen. */
    function svTrialReviewChangeText(m, mode, text, frameNote, asked, onLanded, part) {
        const had = asked && m.trial.versions.find(v => v.letter === asked);
        const letter = had ? had.letter : _trvCurOf(m, mode).letter;
        // V4: with the switch on, the change names its part (Kasper's "Tweaks are on Frame" is always the video's).
        const pt = svTrialReviewFieldsOn(m) ? (frameNote ? 'video' : _trvPart(part)) : '';
        const job = { slug: m.trial.slug, pid: m.id, stage: _trvStage(mode), letter, note: text, at: Date.now(), onLanded };
        if (pt) job.part = pt;
        _trvPending().push(job); _trvPendingSave();
        // The version reads "change asked" at once, as Approve does (Trialtest, 2026-10-28: the client's own dot stayed
        // waiting); the server's answer, or the next read, replaces it.
        const ent = _trv[m.trial.slug], card = ent && ent.cards[m.id];
        if (card && Array.isArray(card.versions)) {
            ent.cards[m.id] = Object.assign({}, card, { versions: card.versions.map(v => v.letter === letter && _trvLive(v) && ['waiting', 'approved'].includes(v.status) ? Object.assign({}, v, { status: 'change asked', change_by: job.stage }, pt ? { change_part: pt === 'video' ? null : pt } : {}) : v) });
            _trvRepaint();
        }
        job.inFlight = true;
        _trvSendChange(job).then(ok => {
            job.inFlight = false;
            if (!ok && _trvPending().includes(job)) showNotify(_trvW(m) + letter + "'s change is not on the version yet", navigator.onLine === false
                ? 'You are offline. Marking ' + _trvW(m) + letter + ' as changed goes once your connection is back.'
                : 'Your words are kept. Marking ' + _trvW(m) + letter + ' as changed will be tried again in a moment.');
        });
        // Kasper's "Tweaks are on Frame" stays word for word: every page reads that exact note.
        return frameNote ? text : _trvW(m) + letter + (pt && pt !== 'video' ? ', ' + pt : '') + ': ' + text;
    }

    /* KASPER'S SECOND LAYOUT (decision 4): every version side by side, each named "Video A"… with its own Approve, change
       and drop, like today's per-part buttons, and "Approve all" at the top. Only the version on stage loads its video
       (the player beside the tiles); the tiles show the card's poster. A press on a tile puts that version on stage. */
    function svTrialReviewTilesHtml(m, mode) {
        if (!m || !m.trial || m.trial.winner || m.trial.versions.length < 2) return '';
        const vs = m.trial.versions, stage = _trvStage(mode), cur = _trvCurOf(m, mode), busy = _trvBusy.has(m.id);
        const open = vs.filter(v => _trvAnswer(v, stage) === 'wait');
        // The card's poster; a card whose thumbnail is a Frame.io page has no picture, so each tile shows a quiet video
        // mark there instead of a black square (owner, 2026-10-28).
        const poster = m.thumb ? '<img alt="" src="' + _calEscAttr(m.thumb) + '">' : TRV_PLAY;
        const own = svTrialReviewFieldsOn(m);
        const actsOf = {};
        const tiles = vs.map(v => {
            const a = _trvAnswer(v, stage), l = _calEscAttr(v.letter);
            // V4: each tile shows its version's own thumbnail (else the card's poster, as before).
            const vp = own ? _trvPicOf(m, v) : '';
            const vposter = vp ? TRV_PLAY + _trvImg(vp, '') : poster;
            const dropBtn = v.on_card && !_trvNextLive(vs, v.letter) ? '' : '<button type="button" class="trk-ic" data-trk-drop="' + l + '" title="Drop this version" aria-label="Drop ' + _trvW(m) + l + '"' + (busy ? ' disabled' : '') + '>' + TRV_DROP + '</button>';
            // The client said "Not this one": the team sees it and drops the version (owner, 2026-10-28).
            const acts = v.client_pass_at && v.status === 'waiting'
                ? '<span class="trk-lab" data-l="passed" title="The client dropped this version">Client dropped</span>' + dropBtn
                : a === 'wait'
                ? '<button type="button" class="trk-ok" data-trk-ok="' + l + '" aria-label="Approve ' + _trvW(m) + l + '"' + (busy ? ' disabled' : '') + '>Approve</button>'
                    + '<button type="button" class="trk-ic" data-trk-chg="' + l + '" title="Ask for a change" aria-label="Ask for a change to ' + _trvW(m) + l + '"' + (busy ? ' disabled' : '') + '>' + TRV_BACK + '</button>'
                    + dropBtn
                // A version the SMM has not looked at is with the team, never "change asked" (follow-up, 2026-10-28).
                : '<span class="trk-lab" data-l="' + (a === 'ok' ? 'approved' : a === 'team' ? 'team' : 'change') + '">' + (a === 'ok' ? 'approved' : a === 'team' ? 'with the team' : 'change asked') + '</span>';
            actsOf[v.letter] = acts;
            return '<div class="trk-v' + (v === cur ? ' cur' : '') + '"><button type="button" class="trk-go" data-trk-go="' + l + '" aria-label="Put ' + _trvW(m) + l + ' on stage"' + (v === cur ? ' aria-current="true"' : '') + '>'
                + '<span class="trk-pic">' + vposter + '</span><span class="trk-nm"><span class="trk-n">' + _trvW(m) + l + '</span>'
                + (_trvClientOk(v, stage) ? '<span class="trv-cok" title="The client approved ' + _trvW(m) + l + '">Client approved</span>' : '') + '</span></button><div class="trk-acts">' + acts + '</div></div>';
        }).join('');
        // Version tabs: the segmented control, then the selected version's own Approve, change and drop beside it.
        if (_trvTabs(m)) return '<div class="trk trs-k"><div class="trs-row">' + _trvTabsHtml(m, mode, 'data-trk-go')
            + '<div class="trk-acts trs-acts">' + (actsOf[cur.letter] || '') + '</div>'
            + (open.length > 1 ? '<button type="button" class="trk-all" data-trk-all="1" title="Approve the ' + open.length + ' versions still waiting"' + (busy ? ' disabled' : '') + '>' + TRV_CHECK + 'Approve all</button>' : '')
            + (busy ? '<span class="trv-busy" role="status">' + svBusyHtml('Saving…') + '</span>' : '') + '</div></div>';
        return '<div class="trk" role="group" aria-label="Versions of this video"><div class="trk-h"><span class="trk-t"><span class="trv-tag trk-tag">Trial</span> ' + vs.length + ' versions</span>'
            + (open.length > 1 ? '<button type="button" class="trk-all" data-trk-all="1" title="Approve the ' + open.length + ' versions still waiting"' + (busy ? ' disabled' : '') + '>' + TRV_CHECK + 'Approve all</button>' : '')
            + (busy ? '<span class="trv-busy" role="status">' + svBusyHtml('Saving…') + '</span>' : '') + '</div><div class="trk-g">' + tiles + '</div>' + svTrialReviewFieldsHtml(m, mode) + '</div>';
    }
    // The tiles' placeholders, drawn at once in their place while the card's trial read is not in (one line, three tiles).
    function svTrialReviewSkeletonHtml() {
        const B = (w, h, r) => '<i class="sk-b" style="width:' + w + ';height:' + h + (r ? ';border-radius:' + r : '') + '"></i>';
        const tile = '<div class="trk-v"><span class="trk-go"><span class="trk-pic"></span>' + B('52px', '.8em', '5px') + '</span><div class="trk-acts">' + B('100%', '26px', '8px') + '</div></div>';
        return '<div class="trk trk-skel" aria-hidden="true"><div class="trk-h"><span class="trk-t">' + B('104px', '.8em', '5px') + '</span></div><div class="trk-g">' + tile + tile + tile + '</div></div>';
    }
    function svTrialReviewBindTiles(el, m, mode, on) {
        if (!el || !m || !m.trial) return;
        // A press on a tile names its own version, so it is never held back as a double click.
        const pick = letter => { _trvCur[m.id] = letter; _trvMovedAt[m.id] = 0; };
        el.querySelectorAll('[data-trk-go]').forEach(b => b.addEventListener('click', () => { pick(b.dataset.trkGo); _trvRepaint(); }));
        el.querySelectorAll('[data-trk-ok]').forEach(b => b.addEventListener('click', () => { pick(b.dataset.trkOk); on.approve(); }));
        el.querySelectorAll('[data-trk-chg]').forEach(b => b.addEventListener('click', () => { pick(b.dataset.trkChg); _trvRepaint(); on.change(); }));
        el.querySelectorAll('[data-trk-drop]').forEach(b => b.addEventListener('click', () => svTrialReviewDrop(m, b.dataset.trkDrop, mode, on.proceed, on.toTweaks)));
        el.querySelectorAll('[data-trk-all]').forEach(b => b.addEventListener('click', () => on.all()));
    }
    const _trvNextLive = (vs, letter) => (vs || []).find(x => x.letter !== letter && x.status !== 'dropped' && x.frame_url) || null;
    /* Only the team drops a version (Q2): Kasper's tile, through the function. The version on the card (default (c)):
       today's attach first puts the next live version on the card, then the old one drops. */
    /* A drop can finish this reviewer's stage: the version dropped was the last one waiting for them, and the others
       already have their OK (session Trialchange, live on the test client, 2026-11-01: Kasper approved A and B and
       dropped C, and the card stayed at Kasper Approval with "Every version is approved" and the approve again). The drop
       then goes on as that last approve would: `proceed` (today's approve on the video part) once the function says the
       stage is done, or `toTweaks` when only changes are left. A card already further on stays where it is. */
    async function svTrialReviewDrop(m, letter, mode, proceed, toTweaks) {
        if (_trvBusy.has(m.id)) return;
        _trvBusy.add(m.id); _trvRepaint();
        const v = m.trial.versions.find(x => x.letter === letter), next = v && v.on_card ? _trvNextLive(m.trial.versions, letter) : null;
        const before = String((m.post && m.post.asset_url) || '');
        let mine = null, after = null;
        try {
            if (next) mine = await svTrialMoveCard(m.post, next.frame_url);
            const json = await svTrialCall({ action: 'version_drop', client: m.trial.slug, post_id: m.id, letter });
            const e = _trv[m.trial.slug];
            if (e && json.versions) e.cards[m.id] = Object.assign({}, e.cards[m.id] || {}, json, { enabled: true });
            if (_trvCur[m.id] === letter) delete _trvCur[m.id];
            const stage = _trvStage(mode);
            if (mode && json.versions && !_trvCardAhead(m.post, stage)) {
                if (_trvDone(json, mode) && json.versions.some(v => _trvLive(v) && _trvAnswer(v, stage) === 'ok')) after = proceed;
                else if (_trvSettlesToTweaks(json.versions, stage)) after = toTweaks;
            }
        } catch (err) {
            showNotify(_trvW(m) + letter + ' was not dropped', svTrialErrorText(err));
            // The card's link moves only once the function says yes (Probe bug 12b): a refused drop puts it back.
            if (mine !== null) { try { await svTrialAttachBack(m.post, before, mine, next.frame_url); } catch (e2) {} _trvLoad(m.trial.slug, true); }
        } finally {
            _trvBusy.delete(m.id); _trvRepaint();
        }
        if (typeof after === 'function') after();
    }
    const TRV_PLAY = '<svg class="trk-mark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.5 3.8v8.4a.6.6 0 0 0 .9.5l6.6-4.2a.6.6 0 0 0 0-1L6.4 3.3a.6.6 0 0 0-.9.5z"/></svg>';
    const TRV_CHECK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"/></svg>';
    const TRV_BACK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6H11a2.5 2.5 0 0 1 0 5H8"/><path d="M7 4 5 6l2 2"/></svg>';
    const TRV_DROP = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>';

    const TRV_CSS = `
.trk{display:flex;flex-direction:column;gap:8px;margin:0 0 10px}
.trk-h{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:32px}
.trk-t{font-size:.78rem;font-weight:700;color:var(--text-secondary)}
.trk-t .trk-tag{display:inline;padding:0 4px 0 0}
.trk-all{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--hair);border-radius:10px;background:var(--deck);color:var(--text-primary);font:inherit;font-size:.8rem;font-weight:600;padding:7px 13px;cursor:pointer}
.trk-all:hover:not([disabled]){background:var(--fill-hover)}
.ql-r .trv-vn{color:var(--pd-video);font-weight:600;white-space:nowrap}
.trk-all svg{width:13px;height:13px}
.trk-all[disabled]{opacity:.6;cursor:default}
/* 136 px holds "Client dropped" beside its Drop button on one line (Nightreel, 2026-10-30: it read "Client dropp…"). */
.trk-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(136px,1fr));gap:8px}
.trk-v{display:flex;flex-direction:column;gap:5px;border:1px solid var(--border);border-radius:10px;padding:5px;background:var(--surface-raised)}
.trk-v.cur{border-color:var(--text-primary);box-shadow:0 0 0 1px var(--text-primary)}
.trk-go{display:flex;align-items:center;gap:8px;border:0;background:none;padding:0;cursor:pointer;color:inherit;font:inherit;text-align:left}
.trk-pic{display:block;flex:none;width:28px;height:40px;border-radius:5px;background:var(--media-bg);overflow:hidden}
.trk-pic img{width:100%;height:100%;object-fit:cover;display:block}
.trk-pic:has(>.trk-mark){display:grid;place-items:center;background:var(--fill);color:var(--pd-video)}
.trk-mark{width:13px;height:13px}
.trk-skel .trk-pic{background:var(--fill)}
.trk-skel .trk-acts .sk-b{display:block}
.trk-n{font-size:.8rem;font-weight:700;color:var(--text-primary)}
.trk-acts{display:flex;align-items:center;gap:4px;min-height:28px}
.trk-ok{flex:1 1 auto;border:0;border-radius:8px;background:var(--ok-solid-bg);color:var(--ok-solid-fg);font:inherit;font-size:.75rem;font-weight:700;padding:5px 8px;cursor:pointer}
.trk-ic{display:grid;place-items:center;width:28px;height:28px;border:0;border-radius:8px;background:var(--fill);color:var(--text-primary);cursor:pointer;padding:0}
.trk-ic svg{width:13px;height:13px}
.trk-ok[disabled],.trk-ic[disabled]{opacity:.6;cursor:default}
.trk-lab{border-radius:4px;padding:2px 8px;font-size:.7rem;font-weight:700;background:var(--fill);color:var(--text-secondary)}
.trk-lab[data-l="approved"]{background:var(--ok-soft-2);color:var(--ok-ink)}
.trv-cok{border-radius:4px;padding:1px 6px;font-size:.68rem;font-weight:700;white-space:nowrap;background:var(--ok-soft-2);color:var(--ok-ink)}
.trk-nm{display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-width:0}
.trk-nm .trv-cok{font-size:.6rem;padding:1px 4px}
.trk-go:has(.trv-cok){gap:5px}
.trk-lab[data-l="change"]{background:var(--warn-soft);color:var(--warn-ink)}
.trk-lab[data-l="passed"]{background:var(--fill);color:var(--text-secondary);white-space:nowrap;font-size:.66rem;padding:2px 6px}
.trk-acts:has(>.trk-lab[data-l="passed"]){justify-content:space-between}
.trv{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;min-height:32px;padding:2px 0 6px;font-size:.78rem}
.trv-under{flex-direction:column;gap:6px;padding:10px 0 2px;min-height:0}
.trv-n{font-weight:700;color:var(--text-primary);text-align:center;font-size:.86rem}
.trv-tag{display:block;padding-top:10px;text-align:center;font-size:.66rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-secondary)}
.trv-tag + .trv-under{padding-top:2px}
.trv-why{display:block;padding:2px 16px 0;text-align:center;font-size:.74rem;line-height:1.35;color:var(--text-secondary)}
.trv-why + .trv-under{padding-top:4px}
.trv-of{font-weight:500;color:var(--text-secondary)}
.trv-dots{display:inline-flex;align-items:center;gap:2px}
.trv-dot{display:grid;place-items:center;width:26px;height:26px;border:0;background:none;font:inherit;cursor:pointer;padding:0}
.trv-dot i{display:grid;place-items:center;width:22px;height:22px;box-sizing:border-box;border:1px solid var(--hair);border-radius:50%;color:var(--text-secondary);font-style:normal;font-size:.62rem;font-weight:700}
.trv-dot.ok i{background:var(--ok-soft-2);border-color:var(--ok-line);color:var(--ok-ink)}
.trv-dot.chg i{background:var(--chgb);border-color:var(--chgrow-line);color:var(--chg-fg)}
.trv-dot.team i{opacity:.45;border-style:dashed}
.trv-dot.pass i{position:relative;background:var(--fill);color:var(--text-secondary);text-decoration:line-through}
.trv-dot.pass i::after{content:'×';position:absolute;top:-5px;right:-5px;width:12px;height:12px;border-radius:50%;display:grid;place-items:center;background:var(--text-secondary);color:var(--surface-raised);font-size:10px;line-height:1;text-decoration:none}
.trv-dot.on i{border-color:var(--pd-video);color:var(--pd-video);box-shadow:0 0 0 1px var(--pd-video)}
.trv-swipe{display:none;color:var(--text-secondary);font-size:.72rem}
.trv-arr{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--hair);border-radius:50%;background:var(--deck);color:var(--text-primary);cursor:pointer;padding:0}
.trv-arr:hover:not([disabled]){background:var(--fill-hover)}
.trv-arr[disabled]{opacity:.35;cursor:default}
.trv-arr svg{width:14px;height:14px}
.trv-side{position:absolute;top:50%;transform:translateY(-50%);z-index:5}
.trv-side.prev{left:calc(50% - var(--trv-half,140px) - 58px)}
.trv-side.next{left:calc(50% + var(--trv-half,140px) + 14px)}
.trv-all{display:inline-flex;align-items:center;gap:6px}
.trv-all svg{width:14px;height:14px}
.trv-busy{color:var(--text-secondary)}
.dfin:has(.trv-all){flex:1 1 auto;justify-content:space-between;align-items:center;gap:12px}
/* V4: the version's own thumbnail and caption, under its player; the parts a change on it can be about. */
.trv-fx{display:flex;align-items:flex-start;gap:10px;margin:8px auto 0;max-width:420px;padding:8px;border:1px solid var(--border);border-radius:10px;background:var(--surface-raised);text-align:left}
.trv-fx-pic{position:relative;display:grid;place-items:center;flex:none;width:45px;height:80px;border-radius:6px;overflow:hidden;background:var(--fill);color:var(--pd-video)}
.trv-fx-pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.trv-fx-pic img[hidden],.trk-pic img[hidden]{display:none}
.trk-pic:has(>.trk-mark+img){position:relative;display:grid;place-items:center;background:var(--fill);color:var(--pd-video)}
.trk-pic:has(>.trk-mark+img) img{position:absolute;inset:0}
.trv-fx-t{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1 1 auto}
.trv-fx-l{font-size:.68rem;font-weight:600;color:var(--text-secondary)}
.trv-fx-cap{font-size:.8rem;line-height:1.35;color:var(--text-primary);white-space:pre-wrap;overflow-wrap:anywhere;max-height:8.2em;overflow:auto}
.trv-fx-cap.none{color:var(--text-secondary)}
.trk .trv-fx{max-width:none;margin:0}
.trv-parts{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:0 0 6px}
.trv-parts .lbl{font-size:.72rem;font-weight:700;color:var(--text-secondary)}
.trv-pt{border:1px solid var(--hair);border-radius:999px;background:var(--deck);color:var(--text-primary);font:inherit;font-size:.76rem;font-weight:600;padding:4px 11px;cursor:pointer}
.trv-pt:hover{background:var(--fill-hover)}
.trv-pt[aria-pressed="true"]{border-color:var(--text-primary);box-shadow:0 0 0 1px var(--text-primary)}
@media (max-width:600px){.trv-side{display:none}.trv-swipe{display:block;order:3}.trv-under{padding-top:6px}.dfin:has(.trv-all) .finish{width:100%;white-space:nowrap;height:44px}.trv-dots{gap:0}.dfin:has(.trv-all) .trv-all{width:100%;justify-content:center;white-space:nowrap}}

/* Version tabs (688, option B): the segmented control and the board chip. Segment colours are the card status colours. */
.trs{display:flex;gap:22px;justify-content:center;border-bottom:1px solid var(--hair);width:100%;max-width:440px;margin:0 auto}
.trs-s{flex:0 0 auto;min-width:0;height:38px;border:0;border-radius:0;padding:0 2px;display:flex;align-items:center;justify-content:center;gap:7px;font:inherit;font-size:.86rem;font-weight:600;color:var(--text-secondary);background:none;cursor:pointer;position:relative;white-space:nowrap;--trs:var(--text-muted)}
.trs-s::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:transparent}
.trs-d{width:7px;height:7px;border-radius:50%;background:var(--trs);flex:none}
.trs-s[data-a="ok"]{--trs:var(--cal-status-approved-bg)}
.trs-s[data-a="chg"]{--trs:var(--cal-status-tweaks-needed-bg)}
.trs-s[data-a="wait"][data-stage="client"]{--trs:var(--cal-status-client-approval-bg)}
.trs-s[data-a="wait"][data-stage="kasper"]{--trs:var(--cal-status-kasper-approval-bg)}
.trs-s[data-a="wait"][data-stage="smm"]{--trs:var(--cal-status-for-smm-approval-bg)}
.trs-s:hover{color:var(--text-primary)}
.trs-s.on{color:var(--text-primary)}
.trs-s.on::after{background:var(--text-primary)}
.trs-s:focus-visible{outline:2px solid var(--text-primary);outline-offset:2px}
.trs-under{padding-top:12px}
.trs-k .trs-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.trs-k .trs{margin:0;flex:1 1 260px;max-width:none;justify-content:flex-start}
.trs-acts{display:flex;gap:6px;align-items:center}
.trv-chip{display:inline-flex;align-items:center;flex:none;font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-secondary);white-space:nowrap;vertical-align:middle}
@media (max-width:600px){.trs-w{display:none}}
