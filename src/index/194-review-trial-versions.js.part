import { showNotify, svBusyHtml } from './040-shared-briefs.js';
import { calClientSlug } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr } from './131-core-html.js';
import { _calDeriveThumb } from './160-calendar-organize-ui.js';
import { _syncviewStaffIdentityForHeaders } from './100-onboarding-staff-controls.js';
import { svRsFlagsReady, svTrialReelsOn, svTrialVersionsV2On } from './188-review-stage-switch.js';
import { svTrialAttachBack, svTrialCall, svTrialRead, svTrialErrorText, svTrialHash, svTrialListShared, svTrialMoveCard, svTrialOnChange } from './189-trial-reels-card.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    /* TRIAL REELS ON THE REVIEW PAGE (session Trials, 2026-10-27; docs/features/TRIAL_REELS_PLAN.md section 5, approved
       in PR 2352).

       On a card whose Trial reels switch is on (behind trial_reels_pages), the video step of the review page (195:
       the client link, the SMM's Review tab and Kasper's Review Session) shows one version at a time: a bar over the
       player reads "Video B of 5" with a dot per version carrying this reviewer's answer and an arrow on each side
       (no hook text, decision 1), and the player plays that version's link.
         - Approve answers the version on screen (trial-reels "answer"). Only when every version that is not dropped has
           this reviewer's OK does the page call today's approve on the video part, so the card moves as it does today
           (SMM to Kasper or the client, Kasper to the client, the client to Approved).
         - "Approve all" answers every open version at once, then today's approve.
         - Ask for a change answers that version (change asked, with the note) and sends today's change request on the
           video part, starting "Video C:", so the card goes to Tweaks Needed and the editor works as today (Q3).
         - Once a winner is picked the client sees only it: "Video C: the one we are posting" (Q8).
       A card with one live version, or any read that fails, is today's page. Read once per client, kept 30 s. */
    const TRV_TTL_MS = 30000;
    const _trv = {};          // client slug -> { at, cards, promise }
    const _trvCur = {};       // post id -> letter on screen
    const _trvBusy = new Set();
    let _trvRepaint = () => {};

    function svTrialReviewOnChange(fn) { _trvRepaint = typeof fn === 'function' ? fn : () => {}; }
    function _trvSlug(client) { try { return calClientSlug(String(client || '')); } catch (e) { return ''; } }
    /* The review pages (a second client tab, Kasper's and the SMM's) hear trial-reels' broadcast too and read their
       client's cards again at once, not on their 30 s refresh (Trialtest, 2026-10-29). */
    const _trvHeard = {};
    async function _trvOnChange(h) {
        for (const slug of Object.keys(_trv)) {
            const ids = Object.keys(_trv[slug].cards || {});
            for (const id of ids) {
                if (await svTrialHash(id) !== h) continue;
                clearTimeout(_trvHeard[slug]);
                _trvHeard[slug] = setTimeout(() => _trvLoad(slug, true), 120);
                break;
            }
        }
    }
    /* Who may ask trial-reels: a client link (its review token) or a verified staff key. Anyone else (signed out, the
       key not yet checked, Production's own boot before verification) gets a 401 and a red console error, so they read
       nothing and see no versions, as with Trial reels off (session Trialchange, OPEN_REPAIRS 630; Production's
       plp_console_errors went red after PR 2486). */
    function _trvMayRead() {
        if (_isClientLink) return true;
        try { return !!_syncviewStaffIdentityForHeaders(); } catch (e) { return false; }
    }
    function _trvLoad(slug, force) {
        if (!_trvMayRead()) return Promise.resolve(_trv[slug] || null);
        const e = _trv[slug] || (_trv[slug] = { at: 0, cards: {}, promise: null });
        svTrialOnChange(_trvOnChange);
        if (e.promise || (!force && e.at && Date.now() - e.at < TRV_TTL_MS)) return e.promise || Promise.resolve(e);
        // After a read the platform refused (429) or that never arrived, wait a little before asking again (631).
        if (!force && e.failedAt && Date.now() - e.failedAt < TRV_FAIL_COOL_MS) return Promise.resolve(e);
        // A staff page's first read is the Calendar's list of this client (189), which Kasper's queue starts as it
        // arrives; every later one is this page's own, so it never takes back an answer given here since. Its own reads
        // are retried with backoff on a 429 or a lost connection (svTrialRead, OPEN_REPAIRS 631).
        const read = !_isClientLink && !e.at ? svTrialListShared(slug, false) : svTrialRead({ action: 'list', client: slug, post_id: '' });
        if (!e.at && !e.started) { e.started = Date.now(); setTimeout(_trvRepaint, TRV_HOLD_MS + 20); }
        let lost = false;
        e.promise = read
            .then(json => { e.cards = (json && json.cards) || {}; e.failedAt = 0; _trvFlush(slug); })
            // Keep what was read; a page never hides versions on a read it could not make. A refused or lost read does
            // not count as read either: the client is asked again after TRV_FAIL_COOL_MS (OPEN_REPAIRS 631).
            .catch(err => { if (err && err.transient) { lost = true; e.failedAt = Date.now(); } })
            .finally(() => { if (!lost) e.at = Date.now(); e.promise = null; _trvRepaint(); });
        return e.promise;
    }
    const _trvLive = v => v.status !== 'dropped';
    /* THE FIRST TRIAL READ, AND THE VIDEO'S ANSWER BEFORE IT (session Trialchange, live on the test client, 2026-11-01).
       The read started only when the review first drew, so a trial card read as an ordinary card for about a second
       (0.87 to 0.99 s, four runs): the client's Approve then answered the whole video, not a version. A client link now
       starts it with the switch read, beside the card read; and until it is in (TRV_HOLD_MS at most), the video's answer
       waits on any card of a client trial reels is on for (svTrialReviewPending). After that the page is today's, as on
       a read that failed. */
    const TRV_HOLD_MS = 2000;
    const TRV_FAIL_COOL_MS = 10000;
    // After every module has loaded (_isClientLink is declared in 260, which loads after this one).
    setTimeout(() => {
        try {
            if (!_isClientLink) return;
            const c = new URLSearchParams(location.search).get('c') || '';
            if (c) svRsFlagsReady().then(() => { const slug = _trvSlug(c); if (slug && svTrialReelsOn(slug)) _trvLoad(slug); }, () => {});
        } catch (e) {}
    }, 0);

    /* The trial shape of one card for the review page, or null for today's page. Samples have no trial. */
    function svTrialReviewShape(post, mode, item) {
        if (!post || !post.id || (item && item._sxr)) return null;
        const slug = _trvSlug(post.client || (item && item.client) || '');
        if (!slug || !svTrialReelsOn(slug)) return null;
        const e = _trv[slug];
        if (!e || !e.at) { _trvLoad(slug); return null; }
        if (Date.now() - e.at > TRV_TTL_MS) _trvLoad(slug);
        const shape = e.cards[post.id];
        if (!shape || !shape.enabled || !Array.isArray(shape.versions)) return null;
        const winner = shape.versions.find(v => v.status === 'winner');
        if (winner) return mode === 'client' ? { slug, winner, versions: [winner], shape } : null;
        // One live version still goes through its own answer, so the trial can start once it is approved. The client link
        // shows only versions that have come through the team (per-version routing: never one still with the SMM or Kasper).
        const live = shape.versions.filter(_trvLive).filter(v => mode !== 'client' || v.ready !== false);
        return live.length ? { slug, versions: live, shape } : null;
    }
    /* The card's trial read is not in yet for a client the switch lists: the page draws a row of tile placeholders in
       the tiles' place (Kasper's second layout), never a late pop-in. */
    function svTrialReviewPending(post, item) {
        if (!post || !post.id || (item && item._sxr)) return false;
        const slug = _trvSlug(post.client || (item && item.client) || '');
        if (!slug || !svTrialReelsOn(slug) || !_trvMayRead()) return false;
        if (!_trv[slug]) _trvLoad(slug);
        const e = _trv[slug];
        if (!e) return false;
        return !e.at && (!e.started || Date.now() - e.started < TRV_HOLD_MS);
    }
    const _trvStage = mode => mode === 'client' ? 'client' : mode === 'smm' ? 'smm' : 'kasper';
    /* This reviewer's answer on one version: ok, chg or wait. */
    /* This reviewer's answer on one version: ok, chg, wait, or team: Kasper and the client answer a version only after
       the SMM has looked at it (the function's stage order), so until then it is "with the team": no Approve, a muted
       dot, not counted in Approve all (Probe rule-miss 13). A read without `ready` (older) counts as ready. */
    function _trvAnswer(v, stage) {
        if (v.status === 'change asked') return 'chg';
        // The client's "Not this one": answered, for the client; for the team (the SMM's Review tab, Kasper's standard
        // layout) it is "Client dropped", never another Approve, and the team drops it (Trialtest, 2026-10-28).
        if (v.client_pass_at && v.status === 'waiting') return stage === 'client' ? 'pass' : 'cpass';
        const ok = stage === 'client' ? ['approved', 'on trial', 'winner', 'lost'].includes(v.status) : !!v[stage + '_ok_at'];
        if (ok) return 'ok';
        const ready = stage === 'smm' || (v.ready !== undefined ? v.ready !== false : stage === 'client' || !!v.smm_ok_at);
        return ready ? 'wait' : 'team';
    }
    /* The client approved a version this staff reviewer has not answered yet (a card sent straight to Client Approval):
       the team sees that, and its own Approve still works (owner, 2026-10-28: approved things show as approved). */
    const _trvClientOk = (v, stage) => stage !== 'client' && !!v.client_ok_at && !v.client_pass_at && ['wait', 'team'].includes(_trvAnswer(v, stage));
    /* PER-VERSION ROUTING (Sidney, 2026-10-29: "Other videos should go to Kasper while one of them is out for a change";
       plan section 5). Each live version has its own place (the function's `place`: smm, kasper, client, approved,
       new_cut, client_dropped), so a reviewer works the versions waiting for them whatever the card's status says, and
       the card moves on once nothing waits for a reviewer and one version has passed them. */
    const TRV_RANK = { 'For SMM Approval': 1, 'Kasper Approval': 2, 'Client Approval': 3, 'Approved': 4, 'Scheduled': 4, 'Posted': 4 };
    const TRV_STAGE_RANK = { smm: 1, kasper: 2, client: 3 };
    function _trvPlace(v) {
        if (v.place) return v.place;
        // An older read (or a client read) carries no place: the same rules from what it has.
        if (v.status === 'dropped') return 'dropped';
        if (v.status === 'change asked') return 'new_cut';
        if (v.client_pass_at) return 'client_dropped';
        if (['approved', 'on trial', 'winner', 'lost'].includes(v.status)) return v.status;
        if (v.ready !== undefined && v.smm_ok_at === undefined) return v.ready ? 'client' : 'team';
        return !v.smm_ok_at ? 'smm' : !v.kasper_ok_at ? 'kasper' : 'client';
    }
    // The card's status is past this reviewer's own (the work went on): their answers move versions, never the card.
    function _trvCardAhead(post, stage) {
        const s = String((post && post.video_status) || '').trim();
        return (TRV_RANK[s] || 0) > (TRV_STAGE_RANK[stage] || 0);
    }
    /* Does a version of this card wait for this reviewer? null while the versions are not read yet (the page then goes
       by the card's status alone, as before). */
    function svTrialStageWaits(post, mode) {
        if (!post || !post.id) return null;
        const slug = _trvSlug(post.client || '');
        if (!slug || !svTrialReelsOn(slug)) return null;
        const e = _trv[slug];
        if (!e || !e.at) { _trvLoad(slug); return null; }
        const shape = e.cards[post.id];
        if (!shape || !shape.enabled || !Array.isArray(shape.versions)) return null;
        if (shape.versions.some(v => v.status === 'winner')) return false;
        const stage = _trvStage(mode), live = shape.versions.filter(_trvLive);
        if (live.some(v => _trvPlace(v) === stage)) return true;
        // The client: nothing for them while the only open version is still with the team; with nothing open anywhere the
        // card's status decides (today's approve moves it on).
        if (stage === 'client') return live.some(v => ['smm', 'kasper', 'team'].includes(_trvPlace(v))) ? false : null;
        return false;
    }
    /* After a change on `letter` at this reviewer's stage, what the card does:
         'ahead'  the card is already further on: it stays (the version waits for its new cut by itself);
         'keep'   another version still waits for this reviewer, or one is still on its way: it stays (option (a));
         'move'   nothing waits for this reviewer and another version passed them: it goes on now (SMM and Kasper);
         'tweaks' nothing waits anywhere: Tweaks Needed, as today. */
    function svTrialReviewAfterChange(m, mode, letter) {
        if (!m || !m.trial || m.trial.winner) return 'tweaks';
        const stage = _trvStage(mode);
        if (_trvCardAhead(m.post, stage)) return 'ahead';
        // From every version, not only the ones on screen: the client's list leaves out the versions still with the team,
        // and those keep the card where it is (Codex on PR 2452).
        const all = (m.trial.shape && Array.isArray(m.trial.shape.versions)) ? m.trial.shape.versions : m.trial.versions;
        const rest = all.filter(v => v.letter !== letter && _trvLive(v) && !v.client_pass_at && v.status !== 'change asked');
        if (rest.some(v => _trvAnswer(v, stage) === 'wait')) return 'keep';
        if (stage !== 'client' && rest.some(v => !!v[stage + '_ok_at'])) return 'move';
        if (rest.some(v => ['smm', 'kasper', 'client', 'team'].includes(_trvPlace(v)))) return 'keep';
        return 'tweaks';
    }
    /* The page kept the card where it is after a change ('keep': another version still waited for this reviewer, by the
       versions it had read), and the function's answer to that change says otherwise: nothing waits for this reviewer any
       more, nothing is on its way to one, and a change is open. The card then goes to Tweaks Needed after all (session
       Trialchange, live on the test client, 2026-11-01: the client approved A, the page reloaded before A's answer was
       read, and the change then asked on B kept the card at Client Approval with nothing left for the client). */
    function svTrialReviewSettles(m, mode, versions) {
        if (!m || !m.trial || m.trial.winner || !Array.isArray(versions)) return false;
        const stage = _trvStage(mode);
        return !_trvCardAhead(m.post, stage) && _trvSettlesToTweaks(versions, stage);
    }
    /* The versions still waiting for their new cut: forwarding the card answers the other versions' change requests,
       never theirs (Codex on PR 2452: the SMM's approve marked B's open request done while B waited for its cut). */
    function svTrialReviewOpenChanges(m) {
        if (!m || !m.trial || m.trial.winner) return [];
        const all = (m.trial.shape && Array.isArray(m.trial.shape.versions)) ? m.trial.shape.versions : m.trial.versions;
        return all.filter(v => _trvLive(v) && v.status === 'change asked').map(v => v.letter);
    }
    function _trvCurOf(m, mode) {
        const vs = m.trial.versions;
        const had = vs.find(v => v.letter === _trvCur[m.id]);
        if (had) return had;
        const stage = _trvStage(mode);
        const v = vs.find(x => _trvAnswer(x, stage) === 'wait') || vs[0];
        _trvCur[m.id] = v.letter;
        return v;
    }
    /* The post the player plays: today's post with the version's link in place of the card's. On a client link the
       player asks for the card's video by the card's id (frameio-view); a version that is not the card's link also
       names its link (`_trvAskLink`), and frameio-view plays it only when it is one of this card's versions the client
       may see (plan section 10 item 1). Staff pages play every version by its link as before. */
    function svTrialReviewPost(m, mode) {
        if (!m || !m.trial) return m && m.post;
        const v = _trvCurOf(m, mode);
        if (!v) return m.post;
        // A version with no link yet shows today's "No video yet", never another version's video.
        if (!v.frame_url) return Object.assign({}, m.post, { asset_url: '', _trvNoPlayer: true });
        return Object.assign({}, m.post, { asset_url: v.frame_url, _fvPortrait: true }, mode === 'client' && !v.on_card ? { _trvAskLink: true } : {});
    }
    // The version on screen is still with the team (the SMM has not looked at it): the page shows that, not Approve.
    function svTrialReviewWithTeam(m, mode) {
        return !!(m && m.trial && !m.trial.winner && _trvAnswer(_trvCurOf(m, mode), _trvStage(mode)) === 'team');
    }
    /* The card's video part has a change asked (one version's change sends the card to Tweaks Needed, plan section 5):
       the version on screen says its own state, never another version's change note (Trialeyes, 2026-10-29). Returns
       '' when the version on screen is the one with the change, so today's "Change asked" line (with its note) stays. */
    function svTrialReviewChangeHtml(m, mode, partSt) {
        if (!m || !m.trial || m.trial.winner) return '';
        const cur = _trvCurOf(m, mode), stage = _trvStage(mode), a = _trvAnswer(cur, stage), L = _calEsc(cur.letter);
        /* A version the client said "Not this one" to keeps saying so on its own screen, never the card's "Approved"
           (Trialeyes E10, 2026-10-29) and never "waits: the card is with the editor" when the card went to Tweaks Needed
           for another version's new cut (Nightreel, 2026-10-30). */
        if (a === 'pass') return '<span class="dst">Not this one: the team will take ' + _trvW(m) + L + ' out</span>';
        if (a === 'cpass') return '<span class="dst">Client dropped ' + _trvW(m) + L + ': take it off the card</span>';
        /* The part reads as answered (the client's: nothing waits for them while a version is still with the team; the
           team's: the card is further on), but this version waits for its new cut: its own "Change asked", never
           "Approved · Change my mind" over a change just sent (Nightreel, 2026-10-30). */
        if (partSt === 'ok' && cur.status === 'change asked') {
            const re = _trvNoteRe(cur.letter);
            const last = (m.thread || []).filter(t => t.part === 'video' && t.change && re.test(t.text)).slice(-1)[0];
            const q = String(cur.change_note || '') || (last ? last.text.replace(re, '') : '');
            return '<span class="dst chg"><span class="ck chg">' + TRV_BACK + '</span>Change asked on ' + _trvW(m) + L + _trvPartWord(cur) + '</span>' + (q ? '<span class="dq" title="' + _calEscAttr(q) + '">' + _calEsc(q) + '</span>' : '');
        }
        if (partSt === 'ok') return '';
        if (cur.status === 'change asked') return '';
        const asked = m.trial.versions.filter(v => v.status === 'change asked').map(v => _trvW(m) + _calEsc(v.letter));
        const who = asked.length ? asked.join(' and ') + (asked.length > 1 ? "'s changes are" : "'s change is") + ' with the editor' : 'the card is with the editor';
        if (_trvAnswer(cur, stage) === 'ok') return '<span class="dst ok"><span class="ck">' + TRV_CHECK + '</span>' + _trvW(m) + _calEsc(cur.letter) + ' approved</span>' + svTrialReviewMindHtml(m, mode);
        return '<span class="dst">' + _trvW(m) + _calEsc(cur.letter) + ' waits: ' + who + '</span>';
    }
    /* The version on screen has a change open while the card stays where it is (the owner's choice (a), OPEN_REPAIRS
       587): its own "Change asked" and note, never Approve again over a change just sent. Null otherwise. */
    // V4: "'s thumbnail" or "'s caption" after the version's name, for a change asked on that part ('' for the video).
    function _trvPartWord(v) { return v && (v.change_part === 'thumbnail' || v.change_part === 'caption') ? "'s " + v.change_part : ''; }
    function svTrialReviewAsked(m, mode) {
        if (!m || !m.trial || m.trial.winner) return null;
        const cur = _trvCurOf(m, mode);
        return cur && cur.status === 'change asked' ? { letter: cur.letter, note: String(cur.change_note || ''), part: cur.change_part || '' } : null;
    }
    /* THE CLIENT'S "CHANGE MY MIND" ON A VERSION THEY APPROVED (Sidney, 2026-10-31: "if a client says change my mind, that
       means they actually want to put a comment, like a better comment, like a tweak needed"). On a trial card it reopens
       that version as a change, the same as "Ask for a change" on it: the version reads "change asked" with the client's
       words, today's change request names it ("Video B: ...") and goes to the editor, and the card follows per-version
       routing (Tweaks Needed once nothing else waits for the client). The other versions keep their own state.
       Only while the card's video is at Client Approval or Tweaks Needed: those are the statuses a client link may ask a
       change from (the client gate in 190 and production-write's client policy); on a card already further on the words
       still go to the team as a note naming the version, as on a card without trial reels. */
    const TRV_REOPEN_FROM = ['client approval', 'tweaks needed'];
    function svTrialReviewCanReopen(m, mode, letter) {
        if (mode !== 'client' || !m || !m.trial || m.trial.winner || !m.post) return false;
        if (!TRV_REOPEN_FROM.includes(String(m.post.video_status || '').trim().toLowerCase())) return false;
        const v = letter ? m.trial.versions.find(x => x.letter === letter) : _trvCurOf(m, mode);
        return !!v && _trvLive(v) && !v.client_pass_at && v.status === 'approved';
    }
    // The "Change my mind" link beside "Video B approved" on the client link ('' elsewhere).
    function svTrialReviewMindHtml(m, mode) {
        return svTrialReviewCanReopen(m, mode, '') ? '<button class="qlink o" type="button" data-again="video">Change my mind</button>' : '';
    }
    // The version on screen already has this reviewer's OK: the page shows that, not Approve again (Probe rule-miss 14).
    function svTrialReviewAnswered(m, mode) {
        return !!(m && m.trial && !m.trial.winner && _trvAnswer(_trvCurOf(m, mode), _trvStage(mode)) === 'ok');
    }
    /* The client's "Not this one" on the version on screen (owner, 2026-10-28: "when it's a trial, shouldn't the client
       have the option to reject it, like to drop it?"). The client link only; never on the last version the client has
       not passed (or approved, or asked to change); the team drops it. */
    function svTrialReviewCanPass(m, mode) {
        if (mode !== 'client' || !m || !m.trial || m.trial.winner) return false;
        const cur = _trvCurOf(m, mode);
        if (_trvAnswer(cur, 'client') !== 'wait') return false;
        return m.trial.versions.some(v => v.letter !== cur.letter && _trvLive(v) && !v.client_pass_at);
    }
    function svTrialReviewClientOk(m, mode) {
        return !!(m && m.trial && !m.trial.winner && _trvClientOk(_trvCurOf(m, mode), _trvStage(mode)));
