    function svTrialReviewPassed(m, mode) {
        if (!m || !m.trial || m.trial.winner) return false;
        const a = _trvAnswer(_trvCurOf(m, mode), _trvStage(mode));
        return a === 'pass' || a === 'cpass';
    }
    /* Every live version already has this reviewer's answer, yet the card is still at their status: the version answer
       landed and today's stage approve after it did not (the tab closed or reloaded in between, or the second save was
       lost). The plan's risk 1: the stage offers that save again, or the card would sit there with nothing to press
       (Nightreel, 2026-10-30: a reload 150 ms after the SMM's last approve). The caller checks the card's status. */
    function svTrialReviewBehind(m, mode) {
        // Never while this page's own answer is on its way: the stage approve follows it by itself.
        if (!m || !m.trial || m.trial.winner || _trvBusy.has(m.id) || _trvChain[m.id]) return false;
        const stage = _trvStage(mode);
        const all = (m.trial.shape && Array.isArray(m.trial.shape.versions)) ? m.trial.shape.versions : m.trial.versions;
        const live = (all || []).filter(v => _trvLive(v) && !v.client_pass_at);
        if (!live.length || live.some(v => _trvAnswer(v, stage) === 'wait')) return false;
        if (stage === 'client') return live.every(v => _trvAnswer(v, 'client') === 'ok');
