    function _rsFit() {
        const v = _rsQ('view'), h = _rsQ('fvHost');
        if (!v || !h) return;
        h.style.setProperty('--fv-h', Math.max(160, v.clientHeight - 2) + 'px');
    }
    function _rsTyping() {
        const a = R.root && R.root.activeElement;
        return !!a && (a.tagName === 'TEXTAREA' || a.tagName === 'INPUT');
    }

    /* ---------- drawing ---------- */
    function _rsRender(opts) {
        if (!R.root || !R.S) return;
        if (R.bar) { _rsHeader(); return; }   // Sheet, Month or Week under the client link's header: no stage
        if (!(opts && opts.force) && _rsTyping()) { R.pending = true; _rsHeader(); _rsStrip(); return; }
        R.pending = false;
        const m = _rsCur();
        _rsHeader();
        _rsStrip();
        const empty = !m;
        ['theatre', 'side', 'chat'].forEach(id => { _rsQ(id).hidden = empty; });
        _rsQ('recap').hidden = !empty;
        _rsQ('stage').classList.toggle('is-empty', empty);
        if (empty) { _rsStageOff(); _rsRecap(); return; }
        _rsSide(m); _rsStepper(m); _rsMedia(m); _rsCard(m); _rsDecide(); _rsChatCalm(m); _rsChat(m);
        if (!R.S.hinted) _rsHint(m);
    }
    /* The conversation is drawn again on every change, so its entrance animations would replay and the whole panel
       would fade out and in. Same post, same messages: no animation. A new message on this post: only it rises.
       Another post: its messages cross-fade softly. (The panel itself never leaves the screen.) */
    function _rsChatCalm(m) {
        const rs = R.root.querySelector('.rs');
        if (!rs) return;
        const n = m.thread.length, prev = R.chatKey || null;
        R.chatKey = { id: m.id, n };
        rs.classList.remove('calm', 'grow', 'xpost');
        void rs.offsetWidth;
        rs.classList.add(!prev ? 'calm' : prev.id !== m.id ? 'xpost' : n > prev.n ? 'grow' : 'calm');
    }
    function _rsHeader() {
        const n = _rsQ('rsName');
        if (n) n.textContent = calState.client || '';
        const tabs = _rsQ('rsTabs');
        if (tabs) tabs.querySelectorAll('[data-tab]').forEach(t => { const on = t.dataset.tab === calState.view; t.classList.toggle('active', on); if (on) t.setAttribute('aria-current', 'page'); else t.removeAttribute('aria-current'); });
        const tl = _rsQ('rsTools');
        if (tl) tl.hidden = !R.bar;
        const b = _rsQ('rsBadge');
        if (b) { const c = _rsQueue().filter(x => !_rsAnswered(x)).length; b.textContent = String(c); b.hidden = !c; }
        const hp = _rsQ('rsHelp');
        if (hp) hp.hidden = !svRsHelpUrl();
    }
    /* Smooth switching (owner feedback 2026-10-17, session Curtain Nine): nothing outside the media may blink when the
