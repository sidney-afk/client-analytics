                _rsFit();
            } else {
                _rsStageOff();
                v.classList.add('novid');
                const nv = _rsQ('novid');
                nv.classList.toggle('land', m.land);
                const img = _rsQ('poster');
                if (m.thumb) { if (img.getAttribute('src') !== m.thumb) img.src = m.thumb; img.hidden = false; } else { img.removeAttribute('src'); img.hidden = true; }
                const url = String(m.post.asset_url || '').trim();
                _rsQ('novidMsg').innerHTML = /^https?:\/\//i.test(url)
                    ? '<span>This video opens in a new tab.</span><a href="' + _re(url) + '" target="_blank" rel="noopener noreferrer">' + RI.play + 'Watch the video</a>'
                    : '<span>No video yet.</span>';
            }
        } else {
            if (_rsStageFor) {
                // leave the player loaded (switching back is instant) but stop the sound
                try { const vid = host.querySelector('video'); if (vid && !vid.paused) vid.pause(); } catch (e) {}
            }
        }
        if (k === 'thumb') {
            const bt = _rsQ('bigthumb'), img = _rsQ('bigthumbImg'), tf = _rsQ('tframe');
            bt.classList.toggle('land', m.land);
            if (m.thumb) {
                tf.hidden = true; img.hidden = false;
                if (img.getAttribute('src') !== m.thumb) {
                    img.onload = () => { if (img.naturalWidth) bt.classList.toggle('land', img.naturalWidth > img.naturalHeight * 1.05); };
                    img.src = m.thumb;
                }
            } else {
                img.hidden = true; img.removeAttribute('src');
                tf.hidden = false;
                tf.innerHTML = m.tframe ? '<span>The thumbnail is in Frame.io.</span><a href="' + _re(m.tframe) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Open the thumbnail</a>' : '<span>No thumbnail yet.</span>';
            }
        }
    }
    function _rsSetStep(k) {
        const m = _rsCur();
        if (!m || !m.parts.some(x => x.key === k)) return;
        if (R.S.step === k) { _rsRender({ force: true }); return; }
        _rsSwap(() => {
            R.S.step = k; R.S.menu = '';
            if (R.S.editing && R.S.editing !== k) R.S.editing = '';
        });
    }
    /* Change what is on stage: only the media fades (out, the change, back in); everything around it stays put. */
    let _rsSwapT = null;
    function _rsSwap(apply) {
        const v = _rsQ('view');
        if (!v || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) { apply(); _rsRender({ force: true }); return; }
        if (_rsSwapT) { clearTimeout(_rsSwapT.t); _rsSwapT.apply(); }
        v.classList.add('swap');
        const job = { apply, t: 0 };
        job.t = setTimeout(() => {
            _rsSwapT = null;
            apply();
            _rsRender({ force: true });
            const nv = _rsQ('view'); if (!nv) return;
            nv.classList.add('swap');
            requestAnimationFrame(() => requestAnimationFrame(() => nv.classList.remove('swap')));
        }, 150);
        _rsSwapT = job;
    }
    function _rsCard(m) {
        const S = R.S, k = S.step, tc = _rsQ('tcard');
        if (_rsKind(k) !== 'text') { tc.innerHTML = ''; return; }
        const x = m.parts.find(p => p.key === k);
        const editing = S.editing === k, yt = k === 'title';
        const canEdit = R.mode !== 'kasper' && _rsActive(m) && x.st === 'wait' && !_rsWriting(x);
        const head = '<div class="tc-h">' + (canEdit && !editing ? '<button class="b-edit" type="button" id="editBtn">' + RI.pen + 'Edit the ' + _rsLname(k) + '</button>' : '') + '</div>';
        const fold = R.mode === 'kasper' && x.st === 'ok' && !yt;
        const open = !!S.exp[m.id + k];
        const text = yt ? m.ytitle : m.caption;
        let body;
        if (editing) {
            const hint = R.mode === 'client' ? 'Your team checks your edit before it goes out.' : 'Saves the new ' + _rsLname(k) + ' on the card.';
            body = '<div class="cap-edit"><textarea id="capTa" aria-label="Edit the ' + _rsLname(k) + '">' + _re(S.editText) + '</textarea><div class="row"><span class="hint">' + hint + '</span><div class="btns"><button class="btn-quiet" type="button" id="capCancel">Cancel</button><button class="btn-dark" type="button" id="capSave">' + (R.mode === 'client' ? 'Send to your team' : 'Save') + '</button></div></div></div>';
        } else if (yt) {
            body = '<div class="tc-yt"><div class="ytimg">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</div><div class="ytx"><div class="ytt">' + _re(text) + '</div><div class="ytm">' + _re(R.mode === 'kasper' ? m.client : (calState.client || '')) + '</div></div></div>';
        } else {
            body = '<div class="tc-text' + (fold && !open ? ' clamp' : '') + '">' + (text ? _re(text) : '<span style="color:var(--text-secondary)">No caption yet.</span>') + '</div>';
        }
        const foot = fold
            ? '<div class="tc-foot num"><button class="expand" type="button" id="expBtn" aria-expanded="' + open + '">' + RI.down + (open ? 'Collapse' : 'Expand the caption') + '</button><span>' + text.length + ' characters</span></div>'
            : '<div class="tc-foot num">' + text.length + ' characters</div>';
        if (yt) { tc.className = 'tcard'; tc.innerHTML = body + head; }
        else { tc.className = 'tcard wc'; tc.innerHTML = '<div class="tc-main"><span class="tc-lbl" style="' + _rsPv(k) + '">' + _rsDot(k) + 'Caption</span>' + body + head + '</div>' + foot; }
        const eb = _rsQ('editBtn'); if (eb) eb.addEventListener('click', () => _rsStartEdit(k, text));
        const xb = _rsQ('expBtn'); if (xb) xb.addEventListener('click', () => { S.exp[m.id + k] = !S.exp[m.id + k]; _rsCard(m); });
        const cs = _rsQ('capSave'); if (cs) cs.addEventListener('click', () => _rsSaveEdit(m, k));
        const cc = _rsQ('capCancel'); if (cc) cc.addEventListener('click', () => { S.editing = ''; _rsRender({ force: true }); });
        const ct = _rsQ('capTa'); if (ct) { ct.addEventListener('input', () => { S.editText = ct.value; }); ct.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); S.editing = ''; _rsRender({ force: true }); } }); }
    }
    function _rsSaving(m, k) {
        if (R.mode === 'kasper') { const it = m.item; return !!(it && (m.sample ? (window._sxrKasperState && window._sxrKasperState.saving && window._sxrKasperState.saving[m.id + '|' + k]) : (it._saving && it._saving[k]))); }
        return !!_calReviewState.saving[m.id + '|' + k];
    }
    function _rsError(m, k) {
        if (R.mode === 'kasper') { const it = m.item; return it && !m.sample && it._errors && it._errors[k] ? String(it._errors[k]) : ''; }
        return String(_calReviewState.errors[m.id + '|' + k] || '');
    }
    /* Save problems on this post, whichever part is on stage (the stage moves on to the next part while a save
       runs): a refused save says why, with Try again; a save with no answer after a few seconds says so. */
    function _rsSaveIssues(m, onStage) {
        const S = R.S;
        return m.parts.map(p => {
            const k = p.key, key = m.id + '|' + k, err = _rsError(m, k);
            const who = k === onStage ? '' : RS_PART[k] + ': ';
            if (err) return '<div class="err" role="alert" data-err="' + k + '"><span>' + _re(who + 'Not saved. ' + err) + '</span>' + (S.retry[key] ? '<button class="retry" type="button" data-retry="' + k + '">Try again</button>' : '') + '</div>';
            if (S.slow[key] && _rsSaving(m, k)) return '<div class="err slow" role="status" data-slow="' + k + '">' + _re(who) + 'Still waiting for the server. Nothing is lost: it finishes here on its own, or says so if it fails.</div>';
            return '';
        }).join('');
    }
    // A small spinner in place of a button's icon while its save runs (owner feedback 2026-10-17: no "Saving..." text).
    const RS_SPIN = '<span class="spin" aria-hidden="true"></span>';
    function _rsSplit(x, busy) {
        const k = x.key, n = _rsLname(k), open = !busy && R.S.menu === k;
        const label = busy === 'client' ? 'Approve to client' : busy === 'aat' ? 'Approve after tweaks' : R.mode === 'smm' ? 'Approve to Kasper' : 'Approve the ' + n;
        const alt = R.mode === 'smm' ? ['client', RI.skip + 'Approve to client'] : ['aat', RI.aat + 'Approve after tweaks'];
        const menu = open ? '<div class="apmenu" role="menu"><button role="menuitem" type="button" data-alt="' + alt[0] + '" data-for="' + k + '">' + alt[1] + '</button></div>' : '';
        const on = busy === 'ok' || busy === 'client' || busy === 'aat';
        return '<div class="split' + (open ? ' open' : '') + (on ? ' busy' : '') + '"><button class="b-ok' + (on ? ' busy' : '') + '" type="button" data-ok="' + k + '"' + _rsBusyAttr(busy, on) + '>' + (on ? RS_SPIN : RI.check) + label + '</button><button class="sarr" type="button" data-menu="' + k + '" aria-haspopup="menu" aria-expanded="' + open + '" aria-label="Other ways to approve the ' + n + '" title="' + (R.mode === 'smm' ? 'Approve to client' : 'Approve after tweaks') + '"' + (busy ? ' disabled' : '') + '>' + RI.down + '</button>' + menu + '</div>';
    }
    function _rsBusyAttr(busy, on) { return busy ? (on ? ' aria-busy="true"' : '') + ' disabled' : ''; }
    // The decision buttons; with `busy` (what was pressed) the pressed one spins and every one waits.
    function _rsActions(x, busy) {
        const n = _rsLname(x.key);
        const ok = busy === 'ok' || (R.mode === 'client' && busy === 'client');
        const approve = R.mode === 'client' ? '<button class="b-ok' + (ok ? ' busy' : '') + '" type="button" data-ok="' + x.key + '"' + _rsBusyAttr(busy, ok) + '>' + (ok ? RS_SPIN : RI.check) + 'Approve the ' + n + '</button>' : _rsSplit(x, busy);
        const chg = busy === 'chg', fr = busy === 'frame';
        return approve + '<button class="b-ask' + (chg ? ' busy' : '') + '" type="button" data-chg="' + x.key + '"' + _rsBusyAttr(busy, chg) + '>' + (chg ? RS_SPIN : RI.back) + 'Ask for a change</button>'
            + (R.mode === 'kasper' && x.key === 'video' ? '<button class="b-frame' + (fr ? ' busy' : '') + '" type="button" data-frame="' + x.key + '"' + _rsBusyAttr(busy, fr) + ' title="Your notes are in Frame.io: sends the change without typing">' + (fr ? RS_SPIN : RI.frame) + 'Tweaks are on Frame</button>' : '');
    }
    function _rsDecide() {
        const m = _rsCur();
        if (!m) return;
        const S = R.S, x = m.parts.find(p => p.key === S.step);
        const el = _rsQ('drow');
        if (!x) { el.innerHTML = ''; return; }
        const n = _rsLname(x.key);
        let d;
        if (!_rsActive(m)) {
            d = x.st === 'ok'
                ? '<span class="dst ok"><span class="ck">' + RI.check + '</span>Approved</span>'
                : '<span class="dst chg"><span class="ck chg">' + (x.frame ? RI.frame : RI.back) + '</span>' + (x.frame ? 'Tweaks are on Frame' : 'Change asked') + '</span>' + (x.frame && m.post.asset_url ? '<a class="rlink" href="' + _re(m.post.asset_url) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Your notes in Frame.io</a>' : '');
            const canPing = (() => { try { return _calShowUrgent(m.post, 'video'); } catch (e) { return false; } })();
            const pg = S.pinged[m.id];
            el.innerHTML = '<div class="dwrap"><div class="dec' + (x.st === 'ok' ? ' is-ok' : ' is-chg') + '">' + d + '</div></div><div class="drow2 both"><span class="held">' + RI.clock + _re(m.note) + '</span>'
                + (canPing ? (pg ? '<span class="b-soft sent">' + RI.check + 'Editor pinged</span>' : '<button class="b-soft" type="button" id="pingBtn">' + RI.bell + 'Ping editor</button>') : '') + '</div>';
            const pb = _rsQ('pingBtn');
            if (pb) pb.addEventListener('click', (e) => { S.pinged[m.id] = true; if (m.sample) window._sxrKasperSendUrgentSlack(e, m.id); else window._kasperSendUrgentSlack(e, m.id); _rsDecide(); });
            return;
        }
        const saving = _rsSaving(m, x.key);
        if (S.editing === x.key) d = '<span class="dst busy">' + RI.pen + 'Editing the ' + n + '</span>';
        else if (_rsWriting(x) && S.note.where === 'stage') d = null;
        else if (_rsWriting(x)) d = '<span class="dst wr">' + RI.pen + 'Writing a change to the ' + n + ' in the conversation</span>';
        else if (saving) d = _rsActions(x, S.pressed[m.id + '|' + x.key] || 'ok');
        else if (x.st === 'ok' && R.mode === 'smm') d = '<span class="dst ok"><span class="ck' + (x.route === 'client' ? ' tocl' : '') + '">' + (x.route === 'client' ? RI.skip : RI.check) + '</span>Approved to ' + (x.route === 'client' ? 'client' : 'Kasper') + '</span><button class="qlink o" type="button" data-again="' + x.key + '">Change my mind</button>';
        else if (x.st === 'ok') d = '<span class="dst ok"><span class="ck">' + (x.dec === 'aat' ? RI.aat : RI.check) + '</span>' + (x.dec === 'aat' ? 'Approved after tweaks' : 'Approved') + (x.when ? ' <span class="when">' + _re(_rsWhen(x.when)) + '</span>' : '') + '</span><button class="qlink o" type="button" data-again="' + x.key + '">Change my mind</button>';
        else if (x.st === 'chg' && x.frame) d = '<span class="dst chg"><span class="ck chg">' + RI.frame + '</span>Tweaks are on Frame</span>' + (m.post.asset_url ? '<a class="rlink" href="' + _re(m.post.asset_url) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Your notes in Frame.io</a>' : '');
        else if (x.st === 'chg') {
            const last = m.thread.filter(t => t.part === x.key && t.change).slice(-1)[0];
            d = '<span class="dst chg"><span class="ck chg">' + RI.back + '</span>Change asked</span>' + (last ? '<span class="dq" title="' + _re(last.text) + '">' + _re(last.text) + '</span>' : '');
        } else {
            d = _rsActions(x, '');
        }
        const parts = m.parts, left = parts.filter(p => p.st === 'wait').length, all = !left;
        const dc = x.st === 'ok' && d && !S.editing && !saving ? ' is-ok' : (x.st === 'chg' || x.st === 'tweak') && d && !S.editing && !saving ? ' is-chg' : '';
        el.innerHTML = '<div class="dwrap">' + (d === null ? _rsComposer(m) : '<div class="dec' + dc + '" id="dec">' + d + '</div>') + '</div>'
            + _rsSaveIssues(m, x.key)
            + '<div class="drow2"><div class="dfin"><button class="finish" type="button" id="finishBtn"' + (all ? '' : ' disabled') + '>' + RI.check + 'Finish reviewing' + (all ? '' : ' <span class="fc num">' + (parts.length - left) + ' of ' + parts.length + '</span>') + '</button></div></div>';
        el.querySelectorAll('[data-ok]').forEach(b => b.addEventListener('click', () => _rsApprove(m, b.dataset.ok, R.mode === 'smm' ? 'kasper' : '')));
        el.querySelectorAll('[data-alt]').forEach(b => b.addEventListener('click', (e) => {
            e.stopPropagation(); S.menu = '';
            if (b.dataset.alt === 'client') _rsApprove(m, b.dataset.for, 'client');
            else _rsStartChange(b.dataset.for, 'stage', true);
        }));
        el.querySelectorAll('[data-menu]').forEach(b => b.addEventListener('click', (e) => { e.stopPropagation(); S.menu = S.menu === b.dataset.menu ? '' : b.dataset.menu; _rsDecide(); }));
        el.querySelectorAll('[data-frame]').forEach(b => b.addEventListener('click', () => _rsSendChange(m, b.dataset.frame, RS_FRAME_NOTE, { where: 'stage' })));
        el.querySelectorAll('[data-chg]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.chg, 'stage')));
        el.querySelectorAll('[data-again]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.again, 'stage')));
        const fb = _rsQ('finishBtn'); if (fb) fb.addEventListener('click', _rsFinish);
        el.querySelectorAll('[data-retry]').forEach(b => b.addEventListener('click', () => { const f = S.retry[m.id + '|' + b.dataset.retry]; if (f) f(); }));
        if (d === null) _rsBindComposer(el);
    }
    function _rsComposer(m) {
        const S = R.S, nt = S.note, k = nt.part, chg = !!k, n = chg ? _rsLname(k) : '', typed = !!nt.text.trim();
        const active = _rsActive(m);
        const paused = !!S.editing && !chg;
        const x = chg ? m.parts.find(p => p.key === k) : null;
        // An approved part on a client link cannot be reopened from the page: "Change my mind" is a note to the team.
        const reopenNote = R.mode === 'client' && x && x.st === 'ok';
        const ph = paused ? 'Finish the edit first'
            : chg ? (nt.aat ? 'What should the editor fix? It goes on to the client after.' : reopenNote ? 'What would you like changed on the ' + n + '?' : 'What should change on the ' + n + '?')
            : R.mode === 'smm' ? (nt.vis === 'client' ? 'Leave a note the client will see too' : 'Leave a note for the team')
            : R.mode === 'kasper' ? (active ? 'Message the team' : 'Message the editor') : 'Message your team';
        const why = nt.aat ? 'Approved once the editor fixes it' : reopenNote ? 'Your team will reopen it' : x && x.st === 'ok' ? 'This takes back the approval' : R.mode === 'client' ? 'Your team will edit it' : 'The editor will change it';
        const chip = chg ? '<span class="tochip">' + _rsDot(k) + (nt.where === 'chat' ? 'Change to: ' + RS_PART[k] + '<button class="x" type="button" id="chipX" aria-label="Make it a plain note" title="Make it a plain note">' + RI.x + '</button>' : (nt.aat ? 'Approve the ' + n + ' after tweaks' : 'Change to the ' + n)) + '</span>' : '';
        const top = chg ? '<div class="cmp-top">' + chip + '<span class="why">' + why + '</span></div>' : '';
        const seg = R.mode === 'smm' ? (chg
            ? '<div class="seg" role="group" aria-label="Who can see the change request"><button type="button" class="on" aria-pressed="true" disabled>' + RI.lock + 'Team only</button><button type="button" disabled title="Change requests always stay with the team">' + RI.eye + 'Client can see</button></div>'
            : '<div class="seg" role="group" aria-label="Who can see the note"><button type="button" data-vis="team" class="' + (nt.vis === 'team' ? 'on' : '') + '" aria-pressed="' + (nt.vis === 'team') + '">' + RI.lock + 'Team only</button><button type="button" data-vis="client" class="' + (nt.vis === 'client' ? 'on' : '') + '" aria-pressed="' + (nt.vis === 'client') + '">' + RI.eye + 'Client can see</button></div>') : '';
        const sendLabel = nt.aat ? 'Approve after tweaks' : reopenNote ? 'Send to your team' : 'Ask for change';
        const opts = active ? m.parts.filter(q => q.st !== 'chg' && q.st !== 'tweak' && !(R.mode === 'client' && q.st === 'ok')) : [];
        const foot = chg
            ? '<div class="cmp-foot">' + (seg || '<span class="esc">Enter sends</span>') + '<div class="btns"><button class="btn-quiet" type="button" id="cmpCancel">Cancel</button><button class="b-send-chg" type="button" id="sendBtn"' + (typed ? '' : ' disabled') + '>' + (nt.aat ? RI.aat : RI.back) + sendLabel + '</button></div></div>'
            : (opts.length ? '<div class="sugg"><div class="sgl"><span>Is this a change?</span><button class="justnote" type="button" id="noteBtn">Just a note ' + RI.send + '</button></div><div class="sgp">' + opts.map(q => '<button class="sg" type="button" data-sg="' + q.key + '">' + _rsDot(q.key) + RS_PART[q.key] + (q.st === 'ok' ? '<span class="sga">, approved</span>' : '') + '</button>').join('') + '</div></div>' : '')
              + (R.mode === 'smm' ? '<div class="nfoot">' + seg + '<button class="send" type="button" id="sendBtn" aria-label="Send the note"' + (typed ? '' : ' disabled') + '>' + RI.send + '</button></div>' : '');
        const send = chg || R.mode === 'smm' ? '' : '<button class="send" type="button" id="sendBtn" aria-label="Send as a note"' + (typed ? '' : ' disabled') + '>' + RI.send + '</button>';
        return '<div class="compose' + (R.mode === 'smm' ? ' smm' : '') + (chg ? ' chg' : '') + (typed ? ' typed' : '') + '" id="compose"><div class="cbox">' + top + '<div class="ta-wrap"><textarea class="cta" id="ta" rows="1" placeholder="' + _re(ph) + '" aria-label="' + _re(ph) + '"' + (paused ? ' disabled' : '') + '>' + _re(nt.text) + '</textarea>' + send + '</div>' + foot + '</div></div>';
    }
    function _rsBubble(t, old) {
        const isChg = t.change && t.part;
        const tag = t.part ? '<span class="tag" style="background:none;padding:0;height:auto;color:inherit;font-weight:600;gap:5px;display:inline-flex;align-items:center">' + _rsDot(t.part) + RS_PART[t.part] + '</span>' : '';
        const kind = isChg ? '<span class="kchg">' + (t.frame ? RI.frame + 'Tweaks on Frame' : RI.back + 'Change asked') + '</span>' : '';
        const role = R.mode === 'smm' && !t.you && t.role ? ' <span class="role">' + (t.role === 'client' ? 'client' : t.role === 'kasper' ? 'review' : '') + '</span>' : '';
        const vis = R.mode === 'smm' && !t.change && t.aud ? '<span class="vis' + (t.aud === 'client' ? ' cl' : '') + '">' + (t.aud === 'client' ? RI.eye + 'Client can see' : RI.lock + 'Team only') + '</span>' : '';
        const av = t.you ? '' : '<span class="av' + (t.role === 'client' ? ' cl' : t.role === 'kasper' ? ' kp' : '') + '">' + _re(String(t.who || '?').charAt(0).toUpperCase()) + '</span>';
        return '<div class="bub ' + (t.you ? 'you' : 'team') + (old ? ' old' : '') + (isChg ? ' is-chg' : '') + (isChg && t.done ? ' handled' : '') + '">' + av + '<div class="bb"><div class="bh"><b>' + (t.you ? 'You' : _re(t.who)) + role + '</b>' + tag + kind + '<span>' + _re(t.time) + '</span>' + vis + '</div><div class="bt' + (t.sending ? ' sending' : '') + '">' + _re(t.text) + '</div>' + (t.done ? '<span class="donec">' + RI.check + 'Done</span>' : '') + '</div></div>';
    }
    function _rsChat(m) {
        const S = R.S, c = _rsQ('chat');
        const all = m.thread;
        // older, finished notes fold away; the newest four always show
        const cut = all.length > 6 ? all.length - 4 : 0;
        const fold = all.slice(0, cut), live = all.slice(cut);
        let th = '';
        if (fold.length) th += '<button class="fold first" type="button" id="foldBtn" aria-expanded="' + S.fold + '">' + (S.fold ? 'Hide earlier notes' : fold.length + ' earlier notes') + '</button><div class="folded' + (S.fold ? ' open' : '') + '">' + fold.map(t => _rsBubble(t, true)).join('') + '</div>';
        th += live.map(t => _rsBubble(t)).join('');
        if (!all.length) th = '<p class="ch-empty">No messages on this post yet. Anything you send shows up here.</p>';
        const dk = !!S.note.part && S.note.where === 'stage';
        const foot = dk ? '<div class="ch-quiet">Your change shows up here when you send it.</div>' : _rsComposer(m);
        const head = R.mode === 'client'
            ? '<span class="avs"><span class="av">S</span></span><span class="who"><b>Your team</b><span>Usually replies within a day</span></span>'
            : R.mode === 'smm'
                ? '<span class="avs"><span class="av cl">' + _re(String(calState.client || '?').charAt(0)) + '</span><span class="av kp">K</span></span><span class="who"><b>Conversation</b><span>' + _re(calState.client || '') + ' (client), the editors and Kasper</span></span>'
                : '<span class="avs"><span class="av">' + _re(String(m.client || '?').charAt(0)) + '</span><span class="av l">E</span></span><span class="who"><b>The team</b><span>' + _re(m.client) + '’s SMM and editors. The client does not see this.</span></span>';
        c.innerHTML = '<div class="ch-head">' + head + '</div><div class="ch-scroll" id="tscroll">' + th + '</div><div class="ch-foot">' + foot + '</div>';
        const fb = _rsQ('foldBtn'); if (fb) fb.addEventListener('click', () => { S.fold = !S.fold; _rsChat(m); });
        if (!dk) _rsBindComposer(c);
        const ts = _rsQ('tscroll'); if (ts) ts.scrollTop = ts.scrollHeight;
    }
    function _rsBindComposer(root) {
        const S = R.S;
        root.querySelectorAll('[data-sg]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.sg, 'chat')));
        root.querySelectorAll('[data-vis]').forEach(b => b.addEventListener('click', () => { S.note.vis = b.dataset.vis; _rsRender({ force: true }); _rsFocusTa(); }));
        const cx = _rsQ('chipX'); if (cx) cx.addEventListener('click', () => _rsClearChange(true, false));
        const cc = _rsQ('cmpCancel'); if (cc) cc.addEventListener('click', () => _rsClearChange(false, true));
        const nb = _rsQ('noteBtn'); if (nb) nb.addEventListener('click', () => _rsSendNote(true));
        const sb = _rsQ('sendBtn'); if (sb) sb.addEventListener('click', () => _rsSendNote(!S.note.part));
        const ta = _rsQ('ta');
        if (!ta) return;
        const grow = () => { ta.style.height = 'auto'; ta.style.height = Math.min(160, ta.scrollHeight + 2) + 'px'; };
        ta.addEventListener('input', () => {
            S.note.text = ta.value;
            const has = !!ta.value.trim();
            const cp = _rsQ('compose'); if (cp) cp.classList.toggle('typed', has);
            const s = _rsQ('sendBtn'); if (s) s.disabled = !has;
            grow();
        });
        ta.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); _rsSendNote(!S.note.part); }
            else if (e.key === 'Escape' && S.note.part) { e.preventDefault(); e.stopPropagation(); _rsClearChange(S.note.where === 'chat', S.note.where === 'stage'); }
        });
        if (S.note.text) grow();
    }
    function _rsRecap() {
        const r = _rsQ('recap');
        if (R.mode === 'kasper') {
            const ed = _rsKasperModels().tweaks;
            r.innerHTML = '<div class="rc-card"><div class="ei">' + RI.check + '</div><h3>All caught up.</h3><p>Nothing is waiting for your review. New cards show up here as soon as an SMM sends them.</p>'
                + (ed.length ? '<div class="recent"><div class="recent-h"><span>With the editors</span></div>' + ed.map(m => '<button class="rc" type="button" data-id="' + _re(m.id) + '" style="cursor:pointer;width:100%;text-align:left"><span class="sw"><span class="slot' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</span></span><span class="rx"><span class="rt">' + _re(m.title) + '</span><span class="rw wt">' + RI.back + _re(m.client) + ', ' + _re(m.note.replace(/^With /, 'with ')) + '</span></span></button>').join('') + '</div>' : '') + '</div>';
            r.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => { R.S.edOpen = true; _rsGo(b.dataset.id); }));
            return;
        }
        const fin = (calState.posts || []).filter(p => R.S.finished.has(p.id));
        const head = R.mode === 'client' ? (fin.length ? 'All done. Your team has everything.' : 'Nothing waiting on you.') : (fin.length ? 'All done for ' + (calState.client || 'this client') + '.' : 'Nothing waiting on SMM approval.');
        const line = R.mode === 'client' ? 'Your team will let you know when the next post is ready.' : 'Posts show up here when they reach SMM approval.';
        r.innerHTML = '<div class="rc-card"><div class="ei">' + RI.check + '</div><h3>' + _re(head) + '</h3><p>' + _re(line) + '</p>'
            + (fin.length ? '<div class="recent"><div class="recent-h"><span>Reviewed just now</span></div>' + fin.slice(-3).map(p => { const m = _rsModel(p, R.mode, null); const ok = m.parts.every(x => x.st === 'ok'); return '<div class="rc"><span class="sw"><span class="slot' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</span></span><span class="rx"><span class="rt">' + _re(m.title) + '</span><span class="rw' + (ok ? '' : ' wt') + '">' + (ok ? RI.check + 'Approved' + (m.date ? ', goes out ' + _re(m.date) : '') : RI.back + 'With your team') + '</span></span></div>'; }).join('') + '</div>' : '') + '</div>';
    }

    /* ---------- actions ---------- */
    let _rsFT = null;
    function _rsFlash(text, key, pid) {
        const m = _rsCur();
        R.S.saved = { key, pid: pid || (m ? m.id : ''), t: Date.now() };
        const f = _rsQ('flash'); if (f) { f.textContent = text; clearTimeout(_rsFT); _rsFT = setTimeout(() => { f.textContent = ''; }, 2600); }
    }
    function _rsAdvance(m, from) {
        setTimeout(() => {
            const cur = _rsCur();
            if (!cur || cur.id !== m.id || R.S.step !== from || R.S.note.part || R.S.editing) return;
            // a refused save stays on its part, with its reason and Try again
            const x = cur.parts.find(p => p.key === from);
            if (!x || x.st === 'wait' || _rsError(cur, from)) return;
            const nx = _rsNextOpen(cur, from);
            if (nx) _rsSetStep(nx);
        }, 650);
    }
    function _rsItem(m) { return m.item; }
    /* A save on the stage always ends on screen (owner feedback 2026-10-17 23:40, session Curtain Nine). The old
       page's save path tells the stage when it is done through its own repaint, but not every branch repaints (an
       approval that cleared the card's last waiting part used to remove the old card and never told the stage, so it
       read "Saving" for good). So the stage watches the part itself: the moment the saving flag drops it draws again,
       and after a few seconds with no answer it says so in plain words. */
    const RS_SLOW_MS = 8000;
    function _rsModelById(id) { return _rsAll().find(x => x.id === id) || null; }
    // `done` is the words for the moment the save ends well ("Video approved, saved"): the step's "Saved" mark and the
    // spoken flash wait for the server, never the click.
    function _rsWatch(m, comp, done) {
        const key = m.id + '|' + comp, S = R.S, t0 = Date.now();
        delete S.slow[key];
        const tick = () => {
            if (R.S !== S) return;   // the page was remounted
            const cur = _rsModelById(m.id) || m;
            if (!_rsSaving(cur, comp)) {
                delete S.slow[key];
                if (!_rsError(cur, comp)) { delete S.retry[key]; if (done) _rsFlash(done, comp, m.id); }
                _rsRender();
                return;
            }
            if (!S.slow[key] && Date.now() - t0 >= RS_SLOW_MS) { S.slow[key] = true; _rsRender(); }
            setTimeout(tick, 200);
        };
        setTimeout(tick, 200);
    }
    function _rsApprove(m, comp, how) {
        R.S.retry[m.id + '|' + comp] = () => { const cur = _rsModelById(m.id); if (cur) _rsApprove(cur, comp, how); };
        R.S.pressed[m.id + '|' + comp] = how === 'client' ? 'client' : 'ok';
        R.S.acted.add(m.id + '|' + comp); R.S.menu = '';
        if (R.mode === 'client') window._calReviewApprove(m.id, comp);
        else if (R.mode === 'smm') window._calReviewApprove(m.id, comp, how === 'client' ? 'client' : 'kasper');
        else if (m.sample) window._sxrKasperApproveComp(m.id, comp);
        else window._kasperApproveComp(m.id, comp, 'client');
        _rsRender({ force: true });
        _rsWatch(m, comp, RS_PART[comp] + (R.mode === 'smm' ? ' approved to ' + (how === 'client' ? 'the client' : 'Kasper') : ' approved, saved'));
        _rsAdvance(m, comp);
    }
    function _rsSendChange(m, comp, text, o) {
        const opts = o || {};
        R.S.retry[m.id + '|' + comp] = () => { const cur = _rsModelById(m.id); if (cur) _rsSendChange(cur, comp, text, Object.assign({}, opts, { where: '' })); };
        R.S.pressed[m.id + '|' + comp] = opts.aat ? 'aat' : text === RS_FRAME_NOTE ? 'frame' : 'chg';
        R.S.acted.add(m.id + '|' + comp);
        if (R.mode === 'kasper') {
            if (m.sample) {
                window._sxrKasperState.drafts[m.id + '|' + comp] = text;
                if (opts.aat) window._sxrKasperApproveAfterTweaksComp(m.id, comp); else window._sxrKasperRequestTweakComp(m.id, comp);
            } else {
                const it = _rsItem(m);
                if (!it._drafts) it._drafts = { video: '', graphic: '', caption: '' };
                it._drafts[comp] = text;
                if (opts.aat) window._kasperApproveAfterTweaksComp(m.id, comp); else window._kasperRequestTweakComp(m.id, comp);
            }
        } else {
            _calReviewState.drafts[m.id + '|' + comp] = text;
            window._calReviewRequestTweak(m.id, comp);
        }
        _rsRender({ force: true });
        _rsWatch(m, comp, opts.aat ? RS_PART[comp] + ' approved after tweaks' : 'Change sent');
        if (opts.where === 'stage') _rsAdvance(m, comp);
    }
    function _rsSendNoteTo(m, comp, text, vis) {
        if (R.mode === 'kasper') {
            if (m.sample) { window._sxrKasperState.drafts[m.id + '|' + comp] = text; window._sxrKasperAddCommentComp(m.id, comp); return; }
            const it = _rsItem(m);
            if (!it._drafts) it._drafts = { video: '', graphic: '', caption: '' };
            it._drafts[comp] = text;
            window._kasperAddCommentComp(m.id, comp);
            return;
        }
        if (R.mode === 'smm' && vis === 'client') { _rsClientVisibleNote(m.post, comp, text); return; }
        _calReviewState.drafts[m.id + '|' + comp] = text;
        window._calReviewComment(m.id, comp);
    }
    /* The SMM's "Client can see" note: the same outbox and card save as the Review panel's note
       (_calReviewComment), with the audience the Notes dialog's switch would give it. */
    function _rsClientVisibleNote(post, comp, body) {
        const now = new Date().toISOString();
        const entry = _noteOutboxPut({
            id: _calMintCommentId(), surface: 'review', kind: 'review-comment', pid: post.id, comp, parent_id: null, body,
            author: _calCurrentAuthor(), author_member_id: _calCurrentAuthorId() || undefined, role: _calCommentRole(),
            audience: 'client', is_tweak: false, created_at: now, at: Date.now(), state: 'sending'
        });
        const list = _calCommentsFor(post, comp).slice();
        if (!list.some(c => c && c.id === entry.id)) {
            list.push({ id: entry.id, parent_id: null, author: entry.author, ...(entry.author_member_id ? { author_member_id: entry.author_member_id } : {}),
                role: entry.role, is_tweak: false, audience: 'client', body, created_at: now, updated_at: now, done: false, done_at: '', done_by: '' });
            _calSetCommentsFor(post, comp, list);
            if (comp === 'video') post.comments = list;
        }
        _noteOutboxSend(entry.id).then(() => _rsRender());
    }
    function _rsStartChange(key, where, aat) {
        const S = R.S;
        S.editing = ''; S.menu = '';
        S.note.part = key; S.note.where = where || 'stage'; S.note.aat = !!aat;
        if (S.step !== key) S.step = key;
        _rsRender({ force: true });
        _rsFocusTa();
    }
    function _rsClearChange(refocus, drop) {
        const S = R.S;
        if (drop) S.note.text = '';
        S.note.part = null; S.note.where = 'chat'; S.note.aat = false;
        _rsRender({ force: true });
        if (refocus) _rsFocusTa();
    }
    function _rsFocusTa() {
        const t = _rsQ('ta'); if (!t) return;
        t.focus({ preventScroll: true });
        const L = t.value.length; try { t.setSelectionRange(L, L); } catch (e) {}
    }
    function _rsSendNote(asNote) {
        const S = R.S, t = String(S.note.text || '').trim();
        if (!t) { _rsFocusTa(); return; }
        const m = _rsCur(); if (!m) return;
        const k = asNote ? null : S.note.part, where = S.note.where, aat = S.note.aat, vis = S.note.vis;
        const x = k ? m.parts.find(p => p.key === k) : null;
        S.note = _rsBlankNote(); S.note.vis = vis;
        if (k && R.mode === 'client' && x && x.st === 'ok') {
            // Change my mind on an approved part (client link): a note to the team on that part.
            _rsSendNoteTo(m, k, t, vis);
            _rsFlash('Sent to your team', k);
            _rsRender({ force: true });
            return;
        }
        if (k) { _rsSendChange(m, k, t, { where, aat }); return; }
        // a plain note goes on the part on stage (every note belongs to a part on a card)
        const comp = m.parts.some(p => p.key === S.step) ? S.step : (m.parts[0] || { key: 'video' }).key;
        _rsSendNoteTo(m, comp, t, vis);
        _rsRender({ force: true });
    }
    function _rsStartEdit(k, text) {
        const S = R.S;
        S.note.part = null; S.note.where = 'chat'; S.editing = k; S.editText = text || '';
        _rsRender({ force: true });
        const t = _rsQ('capTa'); if (t) { t.focus({ preventScroll: true }); t.setSelectionRange(t.value.length, t.value.length); }
    }
    function _rsSaveEdit(m, k) {
        const S = R.S, t = String(S.editText || '').trim(), before = k === 'title' ? m.ytitle : m.caption;
        S.editing = '';
        if (!t || t === before.trim()) { _rsRender({ force: true }); return; }
        if (R.mode === 'client') {
            // The client's edit goes to the team as a change request carrying the new text; it is never approved by itself.
            _rsSendChange(m, k, 'Please use this ' + (k === 'title' ? 'title' : 'caption') + ':\n\n' + t, { where: 'stage' });
            return;
        }
        window._calOnFieldBlur({ dataset: { pid: m.id, fld: k === 'title' ? 'name' : 'caption' }, value: t });
        _rsFlash(RS_PART[k] + ' saved', k);
        _rsRender({ force: true });
    }
    function _rsGo(id) {
        const all = _rsAll();
        const m = all.find(x => x.id === id);
        if (!m) return;
        _rsSwap(() => {
            Object.assign(R.S, { curId: id, note: _rsBlankNote(), editing: '', fold: false, saved: null, menu: '' });
            R.S.step = _rsFirstStep(m);
        });
    }
    function _rsFinish() {
        const m = _rsCur();
        if (!m || _rsWaiting(m).length) return;
        const q = _rsQueue(), i = q.findIndex(x => x.id === m.id);
        let msg;
        if (R.mode === 'kasper') {
            const back = m.parts.some(x => x.st === 'chg' || (x.st === 'ok' && x.dec === 'aat'));
            if (m.sample) window._sxrKasperDismiss(m.id); else window._kasperDismiss(m.id);
            msg = back ? 'Sent to the editors' : 'Approved, sent to the client';
        } else {
            R.S.finished.add(m.id);
            msg = R.mode === 'client' ? 'Done. Your team has “' + m.title + '”' : 'Done with “' + m.title + '”';
        }
        const rest = _rsQueue().filter(x => x.id !== m.id);
        const nxt = rest[Math.min(Math.max(i, 0), rest.length - 1)] || null;
        const go = () => {
            R.S.curId = nxt ? nxt.id : null;
            R.S.step = nxt ? _rsFirstStep(nxt) : '';
            R.S.note = _rsBlankNote(); R.S.editing = '';
        };
        if (nxt) _rsSwap(go); else { go(); _rsRender({ force: true }); }
        _rsToast(msg + (nxt ? '. Next up: ' + nxt.title : ''), R.mode !== 'kasper' ? m.id : '');
    }
    let _rsTT = null;
    function _rsToast(msg, reopenId) {
        let t = R.root.getElementById('rsToast');
        if (!t) { t = document.createElement('div'); t.id = 'rsToast'; t.className = 'toast'; t.setAttribute('role', 'status'); R.root.querySelector('.rs').appendChild(t); }
        t.innerHTML = '<span class="tk">' + RI.check + '</span><span class="tx">' + _re(msg) + '</span>' + (reopenId ? '<button type="button" id="toastUndo">Undo</button>' : '');
        const u = R.root.getElementById('toastUndo');
        if (u) u.addEventListener('click', () => { R.S.finished.delete(reopenId); t.classList.remove('on'); _rsGo(reopenId); });
        clearTimeout(_rsTT);
        requestAnimationFrame(() => t.classList.add('on'));
        _rsTT = setTimeout(() => t.classList.remove('on'), 6000);
    }
    function _rsKeys(e) {
        const tag = (e.target && e.target.tagName || '').toLowerCase();
        if (e.key === 'Escape') {
            if (R.S.menu) { R.S.menu = ''; _rsDecide(); }
            else if (R.S.note.part) _rsClearChange(false, R.S.note.where === 'stage');
            else if (R.S.editing) { R.S.editing = ''; _rsRender({ force: true }); }
            return;
        }
        if (tag === 'textarea' || tag === 'input' || (e.target.closest && e.target.closest('.fv-player'))) return;
        const m = _rsCur(); if (!m) return;
        const keys = m.parts.map(x => x.key), i = keys.indexOf(R.S.step);
        if (e.key === 'ArrowRight' && i < keys.length - 1) { _rsSetStep(keys[i + 1]); e.preventDefault(); }
        if (e.key === 'ArrowLeft' && i > 0) { _rsSetStep(keys[i - 1]); e.preventDefault(); }
    }
    function _rsHelpOpen() {
        const url = svRsHelpUrl();
        if (!url) return;
        const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([A-Za-z0-9_-]{11})/);
        const vm = url.match(/vimeo\.com\/(\d+)/);
        const loom = url.match(/loom\.com\/share\/([A-Za-z0-9]+)/);
        const src = yt ? 'https://www.youtube.com/embed/' + yt[1] + '?autoplay=1&rel=0' : vm ? 'https://player.vimeo.com/video/' + vm[1] + '?autoplay=1' : loom ? 'https://www.loom.com/embed/' + loom[1] : '';
        const media = src ? '<iframe src="' + _re(src) + '" title="How this page works" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>'
            : '<video src="' + _re(url) + '" controls autoplay playsinline></video>';
        const o = document.createElement('div');
        o.className = 'help-ovl'; o.setAttribute('role', 'dialog'); o.setAttribute('aria-modal', 'true'); o.setAttribute('aria-label', 'How this page works');
        o.innerHTML = '<div class="help-box"><button class="help-x" type="button" aria-label="Close">' + RI.x + '</button>' + media + '</div>';
        const close = () => { o.remove(); document.removeEventListener('keydown', esc, true); const hb = _rsQ('rsHelp'); if (hb) hb.focus(); };
        const esc = (e) => { if (e.key === 'Escape') { e.stopPropagation(); close(); } };
        // Only a press that began on the backdrop closes it (OPEN_REPAIRS 215). The page's shared listener cannot
        // see inside this page's shadow root, so the overlay keeps its own press mark.
        o.addEventListener('mousedown', (e) => { o._backdropPressBegan = (e.target === o); });
        o.addEventListener('click', (e) => { if (e.target === o && o._backdropPressBegan) close(); o._backdropPressBegan = false; });
        o.querySelector('.help-x').addEventListener('click', close);
        document.addEventListener('keydown', esc, true);
        R.root.querySelector('.rs').appendChild(o);
        o.querySelector('.help-x').focus();
    }

    /* ---------- the area's door ---------- */
    function _rsCalDraw() {
        const cv = document.getElementById('calView');
        if (!cv) return;
        const mode = _isClientLink ? 'client' : 'smm';
        _rsMount(cv, mode, mode + '|' + (calState.client || ''));
        // The client link on Sheet, Month or Week (or while its cards load): the header only, the calendar below it.
        R.bar = mode === 'client' && !svRsCalOn();
        _rsQ('rsApp').classList.toggle('bar', R.bar);
        if (R.bar) _rsStageOff();
        _rsRender();
    }
    function _rsCalHide() {
        if (R.host && (R.mode === 'client' || R.mode === 'smm')) { R.host.hidden = true; R.bar = false; _rsStageOff(); }
    }
    function _rsKasperDraw(parts) {
        const body = document.getElementById('kasperReviewBody');
        if (!body) return;
        R.kparts = parts || { urgent: [], waiting: [], tweaks: [] };
        R.bar = false;
        _rsMount(body, 'kasper', 'kasper');
        _rsRender();
    }
    function _rsKasperHide() {
        if (R.host && R.mode === 'kasper') { R.host.hidden = true; _rsStageOff(); }
    }
    // The player's own switch (frame_viewer_clients) arriving, or changing, draws the stage again.
    window.addEventListener('sv-frame-switch', () => { if (R.host && !R.host.hidden && R.S) _rsRender(); });
    svAreaRegister('reviewstage', { cal: _rsCalDraw, calHide: _rsCalHide, kasper: _rsKasperDraw, kasperHide: _rsKasperHide });
