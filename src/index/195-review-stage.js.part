        return '<button class="finish' + glow + '" type="button" id="finishBtn"' + (all ? '' : ' disabled') + '>' + RI.check + 'Finish reviewing' + (all ? '' : sending ? (R.cp ? ' <span class="fc num" id="finishWait">' + _rsSpinner('Saving your answers') + '</span>' : ' <span class="fc num" id="finishWait">Saving…</span>') : ' <span class="fc num">' + (parts.length - left) + ' of ' + parts.length + '</span>') + '</button>'
            + (R.mode === 'kasper' && !m.gone ? (R.l2
                ? '<span class="closew"><button class="btn-quiet" type="button" id="closeBtn" aria-describedby="closeTip"' + (sending ? ' disabled' : '') + '>Close card</button><span class="tip" id="closeTip" role="tooltip">' + RS_CLOSE_TIP + '</span></span>'
                : '<button class="btn-quiet" type="button" id="closeBtn"' + (sending ? ' disabled' : '') + '>Close card</button>') : '');
    }
    function _rsBindFinish(m, root) {
        const fb = root.querySelector('#finishBtn'); if (fb) fb.addEventListener('click', _rsFinish);
        const cb = root.querySelector('#closeBtn'); if (cb) cb.addEventListener('click', () => {
            // An explicit close leaves the card; the kept-card rule is only for a background list change.
            const S = R.S;
            S.keepK = null; S.curId = null; S.note = _rsBlankNote();
            ['urgent', 'waiting', 'tweaks'].forEach(sec => {
                if (R.kparts && R.kparts[sec]) R.kparts[sec] = R.kparts[sec].filter(it => it.post.id !== m.id);
            });
            if (m.sample) window._sxrKasperClose(m.id); else window._kasperClose(m.id);
            _rsRender({ force: true });
        });
    }
    // The part's decision buttons and the change box: one click handler each, on the row that holds them.
    function _rsBindDecide(m, el) {
        const S = R.S;
        // A button that stays across refreshes (_rsCalm) keeps its handler, so the post is looked up when it is pressed, never held from when the button was drawn: a refresh replaces the post's objects.
        const cur = () => _rsModelById(m.id) || m;
        el.querySelectorAll('[data-ok]').forEach(b => b.addEventListener('click', () => _rsApprove(cur(), b.dataset.ok, R.mode === 'smm' ? 'kasper' : '')));
        // Polish: the save's live permission read starts at the press, not the release, so the click finds it under way
        // (the write path still reads it live for this very save; it only starts sooner). The circle starts at the button's width.
        if (R.cp) el.querySelectorAll('[data-ok]').forEach(b => b.addEventListener('pointerdown', () => { S.cpW = b.offsetWidth; try { _writeUiRefreshAuthority(); } catch (e) {} }));
        el.querySelectorAll('[data-alt]').forEach(b => b.addEventListener('click', (e) => {
            e.stopPropagation(); S.menu = '';
            if (b.dataset.alt === 'client') _rsApprove(cur(), b.dataset.for, 'client');
            else _rsStartChange(b.dataset.for, 'stage', true);
        }));
        el.querySelectorAll('[data-menu]').forEach(b => b.addEventListener('click', (e) => { e.stopPropagation(); S.menu = S.menu === b.dataset.menu ? '' : b.dataset.menu; _rsDecide(); }));
        el.querySelectorAll('[data-frame]').forEach(b => b.addEventListener('click', () => _rsSendChange(cur(), b.dataset.frame, RS_FRAME_NOTE, { where: 'stage' })));
        el.querySelectorAll('[data-chg]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.chg, 'stage')));
        el.querySelectorAll('[data-again]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.again, 'stage')));
        el.querySelectorAll('[data-retry]').forEach(b => b.addEventListener('click', () => { const f = S.retry[m.id + '|' + b.dataset.retry]; if (f) f(); }));
    }
    function _rsDecide() {
        if (R.l2) { _rsL2Decide(); return; }
        const m = _rsCur();
        if (!m) return;
        const S = R.S, x = m.parts.find(p => p.key === S.step);
        const el = _rsQ('drow');
        const elsew = _rsElsewhere(m, x) || (!x && m.parts.length === 0 ? 'Your team took this post back to work on it.' : '');
        const note = elsew ? '<div class="elsew" role="status" id="elsew"><span>' + _re(elsew) + '</span>' + (m.gone || !x ? '<button class="mv" type="button" id="moveOn">Next post</button>' : '') + '</div>' : '';
        const bindMove = () => { const b = _rsQ('moveOn'); if (b) b.addEventListener('click', () => _rsMoveOn(_rsModelById(m.id) || m)); };
        if (!x) { if (_rsCalm(el, note, m)) bindMove(); return; }
        let d;
        if (m.gone) {
            // Words typed on the stage stay on screen: the conversation's box takes them (review of #2207).
            if (S.note.part && S.note.where === 'stage') { S.note.where = 'chat'; _rsChat(m); }
            if (_rsCalm(el, note, m)) bindMove();
            return;
        }
        if (!_rsActive(m)) {
            if (_rsCalm(el, '<div class="dwrap"><div class="dec' + (x.st === 'ok' ? ' is-ok' : ' is-chg') + '">' + _rsInactiveD(m, x) + '</div></div><div class="drow2 both"><span class="held">' + RI.clock + _re(m.note) + '</span>' + _rsPingHtml(m) + '</div>', m)) _rsBindPing(m, el);
            return;
        }
        const ad = _rsActiveD(m, x);
        d = ad.d;
        if (!_rsCalm(el, note + '<div class="dwrap">' + (d === null ? _rsComposer(m) : '<div class="dec' + ad.dc + '" id="dec">' + d + '</div>') + '</div>'
            + _rsSaveIssues(m, x.key)
            + '<div class="drow2"><div class="dfin">' + _rsFinishHtml(m) + '</div></div>', m)) return;
        _rsBindDecide(m, el);
        _rsBindFinish(m, el);
        if (d === null) _rsBindComposer(el);
    }
    // Polish: what the box says about the changes it sent (a spinner while one is on its way, then "Sent").
    function _rsCpChgState(m, k) {
        if (!R.cp || !k) return '';
        const S = R.S, key = m.id + '|' + k;
        if (_rsSaving(m, k) || (S.chgQ[key] || []).length) return '<span class="cp-st">' + _rsSpinner('Sending your change') + '</span>';
        const n = S.cpSent[key] || 0;
        return n ? '<span class="cp-st cp-done" role="status">' + RI.check + (n > 1 ? n + ' changes sent' : 'Sent') + '</span><span class="why">Add another change, or finish reviewing.</span>' : '';
    }
    function _rsComposer(m) {
        const S = R.S, nt = S.note, k = nt.part, chg = !!k, n = chg ? _rsLname(k) : '', typed = !!nt.text.trim();
        const cpst = _rsCpChgState(m, k);
        const active = _rsActive(m);
        const paused = !!S.editing && !chg;
        const x = chg ? m.parts.find(p => p.key === k) : null;
        // An approved part on a client link cannot be reopened from the page: "Change my mind" is a note to the team.
        const reopenNote = R.mode === 'client' && x && x.st === 'ok';
        const ph = paused ? 'Finish the edit first'
            : cpst && S.cpSent[m.id + '|' + k] ? 'Another change to the ' + n + '?'
            : chg ? (nt.aat ? 'What should the editor fix? It goes on to the client after.' : reopenNote ? 'What would you like changed on the ' + n + '?' : 'What should change on the ' + n + '?')
            : R.mode === 'smm' ? (nt.vis === 'client' ? 'Leave a note the client will see too' : 'Leave a note for the team')
            : R.mode === 'kasper' ? (active ? 'Message the team' : 'Message the editor') : 'Message your team';
        const why = nt.aat ? 'Approved once the editor fixes it' : reopenNote ? 'Your team will reopen it' : x && x.st === 'ok' ? 'This takes back the approval' : R.mode === 'client' ? 'Your team will edit it' : 'The editor will change it';
        const chip = chg ? '<span class="tochip">' + _rsDot(k) + (nt.where === 'chat' ? 'Change to: ' + RS_PART[k] + '<button class="x" type="button" id="chipX" aria-label="Make it a plain note" title="Make it a plain note">' + RI.x + '</button>' : (nt.aat ? 'Approve the ' + n + ' after tweaks' : 'Change to the ' + n)) + '</span>' : '';
        const top = chg ? '<div class="cmp-top">' + chip + (R.cp ? '<span class="cp-stw" id="cpSt">' : '') + (cpst || '<span class="why">' + why + '</span>') + (R.cp ? '</span>' : '') + '</div>' : '';
        const seg = R.mode === 'smm' ? (chg
            ? '<div class="seg" role="group" aria-label="Who can see the change request"><button type="button" class="on" aria-pressed="true" disabled>' + RI.lock + 'Team only</button><button type="button" disabled title="Change requests always stay with the team">' + RI.eye + 'Client can see</button></div>'
            : '<div class="seg" role="group" aria-label="Who can see the note"><button type="button" data-vis="team" class="' + (nt.vis === 'team' ? 'on' : '') + '" aria-pressed="' + (nt.vis === 'team') + '">' + RI.lock + 'Team only</button><button type="button" data-vis="client" class="' + (nt.vis === 'client' ? 'on' : '') + '" aria-pressed="' + (nt.vis === 'client') + '">' + RI.eye + 'Client can see</button></div>') : '';
        const sendLabel = nt.aat ? 'Approve after tweaks' : reopenNote ? 'Send to your team' : 'Ask for change';
        const opts = active ? m.parts.filter(q => q.st !== 'chg' && q.st !== 'tweak' && !(R.mode === 'client' && q.st === 'ok')) : [];
        const foot = chg
            ? '<div class="cmp-foot">' + (seg || '<span class="esc">Enter sends</span>') + '<div class="btns"><button class="btn-quiet" type="button" id="cmpCancel">Cancel</button><button class="b-send-chg" type="button" id="sendBtn"' + (typed ? '' : ' disabled') + '>' + (nt.aat ? RI.aat : RI.back) + sendLabel + '</button></div></div>'
            : (opts.length ? '<div class="sugg"><div class="sgl"><span>Is this a change?</span><button class="justnote" type="button" id="noteBtn">Just a note ' + RI.send + '</button></div><div class="sgp">' + opts.map(q => '<button class="sg" type="button" data-sg="' + q.key + '">' + _rsDot(q.key) + RS_PART[q.key] + (q.st === 'ok' ? '<span class="sga">, approved</span>' : '') + '</button>').join('') + '</div></div>' : '')
              + (R.mode === 'smm' ? '<div class="nfoot">' + seg + '<button class="send" type="button" id="sendBtn" aria-label="Send the note"' + (typed ? '' : ' disabled') + '>' + RI.send + '</button></div>' : '');
        const send = chg || R.mode === 'smm' ? '' : '<button class="send" type="button" id="sendBtn" aria-label="Send as a note"' + (typed ? '' : ' disabled') + '>' + RI.send + '</button>';
        if (R.mode === 'client' && nt.where !== 'stage') return _rsClientComposer(m, opts, ph, paused, typed, cpst);
        return '<div class="compose' + (R.mode === 'smm' ? ' smm' : '') + (chg ? ' chg' : '') + (typed ? ' typed' : '') + '" id="compose"><div class="cbox">' + top + '<div class="ta-wrap"><textarea class="cta" id="ta" rows="1" placeholder="' + _re(ph) + '" aria-label="' + _re(ph) + '"' + (paused ? ' disabled' : '') + '>' + _re(nt.text) + '</textarea>' + send + '</div>' + foot + '</div></div>';
    }
    /* The client's message box: chips at the top left say what the message is about (one at a time; picking it again
       clears it), and two buttons at the bottom right send it. "Ask for a change" needs a part; "Send comment" asks for
       nothing and goes on the chosen part, or on the part on stage. Enter sends a change when a part is picked, a
       comment otherwise. */
    function _rsClientComposer(m, opts, ph, paused, typed, cpst) {
        const nt = R.S.note, k = nt.part, x = k ? m.parts.find(p => p.key === k) : null;
        const reopenNote = x && x.st === 'ok';
        const keys = opts.map(q => q.key);
        if (k && keys.indexOf(k) < 0) keys.push(k);
        const chips = keys.length ? '<div class="cl-parts" role="group" aria-label="What is this about?"><span class="lbl">About</span>' + keys.map(q => '<button class="pchip" type="button" data-pc="' + q + '" aria-pressed="' + (q === k) + '"' + (q === k ? ' title="Clear: send it as a comment"' : '') + '>' + _rsDot(q) + RS_PART[q] + '<span class="px" aria-hidden="true">' + RI.x + '</span></button>').join('')
            + (k ? (R.cp ? '<span class="cp-stw" id="cpSt">' : '') + (cpst || '<span class="why">' + (reopenNote ? 'Your team will reopen it' : 'Your team will edit it') + '</span>') + (R.cp ? '</span>' : '') : '') + '</div>' : '';
        const chgLabel = reopenNote ? 'Send to your team' : 'Ask for a change';
        const foot = '<div class="cl-foot">'
            + '<button class="b-cmt" type="button" id="cmtBtn"' + (typed ? '' : ' disabled') + '>' + RI.send + 'Send comment</button>'
            + (keys.length ? '<button class="b-send-chg" type="button" id="sendBtn"' + (typed && k ? '' : ' disabled') + (k ? '' : ' title="Pick what it is about first"') + '>' + RI.back + chgLabel + '</button>' : '') + '</div>';
        return '<div class="compose cl' + (k ? ' chg' : '') + (typed ? ' typed' : '') + '" id="compose"><div class="cbox">' + chips + '<div class="ta-wrap"><textarea class="cta" id="ta" rows="1" placeholder="' + _re(ph) + '" aria-label="' + _re(ph) + '"' + (paused ? ' disabled' : '') + '>' + _re(nt.text) + '</textarea></div>' + foot + '</div></div>';
    }
    // A note longer than this folds after a few lines behind "Show all" (a whole caption pasted as a change request).
    function _rsLongNote(text) { const t = String(text || ''); return t.length > 320 || t.split('\n').length > 7; }
    function _rsBubble(t, old) {
        const isChg = t.change && t.part;
        const tag = t.part ? '<span class="tag">' + _rsDot(t.part) + RS_PART[t.part] + '</span>' : '';
        const kind = isChg ? '<span class="kchg">' + (t.frame ? RI.frame + 'Tweaks on Frame' : RI.back + 'Change asked') + '</span>' : '';
        const role = R.mode === 'smm' && !t.you && t.role ? ' <span class="role">' + (t.role === 'client' ? 'client' : t.role === 'kasper' ? 'review' : '') + '</span>' : '';
        const vis = R.mode === 'smm' && !t.change && t.aud ? '<span class="vis' + (t.aud === 'client' ? ' cl' : '') + '">' + (t.aud === 'client' ? RI.eye + 'Client can see' : RI.lock + 'Team only') + '</span>' : '';
        const done = t.done ? '<span class="donec">' + RI.check + 'Done</span>' : '';
        const del = t.canDelete && t.id && !R.cp ? '<button class="btn-quiet" type="button" data-delete-note="' + _re(t.id) + '">Delete note</button>' : '';
        // Polish: a small cross at the note's top right on hover, focus or a long press; it asks before it deletes.
        const asking = R.cp && t.canDelete && t.id && R.S.cpDel === t.id;
        const cpx = R.cp && t.canDelete && t.id && !asking ? '<button class="cp-x" type="button" data-cp-del="' + _re(t.id) + '" aria-label="Delete note" title="Delete note">' + RI.x + '</button>' : '';
        const cpAsk = asking ? '<div class="cp-ask" role="group" aria-label="Delete this note?"><span>Delete this note?</span><button class="cp-yes" type="button" data-cp-yes="' + _re(t.id) + '">Delete</button><button class="cp-no" type="button" data-cp-no="1">Cancel</button></div>' : '';
        const when = R.cp && t.sending ? _rsSpinner('Sending') : '<span>' + _re(t.time) + '</span>';
        const av = t.you ? '' : '<span class="av' + (t.role === 'client' ? ' cl' : t.role === 'kasper' ? ' kp' : '') + '">' + _re(String(t.who || '?').charAt(0).toUpperCase()) + '</span>';
        const long = !t.edit && _rsLongNote(t.text), open = long && !!(t.id && R.S.exp['note:' + t.id]);
        const more = long && t.id ? '<button class="bmore" type="button" data-more="' + _re(t.id) + '" aria-expanded="' + open + '">' + (open ? 'Show less' : 'Show all') + '</button>' : '';
        return '<div class="bub ' + (t.you ? 'you' : 'team') + (old ? ' old' : '') + (isChg ? ' is-chg' : '') + (isChg && t.done ? ' handled' : '') + (asking ? ' cp-asking' : '') + '"' + (cpx ? ' data-cp-note="' + _re(t.id) + '"' : '') + '>' + av + '<div class="bb">' + cpx + '<div class="bh"><b>' + (t.you ? 'You' : _re(t.who)) + role + '</b>' + tag + kind + when + '</div>' + (t.edit
            ? '<div class="bt' + (t.sending ? ' sending' : '') + '">' + (t.you ? 'You changed' : 'Changed') + ' the caption</div><div class="diff"><div class="new">' + _re(t.edit.now) + '</div>'
              + (t.edit.old ? '<details class="was"><summary>Show the old caption</summary><div class="old">' + _re(t.edit.old) + '</div></details>' : '<div class="was">It had no caption before.</div>') + '</div>'
            : '<div class="bt' + (t.sending ? ' sending' : '') + (long && t.id && !open ? ' clamp' : '') + '">' + _re(t.text) + '</div>') + more + (t.failed ? '<div class="err" role="alert">Not sent. Your words are kept here. <button type="button" class="retry" data-note-retry="' + _re(t.id) + '">Try again</button></div>' : t.sending && !R.cp ? '<div role="status">Sending…</div>' : '') + (vis || done || del ? '<div class="bfoot">' + vis + done + del + '</div>' : '') + cpAsk + '</div></div>';
    }
    function _rsThreadHtml(m) {
        const S = R.S, all = m.thread;
        // older, finished notes fold away; the newest four always show
        const cut = all.length > 6 ? all.length - 4 : 0;
        const fold = all.slice(0, cut), live = all.slice(cut);
        let th = '';
        if (fold.length) th += '<button class="fold first" type="button" id="foldBtn" aria-expanded="' + S.fold + '">' + (S.fold ? 'Hide earlier notes' : fold.length + ' earlier notes') + '</button><div class="folded' + (S.fold ? ' open' : '') + '">' + fold.map(t => _rsBubble(t, true)).join('') + '</div>';
        th += live.map(t => _rsBubble(t)).join('');
        if (!all.length) th = '<p class="ch-empty">No messages on this post yet. Anything you send shows up here.</p>';
        return th;
    }
    function _rsChat(m) {
        const S = R.S, c = _rsQ('chat');
        const th = _rsThreadHtml(m);
        const dk = !!S.note.part && S.note.where === 'stage';
        const foot = dk ? '<div class="ch-quiet">Your change shows up here when you send it.</div>' : _rsComposer(m);
        const head = R.mode === 'client'
            ? '<span class="avs"><span class="av">S</span></span><span class="who"><b>Your team</b><span>Usually replies within a day</span></span>'
            : R.mode === 'smm'
                ? '<span class="avs"><span class="av cl">' + _re(String(calState.client || '?').charAt(0)) + '</span><span class="av kp">K</span></span><span class="who"><b>Conversation</b><span>' + _re(calState.client || '') + ' (client), the editors and Kasper</span></span>'
                : '<span class="avs"><span class="av">' + _re(String(m.client || '?').charAt(0)) + '</span><span class="av l">E</span></span><span class="who"><b>The team</b><span>' + _re(m.client) + '’s SMM and editors. The client does not see this.</span></span>';
        if (!_rsCalm(c, '<div class="ch-head">' + head + '</div><div class="ch-scroll" id="tscroll">' + th + '</div><div class="ch-foot">' + foot + '</div>', m)) return;
        _rsBindThread(c, m);
        if (!dk) _rsBindComposer(c);
        const ts = _rsQ('tscroll'); if (ts) ts.scrollTop = ts.scrollHeight;
    }
    /* Polish: someone typing in the box keeps it (the page waits to redraw it until they stop), but what they are waiting
       for still shows: the conversation, the steps, and the box's own spinner turning into "Sent". */
    function _rsCpTypingPaint() {
        const m = _rsCur(), S = R.S;
        if (!m || R.l2) return;
        _rsStepper(m);
        // the decision row (its save problems, Finish) unless the box being typed in is in it
        const dr = _rsQ('drow');
        if (dr && !dr.contains(R.root.activeElement)) _rsDecide();
        const ts = _rsQ('tscroll'), c = _rsQ('chat');
        if (ts && c) {
            const html = _rsThreadHtml(m);
            if (ts.__cpHtml !== html) {
                const end = ts.scrollHeight - ts.scrollTop - ts.clientHeight < 40;
                ts.innerHTML = html; ts.__cpHtml = html;
                _rsBindThread(c, m);
                if (end) ts.scrollTop = ts.scrollHeight;
            }
        }
        const st = _rsQ('cpSt'), k = S.note.part;
        if (st && k) { const h = _rsCpChgState(m, k); if (h && st.innerHTML !== h) st.innerHTML = h; }
        const ta = _rsQ('ta');
        if (ta && k && S.cpSent[m.id + '|' + k] && !ta.value) { const ph = 'Another change to the ' + _rsLname(k) + '?'; if (ta.placeholder !== ph) { ta.placeholder = ph; ta.setAttribute('aria-label', ph); } }
    }
    function _rsBindThread(c, m) {
        const S = R.S;
        const fb = _rsQ('foldBtn'); if (fb) fb.addEventListener('click', () => { S.fold = !S.fold; _rsChat(_rsModelById(m.id) || m); });
        c.querySelectorAll('[data-delete-note]').forEach(b => b.addEventListener('click', () => window._calDeleteComment(b.dataset.deleteNote, m.id)));
        if (R.cp) _rsCpBindDelete(c, m);
        // "Show all" on a long note: only this bubble opens, the thread keeps its place.
        c.querySelectorAll('[data-more]').forEach(b => b.addEventListener('click', () => {
            const k = 'note:' + b.dataset.more, ts0 = _rsQ('tscroll'), top = ts0 ? ts0.scrollTop : 0;
            S.exp[k] = !S.exp[k];
            const bt = b.previousElementSibling;
            if (bt) bt.classList.toggle('clamp', !S.exp[k]);
            b.textContent = S.exp[k] ? 'Show less' : 'Show all';
            b.setAttribute('aria-expanded', String(!!S.exp[k]));
            if (ts0) ts0.scrollTop = top;
        }));
        c.querySelectorAll('[data-note-retry]').forEach(b => b.addEventListener('click', () => { _noteOutboxSend(b.dataset.noteRetry).then(() => _rsRender()); }));
    }
    // Polish: the cross asks "Delete this note?" in the note itself; Delete deletes it (no second dialog), Cancel or
    // Escape puts the note back. On a touch screen a long press shows the cross.
    function _rsCpBindDelete(c, m) {
        const S = R.S;
        const redraw = () => _rsChat(_rsModelById(m.id) || m);
        c.querySelectorAll('[data-cp-del]').forEach(b => b.addEventListener('click', (e) => { e.stopPropagation(); S.cpDel = b.dataset.cpDel; redraw(); const y = c.querySelector('[data-cp-yes]'); if (y) y.focus({ preventScroll: true }); }));
        c.querySelectorAll('[data-cp-yes]').forEach(b => b.addEventListener('click', () => { const id = b.dataset.cpYes; S.cpDel = null; window._calDeleteComment(id, m.id, true); redraw(); }));
        c.querySelectorAll('[data-cp-no]').forEach(b => b.addEventListener('click', () => { S.cpDel = null; redraw(); }));
        const ask = c.querySelector('.cp-ask');
        if (ask) ask.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); S.cpDel = null; redraw(); } });
        c.querySelectorAll('[data-cp-note]').forEach(n => {
            let timer = 0;
            const stop = () => { clearTimeout(timer); timer = 0; };
            n.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; stop(); timer = setTimeout(() => { c.querySelectorAll('.bub.cp-show').forEach(x => x.classList.remove('cp-show')); n.classList.add('cp-show'); }, 450); });
            ['pointerup', 'pointercancel', 'pointerleave', 'pointermove'].forEach(ev => n.addEventListener(ev, (e) => { if (ev !== 'pointermove' || Math.abs(e.movementX) + Math.abs(e.movementY) > 6) stop(); }));
            n.addEventListener('contextmenu', (e) => { if (n.classList.contains('cp-show')) e.preventDefault(); });
        });
    }
    function _rsBindComposer(root) {
        const S = R.S;
        // Looked up inside the region being bound, never in the whole page: the stage and the conversation can both hold a box for a moment, and a button bound in the other one is lost when that one is replaced.
        const q = (id) => root.querySelector('#' + id);
        root.querySelectorAll('[data-sg]').forEach(b => b.addEventListener('click', () => _rsStartChange(b.dataset.sg, 'chat')));
        root.querySelectorAll('[data-vis]').forEach(b => b.addEventListener('click', () => { S.note.vis = b.dataset.vis; _rsRender({ force: true }); _rsFocusTa(); }));
        const cx = q('chipX'); if (cx) cx.addEventListener('click', () => _rsClearChange(true, false));
        const cc = q('cmpCancel'); if (cc) cc.addEventListener('click', () => _rsClearChange(false, true));
        const nb = q('noteBtn'); if (nb) nb.addEventListener('click', () => _rsSendNote(true));
        root.querySelectorAll('[data-pc]').forEach(b => b.addEventListener('click', () => { const S2 = R.S; if (S2.note.part === b.dataset.pc) _rsClearChange(true, false); else { S2.note.part = b.dataset.pc; S2.note.where = 'chat'; S2.note.aat = false; const pm = _rsCur(), px = pm && pm.parts.find(p => p.key === b.dataset.pc); S2.note.was = px ? px.st : ''; _rsPersistCur(); _rsRender({ force: true }); _rsFocusTa(); } }));
        const mb = q('cmtBtn'); if (mb) mb.addEventListener('click', () => _rsSendNote(true));
        const sb = q('sendBtn'); if (sb) sb.addEventListener('click', () => _rsSendNote(!S.note.part));
        const ta = q('ta');
        if (!ta) return;
        const grow = () => { ta.style.height = 'auto'; ta.style.height = Math.min(160, ta.scrollHeight + 2) + 'px'; };
        ta.addEventListener('input', () => {
            S.note.text = ta.value;
            _rsPersistCur();
            const has = !!ta.value.trim();
            const cp = q('compose'); if (cp) cp.classList.toggle('typed', has);
            const s = q('sendBtn'); if (s) s.disabled = !has || (R.mode === 'client' && S.note.where !== 'stage' && !S.note.part);
            const cm = q('cmtBtn'); if (cm) cm.disabled = !has;
            grow();
        });
        ta.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); _rsSendNote(!S.note.part); }
            else if (e.key === 'Escape' && S.note.part) { e.preventDefault(); e.stopPropagation(); _rsClearChange(S.note.where === 'chat', S.note.where === 'stage'); }
        });
        if (S.note.text) grow();
    }
    function _rsRecap() {
        const r = _rsQ('recap');
        if (R.mode === 'kasper') {
            const ed = _rsKasperModels().tweaks;
            r.innerHTML = '<div class="rc-card"><div class="ei">' + RI.check + '</div><h3>All caught up.</h3><p>Nothing is waiting for your review. New cards show up here as soon as an SMM sends them.</p>'
                + (ed.length ? '<div class="recent"><div class="recent-h"><span>With the editors</span></div>' + ed.map(m => '<button class="rc" type="button" data-id="' + _re(m.id) + '" style="cursor:pointer;width:100%;text-align:left"><span class="sw"><span class="slot' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</span></span><span class="rx"><span class="rt">' + (m.client ? '<span class="ck">' + _re(m.client) + '</span><span class="ct"> · ' + _re(m.title) + '</span>' : _re(m.title)) + '</span>' + (m.since ? '<span class="rw wt">' + _re(m.since) + '</span>' : '') + '</span></button>').join('') + '</div>' : '') + '</div>';
            r.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => { R.S.edOpen = true; _rsGo(b.dataset.id); }));
            return;
        }
        const fin = (calState.posts || []).filter(p => R.S.finished.has(p.id));
        const head = R.mode === 'client' ? (fin.length ? 'All done. Your team has everything.' : 'Nothing waiting on you.') : (fin.length ? 'All done for ' + (calState.client || 'this client') + '.' : 'Nothing waiting on SMM approval.');
        const line = R.mode === 'client' ? 'Your team will let you know when the next post is ready.' : 'Posts show up here when they reach SMM approval.';
        r.innerHTML = '<div class="rc-card"><div class="ei">' + RI.check + '</div><h3>' + _re(head) + '</h3><p>' + _re(line) + '</p>'
            + (fin.length ? '<div class="recent"><div class="recent-h"><span>Reviewed just now</span></div>' + fin.slice(-3).map(p => { const m = _rsModel(p, R.mode, null); const ok = m.parts.every(x => x.st === 'ok'); return '<div class="rc"><span class="sw"><span class="slot' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</span></span><span class="rx"><span class="rt">' + _re(m.title) + '</span><span class="rw' + (ok ? '' : ' wt') + '">' + (ok ? RI.check + 'Approved' + (m.date ? ', goes out ' + _re(m.date) : '') : RI.back + 'With your team') + '</span></span></div>'; }).join('') + '</div>' : '') + '</div>';
    }

    /* ---------- actions ---------- */
    let _rsFT = null;
    function _rsFlash(text, key, pid, confirmed) {
        const m = _rsCur();
        if (confirmed) R.S.saved = { key, pid: pid || (m ? m.id : ''), t: Date.now() };
        const f = _rsQ('flash'); if (f) { f.textContent = text; clearTimeout(_rsFT); _rsFT = setTimeout(() => { f.textContent = ''; }, 2600); }
    }
    function _rsAdvance(m, from) {
        if (R.l2) return;   // every part is on stage: there is no next step to move to
        const S = R.S, t0 = Date.now();
        const go = () => {
            if (R.S !== S) return;
            const cur = _rsCur();
            if (!cur || cur.id !== m.id || R.S.step !== from || R.S.note.part || R.S.editing) return;
            // a refused save stays on its part, with its reason and Try again
            const x = cur.parts.find(p => p.key === from);
            if (!x || x.st === 'wait' || _rsError(cur, from)) return;
            // Polish: the stage moves on once the save landed and its check has shown, never under the spinner.
            const ok = S.cpOk[m.id + '|' + from];
            if (R.cp && Date.now() - t0 < RS_PRE_MS && (_rsSaving(cur, from) || (ok && Date.now() - ok < RS_CP_CHECK_MS + 150))) { setTimeout(go, 40); return; }
            const nx = _rsNextOpen(cur, from);
            if (nx) _rsSetStep(nx);
        };
        setTimeout(go, R.cp ? 40 : 400);
    }
    function _rsItem(m) { return m.item; }
    /* A save on the stage always ends on screen (owner feedback 2026-10-17 23:40, session Curtain Nine). The old
       page's save path tells the stage when it is done through its own repaint, but not every branch repaints (an
       approval that cleared the card's last waiting part used to remove the old card and never told the stage, so it
       read "Saving" for good). So the stage watches the part itself: the moment the saving flag drops it draws again,
       and after a few seconds with no answer it says so in plain words. */
    const RS_SLOW_MS = 8000;
    function _rsModelById(id) { return _rsAll().find(x => x.id === id) || null; }
    // An action can wait before its save starts (the SMM's "resolve the open change requests" chooser, or a canonical
    // resolve that reads first): until the saving flag has been seen, the watch keeps waiting (up to two minutes)
    // instead of reading "not saving" as "done". `done` is the words for the moment the save ends well ("Video
    // approved, saved"): the step's "Saved" mark and the spoken flash wait for the server, never the click.
    const RS_PRE_MS = 120000;
    // `want` is the outcome the save asked for ('ok' approve, 'chg' a change): the flash and the Saved mark only show
    // when the part now reads that way. A held client approval the queue later drops as not saved (the post changed
    // meanwhile, or the hold expired) ends saving with no error but a different status: no "saved" claim then
    // (review of #2180, Lighthouse).
    function _rsWatch(m, comp, done, want) {
        const key = m.id + '|' + comp, S = R.S;
        let t0 = Date.now(), seen = _rsSaving(m, comp);
        delete S.slow[key];
        const tick = () => {
            if (R.S !== S) return;   // the page was remounted
            const cur = _rsModelById(m.id) || m;
            if (!seen) {
                if (_rsSaving(cur, comp)) { seen = true; t0 = Date.now(); }
                else if (_rsError(cur, comp)) { _rsRender(); return; }
                else { if (Date.now() - t0 < RS_PRE_MS) setTimeout(tick, 50); return; }
            }
            if (!_rsSaving(cur, comp)) {
                const part = (cur.parts || []).find(p => p.key === comp);
                const st = part ? part.st : '';
                const landed = !want || (want === 'ok' ? st === 'ok' : (st === 'chg' || st === 'tweak'));
                if (R.cp && want === 'ok' && landed && S.pressed[key] === 'ok' && !_rsError(cur, comp)) _rsCpLanded(key);
                delete S.slow[key]; delete S.pressed[key];
                if (!_rsError(cur, comp) && landed) { delete S.retry[key]; delete S.retryText[key]; if (done) _rsFlash(done, comp, m.id, true); }
                _rsRender();
                return;
            }
            if (!S.slow[key] && Date.now() - t0 >= RS_SLOW_MS) { S.slow[key] = true; _rsRender(); }
            setTimeout(tick, 50);
        };
        setTimeout(tick, 50);
    }
    function _rsApprove(m, comp, how) {
        // The button was drawn before a refresh said the part is no longer waiting: nothing to save; the stage says so.
        // (Try again after a refused save still goes: the part reads as approved there, with its error.)
        const fresh = _rsModelById(m.id), fx = fresh && fresh.parts.find(p => p.key === comp);
        if (!fresh || fresh.gone || !fx || (fx.st !== 'wait' && !_rsError(fresh, comp))) { _rsRender({ force: true }); return; }
        R.S.saved = null;
        delete R.S.editErrors[m.id + '|' + comp];   // an earlier refused caption edit must not stand in for this save's own result
        R.S.retry[m.id + '|' + comp] = () => { const cur = _rsModelById(m.id); if (cur) _rsApprove(cur, comp, how); };
        R.S.pressed[m.id + '|' + comp] = how === 'client' ? 'client' : 'ok';
        R.S.actAt[m.id + '|' + comp] = Date.now();
        R.S.acted.add(m.id + '|' + comp); R.S.menu = '';
        if (R.mode === 'client') window._calReviewApprove(m.id, comp);
        else if (R.mode === 'smm') window._calReviewApprove(m.id, comp, how === 'client' ? 'client' : 'kasper');
        else if (m.sample) window._sxrKasperApproveComp(m.id, comp);
        else window._kasperApproveComp(m.id, comp, 'client');
        if (R.mode === 'kasper' && R.l2) _rsL2UndoArm(m.id, comp);
        _rsRender({ force: true });
        _rsWatch(m, comp, RS_PART[comp] + (R.mode === 'smm' ? ' approved to ' + (how === 'client' ? 'the client' : 'Kasper') : ' approved, saved'), R.mode === 'client' ? 'ok' : '');
        _rsAdvance(m, comp);
    }
    function _rsSendChange(m, comp, text, o) {
        const opts = o || {};
        R.S.saved = null;
        delete R.S.editErrors[m.id + '|' + comp];
        R.S.retry[m.id + '|' + comp] = () => { const cur = _rsModelById(m.id); if (cur) _rsSendChange(cur, comp, text, Object.assign({}, opts, { where: '' })); };
        R.S.retryText[m.id + '|' + comp] = text;
        R.S.pressed[m.id + '|' + comp] = opts.aat ? 'aat' : text === RS_FRAME_NOTE ? 'frame' : 'chg';
        R.S.actAt[m.id + '|' + comp] = Date.now();
        R.S.acted.add(m.id + '|' + comp);
        if (R.mode === 'kasper') {
            if (m.sample) {
                window._sxrKasperState.drafts[m.id + '|' + comp] = text;
                if (opts.aat) window._sxrKasperApproveAfterTweaksComp(m.id, comp); else window._sxrKasperRequestTweakComp(m.id, comp);
            } else {
                const it = _rsItem(m);
                if (!it._drafts) it._drafts = { video: '', graphic: '', caption: '' };
                it._drafts[comp] = text;
                if (opts.aat) window._kasperApproveAfterTweaksComp(m.id, comp); else window._kasperRequestTweakComp(m.id, comp);
            }
        } else {
            _calReviewState.drafts[m.id + '|' + comp] = text;
            window._calReviewRequestTweak(m.id, comp);
        }
        // A change the polish's queue sends in the background must not redraw the box under someone typing the next one.
        if (opts.quiet) _rsRender(); else _rsRender({ force: true });
        _rsWatch(m, comp, opts.aat ? RS_PART[comp] + ' approved after tweaks' : 'Change sent', R.mode === 'client' ? 'chg' : '');
        if (opts.where === 'stage') _rsAdvance(m, comp);
    }
    /* Polish: a change request from the client page. The box stays open on the same part, empty, for the next change.
       Each change waits for the one before it to land (the save path takes one at a time per part and would drop a
       second one sent meanwhile), then goes. If one is refused, the ones still waiting go back into the box, so no
       words are ever lost; the refused one keeps its own Try again and "Your unsent words". */
    function _rsCpQueueChange(m, k, text, where) {
        const S = R.S, key = m.id + '|' + k;
        S.note = Object.assign(_rsBlankNote(), { part: k, where: where === 'stage' ? 'stage' : 'chat', was: 'chg' });
        const q = S.chgQ[key] || (S.chgQ[key] = []);
        q.push({ id: 'cq' + Date.now() + '_' + q.length, body: text, created_at: new Date().toISOString() });
        if (!q.busy) _rsCpDrain(m, k);
        _rsPersistCur();
        _rsRender({ force: true });
        _rsFocusTa();
    }
    function _rsCpDrain(m, k) {
        const S = R.S, key = m.id + '|' + k, q = S.chgQ[key];
        if (!q) return;
        q.busy = true;
        let sent = false;
        const giveBack = (why) => {
            const rest = q.splice(0).map(n => n.body);
            delete S.chgQ[key];
            if (!rest.length) return;
            const typed = String(S.note.text || '').trim();
            S.note = Object.assign(_rsBlankNote(), { part: k, where: S.note.where || 'chat', was: 'chg', text: rest.concat(typed ? [typed] : []).join('\n\n') });
            S.cpBack[key] = true;
            // Someone typing keeps typing: the words go into the box under their hands, the caret stays at the end.
            const ta = _rsQ('ta');
            if (ta && R.root.activeElement === ta) { ta.value = S.note.text; const L = ta.value.length; try { ta.setSelectionRange(L, L); } catch (e) {} ta.dispatchEvent(new Event('input')); }
            _rsPersistCur();
            _rsFlash(why, k);
        };
        // The save path keeps one change per part in flight: the one before must have landed AND left this browser's
        // delivery ledger (a few ms after its save ends), or the next is refused as "still being confirmed".
        const ledgerBusy = () => { try { return _linearOutboxRead().some(it => it && it.source_gate && String(it.source_gate.post_id) === String(m.id) && String(it.source_gate.component) === k); } catch (e) { return false; } };
        let waitFrom = 0, retried = false;
        const step = () => {
            if (R.S !== S) return;
            const cur = _rsModelById(m.id) || m;
            if (_rsSaving(cur, k)) { setTimeout(step, 40); return; }
            // A refused change still holds this part: sending again first tries that one again, then the rest follow.
            if (!sent && q.length && _rsError(cur, k) && S.retry[key] && !retried) {
                retried = true;
                S.retry[key]();
                sent = true;
                setTimeout(step, 40);
                return;
            }
            if (q.length && !(sent && _rsError(cur, k)) && ledgerBusy()) {
                if (!waitFrom) waitFrom = Date.now();
                if (Date.now() - waitFrom < 15000) { setTimeout(step, 40); return; }
            }
            waitFrom = 0;
            if (sent) {
                sent = false;
                // Refused: it keeps its own words and Try again (that retry is the one the save path accepts next on this
                // part); every change still waiting goes back into the box.
                if (_rsError(cur, k)) { giveBack('Not sent. Your next words are back in the box.'); _rsRender(); return; }
                S.cpSent[key] = (S.cpSent[key] || 0) + 1;
            }
            if (!q.length) { delete S.chgQ[key]; _rsRender(); return; }
            const nx = q.shift();
            delete S.cpBack[key];
            _rsSendChange(cur, k, nx.body, { where: '', quiet: true });
            // The save path can decline before it starts (the part moved on meanwhile): the words go back, never lost.
            if (!_rsSaving(_rsModelById(m.id) || cur, k)) { q.unshift(nx); giveBack('Not sent. Your words are back in the box.'); _rsRender(); return; }
            sent = true;
            setTimeout(step, 40);
        };
        step();
    }
    function _rsSendNoteTo(m, comp, text, vis) {
        const nkey = m.id + '|' + comp;
        if (!_rsSaving(m, comp) && !(R.S.noteQ[nkey] || []).length) { _rsSendNoteNow(m, comp, text, vis); return; }
        // The part is still saving (the person just answered it): the old save paths ignore a note sent now and the
        // words would be lost. The note shows in the conversation at once, "Sending…", and goes the moment that save
        // ends, in the order it was written.
        const S = R.S, q = S.noteQ[nkey] || (S.noteQ[nkey] = []);
        q.push({ id: 'q' + Date.now() + '_' + q.length, body: text, vis, created_at: new Date().toISOString() });
        const drain = () => {
            if (R.S !== S) return;   // the page was remounted
            const cur = _rsModelById(m.id) || m;
            if (_rsSaving(cur, comp)) { setTimeout(drain, 40); return; }
            const nx = (S.noteQ[nkey] || [])[0];
            if (!nx) { delete S.noteQ[nkey]; return; }
            S.noteQ[nkey].shift();
            _rsSendNoteNow(cur, comp, nx.body, nx.vis);
            if (!S.noteQ[nkey].length) delete S.noteQ[nkey]; else setTimeout(drain, 40);
            _rsRender();
        };
        drain();
    }
    function _rsSendNoteNow(m, comp, text, vis) {
        delete R.S.pressed[m.id + '|' + comp];   // a stale "Approved" must not label this note's save
        if (R.mode === 'kasper') {
            if (m.sample) { window._sxrKasperState.drafts[m.id + '|' + comp] = text; window._sxrKasperAddCommentComp(m.id, comp); return; }
            const it = _rsItem(m);
            if (!it._drafts) it._drafts = { video: '', graphic: '', caption: '' };
            // A card that left his lists (m.gone) is no longer where his own save path looks it up by id, so it would
            // drop the words: the note is saved here instead (review of #2207).
            if (m.gone && !_kasperState.items.some(x => x.post && x.post.id === m.id)) { _rsKasperGoneNote(m, it, comp, text); return; }
            it._drafts[comp] = text;
            const S = R.S;
            Promise.resolve(window._kasperAddCommentComp(m.id, comp)).then(() => {
                if (R.S !== S || !it._errors || !it._errors[comp] || !it._drafts[comp]) return;
                // The old panel restores its own textarea draft after a refusal. The stage has a separate box.
                const d = { text: it._drafts[comp], part: null, vis: 'team', was: '', aat: false, at: Date.now() };
                if (S.curId === m.id && !String(S.note.text || '').trim()) S.note = Object.assign(_rsBlankNote(), d);
                else if (!S.drafts[m.id]) S.drafts[m.id] = d;
                _rsRender({ force: true });
            });
            return;
        }
        if (R.mode === 'smm' && vis === 'client') { _rsClientVisibleNote(m.post, comp, text); return; }
        _calReviewState.drafts[m.id + '|' + comp] = text;
        window._calReviewComment(m.id, comp);
    }
    /* Kasper's team-only note on a card that left his lists: the same comment and the same field-level card save as
       _kasperAddCommentComp (comment cells, and scalars only when they changed since load, so the statuses the other
       window set are not sent back). A refused save puts the words back in the box. */
    function _rsKasperGoneNote(m, it, comp, body) {
        const list = _calCommentsFor(it.post, comp).slice(), now = new Date().toISOString();
        list.push({ id: _calMintCommentId(), parent_id: null, author: 'Kasper', role: 'kasper', is_tweak: false, audience: 'internal', body, created_at: now, updated_at: now, done: false, done_at: '', done_by: '' });
        _calSetCommentsFor(it.post, comp, list);
        if (comp === 'video') it.post.comments = list;
        if (!it._saving) it._saving = {};
        if (!it._errors) it._errors = {};
        it._saving[comp] = true; it._errors[comp] = null;
        _kasperPersistPost(it).then(() => { it._saving[comp] = false; _rsRender(); }, (e) => {
            it._saving[comp] = false;
            it._errors[comp] = String((e && e.message) || 'The save was refused.');
            if (R.S && R.S.curId === m.id && !String(R.S.note.text || '').trim()) { R.S.note.text = body; R.S.note.part = null; }
            _rsFlash('Not saved. Your words are back in the box.', comp, m.id);
            _rsRender({ force: true });
        });
    }
    /* The SMM's "Client can see" note: the same outbox and card save as the Review panel's note
       (_calReviewComment), with the audience the Notes dialog's switch would give it. */
    function _rsClientVisibleNote(post, comp, body) {
        const now = new Date().toISOString();
        const entry = _noteOutboxPut({
            id: _calMintCommentId(), surface: 'review', kind: 'review-comment', pid: post.id, comp, parent_id: null, body,
            author: _calCurrentAuthor(), author_member_id: _calCurrentAuthorId() || undefined, role: _calCommentRole(),
            audience: 'client', is_tweak: false, created_at: now, at: Date.now(), state: 'sending'
        });
        const list = _calCommentsFor(post, comp).slice();
        if (!list.some(c => c && c.id === entry.id)) {
            list.push({ id: entry.id, parent_id: null, author: entry.author, ...(entry.author_member_id ? { author_member_id: entry.author_member_id } : {}),
                role: entry.role, is_tweak: false, audience: 'client', body, created_at: now, updated_at: now, done: false, done_at: '', done_by: '' });
            _calSetCommentsFor(post, comp, list);
            if (comp === 'video') post.comments = list;
        }
        _noteOutboxSend(entry.id).then(() => _rsRender());
    }
    function _rsStartChange(key, where, aat) {
        const S = R.S;
        S.editing = ''; S.menu = '';
        S.note.part = key; S.note.where = where || 'stage'; S.note.aat = !!aat;
        const cm = _rsCur(), cx = cm && cm.parts.find(p => p.key === key);
        S.note.was = cx ? cx.st : '';
        if (S.step !== key) S.step = key;
        _rsPersistCur();
        _rsRender({ force: true });
        _rsFocusTa();
    }
    function _rsClearChange(refocus, drop) {
        const S = R.S;
        if (R.cp && S.note.part && S.curId) delete S.cpSent[S.curId + '|' + S.note.part];
        if (drop) S.note.text = '';
        S.note.part = null; S.note.where = 'chat'; S.note.aat = false;
        _rsPersistCur();
        _rsRender({ force: true });
        if (refocus) _rsFocusTa();
    }
    function _rsFocusTa() {
        const t = _rsQ('ta'); if (!t) return;
        t.focus({ preventScroll: true });
        const L = t.value.length; try { t.setSelectionRange(L, L); } catch (e) {}
    }
    function _rsSendNote(asNote) {
        const S = R.S, t = String(S.note.text || '').trim();
        if (!t) { _rsFocusTa(); return; }
        const m = _rsCur();
        if (!m || (S.shown && m.id !== S.shown)) {
            // The post the words were typed on left the list while the stage waited for the typing to stop: draw the
            // post now on stage and keep the words in the box, never send them onto a card nobody looked at.
            _rsRender({ force: true });
            _rsFlash('That post left your list. Your words are still in the box.', '');
            return;
        }
        const picked = S.note.part, k = asNote ? null : S.note.part, where = S.note.where, aat = S.note.aat, vis = S.note.vis, was = S.note.was;
        S.saved = null;
        const x = k ? m.parts.find(p => p.key === k) : null;
        S.note = _rsBlankNote(); S.note.vis = vis; S.moved = null;
        _rsDraftDrop(m.id);
        // The part stopped waiting while the words were typed (answered in another window, or by the team): the
        // words are never dropped. They go to the team as a note on that part, and the page says so (session
        // Curtain Ten; the old page's change request returns early once the part is not waiting).
        const late = k && (m.gone || !x || (was === 'wait' && x.st !== 'wait' && !(R.mode === 'client' && x.st === 'chg')));
        if (late) {
            const msg = x && x.st === 'ok' && !m.gone ? 'This was already approved, so we sent your words to the team as a note.'
                : 'This was already answered, so we sent your words to the team as a note.';
            _rsSendNoteTo(m, k, t, R.mode === 'smm' ? 'team' : vis);
            R.S.told[m.id + '|' + k] = msg;
            _rsFlash('Sent to the team as a note', k);
            _rsRender({ force: true });
            return;
        }
        if (k && R.mode === 'client' && x && x.st === 'ok') {
            // Change my mind on an approved part (client link): a note to the team on that part.
            _rsSendNoteTo(m, k, t, vis);
            _rsFlash('Sent to your team', k);
            _rsRender({ force: true });
            return;
        }
        if (k && R.cp) { _rsCpQueueChange(m, k, t, where); return; }
        if (k) { _rsSendChange(m, k, t, { where, aat }); return; }
        // a plain note goes on the part it is about, else the part on stage (every note belongs to a part on a card)
        const comp = (asNote && picked && m.parts.some(p => p.key === picked)) ? picked : m.parts.some(p => p.key === S.step) ? S.step : (m.parts[0] || { key: 'video' }).key;
        _rsSendNoteTo(m, comp, t, vis);
        _rsRender({ force: true });
    }
    function _rsStartEdit(k, text) {
        const S = R.S;
        const m = _rsCur(), key = m && m.id + '|' + k;
        const draft = key ? _rsEditDraftRead(key) : undefined;
        if (key && (draft === undefined || S.editBase[key] === undefined)) S.editBase[key] = text || '';
        S.note.part = null; S.note.where = 'chat'; S.editing = k; S.editText = draft !== undefined ? draft : text || '';
        _rsRender({ force: true });
        const t = _rsQ('capTa'); if (t) { t.focus({ preventScroll: true }); t.setSelectionRange(t.value.length, t.value.length); }
    }
    function _rsSaveEdit(m, k) {
        const S = R.S, t = String(S.editText || '').trim(), before = k === 'title' ? m.ytitle : m.caption;
        const key = m.id + '|' + k;
        if (S.editSaving[key]) return;
        if (R.mode === 'client') {
            const fresh = _rsModelById(m.id), part = fresh && fresh.parts.find(x => x.key === k), latest = fresh && String(fresh.caption || '');
            if (!fresh || fresh.gone || !part || part.st !== 'wait') {
                showNotify('Your edit was not saved', 'This part was already answered and is no longer waiting for an edit. Your words are kept in the editor; you can copy them into a note to your team.');
                return;
            }
            if (k === 'caption' && latest !== String(S.editBase[key] || '')) {
                showConfirm('The caption changed while you were editing', 'Your words are still in the editor. The current caption is:\n\n' + latest + '\n\nReplace it with your words?', () => {
                    if (R.S !== S || S.curId !== m.id) return;
                    S.editBase[key] = latest;
                    _rsSaveEdit(fresh, k);
                }, 'Replace caption');
                return;
            }
        }
        _rsEditDraftPut(key, S.editText);
        S.editing = '';
        if (!t || t === before.trim()) { _rsEditDiscard(key); _rsRender({ force: true }); return; }
        if (R.mode === 'client' && k === 'title') {
            // A client link never renames a card (the YouTube title is the card's name, and a rename moves the
            // Production work items with it), so a title edit still goes to the team as a change request.
            _rsEditDraftDrop(key);   // the change request keeps its own words (retryText) if it is refused
            _rsSendChange(m, k, 'Please use this title:\n\n' + t, { where: 'stage' });
            return;
        }
        if (R.mode === 'client') {
            // The client's caption edit changes the caption itself (owner, 2026-10-17), and a plain note on the
            // caption tells the team, with the old caption, so the SMM can see it and put it back. It never asks for
            // a change. Since 2026-10-18 (session Onward) the sent edit is also the client's answer for the caption
            // step: once it is stored the caption is approved, once, the way the Approve button does it, and the stage
            // moves on. A save that fails approves nothing, moves nowhere and puts the words back in the edit box.
            // The note goes only once the caption is stored, so it never tells of a change that did not save.
            const old = String(m.caption || '');
            if (S.capSending[m.id + '|' + k]) return;
            S.capSending[m.id + '|' + k] = true;
            delete S.editErrors[key]; S.saved = null;
            S.editSaving[key] = true;
            const save = window._calClientReviewCaptionEdit ? window._calClientReviewCaptionEdit(m.id, t) : Promise.resolve(false);
            if (!R.cp) _rsFlash('Saving the caption…', k);
            _rsRender({ force: true });
            save.then(ok => {
                delete S.capSending[m.id + '|' + k];
                delete S.editSaving[key];
                if (!ok) {
                    S.editErrors[key] = 'The caption did not save. Your words are kept in the editor. Please try again.';
                    if (R.S === S && S.curId === m.id && !S.editing) { S.editing = k; S.editText = S.editDrafts[key]; }
                    _rsFlash('The caption did not save. Your words are kept in the editor. Please try again.', k, m.id); _rsRender({ force: true }); return;
                }
                if (R.S === S && String(S.editDrafts[key] || '').trim() === t) _rsEditDraftDrop(key);
                _calReviewState.drafts[m.id + '|' + k] = _rsEditNote(t, old);
                window._calReviewComment(m.id, k);
                _rsFlash('Caption changed, your team can see it', k, m.id, true);
                _rsRender({ force: true });
                // The note's own card save marks the part as saving and the approve is dropped while it runs, so the
                // approve goes the moment the note's save has ended (it is one save at a time on a part).
                const t0 = Date.now(), pkey = m.id + '|' + k;
                const approve = () => {
                    if (R.S !== S) return;
                    if (_calReviewState.saving[pkey] && Date.now() - t0 < RS_PRE_MS) { setTimeout(approve, 40); return; }
                    const cur = _rsModelById(m.id);
                    const x = cur && cur.parts.find(p => p.key === k);
                    if (x && x.st === 'wait') _rsApprove(cur, k, '');
                };
                approve();
            });
            return;
        }
        window._calOnFieldBlur({ dataset: { pid: m.id, fld: k === 'title' ? 'name' : 'caption' }, value: t });
        _rsEditDraftDrop(key);
        _rsFlash(RS_PART[k] + ' saved', k);
        _rsRender({ force: true });
    }
    /* Words typed on a post and not sent wait for that post while another is open. Client links also persist them
       in browser storage; staff stage drafts stay within their mounted session. */
    function _rsStashDraft() {
        const S = R.S;
        if (!S || !S.curId) return;
        if (String(S.note.text || '').trim()) { S.drafts[S.curId] = { text: S.note.text, part: S.note.part, vis: S.note.vis, was: S.note.was, aat: S.note.aat, at: Date.now() }; _rsDraftPut(S.curId, S.drafts[S.curId]); }
        else _rsDraftDrop(S.curId);
    }
    function _rsRestoreDraft(m) {
        const S = R.S, d = m ? S.drafts[m.id] : null;
        if (!d) return;
        delete S.drafts[m.id];
        S.note.text = d.text; S.note.vis = d.vis;
        // The words keep the part they were about and the status that part had when they were picked for it, so a
        // "Change my mind" note stays on its approved part, and a part answered elsewhere meanwhile takes the words as
        // a late note on that part (_rsSendNote), never as a request on whatever step is on stage (Codex on PR 2214).
        const px = d.part ? m.parts.find(p => p.key === d.part) : null;
        if (px) { S.note.part = d.part; S.note.where = 'chat'; S.note.was = d.was || px.st; S.note.aat = !!d.aat; }
    }
    function _rsGo(id) {
        const all = _rsAll();
        const m = all.find(x => x.id === id);
        if (!m) return;
        _rsSwap(() => {
            _rsStashDraft();
            Object.assign(R.S, { curId: id, note: _rsBlankNote(), editing: '', fold: false, saved: null, menu: '', moved: null });
            R.S.step = _rsFirstStep(m);
            _rsRestoreDraft(m);
        });
    }
    // Leave a post answered elsewhere without saving anything: the next post in the list, or the recap.
    function _rsMoveOn(m) {
        const q = _rsQueue().filter(x => x.id !== m.id);
        const nxt = q[0] || null;
        const go = () => { _rsStashDraft(); R.S.curId = nxt ? nxt.id : null; R.S.step = nxt ? _rsFirstStep(nxt) : ''; R.S.note = _rsBlankNote(); R.S.editing = ''; R.S.keepK = null; R.S.moved = null; _rsRestoreDraft(nxt); };
        if (nxt) _rsSwap(go); else { go(); _rsRender({ force: true }); }
    }
    function _rsFinish() {
        const m = _rsCur();
        if (!m || _rsWaiting(m).length) return;
        if (R.mode !== 'smm' && Object.keys(RS_PART).some(k => _rsSaving(m, k))) return;
        const q = _rsQueue(), i = q.findIndex(x => x.id === m.id);
        let msg;
        if (R.mode === 'kasper') {
            const back = m.parts.some(x => x.st === 'chg' || (x.st === 'ok' && x.dec === 'aat'));
            if (m.sample) window._sxrKasperDismiss(m.id); else window._kasperDismiss(m.id);
            msg = back ? 'Sent to the editors' : 'Approved, sent to the client';
        } else {
            R.S.finished.add(m.id);
            msg = R.mode === 'client' ? 'Done. Your team has “' + m.title + '”' : 'Done with “' + m.title + '”';
        }
        const rest = _rsQueue().filter(x => x.id !== m.id);
        const nxt = rest[Math.min(Math.max(i, 0), rest.length - 1)] || null;
        const go = () => {
            _rsStashDraft();
            R.S.curId = nxt ? nxt.id : null;
            R.S.step = nxt ? _rsFirstStep(nxt) : '';
            R.S.note = _rsBlankNote(); R.S.editing = ''; R.S.moved = null;
            _rsRestoreDraft(nxt);
        };
        if (nxt) _rsSwap(go); else { go(); _rsRender({ force: true }); }
        _rsToast(msg + (nxt ? '. Next up: ' + nxt.title : ''), R.mode !== 'kasper' ? m.id : '');
    }
    let _rsTT = null;
    function _rsToast(msg, reopenId) {
        let t = R.root.getElementById('rsToast');
        if (!t) { t = document.createElement('div'); t.id = 'rsToast'; t.className = 'toast'; t.setAttribute('role', 'status'); R.root.querySelector('.rs').appendChild(t); }
        t.innerHTML = '<span class="tk">' + RI.check + '</span><span class="tx">' + _re(msg) + '</span>' + (reopenId ? '<button type="button" id="toastUndo">Undo</button>' : '');
        const u = R.root.getElementById('toastUndo');
        if (u) u.addEventListener('click', () => { R.S.finished.delete(reopenId); t.classList.remove('on'); _rsGo(reopenId); });
        clearTimeout(_rsTT);
        requestAnimationFrame(() => t.classList.add('on'));
        _rsTT = setTimeout(() => t.classList.remove('on'), 6000);
    }
    function _rsKeys(e) {
        const tag = (e.target && e.target.tagName || '').toLowerCase();
        if (e.key === 'Escape') {
            if (R.S.qOpen) { _rsQueueClose(); const bb = _rsQ('qBtn'); if (bb) bb.focus({ preventScroll: true }); return; }
            if (R.S.menu) { R.S.menu = ''; _rsDecide(); }
            else if (R.S.note.part) _rsClearChange(false, R.S.note.where === 'stage');
            else if (R.S.editing) { _rsEditDiscard(R.S.curId + '|' + R.S.editing); _rsRender({ force: true }); }   // Escape anywhere discards the typed edit, as Cancel does
            return;
        }
        if (R.l2) {
            // Kasper's second layout has no steps: Up and Down move through the list on the left.
            if (!e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey && e.target.closest && e.target.closest('#qlList')) _rsL2ListKey(e);
            return;
        }
        if (tag === 'textarea' || tag === 'input' || (e.target.closest && e.target.closest('.fv-player'))) return;
        const m = _rsCur(); if (!m) return;
        const keys = m.parts.map(x => x.key), i = keys.indexOf(R.S.step);
        if (e.key === 'ArrowRight' && i < keys.length - 1) { _rsSetStep(keys[i + 1]); e.preventDefault(); }
        if (e.key === 'ArrowLeft' && i > 0) { _rsSetStep(keys[i - 1]); e.preventDefault(); }
    }
    /* ---------- Kasper's second layout (session Easel, 2026-10-20) ----------
       Behind review_stage_kasper_layout2 (188), wide screens only. Everything that SAVES is the code above, unchanged:
       the same buttons, handlers, notes, undo and reload notice. Only what is drawn differs:
         - the strip and the "Waiting for your review" dropdown become one always-visible list on the left;
         - every part of the card is on stage at once (video, thumbnail, caption), each with its own buttons;
         - a vertical video puts the parts side by side, a wide one puts the video on top and the other parts below;
         - Finish reviewing and Close card sit at the top right of the card, not in a row of their own. */
    /* A part Kasper approves leaves the card's list of parts (the old page's step bar loses it too). With every part on
       stage that would pull the picture out from under him, so this layout keeps each part it has shown for this card:
       an approved one stays, read only, marked Approved, and Finish reviewing counts it. */
    const RS_L2_ORDER = ['video', 'graphic', 'caption', 'title'];
    function _rsL2Model(m) {
        const S = R.S, seen = S.l2 || (S.l2 = {}), rec = seen[m.id] || (seen[m.id] = []);
        m.parts.forEach(x => { if (rec.indexOf(x.key) < 0) rec.push(x.key); });
        const keys = rec.slice().sort((a, b) => RS_L2_ORDER.indexOf(a) - RS_L2_ORDER.indexOf(b));
        // A part the model no longer returns is shown as what the card says it is: approved only if it really moved
        // past Kasper, its true state if someone sent it to tweaks; one that is neither (media removed while at
        // Kasper Approval) is dropped, so it is neither marked Approved nor counted as answered.
        const parts = [];
        keys.forEach(k => {
            const live = m.parts.find(p => p.key === k);
            if (live) { parts.push(live); return; }
            const s = _calNormStatus((m.post && m.post[k + '_status']) || '');
            if (s === 'Client Approval' || s === 'Approved' || s === 'Scheduled' || s === 'Posted') parts.push({ key: k, st: 'ok', kept: true });
            else if (s === 'Tweaks Needed') {
                const aat = _rsCsv(m.post.kasper_approved_after_tweaks).has(k);
                parts.push(aat ? { key: k, st: 'ok', dec: 'aat', kept: true } : { key: k, st: 'chg', frame: _rsLastTweakIsFrame(m.post, k, m.item), kept: true });
            }
        });
        return Object.assign({}, m, { parts });
    }
    function _rsL2M() { const m = _rsCur(); return m ? _rsL2Model(m) : null; }
    function _rsL2Wanted() {
        let wide = false;
        try { wide = !!window.matchMedia && window.matchMedia('(min-width:' + RS_L2_MIN + 'px)').matches; } catch (e) { wide = false; }
        return wide && svRsKasperLayout2On();
    }
    // The list: urgent, then waiting (the count at the top is these two), then the cards with the editors.
    function _rsL2Row(m, cur) {
        const on = cur && m.id === cur.id;
        const urg = m.sec === 'urgent';
        const head = m.sec === 'tweaks' ? _rsKRowHead(m) : '<span class="cn">' + _re(m.title) + '</span>';
        const meta = m.sec === 'tweaks' ? _rsKRowMeta(m)
            : '<span class="cm' + (urg ? ' urg' : '') + '">' + (urg ? '<span class="ub" title="' + _re(m.flag) + '">' + RI.bell + '</span>' : '') + '<span>' + _re(m.client) + '</span>' + (m.sample ? '<b class="tag">Sample</b>' : '') + _rsDots(m) + '</span>';
        return '<button class="chipp k ql-r' + (on ? ' cur' : '') + (urg ? ' urgc' : '') + (m.sec === 'tweaks' ? ' edc' : '') + '" type="button" data-id="' + _re(m.id) + '" tabindex="' + (on ? '0' : '-1') + '" aria-current="' + !!on + '" title="' + _re(m.client + ': ' + m.title) + '">' + _rsChipImg(m) + '<span class="cx">' + head + meta + '</span></button>';
    }
    // The bell on a card with the editors: the same urgent ping the held card's "Ping editor" sends (_rsPingHtml), shown
    // only where that ping can go (the video is at Tweaks Needed and has an editor to reach).
    function _rsL2CanPing(m) { try { return m.sec === 'tweaks' && !!_calShowUrgent(m.post, 'video'); } catch (e) { return false; } }
    /* The bell. The dispatcher reports through the button it is given (Sending..., Sent, Queued, back to URGENT on a refusal;
       it leaves the button alone when the confirmation is cancelled), so it is given a button of its own that is never
       on screen, and the bell follows what that button ends up saying: a cancel or a refusal leaves the bell ready to be
       pressed again, and only a real send turns it into Editor pinged. The bell itself is not replaced while it works. */
    function _rsL2Ping(m, e) {
        if (!m || (R.S.pinging && R.S.pinging[m.id])) return;
        const proxy = document.createElement('button');
        proxy.type = 'button'; proxy.textContent = 'URGENT';
        const id = m.id;
        const sync = () => {
            const st = R.S.pinging || (R.S.pinging = {});
            if (proxy.dataset.urgentSent === '1') {
                R.S.pinged[id] = true; delete st[id]; obs.disconnect();
            } else if (proxy.disabled) st[id] = proxy.textContent || 'Sending…';
            else delete st[id];
            if (R.host && !R.host.hidden && R.l2) { _rsL2List(true); const cur = _rsCur(); if (cur && cur.id === id) _rsDecide(); }
        };
        const obs = new MutationObserver(sync);
        obs.observe(proxy, { attributes: true, childList: true, characterData: true, subtree: true });
        const ev = { preventDefault() {}, stopPropagation() {}, currentTarget: proxy };
        if (m.sample) window._sxrKasperSendUrgentSlack(ev, id); else window._kasperSendUrgentSlack(ev, id);
    }
    function _rsL2EdRow(m, cur) {
        const row = _rsL2Row(m, cur);
        if (!_rsL2CanPing(m)) return row;
        const sent = !!R.S.pinged[m.id], work = !sent && R.S.pinging && R.S.pinging[m.id];
        return '<div class="edw">' + row.replace('class="chipp k', 'class="chipp k hb')
            + '<button class="edping' + (sent ? ' sent' : work ? ' busy' : '') + '" type="button" data-ping="' + _re(m.id) + '"' + (sent || work ? ' disabled' : '') + (work ? ' aria-busy="true"' : '') + ' aria-label="' + (sent ? 'Editor pinged about ' : 'Ping the editor about ') + _re(m.title) + '" title="' + (sent ? 'Editor pinged' : work ? _re(work) : 'Ping the editor for urgent tweaks') + '">' + (sent ? RI.check : RI.bell) + '</button></div>';
    }
    // `still`: the list is drawn again for a reason that is not a different card (opening or closing With the editors):
    // it must not move, so the current card is not scrolled back into view and the toggle keeps its place on screen.
    function _rsL2List(still) {
        const ql = _rsQ('ql'), list = _rsQ('qlList'), head = _rsQ('qlHead');
        if (!ql || !list || !head) return;
        const cur = _rsCur(), k = _rsKasperModels();
        const open = k.urgent.length + k.waiting.length;
        _rsPut(head, '<b class="num">' + open + '</b> <span>' + (open === 1 ? 'card to review' : 'cards to review') + '</span>');
        const a = R.root.activeElement;
        const hadFocus = !!(a && a.closest && a.closest('#qlList'));
        const keep = list.scrollTop;
        const tg0 = _rsQ('edTog'), tgTop0 = tg0 ? tg0.getBoundingClientRect().top : 0;
        const rows = k.urgent.concat(k.waiting).map(m => _rsL2Row(m, cur)).join('');
        const eds = k.tweaks.length
            ? '<button class="ql-g" type="button" id="edTog" aria-expanded="' + !!R.S.edOpen + '"><span class="r">With the editors <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></span><span class="c num">' + k.tweaks.length + ' tweaks pending</span></button>'
                + (R.S.edOpen || (cur && cur.sec === 'tweaks') ? k.tweaks.map(m => _rsL2EdRow(m, cur)).join('') : '')
            : '';
        const added = _rsPatch(list, (rows || (k.tweaks.length ? '' : '<div class="ql-empty">Nothing is waiting on you.</div>')) + eds);
        if (added.changed) {
            list.scrollTop = keep;
            _rsEachIn(added, '[data-id]', b => b.addEventListener('click', () => _rsGo(b.dataset.id)));
            // The model is looked up when the bell is pressed, not when the row was drawn: a row that stays across refreshes keeps its handler.
            _rsEachIn(added, '[data-ping]', b => b.addEventListener('click', (e) => _rsL2Ping(_rsKasperModels().tweaks.find(x => x.id === b.dataset.ping), e)));
            _rsEachIn(added, '#edTog', t => t.addEventListener('click', () => { R.S.edOpen = !R.S.edOpen; _rsL2List(true); }));
            const t = _rsQ('edTog');
            if (still && t && tg0) list.scrollTop = keep + (t.getBoundingClientRect().top - tgTop0);
            // The row that had the keyboard keeps it when the list is drawn again (the card changed under it).
            if (hadFocus && !(R.root.activeElement && R.root.activeElement.closest && R.root.activeElement.closest('#qlList'))) { const c = list.querySelector('[data-id][aria-current="true"]') || list.querySelector('[data-id]'); if (c) c.focus({ preventScroll: true }); }
        }
        const c = list.querySelector('[aria-current="true"]');
        // Brought into view only when the card on stage is a different one (or the first draw): a refresh that finds the
        // same card on stage must not pull a list the person scrolled back to it.
        const curId = cur ? cur.id : null, moved = R.listCur !== curId;
        if (!still) R.listCur = curId;
        if (c && !still && moved) {
            const t = c.offsetTop - list.offsetTop, b = t + c.offsetHeight;
            if (t < list.scrollTop + 4) list.scrollTop = Math.max(0, t - 8);
            else if (b > list.scrollTop + list.clientHeight - 4) list.scrollTop = b - list.clientHeight + 8;
        }
    }
    // Up and Down in the list open the card above or below; Home and End the first and the last.
    function _rsL2ListKey(e) {
        const rows = Array.from(R.root.querySelectorAll('#qlList [data-id]'));
        const at = rows.indexOf(e.target.closest('[data-id]'));
        if (!rows.length) return false;
        let to = -1;
        if (e.key === 'ArrowDown') to = at < 0 ? 0 : Math.min(rows.length - 1, at + 1);
        else if (e.key === 'ArrowUp') to = at < 0 ? 0 : Math.max(0, at - 1);
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = rows.length - 1;
        else return false;
        e.preventDefault();
        const b = rows[to];
        if (b && at !== to) { b.focus({ preventScroll: false }); _rsGo(b.dataset.id); }
        return true;
    }
    // One pane per part. Built once per post and set of parts, so the player is never torn down by a redraw.
    function _rsL2Skel(m) {
        let other = 0;
        return m.parts.map((x, i) => {
            const k = x.key, kind = _rsKind(k);
            if (kind !== 'video') other++;
            const inner = kind === 'video'
                ? '<div class="rs-fv" id="fvHost"></div><div class="player rs-novid" id="novid"><img class="poster" id="poster" alt=""><div class="vignette"></div><span class="mpill" style="--pc:var(--pd-video)"><i></i>Video</span><div class="nv" id="novidMsg"></div></div>'
                : kind === 'thumb'
                    ? '<div class="bigthumb" id="bigthumb"><img id="bigthumbImg" alt="The thumbnail at full size"><span class="mpill" style="--pc:var(--pd-thumbnail)"><i></i>Thumbnail</span><div class="tframe" id="tframe" hidden></div></div>'
                    : '<div class="tcard" id="tcard-' + k + '"></div>';
            return '<section class="pn pn-' + kind + '" data-part="' + k + '" style="' + _rsPv(k) + ';--c:' + (i + 1) + ';--o:' + (kind === 'video' ? 1 : other) + '" aria-label="' + RS_PART[k] + '"><div class="pn-m view k-' + kind + '"' + (kind === 'video' ? ' id="view"' : '') + '><div class="mbox">' + inner + '</div></div><div class="pn-d" data-pd="' + k + '"></div></section>';
        }).join('');
    }
    // Portrait video: the parts side by side. Landscape: the video across the top, the others below it. The video's own
    // shape decides once it is known (its player, or its poster), then the thumbnail's; until then a vertical card,
    // unless it is a YouTube card (wide by nature).
    function _rsL2Orient() {
        const g = _rsQ('l2g'), m = _rsL2M();
        if (!g || !m) return;
        let ar = 0;
        const host = _rsQ('fvHost');
        if (host && host.firstElementChild) { const v = parseFloat(host.style.getPropertyValue('--fv-ar')); if (v > 0) ar = v; }
        const img = id => { const i = _rsQ(id); return i && !i.hidden && i.getAttribute('src') && i.naturalWidth ? i.naturalWidth / i.naturalHeight : 0; };
        if (!ar) ar = img('poster');
        if (!ar) ar = img('bigthumbImg');
        const hasVideo = m.parts.some(x => x.key === 'video');
        const land = hasVideo && (ar ? ar > 1.05 : !!m.land);
        const was = g.className;
        g.classList.toggle('l2-land', land);
        g.classList.toggle('l2-port', !land);
        // The grid: one column per part (the video's a little wider) when side by side; otherwise one column per part
        // below the video. Each part's picture sits in the first row and its buttons in the row under it, so the
        // buttons of the parts line up whatever each one needs.
        g.style.setProperty('--l2c', String(Math.max(1, m.parts.length - 1)));
        g.style.setProperty('--l2cols', m.parts.map(x => x.key === 'video' ? 'minmax(0,1.35fr)' : 'minmax(0,1fr)').join(' '));
        if (g.className !== was) _rsFit();   // the picture's box changed shape: size the player to it
    }
    function _rsFvDblClick(fvh) {
        fvh.addEventListener('dblclick', (e) => {
            if (e.target.closest('.fv-controls,.fv-stage-foot,button,a,input,.fv-trouble,.fv-state')) return;
            const fb = fvh.querySelector('.fv-full');
            if (!fb) return;
            e.preventDefault();
            fb.click();
        });
    }
    function _rsL2Panes(m) {
        const g = _rsQ('l2g');
        const sig = m.id + '|' + m.parts.map(x => x.key).join(',');
        if (g.__rsSig !== sig) {
            _rsStageOff();
            g.__rsSig = sig;
            g.innerHTML = _rsL2Skel(m);
            const fvh = _rsQ('fvHost');
            if (fvh) {
                _rsFvDblClick(fvh);
                if (R.mo2) R.mo2.disconnect();
                R.mo2 = new MutationObserver(() => _rsL2Orient());
                R.mo2.observe(fvh, { attributes: true, attributeFilter: ['data-orient', 'style'] });
            }
            const v = _rsQ('view');
            if (v && R.ro) R.ro.observe(v);
            ['poster', 'bigthumbImg'].forEach(id => { const i = _rsQ(id); if (i) i.addEventListener('load', _rsL2Orient); });
        }
        if (m.parts.some(x => x.key === 'video')) _rsMediaVideo(m, _rsQ('view'), _rsQ('fvHost'));
        if (m.parts.some(x => x.key === 'graphic')) _rsMediaThumb(m);
        m.parts.forEach(x => { if (_rsKind(x.key) === 'text') _rsL2Text(m, x); });
        _rsL2Orient();
    }
    function _rsL2Text(m, x) {
        const S = R.S, k = x.key, tc = _rsQ('tcard-' + k);
        if (!tc) return;
        const yt = k === 'title';
        const fold = x.st === 'ok' && !yt;
        const open = !!S.exp[m.id + k];
        const text = yt ? m.ytitle : m.caption;
        let body;
        if (yt) body = '<div class="tc-yt"><div class="ytimg">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</div><div class="ytx"><div class="ytt">' + _re(text) + '</div><div class="ytm">' + _re(m.client) + '</div></div></div>';
        else body = '<div class="tc-text' + (fold && !open ? ' clamp' : '') + '">' + (text ? _re(text) : '<span style="color:var(--text-secondary)">No caption yet.</span>') + '</div>';
        const foot = fold
            ? '<div class="tc-foot num"><button class="expand" type="button" data-exp="' + k + '" aria-expanded="' + open + '">' + RI.down + (open ? 'Collapse' : 'Expand the caption') + '</button><span>' + text.length + ' characters</span></div>'
            : '<div class="tc-foot num">' + text.length + ' characters</div>';
        const html = yt ? body : '<div class="tc-main"><span class="tc-lbl" style="' + _rsPv(k) + '">' + _rsDot(k) + 'Caption</span>' + body + '</div>' + foot;
        tc.className = yt ? 'tcard' : 'tcard wc';
        if (!_rsPut(tc, html)) return;
        const xb = tc.querySelector('[data-exp]');
        if (xb) xb.addEventListener('click', () => { S.exp[m.id + k] = !S.exp[m.id + k]; _rsL2Text(m, x); });
    }
    /* Undo after Approve (owner request 2026-10-20). The old page's Undo is the toast the approve itself raises (330 and
       290: "Video approved, sent to client" with Undo, six seconds, restoring the snapshot the approve took, in the
       sheet too). In this layout the toast sits where the buttons now are and the card is redrawn under it, so the same
       Undo is also drawn on the approved part's row. It is that toast's own button that is pressed: one action, one
       time window, and it is shown only while the toast's button is on screen. */
    const RS_UNDO_GIVE_UP = 5000;
    let _rsUndoTick = 0;
    // The toast raised by THIS approve (330 and 290 register it by card and part): never whichever toast is current, so
    // approving a second part inside the first one's six seconds cannot give the second part's Undo the first one's action.
    function _rsUndoToast(u) {
        const el = (window._svUndoToasts || {})[u.id + '|' + u.key];
        return el && el !== u.old && el.isConnected && el.querySelector('.sv-toast-action') ? el : null;
    }
    function _rsL2UndoArm(id, key) {
        const old = (window._svUndoToasts || {})[id + '|' + key] || null;   // an earlier approve of this very part (undone, then approved again)
        R.S.undo = { id, key, at: Date.now(), seen: false, old, el: null };
        clearInterval(_rsUndoTick);
        _rsUndoTick = setInterval(() => {
            const u = R.S && R.S.undo;
            if (!u || !R.host || R.host.hidden) { clearInterval(_rsUndoTick); return; }
            const el = _rsUndoToast(u);
            if (el && !u.seen) { u.seen = true; u.el = el; _rsDecide(); }
            else if (!el && (u.seen || Date.now() - u.at > RS_UNDO_GIVE_UP)) { R.S.undo = null; clearInterval(_rsUndoTick); _rsDecide(); }
        }, 250);
    }
    function _rsL2UndoHtml(m, x) {
        const u = R.S.undo;
        return u && u.seen && u.id === m.id && u.key === x.key && R.mode === 'kasper'
            ? '<button class="b-undo" type="button" data-undo="' + x.key + '" aria-label="Undo approving the ' + _rsLname(x.key) + '">' + RI.back + 'Undo</button>' : '';
    }
    function _rsL2BindUndo(el) {
        el.querySelectorAll('[data-undo]').forEach(b => b.addEventListener('click', () => {
            const u = R.S.undo, t = u && u.el && u.el.isConnected ? u.el.querySelector('.sv-toast-action') : null;
            R.S.undo = null; clearInterval(_rsUndoTick);
            if (t) t.click();
            _rsDecide();
        }));
    }
    function _rsL2Decide() {
        const m = _rsL2M(), g = _rsQ('l2g');
        if (!m || !g) return;
