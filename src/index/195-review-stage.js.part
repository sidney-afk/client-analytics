       status, and Finish reviewing with Close card. Each returns what the old row drew, unchanged. */
    function _rsInactiveD(m, x) {
        return x.st === 'ok'
            ? '<span class="dst ok"><span class="ck">' + RI.check + '</span>Approved</span>'
            : '<span class="dst chg"><span class="ck chg">' + (x.frame ? RI.frame : RI.back) + '</span>' + (x.frame ? 'Tweaks are on Frame' : 'Change asked') + '</span>' + (x.frame && m.post.asset_url ? '<a class="rlink" href="' + _re(m.post.asset_url) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Your notes in Frame.io</a>' : '');
    }
    function _rsPingHtml(m) {
        const canPing = (() => { try { return _calShowUrgent(m.post, 'video'); } catch (e) { return false; } })();
        const pg = R.S.pinged[m.id];
        return canPing ? (pg ? '<span class="b-soft sent">' + RI.check + 'Editor pinged</span>' : '<button class="b-soft" type="button" id="pingBtn">' + RI.bell + 'Ping editor</button>') : '';
    }
    function _rsBindPing(m, root) {
        const pb = root.querySelector('#pingBtn');
        if (pb) pb.addEventListener('click', (e) => { R.S.pinged[m.id] = true; if (m.sample) window._sxrKasperSendUrgentSlack(e, m.id); else window._kasperSendUrgentSlack(e, m.id); _rsDecide(); });
    }
    // The active part's row: `d` is its buttons or its status (null: the change box takes its place), `dc` the status colour.
    function _rsActiveD(m, x) {
        const S = R.S, n = _rsLname(x.key);
        let d;
        const saving = _rsSaving(m, x.key);
        const ck = m.id + '|' + x.key;
        if (R.cp && !saving && x.st === 'ok' && S.pressed[ck] === 'ok' && !_rsError(m, x.key)) _rsCpLanded(ck);
        const cpOk = R.cp && S.cpOk[ck] && x.st === 'ok' && Date.now() - S.cpOk[ck] < RS_CP_CHECK_MS ? S.cpOk[ck] : 0;
        if (S.editing === x.key) d = '<span class="dst busy">' + RI.pen + 'Editing the ' + n + '</span>';
        else if (cpOk && !_rsWriting(x)) d = _rsCpMorph(x, cpOk);
        else if (_rsWriting(x) && S.note.where === 'stage') d = null;
        // Polish: once a change went and the box is empty again, the part shows its answer, not "Writing a change".
        else if (_rsWriting(x) && !(R.cp && S.cpSent[m.id + '|' + x.key] && !String(S.note.text || '').trim())) d = '<span class="dst wr">' + RI.pen + 'Writing a change to the ' + n + ' in the conversation</span>';
        // The pressed button names its result only while the save is the one that button started. A note or an edit
        // saving on a waiting part leaves the buttons as they were (waiting, disabled), never reading "Approved"
        // (review of #2235); on a part already answered, the answer shows.
        else if (saving && (S.pressed[m.id + '|' + x.key] || x.st === 'wait')) d = _rsActions(x, S.pressed[m.id + '|' + x.key] || 'wait');
        else if (x.st === 'ok' && R.mode === 'smm') d = '<span class="dst ok"><span class="ck' + (x.route === 'client' ? ' tocl' : '') + '">' + (x.route === 'client' ? RI.skip : RI.check) + '</span>Approved to ' + (x.route === 'client' ? 'client' : 'Kasper') + '</span><button class="qlink o" type="button" data-again="' + x.key + '">Change my mind</button>';
        else if (x.st === 'ok') d = '<span class="dst ok"><span class="ck">' + (x.dec === 'aat' ? RI.aat : RI.check) + '</span>' + (x.dec === 'aat' ? 'Approved after tweaks' : 'Approved') + (x.when ? ' <span class="when">' + _re(_rsWhen(x.when)) + '</span>' : '') + '</span><button class="qlink o" type="button" data-again="' + x.key + '">Change my mind</button>';
        else if (x.st === 'chg' && x.frame) d = '<span class="dst chg"><span class="ck chg">' + RI.frame + '</span>Tweaks are on Frame</span>' + (m.post.asset_url ? '<a class="rlink" href="' + _re(m.post.asset_url) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Your notes in Frame.io</a>' : '');
        else if (x.st === 'chg') {
