            return a && at && Number(a.at) >= at ? String(a.text || 'The save was refused.') : '';
        }
        if (R.mode === 'kasper') { const it = m.item; return it && !m.sample && it._errors && it._errors[k] ? String(it._errors[k]) : ''; }
        return String(_calReviewState.errors[m.id + '|' + k] || '');
    }
    /* Save problems on this post, whichever part is on stage (the stage moves on to the next part while a save
       runs): a refused save says why, with Try again; a save with no answer after a few seconds says so. */
    function _rsSaveIssue(m, k, onStage) {
        const S = R.S;
        const key = m.id + '|' + k, err = _rsError(m, k), editError = S.editErrors[key];
        const who = k === onStage ? '' : RS_PART[k] + ': ';
        if (err) return '<div class="err" role="alert" data-err="' + k + '"><div>' + _re(who + 'Not saved. ' + (R.mode === 'client' ? _rsClientWords(err) : err) + (R.cp && S.cpBack[key] ? ' Your next words are back in the box.' : '')) + (!editError && S.retryText[key] ? '<details><summary>Your unsent words</summary><div class="tc-text">' + _re(S.retryText[key]) + '</div></details>' : '') + '</div>' + (!editError && S.retry[key] ? '<button class="retry" type="button" data-retry="' + k + '">Try again</button>' : '') + '</div>';
        if (S.slow[key] && _rsSaving(m, k)) return '<div class="err slow" role="status" data-slow="' + k + '">' + _re(who) + 'Still waiting for the server. Nothing is lost: it finishes here on its own.</div>';
        return '';
    }
    // A refusal in a client's words. With the polish on, a sentence written for the team (a code, "send this to the
    // owner") reads as one plain line instead; the full reason is still in the server's refusal report.
    const RS_CP_TECH = /\bcode\b|native|owner|recogni[sz]e|HTTP|Linear|gateway|deliverable|\b\d{3}\b/i;
    function _rsClientWords(err) {
        const w = _calCrqClientWords(err);
        return R.cp && !w.whole && RS_CP_TECH.test(w.text) ? 'Something went wrong on our side, so nothing changed. Please try again.' : w.text;
    }
    function _rsSaveIssues(m, onStage) {
        return m.parts.map(p => _rsSaveIssue(m, p.key, onStage)).join('');
    }
    // A small spinner in place of a button's icon while its save runs (owner feedback 2026-10-17: no "Saving..." text).
    const RS_SPIN = '<span class="spin" aria-hidden="true"></span>';
    /* THE CLIENT PAGE'S POLISH (review_client_polish, session Porch, 2026-10-24; R.cp, the client link only).
       Approve morphs into a small spinner the moment it is pressed, turns into a check the moment the save lands, and
       the row then settles into its Approved state; a refused save puts the buttons back with the reason. A sent change
       request keeps its box open and empty on the same part, so the next change can follow; changes sent while one is
       still saving wait their turn here and never replace each other. No "Sending..." text anywhere: one spinner. */
    const RS_CP_CHECK_MS = 650;
    // The page's one spinner. Swap point: when the shared staff spinner (session Beacon) lands, return its markup here.
    function _rsSpinner(label) { return '<span class="cp-spin" role="img" aria-label="' + _re(label || 'Working') + '"></span>'; }
    // The approve button as a circle: a spinner while the save runs, a check once it landed (`ok`: when it landed).
    function _rsCpMorph(x, ok) {
        const n = _rsLname(x.key), w = Math.max(44, Math.min(320, Number(R.S.cpW) || 180));
        const label = ok ? RS_PART[x.key] + ' approved' : 'Approving the ' + n;
        return '<button class="b-ok cp-morph' + (ok ? ' cp-ok' : '') + '" type="button" disabled aria-busy="' + !ok + '" aria-label="' + label + '" style="--cpw:' + w + 'px' + (ok ? ';--cpd:-' + Math.min(RS_CP_CHECK_MS, Date.now() - ok) + 'ms' : '') + '">'
            + (ok ? '<span class="cp-ck" role="img" aria-label="' + label + '">' + RI.check + '</span>' : _rsSpinner(label)) + '</button>';
    }
    // The save of an approval pressed here landed: the check shows for a moment, then the row settles.
    function _rsCpLanded(key) {
        const S = R.S;
        if (!R.cp || S.cpOk[key]) return;
        S.cpOk[key] = Date.now();
        setTimeout(() => { if (R.S === S) _rsRender(); }, RS_CP_CHECK_MS + 20);
    }
    function _rsSplit(x, busy) {
        const k = x.key, n = _rsLname(k), open = !busy && R.S.menu === k;
        // While the save runs the pressed button already says the result (past tense, with its spinner), so the click is answered
        // at once; a refused save puts the part back and says so (speed pass, session Swift).
        const label = busy === 'client' ? 'Approved to client' : busy === 'aat' ? 'Approved after tweaks' : busy === 'ok' ? (R.mode === 'smm' ? 'Approved to Kasper' : 'Approved') : R.mode === 'smm' ? 'Approve to Kasper' : 'Approve the ' + n;
        const alt = R.mode === 'smm' ? ['client', RI.skip + 'Approve to client'] : ['aat', RI.aat + 'Approve after tweaks'];
        const menu = open ? '<div class="apmenu" role="menu"><button role="menuitem" type="button" data-alt="' + alt[0] + '" data-for="' + k + '">' + alt[1] + '</button></div>' : '';
        const on = busy === 'ok' || busy === 'client' || busy === 'aat';
        return '<div class="split' + (open ? ' open' : '') + (on ? ' busy' : '') + '"><button class="b-ok' + (on ? ' busy' : '') + '" type="button" data-ok="' + k + '"' + _rsLblAttr(label) + _rsBusyAttr(busy, on) + '>' + (on ? RS_SPIN : RI.check) + _rsLbl(label, on ? 'Approved' : 'Approve') + '</button><button class="sarr" type="button" data-menu="' + k + '" aria-haspopup="menu" aria-expanded="' + open + '" aria-label="Other ways to approve the ' + n + '" title="' + (R.mode === 'smm' ? 'Approve to client' : 'Approve after tweaks') + '"' + (busy ? ' disabled' : '') + '>' + RI.down + '</button>' + menu + '</div>';
    }
    // In Kasper's all-parts layout a button's label has a long and a short form (the part's column decides which shows,
    // so a label is never on two lines) and the long one is its accessible name.
    function _rsLbl(full, short) { return R.l2 ? '<span class="lf">' + full + '</span><span class="ls" aria-hidden="true">' + short + '</span>' : full; }
    function _rsLblAttr(full) { return R.l2 ? ' aria-label="' + full + '"' : ''; }
    function _rsBusyAttr(busy, on) { return busy ? (on ? ' aria-busy="true"' : '') + ' disabled' : ''; }
    // The decision buttons; with `busy` (what was pressed) the pressed one spins and every one waits.
    function _rsActions(x, busy) {
        const n = _rsLname(x.key);
        if (R.cp && (busy === 'ok' || busy === 'client')) return _rsCpMorph(x, 0);
        const ok = busy === 'ok' || (R.mode === 'client' && busy === 'client');
        const approve = R.mode === 'client' ? '<button class="b-ok' + (ok ? ' busy' : '') + '" type="button" data-ok="' + x.key + '"' + _rsBusyAttr(busy, ok) + '>' + (ok ? RS_SPIN : RI.check) + (ok ? 'Approved' : 'Approve the ' + n) + '</button>' : _rsSplit(x, busy);
        const chg = busy === 'chg', fr = busy === 'frame';
        return approve + '<button class="b-ask' + (chg ? ' busy' : '') + '" type="button"' + (R.l2 ? ' title="Ask for a change"' : '') + ' data-chg="' + x.key + '"' + _rsLblAttr(chg ? 'Change asked' : 'Ask for a change') + _rsBusyAttr(busy, chg) + '>' + (chg ? RS_SPIN : RI.back) + (chg ? _rsLbl('Change asked', 'Asked') : _rsLbl('Ask for a change', 'Ask for change')) + '</button>'
            + (R.mode === 'kasper' && x.key === 'video' ? '<button class="b-frame' + (fr ? ' busy' : '') + '" type="button" data-frame="' + x.key + '"' + _rsBusyAttr(busy, fr) + ' title="Your notes are in Frame.io: sends the change without typing"' + _rsLblAttr('Tweaks are on Frame') + '>' + (fr ? RS_SPIN : RI.frame) + _rsLbl('Tweaks are on Frame', 'Frame tweaks') + '</button>' : '');
    }
    /* The pieces of the decision row, shared by the one-part-at-a-time page and Kasper's all-parts layout (session
