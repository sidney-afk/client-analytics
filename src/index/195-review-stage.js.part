            body = '<div class="cap-edit"><textarea id="capTa" aria-label="Edit the ' + _rsLname(k) + '">' + _re(S.editText) + '</textarea><div class="row"><span class="hint" role="status">' + hint + '</span><div class="btns"><button class="btn-quiet" type="button" id="capCancel">Cancel</button><button class="btn-dark" type="button" id="capSave">' + (R.mode === 'client' ? 'Send to your team' : 'Save') + '</button></div></div></div>';
        } else if (yt) {
            body = '<div class="tc-yt"><div class="ytimg">' + (m.thumb ? '<img alt="" src="' + _re(m.thumb) + '">' : '') + '</div><div class="ytx"><div class="ytt">' + _re(text) + '</div><div class="ytm">' + _re(R.mode === 'kasper' ? m.client : (calState.client || '')) + '</div></div></div>';
        } else {
            body = '<div class="tc-text' + (fold && !open ? ' clamp' : '') + '">' + (text ? _re(text) : '<span style="color:var(--text-secondary)">No caption yet.</span>') + '</div>';
        }
        const chars = editing ? S.editText.length : text.length;
        const foot = fold
            ? '<div class="tc-foot num"><button class="expand" type="button" id="expBtn" aria-expanded="' + open + '">' + RI.down + (open ? 'Collapse' : 'Expand the caption') + '</button><span>' + text.length + ' characters</span></div>'
            : '<div class="tc-foot num">' + chars + ' characters</div>';
