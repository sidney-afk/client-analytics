            _rsQueuePanel();
            if (cur && cur.id === m.id) _rsDecide();
        }));
    }
    function _rsQueueClose() { if (R.S && R.S.qOpen) { R.S.qOpen = false; _rsQueuePanel(); } }
    function _rsSide(m) {
        const d = _rsQ('sdate');
        if (R.mode === 'kasper') {
            // One row (owner feedback 2026-10-17 23:20, session Curtain Seven): "Client · Title", no initials badge; the
            // round ("Back after tweaks, round 3") and an urgent ping sit beside the date at the stage's top left.
            _rsCalm(_rsQ('side'), '<div class="sd-t"><h2>' + (m.client ? _re(m.client) + '<span class="sep"> · </span>' : '') + _re(m.title) + (m.sample ? '<b class="tag">Sample</b>' : '') + '</h2></div>', m);
            const extra = (m.flag ? '<span class="sdn flag">' + RI.bell + _re(m.flag) + '</span>' : '') + (m.note ? '<span class="sdn">' + _re(m.note) + '</span>' : '');
            _rsCalm(d, (m.date ? RI.cal + _re(m.date) : '') + extra, m);
            d.hidden = !m.date && !extra;
            return;
        }
        _rsCalm(_rsQ('side'), '<div class="sd-t"><h2>' + _re(m.title) + '</h2></div>', m);
        _rsCalm(d, m.date ? RI.cal + _re(m.date) : '', m);
        d.hidden = !m.date;
    }
    function _rsWriting(x) { return R.S.note.part === x.key; }
    function _rsStCls(x) { if (_rsWriting(x)) return ' wr'; if (x.st === 'ok') return ' ok'; if (x.st === 'chg' || x.st === 'tweak') return ' chg'; return ''; }
    function _rsStepper(m) {
        const S = R.S;
        const stepHtml = m.parts.map((x, i) => {
            const on = x.key === S.step;
            const mark = x.st === 'ok' && !_rsWriting(x) ? RI.check : (x.st === 'chg' || x.st === 'tweak') && !_rsWriting(x) ? RI.back : _rsWriting(x) ? '' : (i + 1);
            const prev = i ? m.parts[i - 1] : null;
            const sv = S.saved && S.saved.key === x.key && S.saved.pid === m.id && Date.now() - S.saved.t < 2600
                ? '<span class="svd' + (x.st === 'chg' ? ' chg' : '') + '" style="animation-delay:-' + (Date.now() - S.saved.t) + 'ms">' + (x.st === 'chg' ? 'Sent' : 'Saved') + '</span>' : '';
            const label = x.st === 'ok' ? 'approved' : (x.st === 'chg' || x.st === 'tweak') ? 'change asked' : 'waiting for an answer';
            return (i ? '<li class="ln' + (prev.st === 'ok' ? ' ok' : '') + '" aria-hidden="true"></li>' : '')
                + '<li><button class="stp' + (on ? ' on' : '') + _rsStCls(x) + '" type="button" data-step="' + x.key + '" style="' + _rsPv(x.key) + '" aria-current="' + (on ? 'step' : 'false') + '" title="' + RS_PART[x.key] + ', ' + label + '"><span class="sd">' + mark + '</span>' + RS_PART[x.key] + sv + '</button></li>';
        }).join('');
        if (!_rsCalm(_rsQ('stepper'), stepHtml, m)) return;
        _rsQ('stepper').querySelectorAll('[data-step]').forEach(b => b.addEventListener('click', () => _rsSetStep(b.dataset.step)));
    }
    // One soft glow on the next part to answer, the first time the page shows, and never again in this visit.
    function _rsHint(m) {
        R.S.hinted = true;
        const next = m.parts.find(x => x.st === 'wait' && x.key !== R.S.step);
        if (!next) return;
        const b = _rsQ('stepper').querySelector('[data-step="' + next.key + '"]');
        if (b) { b.classList.add('hint'); b.addEventListener('animationend', () => b.classList.remove('hint'), { once: true }); }
    }
    let _rsStageFor = '';
    function _rsStageOff() {
        if (_rsStageFor) { _rsStageFor = ''; try { const h = _rsQ('fvHost'); if (h && h.firstElementChild) svFrameStageUnmount(); } catch (e) {} }
    }
    function _rsMedia(m) {
        const S = R.S, k = _rsKind(S.step), v = _rsQ('view');
        v.className = 'view k-' + k;
        const host = _rsQ('fvHost');
        if (k === 'video') {
            _rsMediaVideo(m, v, host);
        } else {
            if (_rsStageFor) {
                // leave the player loaded (switching back is instant) but stop the sound
                try { const vid = host.querySelector('video'); if (vid && !vid.paused) vid.pause(); } catch (e) {}
            }
        }
        if (k === 'thumb') _rsMediaThumb(m);
    }
    function _rsMediaVideo(m, v, host) {
        v.classList.remove('novid');
        let on = false;
        if (!m.sample) {
            try { on = svFrameStageMount(host, m.post, m.thumb); } catch (e) { on = false; }
        }
        if (on) {
            _rsStageFor = m.id;
            host.hidden = false;
            if (!host.querySelector(':scope > .mpill')) host.insertAdjacentHTML('afterbegin', '<span class="mpill" style="--pc:var(--pd-video)"><i></i>Video</span>');
            _rsFit();
        } else {
            _rsStageOff();
            v.classList.add('novid');
            const nv = _rsQ('novid');
            nv.classList.toggle('land', m.land);
            const img = _rsQ('poster');
            if (m.thumb) { if (img.getAttribute('src') !== m.thumb) img.src = m.thumb; img.hidden = false; } else { img.removeAttribute('src'); img.hidden = true; }
            const url = String(m.post.asset_url || '').trim();
            // Until the player's switch is read (the first second of a first load), the poster alone: the
            // "Watch the video" fallback would show and then give way to the player (owner report 2026-10-18,
            // session Curtain Ten: a huge black play button for the first second).
            let wait = false;
            try { wait = !m.sample && svFrameStagePending(m.post); } catch (e) { wait = false; }
            nv.classList.toggle('wait', wait);
            _rsQ('novidMsg').innerHTML = wait ? '' : /^https?:\/\//i.test(url)
                ? '<span>This video opens in a new tab.</span><a href="' + _re(url) + '" target="_blank" rel="noopener noreferrer">' + RI.play + 'Watch the video</a>'
                : '<span>No video yet.</span>';
        }
    }
    function _rsMediaThumb(m) {
        const bt = _rsQ('bigthumb'), img = _rsQ('bigthumbImg'), tf = _rsQ('tframe');
        bt.classList.toggle('land', m.land);
        // Kasper's second layout draws every part on every redraw: a thumbnail already on screen keeps its own shape.
        if (R.l2 && m.thumb && img.complete && img.naturalWidth && img.getAttribute('src') === m.thumb) bt.classList.toggle('land', img.naturalWidth > img.naturalHeight * 1.05);
        if (m.thumb) {
            tf.hidden = true; img.hidden = false;
            if (img.getAttribute('src') !== m.thumb) {
                img.onload = () => { if (img.naturalWidth) bt.classList.toggle('land', img.naturalWidth > img.naturalHeight * 1.05); };
                img.src = m.thumb;
            }
        } else {
            img.hidden = true; img.removeAttribute('src');
            tf.hidden = false;
            tf.innerHTML = m.tframe ? '<span>The thumbnail is in Frame.io.</span><a href="' + _re(m.tframe) + '" target="_blank" rel="noopener noreferrer">' + RI.ext + 'Open the thumbnail</a>' : '<span>No thumbnail yet.</span>';
        }
    }
    function _rsSetStep(k) {
        const m = _rsCur();
        if (!m || !m.parts.some(x => x.key === k)) return;
        if (R.S.step === k) { _rsRender({ force: true }); return; }
        _rsSwap(() => {
            R.S.step = k; R.S.menu = '';
            if (R.S.editing && R.S.editing !== k) R.S.editing = '';
        });
    }
    /* Change what is on stage: only the media fades (out, the change, back in); everything around it stays put. */
    let _rsSwapT = null;
    function _rsSwap(apply) {
        const v = _rsQ(R.l2 ? 'l2g' : 'view');
        if (!v || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) { apply(); _rsRender({ force: true }); return; }
        if (_rsSwapT) { clearTimeout(_rsSwapT.t); _rsSwapT.apply(); }
        v.classList.add('swap');
        const job = { apply, t: 0 };
        job.t = setTimeout(() => {
            _rsSwapT = null;
            apply();
            _rsRender({ force: true });
            const nv = _rsQ(R.l2 ? 'l2g' : 'view'); if (!nv) return;
            nv.classList.add('swap');
            requestAnimationFrame(() => requestAnimationFrame(() => nv.classList.remove('swap')));
        }, 150);
        _rsSwapT = job;
    }
    function _rsCard(m) {
        const S = R.S, k = S.step, tc = _rsQ('tcard');
        if (_rsKind(k) !== 'text') { tc.innerHTML = ''; return; }
        const x = m.parts.find(p => p.key === k);
        const editing = S.editing === k, yt = k === 'title';
        const canEdit = R.mode !== 'kasper' && _rsActive(m) && x.st === 'wait' && !_rsWriting(x) && !S.editSaving[m.id + '|' + k];
        const head = '<div class="tc-h">' + (canEdit && !editing ? '<button class="b-edit" type="button" id="editBtn">' + RI.pen + 'Edit the ' + _rsLname(k) + '</button>' : '') + '</div>';
