        sl.addEventListener('scroll', _rsStripEdge, { passive: true });
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(_rsStripEdge).observe(sl);
        R.root.addEventListener('keydown', _rsKeys);
        R.root.addEventListener('focusout', () => { if (R.pending) setTimeout(() => { if (R.pending && !_rsTyping()) { R.pending = false; _rsRender(); } }, 0); });
        R.root.addEventListener('click', (e) => { if (R.S.menu && !e.target.closest('.split')) { R.S.menu = ''; _rsDecide(); } });
        if (R.ro) R.ro.disconnect();
        R.ro = new ResizeObserver(() => _rsFit());
