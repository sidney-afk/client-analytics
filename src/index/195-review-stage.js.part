            d = '<span class="dst chg"><span class="ck chg">' + RI.back + '</span>Change asked</span>' + (last ? '<span class="dq" title="' + _re(last.text) + '">' + _re(last.text) + '</span>' : '');
        } else {
            d = _rsActions(x, '');
        }
        const dc = cpOk ? ' cp-checking' : x.st === 'ok' && d && !S.editing && !saving ? ' is-ok' + (R.cp && S.cpOk[ck] ? ' cp-settle' : '') : (x.st === 'chg' || x.st === 'tweak') && d && !S.editing && !saving ? ' is-chg' : '';
        return { d, dc, saving };
    }
    // Finish reviewing and Close card. On the client link Finish stays off, with a short "Saving…", while any part's
    // answer is still being sent: it lights up when the save lands or fails (an answer is never lost to a quick Finish
    // and a closed tab).
    // What Close card really does (_kasperClose): it only hides the card, it writes no answer and approves nothing.
    const RS_CLOSE_TIP = 'Hides this card from your list, on every device, without approving or changing anything. It comes back if someone writes on it.';
    function _rsFinishHtml(m) {
        const S = R.S, parts = m.parts, left = parts.filter(p => p.st === 'wait').length;
        const sending = R.mode !== 'smm' && Object.keys(RS_PART).some(k => _rsSaving(m, k));
        const all = !left && !sending;
