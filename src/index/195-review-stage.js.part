        el.querySelectorAll('img[src]').forEach(i => { if (i.complete && i.naturalWidth) { const k = i.getAttribute('src'); if (!have.has(k)) have.set(k, []); have.get(k).push(i); } });
        el.innerHTML = html;
        el.__rsHtml = html;
        if (have.size) el.querySelectorAll('img[src]').forEach(i => { const l = have.get(i.getAttribute('src')); const o = l && l.shift(); if (o) { o.className = i.className; i.replaceWith(o); } });
        return true;
    }
    function _rsChipImg(m) {
        return '<span class="sl"><span class="si' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" loading="lazy" src="' + _re(m.thumb) + '">' : '') + '</span></span>';
    }
    function _rsDots(m) { return '<span class="cd" aria-hidden="true">' + m.parts.map(x => '<i class="' + (x.st === 'ok' ? 'ok' : (x.st === 'chg' || x.st === 'tweak') ? 'chg' : '') + '"></i>').join('') + '</span>'; }
    function _rsChip(m, cur) {
        const on = cur && m.id === cur.id;
        if (R.mode !== 'kasper') return '<button class="chipp' + (on ? ' cur' : '') + '" type="button" data-id="' + _re(m.id) + '" aria-current="' + on + '" title="' + _re(m.title) + '">' + _rsChipImg(m) + '<span class="cx"><span class="cn">' + _re(m.title) + '</span>' + _rsDots(m) + '</span></button>';
        const meta = m.sec === 'urgent' ? '<span class="cm urg">' + RI.bell + '<span>' + _re(m.flag) + '</span></span>'
            : m.sec === 'tweaks' ? '<span class="cm"><span>' + _re(m.client) + ', ' + _re(m.note.replace(/^With /, 'with ')) + '</span></span>'
            : '<span class="cm"><span>' + _re(m.client) + '</span>' + (m.sample ? '<b class="tag">Sample</b>' : '') + _rsDots(m) + '</span>';
        return '<button class="chipp k' + (on ? ' cur' : '') + (m.sec === 'urgent' ? ' urgc' : '') + (m.sec === 'tweaks' ? ' edc' : '') + '" type="button" data-id="' + _re(m.id) + '" aria-current="' + on + '" title="' + _re(m.client + ': ' + m.title) + '">' + _rsChipImg(m) + '<span class="cx">' + meta + '<span class="cn">' + _re(m.title) + '</span></span></button>';
    }
    function _rsStrip() {
        const cur = _rsCur();
        const sl = _rsQ('skList'), sh = _rsQ('skHead');
        const keep = sl.scrollLeft;
        let fresh = false;
        if (R.mode !== 'kasper') {
            const q = _rsQueue();
            const open = q.filter(x => !_rsAnswered(x)).length;
            const done = R.mode === 'client' ? 'You can still change your mind' : 'Approve sends to Kasper';
            _rsPut(sh, '<b class="num">' + (open ? open + ' waiting for you' : 'Nothing else waiting') + '</b><span class="num">' + (open ? (R.mode === 'smm' ? 'Approve sends to Kasper' : '') : done) + '</span>');
            const fin = (calState.posts || []).filter(p => R.S.finished.has(p.id)).map(p => _rsModel(p, R.mode, null));
            fresh = _rsPut(sl, q.map(m => _rsChip(m, cur)).join('') + (fin.length ? '<span class="sk-sep" aria-hidden="true"></span>' + fin.map(m => {
                const ch = m.parts.some(x => x.st === 'chg');
                return '<button class="chipp done" type="button" data-reopen="' + _re(m.id) + '" title="Open it again" aria-label="' + _re(m.title) + ', done. Open it again">' + _rsChipImg(m) + '<span class="cx"><span class="cn">' + _re(m.title) + '</span>' + _rsDots(m) + '</span><span class="dk' + (ch ? ' chg' : '') + '">' + (ch ? RI.back : RI.check) + '</span></button>';
            }).join('') : ''));
        } else {
            const k = _rsKasperModels();
            const open = k.urgent.length + k.waiting.length;
            _rsPut(sh, '<b class="num">' + (open ? open + ' to review' : 'All caught up') + '</b><span class="num">' + (k.urgent.length ? k.urgent.length + ' urgent' : open ? 'Oldest first' : 'Nothing waiting on you') + '</span>');
            const h = [];
            if (k.urgent.length) h.push('<div class="sk-grp"><span class="sk-lab urg"><span class="r">' + RI.bell + 'Urgent</span><span class="c num">' + k.urgent.length + '</span></span>' + k.urgent.map(m => _rsChip(m, cur)).join('') + '</div>');
            if (k.waiting.length) h.push('<div class="sk-grp"><span class="sk-lab"><span class="r">Waiting for your review</span><span class="c num">' + k.waiting.length + '</span></span>' + k.waiting.map(m => _rsChip(m, cur)).join('') + '</div>');
            if (k.tweaks.length) h.push('<div class="sk-grp"><button class="sk-lab" type="button" id="edTog" aria-expanded="' + !!R.S.edOpen + '"><span class="r">With the editors <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></span><span class="c num">' + k.tweaks.length + ' tweaks pending</span></button>' + (R.S.edOpen || (cur && cur.sec === 'tweaks') ? k.tweaks.map(m => _rsChip(m, cur)).join('') : '') + '</div>');
            fresh = _rsPut(sl, h.join('<span class="sk-sep" aria-hidden="true"></span>'));
            const t = _rsQ('edTog');
            if (t && fresh) t.addEventListener('click', () => { R.S.edOpen = !R.S.edOpen; _rsStrip(); });
        }
        if (fresh) {
            sl.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => _rsGo(b.dataset.id)));
            sl.querySelectorAll('[data-reopen]').forEach(b => b.addEventListener('click', () => { R.S.finished.delete(b.dataset.reopen); _rsGo(b.dataset.reopen); }));
        }
        sl.scrollLeft = keep;
        const c = sl.querySelector('.cur');
