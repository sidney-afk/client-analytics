        nodes.forEach(n => { if (n.nodeType !== 1) return; if (n.matches(sel)) f(n); n.querySelectorAll(sel).forEach(f); });
    }
    function _rsPut(el, html) {
        if (!el) return false;
        if (el.__rsHtml === html) return false;
        const have = new Map();
        el.querySelectorAll('img[src]').forEach(i => { if (i.complete && i.naturalWidth) { const k = i.getAttribute('src'); if (!have.has(k)) have.set(k, []); have.get(k).push(i); } });
        el.innerHTML = html;
        el.__rsHtml = html;
        if (have.size) el.querySelectorAll('img[src]').forEach(i => { const l = have.get(i.getAttribute('src')); const o = l && l.shift(); if (o) { o.className = i.className; i.replaceWith(o); } });
        return true;
    }
    function _rsChipImg(m) {
        return '<span class="sl"><span class="si' + (m.land ? ' l' : '') + '">' + (m.thumb ? '<img alt="" loading="lazy" src="' + _re(m.thumb) + '">' : '') + '</span></span>';
    }
    function _rsDots(m) { return '<span class="cd" aria-hidden="true">' + m.parts.map(x => '<i class="' + (x.st === 'ok' ? 'ok' : (x.st === 'chg' || x.st === 'tweak') ? 'chg' : '') + '"></i>').join('') + '</span>'; }
    // Kasper's rows (strip chip and list panel). Only "With the editors" rows read "Client · Title" on the first line
    // with the small date below; Urgent and Waiting rows keep the title with the client on their small line.
    function _rsKRowHead(m) {
        return '<span class="cn">' + (m.sec === 'tweaks' && m.client ? '<span class="ck">' + _re(m.client) + '</span><span class="ct"> · ' + _re(m.title) + '</span>' : _re(m.title)) + '</span>';
    }
    function _rsKRowMeta(m) {
        return m.sec === 'urgent' ? '<span class="cm urg">' + RI.bell + '<span>' + _re(m.flag) + '</span></span>'
            : m.sec === 'tweaks' ? (m.since ? '<span class="cm"><span>' + _re(m.since) + '</span></span>' : '')
            : '<span class="cm"><span>' + _re(m.client) + '</span>' + (m.sample ? '<b class="tag">Sample</b>' : '') + _rsDots(m) + '</span>';
    }
    function _rsChip(m, cur) {
        const on = cur && m.id === cur.id;
        if (R.mode !== 'kasper') return '<button class="chipp' + (on ? ' cur' : '') + '" type="button" data-id="' + _re(m.id) + '" aria-current="' + on + '" title="' + _re(m.title) + '">' + _rsChipImg(m) + '<span class="cx"><span class="cn">' + _re(m.title) + '</span>' + _rsDots(m) + '</span></button>';
        return '<button class="chipp k' + (on ? ' cur' : '') + (m.sec === 'urgent' ? ' urgc' : '') + (m.sec === 'tweaks' ? ' edc' : '') + '" type="button" data-id="' + _re(m.id) + '" aria-current="' + on + '" title="' + _re(m.client + ': ' + m.title) + '">' + _rsChipImg(m) + '<span class="cx">' + (m.sec === 'tweaks' ? _rsKRowHead(m) + _rsKRowMeta(m) : _rsKRowMeta(m) + _rsKRowHead(m)) + '</span></button>';
    }
    function _rsStrip() {
        if (R.l2) { _rsL2List(); return; }
        const cur = _rsCur();
        const sl = _rsQ('skList'), sh = _rsQ('skHead');
        const keep = sl.scrollLeft;
        let added = [];
        if (R.mode !== 'kasper') {
            const q = _rsQueue();
            const open = q.filter(x => !_rsAnswered(x)).length;
            const done = R.mode === 'client' ? 'You can still change your mind' : 'Approve sends to Kasper';
            _rsPut(sh, '<b class="num">' + (open ? open + ' waiting for you' : 'Nothing else waiting') + '</b><span class="num">' + (open ? (R.mode === 'smm' ? 'Approve sends to Kasper' : '') : done) + '</span>');
            const fin = (calState.posts || []).filter(p => R.S.finished.has(p.id)).map(p => _rsModel(p, R.mode, null));
            added = _rsPatch(sl, q.map(m => _rsChip(m, cur)).join('') + (fin.length ? '<span class="sk-sep" aria-hidden="true"></span>' + fin.map(m => {
                const ch = m.parts.some(x => x.st === 'chg');
                return '<button class="chipp done" type="button" data-reopen="' + _re(m.id) + '" title="Open it again" aria-label="' + _re(m.title) + ', done. Open it again">' + _rsChipImg(m) + '<span class="cx"><span class="cn">' + _re(m.title) + '</span>' + _rsDots(m) + '</span><span class="dk' + (ch ? ' chg' : '') + '">' + (ch ? RI.back : RI.check) + '</span></button>';
            }).join('') : ''));
        } else {
            const k = _rsKasperModels();
            const open = k.urgent.length + k.waiting.length;
            // No "9 to review" and no section labels on the strip (owner feedback 2026-10-17 23:20): a small list button
            // with the count opens his sections as a list (_rsQueuePanel).
            sh.className = 'sk-head k';
            if (_rsPut(sh, '<button class="qbtn" type="button" id="qBtn" aria-haspopup="dialog" aria-expanded="' + !!R.S.qOpen + '" aria-controls="qPanel" aria-label="Your review list, ' + open + ' to review" title="Your review list">' + RI.list + (open ? '<b class="qb num">' + open + '</b>' : '') + '</button>')) {
                const qb = _rsQ('qBtn');
