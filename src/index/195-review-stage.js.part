            }
            const h = [];
            if (k.urgent.length) h.push('<div class="sk-grp">' + k.urgent.map(m => _rsChip(m, cur)).join('') + '</div>');
            if (k.waiting.length) h.push('<div class="sk-grp">' + k.waiting.map(m => _rsChip(m, cur)).join('') + '</div>');
            if (k.tweaks.length) h.push('<div class="sk-grp"><button class="sk-lab" type="button" id="edTog" aria-expanded="' + !!R.S.edOpen + '"><span class="r">With the editors <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></span><span class="c num">' + k.tweaks.length + ' tweaks pending</span></button>' + (R.S.edOpen || (cur && cur.sec === 'tweaks') ? k.tweaks.map(m => _rsChip(m, cur)).join('') : '') + '</div>');
            added = _rsPatch(sl, h.join('<span class="sk-sep" aria-hidden="true"></span>'));
            _rsEachIn(added, '#edTog', t => t.addEventListener('click', () => { R.S.edOpen = !R.S.edOpen; _rsStrip(); }));
        }
        _rsEachIn(added, '[data-id]', b => b.addEventListener('click', () => _rsGo(b.dataset.id)));
        _rsEachIn(added, '[data-reopen]', b => b.addEventListener('click', () => { R.S.finished.delete(b.dataset.reopen); _rsGo(b.dataset.reopen); }));
        if (R.mode === 'kasper') _rsQueuePanel();
        sl.scrollLeft = keep;
        const c = sl.querySelector('.cur');
        const curId = cur ? cur.id : null, moved = R.stripCur !== curId;
        R.stripCur = curId;
        if (c && moved) { const l = c.offsetLeft, r = l + c.offsetWidth; if (l < sl.scrollLeft || r > sl.scrollLeft + sl.clientWidth) sl.scrollLeft = Math.max(0, l - 40); }
        _rsStripEdge();
    }
    function _rsStripEdge() {
        const sl = _rsQ('skList');
        if (sl) sl.classList.toggle('more-r', sl.scrollWidth - sl.clientWidth - sl.scrollLeft > 1);
    }
    /* Kasper's list (owner feedback 2026-10-17 23:20, session Curtain Seven): the strip's list button opens his
       sections as they are today, top to bottom: Urgent, Waiting for your review, With the editors (tweaks pending,
       with Ping editor). A row opens that post on the stage and closes the list; Escape or a click outside closes it. */
    function _rsQueuePanel() {
        const p = _rsQ('qPanel'), b = _rsQ('qBtn');
        if (!p) return;
        const on = R.mode === 'kasper' && !!R.S.qOpen;
        if (b) b.setAttribute('aria-expanded', String(on));
        p.hidden = !on;
        if (!on) { p.innerHTML = ''; return; }
        const k = _rsKasperModels(), cur = _rsCur();
        const row = (m) => {
            let ping = '';
            if (m.sec === 'tweaks') {
                const canPing = (() => { try { return _calShowUrgent(m.post, 'video'); } catch (e) { return false; } })();
                if (canPing) ping = R.S.pinged[m.id] ? '<span class="b-soft sent qp-ping">' + RI.check + 'Editor pinged</span>' : '<button class="b-soft qp-ping" type="button" data-qping="' + _re(m.id) + '">' + RI.bell + 'Ping editor</button>';
            }
            const on = cur && cur.id === m.id;
            return '<div class="qp-r' + (on ? ' cur' : '') + '"><button class="qp-row" type="button" data-qid="' + _re(m.id) + '"' + (on ? ' aria-current="true"' : '') + '>' + _rsChipImg(m) + '<span class="cx">' + _rsKRowHead(m) + _rsKRowMeta(m) + '</span></button>' + ping + '</div>';
        };
        const sec = (cls, icon, label, count, list, empty) => '<div class="qp-sec"><div class="qp-h' + cls + '">' + icon + '<span>' + label + '</span><span class="c num">' + count + '</span></div>' + (list.length ? list.map(row).join('') : '<div class="qp-empty">' + empty + '</div>') + '</div>';
        let h = '';
        if (k.urgent.length) h += sec(' urg', RI.bell, 'Urgent', k.urgent.length, k.urgent, '');
        h += sec('', '', 'Waiting for your review', k.waiting.length, k.waiting, 'Nothing waiting on you.');
        if (k.tweaks.length) h += sec('', '', 'With the editors', k.tweaks.length + ' tweaks pending', k.tweaks, '');
        p.innerHTML = h;
