.rs.l2 .recap{grid-column:2/4;grid-row:1}
.rs.l2 .ql{grid-column:1;grid-row:1;display:flex;flex-direction:column;min-height:0;min-width:0;background:var(--surface-raised);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow-stage);overflow:hidden}
.rs.l2 .stage .theatre{grid-column:2;grid-row:1}
.rs.l2 .stage .chat{grid-column:3;grid-row:1}
.ql-h{display:flex;align-items:baseline;gap:8px;padding:14px 16px 8px;flex-shrink:0}
.ql-h b{font-size:1.5rem;font-weight:800;letter-spacing:-.03em;line-height:1}
.ql-h span{font-size:.8rem;font-weight:700;color:var(--text-secondary)}
.ql-l{flex:1 1 auto;min-height:0;overflow-y:auto;padding:2px 8px 10px;display:flex;flex-direction:column;gap:2px;position:relative}
.rs.l2 .ql .chipp{width:100%;height:88px;flex-shrink:0;gap:12px;padding:8px 10px 8px 8px;border-radius:14px}
.rs.l2 .ql .chipp .sl{width:72px;height:72px}
.rs.l2 .ql .chipp .si{width:41px;height:72px;border-radius:7px}
.rs.l2 .ql .chipp .si.l{width:72px;height:41px}
/* The selected card: its whole rounded row tinted with the accent and edged by a fine accent line (no bracket on the edge). */
.rs.l2 .ql .chipp.cur{background:color-mix(in srgb,var(--accent) 13%,var(--surface-raised));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 48%,transparent)}
.rs.l2 .ql .chipp.urgc.cur{background:color-mix(in srgb,var(--urgent) 11%,var(--surface-raised));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--urgent) 48%,transparent)}
.edw{position:relative;flex-shrink:0}
.edw .chipp.hb,.rs.l2 .ql .edw .chipp.hb{padding-right:50px}
.edping{position:absolute;right:10px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--chgb);color:var(--chg-fg);box-shadow:inset 0 0 0 1px var(--chgrow-line);transition:background .14s}
.edping svg{width:14px;height:14px}
.edping:hover:not(:disabled),.edping:focus-visible{background:var(--chgb-h)}
.edping.busy{opacity:.55;cursor:progress}
.edping.sent{background:var(--ok-soft);color:var(--ok-ink);box-shadow:inset 0 0 0 1px var(--ok-line);cursor:default}
.rs.l2 .ql .chipp .ub{display:inline-flex;color:var(--urgent);flex-shrink:0}
.rs.l2 .ql .chipp .cn{font-size:.82rem}
.ql-g{display:flex;flex-direction:column;gap:1px;margin-top:6px;padding:10px 8px 6px;border-top:1px solid var(--hair);border-radius:0 0 10px 10px;font-size:.74rem;font-weight:800;color:var(--text-secondary);text-align:left;flex-shrink:0}
.ql-g:hover{color:var(--text-primary)}
.ql-g .r{display:flex;align-items:center;gap:5px}
.ql-g .c{font-weight:600;color:var(--label)}
.ql-g .chev{width:12px;height:12px;transition:transform .18s var(--ease)}
.ql-g[aria-expanded="true"] .chev{transform:rotate(-90deg)}
.ql-empty{padding:18px 10px;font-size:.82rem;font-weight:600;color:var(--text-secondary)}
.rs.l2 .l2h{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;flex-shrink:0}
.rs.l2 .l2t{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}
.rs.l2 .l2t .side{display:block;padding:0;min-width:0}
.rs.l2 .l2t .side .sd-t h2{font-size:1.2rem;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rs.l2 .sdate{position:static;height:auto;max-width:none;min-width:0;padding:0 2px;overflow:hidden;font-size:.74rem;white-space:nowrap}
.closew{position:relative;display:inline-flex}
.closew .tip{position:absolute;top:calc(100% + 8px);right:0;z-index:30;width:236px;padding:9px 11px;border-radius:10px;background:var(--text-primary);color:var(--surface-raised);font-size:.74rem;font-weight:600;line-height:1.4;text-align:left;box-shadow:var(--shadow-md);opacity:0;visibility:hidden;transform:translateY(-3px);transition:opacity .14s,transform .14s,visibility 0s .14s;pointer-events:none}
.closew:hover .tip,.closew:focus-within .tip{opacity:1;visibility:visible;transform:none;transition:opacity .14s .3s,transform .14s .3s,visibility 0s .3s}
.b-undo{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;margin-left:auto;border-radius:8px;font-size:.76rem;font-weight:700;color:var(--ok-ink);transition:background .14s}
.b-undo svg{width:12px;height:12px}
.b-undo:hover,.b-undo:focus-visible{background:var(--okb)}
.rs.l2 .l2a{display:flex;align-items:center;gap:8px;flex-shrink:0}
.rs.l2 .l2a .held{margin-right:6px}
.rs.l2 .flash{right:auto;left:50%;top:9px;transform:translate(-50%,-4px)}
.rs.l2 .flash.on{transform:translate(-50%,0)}
#l2note:empty{display:none}
#l2note .elsew{margin:0}
.rs.l2 .l2g{flex:1 1 auto;min-height:0;display:grid;column-gap:16px;row-gap:10px;transition:opacity .16s var(--ease)}
.rs.l2 .l2g.swap{opacity:0}
.rs.l2 .l2g.l2-port{grid-template-columns:var(--l2cols,minmax(0,1fr));grid-template-rows:minmax(0,1fr) auto}
.rs.l2 .l2g.l2-land{grid-template-columns:repeat(var(--l2c,2),minmax(0,1fr));grid-template-rows:minmax(0,2fr) auto minmax(0,1fr) auto}
.pn{display:contents}
.pn-m{min-width:0;min-height:0}
.pn-d{min-width:0}
.l2-port .pn-m{grid-column:var(--c);grid-row:1}
.l2-port .pn-d{grid-column:var(--c);grid-row:2}
.l2-land .pn-video .pn-m{grid-column:1/-1;grid-row:1}
.l2-land .pn-video .pn-d{grid-column:1/-1;grid-row:2}
.l2-land .pn:not(.pn-video) .pn-m{grid-column:var(--o);grid-row:3}
.l2-land .pn:not(.pn-video) .pn-d{grid-column:var(--o);grid-row:4}
.pn-d .dwrap{justify-content:stretch}
.pn-d .dec{justify-content:flex-start;width:100%;gap:6px}
.pn-d .dst{white-space:normal}
.pn-d{container-type:inline-size}
/* One compact row per part: Tweaks are on Frame left, Approve centred (with its caret), Ask for a change right. */
.pn-d .dec:has(>.b-ask){display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;justify-content:normal;column-gap:8px;flex-wrap:nowrap}
.pn-d .dec:has(>.b-ask)>.b-frame{grid-column:1;grid-row:1;justify-self:start}
.pn-d .dec:has(>.b-ask)>.split{grid-column:2;grid-row:1;justify-self:center}
.pn-d .dec:has(>.b-ask)>.b-ask{grid-column:3;grid-row:1;justify-self:end}
.pn-d .split>.b-ok{height:auto;min-height:38px;padding:5px 42px 5px 12px;font-size:.8rem;line-height:1.15;text-align:left;white-space:nowrap}
.pn-d .split>.sarr{width:32px}
.pn-d .b-ask,.pn-d .b-frame{height:auto;min-height:38px;padding:5px 8px;font-size:.74rem;line-height:1.15;text-align:center;white-space:nowrap;justify-content:center}
.pn-d .ls{display:none}
/* Every label stays on ONE line (owner feedback 2026-10-20): where the part's column is too narrow for the long labels
   the short ones show, and where even those do not fit, Frame and Ask for a change shrink to their icons. The long text
   is always the button's accessible name (aria-label) and its tooltip. */
@container (max-width:460px){.pn-d .lf{display:none}.pn-d .ls{display:inline}.pn-d .dec:has(>.b-ask){column-gap:5px}.pn-d .b-ask svg,.pn-d .b-frame svg{display:none}.pn-d .split>.b-ok{padding:4px 34px 4px 10px;font-size:.78rem}.pn-d .split>.sarr{width:28px}.pn-d .b-ask,.pn-d .b-frame{padding:4px 5px;font-size:.72rem}.pn-d .split>.b-ok svg{display:none}}
@container (max-width:300px){.pn-d .dec:has(>.b-ask){grid-template-columns:34px minmax(0,1fr) 34px}.pn-d .b-ask,.pn-d .b-frame{width:34px;padding:0}.pn-d .b-ask .ls,.pn-d .b-frame .ls{display:none}.pn-d .b-ask svg,.pn-d .b-frame svg{display:block;width:15px;height:15px}.pn-d .split{justify-self:stretch}.pn-d .split>.b-ok{width:100%}}
.pn-d .b-ok:not(.split>.b-ok){white-space:normal;text-align:left;line-height:1.15;height:auto;min-height:38px;font-size:.8rem}
.pn-d .dwrap .compose{width:100%}
.pn-d .cmp-foot{flex-wrap:wrap}
.pn-d .elsew{margin:0 0 6px}
.rs.l2 .tc-text{font-size:.96rem;line-height:1.55}
.rs.l2 .tcard.wc{padding:18px 18px 14px;gap:10px}
.rs.l2 .l2g.l2-port .tcard.wc{width:100cqw}
`;
    const RS_PART = { video: 'Video', graphic: 'Thumbnail', caption: 'Caption', title: 'YouTube title' };
    /* The client page's polish (review_client_polish, session Porch, 2026-10-24): only added to a client page the switch
       lists. No wait or progress cursor; the approve circle, spinner and check; the change box's "Sent"; the delete cross. */
    const RS_CSS_CP = `
.cp .b-ok.busy,.cp .b-ask.busy,.cp .b-frame.busy,.cp .b-ok:disabled,.cp .b-ask:disabled{cursor:default}
.cp-spin{display:inline-block;flex:none;width:16px;height:16px;border-radius:50%;border:2px solid currentColor;border-right-color:transparent;opacity:.8;animation:rsSpin .7s linear infinite;vertical-align:middle}
.bh .cp-spin{width:10px;height:10px;border-width:1.5px;opacity:.55}
.fc .cp-spin{width:12px;height:12px}
.b-ok.cp-morph,.b-ok.cp-morph:disabled{width:44px;min-width:44px;height:42px;padding:0;gap:0;justify-content:center;border-radius:999px;background:var(--okb);color:var(--okb-fg);box-shadow:inset 0 0 0 1px var(--okb-line);overflow:hidden;animation:cpShrink .22s var(--ease) both}
@keyframes cpShrink{from{width:var(--cpw);border-radius:11px}to{width:44px;border-radius:999px}}
.b-ok.cp-ok,.b-ok.cp-ok:disabled{animation:none;background:var(--ok-ink);color:var(--surface-raised);box-shadow:none}
.cp-ck{display:inline-flex;animation:cpPop .34s cubic-bezier(.3,1.6,.5,1) both;animation-delay:var(--cpd,0ms)}
.cp-ck svg{width:18px;height:18px}
@keyframes cpPop{from{transform:scale(.3);opacity:0}to{transform:none;opacity:1}}
.dec.cp-checking{background:transparent;box-shadow:none}
.dec.cp-settle{animation:cpSettle .3s var(--ease) both}
@keyframes cpSettle{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
.cp-stw{display:inline-flex;align-items:center;gap:4px 10px;flex-wrap:wrap}
.cp-st{display:inline-flex;align-items:center;gap:6px;font-size:.74rem;font-weight:700;color:var(--text-secondary)}
.cp-st svg{width:12px;height:12px}
.cp-st.cp-done{color:var(--ok-ink);animation:rise .2s var(--ease)}
.cp .bb{position:relative}
.cp-x{position:absolute;top:-10px;right:-8px;width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--surface-raised);color:var(--text-secondary);box-shadow:0 0 0 1px var(--border),0 1px 3px rgba(0,0,0,.14);opacity:0;transform:scale(.85);transition:opacity .12s,transform .12s,color .12s;pointer-events:none;z-index:1}
.cp-x svg{width:10px;height:10px}
.bub:hover .cp-x,.bub:focus-within .cp-x,.bub.cp-show .cp-x{opacity:1;transform:none;pointer-events:auto}
.cp-x:hover,.cp-x:focus-visible{color:var(--urgent)}
.cp-ask{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:6px;font-size:.78rem;font-weight:600;color:var(--text-primary)}
.cp-ask span{margin-right:4px}
.cp-ask button{font:inherit;font-weight:700;padding:3px 11px;border-radius:999px;transition:background .12s}
.cp-yes{background:var(--urgent);color:#fff}
.cp-no{color:var(--text-secondary)}
.cp-no:hover{background:var(--fill);color:var(--text-primary)}
@media (prefers-reduced-motion:reduce){.cp-spin{animation:rsBreathe 1.6s ease-in-out infinite!important;border-right-color:currentColor}.b-ok.cp-morph,.cp-ck,.dec.cp-settle{animation:none}}
`;
    const RS_CSSKEY = { video: 'video', graphic: 'thumbnail', caption: 'caption', title: 'youtube' };
    const RS_FRAME_NOTE = 'Tweaks are on Frame.';
    function _rsSv(p, w) { return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="' + (w || 2.2) + '" stroke-linecap="round" stroke-linejoin="round">' + p + '</svg>'; }
    const RI = {
        check: _rsSv('<path d="m5 12.5 4.5 4.5L19 7.5"/>', 2.8),
        clock: _rsSv('<circle cx="12" cy="12" r="8"/><path d="M12 8v4.2l2.8 1.8"/>', 2.3),
        back: _rsSv('<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>', 2.4),
        ext: _rsSv('<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>'),
        pen: _rsSv('<path d="M4 20h4l10.5-10.5a2 2 0 0 0-4-4L4 16z"/>'),
        send: _rsSv('<path d="M5 12h13M13 6l6 6-6 6"/>', 2.4),
        down: _rsSv('<path d="m6 9 6 6 6-6"/>', 2.6),
        x: _rsSv('<path d="M7 7l10 10M17 7 7 17"/>', 2.6),
        skip: _rsSv('<path d="m5 6 7 6-7 6zM13 6l7 6-7 6z"/>', 2),
        lock: _rsSv('<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>', 2.2),
        eye: _rsSv('<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.6"/>'),
        bell: _rsSv('<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>'),
        frame: _rsSv('<path d="M5 4h14v5H9v4h8v4H9v3H5z"/>'),
        aat: _rsSv('<path d="m3.5 12.5 4 4L15 9"/><path d="M14 20h2.2l4.6-4.6-2.2-2.2L14 17.8z"/>'),
        cal: _rsSv('<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>', 2),
        moon: _rsSv('<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>', 2),
        sun: _rsSv('<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>', 2),
        list: _rsSv('<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r=".6"/><circle cx="4.5" cy="12" r=".6"/><circle cx="4.5" cy="18" r=".6"/>', 2.2),
        play: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>'
    };
    const _re = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    function _rsPv(c) { const k = RS_CSSKEY[c] || 'video'; return '--pc:var(--pd-' + k + ');--pt:var(--pt-' + k + ');--pi:var(--pi-' + k + ')'; }
    function _rsDot(c) { return '<span class="pdot" style="--pc:var(--pd-' + (RS_CSSKEY[c] || 'video') + ')"></span>'; }
    function _rsLname(c) { return c === 'title' ? 'title' : RS_PART[c].toLowerCase(); }
    function _rsKind(c) { return c === 'video' ? 'video' : c === 'graphic' ? 'thumb' : 'text'; }
    function _rsCsv(v) { return new Set(String(v || '').split(',').map(s => s.trim()).filter(Boolean)); }
    const RS_DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const RS_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    // "Fri 21 Oct" (owner, 2026-10-16), from the card's YYYY-MM-DD post date.
    function _rsDate(iso) {
        const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (!m) return '';
        const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
        return RS_DAYS[d.getUTCDay()] + ' ' + (+m[3]) + ' ' + RS_MONTHS[+m[2] - 1];
    }
    function _rsWhen(iso) {
        if (!iso) return '';
        try { return _calFmtCommentTime(iso) || ''; } catch (e) { return ''; }
    }
    /* The date a tweak went to the editors, as small as it can be (owner, 2026-10-18): Today, Yesterday, the weekday
       within the last week, otherwise "29 Sept"; the year only when it is not this year. Local days, not 24 hours. */
    const RS_WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const RS_SINCE_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
    function _rsSince(iso) {
        const t = Date.parse(iso || '');
        if (!isFinite(t)) return '';
        const d = new Date(t), now = new Date();
        const days = Math.round((new Date(now.getFullYear(), now.getMonth(), now.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 86400000);
        if (days <= 0) return 'Today';
        if (days === 1) return 'Yesterday';
        if (days < 7) return RS_WEEKDAYS[d.getDay()];
        return d.getDate() + ' ' + RS_SINCE_MONTHS[d.getMonth()] + (d.getFullYear() === now.getFullYear() ? '' : ' ' + d.getFullYear());
    }

    /* ---------- state ---------- */
    function _rsBlankNote() { return { text: '', part: null, where: 'chat', vis: 'team', aat: false, was: '' }; }
    const R = {
        mode: '', key: '', host: null, root: null, ro: null, mo: null,
        S: null, kparts: null, pending: false, l2: false, cp: false
    };
    // Kasper's second layout needs room for the list, three parts and the conversation (below this: today's page).
    const RS_L2_MIN = 1360;
    /* Unsent change-request words survive a reload (session Rail, 2026-10-18). Client link only. Kept in this browser
       under one key per client link: { postId: { text, part, vis, at } }. Cleared when sent, when the post leaves the
       list, and after 7 days. Every read and write is guarded: with storage blocked the page works as before, the
       words just do not outlive the tab. No link token is ever stored. */
    const RS_DRAFT_KEY = 'syncview_rs_drafts_v1:';
    const RS_DRAFT_TTL_MS = 7 * 24 * 60 * 60 * 1000;
    // Caption edits use this tab's storage, so another open tab cannot replace its unsent text.
    function _rsEditDraftKey(key) { return R.mode === 'client' ? 'syncview_rs_caption_draft_v1:' + String(calState.client || '').toLowerCase() + ':' + key : ''; }
    function _rsEditDraftRead(key) {
        if (Object.prototype.hasOwnProperty.call(R.S.editDrafts, key)) return R.S.editDrafts[key];
        try {
            const storageKey = _rsEditDraftKey(key), d = storageKey && JSON.parse(sessionStorage.getItem(storageKey) || 'null');
            if (d && typeof d.text === 'string' && Date.now() - Number(d.at || 0) < RS_DRAFT_TTL_MS) { R.S.editBase[key] = typeof d.base === 'string' ? d.base : ''; return d.text; }
            if (storageKey) sessionStorage.removeItem(storageKey);
        } catch (e) {}
        return undefined;
    }
    function _rsEditDraftPut(key, text) {
        R.S.editDrafts[key] = text;
        try { const k = _rsEditDraftKey(key); if (k) sessionStorage.setItem(k, JSON.stringify({ text, base: R.S.editBase[key], at: Date.now() })); } catch (e) {}
    }
    function _rsEditDraftDrop(key) {
        delete R.S.editDrafts[key];
        delete R.S.editBase[key];
        try { const k = _rsEditDraftKey(key); if (k) sessionStorage.removeItem(k); } catch (e) {}
    }
    // Cancel or Escape on the caption editor throws the words away, as it always did; so do a save that is
    // finished (or needs no save), or the next Edit would open on stale words instead of the current text.
    function _rsEditDiscard(key) {
        if (R.S) { R.S.editing = ''; delete R.S.editErrors[key]; }
        _rsEditDraftDrop(key);
    }
    // Pocket (phones): on a fresh load the editor reopens on the post whose caption words were left unsent, from the
    // same per-tab drafts as above. Restoring one never sends it or approves a part.
    function _rsEditDrafts() {
        const out = {};
        if (R.mode !== 'client') return out;
        try {
            const pre = 'syncview_rs_caption_draft_v1:' + String(calState.client || '').toLowerCase() + ':';
            for (let i = 0; i < sessionStorage.length; i++) {
                const sk = sessionStorage.key(i);
                if (!sk || sk.indexOf(pre) !== 0) continue;
                const id = sk.slice(pre.length), cut = id.lastIndexOf('|'), d = JSON.parse(sessionStorage.getItem(sk) || 'null');
                if (cut < 0 || !d || typeof d.text !== 'string' || Date.now() - Number(d.at || 0) >= RS_DRAFT_TTL_MS) continue;
                const post = id.slice(0, cut), part = id.slice(cut + 1);
                if (!['caption', 'title'].includes(part)) continue;
                if (!out[post] || Number(d.at || 0) > Number(out[post].at || 0)) out[post] = { part, text: d.text, at: d.at };
            }
        } catch (e) {}
        return out;
    }
    function _rsRestoreEdit(m) {
        const d = m && _rsEditDrafts()[m.id];
        if (!d || !m.parts.some(p => p.key === d.part && p.st === 'wait')) return;
        const key = m.id + '|' + d.part, text = _rsEditDraftRead(key);
        if (text === undefined) return;
        R.S.step = d.part; R.S.editing = d.part; R.S.editText = text;
    }
    function _rsDraftStoreKey() {
        const c = String(calState.client || '').trim().toLowerCase();
        return R.mode === 'client' && c ? RS_DRAFT_KEY + c : '';
    }
    function _rsStoreRead() {
        const key = _rsDraftStoreKey(), out = {};
        if (!key) return out;
        try {
            const raw = JSON.parse(localStorage.getItem(key) || '{}'), now = Date.now();
            if (!raw || typeof raw !== 'object') return out;
            let stale = false;
            Object.keys(raw).forEach(id => {
                const d = raw[id];
                if (d && typeof d.text === 'string' && d.text.trim() && now - Number(d.at || 0) < RS_DRAFT_TTL_MS) out[id] = { text: d.text, part: d.part || null, vis: d.vis === 'client' ? 'client' : 'team', was: ['wait', 'ok', 'chg', 'tweak'].indexOf(d.was) >= 0 ? d.was : '', aat: !!d.aat, at: Number(d.at) };
                else stale = true;
            });
            // Words past their 7 days are removed from storage, not just left out of the answer.
            if (stale) _rsStoreWrite(out);
        } catch (e) {}
        return out;
    }
    function _rsStoreWrite(all) {
        const key = _rsDraftStoreKey();
        if (!key) return;
        try {
            if (Object.keys(all).length) localStorage.setItem(key, JSON.stringify(all));
            else localStorage.removeItem(key);
        } catch (e) {}
    }
    function _rsDraftPut(pid, d) {
        if (!_rsDraftStoreKey() || !pid) return;
        const all = _rsStoreRead();
        all[pid] = { text: d.text, part: d.part || null, vis: d.vis || 'team', was: d.was || '', aat: !!d.aat, at: Date.now() };
        _rsStoreWrite(all);
    }
    function _rsDraftDrop(pid) {
        if (!pid) return;
        if (R.S && R.S.drafts) delete R.S.drafts[pid];
        if (!_rsDraftStoreKey()) return;
        const all = _rsStoreRead();
        if (all[pid]) { delete all[pid]; _rsStoreWrite(all); }
    }
    // The words in the box right now, kept for the post on stage (called as they are typed).
    function _rsPersistCur() {
        const S = R.S;
        if (R.mode !== 'client' || !S || !S.curId) return;
        if (String(S.note.text || '').trim()) _rsDraftPut(S.curId, { text: S.note.text, part: S.note.part, vis: S.note.vis, was: S.note.was, aat: S.note.aat });
        else _rsDraftDrop(S.curId);
    }
    /* Once the list has loaded: kept words come back from storage (once), and words for a post that is no longer on
       the list are dropped, from memory and from storage. An empty or still loading list never drops anything. */
    function _rsDraftsSettle(all) {
        const S = R.S;
        if (R.mode !== 'client' || !S || calState.loading || !all.length) return;
        const live = new Set(all.map(x => x.id));
        if (!S.draftsLoaded) {
            S.draftsLoaded = true;
            const stored = _rsStoreRead();
            Object.keys(stored).forEach(id => { if (!S.drafts[id]) S.drafts[id] = stored[id]; });
        }
        // The list may still be the saved copy from an earlier visit (calState.fromCache): it can lack a post that
        // is waiting now, so nothing is dropped until the live list has landed.
        if (calState.fromCache) return;
        let gone = false;
        Object.keys(S.drafts).forEach(id => { if (!live.has(id)) { delete S.drafts[id]; gone = true; } });
        if (gone || S.draftsSwept !== true) {
            S.draftsSwept = true;
            const all2 = _rsStoreRead();
            let changed = false;
            Object.keys(all2).forEach(id => { if (!live.has(id) && id !== S.curId) { delete all2[id]; changed = true; } });
            if (changed) _rsStoreWrite(all2);
        }
    }
    function _rsDraftPick(q) {
        const S = R.S;
        let best = null, at = -1;
        q.forEach(x => { const d = S.drafts[x.id]; if (d && Number(d.at || 0) > at) { best = x; at = Number(d.at || 0); } });
        const edits = _rsEditDrafts();
        q.forEach(x => { const d = edits[x.id]; if (d && Number(d.at || 0) > at) { best = x; at = Number(d.at || 0); } });
        return best;
    }
    function _rsFreshState() {
        return { curId: null, step: '', note: _rsBlankNote(), editing: '', editText: '', fold: false, saved: null,
            menu: '', exp: {}, edOpen: false, qOpen: false, acted: new Set(), finished: new Set(), hinted: false, pinged: {}, retry: {}, retryText: {}, capSending: {}, noteQ: {}, slow: {}, pressed: {}, ready: {}, actAt: {}, seen: {}, told: {}, keepK: null, drafts: {}, editDrafts: {}, editBase: {}, editSaving: {}, editErrors: {}, draftsLoaded: false, moved: null, stageTitle: '', cpOk: {}, cpSent: {}, chgQ: {}, cpBack: {}, cpDel: null, cpW: 0 };
    }

    /* ---------- the model: one shape for every person ---------- */
    function _rsPartState(post, comp, mode, item) {
        const s = _calNormStatus(post[comp + '_status'] || '');
        if (mode === 'client') {
            if (s === 'Client Approval') return { st: 'wait' };
            if (s === 'Approved' || s === 'Scheduled' || s === 'Posted') return { st: 'ok', when: post['client_' + comp + '_approved_at'] || '' };
            if (s === 'Tweaks Needed') return { st: 'chg' };
            return null;
        }
        if (mode === 'smm') {
            if (s === 'For SMM Approval') return { st: 'wait' };
            if (s === 'Kasper Approval') return { st: 'ok', route: 'kasper' };
            if (s === 'Client Approval' || s === 'Approved' || s === 'Scheduled' || s === 'Posted') return { st: 'ok', route: 'client' };
            if (s === 'Tweaks Needed') return { st: 'chg' };
            return null;
        }
        // Kasper
        const aat = _rsCsv(post.kasper_approved_after_tweaks).has(comp);
        if (item && item._rsSec === 'tweaks') {
            if (s === 'Tweaks Needed') return { st: 'tweak', frame: _rsLastTweakIsFrame(post, comp, item) };
            return { st: 'ok', dec: aat ? 'aat' : '' };
        }
        const reviewable = item && item._sxr
            ? s === 'Kasper Approval'
            : s === 'Kasper Approval' && _kasperCompReviewable(post, comp);
        if (reviewable) return { st: 'wait' };
        if (s === 'Tweaks Needed') return aat ? { st: 'ok', dec: 'aat' } : { st: 'chg', frame: _rsLastTweakIsFrame(post, comp, item) };
        if (s === 'Client Approval' || s === 'Approved' || s === 'Scheduled' || s === 'Posted') return { st: 'ok' };
        return null;
    }
    function _rsComments(post, comp, mode, item) {
        let list;
        try {
            if (item && item._sxr && typeof window._sxrCommentsFor === 'function') list = window._sxrCommentsFor(post, comp);
            else list = mode === 'client' ? _calCommentsForView(post, comp) : _calCommentsFor(post, comp);
        } catch (e) { list = []; }
        return (Array.isArray(list) ? list : []).filter(c => c && !c.deleted && !c.hidden && String(c.body || '').trim());
    }
    function _rsLastTweakIsFrame(post, comp, item) {
        const t = _rsComments(post, comp, 'kasper', item).filter(c => c.is_tweak && c.role === 'kasper');
        const last = t[t.length - 1];
        return !!last && String(last.body || '').trim() === RS_FRAME_NOTE;
    }
    function _rsCompsOf(post, mode, item) {
        if (mode === 'kasper') {
            if (item && item._sxr) return ['video', 'graphic'].filter(c => _calNormStatus(post[c + '_status'] || '') && _calNormStatus(post[c + '_status'] || '') !== 'N/A');
            try { const c = _kasperPanelComps(post); if (Array.isArray(c) && c.length) return c; } catch (e) {}
        }
        return _calComponentsFor(post);
    }
    function _rsIsMine(c, mode) {
        if (mode === 'client') return c.role === 'client';
        if (mode === 'kasper') return c.role === 'kasper';
        const me = _calCurrentAuthorId();
        return c.role === 'smm' && !!me && c.author_member_id === me;
    }
    function _rsThread(post, comps, mode, item) {
        const all = [];
        comps.forEach(comp => _rsComments(post, comp, mode, item).forEach(c => all.push({ c, comp })));
        const outbox = _noteOutboxFor(post.id);
        // a change request still on its way (it shows from the click, as on the old page)
        if (mode !== 'kasper') {
            comps.forEach(comp => {
                const n = _calReviewState.sendingNotes && _calReviewState.sendingNotes[post.id + '|' + comp];
                if (n && _calReviewState.saving[post.id + '|' + comp] && !all.some(x => x.c.id && x.c.id === n.id)) all.push({ c: Object.assign({ role: _calCommentRole(), sending: true }, n), comp });
            });
        }
        if (R.S && R.S.noteQ) {
            comps.forEach(comp => (R.S.noteQ[post.id + '|' + comp] || []).forEach(n => all.push({ c: { id: n.id, body: n.body, created_at: n.created_at, role: mode === 'kasper' ? 'kasper' : _calCommentRole(), sending: true, audience: mode === 'client' || n.vis === 'client' ? 'client' : 'internal' }, comp })));
        }
        // the client page's queued change requests (polish): each shows from its send, in order, until it goes
        if (R.S && R.S.chgQ) {
            comps.forEach(comp => (R.S.chgQ[post.id + '|' + comp] || []).forEach(n => all.push({ c: { id: n.id, body: n.body, created_at: n.created_at, role: _calCommentRole(), sending: true, is_tweak: true, audience: 'client' }, comp })));
        }
        all.sort((a, b) => String(a.c.created_at || '').localeCompare(String(b.c.created_at || '')));
        return all.map(({ c, comp }) => {
            const pending = outbox.find(e => e.id === c.id);
            let who;
            try { who = _calNoteAuthorName(c) || c.author || ''; } catch (e) { who = c.author || ''; }
            return {
                id: String(c.id || ''), you: _rsIsMine(c, mode), who: who || (c.role === 'client' ? 'Client' : 'Team'), role: c.role || '',
                part: comp, time: c.sending ? (R.cp ? '' : 'Sending…') : _rsWhen(c.created_at), text: String(c.body || ''),
                change: !!c.is_tweak, done: !!c.done, aud: c.audience || '', sending: !!c.sending || !!(pending && pending.state === 'sending'), failed: !!(pending && pending.state === 'failed'), edit: c.is_tweak ? null : _rsEditOf(c.body),
                canDelete: mode === 'client' && !c.sending && (c.canonical ? !!c.can_delete : c.role === 'client'),
                frame: !!c.is_tweak && String(c.body || '').trim() === RS_FRAME_NOTE
            };
        });
    }
    /* A client's caption edit is saved on the card and told in the conversation as a plain note in these words, so
       every page that shows notes (the old Review panel, Notes, Kasper's) reads it as it is, and this page shows it as
       the new caption over the old one. */
    const RS_EDIT_HEAD = 'Changed the caption to:\n\n', RS_EDIT_WAS = '\n\nIt was:\n\n', RS_EDIT_EMPTY = '\n\nIt was empty.';
    function _rsEditNote(now, old) { return RS_EDIT_HEAD + now + (String(old || '').trim() ? RS_EDIT_WAS + old : RS_EDIT_EMPTY); }
    function _rsEditOf(body) {
        const b = String(body || '');
        if (b.indexOf(RS_EDIT_HEAD) !== 0) return null;
        const rest = b.slice(RS_EDIT_HEAD.length);
        if (rest.endsWith(RS_EDIT_EMPTY)) return { now: rest.slice(0, -RS_EDIT_EMPTY.length), old: '' };
        const i = rest.lastIndexOf(RS_EDIT_WAS);
        return i < 0 ? null : { now: rest.slice(0, i), old: rest.slice(i + RS_EDIT_WAS.length) };
    }
    function _rsModel(post, mode, item) {
        const comps = _rsCompsOf(post, mode, item);
        const parts = [];
        comps.forEach(comp => {
            const ps = _rsPartState(post, comp, mode, item);
            if (ps) parts.push(Object.assign({ key: comp }, ps));
        });
        const yt = (() => { try { return _calIsYouTubeCard(post); } catch (e) { return false; } })();
        let thumb = '';
        try { thumb = _calDeriveThumb(post) || ''; } catch (e) { thumb = ''; }
        let tinfo = null;
        try { tinfo = _calDeriveThumbInfo(post); } catch (e) { tinfo = null; }
        const thread = _rsThread(post, comps, mode, item);
        return {
            id: post.id, post, item: item || null, title: post.name || 'Untitled', date: _rsDate(post.scheduled_date),
            land: yt, thumb, tframe: tinfo && tinfo.frame ? tinfo.frame : '', parts,
            caption: String(post.caption || ''), ytitle: String(post.name || ''),
            client: item ? (item.client || post.client || '') : (post.client || ''),
            sample: !!(item && item._sxr), sec: item ? item._rsSec : '',
            flag: '', note: '', thread
        };
    }
    function _rsWaiting(m) { return m.parts.filter(x => x.st === 'wait'); }
    function _rsAnswered(m) { return !_rsWaiting(m).length; }

    // The posts on the strip, in the order the old page lists them.
    function _rsCalPosts() {
        const mode = R.mode, S = R.S;
        const list = (calState.posts || []).filter(p => {
            if (!p || !p.id) return false;
            if (S.finished.has(p.id)) return false;
            // The post on stage stays until the person moves on, even when it was answered elsewhere (another
            // tab, or the team) meanwhile: a background refresh never swaps it for another post (session Curtain Ten).
            if (p.id === S.curId) return true;
            const m = _rsModel(p, mode, null);
            if (_rsWaiting(m).length) return mode !== 'smm' || _calHasMedia(p);
            // answered in this sitting: it stays until Finish reviewing
            return m.parts.some(x => S.acted.has(p.id + '|' + x.key));
        });
        return list.slice().sort((a, b) => {
            const ad = String(a.scheduled_date || '').slice(0, 10), bd = String(b.scheduled_date || '').slice(0, 10);
            if (ad && bd && ad !== bd) return ad.localeCompare(bd);
            if (ad && !bd) return -1;
            if (!ad && bd) return 1;
            return Number(a.order_index || 0) - Number(b.order_index || 0);
        }).map(p => _rsModel(p, mode, null));
    }
    function _rsKasperModels() {
        const P = R.kparts || { urgent: [], waiting: [], tweaks: [] };
        const out = { urgent: [], waiting: [], tweaks: [] };
        ['urgent', 'waiting', 'tweaks'].forEach(sec => (P[sec] || []).forEach(it => {
            if (!it || !it.post) return;
            it._rsSec = sec;
            const m = _rsModel(it.post, 'kasper', it);
            const p = it.post;
            m.client = it.client || p.client || '';
            if (sec === 'urgent') {
                const by = String(p.kasper_urgent_by || '').trim();
                m.flag = (by ? by + ' pinged you' : 'Pinged') + (p.kasper_urgent_pinged_at ? ', ' + _rsWhen(p.kasper_urgent_pinged_at) : '');
            }
            if (sec === 'tweaks') { m.note = p.kasper_finished_at ? 'With the editors since ' + _rsWhen(p.kasper_finished_at) : 'With the editors'; m.since = _rsSince(p.kasper_finished_at); }
            else {
                const rounds = m.thread.filter(x => x.change && x.role === 'kasper').length;
                m.note = rounds ? 'Back after tweaks, round ' + (rounds + 1) : (m.sample ? 'Sample' : 'First review');
            }
            out[sec].push(m);
        }));
        // The card on stage left Kasper's lists (answered in another window): it stays on stage, read only, until he
        // moves on (session Curtain Ten).
        const K = R.S && R.S.keepK;
        if (K && K.item && K.item.post && K.item.post.id === R.S.curId && !['urgent', 'waiting', 'tweaks'].some(sec => out[sec].some(x => x.id === K.item.post.id))) {
            const m = _rsModel(K.item.post, 'kasper', K.item);
            m.client = K.item.client || K.item.post.client || '';
            m.gone = true; m.note = '';
            out[K.sec === 'tweaks' ? 'tweaks' : 'waiting'].push(m);
        }
        return out;
    }
    function _rsAll() {
        if (R.mode !== 'kasper') return _rsCalPosts();
        const k = _rsKasperModels();
        return k.urgent.concat(k.waiting, k.tweaks);
    }
    function _rsQueue() {
        if (R.mode !== 'kasper') return _rsCalPosts();
        const k = _rsKasperModels();
        return k.urgent.concat(k.waiting);
    }
    function _rsCur() {
        const all = _rsAll();
        let m = all.find(x => x.id === R.S.curId);
        _rsDraftsSettle(all);
        if (!m) {
            const q = _rsQueue(), had = R.S.curId;   // had: a post was on stage (not the recap, not a first draw)
            m = q[0] || null;
            // A reload: open on the post whose unsent words were kept, so they are in front of the client again.
            if (!had && R.mode === 'client') { const kp = _rsDraftPick(q); if (kp) m = kp; }
            if (had && all.length && !calState.fromCache && !calState.loading) _rsDraftDrop(had);
            R.S.curId = m ? m.id : null;
            R.S.step = m ? _rsFirstStep(m) : '';
            // The post on stage left the list (archived, or moved): typed words stay in the box, about no part, so
            // nothing is sent until the person sees the post now on stage (review of #2207).
            const kept = R.S.note.text, vis = R.S.note.vis;
            R.S.note = _rsBlankNote(); R.S.note.text = kept; R.S.note.vis = vis;
            R.S.editing = '';
            if (!had && m && !kept.trim()) _rsRestoreDraft(m);
            else if (had && m && kept.trim()) _rsPersistCur();
            if (!had && m) _rsRestoreEdit(m);
            // ...and the page says so: the post on stage changed under the person, so they are told which one they
            // were on and which one they are on now, and that the words (if any) would go on this one. Without the
            // notice the title changed silently and a Send landed on a post nobody had chosen (client gauntlet 2).
            R.S.moved = had && m && R.S.stageTitle && R.mode !== 'kasper' ? {
                id: m.id,
                text: '“' + R.S.stageTitle + '” is no longer on your list (it was taken back or finished), so this is the next post. '
                    + (kept.trim() ? 'Your words are still in the box and will go on this post if you send them.' : 'Nothing was sent.')
            } : null;
        }
        if (m) R.S.stageTitle = m.title;
        if (m && !m.parts.some(x => x.key === R.S.step)) R.S.step = _rsFirstStep(m);
        if (m && R.mode === 'kasper' && !m.gone) R.S.keepK = { item: m.item, sec: m.sec };
        return m;
    }
    function _rsFirstStep(m) { const w = _rsWaiting(m); return (w[0] || m.parts[0] || { key: '' }).key; }
    function _rsNextOpen(m, from) {
        const a = m.parts, i = a.map(x => x.key).indexOf(from);
        for (let j = 1; j <= a.length; j++) { const x = a[(i + j) % a.length]; if (x.st === 'wait') return x.key; }
        return null;
    }
    function _rsActive(m) { return !!m && m.sec !== 'tweaks' && !m.gone; }
    /* Answered elsewhere: a part that was waiting while on stage here and now is not, with no action from this page.
       Its plain words, or '' (session Curtain Ten). */
    function _rsElsewhere(m, x) {
        const S = R.S;
        if (S.moved && S.moved.id === m.id) return S.moved.text;
        if (m.gone) return S.told[Object.keys(S.told).find(k => k.indexOf(m.id + '|') === 0)] || 'This was answered in another window, so it has left your list. Nothing more to do here.';
        if (!x) return '';
        const key = m.id + '|' + x.key;
        if (x.st === 'wait') { delete S.told[key]; return ''; }
        if (S.told[key]) return S.told[key];
        if (!S.seen[key] || S.acted.has(key)) return '';
        const who = R.mode === 'client' ? ' or by your team' : '';
        return x.st === 'ok' ? 'Approved in another window' + who + '.' : 'A change was asked in another window' + who + '.';
    }

    /* ---------- the shell ---------- */
    function _rsHeaderHtml() {
        // Kasper's tab and the staff Calendar draw no header of their own: the staff Review tab sits under the
        // Calendar's own bar, the same one Sheet, Month and Week show (188), so nothing moves between the tabs.
        if (R.mode !== 'client') return '';
        const tabs = [['review', 'Review'], ['organizer', 'Sheet'], ['month', 'Month'], ['week', 'Week']];
        const right = '<a class="help-btn" id="rsHelp" href="/start#review" target="_blank" rel="noopener" aria-label="How this page works" title="How this page works" hidden>?</a>'
            + '<button class="theme-btn" id="rsTheme" type="button" aria-label="Switch to dark mode" title="Switch to dark mode"></button>';
        // The client link's header is its only one on all four tabs (188): a fixed slot holds the old bar's tools on
        // Sheet, Month and Week, left of the pill toggle, so neither the toggle nor the sun/moon button ever moves.
        const tools = '<div class="hdr-tools" id="rsTools" hidden><slot name="tools"></slot></div>';
        return '<header class="hdr"><div class="hdr-who"><h1 id="rsName"></h1><span class="sub">Content calendar</span></div>' + tools + '<div class="hdr-r">'
            + '<nav class="tabs" id="rsTabs" aria-label="Calendar views">' + tabs.map((t, i) => '<button class="cal-view-btn' + (i ? '' : ' active') + '" type="button" data-tab="' + t[0] + '">' + t[1] + (i ? '' : ' <b class="badge num" id="rsBadge"></b>') + '</button>').join('') + '</nav>'
            + right + '</div></header>';
    }
    function _rsShellHtml() {
        if (R.mode === 'kasper' && R.l2) {
            // Kasper's second layout: a list on the left, every part of the card on stage, the conversation on the right.
            return '<div class="rs in-kasper l2"><div class="app" id="rsApp">'
                + '<main class="stage" id="stage">'
                + '<aside class="ql" id="ql" aria-label="Cards waiting for your review"><div class="ql-h" id="qlHead"></div><div class="ql-l" id="qlList"></div></aside>'
                + '<section class="theatre" id="theatre" aria-label="Review this post"><div class="card">'
                + '<div class="l2h"><div class="l2t"><aside class="side" id="side" aria-label="This post"></aside><div class="sdate" id="sdate"></div></div><div class="l2a" id="l2a"></div></div>'
                + '<div class="flash" id="flash" role="status"></div>'
                + '<div id="l2note"></div><div class="l2g" id="l2g"></div>'
                + '</div></section>'
                + '<aside class="chat" id="chat" aria-label="Conversation"></aside>'
                + '<section class="recap" id="recap" hidden></section>'
                + '</main></div></div>';
        }
        return '<div class="rs' + (R.mode === 'kasper' ? ' in-kasper' : R.mode === 'client' ? ' client' : ' smm') + (R.cp ? ' cp' : '') + '"><div class="app" id="rsApp">' + _rsHeaderHtml()
            + '<nav class="strip" id="strip" aria-label="Posts waiting for review"><div class="sk-head" id="skHead"></div><div class="sk-list" id="skList"></div>'
            + (R.mode === 'kasper' ? '<div class="qp" id="qPanel" role="dialog" aria-label="Your review list" hidden></div>' : '') + '</nav>'
            + '<main class="stage" id="stage">'
            + '<aside class="side" id="side" aria-label="This post"></aside>'
            + '<section class="theatre" id="theatre" aria-label="Review this post"><div class="card">'
            + '<div class="sdate" id="sdate"></div>'
            + '<ol class="stepper" id="stepper" aria-label="Parts of this post"></ol>'
            + '<div class="flash" id="flash" role="status"></div>'
            + '<div class="view" id="view"><div class="mbox">'
            + '<div class="rs-fv" id="fvHost"></div>'
            + '<div class="player rs-novid" id="novid"><img class="poster" id="poster" alt=""><div class="vignette"></div><span class="mpill" style="--pc:var(--pd-video)"><i></i>Video</span><div class="nv" id="novidMsg"></div></div>'
            + '<div class="bigthumb" id="bigthumb"><img id="bigthumbImg" alt="The thumbnail at full size"><span class="mpill" style="--pc:var(--pd-thumbnail)"><i></i>Thumbnail</span><div class="tframe" id="tframe" hidden></div></div>'
            + '<div class="tcard" id="tcard"></div>'
            + '</div></div>'
            + '<div class="drow" id="drow"></div>'
            + '</div></section>'
            + '<aside class="chat" id="chat" aria-label="Conversation"></aside>'
            + '<section class="recap" id="recap" hidden></section>'
            + '</main></div></div>';
    }
    function _rsQ(id) { return R.root ? R.root.getElementById(id) : null; }
    // The player's own styles live in the page; the same rules are copied in here, so the player looks exactly
    // as in the Notes view (and picks up later changes to it, such as the speed buttons, without a second copy).
    function _rsPlayerCss() {
        const out = [];
        const fix = t => t.replace(/(^|[,{}]\s*)html\s+(?=\.fv-)/g, '$1').replace(/html\[data-theme="dark"\]\s+/g, ':host([data-theme="dark"]) ');
        const walk = (rules) => {
            for (const r of rules) {
                const t = r.cssText || '';
                if (r.type === 1) { if (/\.fv-/.test(r.selectorText || '') && !/cal-notes|cal-comments|cal-cm-|cal-review|cal-card|kcard/.test(r.selectorText || '')) out.push(fix(t)); }
