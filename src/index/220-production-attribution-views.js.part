                    values: () => [...new Set(_prodCurIssuesUnfiltered().map(i => i.project).filter(Boolean))].sort((a, b) => _prodDisplayClient(a).localeCompare(_prodDisplayClient(b))),
                    name: k => _prodDisplayClient(k),
