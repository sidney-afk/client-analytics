            if (s) return s;
            const key = PROD_ORDER_KEYS.has(_prodState.orderBy) ? _prodState.orderBy : 'due';
            const av = String(_prodIssueOrderValue(a, key) || '');
            const bv = String(_prodIssueOrderValue(b, key) || '');
