                + '<textarea class="prod-composer-input" data-prod-comment-input="1" maxlength="20000" placeholder="Write a comment…" oninput="_prodCommentDraftInput(' + _jsAttrArg(issue.id) + ',this.value)" onkeydown="_prodComposerKeydown(event,' + _jsAttrArg(issue.id) + ')"' + (pending ? ' disabled' : '') + '>' + _calEsc(draft.body) + '</textarea>'
                + '<div class="prod-composer-actions"><select class="prod-composer-audience" aria-label="Comment visibility" onchange="_prodCommentDraftAudience(' + _jsAttrArg(issue.id) + ',this.value)"' + (pending ? ' disabled' : '') + '><option value="internal"' + (draft.audience === 'internal' ? ' selected' : '') + '>Internal</option><option value="client"' + (draft.audience === 'client' ? ' selected' : '') + '>Client-visible</option></select><span class="prod-spacer"></span>'
                + (pending ? '<span class="prod-write-state" role="status">Saving…</span>' : '<span class="prod-write-state">Ctrl/⌘ Enter</span>')
