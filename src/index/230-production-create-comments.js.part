                    return;
                }
                const label = state.catalog[Number(row.getAttribute('data-prod-label-option'))];
                if (!label) return;
                const next = new Set(state.selectedIds || []);
                if (next.has(label.id)) next.delete(label.id);
                else next.add(label.id);
                _prodRunLabelsWrite(id, [...next]);
