                menuItem('Due date', _prodIcon('cal'), '⇧D', 'due'),
                disabled('Project', _prodIcon('project'), '⇧P', false, false, PROD_PROJECT_MOVE_UNSUPPORTED),
                '<div class="prod-msep"></div>',
