            const _kasperSessionUnlocked = (() => { try { return sessionStorage.getItem(KASPER_UNLOCK_KEY) === 'ok'; } catch (e) { return false; } })();
            const _kasperHashLanding = (hashRaw === 'kasper' || hashRaw.startsWith('kasper/'))
