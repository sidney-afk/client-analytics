        let _prodListRowBudget = Infinity;
        let _prodListDeferred = [];
        let _prodListFillSeq = 0;
        const PROD_LIST_FILL_CHUNK = 200;
        /* Measured 2026-09-23 at 1440x950: every .prod-row is 44 px tall (group
