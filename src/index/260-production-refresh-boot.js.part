                + command(plural ? 'Copy issue IDs' : 'Copy issue ID', _prodIcon('copy'), 'copy-id', 'C', false)
                + command('Change due date...', _prodIcon('cal'), 'due', 'D', true)
                + '<div class="prod-msep"></div>'
