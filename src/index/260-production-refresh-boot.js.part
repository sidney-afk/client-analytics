            if (pop && r) {
                pop.setAttribute('data-prod-bulkcmd', '1');
                pop.setAttribute('data-prod-actioncmd', '1');
                pop.setAttribute('data-prod-anchor-top', String(r.top));
                const pr = pop.getBoundingClientRect();
