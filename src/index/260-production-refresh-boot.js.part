                    _prodOpenSub(row, act, ids);
                    return;
                }
                if (act === 'copy-id') {
                    _prodClearLayer();
                    _prodCopyIssueIds(ids);
                }
            };
            rows.forEach(el => {
                el.addEventListener('mouseenter', () => {
                    const shown = visible();
                    const ix = shown.indexOf(el);
