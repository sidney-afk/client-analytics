                    const match = WL_CLIENT_NAMES.find(n => wlNormalizeClient(n) === slug);
                    if (match) _smFocusRequest = { client: match, cardId: cardId || null };
                    navTo('samples', false);
                } else if (hashRaw.startsWith('templates/')) {
