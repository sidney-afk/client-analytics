                const _kasperAlreadyUnlocked = sessionStorage.getItem(KASPER_UNLOCK_KEY) === 'ok';
                if(qp.get('Kasper')==='1'){
                    sessionStorage.setItem(KASPER_UNLOCK_KEY,'ok');
                    _kasperArrivedFromUnlockParam = !_kasperAlreadyUnlocked;
                }
                if(sessionStorage.getItem(KASPER_UNLOCK_KEY)==='ok'){
                    _kasperUnlocked=true;
                    const navKp=document.getElementById('navKasper');
                    if(navKp) navKp.style.display='';
