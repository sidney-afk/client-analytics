        _sxrPendingEdits[pid] = Object.assign(_sxrPendingEdits[pid] || {}, { [comp + '_tweaks']: _sxrStringifyComments(list) });
        _sxrWatchNoteSave(pid);
        _sxrRefreshCommentsBtn(pid);
        _sxrUpdateCardStatusDisplay(pid);
