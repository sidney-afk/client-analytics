            + n + (n === 1 ? ' sample is' : ' samples are') + ' waiting on SMM approval but cannot be reviewed here yet, '
            + 'because no video or thumbnail has landed on ' + (n === 1 ? 'it' : 'them') + ' — '
            + names + more + '.</div>';
    }
    function renderSxrReview() {
