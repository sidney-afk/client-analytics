    function _sxrKasperAppendFinishLog(post, stampIso) {
        let log = []; try { log = JSON.parse(post.kasper_finish_log || '[]'); if (!Array.isArray(log)) log = []; } catch { log = []; }
        const prev = log.length ? log[log.length - 1].at : null;
