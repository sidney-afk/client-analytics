import { clientMap, showConfirm, showNotify } from './040-shared-briefs.js';
import { WL_CLIENT_NAMES } from './070-core-client-names.js';
import { svSharedClientFor, svSharedClientNote } from './095-shared-client.js';
import { CAL_SUPABASE_URL, _svDateHtml, _svSelectHtml } from './100-onboarding-staff-controls.js';
import { _syncviewEfHeaders, _writeUiRecordFailure, _writeUiTrackSave, computeOverallStatus } from './120-calendar-flags-write-repair.js';
import { CAL_PLATFORM_BY_KEY, calClientSlug, calState } from './130-calendar-model-cache.js';
import { _calCacheRead, _calV2FetchPosts } from './150-calendar-hydration-import.js';
import { _calDeriveThumb } from './160-calendar-organize-ui.js';
import { svPostNetworksOn, svPostSourcesOn, svTrialVersionsV2On } from './188-review-stage-switch.js';
import { svTrialListShared } from './189-trial-reels-card.js';
    /* ============================================================
       INSTAGRAM UPLOAD (the Instagram side of the Post tab, once called TikTok Upload)
       Posts a video to a client's Instagram through Post For Me. Unlike TikTok, which
       runs through n8n webhooks, everything here talks to ONE Supabase function,
       `instagram-upload`, which holds the Post For Me key and keeps the queue in the
       `instagram_uploads` table (owner, 2026-09-30: new server work goes in Supabase).

       The client's Instagram account id (the Post For Me connection id, spc_...) is on
       the client's SyncView profile as `postforme_instagram_account_id` (set through
       roster-write; the Clients Info sheet only holds a copy), next to the TikTok one
       (`postforme_account_id`). No id, no post: there is no fallback, so a video can
       never land on another client's account.

       Also to Facebook (2026-10-31, OPEN_REPAIRS 620): Instagram's own "also share to Facebook" does
       not apply to a post published through the API, so a client whose Facebook Page is on its profile
       (`postforme_facebook_account_id`, set on the Kasper Clients tab) gets an "Also post to Facebook"
       box, ticked by default. When it is ticked the function sends ONE Post For Me post to both accounts
       (a Reel as a Facebook Reel; a carousel of photos as a Facebook multi-photo post). A trial reel and
       a carousel with a video stay Instagram only, and the box says why. Each network's result is shown
       on its own in the queue.

       The TikTok module (300) owns the tab, the platform switch and the shared helpers;
       it hands them in through `deps` so the two files never import each other.
       ============================================================ */
    const IG_FUNCTION_URL = CAL_SUPABASE_URL + '/functions/v1/instagram-upload';
    const IG_ACCOUNT_RE = /^spc_[A-Za-z0-9]{6,80}$/;
    const IG_ACCOUNT_COLUMN = 'postforme_instagram_account_id';
    const IG_FACEBOOK_COLUMN = 'postforme_facebook_account_id';
    // YouTube and LinkedIn (post_networks_v1, plan row P3): read from the client's profile as Facebook's is; the server
    // checks each against the profile and against Post for Me before anything is written.
    const IG_YOUTUBE_COLUMN = 'postforme_youtube_account_id';
    const IG_LINKEDIN_COLUMN = 'postforme_linkedin_account_id';
    const IG_KIDS_COLUMN = 'youtube_made_for_kids';
    const IG_YT_TITLE_MAX = 100;
    const IG_YT_SHORT_MAX_SECONDS = 180;
    const IG_YT_DESCRIPTION_MAX_BYTES = 5000;
    const IG_MAX_CAPTION = 2200;
    // Client info lives on the SyncView client profile; the Clients Info sheet is only a copy of it.
    // Since L1 (3 Nov) a client's Post for Me accounts link themselves every hour on an exact handle match, so the
    // message says to connect it there (OPEN_REPAIRS 653).
    const IG_NO_ACCOUNT_MSG = "No Instagram account linked to this client yet. Connect it in Post for Me: it links itself here within the hour. If it still isn't here after that, ask Sidney.";
    const IG_STATUS_LABELS = { uploading: 'Uploading', processing: 'Posting', scheduled: 'Scheduled', posted: 'Posted', failed: 'Failed', cancelled: 'Cancelled' };
    const IG_UPCOMING = ['uploading', 'processing', 'scheduled'];
    const IG_COVER_MAX_BYTES = 8 * 1024 * 1024;     // Instagram's own limit for a cover image
    const IG_COVER_RATIO = 9 / 16;
    const IG_CALL_TIMEOUT_MS = 30000;
    const IG_QUEUE_PAGE = 5;
    // A carousel: one feed post of 2 to 10 images and videos (Instagram's own limits). The server checks the count too.
    const IG_CAROUSEL_MIN = 2;
    const IG_CAROUSEL_MAX = 10;
    const IG_CAROUSEL_IMAGE_MAX_BYTES = 8 * 1024 * 1024;   // Instagram's limit for a feed image

    const igState = {
        client: null,
        kind: 'reel',                // 'reel' (one video) | 'carousel' (2 to 10 images and videos, one feed post)
        file: null,
        objectUrl: null,
        items: [],                   // carousel only: [{ file, objectUrl, isVideo }], carousel order = array order
        title: '',
        titleFromCard: '',           // the caption a Calendar card filled in, while unedited
        captionFill: null,           // { name, text, from? }: the caption a file name or a folder's text filled in, while it can be undone
        // A dropped folder (post_sources_v1): its pick list while it needs a person ({ sorted, seq }), and its line.
        drop: null,
        dropNote: '',
        dropSeq: 0,
        // The Reel cover: an image (uploaded, or copied from a Calendar card) or a frame of the video. Optional.
        cover: { mode: 'image', blob: null, url: '', name: '', source: '', note: '', dims: '', frameMs: 0, frameUrl: '', duration: 0, cardId: '', remoteUrl: '' },
        // "From a card" (post_sources_v1): the card whose video post-source copied (svPostSourceNew). remoteUrl above
        // is its thumbnail, already in Post for Me storage, used as the cover until the person picks another.
        source: null,
        schedule: { postNow: true, date: '', hour: '', minute: '', ampm: 'AM', tz: 'America/New_York' },
        trial: false,                // post as a trial reel (non-followers first; shared to followers only in the Instagram app)
        facebookOff: false,          // the person unticked "Also post to Facebook" for this client (ticked again on a client change)
        // Which side this panel is (OPEN_REPAIRS 687): 'instagram', or 'youtube' / 'linkedin' behind post_networks_v1.
        network: 'instagram',
        // The YouTube side's title (the caption's first line until typed into) and format.
        yt: { title: '', edited: false, format: 'short' },
        videoDims: null,             // { w, h } of the dropped video, once its metadata is read
        // P4: a trial card picked "From a card" with Trial reel on posts each approved version as its own trial reel.
        // { cardId, state: 'loading'|'ready'|'failed', isTrial, versions, off: { letter: true }, res: { letter: { state, message } } }
        trialVersions: null,
        trialAttempt: null,          // { cardId, client, letters: { A: { fp, key, done } } }: each version's key and "sent", for this card
        instagramOn: true,           // false only when the person unticked Instagram (post_networks_v1); read by _igValidate
        attempt: null,               // { fp, key }: the retry-safe key, kept while an attempt's outcome is unknown
        carouselAttempt: null,       // the same for a carousel, kept apart so switching Reel / Carousel never loses either
        phase: '',                   // '', 'preparing', 'uploading', 'creating'
        uploads: [],
        queueReadState: 'loading',   // only a successful read proves an empty queue
        queueTab: 'upcoming',
        queueLimit: IG_QUEUE_PAGE,
        submitting: false,
        error: null,
        notice: null,
        progress: 0,
    };
    let _igDeps = null;
    let _igMounted = false;
    // The post_sources_v1 answer may arrive after the form is drawn: draw it again then (registered once, at load).
    try { window.addEventListener('sv-review-stage-switch', () => { if (_igMounted && !igState.submitting) _igRenderForm(); }); } catch (e) { /* no window: nothing to redraw */ }
    let _igPollTimer = null;
    let _igActiveXhr = null;
    let _igAbort = null;           // aborts every step before the post is created

    const _igEsc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    // Beside every "no account" message on both sides of the Post tab: a link that opens Post for Me in a new tab,
    // where the account is connected (plan row N1, decision D7, OPEN_REPAIRS 646). A link and nothing else.
    const SV_POSTFORME_URL = 'https://www.postforme.dev';
    function svPostForMeLinkHtml() {
        return ` <a class="tk-pfm-link" href="${SV_POSTFORME_URL}" target="_blank" rel="noopener">Open Post for Me</a>`;
    }

    // The client's Instagram connection id. Staff pages read the sheet columns directly, or (once the analytics
    // database is on) receive any column the copy does not know by name inside `extra`; both are accepted.
    function _igProfileValue(client, column) {
        const row = (client && clientMap[client]) || null;
        if (!row) return '';
        const direct = String(row[column] || '').trim();
        if (direct) return direct;
        const extra = row.extra && typeof row.extra === 'object' ? row.extra : null;
        return extra ? String(extra[column] || '').trim() : '';
    }
    function _igResolveAccount(client) { return _igProfileValue(client, IG_ACCOUNT_COLUMN); }
    function _igResolveFacebook(client) { return _igProfileValue(client, IG_FACEBOOK_COLUMN); }

    // "Also post to Facebook": { enabled, checked, reason }. Ticked by default when the client's Facebook Page
    // is on file; off, with the reason in plain words, when it cannot go to Facebook.
    function _igFacebookState() {
        if (!igState.client) return { enabled: false, checked: false, reason: '' };
        const fb = _igResolveFacebook(igState.client);
        if (!IG_ACCOUNT_RE.test(fb)) return { enabled: false, checked: false, noAccount: true, reason: 'No Facebook Page linked to this client yet. Connect it in Post for Me, then ask Sidney to link it to the client\'s profile: a Page does not link itself.' };
        if (igState.kind === 'reel' && igState.trial) return { enabled: false, checked: false, reason: 'Trial reels are an Instagram feature, so this one posts to Instagram only.' };
        if (igState.kind === 'carousel' && igState.items.some(it => it.isVideo)) return { enabled: false, checked: false, reason: 'Facebook takes a carousel of photos only. This one has a video, so it posts to Instagram only.' };
        return { enabled: true, checked: !igState.facebookOff, reason: '' };
    }
    function _igFacebookCardHtml() {
        if (!igState.client) return '';
        const st = _igFacebookState();
        const dis = !st.enabled || igState.submitting;
        const what = igState.kind === 'carousel' ? 'The photos also go to the client\'s Facebook Page as one post.' : 'The Reel also goes to the client\'s Facebook Page as a Facebook Reel.';
        return `<div class="tk-card" id="igFacebookCard">
                <div class="tk-sched-head"><h3>Facebook</h3>
                    <label class="tk-toggle${st.enabled ? '' : ' is-off'}">
                        <input type="checkbox" id="igFacebook" ${st.checked ? 'checked' : ''} ${dis ? 'disabled' : ''} aria-describedby="igFacebookNote">
                        <span class="tk-toggle-track"><span class="tk-toggle-thumb"></span></span>
                        Also post to Facebook
                    </label>
                </div>
                <div class="tk-step-note" id="igFacebookNote">${_igEsc(st.enabled ? (st.checked ? what + ' Each network\'s result shows on its own in the queue.' : 'Instagram only.') : st.reason)}${st.noAccount ? svPostForMeLinkHtml() : ''}</div>
            </div>`;
    }

    /* One side per network (OPEN_REPAIRS 687, the owner on 3 Nov: "I don't understand why there's an Instagram toggle
       inside of the Instagram"). Behind post_networks_v1 the Post tab's switch has a YouTube side and a LinkedIn side;
       each is this panel with that network as the only target, sent through the same instagram-upload create (plan row
       P3). The Instagram side keeps only "Also post to Facebook". The page sends the profile's id; the server reads every
       id again from the profile and refuses any other. */
    const _igNet = () => (igState.network === 'youtube' || igState.network === 'linkedin') ? igState.network : 'instagram';
    const IG_NET_LABEL = { instagram: 'Instagram', youtube: 'YouTube', linkedin: 'LinkedIn' };
    const _igNetworksOn = () => !!igState.client && svPostNetworksOn(igState.client);
    const _igInstagramOn = () => _igNet() === 'instagram';
    // The YouTube or LinkedIn side's own account: { checked } when it can post, else the reason in plain words.
    function _igMoreState(name) {
        if (_igNet() !== name) return { enabled: false, checked: false, reason: '', id: '' };
        if (!igState.client) return { enabled: false, checked: false, reason: '', id: '' };
        if (!_igNetworksOn()) return { enabled: false, checked: false, off: true, id: '', reason: IG_NET_LABEL[name] + ' posting is not switched on for this client yet.' };
        const id = _igProfileValue(igState.client, name === 'youtube' ? IG_YOUTUBE_COLUMN : IG_LINKEDIN_COLUMN);
        if (!IG_ACCOUNT_RE.test(id)) return { enabled: false, checked: false, noAccount: true, id: '', reason: name === 'youtube'
            ? 'No YouTube account linked to this client yet. Connect it in Post for Me: it links itself here within the hour. If it still isn\'t here after that, ask Sidney.'
            : 'No LinkedIn account linked to this client yet. Connect it in Post for Me, then ask Sidney to link it to the client\'s profile: a LinkedIn account does not link itself.' };
        return { enabled: true, checked: true, id, reason: '' };
    }
    // The YouTube title: the caption's first line (no < or >, which YouTube refuses) until the person types one.
    function _igYtTitle() {
        if (igState.yt.edited) return igState.yt.title;
        const line = String(igState.title || '').split('\n').map(l => l.trim()).find(Boolean) || '';
        return line.replace(/[<>]/g, '').replace(/\s+/g, ' ').slice(0, IG_YT_TITLE_MAX);
    }
    // What the page knows of the video (the dropped file's metadata, or the card's copy): { secs, w, h }, 0 = unknown.
    function _igVideoFacts() {
        const src = igState.source;
        if (src && src.active && src.data) return { secs: Number(src.data.duration_seconds) || 0, w: Number(src.data.width) || 0, h: Number(src.data.height) || 0 };
        const d = igState.videoDims || {};
        return { secs: Number(igState.cover.duration) || 0, w: Number(d.w) || 0, h: Number(d.h) || 0 };
    }
    // Why the chosen video cannot go as a Short ('' when it can, or when its length and shape are not known).
    function _igShortProblem() {
        const f = _igVideoFacts();
        if (f.secs > IG_YT_SHORT_MAX_SECONDS) return 'A Short is at most 3 minutes; this video is ' + Math.floor(f.secs / 60) + ':' + String(Math.round(f.secs % 60)).padStart(2, '0') + '. Post it as a regular video.';
        if (f.w > 0 && f.h > 0 && f.w >= f.h) return 'A Short is a vertical video; this one is ' + f.w + '×' + f.h + '. Post it as a regular video.';
        return '';
    }
    // The networks this post goes to, by name, in the order the queue shows them.
    function _igTickedNames() {
        const net = _igNet();
        if (net !== 'instagram') return _igMoreState(net).checked ? [IG_NET_LABEL[net]] : [];
        const names = ['Instagram'];
        const fb = _igFacebookState(); if (fb.enabled && fb.checked) names.push('Facebook');
        return names;
    }
    const _igAnd = (names) => names.length > 1 ? names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1] : (names[0] || '');
    // Problems with the YouTube or LinkedIn side ('' on the Instagram side).
    function _igNetworksProblem() {
        const net = _igNet();
        if (net === 'instagram') return '';
        const st = _igMoreState(net);
        if (!igState.client) return 'Pick a client first.';
        if (!st.checked) return st.reason;
        if (net === 'youtube') {
            const t = _igYtTitle().trim();
            if (!t) return 'Add a YouTube title.';
            if (t.length > IG_YT_TITLE_MAX) return 'The YouTube title is over ' + IG_YT_TITLE_MAX + ' characters.';
            if (/[<>]/.test(t)) return 'YouTube does not take < or > in a title.';
            if (new TextEncoder().encode(igState.title.trim()).length > IG_YT_DESCRIPTION_MAX_BYTES) return 'The caption is too long for a YouTube description (5,000 bytes).';
            if (igState.yt.format === 'short') { const p = _igShortProblem(); if (p) return p; }
        }
        return '';
    }
    function _igYoutubeFieldsHtml() {
        const t = _igYtTitle();
        const short = igState.yt.format === 'short';
        const off = igState.submitting ? 'disabled' : '';
        const kids = /^(true|yes|1)$/i.test(_igProfileValue(igState.client, IG_KIDS_COLUMN));
        const problem = short ? _igShortProblem() : '';
        return `<div class="ig-yt" id="igYtFields">
                    <label class="ig-yt-label" for="igYtTitle">YouTube title <span class="tk-card-hint" id="igYtCount">${t.length} / ${IG_YT_TITLE_MAX}</span></label>
                    <input type="text" class="tpl-input" id="igYtTitle" maxlength="${IG_YT_TITLE_MAX}" value="${_igEsc(t)}" placeholder="The caption's first line" ${off}>
                    <div class="tk-radio-row tk-seg" role="radiogroup" aria-label="YouTube format">
                        <label class="tk-radio${short ? ' active' : ''}"><input type="radio" name="igYtFormat" value="short" ${short ? 'checked' : ''} ${off} style="position:absolute;opacity:0">Short</label>
                        <label class="tk-radio${short ? '' : ' active'}"><input type="radio" name="igYtFormat" value="regular" ${short ? '' : 'checked'} ${off} style="position:absolute;opacity:0">Regular video</label>
                    </div>
                    <div class="tk-step-note" id="igYtNote">${short ? 'A Short: vertical and 3 minutes or less. YouTube itself puts it on the Shorts shelf.' : 'A regular video, any shape or length.'} Public. Made for kids: ${kids ? 'Yes' : 'No'} (set on the client's profile).</div>
                    ${problem ? `<div class="tk-error" id="igYtProblem" role="alert">${_igEsc(problem)}</div>` : ''}
                </div>`;
    }
    // The YouTube side's own card: the title, Short or Regular video, and what is fixed (Public; made for kids).
    function _igYoutubeCardHtml() {
        if (_igNet() !== 'youtube' || !_igMoreState('youtube').checked) return '';
        return `<div class="tk-card" id="igYoutubeCard"><h3>YouTube</h3>${_igYoutubeFieldsHtml()}</div>`;
    }
    // The account line of a YouTube or LinkedIn side.
    function _igSideAccountLine() {
        const net = _igNet(), st = _igMoreState(net);
        if (st.checked) return `<div class="tk-profile-line">Posts to Post For Me account <span class="tk-profile-chip">${_igEsc(st.id)}</span></div>`;
        return `<div class="tk-profile-line"><span class="tk-warn-chip">⚠ ${st.off ? 'Not switched on' : 'No ' + IG_NET_LABEL[net] + ' account'}</span> ${_igEsc(st.reason)}${st.noAccount ? svPostForMeLinkHtml() : ''}</div>`;
    }

    /* Posting a trial card's versions (plan row P4, decision D3). The picked card's versions come from trial-reels'
       list, as the Calendar reads them; each approved version posts as its own Instagram trial reel with its own video,
       thumbnail and caption (V3's effective fields). Nothing else is ticked or posted afterwards. */
    function _igTrialVersionsState() {
        const src = igState.source;
        if (!(src && src.active && src.mode === 'card' && src.cardId && igState.trial && igState.kind === 'reel')) return null;
        let tv = igState.trialVersions;
        if (!tv || tv.cardId !== src.cardId || tv.client !== igState.client) {
            tv = igState.trialVersions = { cardId: src.cardId, client: igState.client, state: 'loading', isTrial: false, versions: [], off: {}, res: {} };
            const want = tv;
            let slug = '';
            try { slug = calClientSlug(String(igState.client || '')); } catch (e) { slug = ''; }
            Promise.resolve(slug ? svTrialListShared(slug) : null).then(list => {
                const c = list && list.cards ? list.cards[want.cardId] : null;
                const vs = c && c.enabled && Array.isArray(c.versions) ? c.versions : [];
                want.isTrial = vs.length > 1;
                want.versions = vs.filter(v => v.status === 'approved');
                want.state = 'ready';
            }).catch(() => { want.state = 'failed'; }).finally(() => {
                if (igState.trialVersions === want && _igMounted && !igState.submitting) _igRenderForm();
            });
        }
        return tv;
    }
    // Are the versions what this press posts? (A trial card, read, with Trial reel on.)
    function _igTrialVersionsOn() {
        const tv = _igTrialVersionsState();
        return !!(tv && tv.state === 'ready' && tv.isTrial);
    }
    const _igTrialTicked = (tv) => tv.versions.filter(v => !tv.off[v.letter]);
    // 688 part 3: "Version A" on the clients of trial_versions_v2, "Video A" elsewhere.
    const _igTrialW = () => svTrialVersionsV2On(igState.client) ? 'Version ' : 'Video ';
    const _igTrialCaption = (v) => String((v.effective && v.effective.caption) || igState.title || '').trim();
    function _igTrialVersionsProblem() {
        const tv = igState.trialVersions;
        if (!igState.client || !IG_ACCOUNT_RE.test(_igResolveAccount(igState.client))) return IG_NO_ACCOUNT_MSG;
        if (!tv.versions.length) return 'No version of this card is approved yet. A trial reel goes out once its version is approved.';
        const ticked = _igTrialTicked(tv);
        if (!ticked.length) return 'Tick at least one version to post.';
        const bare = ticked.find(v => !_igTrialCaption(v));
        if (bare) return _igTrialW() + bare.letter + ' has no caption. Add one to the version on the card, or write one in the caption box.';
        const long = ticked.find(v => _igTrialCaption(v).length > IG_MAX_CAPTION);
        if (long) return _igTrialW() + long.letter + '\'s caption is over the ' + IG_MAX_CAPTION + '-character limit.';
        if (!igState.schedule.postNow) {
            const at = _igAt();
            if (!at) return 'Pick a schedule date and time, or switch on "Post immediately".';
            const t = Date.parse(_igDeps.wallClockToUTC(at, igState.schedule.tz) || '');
            if (!Number.isFinite(t) || t < Date.now()) return 'The schedule time is in the past.';
        }
        return '';
    }
    function _igTrialVersionsHtml() {
        const tv = _igTrialVersionsState();
        if (!tv) return '';
        if (tv.state === 'loading') return '<div class="tk-step-note" id="igTrialVersions" role="status">Reading this card\'s versions…</div>';
        if (tv.state === 'failed') return '<div class="tk-step-note" id="igTrialVersions" role="alert">This card\'s versions could not be read, so it posts as one trial reel of the video on the card.</div>';
        if (!tv.isTrial) return '';
        const off = igState.submitting ? 'disabled' : '';
        const label = { copying: 'Copying from Frame…', posting: 'Posting…', done: 'Sent', failed: 'Failed' };
        const rows = tv.versions.map(v => {
            const went = !!(igState.trialAttempt && igState.trialAttempt.cardId === tv.cardId && igState.trialAttempt.letters[v.letter] && igState.trialAttempt.letters[v.letter].done);
            const r = went ? { state: 'done' } : (tv.res[v.letter] || {});
            const thumb = (function () { try { return _calDeriveThumb({ thumbnail_url: v.effective && v.effective.thumbnail_url }); } catch (e) { return ''; } })();
            const cap = _igTrialCaption(v);
            return `<label class="ig-trv-row" data-ig-trv-row="${_igEsc(v.letter)}">
                    <input type="checkbox" data-ig-trv="${_igEsc(v.letter)}" ${tv.off[v.letter] && !went ? '' : 'checked'} ${off || went ? 'disabled' : ''}>
                    ${thumb ? `<img class="ig-trv-thumb" src="${_igEsc(thumb)}" alt="" loading="lazy">` : '<span class="ig-trv-thumb" aria-hidden="true"></span>'}
                    <span class="ig-trv-text"><strong>${_igTrialW()}${_igEsc(v.letter)}</strong><span class="ig-trv-cap">${cap ? _igEsc(cap.split('\n')[0]) : 'No caption'}</span></span>
                    ${r.state ? `<span class="ig-trv-state${r.state === 'failed' ? ' is-failed' : ''}" title="${_igEsc(r.message || '')}">${label[r.state] || ''}</span>` : ''}
                </label>${r.state === 'failed' && r.message ? `<div class="tk-queue-error ig-trv-why">${_igEsc(r.message)}</div>` : ''}`;
        }).join('');
        return `<div class="ig-trv" id="igTrialVersions">
                <div class="tk-step-note">This card is on trial. Each approved version posts as its own trial reel, with its own video, thumbnail and caption. Instagram only; nothing is posted anywhere afterwards.</div>
                ${tv.versions.length ? rows : '<div class="tk-step-note" role="status">No version of this card is approved yet.</div>'}
            </div>`;
    }
    // One version's copy: the version on the card goes as the card; any other by its letter (post-source, P4).
    async function _igTrialCopy(client, cardId, v) {
        const body = { client, post_id: cardId, side: 'instagram' };
        if (!v.on_card) body.letter = v.letter;
        const res = await _svPostSourceAsk(SV_POST_SOURCE_URL, body, SV_POST_SOURCE_TIMEOUT_MS);
        if (res.status === 200 && res.json && res.json.ok && res.json.media_url) return { ok: true, data: res.json };
        _igRecordFailure('post_source_copy', res.status || 0, !res.status);
        return { ok: false, message: _svPostSourceFail(res) };
    }
    /* One press, one post per ticked version, each with its own key. Each version keeps its key and its "sent" for
       this card, whatever else changes (Codex P1 on PR 2573): a version that went is never sent again, even when the
       ticks, the fallback caption or the time change after a partial failure; a version whose answer was lost keeps
       its key while what it would post is unchanged, so the server adopts that post instead of making a second. A
       request that throws (a timeout, a lost connection) counts as a lost answer, and the form is always given back. */
    async function _igSubmitTrialVersions() {
        const tv = igState.trialVersions;
        const err = _igTrialVersionsProblem();
        if (err) { igState.error = err; _igRenderForm(); return; }
        const client = igState.client, account = _igResolveAccount(client), cardId = tv.cardId;
        const wall = igState.schedule.postNow ? '' : _igAt();
        const utc = wall ? (_igDeps.wallClockToUTC(wall, igState.schedule.tz) || '') : '';
        if (wall && !utc) { igState.error = 'That schedule time is not valid.'; _igRenderForm(); return; }
        const ticked = _igTrialTicked(tv);
        let ta = igState.trialAttempt;
        if (!ta || ta.cardId !== cardId || ta.client !== client) ta = igState.trialAttempt = { cardId, client, letters: {} };
        const pressKey = (crypto.randomUUID && crypto.randomUUID().replace(/-/g, '')) || ('ig' + Date.now() + Math.random().toString(36).slice(2));
        igState.submitting = true; igState.error = null; igState.notice = null; igState.phase = 'creating';
        _igRenderForm();
        let unknown = false;
        try {
            for (const v of ticked) {
                const fp = [client, cardId, v.letter, _igTrialCaption(v), utc].join('|');
                let one = ta.letters[v.letter];
                if (one && one.done) { tv.res[v.letter] = { state: 'done' }; continue; }
                if (!one || one.fp !== fp) one = ta.letters[v.letter] = { fp, key: pressKey + '_' + v.letter, done: false };
                tv.res[v.letter] = { state: 'copying' }; _igRenderForm();
                const copy = await _igTrialCopy(client, cardId, v);
                if (!copy.ok) { tv.res[v.letter] = { state: 'failed', message: copy.message }; _igRenderForm(); continue; }
                tv.res[v.letter] = { state: 'posting' }; _igRenderForm();
                let created;
                try {
                    created = await _igCall({
                        action: 'create', clientName: client, socialAccountId: account, title: _igTrialCaption(v),
                        mediaUrl: copy.data.media_url, coverUrl: copy.data.thumb_url || '', options: { cover_timestamp_ms: 0, trial_reel_type: 'manual' },
                        scheduledAtUTC: utc, timezone: igState.schedule.tz, idempotencyKey: one.key,
                    }, 'instagram_create');
                } catch (e) {
                    created = { ok: false, status: 0, json: null };
                }
                if (created.ok) {
                    const row = created.json && created.json.row;
                    one.done = true;
                    if (row) igState.uploads = [row].concat(igState.uploads.filter(r => r.id !== row.id));
                    tv.res[v.letter] = { state: 'done' };
                } else {
                    const final = created.status > 0 && _igCreateAnswerIsFinal(created);
                    // A clear "no" made nothing: the next press may start afresh. An unknown outcome keeps the key.
                    if (final) delete ta.letters[v.letter]; else unknown = true;
                    const reason = (created.status > 0 && _igCreateRefusalReason(created)) || (created.json && created.json.error) || '';
                    tv.res[v.letter] = { state: 'failed', message: final ? ('Instagram did not take it' + (reason ? ': ' + reason : '.')) : 'Not confirmed. Press again: it cannot post twice.' };
                }
                _igRenderForm(); _igRenderQueue();
            }
        } finally {
            igState.submitting = false; igState.phase = '';
        }
        const sent = ticked.filter(v => ta.letters[v.letter] && ta.letters[v.letter].done).length;
        if (sent === ticked.length) {
            igState.trialAttempt = null;
            svPostSourceClear(igState.source);
            igState.trialVersions = null;
            igState.title = ''; igState.titleFromCard = ''; igState.captionFill = null; igState.trial = false;
            igState.notice = (utc ? 'Scheduled ' : 'Sent ') + sent + ' trial reel' + (sent === 1 ? '' : 's') + (utc ? '. They will appear in the queue.' : '. Each shows as Posted here once Instagram confirms.');
            igState.queueTab = 'upcoming';
        } else {
            igState.error = sent + ' of ' + ticked.length + ' went. Press again to send the rest: the ones that went are not sent again.' + (unknown ? ' One answer was lost, so check the queue too.' : '');
        }
        _igRenderForm(); _igRenderQueue(); _igSchedulePoll();
    }

    // "Post to Instagram" as before; with the switch on, the one network's name, or "Post to 3 networks".
    function _igTrialButtonLabel() {
        const n = _igTrialTicked(igState.trialVersions).length;
        return svPlatformLogo('instagram') + '<span>' + (igState.schedule.postNow ? 'Post ' : 'Schedule ') + n + ' trial reel' + (n === 1 ? '' : 's') + '</span>';
    }
    function _igButtonLabel() {
        return svPostButtonLabel(_igNet(), igState.schedule.postNow);
    }

    function _igRecordFailure(operation, status, network) {
        const shape = { message: status ? 'HTTP ' + status : (network ? 'network error' : 'upload rejected') };
        if (status) shape.status = status;
        else if (network) shape.network = true;
        _writeUiRecordFailure('tiktok', operation, shape, {});
    }

    // One call to the function. Returns { ok, status, json }; a bad answer never throws, a network failure does.
    async function _igCall(payload, track, userSignal) {
        const timeout = (AbortSignal.timeout ? AbortSignal.timeout(IG_CALL_TIMEOUT_MS) : undefined);
        const signal = (userSignal && timeout && AbortSignal.any) ? AbortSignal.any([userSignal, timeout]) : (userSignal || timeout);
        const send = () => fetch(IG_FUNCTION_URL, {
            method: 'POST',
            headers: _syncviewEfHeaders({ 'Content-Type': 'application/json', Accept: 'application/json' }, IG_FUNCTION_URL),
            body: JSON.stringify(payload),
            cache: 'no-store',
            signal,
        });
        const resp = track ? await _writeUiTrackSave('tiktok', track, {}, send) : await send();
        let json = null;
        try { json = await resp.json(); } catch { json = null; }
        return { ok: !!(resp.ok && json && json.ok !== false), status: resp.status, json };
    }

    function _igClientNames() {
        return (WL_CLIENT_NAMES || []).slice().sort((a, b) => a.localeCompare(b));
    }

    function renderInstagramPanel() {
        return `
            <div class="tk-col tk-form-col" id="igFormCol" hidden></div>
            <div class="tk-col tk-right-col" id="igRightCol" hidden><div id="igPreviewCol"></div><div id="igQueueCol"></div></div>
        `;
    }


    /* ---- Cover ----------------------------------------------------------------------------------
       Post For Me takes a Reel cover on the media item, two ways: `thumbnail_url` (an image in its
       storage) or `thumbnail_timestamp_ms` (a frame of the video). The form offers both, plus the
       thumbnail of a Calendar card as a ready-made image. Only one is ever sent. */
    const _igCover = () => igState.cover;
    const _igSrc = () => (igState.source || (igState.source = svPostSourceNew()));
    // `active` is kept on the source itself, so the functions the tests lift alone (_igValidate, _igLeaveClient) read
    // only igState.
    const _igFromCard = () => { const s = _igSrc(); s.active = svPostSourceActive(s, igState.client, igState.kind === 'reel'); return s.active; };
    function _igCoverClear(keepMode) {
        const c = _igCover();
        if (c.url) { try { URL.revokeObjectURL(c.url); } catch (e) {} }
        igState.cover = Object.assign({}, c, { blob: null, url: '', name: '', source: '', note: '', dims: '', cardId: '', remoteUrl: '', frameUrl: keepMode ? c.frameUrl : '' });
    }
    // The client's Calendar cards that can still go out: the live Calendar if it is showing this client, otherwise
    // its saved copy on this device. Read only; nothing is fetched here.
    //  - only cards that are Approved or Scheduled (never Posted, never still in review);
    //  - a card with a posting date in the past is left out;
    //  - order: cards dated today or later first, soonest first; then cards with no posting date, in the order
    //    they appear on the Calendar (its manual order).
    // Each card is named the way the Calendar names it (for example "Video 15").
    function _igCalendarCards(client) {
        if (!client) return [];
        let posts = [];
        try {
            const slug = calClientSlug(client);
            if (calState && calState.client && calClientSlug(calState.client) === slug && Array.isArray(calState.posts) && calState.posts.length) posts = calState.posts;
            else { const cached = _calCacheRead(slug); posts = (cached && cached.posts) || []; }
        } catch (e) { posts = []; }
        const today = _igTodayIso();
        const byManual = (a, b) => Number(a.order || 0) - Number(b.order || 0);
        const cards = posts
            .filter(p => p && p.id && !p.archived && String(p.id).indexOf('p_cal_settings') !== 0)
            .filter(p => { let st = ''; try { st = computeOverallStatus(p); } catch (e) { st = String(p.status || ''); } return st === 'Approved' || st === 'Scheduled'; })
            .map(p => {
                const iso = String(p.scheduled_date || '').slice(0, 10);
                return {
                    id: String(p.id), date: /^\d{4}-\d{2}-\d{2}$/.test(iso) ? iso : '', order: p.order_index,
                    name: String(p.name || '').replace(/\s+/g, ' ').trim() || 'Untitled card',
                    caption: String(p.caption || '').trim(),
                    captionAlt: String(p.caption_alt || '').trim(),
                    captionAltPlatform: String(p.caption_alt_platform || '').trim().toLowerCase(),
                    link: String(p.asset_url || '').trim(),
                    thumb: (function () { try { return _calDeriveThumb(p); } catch (e) { return ''; } })(),
                };
            })
            .filter(c => !c.date || c.date >= today);
        const dated = cards.filter(c => c.date).sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : byManual(a, b));
        const undated = cards.filter(c => !c.date).sort(byManual);
        return dated.concat(undated).slice(0, 80).map(c => Object.assign(c, { label: c.name }));
    }
    /* ---- From a card (both sides of the Post tab; plan row P1, part P1b, OPEN_REPAIRS 651) ----------------------
       Behind post_sources_v1 (188). The person picks one of the client's Approved or Scheduled cards
       (_igCalendarCards). The server function post-source copies the card's video, and its thumbnail, from Frame.io
       into Post for Me storage, so the file never passes through this browser (a phone included). The post then
       carries that storage address. The page shows Frame's small copy in a plain <video> (asked of frameio-view,
       as the Calendar's player asks) and one line naming the file, its size and which Frame file went.
       Post for Me deletes an upload no post uses after 24 hours, so a copy older than SV_POST_SOURCE_MAX_AGE_MS is
       made again at the press. Each side keeps its own state (svPostSourceNew) and draws it with these helpers. */
    const SV_POST_SOURCE_URL = CAL_SUPABASE_URL + '/functions/v1/post-source';
    const SV_FRAMEIO_VIEW_URL = CAL_SUPABASE_URL + '/functions/v1/frameio-view';
    const SV_POST_SOURCE_MAX_AGE_MS = 20 * 60 * 60 * 1000;
    const SV_POST_SOURCE_TIMEOUT_MS = 150000;
    const SV_POST_SOURCE_RENDITIONS = { original: "Frame's original file", high_quality: "Frame's full-size copy", efficient: "Frame's small copy" };
    function svPostSourceNew() {
        // "From Content Calendar" is where a post starts (OPEN_REPAIRS 687); "From files" is the second choice.
        return { mode: 'card', cardId: '', cardName: '', client: '', state: '', data: null, message: '', previewUrl: '', copiedAt: 0, seq: 0 };
    }
    // Is "From a card" offered here? The switch, a client, and a single video (not a carousel or photos).
    function svPostSourceOffered(client, singleVideo) {
        return !!client && !!singleVideo && svPostSourcesOn(client);
    }
    // Using a card: the switch is on and the person chose "From a card".
    function svPostSourceActive(src, client, singleVideo) {
        return !!src && src.mode === 'card' && svPostSourceOffered(client, singleVideo);
    }
    function svPostSourceReady(src) { return !!src && src.state === 'ready' && !!(src.data && src.data.media_url); }
    // Young enough that Post for Me still holds the copy (it deletes an unused upload after 24 hours).
    function svPostSourceYoung(src) { return !!src && Date.now() - (Number(src.copiedAt) || 0) < SV_POST_SOURCE_MAX_AGE_MS; }
    // The card's caption for this network: its second caption when written for it, else the first (as the file-name fill).
    function svPostSourceCaption(card, platform) {
        if (!card) return '';
        return (card.captionAlt && card.captionAltPlatform === platform) ? card.captionAlt : card.caption;
    }
    async function _svPostSourceAsk(url, body, timeoutMs) {
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timer = ctrl ? setTimeout(() => { try { ctrl.abort(); } catch (e) {} }, timeoutMs) : null;
        try {
            const resp = await fetch(url, { method: 'POST', headers: _syncviewEfHeaders({ 'Content-Type': 'application/json' }, url), body: JSON.stringify(body), signal: ctrl ? ctrl.signal : undefined });
            const json = await resp.json().catch(() => null);
            return { status: resp.status, json };
        } catch (e) {
            return { status: 0, json: null, aborted: !!(ctrl && ctrl.signal.aborted) };
        } finally { if (timer) clearTimeout(timer); }
    }
    function _svPostSourceFail(res) {
        const j = res && res.json;
        if (j && j.message) return String(j.message);
        if (res && (res.status === 401 || res.status === 403)) return 'Your staff sign-in was not accepted for this. Sign in again and retry.';
        if (res && res.aborted) return 'Copying from Frame took too long. Try again, or download the video from Frame and drop it here.';
        if (res && !res.status) return 'The copy could not start. Check your connection and try again.';
        return 'The copy from Frame did not finish. Try again, or download the video from Frame and drop it here.';
    }
    // One copy: { ok, data } or { ok:false, message }. Nothing is changed on the card.
    async function svPostSourceCopy(client, cardId, side) {
        const res = await _svPostSourceAsk(SV_POST_SOURCE_URL, { client, post_id: cardId, side }, SV_POST_SOURCE_TIMEOUT_MS);
        if (res.status === 200 && res.json && res.json.ok && res.json.media_url) return { ok: true, data: res.json };
        _igRecordFailure('post_source_copy', res.status || 0, !res.status);
        return { ok: false, message: _svPostSourceFail(res) };
    }
    /* Pick a card: copy its video (and thumbnail) and ask Frame for its small copy to show. A later pick, a client
       change or Remove retires an answer still on its way (seq). onDone(card) runs once a copy is in, for the
       caller's caption and cover. */
    async function svPostSourcePick(src, opts) {
        const card = (_igCalendarCards(opts.client) || []).find(c => c.id === opts.cardId);
        const seq = ++src.seq;
        Object.assign(src, { cardId: card ? card.id : '', cardName: card ? card.name : '', client: opts.client || '', data: null, message: '', previewUrl: '', copiedAt: 0, state: card ? 'copying' : '' });
        opts.rerender();
        if (!card) return;
        // A later pick, Remove, a client change or a switch back to "From files" retires this one (Codex P2 on #2555):
        // an abandoned card never fills the caption or the cover.
        const live = () => src.seq === seq && src.cardId === card.id && src.client === opts.client && src.mode === 'card';
        if (card.link) {
            _svPostSourceAsk(SV_FRAMEIO_VIEW_URL, { link: card.link, part: 'video' }, 30000).then(res => {
                const v = res.json && res.json.ok && res.json.video;
                const url = v && ((v.renditions && v.renditions.efficient) || v.url);
                if (!live() || !url) return;
                src.previewUrl = String(url);
                opts.rerender();
            });
        }
        const out = await svPostSourceCopy(opts.client, card.id, opts.side);
        if (!live()) return;
        if (out.ok) { src.state = 'ready'; src.data = out.data; src.copiedAt = Date.now(); }
        else { src.state = 'failed'; src.message = out.message; }
        if (out.ok && typeof opts.onDone === 'function') opts.onDone(card, out.data);
        opts.rerender();
    }
    // At the press: the copy, made again first when it is old enough that Post for Me may have deleted it.
    async function svPostSourceFresh(src, side) {
        if (!svPostSourceReady(src)) throw new Error('Pick a card and wait for its video to be copied.');
        if (svPostSourceYoung(src)) return src.data;
        const out = await svPostSourceCopy(src.client, src.cardId, side);
        if (!out.ok) throw new Error(out.message);
        src.data = out.data; src.copiedAt = Date.now();
        return src.data;
    }
    function svPostSourceClear(src) {
        src.seq++;
        Object.assign(src, { cardId: '', cardName: '', client: '', state: '', data: null, message: '', previewUrl: '', copiedAt: 0 });
    }
    // The line under the video: what goes, in plain words.
    function svPostSourceFacts(d) {
        if (!d) return '';
        const parts = [];
        if (d.width && d.height) parts.push(d.width + '×' + d.height);
        if (d.bytes) parts.push(_svPostSourceBytes(d.bytes));
        if (d.duration_seconds) parts.push(Math.round(d.duration_seconds) + ' s');
        parts.push(SV_POST_SOURCE_RENDITIONS[d.rendition] || 'from Frame');
        return parts.join(' · ');
    }
    function _svPostSourceBytes(n) {
        const mb = n / (1024 * 1024);
        return mb >= 10 ? Math.round(mb) + ' MB' : mb >= 1 ? mb.toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB';
    }
    // "From files" / "From a card", above the video card's body.
    /* Where the video comes from: the house's small two-option row (the Notes composer's "Who sees this?",
       cal-cm-audience), so it never reads as a second post-type switch like the big Video / Carousel control above it
       (the owner, 3 Nov; OPEN_REPAIRS 687). */
    function svPostSourceModeHtml(prefix, src, disabled) {
        const mode = src.mode === 'files' ? 'files' : 'card';
        return `<div class="cal-cm-audience tk-src-switch" role="radiogroup" aria-label="Where the video comes from"><span class="cal-cm-audience-cap">Video from</span><div class="cal-cm-aud-seg">${[['card', 'From Content Calendar'], ['files', 'From files']].map(([v, label]) =>
            `<label class="cal-cm-aud-btn${mode === v ? ' is-active' : ''}"><input type="radio" name="${prefix}SrcMode" value="${v}" ${mode === v ? 'checked' : ''} ${disabled ? 'disabled' : ''}>${label}</label>`).join('')}</div></div>`;
    }
    // The card picker and what the copy has done so far.
    function svPostSourceCardHtml(prefix, src, client, disabled) {
        const cards = _igCalendarCards(client);
        if (!cards.length) return `<div class="tk-step-note" id="${prefix}SrcEmpty">No Approved or Scheduled cards from today on. Choose From files to drop the file instead.</div>`;
        const pick = _svSelectHtml(prefix + 'SrcCard', cards.map(x => ({ value: x.id, label: x.date ? x.label + ' · ' + x.date : x.label })), src.cardId || '', 'Pick a card…', { disabled });
        let body = '';
        if (src.state === 'copying') {
            body = `<div class="tk-step-note" role="status" id="${prefix}SrcStatus">Copying ${_igEsc(src.cardName)} from Frame… This takes a few seconds. Nothing is downloaded to this device.</div>`;
        } else if (src.state === 'failed') {
            body = `<div class="tk-step-note" role="alert" id="${prefix}SrcStatus">${_igEsc(src.message)}</div>
                <div class="tk-file-actions" style="margin-top:8px"><button type="button" class="tk-mini-btn" id="${prefix}SrcRetry" ${disabled ? 'disabled' : ''}>Try again</button></div>`;
        } else if (svPostSourceReady(src)) {
            const d = src.data;
            const video = src.previewUrl
                ? `<video id="${prefix}SrcPreview" src="${_igEsc(src.previewUrl)}" playsinline controls preload="metadata" muted></video>`
                : '';
            const fell = d.fell_back_from_original ? `<div class="tk-step-note">Frame did not allow its original file, so its full-size copy goes instead.</div>` : '';
            body = `<div class="tk-file-card" id="${prefix}SrcReady">${video}
                    <div class="tk-file-meta">
                        <div class="tk-file-meta-text">
                            <div class="tk-file-name">${_igEsc(d.file_name || src.cardName)}</div>
                            <div class="tk-file-size" id="${prefix}SrcFacts">${_igEsc(svPostSourceFacts(d))}</div>
                        </div>
                        <div class="tk-file-actions"><button type="button" class="tk-mini-btn" id="${prefix}SrcRemove" ${disabled ? 'disabled' : ''}>Remove</button></div>
                    </div>
                </div>${fell}`;
        }
        return `<div style="margin-bottom:${body ? '12px' : '0'}">${pick}</div>${body}`;
    }
    // Wires the controls drawn above. ctx: { client, side, rerender, onDone, onMode }.
    function svPostSourceBind(prefix, src, ctx) {
        document.querySelectorAll(`input[name="${prefix}SrcMode"]`).forEach(r => r.addEventListener('change', (e) => {
            src.mode = e.target.value === 'card' ? 'card' : 'files';
            // Back to files: a copy still on its way is dropped, so it can never fill the form later.
            if (src.mode === 'files' && src.state === 'copying') svPostSourceClear(src);
            if (typeof ctx.onMode === 'function') ctx.onMode(src.mode);
            ctx.rerender();
        }));
        const pick = (id) => svPostSourcePick(src, { client: ctx.client, cardId: id, side: ctx.side, rerender: ctx.rerender, onDone: ctx.onDone });
        document.getElementById(prefix + 'SrcCard')?.addEventListener('change', (e) => { pick(e.target.value); });
        document.getElementById(prefix + 'SrcRetry')?.addEventListener('click', () => { pick(src.cardId); });
        document.getElementById(prefix + 'SrcRemove')?.addEventListener('click', () => { svPostSourceClear(src); ctx.rerender(); });
    }
    /* ---- Caption from the Calendar (both sides of the Post tab) --------------------------------
       When the chosen video's file name names one of the client's Calendar cards, that card's caption
       fills an EMPTY caption box. The file name without its extension is compared, ignoring case, spaces
       and punctuation, with the card's name and with the last part of the card's video link. Only when
       exactly one card matches does anything fill; two or more fill nothing. A card's second caption
       wins when it was written for the platform being posted to.
       The cards come from where the Calendar keeps them: the live Calendar when it shows this client,
       otherwise its saved copy on this device, otherwise one read of the same rows the Calendar reads
       (no new access of any kind). That read is kept two minutes per client. */
    const SV_CAP_FETCH_TTL_MS = 2 * 60 * 1000;
    const _svCapFetched = new Map();   // slug -> { at, promise }
    function _svCapKey(s) {
        return String(s || '').normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');
    }
    function _svFileStem(name) { return String(name || '').trim().replace(/\.[a-z0-9]{1,5}$/i, ''); }
    function _svLinkStem(url) {
        try {
            const seg = new URL(String(url)).pathname.split('/').filter(Boolean).pop() || '';
            return _svFileStem(decodeURIComponent(seg));
        } catch (e) { return ''; }
    }
    function _svCalendarPostsFor(client) {
        const slug = calClientSlug(client);
        try {
            if (calState && calState.client && calClientSlug(calState.client) === slug && Array.isArray(calState.posts) && calState.posts.length) return Promise.resolve(calState.posts);
            const cached = _calCacheRead(slug);
            if (cached && Array.isArray(cached.posts) && cached.posts.length) return Promise.resolve(cached.posts);
        } catch (e) {}
        const kept = _svCapFetched.get(slug);
        if (kept && Date.now() - kept.at < SV_CAP_FETCH_TTL_MS) return kept.promise;
        const promise = _calV2FetchPosts(slug, null).then(j => (j && j.posts) || []);
        _svCapFetched.set(slug, { at: Date.now(), promise });
        promise.catch(() => { if (_svCapFetched.get(slug)?.promise === promise) _svCapFetched.delete(slug); });
        return promise;
    }
    // { id, name, caption } for the one card the file name names, or null (no match, two or more, no caption, a failed read).
    async function svCalendarCaptionFor(client, fileName, platform) {
        const key = _svCapKey(_svFileStem(fileName));
        if (!client || !key) return null;
        let posts = [];
        try { posts = await _svCalendarPostsFor(client); } catch (e) { return null; }
        const hits = (posts || [])
            .filter(p => p && p.id && !p.archived && String(p.id).indexOf('p_cal_settings') !== 0 && String(p.status || '').toLowerCase() !== 'archived')
            .filter(p => _svCapKey(p.name) === key || (!!p.asset_url && _svCapKey(_svLinkStem(p.asset_url)) === key));
        if (hits.length !== 1) return null;
        const p = hits[0];
        const alt = String(p.caption_alt || '').trim();
        const caption = (alt && String(p.caption_alt_platform || '').trim().toLowerCase() === platform) ? alt : String(p.caption || '').trim();
        if (!caption) return null;
        return { id: String(p.id), name: String(p.name || '').replace(/\s+/g, ' ').trim() || 'Untitled card', caption };
    }
    // The line under a caption the Calendar filled, with its Undo.
    function svCaptionFillHtml(id, name, from) {
        return `<div class="tk-cap-fill" id="${id}" role="status">Caption filled from ${_igEsc(from || 'Calendar')}: <strong>${_igEsc(name)}</strong> <button type="button" class="tk-cap-undo" id="${id}Undo">Undo</button></div>`;
    }
    // The platform's name and logo, for the header badge, the switch and the post button.
    function svPlatformLogo(platform) {
        const p = CAL_PLATFORM_BY_KEY[['instagram', 'youtube', 'linkedin'].includes(platform) ? platform : 'tiktok'];
        return `<span class="tk-plat-logo" aria-hidden="true">${p ? p.icon : ''}</span>`;
    }
    function svPostButtonLabel(platform, postNow) {
        const name = ({ instagram: 'Instagram', youtube: 'YouTube', linkedin: 'LinkedIn' })[platform] || 'TikTok';
        return svPlatformLogo(platform) + '<span>' + (postNow ? 'Post to ' : 'Schedule on ') + name + '</span>';
    }
    async function _igTryCaptionFill(file) {
        if (!file || !igState.client || igState.title.trim()) return;
        const client = igState.client;
        const hit = await svCalendarCaptionFor(client, file.name, _igNet());
        if (!hit || igState.file !== file || igState.client !== client || igState.title.trim() || igState.submitting) return;
        igState.title = hit.caption.slice(0, IG_MAX_CAPTION);
        igState.titleFromCard = igState.title;
        igState.captionFill = { name: hit.name, text: igState.title };
        if (_igMounted) _igRenderForm();
    }
    // A caption the file name filled, still as it was filled, leaves with the video (or the client) it came from.
    function _igDropCaptionFill() {
        const f = igState.captionFill;
        if (f && igState.title === f.text) { igState.title = ''; if (igState.titleFromCard === f.text) igState.titleFromCard = ''; }
        igState.captionFill = null;
    }

    function _igImageSize(url) {
        return new Promise(resolve => {
            const img = new Image();
            img.onload = () => resolve({ w: img.naturalWidth, h: img.naturalHeight });
            img.onerror = () => resolve(null);
            img.src = url;
        });
    }
    // WebP and other formats become a JPEG: Instagram takes JPEG and PNG.
    async function _igToJpegOrPng(blob) {
        if (/^image\/(jpeg|png)$/.test(blob.type)) return blob;
        const url = URL.createObjectURL(blob);
        try {
            const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = url; });
            const cv = document.createElement('canvas');
            cv.width = img.naturalWidth; cv.height = img.naturalHeight;
            cv.getContext('2d').drawImage(img, 0, 0);
            return await new Promise((res, rej) => cv.toBlob(b => b ? res(b) : rej(new Error('convert failed')), 'image/jpeg', 0.92));
        } finally { URL.revokeObjectURL(url); }
    }
    async function _igSetCoverImage(input, name, source, cardId, stillCurrent) {
        const current = typeof stillCurrent === 'function' ? stillCurrent : () => true;
        const c = _igCover();
        let blob = input;
        if (source === 'upload' && !/^image\/(jpeg|png)$/.test(blob.type || '')) { c.note = 'The cover must be a JPEG or PNG image.'; _igRenderForm(); return; }
        try { blob = await _igToJpegOrPng(blob); } catch (e) { if (!current()) return; c.note = 'That image could not be read. Try a JPEG or PNG.'; _igRenderForm(); return; }
        if (!current()) return;
        if (blob.size > IG_COVER_MAX_BYTES) { c.note = 'That image is over ' + _igDeps.formatBytes(IG_COVER_MAX_BYTES) + '. Use a smaller JPEG or PNG.'; _igRenderForm(); return; }
        const url = URL.createObjectURL(blob);
        const size = await _igImageSize(url);
        if (!current()) { try { URL.revokeObjectURL(url); } catch (e) {} return; }
        _igCoverClear(true);
        const cur = _igCover();
        cur.blob = blob; cur.url = url; cur.name = name || 'cover'; cur.source = source; cur.cardId = cardId || ''; cur.mode = 'image';
        cur.dims = size ? size.w + '×' + size.h : '';
        // Not 9:16 is a heads-up, not a block: the image still posts and Instagram crops it.
        cur.note = (size && Math.abs(size.w / size.h - IG_COVER_RATIO) > 0.02) ? 'This image is ' + size.w + '×' + size.h + ', not 9:16. Instagram will crop it to fit.' : '';
        _igRenderForm(); _igRenderPreview();
    }
    /* What a client change takes away: a Calendar cover (and the card it came
       from, which also retires a copy still in flight) and a caption that card
       filled in, if nobody edited it. Typed text stays. */
    function _igLeaveClient() {
        igState.error = null; igState.notice = null;
        igState.facebookOff = false;
        igState.yt = { title: '', edited: false, format: 'short' };
        if (igState.cover.source === 'calendar') _igCoverClear(true);
        igState.cover.cardId = ''; igState.cover.note = '';
        if (igState.titleFromCard && igState.title === igState.titleFromCard) igState.title = '';
        igState.titleFromCard = '';
        igState.captionFill = null;
        // A folder still being read, or waiting on a pick, is retired (as _igDropForget, written out: this function
        // is lifted on its own by the assurance suites).
        igState.dropSeq = (igState.dropSeq || 0) + 1; igState.drop = null; igState.dropNote = '';
        if (igState.source) svPostSourceClear(igState.source);
    }
    async function _igUseCalendarCard(cardId) {
        const c = _igCover();
        if (!cardId) { if (c.source === 'calendar') _igCoverClear(true); c.cardId = ''; c.note = ''; _igRenderForm(); _igRenderPreview(); return; }
        const card = _igCalendarCards(igState.client).find(x => x.id === cardId);
        if (!card) return;
        c.cardId = cardId;
        // The card's caption fills the caption box, but only while that box is empty: typed text is never overwritten.
        if (!igState.title.trim() && card.caption) { igState.title = card.caption.slice(0, IG_MAX_CAPTION); igState.titleFromCard = igState.title; }
        if (!card.thumb) { c.note = 'This card has no thumbnail yet' + (card.caption ? ', so only its caption was used.' : '.'); _igRenderForm(); return; }
        c.note = 'Copying the Calendar thumbnail…'; _igRenderForm();
        /* The copy belongs to this client and this card. A client change (or
           another card) while it runs retires it: before 2026-10-10 it landed
           as the next client's Reel cover (OPEN_REPAIRS 404). */
        const client = igState.client;
        const current = () => igState.client === client && _igCover().cardId === cardId;
        try {
            const resp = await fetch(card.thumb, { mode: 'cors', credentials: 'omit', cache: 'force-cache' });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const blob = await resp.blob();
            if (!current()) return;
            await _igSetCoverImage(blob, 'calendar-thumbnail', 'calendar', cardId, current);
        } catch (e) {
            if (!current()) return;
            _igCover().note = "Couldn't copy that Calendar thumbnail (the browser was not allowed to read it). Upload the image instead.";
            _igCover().cardId = cardId;
            _igRenderForm();
        }
    }
    // A frame of the chosen video, drawn small, for the preview.
    function _igCaptureFrame(objectUrl, ms) {
        return new Promise(resolve => {
            const v = document.createElement('video');
            v.muted = true; v.preload = 'auto'; v.playsInline = true;
            const done = (val) => { v.removeAttribute('src'); try { v.load(); } catch (e) {} resolve(val); };
            v.onloadeddata = () => { try { v.currentTime = Math.max(0, ms / 1000); } catch (e) { done(''); } };
            v.onseeked = () => {
                try {
                    const w = 360, h = Math.round(w * (v.videoHeight || 640) / (v.videoWidth || 360));
                    const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
                    cv.getContext('2d').drawImage(v, 0, 0, w, h);
                    done(cv.toDataURL('image/jpeg', 0.8));
                } catch (e) { done(''); }
            };
            v.onerror = () => done('');
            v.src = objectUrl;
        });
    }
    async function _igSetFrame(ms) {
        const c = _igCover();
        c.frameMs = Math.max(0, Math.round(ms));
        if (igState.objectUrl) c.frameUrl = await _igCaptureFrame(igState.objectUrl, c.frameMs);
        _igRenderPreview();
    }
    function _igCoverPreviewUrl() {
        const c = _igCover();
        if (c.mode === 'image') return c.url || c.remoteUrl || '';
        return c.frameMs > 0 ? c.frameUrl : '';
    }
    function _igCoverSummary() {
        const c = _igCover();
        if (c.mode === 'image' && c.blob) return c.source === 'calendar' ? 'Calendar thumbnail' : 'Uploaded image';
        if (c.mode === 'image' && c.remoteUrl) return "The card's thumbnail";
        if (c.mode === 'frame' && c.frameMs > 0) return 'Video frame at ' + (c.frameMs / 1000).toFixed(1) + ' s';
        return 'Instagram picks the first frame';
    }
    function _igCoverCardHtml() {
        const c = _igCover(), cards = _igCalendarCards(igState.client), off = igState.submitting ? 'disabled' : '';
        // From a card, the card is already picked above (and its thumbnail is the cover): no second card picker here.
        const cardPick = cards.length && !_igFromCard()
            ? `<div style="margin-bottom:12px"><div class="tk-step-note" style="margin:0 0 6px">Pick one of this client's Calendar cards (Approved or Scheduled) to use its thumbnail as the cover and its caption if the caption box is empty:</div>
                ${_svSelectHtml('igCard', [{ value: '', label: 'No Calendar card' }].concat(cards.map(x => ({ value: x.id, label: x.label }))), c.cardId || '', 'Pick a Calendar card…', { disabled: igState.submitting })}</div>`
            : '';
        const modes = [{ v: 'image', label: 'Image' }, { v: 'frame', label: 'Frame from video' }]
            .map(m => `<label class="tk-radio${c.mode === m.v ? ' active' : ''}"><input type="radio" name="igCoverMode" value="${m.v}" ${c.mode === m.v ? 'checked' : ''} ${off} style="position:absolute;opacity:0">${m.label}</label>`).join('');
        let body;
        if (c.mode === 'image') {
            body = c.blob
                ? `<div class="tk-file-card"><div class="tk-file-meta"><div class="tk-file-meta-text"><div class="tk-file-name">${_igEsc(c.name)}</div><div class="tk-file-size">${_igEsc(c.dims)} · ${_igDeps.formatBytes(c.blob.size)} · ${c.source === 'calendar' ? 'from the Calendar' : 'uploaded'}</div></div><div class="tk-file-actions"><button type="button" class="tk-mini-btn" id="igCoverRemove" ${off}>Remove</button></div></div></div>`
                : c.remoteUrl
                ? `<div class="tk-file-card" id="igCoverRemote"><div class="tk-file-meta"><div class="tk-file-meta-text"><div class="tk-file-name">The card's thumbnail</div><div class="tk-file-size">Copied with the video</div></div><div class="tk-file-actions"><button type="button" class="tk-mini-btn" id="igCoverRemove" ${off}>Remove</button></div></div></div>`
                : `<div class="tk-drop" id="igCoverDrop"><input type="file" id="igCoverFile" accept="image/jpeg,image/png" ${off}><div class="tk-drop-title">Drop a cover image here, or ${window.svIsStaffPhone?.() ? 'tap' : 'click'} to browse</div><div class="tk-drop-sub">JPEG or PNG · 9:16 (1080×1920 is ideal) · up to ${_igDeps.formatBytes(IG_COVER_MAX_BYTES)}</div></div>`;
        } else {
            const maxMs = Math.max(0, Math.floor((c.duration || 0) * 1000));
            body = igState.file
                ? `<input type="range" id="igFrame" min="0" max="${maxMs}" step="100" value="${Math.min(c.frameMs, maxMs)}" aria-label="Cover frame" ${off} style="width:100%"><div class="tk-step-note" id="igFrameLabel">${c.frameMs > 0 ? 'Frame at ' + (c.frameMs / 1000).toFixed(1) + ' s' : 'Drag to choose a frame. At 0 s Instagram uses the first frame.'}</div>`
                : '<div class="tk-step-note">Attach a video first, then pick a frame from it.</div>';
        }
        return `<div class="tk-card"><h3>Cover image <span class="tk-card-hint">Optional</span></h3>${cardPick}
            <div class="tk-radio-row tk-seg" role="radiogroup" aria-label="Cover source" style="margin-bottom:12px">${modes}</div>${body}
            ${c.note ? `<div class="tk-step-note" role="status" id="igCoverNote">${_igEsc(c.note)}</div>` : ''}</div>`;
    }
    // The preview: what the cover will look like, in a 9:16 frame, with the caption underneath.
    function _igRenderPreview() {
        const host = document.getElementById('igPreviewCol');
        if (!host) return;
        if (igState.kind === 'carousel') { _igRenderCarouselPreview(host); return; }
        const url = _igCoverPreviewUrl();
        host.innerHTML = `<div class="tk-card" id="igPreviewCard"><h3>Preview <span class="tk-card-hint">${_igEsc(_igCoverSummary())}</span></h3>
            <div style="width:180px;max-width:100%;aspect-ratio:9/16;margin:0 auto;border-radius:12px;overflow:hidden;background:var(--bg);display:grid;place-items:center">
                ${url ? `<img id="igPreviewImg" src="${_igEsc(url)}" alt="Cover preview" style="width:100%;height:100%;object-fit:cover">` : '<span class="tk-step-note" style="text-align:center;padding:10px">No cover chosen. Instagram will use the first frame of the video.</span>'}
            </div>
            ${igState.title.trim() ? `<div class="tk-queue-title" style="margin-top:10px">${_igEsc(igState.title.trim().slice(0, 140))}</div>` : ''}
        </div>`;
    }

    /* ---- Carousel ------------------------------------------------------------------------------
       The same picker as TikTok's Photo carousel (pick or drop several files, arrows to reorder, x to
       remove), with Instagram's limits: 2 to 10 items, images and videos may mix, and Instagram crops
       every item to the shape of the first one. Each item goes to Post For Me storage in order, then
       one create call sends the list (placement "timeline", a feed post). */
    function _igCarouselPreviewHtml(it, alt) {
        return it.isVideo
            ? `<video src="${_igEsc(it.objectUrl)}" muted playsinline preload="metadata" aria-label="${_igEsc(alt)}" style="width:100%;height:100%;object-fit:cover;display:block"></video>`
            : `<img src="${_igEsc(it.objectUrl)}" alt="${_igEsc(alt)}">`;
    }
    function _igRenderCarouselPreview(host) {
        const items = igState.items, first = items[0];
        host.innerHTML = `<div class="tk-card" id="igPreviewCard"><h3>Preview <span class="tk-card-hint">${items.length ? 'Carousel · ' + items.length + ' item' + (items.length === 1 ? '' : 's') : 'Carousel'}</span></h3>
            <div style="width:200px;max-width:100%;aspect-ratio:4/5;margin:0 auto;border-radius:12px;overflow:hidden;background:var(--bg);display:grid;place-items:center" id="igPreviewFrame">
                ${first ? (first.isVideo
                    ? `<video id="igPreviewImg" src="${_igEsc(first.objectUrl)}" muted playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover"></video>`
                    : `<img id="igPreviewImg" src="${_igEsc(first.objectUrl)}" alt="First carousel item" style="width:100%;height:100%;object-fit:cover">`)
                    : '<span class="tk-step-note" style="text-align:center;padding:10px">No items yet. The first item is the one people see first.</span>'}
            </div>
            ${items.length > 1 ? `<div class="tk-step-note" style="text-align:center;margin-top:6px">1 of ${items.length} · swipe for the rest</div>` : ''}
            ${igState.title.trim() ? `<div class="tk-queue-title" style="margin-top:10px">${_igEsc(igState.title.trim().slice(0, 140))}</div>` : ''}
        </div>`;
    }
    function _igCarouselCardHtml() {
        const items = igState.items, off = igState.submitting ? 'disabled' : '';
        const verb = window.svIsStaffPhone?.() ? 'tap' : 'click';
        const grid = items.length ? `
            <div class="tk-photo-grid" id="igCarGrid">
                ${items.map((it, i) => `
                <div class="tk-photo-item" data-ig-car-item="${i}">
                    ${_igCarouselPreviewHtml(it, (it.isVideo ? 'Video ' : 'Image ') + (i + 1))}
                    <div class="tk-photo-badge">${i + 1}${it.isVideo ? ' · Video' : ''}</div>
                    <div class="tk-photo-actions">
                        <button type="button" class="tk-photo-btn" data-ig-car-idx="${i}" data-action="move-earlier" ${(i === 0 || igState.submitting) ? 'disabled' : ''} title="Move earlier" aria-label="Move item ${i + 1} earlier">&larr;</button>
                        <button type="button" class="tk-photo-btn" data-ig-car-idx="${i}" data-action="move-later" ${(i === items.length - 1 || igState.submitting) ? 'disabled' : ''} title="Move later" aria-label="Move item ${i + 1} later">&rarr;</button>
                        <button type="button" class="tk-photo-btn tk-photo-btn-remove" data-ig-car-idx="${i}" data-action="remove" ${off} title="Remove" aria-label="Remove item ${i + 1}">&times;</button>
                    </div>
                </div>`).join('')}
            </div>` : '';
        const drop = items.length < IG_CAROUSEL_MAX ? `
            <div class="tk-drop" id="igCarDrop">
                <input type="file" id="igCarFile" accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/*" multiple ${off}>
                <div class="tk-drop-title">${items.length ? 'Drop more images or videos, or ' + verb + ' to add' : 'Drop images or videos here, or ' + verb + ' to browse'}</div>
                <div class="tk-drop-sub">JPEG, PNG, WEBP, MP4 or MOV · ${IG_CAROUSEL_MIN} to ${IG_CAROUSEL_MAX} items · images up to ${_igDeps.formatBytes(IG_CAROUSEL_IMAGE_MAX_BYTES)}</div>
            </div>` : '';
        const count = `<div class="tk-step-note" id="igCarCount">${items.length} of ${IG_CAROUSEL_MAX} items${items.length && items.length < IG_CAROUSEL_MIN ? ' · add at least ' + IG_CAROUSEL_MIN : ''}. Instagram crops every item to the shape of the first one.</div>`;
        return grid + drop + count;
    }
    function _igHandleCarouselFiles(fileList) {
        if (!fileList || !fileList.length || igState.submitting) return;
        const room = IG_CAROUSEL_MAX - igState.items.length;
        const incoming = Array.from(fileList);
        let err = null;
        let added = 0;
        for (const file of incoming.slice(0, Math.max(room, 0))) {
            const isVideo = /^video\//.test(file.type || '') || /\.(mp4|mov|m4v)$/i.test(file.name || '');
            const isImage = /^image\/(jpeg|png|webp)$/.test(file.type || '') || /\.(jpe?g|png|webp)$/i.test(file.name || '');
            if (!isVideo && !isImage) { err = `"${file.name}" is not a JPEG, PNG or WEBP image, or a video.`; continue; }
            const limit = isVideo ? _igDeps.maxBytes : IG_CAROUSEL_IMAGE_MAX_BYTES;
            if (file.size > limit) { err = `"${file.name}" is ${_igDeps.formatBytes(file.size)}. The limit is ${_igDeps.formatBytes(limit)}.`; continue; }
            igState.items.push({ file, objectUrl: URL.createObjectURL(file), isVideo });
            added++;
        }
        if (incoming.length > room) err = `Only ${room} more item${room === 1 ? '' : 's'} fit: a carousel holds ${IG_CAROUSEL_MAX}.`;
        igState.error = err;
        if (added) igState.notice = null;
        _igRenderForm();
    }
    // A re-render drops keyboard focus; put it back on the button a keyboard user expects.
    function _igFocusCarouselControl(idx, action) {
        const el = document.querySelector(`[data-ig-car-idx="${idx}"][data-action="${action}"]`);
        if (el && !el.disabled) { el.focus(); return true; }
        return false;
    }
    function _igCarouselAction(i, action) {
        const arr = igState.items;
        if (igState.submitting || !arr[i]) return;
        if (action === 'remove') {
            try { URL.revokeObjectURL(arr[i].objectUrl); } catch (e) {}
            arr.splice(i, 1);
            _igRenderForm();
            if (!_igFocusCarouselControl(Math.min(i, arr.length - 1), 'remove')) document.getElementById('igCarFile')?.focus();
            return;
        }
        const j = i + (action === 'move-earlier' ? -1 : 1);
        if (j < 0 || j >= arr.length) return;
        [arr[i], arr[j]] = [arr[j], arr[i]];
        _igRenderForm();
        _igFocusCarouselControl(j, action) || _igFocusCarouselControl(j, action === 'move-earlier' ? 'move-later' : 'move-earlier') || _igFocusCarouselControl(j, 'remove');
    }
    function _igClearCarousel() {
        igState.items.forEach(it => { try { URL.revokeObjectURL(it.objectUrl); } catch (e) {} });
        igState.items = [];
    }
    // Instagram's feed takes JPEG images, so a PNG or WEBP is redrawn as a JPEG (on white, for transparent parts).
    async function _igToJpeg(file) {
        if (/^image\/jpeg$/.test(file.type || '') || (!file.type && /\.jpe?g$/i.test(file.name || ''))) return file;
        const url = URL.createObjectURL(file);
        try {
            const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = url; });
            const cv = document.createElement('canvas');
            cv.width = img.naturalWidth; cv.height = img.naturalHeight;
            const cx = cv.getContext('2d');
            cx.fillStyle = 'white'; cx.fillRect(0, 0, cv.width, cv.height);
            cx.drawImage(img, 0, 0);
            return await new Promise((res, rej) => cv.toBlob(b => b ? res(b) : rej(new Error('convert failed')), 'image/jpeg', 0.92));
        } finally { URL.revokeObjectURL(url); }
    }
    function _igSetKind(kind) {
        if (igState.submitting || (kind !== 'reel' && kind !== 'carousel') || kind === igState.kind) return;
        igState.kind = kind;
        // A trial is a Reel thing; a carousel never carries one.
        if (kind === 'carousel') igState.trial = false;
        // Each kind keeps its own retry-safe key: a post whose outcome is unknown must reuse its key when the
        // SMM comes back to it, or a second press could post it twice.
        igState.error = null; igState.notice = null;
        _igRenderForm();
    }

    // The schedule is held as date + 12-hour time, like TikTok's; this composes "YYYY-MM-DDTHH:MM".
    function _igAt() {
        const s = igState.schedule;
        if (!s.date || s.hour === '' || s.minute === '') return '';
        let h = parseInt(s.hour, 10);
        if (!Number.isFinite(h)) return '';
        if (s.ampm === 'PM' && h < 12) h += 12;
        if (s.ampm === 'AM' && h === 12) h = 0;
        return s.date + 'T' + String(h).padStart(2, '0') + ':' + String(s.minute).padStart(2, '0');
    }
    function _igTodayIso() {
        const d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    const _igItems = (pairs) => pairs.map(([value, label]) => ({ value: String(value), label: String(label) }));

    // Did the create call get a definite "no"? See the note where it is used.
    function _igCreateAnswerIsFinal(created) {
        const j = created && created.json;
        if (!j || typeof j !== 'object') return false;
        return created.status >= 400 && created.status < 500;
    }
    /* The function also answers HTTP 200 with {"ok":false}, a row marked failed
       and a reason when Post For Me did not accept the create. That reason is
       worth showing, and the row belongs in the queue. But it is NOT proof that
       no post exists: the same shape comes back when Post For Me fails or times
       out after taking the post, and the page cannot tell the two apart from
       the text (the first version of this change tried to, by matching the
       error text, and an independent review showed how that could end in two
       posts). So the attempt and its key are KEPT: pressing again retries this
       same post, and the function's own lookup adopts one that already exists. */
    function _igCreateRefusalReason(created) {
        const j = created && created.json;
        if (!j || typeof j !== 'object' || created.status !== 200 || j.ok !== false) return '';
        if (!j.row || j.row.status !== 'failed') return '';
        return String(j.error || j.row.error || '').trim();
    }
    function _igValidate() {
        if (!igState.client) return 'Pick a client first.';
        // instagramOn is false only when post_networks_v1 lets the person untick Instagram (set on every redraw).
        if (igState.instagramOn !== false && !IG_ACCOUNT_RE.test(_igResolveAccount(igState.client))) return IG_NO_ACCOUNT_MSG;
        if (igState.kind === 'carousel') {
            if (igState.items.length < IG_CAROUSEL_MIN) return 'A carousel needs at least ' + IG_CAROUSEL_MIN + ' images or videos.';
            if (igState.items.length > IG_CAROUSEL_MAX) return 'A carousel holds at most ' + IG_CAROUSEL_MAX + ' items.';
        } else if (igState.source && igState.source.active) {
            const src = igState.source;
            if (src.state === 'copying') return 'Wait for the video to finish copying from Frame.';
            if (!(src.state === 'ready' && src.data && src.data.media_url)) return 'Pick a card for the video.';
        } else {
            if (!igState.file) return 'Attach a video.';
            if (igState.file.size > _igDeps.maxBytes) return 'That video is over the ' + _igDeps.formatBytes(_igDeps.maxBytes) + ' limit.';
        }
        if (!igState.title.trim()) return 'Add a caption.';
        if (igState.title.length > IG_MAX_CAPTION) return 'Caption is over the ' + IG_MAX_CAPTION + '-character limit.';
        if (!igState.schedule.postNow) {
            const at = _igAt();
            if (!at) return 'Pick a schedule date and time, or switch on "Post immediately".';
            // Wall clock in the picked timezone, not the browser's (see _tkValidate).
            const t = Date.parse(_igDeps.wallClockToUTC(at, igState.schedule.tz) || '');
            if (!Number.isFinite(t)) return 'That schedule time is not valid.';
            if (t < Date.now() - 60000) return 'The schedule time is in the past.';
        }
        return null;
    }

    function _igRenderForm() {
        const col = document.getElementById('igFormCol');
        if (!col) return;
        igState.instagramOn = _igInstagramOn();
        const account = igState.client ? _igResolveAccount(igState.client) : '';
        const accountOk = IG_ACCOUNT_RE.test(account);
        const names = _igClientNames();
        const over = igState.title.length > IG_MAX_CAPTION;
        const isCarousel = igState.kind === 'carousel';
        const fromCard = _igFromCard();
        const hasMedia = isCarousel ? (igState.items.length >= IG_CAROUSEL_MIN && igState.items.length <= IG_CAROUSEL_MAX) : fromCard ? svPostSourceReady(_igSrc()) : !!igState.file;
        const trialVersions = _igTrialVersionsOn();
        const can = trialVersions ? !igState.submitting && !_igTrialVersionsProblem()
            : !!(igState.client && (accountOk || !_igInstagramOn()) && hasMedia && igState.title.trim() && !over && !igState.submitting && !_igNetworksProblem());
        let accountLine = '';
        if (igState.client && !_igInstagramOn()) accountLine = _igSideAccountLine();
        else if (igState.client) {
            accountLine = accountOk
                ? `<div class="tk-profile-line">Posts to Post For Me account <span class="tk-profile-chip">${_igEsc(account)}</span></div>`
                : `<div class="tk-profile-line"><span class="tk-warn-chip">⚠ No Instagram account</span> ${_igEsc(IG_NO_ACCOUNT_MSG)}${svPostForMeLinkHtml()}</div>`;
        }
        const media = igState.file
            ? `<div class="tk-file-card">
                    <video id="igFilePreview" src="${_igEsc(igState.objectUrl)}" playsinline controls preload="metadata"></video>
                    <div class="tk-file-meta">
                        <div class="tk-file-meta-text">
                            <div class="tk-file-name">${_igEsc(igState.file.name)}</div>
                            <div class="tk-file-size">${_igDeps.formatBytes(igState.file.size)} · ${_igEsc(igState.file.type || 'video')}</div>
                        </div>
                        <div class="tk-file-actions">
                            <button type="button" class="tk-mini-btn" id="igRemoveFile" ${igState.submitting ? 'disabled' : ''}>Remove</button>
                        </div>
                    </div>
                </div>`
            : `<div class="tk-drop" id="igDrop">
                    <input type="file" id="igFile" accept="video/mp4,video/quicktime,video/*" ${igState.submitting ? 'disabled' : ''}>
                    <div class="tk-drop-title">Drop a video here, or ${window.svIsStaffPhone?.() ? 'tap' : 'click'} to browse</div>
                    <div class="tk-drop-sub">MP4 or MOV · up to ${_igDeps.formatBytes(_igDeps.maxBytes)}</div>
                </div>`;
        col.innerHTML = `
            <div class="tk-card">
                <h3>Client</h3>
                ${_svSelectHtml('igClient', _igItems(names.map(n => [n, n])), igState.client || '', 'Pick a client…', { disabled: igState.submitting })}
                ${accountLine}
            </div>
            <div class="tk-card">
                <h3>${isCarousel ? 'Carousel' : 'Video'}</h3>
                ${_igInstagramOn() ? `<div class="tk-radio-row tk-seg" role="radiogroup" aria-label="Instagram post type" style="margin-bottom:12px">
                    <label class="tk-radio${isCarousel ? '' : ' active'}"><input type="radio" name="igKind" value="reel" ${isCarousel ? '' : 'checked'} ${igState.submitting ? 'disabled' : ''} style="position:absolute;opacity:0">Reel</label>
                    <label class="tk-radio${isCarousel ? ' active' : ''}"><input type="radio" name="igKind" value="carousel" ${isCarousel ? 'checked' : ''} ${igState.submitting ? 'disabled' : ''} style="position:absolute;opacity:0">Carousel</label>
                </div>` : ''}
                ${isCarousel ? _igCarouselCardHtml() : (svPostSourceOffered(igState.client, true) ? svPostSourceModeHtml('ig', _igSrc(), igState.submitting) : '') + (fromCard ? svPostSourceCardHtml('ig', _igSrc(), igState.client, igState.submitting) : media)}
                ${fromCard ? '' : svDropPickHtml('ig', igState.drop, igState.submitting) + svDropNoteHtml('ig', igState.dropNote)}
            </div>
            ${isCarousel || trialVersions || _igNet() === 'linkedin' ? '' : _igCoverCardHtml()}
            <div class="tk-card">
                <h3>Caption <span class="tk-card-hint" id="igCount">${igState.title.length} / ${IG_MAX_CAPTION}</span></h3>
                <textarea class="tpl-input" id="igTitle" rows="5" placeholder="Write the caption…" ${igState.submitting ? 'disabled' : ''}>${_igEsc(igState.title)}</textarea>
                ${igState.captionFill ? svCaptionFillHtml('igCapFill', igState.captionFill.name, igState.captionFill.from) : ''}
                ${trialVersions ? '<div class="tk-step-note" id="igTrialCapNote">Each version posts with its own caption. This box is used only for a version that has none.</div>' : ''}

            </div>
            ${isCarousel || !_igInstagramOn() ? '' : `<div class="tk-card">
                <div class="tk-sched-head"><h3>Trial reel</h3>
                    <label class="tk-toggle">
                        <input type="checkbox" id="igTrial" ${igState.trial ? 'checked' : ''} ${igState.submitting ? 'disabled' : ''}>
                        <span class="tk-toggle-track"><span class="tk-toggle-thumb"></span></span>
                        Trial reel
                    </label>
                </div>
                ${igState.trial ? '<div class="tk-step-note">Shown to non-followers first. It reaches followers only if you share it from the Instagram app. Not every account can post trial reels: if this one cannot, the post shows as Failed with Instagram\'s reason.</div>' : ''}
                ${igState.trial ? _igTrialVersionsHtml() : ''}
            </div>`}
            ${_igYoutubeCardHtml()}
            ${!_igInstagramOn() || (_igNetworksOn() && _igFacebookState().noAccount) ? '' : _igFacebookCardHtml()}
            <div class="tk-card">
                <div class="tk-sched-head"><h3>Scheduling</h3>
                    <label class="tk-toggle">
                        <input type="checkbox" id="igPostNow" ${igState.schedule.postNow ? 'checked' : ''} ${igState.submitting ? 'disabled' : ''}>
                        <span class="tk-toggle-track"><span class="tk-toggle-thumb"></span></span>
                        Post immediately
                    </label>
                </div>
                ${igState.schedule.postNow ? '<div class="tk-step-note">Posts to ' + IG_NET_LABEL[_igNet()] + ' as soon as you press Post to ' + IG_NET_LABEL[_igNet()] + '. Switch off to pick a date and time.</div>' : ''}
                <div id="igScheduleFields" ${igState.schedule.postNow ? 'hidden' : ''}>
                    ${_svDateHtml('igDate', igState.schedule.date, { min: _igTodayIso(), placeholder: 'Choose date', disabled: igState.submitting })}
                    <div style="display:flex;gap:8px;margin-top:10px">
                        ${_svSelectHtml('igHour', _igItems(Array.from({ length: 12 }, (_, i) => [i + 1, i + 1])), igState.schedule.hour, 'Hour', { disabled: igState.submitting })}
                        ${_svSelectHtml('igMin', _igItems(Array.from({ length: 12 }, (_, i) => { const m = String(i * 5).padStart(2, '0'); return [m, m]; })), igState.schedule.minute, 'Min', { disabled: igState.submitting })}
                        ${_svSelectHtml('igAmPm', _igItems([['AM', 'AM'], ['PM', 'PM']]), igState.schedule.ampm, 'AM', { disabled: igState.submitting })}
                    </div>
                    <div style="margin-top:10px">${_svSelectHtml('igTz', _igItems(_igDeps.timezones.map(tz => [tz, tz])), igState.schedule.tz, 'Timezone', { disabled: igState.submitting })}</div>
                </div>
            </div>
            <div class="tk-submit-bar">
                <button type="button" class="tk-submit-btn" id="igSubmit" ${can ? '' : 'disabled'}>${igState.submitting ? 'Uploading…' : trialVersions ? _igTrialButtonLabel() : _igButtonLabel()}</button>
                ${igState.submitting
                    ? `<div class="tk-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"><div class="tk-progress-bar" id="igProgress" style="width:${igState.progress}%"></div></div>${igState.phase === 'creating' ? '<span class="tk-step-note">Finishing…</span>' : '<button type="button" class="tk-mini-btn" id="igAbort">Cancel</button>'}`
                    : ''}
                ${igState.error ? `<div class="tk-error" role="alert">${_igEsc(igState.error)}${igState.error === IG_NO_ACCOUNT_MSG ? svPostForMeLinkHtml() : ''}</div>` : (igState.notice ? `<div class="tk-step-note" role="status">${_igEsc(igState.notice)}</div>` : '')}
            </div>
        `;
        _igWireForm();
        _igRenderPreview();
    }

    function _igWireForm() {
        const $ = (id) => document.getElementById(id);
        // Only the parts that change the submit button re-render the whole form; typing never does.
        // A trial card's versions are checked by their own rule (their captions are their own; Codex on PR 2573).
        const syncSubmit = () => { const b = $('igSubmit'); if (b) b.disabled = _igTrialVersionsOn() ? !!_igTrialVersionsProblem() : !!_igValidateSoft(); };
        $('igClient')?.addEventListener('change', (e) => { igState.client = e.target.value || null; if (igState.client) { try { svSharedClientNote(igState.client); } catch (err) {} } _igLeaveClient(); _igRenderForm(); if (igState.file) _igTryCaptionFill(igState.file); });
        $('igTitle')?.addEventListener('input', (e) => {
            igState.title = e.target.value;
            if (igState.captionFill && igState.title !== igState.captionFill.text) { igState.captionFill = null; $('igCapFill')?.remove(); }
            const c = $('igCount'); if (c) c.textContent = igState.title.length + ' / ' + IG_MAX_CAPTION;
            const yt = $('igYtTitle');
            if (yt && !igState.yt.edited) { const t = _igYtTitle(); yt.value = t; const n = $('igYtCount'); if (n) n.textContent = t.length + ' / ' + IG_YT_TITLE_MAX; }
            syncSubmit();
            _igRenderPreview();
        });
        $('igPostNow')?.addEventListener('change', (e) => { igState.schedule.postNow = e.target.checked; _igRenderForm(); });
        $('igTrial')?.addEventListener('change', (e) => { igState.trial = e.target.checked; _igRenderForm(); });
        document.querySelectorAll('[data-ig-trv]').forEach(b => b.addEventListener('change', (e) => {
            const tv = igState.trialVersions, letter = b.getAttribute('data-ig-trv');
            if (!tv) return;
            if (e.target.checked) delete tv.off[letter]; else tv.off[letter] = true;
            _igRenderForm();
        }));
        $('igFacebook')?.addEventListener('change', (e) => { igState.facebookOff = !e.target.checked; _igRenderForm(); });
        document.querySelectorAll('input[name="igYtFormat"]').forEach(r => r.addEventListener('change', (e) => { igState.yt.format = e.target.value === 'regular' ? 'regular' : 'short'; _igRenderForm(); }));
        $('igYtTitle')?.addEventListener('input', (e) => {
            igState.yt.title = e.target.value; igState.yt.edited = true;
            const c = $('igYtCount'); if (c) c.textContent = e.target.value.length + ' / ' + IG_YT_TITLE_MAX;
            syncSubmit();
        });
        $('igDate')?.addEventListener('change', (e) => { igState.schedule.date = e.target.value; syncSubmit(); });
        $('igHour')?.addEventListener('change', (e) => { igState.schedule.hour = e.target.value; syncSubmit(); });
        $('igMin')?.addEventListener('change', (e) => { igState.schedule.minute = e.target.value; syncSubmit(); });
        $('igAmPm')?.addEventListener('change', (e) => { igState.schedule.ampm = e.target.value; syncSubmit(); });
        $('igTz')?.addEventListener('change', (e) => { igState.schedule.tz = e.target.value; });
        $('igFile')?.addEventListener('change', (e) => { _igDropForget(); _igHandleFile(e.target.files && e.target.files[0]); });
        document.querySelectorAll('input[name="igCoverMode"]').forEach(r => r.addEventListener('change', (e) => { igState.cover.mode = e.target.value; igState.cover.note = ''; _igRenderForm(); }));
        $('igCoverFile')?.addEventListener('change', (e) => { const f = e.target.files && e.target.files[0]; if (f) _igSetCoverImage(f, f.name, 'upload'); });
        $('igCoverRemove')?.addEventListener('click', () => { _igCoverClear(true); _igRenderForm(); _igRenderPreview(); });
        $('igCard')?.addEventListener('change', (e) => { _igUseCalendarCard(e.target.value); });
        $('igFrame')?.addEventListener('input', (e) => { const l = $('igFrameLabel'); const ms = Number(e.target.value) || 0; if (l) l.textContent = ms > 0 ? 'Frame at ' + (ms / 1000).toFixed(1) + ' s' : 'Drag to choose a frame. At 0 s Instagram uses the first frame.'; });
        $('igFrame')?.addEventListener('change', (e) => { _igSetFrame(Number(e.target.value) || 0); });
        const coverDrop = $('igCoverDrop');
        if (coverDrop) {
            coverDrop.addEventListener('dragover', (e) => { e.preventDefault(); });
            coverDrop.addEventListener('drop', (e) => { e.preventDefault(); const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]; if (f) _igSetCoverImage(f, f.name, 'upload'); });
        }
        $('igRemoveFile')?.addEventListener('click', _igClearFile);
        document.querySelectorAll('input[name="igKind"]').forEach(r => r.addEventListener('change', (e) => _igSetKind(e.target.value)));
        $('igCarFile')?.addEventListener('change', (e) => { _igHandleCarouselFiles(e.target.files); e.target.value = ''; });
        const carDrop = $('igCarDrop');
        if (carDrop) {
            ['dragenter', 'dragover'].forEach(ev => carDrop.addEventListener(ev, (e) => { e.preventDefault(); carDrop.classList.add('tk-drag'); }));
            ['dragleave', 'drop'].forEach(ev => carDrop.addEventListener(ev, (e) => { e.preventDefault(); carDrop.classList.remove('tk-drag'); }));
            carDrop.addEventListener('drop', (e) => { const folder = svDroppedFolder(e.dataTransfer, igState.client); if (folder) _igDropFolder(folder); else _igHandleCarouselFiles(e.dataTransfer && e.dataTransfer.files); });
        }
        document.querySelectorAll('[data-ig-car-idx]').forEach(b => b.addEventListener('click', () => _igCarouselAction(Number(b.getAttribute('data-ig-car-idx')), b.getAttribute('data-action'))));
        $('igCapFillUndo')?.addEventListener('click', () => { _igDropCaptionFill(); _igRenderForm(); $('igTitle')?.focus(); });
        svPostSourceBind('ig', _igSrc(), { client: igState.client, side: 'instagram', rerender: () => { _igRenderForm(); _igRenderPreview(); }, onDone: _igCardCopied });
        $('igSubmit')?.addEventListener('click', _igSubmit);
        $('igAbort')?.addEventListener('click', () => { if (_igAbort) _igAbort.abort(); if (_igActiveXhr) _igActiveXhr.abort(); });
        const drop = $('igDrop');
        if (drop) {
            drop.addEventListener('dragover', (e) => { e.preventDefault(); });
            drop.addEventListener('drop', (e) => {
                e.preventDefault();
                const folder = svDroppedFolder(e.dataTransfer, igState.client);
                if (folder) { _igDropFolder(folder); return; }
                _igDropForget(); _igHandleFile(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]);
            });
        }
        document.querySelectorAll('[data-ig-drop-pick]').forEach(b => b.addEventListener('click', () => _igDropPick(Number(b.getAttribute('data-ig-drop-pick')))));
    }

    // The submit button's enabled state, without a message.
    function _igValidateSoft() {
        if (igState.submitting) return 'busy';
        if (!igState.client || (_igInstagramOn() && !IG_ACCOUNT_RE.test(_igResolveAccount(igState.client)))) return 'account';
        // A card's copy counts as the video, as it does for the button drawn with the form (before, typing a caption
        // after picking a card switched the button off until the next redraw).
        const hasMedia = igState.kind === 'carousel' ? (igState.items.length >= IG_CAROUSEL_MIN && igState.items.length <= IG_CAROUSEL_MAX) : _igFromCard() ? svPostSourceReady(_igSrc()) : !!igState.file;
        if (!hasMedia || !igState.title.trim() || igState.title.length > IG_MAX_CAPTION) return 'fields';
        if (_igNetworksProblem()) return 'networks';
        return '';
    }

    function _igHandleFile(file) {
        if (!file) return;
        if (!/^video\//.test(file.type || '')) { igState.error = 'That file is not a video.'; _igRenderForm(); return; }
        if (igState.objectUrl) URL.revokeObjectURL(igState.objectUrl);
        _igDropCaptionFill();
        igState.file = file;
        igState.objectUrl = URL.createObjectURL(file);
        igState.error = null;
        igState.cover.frameMs = 0; igState.cover.frameUrl = ''; igState.cover.duration = 0; igState.videoDims = null;
        _igRenderForm();
        _igTryCaptionFill(file);
        // The length of the video sets the range of the frame picker.
        const probe = document.createElement('video');
        probe.preload = 'metadata';
        probe.onloadedmetadata = () => {
            if (igState.file === file && Number.isFinite(probe.duration)) {
                igState.cover.duration = probe.duration;
                igState.videoDims = probe.videoWidth && probe.videoHeight ? { w: probe.videoWidth, h: probe.videoHeight } : null;
                if (igState.cover.mode === 'frame' || _igMoreState('youtube').checked) _igRenderForm();
            }
            probe.removeAttribute('src');
        };
        probe.src = igState.objectUrl;
    }
    function _igClearFile() {
        if (igState.objectUrl) URL.revokeObjectURL(igState.objectUrl);
        _igDropCaptionFill();
        _igDropForget();
        igState.file = null; igState.objectUrl = null; igState.error = null;
        igState.cover.frameMs = 0; igState.cover.frameUrl = ''; igState.cover.duration = 0;
        _igRenderForm(); _igRenderPreview();
    }

    /* A dropped folder (plan row P2): one video and its cover and caption, or images as a carousel. A newer drop, a
       client change, Remove or a finished post retires one still being read (the sequence number). The caption file
       fills only an EMPTY caption box, with Undo; it is read before the video is set, so a Calendar match on the
       video's file name finds the box filled and leaves it. */
    // LinkedIn takes no cover, so its side never asks for one (the YouTube side takes the cover as Instagram's does).
    const _igDropSide = () => _igNet() === 'linkedin' ? 'linkedin' : 'instagram';
    function _igDropForget() { igState.dropSeq = (igState.dropSeq || 0) + 1; igState.drop = null; igState.dropNote = ''; }
    async function _igDropFolder(reading) {
        if (igState.submitting) return;
        _igDropForget();
        const seq = igState.dropSeq, client = igState.client;
        const entries = await reading;
        if (seq !== igState.dropSeq || client !== igState.client || igState.submitting) return;
        const sorted = svDropSorted(entries, _igDropSide());
        igState.error = sorted.error || null;
        if (sorted.error) { _igRenderForm(); return; }
        if (sorted.ask === 'video') { igState.drop = { sorted, seq }; igState.dropNote = ''; _igRenderForm(); return; }
        await _igDropApply(sorted, seq);
    }
    function _igDropPick(i) {
        const pick = igState.drop;
        if (!pick || igState.submitting) return;
        const wasCover = pick.sorted.ask === 'cover';
        const sorted = svDropPicked(pick.sorted, i, _igDropSide());
        if (wasCover) {
            igState.drop = null; igState.dropNote = svDropFoundLine(sorted, _igDropSide());
            if (sorted.cover) _igSetCoverImage(sorted.cover.file, sorted.cover.file.name, 'upload'); else _igRenderForm();
            return;
        }
        _igDropApply(sorted, pick.seq);
    }
    async function _igDropApply(sorted, seq) {
        const client = igState.client;
        const text = sorted.caption ? await svDropText(sorted.caption.file) : '';
        if (seq !== igState.dropSeq || client !== igState.client || igState.submitting) return;
        if (sorted.video) {
            if (igState.kind !== 'reel') _igSetKind('reel');
            // The dropped video is the source now, not a card chosen earlier (Codex on #2566).
            const src = _igSrc();
            if (src.mode === 'card') { src.mode = 'files'; if (src.state === 'copying') svPostSourceClear(src); }
            _igHandleFile(sorted.video.file);
        } else if (sorted.images.length >= IG_CAROUSEL_MIN) {
            if (igState.kind !== 'carousel') _igSetKind('carousel');
            // A caption an earlier drop filled, still unedited, leaves with the images it came with (Codex on #2566).
            _igDropCaptionFill();
            _igClearCarousel();
            _igHandleCarouselFiles(sorted.images.map(e => e.file));
        } else {
            igState.error = sorted.images.length ? 'This folder has one image and no video. A Reel needs a video, and a carousel needs ' + IG_CAROUSEL_MIN + ' or more images.' : 'This folder has no video or image to post.';
            _igRenderForm(); return;
        }
        if (text && !igState.title.trim()) {
            igState.title = text.slice(0, IG_MAX_CAPTION);
            igState.captionFill = { name: sorted.caption.path.split('/').pop(), text: igState.title, from: 'the folder' };
        }
        igState.drop = sorted.ask === 'cover' ? { sorted, seq } : null;
        igState.dropNote = svDropFoundLine(sorted, _igDropSide());
        _igRenderForm(); _igRenderPreview();
        if (sorted.video && sorted.cover && !sorted.ask) _igSetCoverImage(sorted.cover.file, sorted.cover.file.name, 'upload');
    }

    // A card's copy is in: its caption fills an EMPTY caption box (with Undo), and its thumbnail, already in Post for
    // Me storage, becomes the cover unless one is already chosen.
    function _igCardCopied(card, data) {
        const text = svPostSourceCaption(card, _igNet());
        if (text && !igState.title.trim()) {
            igState.title = text.slice(0, IG_MAX_CAPTION);
            igState.titleFromCard = igState.title;
            igState.captionFill = { name: card.name, text: igState.title };
        }
        const c = _igCover();
        if (data && data.thumb_url && !c.blob && !(c.mode === 'frame' && c.frameMs > 0)) {
            _igCoverClear(true);
            Object.assign(_igCover(), { mode: 'image', remoteUrl: String(data.thumb_url), note: '' });
        } else if (data && !data.thumb_url && data.thumb_note && !c.blob) {
            c.note = String(data.thumb_note);
        }
    }
    // Three steps, the same shape as TikTok's direct transport: (1) ask the function for a one-time Post For Me
    // storage URL, (2) PUT the video straight there from the browser, (3) tell the function to create the post.
    // Cancel works for steps 1 and 2. Once step 3 is sent its outcome may be unknown (a timeout, a dropped
    // connection), so the same retry-safe key is kept and sent again: a second press can never post twice.
    async function _igSubmit() {
        _igFromCard();
        if (_igTrialVersionsOn()) return _igSubmitTrialVersions();
        igState.instagramOn = _igInstagramOn();
        const err = _igValidate() || _igNetworksProblem();
        if (err) { igState.error = err; _igRenderForm(); return; }
        if (igState.kind === 'carousel') return _igSubmitCarousel();
        const account = _igResolveAccount(igState.client);
        const wall = igState.schedule.postNow ? '' : _igAt();
        const utc = wall ? (_igDeps.wallClockToUTC(wall, igState.schedule.tz) || '') : '';
        if (wall && !utc) { igState.error = 'That schedule time is not valid.'; _igRenderForm(); return; }
        const fromCard = _igFromCard();
        const src = _igSrc();
        const file = fromCard ? null : igState.file;
        const cv = igState.cover;
        const coverKey = cv.mode === 'image' ? (cv.blob ? 'img:' + cv.name + ':' + cv.blob.size : (cv.remoteUrl ? 'card-thumb:' + src.cardId : '')) : (cv.frameMs > 0 ? 'frame:' + cv.frameMs : '');
        const trial = igState.trial ? 'manual' : '';
        const fbState = _igFacebookState();
        const facebookAccountId = _igInstagramOn() && fbState.enabled && fbState.checked ? _igResolveFacebook(igState.client) : '';
        // post_networks_v1: Instagram may be unticked; YouTube and LinkedIn ride on the same one post. A cover goes
        // only where it can (Instagram or YouTube).
        const instagramOn = _igInstagramOn();
        const ytState = _igMoreState('youtube'), liState = _igMoreState('linkedin');
        const facts = _igVideoFacts();
        const youtube = ytState.checked ? { accountId: ytState.id, title: _igYtTitle().trim(), format: igState.yt.format, ...(facts.secs ? { durationSeconds: Math.round(facts.secs) } : {}), ...(facts.w && facts.h ? { width: facts.w, height: facts.h } : {}) } : null;
        const linkedin = liState.checked ? { accountId: liState.id } : null;
        const names = _igTickedNames();
        const coverOn = instagramOn || !!youtube;
        // A card is named by its id, not by the copy's address: a copy made again (after 20 h) is the same post.
        const media = fromCard ? ['card', src.cardId] : [file.name, file.size, file.lastModified];
        const more = (instagramOn ? '' : 'no-ig') + (youtube ? '|yt:' + youtube.format + ':' + youtube.title : '') + (linkedin ? '|li' : '');
        const fp = [igState.client].concat(media, [igState.title.trim(), utc, coverOn ? coverKey : '', trial, facebookAccountId ? 'fb' : ''], more ? [more] : []).join('|');
        if (!igState.attempt || igState.attempt.fp !== fp) {
            igState.attempt = { fp, key: (crypto.randomUUID && crypto.randomUUID().replace(/-/g, '')) || ('ig' + Date.now() + Math.random().toString(36).slice(2)) };
        }
        const idempotencyKey = igState.attempt.key;
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        _igAbort = ctrl;
        igState.submitting = true; igState.error = null; igState.notice = null; igState.progress = 0; igState.phase = 'preparing';
        _igRenderForm();
        try {
            let mediaUrl = '';
            let coverUrl = '';
            if (fromCard) {
                // The video is already in Post for Me storage (post-source); it is copied again first if it is old.
                const copied = await svPostSourceFresh(src, 'instagram');
                mediaUrl = copied.media_url;
                if (coverOn && cv.mode === 'image' && !cv.blob && cv.remoteUrl) coverUrl = copied.thumb_url || '';
                if (ctrl && ctrl.signal.aborted) throw Object.assign(new Error('Upload cancelled.'), { igCancelled: true });
            } else {
                const mint = await _igCall({ action: 'mint' }, null, ctrl && ctrl.signal);
                if (!mint.ok || !mint.json || !mint.json.upload_url || !mint.json.media_url) {
                    _igRecordFailure('instagram_mint', mint.status);
                    throw new Error((mint.json && mint.json.error) || 'Could not prepare the upload. Try again.');
                }
                mediaUrl = mint.json.media_url;
                igState.phase = 'uploading';
                await new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    _igActiveXhr = xhr;
                    xhr.open('PUT', mint.json.upload_url);
                    xhr.setRequestHeader('Content-Type', file.type || 'video/mp4');
                    xhr.upload.onprogress = (e) => {
                        if (!e.lengthComputable) return;
                        igState.progress = Math.min(90, Math.round((e.loaded / e.total) * 90));
                        const bar = document.getElementById('igProgress');
                        if (bar) bar.style.width = igState.progress + '%';
                    };
                    xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? resolve() : (_igRecordFailure('instagram_storage_put', xhr.status), reject(new Error('Video upload to storage failed (HTTP ' + xhr.status + '). Try again.')));
                    xhr.onerror = () => { _igRecordFailure('instagram_storage_put', 0, true); reject(new Error('Network error while uploading the video. Try again.')); };
                    xhr.onabort = () => reject(Object.assign(new Error('Upload cancelled.'), { igCancelled: true }));
                    xhr.send(file);
                });
                _igActiveXhr = null;
                if (ctrl && ctrl.signal.aborted) throw Object.assign(new Error('Upload cancelled.'), { igCancelled: true });
            }
            // A cover image goes to Post For Me storage the same way the video did; its address rides on the post.
            if (coverOn && cv.mode === 'image' && cv.blob) {
                const cmint = await _igCall({ action: 'mint' }, null, ctrl && ctrl.signal);
                if (!cmint.ok || !cmint.json || !cmint.json.upload_url || !cmint.json.media_url) {
                    _igRecordFailure('instagram_mint', cmint.status);
                    throw new Error((cmint.json && cmint.json.error) || 'Could not prepare the cover upload. Try again.');
                }
                const put = await fetch(cmint.json.upload_url, { method: 'PUT', headers: { 'Content-Type': cv.blob.type || 'image/jpeg' }, body: cv.blob, signal: ctrl ? ctrl.signal : undefined });
                if (!put.ok) { _igRecordFailure('instagram_cover_put', put.status); throw new Error('Cover upload to storage failed (HTTP ' + put.status + '). Try again.'); }
                coverUrl = cmint.json.media_url;
            }
            igState.phase = 'creating';
            _igRenderForm();
            const created = await _igCall({
                action: 'create', clientName: igState.client, socialAccountId: instagramOn ? account : '', title: igState.title.trim(),
                mediaUrl, coverUrl, options: { cover_timestamp_ms: (coverOn && cv.mode === 'frame' && cv.frameMs > 0) ? cv.frameMs : 0, ...(trial ? { trial_reel_type: trial } : {}) },
                scheduledAtUTC: utc, timezone: igState.schedule.tz, idempotencyKey,
                ...(facebookAccountId ? { alsoFacebook: true, facebookAccountId } : {}),
                ...(instagramOn ? {} : { instagram: false }),
                ...(youtube ? { youtube } : {}),
                ...(linkedin ? { linkedin } : {}),
            }, 'instagram_create');
            if (!created.ok) {
                // An answer that says no (4xx) is final. A server error or an unreadable answer leaves the outcome unknown.
                const final = _igCreateAnswerIsFinal(created);
                if (final) igState.attempt = null;
                // Post For Me did not accept it, and said why: show the reason and the failed row
                // (it used to read "could not confirm", with the reason hidden). The attempt is kept.
                const reason = final ? '' : _igCreateRefusalReason(created);
                if (reason) {
                    const failedRow = created.json.row;
                    if (failedRow && failedRow.id) { igState.uploads = [failedRow].concat(igState.uploads.filter(r => r.id !== failedRow.id)); _igRenderQueue(); }
                    throw Object.assign(new Error('Instagram did not take this post: ' + reason + ' Pressing the button again retries this same post; it cannot post twice.'), { igUnknown: false });
                }
                throw Object.assign(new Error((created.json && created.json.error) || ('The post could not be confirmed (HTTP ' + (created.status || 'no response') + ').')), { igUnknown: !final });
            }
            igState.attempt = null;
            const row = created.json.row;
            if (row) igState.uploads = [row].concat(igState.uploads.filter(r => r.id !== row.id));
            igState.submitting = false; igState.progress = 0; igState.phase = ''; _igAbort = null;
            igState.file = null; if (igState.objectUrl) URL.revokeObjectURL(igState.objectUrl); igState.objectUrl = null;
            if (fromCard) svPostSourceClear(src);
            igState.title = ''; igState.titleFromCard = ''; igState.captionFill = null; igState.trial = false; _igDropForget();
            _igCoverClear(false); igState.cover.frameMs = 0; igState.cover.duration = 0;
            igState.notice = names.length > 1
                ? (utc ? 'Scheduled for ' + _igAnd(names) + '. It will appear in the queue.' : 'Sent to ' + _igAnd(names) + '. Each shows as Posted here once it confirms.')
                : (utc ? 'Scheduled. It will appear in the queue.' : 'Sent to ' + names[0] + '. It will show as Posted here once ' + names[0] + ' confirms.');
            igState.yt = { title: '', edited: false, format: igState.yt.format }; igState.videoDims = null;
            igState.queueTab = 'upcoming';
            _igRenderForm(); _igRenderQueue(); _igSchedulePoll();
        } catch (e) {
            const inCreate = igState.phase === 'creating';
            _igActiveXhr = null; _igAbort = null;
            igState.submitting = false; igState.progress = 0; igState.phase = '';
            const cancelled = !!(e && (e.igCancelled || e.name === 'AbortError')) && !inCreate;
            if (cancelled) { igState.attempt = null; igState.error = 'Upload cancelled.'; }
            else if (inCreate && !(e && e.igUnknown === false)) igState.error = 'We could not confirm whether Instagram received this post. Press the button again: it will not post twice. You can also check the queue.';
            else igState.error = e && e.message ? e.message : 'The upload failed. Try again.';
            _igRenderForm();
        }
    }

    /* A carousel, the same three steps as a Reel: each item gets a one-time storage URL and is PUT there in
       carousel order, then one create call sends the list. The client, caption and schedule are read once,
       before the uploads, so an edit made while they run cannot send these items somewhere else. The
       retry-safe key works the same way as for a Reel: an unknown outcome keeps it, so a second press
       cannot post twice. */
    async function _igSubmitCarousel() {
        const client = igState.client;
        const account = _igResolveAccount(client);
        const title = igState.title.trim();
        const tz = igState.schedule.tz;
        const wall = igState.schedule.postNow ? '' : _igAt();
        const utc = wall ? (_igDeps.wallClockToUTC(wall, tz) || '') : '';
        if (wall && !utc) { igState.error = 'That schedule time is not valid.'; _igRenderForm(); return; }
        const items = igState.items.slice();
        const fbState = _igFacebookState();
        const facebookAccountId = fbState.enabled && fbState.checked ? _igResolveFacebook(client) : '';
        const fp = ['carousel', client, items.map(it => [it.file.name, it.file.size, it.file.lastModified].join(':')).join(','), title, utc, facebookAccountId ? 'fb' : ''].join('|');
        if (!igState.carouselAttempt || igState.carouselAttempt.fp !== fp) {
            igState.carouselAttempt = { fp, key: (crypto.randomUUID && crypto.randomUUID().replace(/-/g, '')) || ('ig' + Date.now() + Math.random().toString(36).slice(2)) };
        }
        const idempotencyKey = igState.carouselAttempt.key;
        const ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        _igAbort = ctrl;
        igState.submitting = true; igState.error = null; igState.notice = null; igState.progress = 0; igState.phase = 'uploading';
        _igRenderForm();
        try {
            const mediaUrls = [];
            for (let i = 0; i < items.length; i++) {
                const it = items[i];
                let body = it.file;
                if (!it.isVideo) {
                    try { body = await _igToJpeg(it.file); } catch (e) { throw new Error('Item ' + (i + 1) + ' (' + it.file.name + ') could not be read as an image.'); }
                }
                const mint = await _igCall({ action: 'mint' }, null, ctrl && ctrl.signal);
                if (!mint.ok || !mint.json || !mint.json.upload_url || !mint.json.media_url) {
                    _igRecordFailure('instagram_mint', mint.status);
                    throw new Error((mint.json && mint.json.error) || ('Could not prepare item ' + (i + 1) + '. Try again.'));
                }
                const type = it.isVideo ? (it.file.type || 'video/mp4') : 'image/jpeg';
                const put = await fetch(mint.json.upload_url, { method: 'PUT', headers: { 'Content-Type': type }, body, signal: ctrl ? ctrl.signal : undefined });
                if (!put.ok) { _igRecordFailure('instagram_storage_put', put.status); throw new Error('Item ' + (i + 1) + ' upload to storage failed (HTTP ' + put.status + '). Try again.'); }
                mediaUrls.push(mint.json.media_url);
                igState.progress = Math.round(((i + 1) / items.length) * 90);
                const bar = document.getElementById('igProgress');
                if (bar) bar.style.width = igState.progress + '%';
            }
            if (ctrl && ctrl.signal.aborted) throw Object.assign(new Error('Upload cancelled.'), { igCancelled: true });
            igState.phase = 'creating';
            _igRenderForm();
            const created = await _igCall({
                action: 'create', kind: 'carousel', clientName: client, socialAccountId: account, title,
                mediaUrls, options: {}, scheduledAtUTC: utc, timezone: tz, idempotencyKey,
                ...(facebookAccountId ? { alsoFacebook: true, facebookAccountId, itemTypes: items.map(it => (it.isVideo ? 'video' : 'image')) } : {}),
            }, 'instagram_create');
            if (!created.ok) {
                const final = _igCreateAnswerIsFinal(created);
                if (final) igState.carouselAttempt = null;
                const reason = final ? '' : _igCreateRefusalReason(created);
                if (reason) {
                    const failedRow = created.json.row;
                    if (failedRow && failedRow.id) { igState.uploads = [failedRow].concat(igState.uploads.filter(r => r.id !== failedRow.id)); _igRenderQueue(); }
                    throw Object.assign(new Error('Instagram did not take this post: ' + reason + ' Pressing the button again retries this same post; it cannot post twice.'), { igUnknown: false });
                }
                throw Object.assign(new Error((created.json && created.json.error) || ('The post could not be confirmed (HTTP ' + (created.status || 'no response') + ').')), { igUnknown: !final });
            }
            igState.carouselAttempt = null;
            const row = created.json.row;
            if (row) igState.uploads = [row].concat(igState.uploads.filter(r => r.id !== row.id));
            igState.submitting = false; igState.progress = 0; igState.phase = ''; _igAbort = null;
            _igClearCarousel();
            igState.title = ''; igState.titleFromCard = ''; igState.captionFill = null; _igDropForget();
            igState.notice = facebookAccountId
                ? (utc ? 'Scheduled for Instagram and Facebook. It will appear in the queue.' : 'Sent to Instagram and Facebook. Each shows as Posted here once it confirms.')
                : (utc ? 'Scheduled. It will appear in the queue.' : 'Sent to Instagram. It will show as Posted here once Instagram confirms.');
            igState.queueTab = 'upcoming';
            _igRenderForm(); _igRenderQueue(); _igSchedulePoll();
        } catch (e) {
            const inCreate = igState.phase === 'creating';
            _igAbort = null;
            igState.submitting = false; igState.progress = 0; igState.phase = '';
            const cancelled = !!(e && (e.igCancelled || e.name === 'AbortError')) && !inCreate;
            if (cancelled) { igState.carouselAttempt = null; igState.error = 'Upload cancelled.'; }
            else if (inCreate && !(e && e.igUnknown === false)) igState.error = 'We could not confirm whether Instagram received this post. Press the button again: it will not post twice. You can also check the queue.';
            else igState.error = e && e.message ? e.message : 'The upload failed. Try again.';
            _igRenderForm();
        }
    }

    // The queue group for a row: failed if either network failed, upcoming while either is still going,
    // otherwise done. Instagram's own result is r.status; Facebook's is r.facebook (null = Instagram only).
    // Every network a row went to, the row's own first: [{ name, status, url, error }]. A row from before P3 has no
    // `network` (Instagram) and no `networks`.
    const IG_NET_NAMES = { instagram: 'Instagram', facebook: 'Facebook', youtube: 'YouTube', linkedin: 'LinkedIn' };
    function _igRowNets(r) {
        const out = [{ name: IG_NET_NAMES[r.network] || 'Instagram', status: r.status, url: r.instagram_url, error: r.error }];
        if (r.facebook) out.push({ name: 'Facebook', status: r.facebook.status, url: r.facebook.url, error: r.facebook.error });
        const n = r.networks && typeof r.networks === 'object' ? r.networks : {};
        ['youtube', 'linkedin'].forEach(k => { if (n[k]) out.push({ name: IG_NET_NAMES[k], status: n[k].status, url: n[k].url, error: n[k].error }); });
        return out;
    }
    function _igEffective(r) {
        const all = _igRowNets(r).map(n => n.status);
        if (all.includes('failed')) return 'failed';
        return all.find(s => IG_UPCOMING.includes(s)) || r.status;
    }
    function _igNetworkHtml(name, status, error) {
        return `<div class="tk-q-net"><span class="tk-q-net-name">${name}</span><span class="tk-st ${_igEsc(status)}">${_igEsc(IG_STATUS_LABELS[status] || status)}</span>${error ? `<span class="tk-queue-error">${_igEsc(error)}</span>` : ''}</div>`;
    }
    function _igWhen(r) {
        const iso = r.scheduled_for || r.posted_at || r.created_at || '';
        if (!iso) return { day: '—', time: '' };
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return { day: '—', time: '' };
        const opts = r.timezone ? { timeZone: r.timezone } : {};
        let day, time;
        try {
            day = d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', ...opts });
            time = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', ...opts });
        } catch { day = d.toLocaleDateString(); time = d.toLocaleTimeString(); }
        return { day, time };
    }

    function _igRenderQueue() {
        const col = document.getElementById('igQueueCol');
        if (!col) return;
        const t = (r) => { const d = new Date(r.scheduled_for || r.posted_at || r.created_at || 0); return d.getTime() || 0; };
        // Each side lists the posts that went to its own network (the Instagram side: Instagram and Facebook).
        const side = { instagram: ['Instagram', 'Facebook'], youtube: ['YouTube'], linkedin: ['LinkedIn'] }[_igNet()];
        const all = igState.uploads.filter(r => _igRowNets(r).some(n => side.includes(n.name)));
        const groups = {
            upcoming: all.filter(r => IG_UPCOMING.includes(_igEffective(r))).sort((x, y) => t(x) - t(y)),
            failed: all.filter(r => _igEffective(r) === 'failed').sort((x, y) => t(y) - t(x)),
            done: all.filter(r => ['posted', 'cancelled'].includes(_igEffective(r))).sort((x, y) => t(y) - t(x)),
        };
        const tab = groups[igState.queueTab] ? igState.queueTab : 'upcoming';
        const rows = groups[tab];
        const shown = rows.slice(0, igState.queueLimit);
        const remaining = rows.length - shown.length;
        const item = (r) => {
            const status = _igEffective(r);
            const when = _igWhen(r);
            const id = _igEsc(r.id);
            const actions = [];
            if (r.status === 'scheduled') actions.push(`<button type="button" class="tk-q-btn tk-q-danger" data-ig-cancel="${id}">Cancel</button>`);
            const nets = _igRowNets(r);
            const many = nets.length > 1;
            nets.forEach(n => { if (n.url) actions.push(`<a class="tk-q-btn" href="${_igEsc(n.url)}" target="_blank" rel="noopener"${many ? ` aria-label="Open on ${n.name}"` : ''}>${many ? n.name : 'Open'}</a>`); });
            const kindLabel = r.kind === 'carousel' ? 'Carousel (' + _igEsc(r.items || '') + ')' : r.trial ? 'Trial reel' : 'Reel';
            return `
                <div class="tk-queue-item">
                    <div class="tk-q-when"><div class="tk-q-day">${_igEsc(when.day)}</div><div class="tk-q-time">${_igEsc(when.time)}</div></div>
                    <div class="tk-q-main">
                        <div class="tk-queue-client">${_igEsc(r.client || '—')}</div>
                        ${r.title ? `<div class="tk-queue-title">${_igEsc(r.title)}</div>` : ''}
                        ${many
                            ? `<div class="tk-q-meta"><span>${kindLabel} · ${_igAnd(nets.map(n => n.name))}</span></div>
                               <div class="tk-q-nets">${nets.map(n => _igNetworkHtml(n.name, n.status, n.error)).join('')}</div>`
                            : `<div class="tk-q-meta"><span class="tk-st ${_igEsc(status)}">${_igEsc(IG_STATUS_LABELS[status] || status)}</span><span>${kindLabel}${nets[0].name === 'Instagram' ? '' : ' · ' + nets[0].name}</span></div>
                        ${r.error ? `<div class="tk-queue-error">${_igEsc(r.error)}</div>` : ''}`}
                    </div>
                    ${actions.length ? `<div class="tk-queue-actions">${actions.join('')}</div>` : ''}
                </div>`;
        };
        const tabBtn = (key, label) => `<button type="button" class="tk-q-tab${tab === key ? ' on' : ''}${key === 'failed' && groups.failed.length ? ' alert' : ''}" role="tab" aria-selected="${tab === key}" data-ig-tab="${key}">${label}<b>${groups[key].length}</b></button>`;
        const empty = { upcoming: 'Nothing scheduled yet.', failed: 'No failed uploads.', done: 'No posts yet.' }[tab];
        const notice = igState.queueReadState === 'loading' ? '<div class="tk-queue-empty" role="status">Loading uploads…</div>'
            : igState.queueReadState === 'error' ? `<div class="tk-queue-empty" role="alert">Couldn't load your ${IG_NET_LABEL[_igNet()]} uploads. ${all.length ? 'Showing what we have. ' : ''}Trying again shortly.</div>` : '';
        col.innerHTML = `
            <div class="tk-card">
                <h3>${IG_NET_LABEL[_igNet()]} uploads</h3>
                <div class="tk-q-tabs" role="tablist">${tabBtn('upcoming', 'Upcoming')}${tabBtn('failed', 'Failed')}${tabBtn('done', 'Done')}</div>
                ${notice}
                ${shown.length ? shown.map(item).join('') : igState.queueReadState === 'ready' ? `<div class="tk-queue-empty">${empty}</div>` : ''}
                ${remaining > 0 ? `<button type="button" class="tk-q-more" data-ig-more>Show ${Math.min(remaining, IG_QUEUE_PAGE)} more <span>· ${remaining} left</span></button>` : ''}
            </div>`;
        col.querySelectorAll('[data-ig-tab]').forEach(b => b.addEventListener('click', () => { igState.queueTab = b.getAttribute('data-ig-tab'); igState.queueLimit = IG_QUEUE_PAGE; _igRenderQueue(); }));
        col.querySelector('[data-ig-more]')?.addEventListener('click', () => { igState.queueLimit += IG_QUEUE_PAGE; _igRenderQueue(); });
        col.querySelectorAll('[data-ig-cancel]').forEach(b => b.addEventListener('click', () => _igCancelRow(b.getAttribute('data-ig-cancel'))));
    }

    async function _igFetchQueue() {
        try {
            const r = await _igCall({ action: 'list', client: '' });
            if (!r.ok || !r.json || !Array.isArray(r.json.rows)) throw new Error('read failed');
            igState.uploads = r.json.rows;
            igState.queueReadState = 'ready';
        } catch {
            igState.queueReadState = igState.queueReadState === 'ready' ? 'ready' : 'error';
        }
        if (_igMounted) _igRenderQueue();
    }

    function _igCancelRow(id) {
        showConfirm('Cancel this scheduled post?', 'This removes the scheduled post from Post For Me, so it will not go out. The video file stays on your computer.', async () => {
            try {
                const r = await _igCall({ action: 'cancel', id }, 'instagram_cancel');
                if (!r.ok) throw new Error((r.json && r.json.error) || 'Post For Me did not cancel it.');
                igState.uploads = igState.uploads.map(x => x.id === id ? r.json.row : x);
                _igRenderQueue();
            } catch (e) { showNotify('Could not cancel', (e && e.message) || 'The cancel did not go through.'); }
        });
    }

    // Poll gently: often while something is being posted, rarely while only future posts wait, never when idle.
    function _igPollDelay() {
        if (igState.queueReadState === 'error') return 60000;
        // Both networks' results count: a Reel already on Instagram may still be going out on Facebook.
        const statuses = (r) => _igRowNets(r).map(n => n.status);
        if (igState.uploads.some(r => statuses(r).some(s => s === 'uploading' || s === 'processing'))) return 15000;
        if (igState.uploads.some(r => statuses(r).includes('scheduled'))) return 300000;
        return 0;
    }
    function _igStopPolling() { if (_igPollTimer) { clearTimeout(_igPollTimer); _igPollTimer = null; } }
    function _igSchedulePoll() {
        _igStopPolling();
        if (!_igMounted || (typeof document !== 'undefined' && document.visibilityState === 'hidden')) return;
        const delay = _igPollDelay();
        if (delay <= 0) return;
        _igPollTimer = setTimeout(() => { _igPollTimer = null; Promise.resolve(_igFetchQueue()).finally(_igSchedulePoll); }, delay);
    }

    // Called by the TikTok module when the person switches to Instagram (or lands on it after a reload).
    function mountInstagramPanel(deps) {
        _igDeps = deps;
        // The side this panel is now (OPEN_REPAIRS 687). YouTube and LinkedIn post one video: no carousel, no trial.
        const net = deps && (deps.network === 'youtube' || deps.network === 'linkedin') ? deps.network : 'instagram';
        if (net !== (igState.network || 'instagram')) {
            igState.network = net;
            igState.error = null; igState.notice = null;
            if (net !== 'instagram') { igState.kind = 'reel'; igState.trial = false; }
            // A folder still being read is retired (as _igDropForget, written out: the assurance suites lift this
