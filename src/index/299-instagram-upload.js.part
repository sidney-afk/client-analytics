    }
    // Called when the person switches back to TikTok or leaves the tab. The chosen video stays in memory.
    function teardownInstagramPanel() {
        _igMounted = false;
        _igStopPolling();
        const form = document.getElementById('igFormCol'), right = document.getElementById('igRightCol');
        if (form) form.hidden = true;
        if (right) right.hidden = true;
    }
    // The roster can arrive after this side first drew. Redrawn unless the caption is being typed into.
    function refreshInstagramForm() {
        if (!_igMounted) return;
        const a = document.activeElement;
        if (a && a.id === 'igTitle') return;
        _igRenderForm();
    }
    /* What a dropped folder holds, sorted for the Post tab (plan row P2a, OPEN_REPAIRS 648; posting.md
       section 2, "From files"). Pure: it reads only each entry's `path` ("Folder/name.ext", or "name.ext" for
       a loose file) and hands the entries back as given. The drop zones call it through svDropSorted (plan row P2).
       Hidden and system files are skipped without a word; any other file that is not a video, image or text
       is named in `ignoredLine`, so nothing is dropped silently. `ask` is '' when nothing needs a person,
       'video' when several videos need a pick, 'cover' when several images and one video need one. */
    function svSortDroppedFiles(entries) {
        const out = { error: '', video: null, cover: null, caption: null, videos: [], images: [], texts: [], carousel: [], ignored: [], ignoredLine: '', ask: '', askText: '', captionNote: '' };
        const list = Array.isArray(entries) ? entries.filter(e => e && typeof e.path === 'string' && e.path) : [];
        const folders = new Set(list.map(e => e.path.split('/')).filter(p => p.length > 1).map(p => p[0]));
        if (folders.size > 1) { out.error = 'Drop one folder at a time.'; return out; }
        const base = (e) => e.path.split('/').pop();
        const ext = (e) => { const m = /\.([^.]+)$/.exec(base(e)); return m ? m[1].toLowerCase() : ''; };
        const hidden = (e) => e.path.split('/').some(p => p.startsWith('.')) || /^(thumbs\.db|desktop\.ini)$/i.test(base(e));
        const byName = (a, b) => base(a).localeCompare(base(b), undefined, { numeric: true, sensitivity: 'base' }) || a.path.localeCompare(b.path);
        for (const e of list.filter(e => !hidden(e)).sort(byName)) {
            const x = ext(e);
            if (['mp4', 'mov', 'm4v', 'webm'].includes(x)) out.videos.push(e);
            else if (['jpg', 'jpeg', 'png', 'webp'].includes(x)) out.images.push(e);
            else if (['txt', 'md'].includes(x)) out.texts.push(e);
            else out.ignored.push(e);
        }
        if (out.videos.length === 1) out.video = out.videos[0];
        else if (out.videos.length > 1) { out.ask = 'video'; out.askText = 'This folder has ' + out.videos.length + ' videos. Pick one.'; }
        if (out.videos.length) {
            out.cover = out.images.length === 1 ? out.images[0] : (out.images.find(e => /^(thumbnail|thumb|cover)/i.test(base(e))) || null);
            if (!out.cover && out.images.length > 1 && !out.ask) { out.ask = 'cover'; out.askText = 'This folder has ' + out.images.length + ' images. Pick the cover.'; }
        } else if (out.images.length > 1) out.carousel = out.images.slice();
        if (out.texts.length === 1) out.caption = out.texts[0];
        else if (out.texts.length > 1) {
            out.caption = out.texts.find(e => /^caption/i.test(base(e)) && ext(e) === 'txt') || null;
            if (!out.caption) out.captionNote = 'This folder has ' + out.texts.length + ' text files and none is named caption, so the caption was not filled.';
        }
        if (out.ignored.length) {
            const kinds = [...new Set(out.ignored.map(e => ext(e) ? '.' + ext(e) : base(e)))].sort();
            out.ignoredLine = 'Ignored ' + out.ignored.length + ' file' + (out.ignored.length === 1 ? '' : 's') + ': ' + kinds.join(', ');
        }
        return out;
    }

    /* A drop that holds a folder (plan row P2, OPEN_REPAIRS 654), behind post_sources_v1. Returns null when the
       switch is off for this client or the drop holds no folder (the zone then does what it did before), else a
       promise of [{ path, file }], two levels deep. The drop's entries are taken before the first await: a browser
       empties the drop's item list once the event is over. */
    function svDroppedFolder(dt, client) {
        if (!client || !svPostSourcesOn(client)) return null;
        const items = dt && dt.items ? Array.from(dt.items) : [];
        const roots = items.map(it => (it && it.kind === 'file' && typeof it.webkitGetAsEntry === 'function') ? it.webkitGetAsEntry() : null).filter(Boolean);
        if (!roots.some(r => r.isDirectory)) return null;
        const fileOf = (fe) => new Promise(res => fe.file(res, () => res(null)));
        const childrenOf = (dir) => new Promise(res => {
            const reader = dir.createReader(); const all = [];
            const next = () => reader.readEntries(batch => { if (!batch.length) { res(all); return; } all.push(...batch); next(); }, () => res(all));
            next();
        });
        const out = [];
        const walk = async (entry, prefix, depth) => {
            if (entry.isFile) { const f = await fileOf(entry); if (f) out.push({ path: prefix + entry.name, file: f }); return; }
            if (entry.isDirectory && depth < 2) for (const c of await childrenOf(entry)) await walk(c, prefix + entry.name + '/', depth + 1);
        };
        return (async () => { for (const r of roots) await walk(r, '', 0); return out; })();
    }
    // The folder sorted for one side. TikTok takes its cover from the video, so it never asks for one.
    function svDropSorted(entries, side) {
        const s = svSortDroppedFiles(entries);
        if (side !== 'instagram' && s.ask === 'cover') { s.ask = ''; s.askText = ''; }
        return s;
    }
    // A pick from the folder's list: a video first, then (Instagram) a cover when the images still need one.
    function svDropPicked(s, i, side) {
        if (s.ask === 'video') {
            s.video = s.videos[i] || null;
            const needCover = side === 'instagram' && !s.cover && s.images.length > 1;
            s.ask = needCover ? 'cover' : '';
            s.askText = needCover ? 'This folder has ' + s.images.length + ' images. Pick the cover.' : '';
        } else if (s.ask === 'cover') { s.cover = s.images[i] || null; s.ask = ''; s.askText = ''; }
        return s;
    }
    // A caption file's text, or '' when it cannot be read.
    async function svDropText(file) {
        try { return String(await file.text()).replace(/\r\n?/g, '\n').trim(); } catch (e) { return ''; }
    }
    // One quiet line after a folder: what was used, and what was not.
    function svDropFoundLine(s, side) {
        const found = [];
        if (s.video) found.push('video');
        else if (s.images.length) found.push(s.images.length === 1 ? '1 image' : s.images.length + ' images');
        if (s.video && s.cover && side === 'instagram') found.push('cover');
        if (s.caption) found.push('caption');
        const parts = [];
        if (found.length) { const t = found.length > 1 ? found.slice(0, -1).join(', ') + ' and ' + found[found.length - 1] : found[0]; parts.push(t.charAt(0).toUpperCase() + t.slice(1) + ' found.'); }
        if (s.video && s.cover && side === 'tiktok') parts.push('TikTok takes its cover from the video, so the image is not used.');
        if (s.captionNote) parts.push(s.captionNote);
        if (s.ignoredLine) parts.push(s.ignoredLine + '.');
        return parts.join(' ');
    }
    // The folder's pick list (several videos, or several images for a cover), then the line above.
    function svDropPickHtml(prefix, pick, disabled) {
        if (!pick || !pick.sorted.ask) return '';
        const s = pick.sorted;
        const list = s.ask === 'cover' ? s.images : s.videos;
        return `<div class="tk-drop-pick" id="${prefix}DropPick" role="group" aria-label="${_igEsc(s.askText)}"><div class="tk-step-note">${_igEsc(s.askText)}</div><div class="tk-drop-pick-list">${list.map((e, i) => `<button type="button" class="tk-mini-btn tk-drop-pick-btn" data-${prefix}-drop-pick="${i}" title="${_igEsc(e.path)}" ${disabled ? 'disabled' : ''}>${_igEsc(e.path.split('/').pop())}</button>`).join('')}</div></div>`;
    }
    function svDropNoteHtml(prefix, note) {
        return note ? `<div class="tk-step-note tk-drop-note" id="${prefix}DropNote" role="status">${_igEsc(note)}</div>` : '';
    }

    function instagramResumePolling() { if (_igMounted) { Promise.resolve(_igFetchQueue()).finally(_igSchedulePoll); } }

