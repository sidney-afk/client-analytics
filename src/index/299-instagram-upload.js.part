           still said A, and a video attached then went to A's Instagram. */
        // A caption a Calendar card filled in, unedited, is not a post being written.
        const igIdle = !igState.file && !igState.items.length && !igState.submitting && !(igState.source && igState.source.cardId)
            && (!String(igState.title || '').trim() || (!!igState.titleFromCard && igState.title === igState.titleFromCard));
        if (shared && (WL_CLIENT_NAMES || []).includes(shared) && (!igState.client || (igIdle && igState.client !== shared))) {
            const leaving = igState.client && igState.client !== shared;
            igState.client = shared;
            if (leaving) _igLeaveClient();
