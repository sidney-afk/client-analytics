    function _kasperSyncMoreNotificationCount() {
        const badge = document.querySelector('[data-kasper-more-count]');
        const trigger = document.querySelector('[data-kasper-more-trigger]');
        if (!badge || !trigger) return;
        let total = 0;
        KASPER_MORE_NOTIFICATION_KEYS.forEach(key => {
            const el = document.querySelector('[data-kasper-count="' + key + '"]');
            if (el && !el.hidden) total += Math.max(0, Number(el.textContent) || 0);
        });
        badge.textContent = String(total);
        badge.hidden = total === 0;
        const activeLabel = trigger.querySelector('[data-kasper-more-label]');
        const label = activeLabel ? activeLabel.textContent : 'More';
        trigger.title = total ? label + ': ' + total + ' notification' + (total === 1 ? '' : 's') : (label === 'More' ? 'More sections' : label);
