        const localFin = !!(_kasperState.dismissed && _kasperState.dismissed[post.id]);
        if (!stampedAt && !localFin) return false;
        // Once finished, a card STAYS in "Tweaks pending" and returns to "Waiting"
        // ONLY when a component is genuinely re-sent to Kasper Approval. A later
        // message — even a client tweak — updates the card in place but must NOT pull
        // it back into his queue (product rule: Finish means finished until an explicit
        // For-Kasper-Approval re-route; the earlier reply-re-surfaces-it behaviour was
        // the friction — a client tweak kept bouncing finished cards back into
        // "Waiting"). Gated on a SERVER-CONFIRMED finish (stamp present) so a mid-write
        // stale read can't bounce a freshly-finished card; _kasperUndecidedComps applies
        // the unlinked-thumbnail gate (a graphic stuck at KA with no GRA sub-issue
        // doesn't count).
