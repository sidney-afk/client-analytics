    const KASPER_CAL_CACHE_TTL = 5 * 60 * 1000;
    function _kasperCalCacheKey(slug) { return 'syncview_kasper_cal_' + slug + '_v1'; }
    const KASPER_CAL_CACHE_MAX_CLIENTS = 8;
    function _kasperCalCachePrune(keepSlug) {
        const keepKey = _kasperCalCacheKey(String(keepSlug || ''));
        const entries = [];
        try {
            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (!key || key === keepKey) continue;
                if (!/^syncview_kasper_cal_.*_v1$/.test(key)) continue;
                let savedAt = 0;
                try { savedAt = Number(JSON.parse(localStorage.getItem(key) || '{}').savedAt) || 0; } catch {}
                entries.push({ key, savedAt });
            }
        } catch { return; }
        const now = Date.now();
        const stale = entries.filter(e => !e.savedAt || now - e.savedAt >= KASPER_CAL_CACHE_TTL);
        const live = entries.filter(e => !stale.includes(e)).sort((a, b) => b.savedAt - a.savedAt);
        // keepSlug is excluded above, so it holds one of the allowed slots.
        const overflow = live.slice(Math.max(0, KASPER_CAL_CACHE_MAX_CLIENTS - 1));
        stale.concat(overflow).forEach(e => { try { localStorage.removeItem(e.key); } catch {} });
    }
    /* A per-browser Finish / Close mark is a CONTINUITY aid for the seconds before the write
