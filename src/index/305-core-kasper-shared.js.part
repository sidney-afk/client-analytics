    function _kasperSampleSentAtMs(post) {
        let best = Infinity;
        for (const c of SXR_REVIEW_COMPONENTS) {
            if (String(post[c + '_status'] || '') !== 'Kasper Approval') continue;
            const t = Date.parse(post[c + '_status_at'] || '');
            if (isFinite(t) && t < best) best = t;
        }
        if (best === Infinity) {
