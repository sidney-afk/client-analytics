        // optional slack_user_id / slack_team_id (the script ignores anything
        // it doesn't recognise so adding columns later is non-breaking).
        try {
            const resp = await fetch(KASPER_SMM_URL + '&_t=' + Date.now());
            const text = await resp.text();
            const rows = parseCSV(text);
            const map = new Map();
            for (const r of rows) {
                const name = (r.client_name || r.client || '').trim();
                if (!name) continue;
                const slug = wlNormalizeClient(name);
                if (!slug) continue;
                map.set(slug, {
                    name: (r.social_media_manager || r.smm_name || r.smm || '').trim(),
                    slack_profile_url: (r.slack_profile_url || r.slack_url || r.slack_link || '').trim(),
                    slack_user_id: (r.slack_user_id || r.smm_slack_id || '').trim(),
                    slack_team_id: (r.slack_team_id || '').trim(),
                });
            }
            return map;
