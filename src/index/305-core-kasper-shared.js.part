                    post: it.post,
                    client: it.client,
                    slug: it.slug,
                    smm: it.smm,
                    // Cards always rehydrate collapsed from cache. Kasper
                    // opens the day fresh and decides which to dig into;
                    // resuming with five cards already expanded under
