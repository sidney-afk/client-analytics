    function _kasperLocalFlagLive(v) { return typeof v === 'number' && isFinite(v) && Date.now() - v < KASPER_LOCAL_FLAG_MS; }
    function _kasperUrgentSupersedes(post, stampIso) {
        if (!_calKasperUrgentActive(post)) return false;
        const stamp = Date.parse(stampIso || '');
        const ping = Date.parse((post && post.kasper_urgent_pinged_at) || '');
        if (!isFinite(stamp) || !isFinite(ping)) return true;
        return ping > stamp;
