            return true;
        } catch (e) { return false; }
    }
    function _kasperSetTabCount(key, n) {
        document.querySelectorAll('[data-kasper-count="' + key + '"]').forEach(el => {
            el.textContent = String(n);
            if (el.hasAttribute('data-kasper-hide-zero')) el.hidden = Number(n) === 0;
        });
        _kasperSyncMoreNotificationCount();
