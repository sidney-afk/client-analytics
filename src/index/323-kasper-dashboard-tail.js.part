        const focusId = activeEl && body.contains(activeEl) && activeEl.id ? activeEl.id : '';
        body.innerHTML = staleNote + (selected ? `<div class="ca-detail" id="caDetail">${_caDetailHtml(selected)}</div>` : _caLandingHtml());
        if (focusId) { const el = document.getElementById(focusId); if (el) { try { el.focus({ preventScroll: true }); } catch (e) {} } }
