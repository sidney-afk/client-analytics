  _caPurgeSensitiveState, _caRender, _kasperEnsureAllTabCounts, _kasperMarkRepliesRead,
  _kasperRenderReplies, _kasperRepliesDraftInput, _kasperRepliesReply, _kasperRepliesToggleAll
