        } else {
            _caEditSay('Could not load the sheet (' + _calEsc(out.json.error || ('HTTP ' + out.resp.status)) + ').', 'error');
        }
        _caPaint();
    }

    // ---- The profile ----
    // Remember which folded sections are open across repaints (not while editing, which opens them all).
    function _caFold(key, open) { if (!_caState.edit) _caState.folds[key] = !!open; }
    function _caDetailHtml(r) {
        const ed = _caState.edit && _caState.edit.slug === r.slug ? _caState.edit : null;
        const input = (k, label) => {
            const v = k in ed.draft ? ed.draft[k] : (r[k] == null ? '' : String(r[k]));
            const flag = ed.conflictFields && ed.conflictFields.includes(k) ? ' is-conflict' : '';
            const attrs = `id="caIn_${k}" data-ca-field="${k}" oninput="_caEditInput(this)" ${ed.saving ? 'disabled' : ''} aria-label="${_calEscAttr(label)}"`;
            return CA_LONG_FIELDS.includes(k)
                ? `<textarea class="ca-input${flag}" rows="3" ${attrs}>${_calEsc(v)}</textarea>`
                : `<input class="ca-input${flag}" type="text" autocomplete="off" spellcheck="false" value="${_calEscAttr(v)}" ${attrs}>`;
        };
        const field = ([k, label]) => ed
            ? `<div class="ca-field${CA_LONG_FIELDS.includes(k) ? ' is-wide' : ''}"><dt><label for="caIn_${k}">${_calEsc(label)}</label></dt><dd>${input(k, label)}</dd></div>`
            : `<div class="ca-field"><dt>${_calEsc(label)}</dt><dd>${_caValueHtml(k, r[k])}</dd></div>`;
        const cards = CA_GROUPS.map(g => `<section class="ca-card ca-group is-${g.tone}" data-ca-group="${g.key}"><h4>${_calEsc(g.title)}</h4><dl>${g.fields.map(field).join('')}</dl></section>`).join('');
        // One row of the most-used jumps, under the name.
        const reach = [['email', 'Email', CA_ICONS.mail], ['slack_channel_id', 'Slack', CA_ICONS.slack], ['creative_channel_id', 'Creative', CA_ICONS.brush],
            ['instagram_handle', 'Instagram', CA_ICONS.ig], ['tiktok_handle', 'TikTok', CA_ICONS.tt], ['youtube_channel_id', 'YouTube', CA_ICONS.yt]]
            .map(([k, label, icon]) => { const l = _caLinkFor(k, r[k]); return l ? `<a class="ca-reach-btn" href="${_calEscAttr(l.href)}" target="_blank" rel="noopener" data-ca-reach="${k}">${icon}<span>${label}</span></a>` : ''; }).join('');
        const m = _caManager(r.slug);
