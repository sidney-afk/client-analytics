            ? `<div class="ca-mgr-wrap"><button type="button" class="ca-mgr" id="caMgrBtn" onclick="_caLoadManagers()"><span class="ca-mgr-lbl">Manager not loaded.</span><span class="ca-mgr-cur">Try again</span></button></div>` : '';
        const mgrBtn = mgrRetry || `<div class="ca-mgr-wrap"><button type="button" class="ca-mgr" id="caMgrBtn" aria-haspopup="menu" aria-expanded="${_caState.picker}" onclick="_caMgrToggle()" ${!_caState.managers || !canEdit || ed || _caState.pickerBusy ? 'disabled' : ''}>
                ${m ? _caAvatar(m.name, 'is-sm') : ''}<span class="ca-mgr-lbl">Managed by</span><span class="ca-mgr-cur">${_caState.pickerBusy ? 'Saving…' : mgrLabel}</span>${_caState.managers && canEdit && !ed ? CA_ICONS.chev : ''}
            </button>${_caMgrPickerHtml(r)}</div>`;
        const research = `<details class="ca-fold ca-group" data-ca-fold="research"${ed || _caState.folds.research ? ' open' : ''} ontoggle="_caFold('research', this.open)"><summary><h4>${_calEsc(CA_RESEARCH.title)}</h4><span class="ca-fold-tag">Rarely needed</span></summary><dl>${CA_RESEARCH.fields.map(field).join('')}</dl></details>`;
        const extra = r.extra && typeof r.extra === 'object' ? Object.entries(r.extra).filter(([, v]) => String(v == null ? '' : v).trim()) : [];
        const extraHtml = extra.length && !ed ? `<details class="ca-fold ca-group" data-ca-fold="extra"${_caState.folds.extra ? ' open' : ''} ontoggle="_caFold('extra', this.open)"><summary><h4>Other sheet columns</h4></summary><dl>${extra.map(([k, v]) => `<div class="ca-field"><dt>${_calEsc(k)}</dt><dd>${_calEsc(String(v))}</dd></div>`).join('')}</dl></details>` : '';
        const onboarding = `<details class="ca-fold ca-group ca-onb" data-ca-fold="onboarding"${_caState.folds.onboarding ? ' open' : ''} ontoggle="_caFold('onboarding', this.open)"><summary><h4>Onboarding</h4><span class="ca-admin-pill">Admin</span><span class="ca-fold-tag" id="caOnbSummary"></span></summary><div class="cb-mount" id="caOnboarding"></div></details>`;
        return `<header class="ca-hero ca-detail-head" style="--ca-h:${_svClientHue(_caName(r))}">
