            </header>
            ${ed && ed.message ? `<div class="ca-msg${ed.messageKind ? ' is-' + ed.messageKind : ''}" role="${ed.messageKind === 'error' ? 'alert' : 'status'}">${ed.message}</div>` : ''}
            <div class="ca-cards">${cards}</div>
            <div class="cb-mount ca-hs" id="caHubspot"></div>
            <div class="ca-lower">${research}${extraHtml}${onboarding}</div>
            ${ed ? `<div class="ca-editbar">
                <span class="ca-editnote">${_caNative() ? 'Saves only if nobody changed this client since you opened it. Every change is kept in the history.' : 'Saves to the Clients Info sheet first, then SyncView.'}</span>
                <button type="button" class="cc-btn" onclick="_caEditCancel()" ${ed.saving ? 'disabled' : ''}>Cancel</button>
                <button type="button" class="cc-btn primary ca-save" onclick="_caEditSave()" ${ed.saving ? 'disabled' : ''}>${ed.saving ? 'Saving…' : 'Save changes'}</button>
            </div>` : ''}
            <footer class="ca-prov">Last saved ${_calEsc(_caWhen(r.updated_at) || 'unknown')} by ${_calEsc(r.updated_by || 'unknown')} · <button type="button" class="ca-link" id="caHistBtn" aria-expanded="${_caState.historyOpen}" onclick="_caToggleHistory()">${_caState.historyOpen ? 'Hide history' : 'See history'}</button>${_caHistoryHtml()}</footer>`;
    }

    function _caLandingHtml() {
        const recent = _caRecentMap();
        const opened = (_caState.rows || []).filter(r => !r.archived_at && recent[r.slug]).sort((a, b) => recent[b.slug] - recent[a.slug]).slice(0, 6);
        const active = (_caState.rows || []).filter(r => !r.archived_at).length;
        return `<div class="ca-land">
                <p class="ca-land-lead">${active} client${active === 1 ? '' : 's'}. Search above, or open All clients.</p>
                ${opened.length ? `<div class="ca-land-label">Recently opened</div><div class="ca-recent">${opened.map(r => `<button type="button" class="ca-chip" data-ca-slug="${_calEscAttr(r.slug)}" onclick="_caSelect('${_calEscAttr(r.slug)}')">${_caAvatar(_caName(r), 'is-sm')}${_calEsc(_caName(r))}</button>`).join('')}</div>` : ''}
            </div>`;
    }

    function _caPaint() {
        _caBindOutside();
        const body = document.getElementById('caBody');
        if (!body) return;
        if (_caState.loading && !_caState.loaded) { body.innerHTML = `<div class="ca-status">Loading clients…</div>`; return; }
        if (_caState.error && !_caState.loaded) { body.innerHTML = `<div class="ca-status is-error">${_calEsc(_caState.error)} <button class="cc-btn" type="button" onclick="_caLoad(false)">Try again</button></div>`; return; }
        const selected = (_caState.rows || []).find(r => r.slug === _caState.selected) || null;
        const staleNote = _caState.error ? `<div class="ca-stale" role="alert">Loading failed: ${_calEsc(_caState.error)} Showing the last list loaded. <button class="cc-btn" type="button" onclick="_caLoad(false)">Try again</button></div>` : '';
        // Keep the typed text and focus if a repaint lands while someone is editing.
