import { svFocusKeep, svLayerOpen, svLayerRelease } from './041-core-layers.js';
import { CAL_SUPABASE_URL, _syncviewCloseStaffAccount, _syncviewStaffIdentityForHeaders, _syncviewStaffRoleValue } from './100-onboarding-staff-controls.js';
import { showToast } from './040-shared-briefs.js';
import { navTo } from './092-core-submit-form-navigation.js';
import { currentNav } from './065-core-nav-intake-state.js';
import { _syncviewEfHeaders } from './120-calendar-flags-write-repair.js';
import { _calSetFocusRequest, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr, _jsAttrArg } from './131-core-html.js';
import { _calDeriveThumb, onCalClientChange } from './160-calendar-organize-ui.js';
import { COMP_LABELS } from './180-calendar-native-post-media.js';
import {
  _CAL_LOCK_ICO, _calCommentRole, _calCommentSendPending, _calCurrentAuthor, _calCurrentAuthorId,
  _calFindCompForCommentId, _calFmtCommentTime, _calMintCommentId, _calNoteAuthorName, _noteOutboxAsComment,
  _noteOutboxDrop, _noteOutboxFor, _noteOutboxGet, _noteOutboxPut, _noteOutboxSend, _noteOutboxStatusHtml,
  openCalComments
} from './190-calendar-approval-comments.js';
import { _prodCanonicalCommentGate, _prodProjectCanonicalCardComments } from './230-production-create-comments.js';
import { _calLoadPostsWithoutScreen, _calV2Client, _calV2Ready } from './150-calendar-hydration-import.js';
import { wlCanonicalClient } from './070-core-client-names.js';
import { _isClientLink } from './260-production-refresh-boot.js';
    /* ── Messages inbox (Notes Step 2) ─────────────────────────────────────
       Plan: docs/plans/2026-10-13-notes-messages.md, section 6 "Step 2".

       One inbox for all staff, shown as its own page (route "messages"): the
       header Messages button, the Tabs menu on a phone and the Kasper
       Messages tab all open it.

       Who sees what is decided on the SERVER (production-comments, action
       "inbox"): an admin who is not on the SMM roster sees every client,
       anyone on the roster sees their own clients ("My clients"), editors and
       designers see nothing, and a posted post drops out. Nothing here reads
       a table with the browser key.

       A reply is written by the Notes save path itself (_calAppendComment, the
       one Step 1 uses): the conversation's client is loaded into the Calendar
       first, exactly as opening that card would, and the reply goes under the
       thread it answers, so it keeps that thread's part and audience. */
    const MSG_URL = CAL_SUPABASE_URL + '/functions/v1/production-comments';
    const MSG_REFRESH_MS = 60000;   // the safety-net refresh; realtime and other tabs reach it sooner
    const MSG_LIVE_GAP_MS = 5000;   // card edits trigger at most one live inbox read per 5 s, however many arrive
    const _msgState = {
        loading: false, loaded: false, error: '', conversations: [], scope: '',
        openId: '', replyTo: '', draft: '', sending: false, filter: 'new', lastAt: 0,
        unavailable: false, fromCache: false, readWhenFresh: '', owner: '', epoch: 0,
    };
    let _msgTimer = null;
    const _msgFallbackHooks = [];
    // Phone presentation only; the native inbox and Notes writers own access,
    // unread marks, audience, component and reply persistence.
    const _msgPhone = {query:'',drafts:new Map(),unread:new Map(),listScroll:0,focusId:'',firstOpen:false,returning:false};
    const _msgIsPhone = () => !!window.svIsStaffPhone?.();
    function _msgPhoneKeepDraft() {
        if (_msgIsPhone() && _msgState.openId) _msgPhone.drafts.set(_msgState.openId,{draft:_msgState.draft,replyTo:_msgState.replyTo});
    }
    function _msgPhoneSearch(value) {
        _msgPhone.query=value;
        const list=document.querySelector('#msgPage .msg-convs');
        if(list) list.innerHTML=_msgListHtml();
    }
    function _msgPhoneLayout() {
        const root=document.getElementById('msgPage');if(!root)return;
        if(!_msgIsPhone()){if(root.hasAttribute('data-thumb-messages')){delete root.dataset.thumbMessages;root.style.removeProperty('--thumb-msg-height');}return;}
        root.dataset.thumbMessages='';
        if(window.scrollY)window.scrollTo(0,0);
        const viewport=window.visualViewport;
        const height=Math.max(220,(viewport?.height||innerHeight)+(viewport?.offsetTop||0)-root.getBoundingClientRect().top-window.scrollY);
        const value=Math.round(height)+'px';
        if(root.style.getPropertyValue('--thumb-msg-height')!==value)root.style.setProperty('--thumb-msg-height',value);
        const box=root.querySelector('#msgReplyBox');
        if(box&&box.scrollHeight>box.clientHeight&&box.clientHeight<120)box.style.height=Math.min(120,Math.max(44,box.scrollHeight))+'px';
    }
    window.addEventListener('resize',_msgPhoneLayout);
    window.visualViewport?.addEventListener('resize',_msgPhoneLayout);
    window.visualViewport?.addEventListener('scroll',_msgPhoneLayout);
    window.matchMedia?.('(max-width:767px)').addEventListener('change',()=>{
        const root=document.getElementById('msgPage');if(!root)return;
        const box=root.querySelector('#msgReplyBox'),focused=box&&document.activeElement===box;
        const selection=focused?[box.selectionStart,box.selectionEnd]:null;
        document.querySelectorAll('.thumb-msg-more[open]').forEach(d=>d.close());
        if(focused)box.blur();
        _msgPaint();
        const next=root.querySelector('#msgReplyBox');
        if(focused&&next){next.focus({preventScroll:true});next.setSelectionRange(...selection);}
    });
    function _msgPhoneMore(trigger) {
        if(!_msgIsPhone()||!_msgCanUse())return;
        const dialog=document.createElement('dialog');dialog.className='thumb-msg-more';dialog.setAttribute('aria-label','Conversation actions');dialog.setAttribute('data-backdrop-dismiss','');
        dialog.innerHTML='<header><h2>Conversation</h2><button type="button" aria-label="Close conversation actions">Close</button></header><section aria-label="Conversation actions"><button type="button" data-msg-more="unread">Mark as unread</button><button type="button" data-msg-more="card">Open card</button></section>';
        dialog.querySelector('header button').onclick=()=>dialog.close();
        dialog.querySelector('[data-msg-more=unread]').onclick=()=>{dialog.close();_msgMarkUnread();};
        dialog.querySelector('[data-msg-more=card]').onclick=()=>{dialog.close();_msgOpenCard();};
        dialog.addEventListener('click',e=>{if(e.target===dialog&&dialog._backdropPressBegan)dialog.close();});
        dialog.addEventListener('close',()=>{svLayerRelease('thumb-message-actions');dialog.remove();if(trigger?.isConnected)trigger.focus({preventScroll:true});});
        document.body.append(dialog);dialog.showModal();
        svLayerOpen({key:'thumb-message-actions',region:dialog,opener:trigger,isOpen:()=>dialog.open,close:()=>dialog.close()});
    }

    /* The page can go live before the production-comments deploy that adds
       the inbox. The old function answers `inbox` with invalid_deliverable_id;
       then the Messages tab keeps its old view, the Messages button stays
       hidden, and nothing polls until the next page load. */
    function _msgInboxLive() { return !_msgState.unavailable; }
    function _msgOnFallback(fn) { if (typeof fn === 'function') _msgFallbackHooks.push(fn); }
    function _msgFallBack() {
        if (_msgState.unavailable) return;
        _msgState.unavailable = true;
        _msgCacheClear();
        if (_msgTimer) { clearInterval(_msgTimer); _msgTimer = null; }
        _msgReturn = null;
        _msgLeavePage();
        const btn = document.getElementById('navMessages');
        if (btn) btn.style.display = 'none';
        _msgFallbackHooks.forEach(fn => { try { fn(); } catch (e) {} });
    }

    function _msgCanUse() {
        const identity = _syncviewStaffIdentityForHeaders();
        const role = _syncviewStaffRoleValue(identity);
        return role === 'admin' || role === 'smm';
    }
    function _msgMe() {
        const identity = _syncviewStaffIdentityForHeaders();
        return String(identity && identity.member && identity.member.name || '');
    }
    const _msgSameName = (a, b) => String(a || '').trim().toLowerCase().replace(/\s+/g, ' ') === String(b || '').trim().toLowerCase().replace(/\s+/g, ' ');
    function _msgMyId() {
        const identity = _syncviewStaffIdentityForHeaders();
        return String(identity && identity.member && identity.member.id || '');
    }
    // Yours when it carries your member id; the name match covers older staff
    // notes only. A client-written note is never yours, whatever its name.
    function _msgIsMine(m) {
        if (!m) return false;
        const id = String(m.author_member_id || '');
        if (id) return id === _msgMyId();
        if (String(m.role || '').toLowerCase() === 'client') return false;
        return _msgSameName(m.author, _msgMe());
    }
    function _msgLastAsNote(c) {
        return { author: c.last_author, role: c.last_role, author_member_id: c.last_author_member_id };
    }
    window.addEventListener('sv-staff-names', () => { try { _msgPaint(); } catch (e) {} });

    /* ── Short-lived list cache ──
       So the list can be on screen the moment the page opens, the last list is
       kept in this TAB's own storage (sessionStorage: gone when the tab closes,
       never shared with another tab or browser). It is only ever shown to the
       person who fetched it: it carries their member id, and it is thrown away
       when the sign-in changes or ends, when it is older than ten minutes, or
       when the id does not match the signed-in member. It holds the list lines
       only (no conversation text beyond the one preview line); the chat pane
       always comes from a fresh answer from the server, which is also what
       replaces the cached list a moment later. */
    const MSG_CACHE_KEY = 'sv_msg_inbox_v1';
    const MSG_CACHE_MS = 10 * 60 * 1000;
    function _msgCacheClear() { try { sessionStorage.removeItem(MSG_CACHE_KEY); } catch (e) {} }
    function _msgCacheWrite() {
        const me = _msgMyId();
        if (!me || !_msgCanUse() || !_msgState.loaded || _msgState.fromCache) return;
        try {
            sessionStorage.setItem(MSG_CACHE_KEY, JSON.stringify({
                v: 1, member: me, at: _msgState.lastAt, scope: _msgState.scope,
                conversations: _msgState.conversations.map(c => ({
                    post_id: c.post_id, client_slug: c.client_slug, client_name: c.client_name, title: c.title,
                    thumbnail_url: c.thumbnail_url, asset_url: c.asset_url, last_at: c.last_at,
                    last_author: c.last_author, last_author_member_id: c.last_author_member_id, last_role: c.last_role,
                    last_body: String(c.last_body || '').slice(0, 160), unread: Number(c.unread) || 0
                }))
            }));
        } catch (e) {}
    }
    /* Put the cached list on screen (once), if it is this person's and fresh. */
    function _msgCacheHydrate() {
        if (_msgState.loaded || !_msgCanUse()) return;
        let saved = null;
        try { saved = JSON.parse(sessionStorage.getItem(MSG_CACHE_KEY) || 'null'); } catch (e) { saved = null; }
        const me = _msgMyId();
        const ok = saved && saved.v === 1 && me && saved.member === me && Array.isArray(saved.conversations)
            && Date.now() - Number(saved.at) < MSG_CACHE_MS && Date.now() >= Number(saved.at);
        if (!ok) { if (saved) _msgCacheClear(); return; }
        _msgState.conversations = saved.conversations;
        _msgState.scope = String(saved.scope || '');
        _msgState.loaded = true;
        _msgState.fromCache = true;
        _msgState.lastAt = Number(saved.at);
        _msgPaintCounts();
    }
    /* Start the inbox call when the pointer or finger reaches the Messages
       button (a few hundred ms before the click), so the answer is on its way
       while the click lands. The first read after sign-in is _msgBootLoad's;
       neither runs on the Production tab, whose read-only gate allows no POST. */
    ['pointerover', 'pointerdown', 'focusin'].forEach(type => document.addEventListener(type, e => {
        const t = e.target && e.target.closest && e.target.closest('#navMessages, [onclick*="_msgOpenPage"]');
        // Not on the Production tab: its read-only gate allows no POST the page was not asked to make.
        if (t && _msgCanUse() && !_msgState.unavailable && currentNav !== 'production') _msgLoad(false);
    }, { capture: true, passive: true }));

    async function _msgCall(body) {
        const response = await fetch(MSG_URL, {
            method: 'POST', cache: 'no-store',
            headers: _syncviewEfHeaders({ 'Content-Type': 'application/json' }, MSG_URL),
            body: JSON.stringify(body)
        });
        let value = null;
        try { value = await response.json(); } catch (e) { value = null; }
        if (!response.ok || !value || value.ok !== true) throw new Error((value && value.error) || ('HTTP ' + response.status));
        return value;
    }

    /* Fetch the conversations, repaint whatever inbox is on screen, and the
       unread counts on the Kasper tab and the Messages button. */
    async function _msgLoad(force) {
        if (!_msgCanUse()) { _msgPaintCounts(); return; }
        if (_msgState.unavailable || _msgState.loading) return;
        if (!force && _msgState.loaded && !_msgState.fromCache && Date.now() - _msgState.lastAt < 15000) { _msgPaint(); return; }
        _msgState.loading = true;
        _msgPaint();
        // An answer belongs to the sign-in that asked for it: if the sign-in
        // changed or ended while it was on its way, it is dropped.
        const epoch = _msgState.epoch, asker = _msgMyId();
        const stale = () => epoch !== _msgState.epoch || asker !== _msgMyId();
        try {
            const value = await _msgCall({ action: 'inbox' });
            if (stale()) return;
            _msgState.conversations = Array.isArray(value.conversations) ? value.conversations : [];
            _msgState.scope = String(value.scope || '');
            _msgState.error = '';
            _msgState.loaded = true;
            _msgState.fromCache = false;
            _msgState.lastAt = Date.now();
            _msgStartLive();
            if (_msgState.openId && !_msgState.conversations.some(c => c.post_id === _msgState.openId)) _msgState.openId = '';
            _msgCacheWrite();
            // A conversation opened from the cached list is marked read only now,
            // after the person can actually see what is in it.
            if (_msgState.readWhenFresh) {
                const id = _msgState.readWhenFresh;
                _msgState.readWhenFresh = '';
                const c = _msgState.conversations.find(x => x.post_id === id);
                if (c && id === _msgState.openId && Number(c.unread) > 0) { c.unread = 0; _msgMark(id, 'read'); _msgCacheWrite(); }
            }
        } catch (e) {
            if (stale()) return;
            if (e && e.message === 'invalid_deliverable_id') { _msgState.loading = false; _msgCacheClear(); _msgFallBack(); return; }
            if (_msgState.fromCache) { _msgState.conversations = []; _msgState.loaded = false; _msgState.fromCache = false; _msgCacheClear(); }
            _msgState.error = 'Messages could not load. Try again in a moment.';
        } finally {
            if (!stale()) _msgState.loading = false;
        }
        _msgPaintCounts();
        _msgPaint();
    }
    function _msgUnreadConversations() {
        return _msgState.conversations.filter(c => Number(c.unread) > 0).length;
    }
    function _msgPaintCounts() {
        if (_msgState.unavailable) return;
        const n = _msgCanUse() ? _msgUnreadConversations() : 0;
        document.querySelectorAll('[data-kasper-count="replies"]').forEach(el => {
            el.textContent = String(n);
            el.classList.toggle('is-unread', n > 0);
        });
        document.querySelectorAll('[data-msg-count]').forEach(el => {
            el.textContent = String(n);
            el.hidden = n === 0;
        });
    }
    /* Called whenever the staff sign-in changes (100): forget the last
       person's list when the sign-in ends or changes. */
    function _msgOnIdentity() {
        const member=_msgMyId();
        if(_msgPhone.member!==member){
            _msgPhone.drafts.clear();_msgPhone.unread.clear();_msgPhone.query='';
            if(_msgPhone.member&&_msgIsPhone()){_msgState.draft='';_msgState.replyTo='';_msgState.openId='';}
            _msgPhone.member=member;
        }
        if (!_msgCanUse()) {
            if (_msgTimer) { clearInterval(_msgTimer); _msgTimer = null; }
            _msgReturn = null;
            _msgPhone.drafts.clear();_msgPhone.unread.clear();_msgPhone.query='';
            _msgState.conversations = []; _msgState.loaded = false; _msgState.fromCache = false; _msgState.openId = '';
            _msgState.readWhenFresh = '';
            _msgState.epoch++; _msgState.loading = false; _msgState.owner = '';
            _msgCacheClear();
            _msgPaintCounts(); _msgLeavePage();
            return;
        }
        // A different member signed in on this tab: nothing of the last one stays.
        if (_msgState.owner && _msgState.owner !== _msgMyId()) {
            _msgState.conversations = []; _msgState.loaded = false; _msgState.fromCache = false; _msgState.openId = '';
            _msgState.readWhenFresh = '';
            _msgState.epoch++; _msgState.loading = false;
            _msgCacheClear();
            _msgPaintCounts();
        }
        _msgState.owner = _msgMyId();
        // The Messages page was opened before the sign-in was known (a reload
        // on #messages): draw it now.
        // (The page can also have been put on screen before this file ran, an empty shell: fill it.)
        const shell = document.getElementById('msgPage');
        if (shell && !shell.querySelector('.msg-page-body')) _msgMountPage(shell);
        else if (shell) { _msgPaint(); _msgLoad(false); }
        else _msgBootLoad();
    }
    /* The Messages button's badge is live from page load (owner, 2026-10-23: it only appeared after a click).
       Once a sign-in that may use Messages is known, the inbox is read once, a moment after the page has
       settled; that first answer starts the live refresh (realtime, other tabs, the safety net). Never on the
       Production tab (its read-only gate allows no POST it did not ask for), on a client link, or in a hidden
       tab: then it waits, checking again every few seconds without asking the server anything. */
    const MSG_BOOT_WAIT_MS = 1500;
    let _msgBootTimer = null;
    function _msgBootLoad() {
        if (_msgBootTimer) return;
        _msgBootTimer = setTimeout(() => {
            _msgBootTimer = null;
            if (!_msgCanUse() || _msgState.unavailable || _isClientLink) return;
            if ((_msgState.loaded && !_msgState.fromCache) || _msgState.loading) return;
            if (document.hidden || currentNav === 'production') { _msgBootLoad(); return; }
            _msgLoad(false);
        }, MSG_BOOT_WAIT_MS);
    }

    /* ── Drawing ── */
    function _msgThumb(c) {
        const src = _calDeriveThumb({ thumbnail_url: c.thumbnail_url, asset_url: c.asset_url });
        return src
            ? `<img class="msg-thumb" alt="" src="${_calEscAttr(src)}" loading="lazy">`
            : '<span class="msg-thumb is-empty" aria-hidden="true">'+(_msgIsPhone()?_calEsc(_msgClientName(c).split(/\s+/).filter(Boolean).slice(0,2).map(n=>n[0]).join('').toUpperCase()):'')+'</span>';
    }
    function _msgClientName(c) {
        return String(c.client_name || c.client_slug || '');
    }
    function _msgToTag(m) {
        return m.audience === 'client'
            ? '<span class="cal-cm-to-tag is-client">To client</span>'
            : `<span class="cal-cm-to-tag is-team">${_CAL_LOCK_ICO}Team only</span>`;
    }
    function _msgPartTag(m) {
        const comp = String(m.component || 'video');
        return `<span class="cal-cm-comp-label cal-cm-comp-${_calEscAttr(comp)}">${_calEsc(COMP_LABELS[comp] || comp)}</span>`;
    }
    function _msgRoleLabel(m) {
        const role = String(m.role || '');
        return role === 'client' ? 'Client' : role === 'smm' ? 'SMM' : role === 'kasper' ? 'Reviewer' : '';
    }
    function _msgListHtml() {
        const query=_msgIsPhone()?_msgPhone.query.trim().toLowerCase():'';
        const list=_msgState.conversations.filter(c=>(_msgState.filter!=='new'||Number(c.unread)>0||c.post_id===_msgState.openId)&&(!query||[_msgClientName(c),c.title,c.last_body].join(' ').toLowerCase().includes(query)));
        if (!list.length) {
            if(query)return '<div class="msg-list-empty">No conversations match your search.</div>';
            return `<div class="msg-list-empty">${_msgState.filter === 'new' ? 'No new messages' : 'No conversations yet.'}</div>`;
        }
        return list.map(c => {
            const who = _msgIsMine(_msgLastAsNote(c)) ? 'You' : _calNoteAuthorName(_msgLastAsNote(c));
            const unread = Number(c.unread) || 0;
            return `<button type="button" class="msg-conv${c.post_id === _msgState.openId ? ' is-active' : ''}${unread ? ' is-unread' : ''}" data-msg-conv="${_calEscAttr(c.post_id)}" onclick="_msgOpen(${_jsAttrArg(c.post_id)})">
                ${_msgThumb(c)}
                <span class="msg-conv-main">
                    <span class="msg-conv-top"><span class="msg-conv-client">${_calEsc(_msgClientName(c))}</span><span class="msg-conv-time">${_calEsc(_calFmtCommentTime(c.last_at))}</span></span>
                    <span class="msg-conv-sub">${_calEsc(c.title || 'Untitled post')}</span>
                    <span class="msg-conv-last">${_calEsc(who ? who + ': ' : '')}${_calEsc(c.last_body || '')}</span>
                </span>
                ${unread ? `<span class="msg-unread" aria-label="${unread} unread">${unread}</span>` : ''}
            </button>`;
        }).join('');
    }
    function _msgReplyTarget(c) {
        if (!c) return null;
        const roots = c.messages.filter(m => !m.parent_id || m.root_id === m.id);
        const byId = new Map(roots.map(m => [m.id, m]));
        if (_msgState.replyTo && byId.has(_msgState.replyTo)) return byId.get(_msgState.replyTo);
        const last = c.messages[c.messages.length - 1];
        return last ? (byId.get(last.root_id) || roots[roots.length - 1] || null) : null;
    }
    /* Day dividers in a chat. A note belongs to the reader's own calendar day,
       not the UTC one: cutting the timestamp's first ten characters put the
       team's evening notes (after 6pm at UTC-6) under the next day. And the
       divider reads as a date on every screen, not "2026-10-17" on a desktop. */
    const _MSG_DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const _MSG_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    function _msgLocalDay(value) {
        const t = new Date(String(value || ''));
        if (!value || isNaN(t)) return '';
        return t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
    }
    function _msgDayLabel(ymd) {
        const d = new Date(ymd + 'T12:00:00');
        if (isNaN(d)) return ymd;
        return _MSG_DAYS[d.getDay()] + ', ' + d.getDate() + ' ' + _MSG_MONTHS[d.getMonth()] + ' ' + d.getFullYear();
    }
    function _msgChatHtml() {
        const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
        if (!c) {
            return `<div class="msg-chat-empty"><b>Pick a conversation</b><span>Notes on your posts show up here, newest first.</span></div>`;
        }
        if (!Array.isArray(c.messages)) return _msgChatSkeletonHtml(c);
        const target = _msgReplyTarget(c);
        let day = '';
        const phone=_msgIsPhone(),firstUnread=phone?_msgPhone.unread.get(c.post_id):'';
        const bubbles = c.messages.map(m => {
            const d = _msgLocalDay(m.created_at);
            const dayRow = d && d !== day ? `<div class="msg-day">${_calEsc(_msgDayLabel(d))}</div>` : '';
            day = d || day;
            const mine = _msgIsMine(m);
            const isRoot = m.root_id === m.id;
            const tweak = isRoot && m.is_tweak ? '<span class="cal-cm-type-tag is-tweak">Change request</span>' : '';
            const role = _msgRoleLabel(m);
            return `${dayRow}${m.id===firstUnread?'<div class="thumb-msg-new" role="separator">New messages</div>':''}<div class="msg-b${mine ? ' is-me' : ''}${isRoot ? '' : ' is-reply'}" data-msg-id="${_calEscAttr(m.id)}">
                <div class="msg-b-meta"><b>${_calEsc(mine ? 'You' : _calNoteAuthorName(m))}</b>${role && !mine && (!phone || role.toLowerCase()!==_calNoteAuthorName(m).toLowerCase()) ? `<span>${_calEsc(role)}</span>` : ''}${isRoot ? _msgPartTag(m) + tweak + _msgToTag(m) : ''}<span>${_calEsc(_calFmtCommentTime(m.created_at))}</span></div>
                <div class="msg-b-text">${_calEsc(m.body || '')}</div>
                <button type="button" class="msg-b-reply" onclick="_msgSetReplyTo(${_jsAttrArg(m.root_id)})">Reply</button>
            </div>`;
        }).join('') + _noteOutboxFor(c.post_id, e => {
            if (!c.messages.some(m => m.id === e.id)) return true;
            if (e.state === 'sent' || e.state === 'failed') _noteOutboxDrop(e.id);
            return false;
        }).map(e => {
            const m = _noteOutboxAsComment(e);
            return `<div class="msg-b is-me is-reply is-outbox is-outbox-${m._outbox}" data-msg-id="${_calEscAttr(m.id)}">
                <div class="msg-b-meta"><b>You</b><span>${_calEsc(_calFmtCommentTime(m.created_at))}</span></div>
                <div class="msg-b-text">${_calEsc(m.body || '')}</div>
                ${_noteOutboxStatusHtml(m)}
            </div>`;
        }).join('');
        const sendIco = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5L13.5 8L9 12.5"/></svg>';
        const replyCap = target
            ? `Replying to <b>${_calEsc(_msgIsMine(target) ? 'you' : _calNoteAuthorName(target))}</b> ${_msgPartTag(target)} ${_msgToTag(target)}`
            : '';
        const html = `<div class="msg-chat-head">
                <button type="button" class="msg-back" onclick="_msgBack()" aria-label="Back to conversations">‹</button>
                ${_msgThumb(c)}
                <div class="msg-chat-titles"><div class="msg-chat-title">${_calEsc(c.title || 'Untitled post')}</div><div class="msg-chat-sub">${_calEsc(_msgClientName(c))}</div></div>
                <div class="msg-chat-actions">
                    <button type="button" class="msg-act" onclick="_msgMarkUnread()" title="Mark as unread">Mark as unread</button>
                    <button type="button" class="msg-act" onclick="_msgOpenCard()" title="Open this card's Notes in the Calendar">Open card</button>
                </div>
            </div>
            <div class="msg-bubbles" id="msgBubbles">${bubbles}</div>
            <div class="msg-reply">
                <div class="msg-reply-cap">${replyCap}</div>
                <div class="cal-cm-composer">
                    <textarea id="msgReplyBox" rows="1" placeholder="Reply…" oninput="_msgOnDraft(this)" onkeydown="_msgOnKey(event)">${_calEsc(_msgState.draft)}</textarea>
                    <div class="cal-cm-composer-actions"><button class="cal-cm-send" type="button" onclick="_msgReply()" aria-label="Send reply" ${_msgState.draft.trim() && target ? '' : 'disabled'}>${sendIco}</button></div>
                </div>
            </div>`;
        return phone ? html.replace(/<div class="msg-chat-actions">[\s\S]*?<\/div>/, '<div class="msg-chat-actions"><button type="button" class="msg-act thumb-msg-options" onclick="_msgPhoneMore(this)" aria-label="More conversation actions">•••</button></div>') : html;
    }
    /* ── Loading placeholder ──
       The SAME markup and classes as the loaded page (list rows, filter pills,
       chat pane), with the words made see-through and a grey bar painted over
       each line, so every box lands exactly where the real one will. */
    const _MSG_SKEL_ROWS = [[58, 74, 82], [44, 62, 70], [66, 80, 56], [50, 68, 76], [60, 56, 84], [46, 72, 64]];
    function _msgSkelRowsHtml() {
        return Array.from({ length: 12 }, (_, i) => {
            const w = _MSG_SKEL_ROWS[i % _MSG_SKEL_ROWS.length];
            return `<button type="button" class="msg-conv is-skeleton" disabled tabindex="-1" aria-hidden="true">
                <span class="msg-thumb is-empty sv-skeleton"></span>
                <span class="msg-conv-main">
                    <span class="msg-conv-top"><span class="msg-conv-client msg-skel sv-skeleton" style="width:${w[0]}%">Client name</span><span class="msg-conv-time msg-skel sv-skeleton" style="width:34px">12:00</span></span>
                    <span class="msg-conv-sub msg-skel sv-skeleton" style="width:${w[1]}%">Post title</span>
                    <span class="msg-conv-last msg-skel sv-skeleton" style="width:${w[2]}%">Name: the last message</span>
                </span>
            </button>`;
        }).join('');
    }
    function _msgSkelFiltersHtml() {
        return `<div class="msg-filters" aria-hidden="true">
            <button type="button" class="is-active" disabled tabindex="-1">New</button>
            <button type="button" class="msg-skel sv-skeleton" disabled tabindex="-1">All</button>
        </div>`;
    }
    /* The phone list's search field. The loading placeholder carries a disabled
       copy so the filters and rows below it sit where the loaded page puts them. */
    function _msgPhoneSearchHtml(placeholder) {
        const input = placeholder
            ? '<input type="search" placeholder="Search conversations" aria-hidden="true" tabindex="-1" disabled>'
            : `<input type="search" placeholder="Search conversations" aria-label="Search conversations" value="${_calEscAttr(_msgPhone.query)}" oninput="_msgPhoneSearch(this.value)">`;
        return `<label class="thumb-msg-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg>${input}</label>`;
    }
    function _msgSkeletonHtml() {
        return `<div class="msg-inbox is-skeleton" role="status" aria-label="Loading messages">
            <div class="msg-list">
                ${_msgIsPhone() ? _msgPhoneSearchHtml(true) : ''}
                ${_msgSkelFiltersHtml()}
                <div class="msg-convs">${_msgSkelRowsHtml()}</div>
            </div>
            <div class="msg-chat">${_msgChatHtml()}</div>
        </div>`;
    }
    /* A conversation opened from the cached list: its head is known, its notes
       are still on the way. */
    function _msgChatSkeletonHtml(c) {
        const bar = (cls, w, text) => `<span class="${cls} msg-skel sv-skeleton" style="width:${w}">${text}</span>`;
        const bubble = (me, w) => `<div class="msg-b${me ? ' is-me' : ''}"><div class="msg-b-meta"><b>${bar('', '70px', 'Name')}</b></div><div class="msg-b-text msg-skel sv-skeleton" style="width:${w}">Message text goes here</div></div>`;
        return `<div class="msg-chat-head">
                <button type="button" class="msg-back" onclick="_msgBack()" aria-label="Back to conversations">‹</button>
                ${_msgThumb(c)}
                <div class="msg-chat-titles"><div class="msg-chat-title">${_calEsc(c.title || 'Untitled post')}</div><div class="msg-chat-sub">${_calEsc(_msgClientName(c))}</div></div>
            </div>
            <div class="msg-bubbles" role="status" aria-label="Loading the conversation">${bubble(false, '62%')}${bubble(true, '48%')}${bubble(false, '70%')}</div>
            <div class="msg-reply"><div class="msg-reply-cap"></div><div class="cal-cm-composer"><textarea rows="1" placeholder="Reply…" disabled></textarea></div></div>`;
    }
    function _msgInboxHtml() {
        if (!_msgCanUse()) return '<div class="msg-chat-empty"><b>Messages are for the team</b><span>Sign in as staff to see your conversations.</span></div>';
        if (!_msgState.loaded && !_msgState.error) return _msgSkeletonHtml();
        if (!_msgState.loaded && _msgState.error) {
            return `<div class="msg-chat-empty"><b>${_calEsc(_msgState.error)}</b><button type="button" class="msg-act" onclick="_msgLoad(true)">Try again</button></div>`;
        }
        if (!_msgState.conversations.length) {
            return `<div class="kasper-empty"><div class="kasper-empty-icon"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h11a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H7l-3 2.5V12H2.5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z"/></svg></div><div class="kasper-empty-title">You're all caught up</div><div class="kasper-empty-sub">Notes on your clients' posts show up here. A conversation leaves this list once its post is posted.</div></div>`;
        }
        const unread = _msgUnreadConversations();
        const html = `<div class="msg-inbox${_msgState.openId ? ' is-chat-open' : ''}">
            <div class="msg-list">
                <div class="msg-filters" role="group" aria-label="Show">
                    <button type="button" class="${_msgState.filter === 'new' ? 'is-active' : ''}" aria-pressed="${_msgState.filter === 'new'}" onclick="_msgSetFilter('new')">New${unread ? ' · ' + unread : ''}</button>
                    <button type="button" class="${_msgState.filter === 'all' ? 'is-active' : ''}" aria-pressed="${_msgState.filter === 'all'}" onclick="_msgSetFilter('all')">All</button>
                </div>
                <div class="msg-convs">${_msgListHtml()}</div>
            </div>
            <div class="msg-chat">${_msgChatHtml()}</div>
        </div>`;
        return _msgIsPhone() ? html.replace('<div class="msg-list">','<div class="msg-list">'+_msgPhoneSearchHtml(false)) : html;
    }
    /* Repaint every mounted inbox (Kasper tab and/or the staff panel),
       keeping a reply being typed: never rebuild under the caret. */
    function _msgPaint() {
        const roots = document.querySelectorAll('[data-msg-root]');
        if (!roots.length) return;
        const box = document.getElementById('msgReplyBox');
        const typing = box && document.activeElement === box;
        const previous=document.getElementById('msgBubbles');
        const scroll=previous?{top:previous.scrollTop,pinned:previous.scrollHeight-previous.clientHeight-previous.scrollTop<40}:null;
        roots.forEach(root => {
            if (typing && root.contains(box)) {
                const list = root.querySelector('.msg-convs');
                if (list) list.innerHTML = _msgListHtml();
                // The chat's bubbles still follow (a reply sent a moment ago,
                // its "Sending…" mark), without touching the box being typed in.
                const live = root.querySelector('#msgBubbles');
                if (live) {
                    const fresh = document.createElement('div');
                    fresh.innerHTML = _msgInboxHtml();
                    const next = fresh.querySelector('#msgBubbles');
                    if (next && next.innerHTML !== live.innerHTML) {
                        const pinned = live.scrollHeight - live.clientHeight - live.scrollTop < 40;
                        live.innerHTML = next.innerHTML;
                        if (pinned) live.scrollTop = live.scrollHeight;
                    }
                }
                return;
            }
            const restore = svFocusKeep(root);
            root.innerHTML = _msgInboxHtml();
            restore();
        });
        const bubbles = document.getElementById('msgBubbles');
        if(bubbles&&!typing){
            const divider=bubbles.querySelector('.thumb-msg-new');
            if(_msgIsPhone()&&_msgPhone.firstOpen&&divider)bubbles.scrollTop=divider.getBoundingClientRect().top-bubbles.getBoundingClientRect().top+bubbles.scrollTop;
            else if(_msgIsPhone()&&scroll&&!scroll.pinned&&!_msgPhone.firstOpen)bubbles.scrollTop=scroll.top;
            else bubbles.scrollTop=bubbles.scrollHeight;
        }
        _msgPhone.firstOpen=false;_msgPhoneLayout();
    }
    function _msgRenderInto(root) {
        if (!root) return;
        root.setAttribute('data-msg-root', '1');
        _msgCacheHydrate();
        root.innerHTML = _msgInboxHtml();
        _msgLoad(false);
    }

    /* ── Actions ── */
    function _msgSetFilter(f) { _msgState.filter = f === 'all' ? 'all' : 'new'; _msgPaint(); }
    function _msgSetReplyTo(rootId) {
        _msgState.replyTo = String(rootId || '');
        _msgPhoneKeepDraft();
        _msgPaint();
        const box = document.getElementById('msgReplyBox');
        if (box) box.focus();
    }
    function _msgOnDraft(ta) {
        _msgState.draft = ta.value;
        _msgPhoneKeepDraft();
        if(_msgIsPhone()){ta.style.height='auto';ta.style.height=Math.min(120,Math.max(44,ta.scrollHeight))+'px';}
        const send = ta.closest('.cal-cm-composer') && ta.closest('.cal-cm-composer').querySelector('.cal-cm-send');
        if (send) send.disabled = !ta.value.trim() || _msgState.sending;
    }
    function _msgOnKey(e) {
        if(_msgIsPhone())return;
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); _msgReply(); }
    }
    async function _msgMark(postId, state) {
        try {
            const value = await _msgCall({ action: 'inbox_mark', post_id: postId, state });
            try { if (_msgBus) _msgBus.postMessage('marked'); } catch (e) {}
            return value;
        } catch (e) { return null; }
    }
    async function _msgOpen(postId,navigate=true) {
        const phone=_msgIsPhone(),fromList=!_msgState.openId;
        if(phone){
            _msgPhoneKeepDraft();
            if(fromList)_msgPhone.listScroll=document.querySelector('#msgPage .msg-convs')?.scrollTop||0;
            _msgPhone.focusId=String(postId||'');_msgPhone.firstOpen=true;
            if(navigate&&fromList&&document.getElementById('msgPage')){
                history.replaceState({...history.state,thumbMessagesParent:true},'');
                history.pushState({...history.state,thumbMessagesParent:false,thumbMessagesThread:String(postId)},'');
            }
        }
        _msgState.openId = String(postId || '');
        _msgState.replyTo = '';
        _msgState.draft = '';
        const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
        if(phone){
            const draft=_msgPhone.drafts.get(_msgState.openId);
            if(draft){_msgState.draft=draft.draft;_msgState.replyTo=draft.replyTo;}
            const incoming=(c?.messages||[]).filter(m=>!_msgIsMine(m));
            const unread=Math.min(incoming.length,Math.max(0,Math.floor(Number(c?.unread)||0)));
            // The server names the first message that counts as new; automatic records and (for the
            // reviewer) client notes sit among the incoming ones and never count, so the last-N guess
            // is only the fallback for an answer that carries no id.
            const named=c&&c.first_unread_id&&incoming.some(m=>m.id===c.first_unread_id)?c.first_unread_id:'';
            if(unread)_msgPhone.unread.set(c.post_id,named||incoming[incoming.length-unread].id);
            else _msgPhone.unread.delete(c?.post_id);
        }
        if (c && Number(c.unread) > 0) {
            c.unread = 0;          // opening = read; the server stamps it below
            _msgPaintCounts();
            // From the cached list the notes are not here yet: mark it read once they are.
            if (Array.isArray(c.messages)) { _msgMark(c.post_id, 'read'); _msgCacheWrite(); }
            else _msgState.readWhenFresh = c.post_id;
        }
        _msgPaint();
        if(phone)document.querySelector('#msgPage .msg-back')?.focus({preventScroll:true});
    }
    function _msgBack(navigate=true) {
        const phone=_msgIsPhone();if(phone){_msgPhoneKeepDraft();document.getElementById('msgReplyBox')?.blur();}
        _msgState.openId='';_msgPaint();
        if(phone){
            const list=document.querySelector('#msgPage .msg-convs');
            if(list){list.scrollTop=_msgPhone.listScroll;[...list.querySelectorAll('[data-msg-conv]')].find(n=>n.dataset.msgConv===_msgPhone.focusId)?.focus({preventScroll:true});}
            if(navigate&&history.state?.thumbMessagesThread){_msgPhone.returning=true;history.back();}
        }
    }
    window.svThumbMessagesConsumeHistory=e=>{
        if(!_msgIsPhone()||!_msgCanUse()||(!e.state?.thumbMessagesParent&&!e.state?.thumbMessagesThread))return false;
        if(!document.getElementById('msgPage')){
            navTo('messages',false);
            if(!document.getElementById('msgPage'))return false;
            // navTo restores the page's normal route; keep this owned history
            // entry so Back/Forward can still restore its list or thread.
            history.replaceState(e.state,'',location.href);
        }
        if(e.state?.thumbMessagesParent){
            if(!_msgPhone.returning)_msgBack(false);_msgPhone.returning=false;return true;
        }
        if(e.state?.thumbMessagesThread){_msgOpen(e.state.thumbMessagesThread,false);return true;}
        return false;
    };

    async function _msgMarkUnread() {
        const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
        if (!c) return;
        const answer = await _msgMark(c.post_id, 'unread');
        if (!answer) { showToast('Could not mark it unread. Try again.'); return; }
        if(_msgIsPhone())_msgBack();
        _msgState.openId = '';
        await _msgLoad(true);
    }
    /* Load the conversation's client into the Calendar, as opening the card
       would, and wait for its cards. Needed by both Reply (the Notes save path
       works on the Calendar's cards) and Open card. */
    async function _msgEnsureCard(c) {
        const name = _msgClientName(c);
        if (!name) return null;
        if (calState.client !== name || !calState.posts.some(p => p.id === c.post_id)) {
            if (calState.client !== name) onCalClientChange(name);
            // The Calendar screen's own load only lands while that screen is
            // on the page; from a cold start on another tab, read the cards
            // directly instead of waiting for a load that never fills them.
            const view = document.getElementById('calView');
            if (!(view && view.isConnected)) {
                try { await _calLoadPostsWithoutScreen(name); } catch (e) {}
            }
            const started = Date.now();
            while (Date.now() - started < 20000 && calState.client === name && !calState.posts.some(p => p.id === c.post_id)) {
                await new Promise(resolve => setTimeout(resolve, 150));
            }
        }
        const post = calState.posts.find(p => p.id === c.post_id);
        if (!post) return null;
        // The same canonical-thread load the Notes dialog starts on open.
        _prodProjectCanonicalCardComments('calendar', c.post_id);
        return post;
    }
    /* The one video-and-notes view, from any door (187's play icon, Review tile and Kasper's "Watch here"): the
       card's Notes dialog, with the player when its video can be watched here. A card the Calendar has not loaded
       (Kasper's board is cross-client) is loaded first, the way a Messages conversation is. True when it opened. */
    async function svOpenCardNotes(client, pid) {
        if (!pid) return false;
        if (!calState.posts.some(p => p.id === pid)) {
            if (_isClientLink) return false;
            const name = String(wlCanonicalClient(client) || client || '');
            const post = await _msgEnsureCard({ client_name: name, post_id: pid });
            if (!post) { showToast('That card could not be loaded. Try again.'); return false; }
        }
        openCalComments(pid);
        return true;
    }
    window.svOpenCardNotes = svOpenCardNotes;
    /* A reply shows in the chat the moment it is sent (the note outbox in 190
       keeps it, with its words, until the server confirms it; a failed one
       stays as "Not sent" with Retry, also after a refresh). The box is free
       at once; loading the card, the save, the read mark and the inbox
       refresh all run behind it. */
    function _msgReply() {
        const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
        const target = _msgReplyTarget(c);
        const body = String(_msgState.draft || '').trim();
        if (!c || !target || !body) return;
        const entry = _noteOutboxPut({
            id: _calMintCommentId(), surface: 'msg', kind: 'reply', pid: c.post_id, comp: '',
            parent_id: target.id, body, author: _calCurrentAuthor(),
            author_member_id: _calCurrentAuthorId() || undefined, role: _calCommentRole(),
            created_at: new Date().toISOString(), at: Date.now(), state: 'sending'
        });
        _msgState.draft = '';
        _msgPhone.drafts.delete(c.post_id);
        const box = document.getElementById('msgReplyBox');
        if (box) box.value = '';
        _msgSendQueued(entry.id);
        _msgPaint();
        const bubbles = document.getElementById('msgBubbles');
        if (bubbles) bubbles.scrollTop = bubbles.scrollHeight;
    }
    function _msgSendQueued(id) {
        const postId = (_noteOutboxGet(id) || {}).pid;
        return _noteOutboxSend(id).then(ok => {
            if (!ok) return;
            // Confirmed. The read mark and the inbox refresh follow; the reply
            // stays drawn from the outbox until the refreshed inbox has it.
            return _msgMark(postId, 'read').then(async () => {
                // A load already running started before this reply was saved.
                for (let i = 0; i < 100 && _msgState.loading; i++) await new Promise(r => setTimeout(r, 100));
                await _msgLoad(true);
            }).catch(() => {}).finally(() => {
                const c = _msgState.conversations.find(x => x.post_id === postId);
                // Drawn from the inbox now; until then it stays drawn from the
                // outbox as sent (an entry that is never listed lapses in a minute).
                if (c && c.messages.some(m => m.id === id)) _noteOutboxDrop(id);
                _msgPaint();
            });
        });
    }
    /* Run by the outbox before a Messages reply is saved: the Notes save path
       works on the Calendar's cards, so the conversation's client is loaded
       first and its thread allowed to finish loading. */
    window._msgSendQueued = _msgSendQueued;
    window._msgBeforeNoteSend = _msgBeforeNoteSend;
    async function _msgBeforeNoteSend(entry) {
        const c = _msgState.conversations.find(x => x.post_id === entry.pid);
        if (!c) throw new Error('This conversation is no longer in your inbox.');
        const post = await _msgEnsureCard(c);
        if (!post) throw new Error('card not found');
        const comp = _calFindCompForCommentId(post, entry.parent_id) || 'video';
        const started = Date.now();
        while (Date.now() - started < 15000) {
            const gate = _prodCanonicalCommentGate(post, comp);
            if (!(gate.linked && !gate.ready) && !_calCommentSendPending(post, gate)) break;
            await new Promise(resolve => setTimeout(resolve, 150));
        }
    }
    window.addEventListener('sv-note-outbox', e => {
        if (e && e.detail && e.detail.pid === _msgState.openId && document.getElementById('msgPage')) _msgPaint();
    });
    async function _msgOpenCard() {
        const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
        if (!c) return;
        navTo('calendar');
        const post = await _msgEnsureCard(c);
        if (post) openCalComments(c.post_id);
        else showToast('That card could not be found in the Calendar.');
    }

    /* ── The Messages page ──
       A normal page under the header, like Calendar or Samples (route
       "messages" in navTo). The header Messages button, its copy in the phone
       Tabs menu, and the Kasper Messages tab all open it.

       Getting out (owner, 2026-10-15): the Messages button is a toggle, there
       is a Close button (top right; on a phone in the phone title bar), Escape
       closes it on a desktop (never while a typed reply has the caret), and the
       browser Back button leaves it too. All of them put the person back where
       they were when they opened it: the same tab and client, the card that was
       open, and every scroll position. Opened straight from a link (nothing
       to go back to), they land on the Calendar. Nothing typed is thrown away. */
    let _msgReturn = null;           // where the person was when Messages opened
    let _msgLeftBoot = false;        // the page was first loaded on Messages itself
    const _msgBootOnMessages = /^\/messages\/?$/.test(location.pathname) || /^#\/?messages/.test(location.hash);
    const _msgSig = el => el.id ? '#' + el.id : el.tagName.toLowerCase() + '.' + [...el.classList].slice(0, 2).join('.');
    // Pressing the Messages button (or Tabs, on a phone) counts as "clicking away" for the Calendar's open-card
    // outline, which drops it before the page changes. Note the card on the way down, in the capture phase, ahead of it.
    let _msgPeek = null;
    document.addEventListener('mousedown', e => {
        if (!e.target || !e.target.closest || !e.target.closest('#navMessages, [onclick*="_msgOpenPage"], .pocket-staff-tabs-btn, #pocketStaffTabs')) return;
        const open = document.querySelector('.cal-card-focused');
        if (open) _msgPeek = { cardId: String(open.dataset.pid || ''), at: Date.now() };
    }, { capture: true, passive: true });
    function _msgCapture() {
        if (_msgBootOnMessages && !_msgLeftBoot) { _msgReturn = null; return; }
        const scrollers = [];
        const content = document.getElementById('content');
        if (content) {
            const seen = new Map();
            content.querySelectorAll('*').forEach(el => {
                const key = _msgSig(el), n = seen.get(key) || 0;
                seen.set(key, n + 1);
                if (el.scrollHeight > el.clientHeight + 1 || el.scrollWidth > el.clientWidth + 1) {
                    if (el.scrollTop > 0 || el.scrollLeft > 0) scrollers.push({ key, n, top: el.scrollTop, left: el.scrollLeft });
                }
            });
        }
        // The card that is open on the Calendar (outlined, and named in the address).
        const open = document.querySelector('.cal-card-focused');
        const cardId = open ? String(open.dataset.pid || '') : (_msgPeek && Date.now() - _msgPeek.at < 20000 ? _msgPeek.cardId : '');
        _msgPeek = null;
        _msgReturn = {
            nav: currentNav, client: String(calState.client || ''), cardId,
            scrollY: window.scrollY || 0, scrollers
        };
    }
    // navTo tells this before it changes anything, so the page being left is still whole.
    window.svMessagesNavHook = function (page) {
        if (page === 'messages') { if (currentNav !== 'messages') _msgCapture(); }
        else if (currentNav === 'messages') _msgLeftBoot = true;
    };
    // Put the places back, and keep doing it for a few seconds: the Calendar paints in stages (cards arrive, its own
    // scroll-into-view runs, a refresh re-draws the strip) and any of them can move a place the person just got back.
    // The first thing the person does themselves (wheel, touch, key, press) ends it.
    function _msgApplyScroll(r, tries) {
