import { showToast, svSpinHtml } from './040-shared-briefs.js';
import { _calCommentsForView, calState } from './130-calendar-model-cache.js';
import { _calEsc, _calEscAttr, _jsAttrArg } from './131-core-html.js';
import { COMP_LABELS, _notesGetSeen } from './180-calendar-native-post-media.js';
import { svUnreadBadgesOn } from './188-review-stage-switch.js';
import { _calNoteAuthorName, _calRefreshCommentsBtn } from './190-calendar-approval-comments.js';
import { _msgBootPageOk, _msgClientName, _msgIsPhone, _msgLoad, _msgMe, _msgMyId, _msgPaint, _msgState } from './326-core-messages-inbox.js';
    /* UNREAD BADGES, ROUND 5 (session Beacon, 2026-10-24; docs/audits/2026-10-23-unread-badges.md). On only for the
       staff members the runtime switch unread_badges_v2 names (188), on a desktop page; for everyone else nothing here
       runs and every page is exactly as it was. The owner tries it first and tweaks it.

       What it changes is how unread notes are shown, never what anything writes:
         - a card's Notes button: one round picture per person with something for you, with a number coloured by kind
           (orange change request, blue client comment, grey team, violet Kasper); filled = new, a coloured number with no
           fill (round 7) = read but still needs you (a change not done, a client comment waiting for your answer); at most three, then "+N";
           an instant hover lists who and what;
         - Notes on a card: the notes laid out like Slack (picture, name, time), the tags New / Waiting for your
           answer, and on hover at the note's bottom right Reply (comments only), No reply needed, Mark done, Delete;
         - Messages: New, To answer and All; rows with the client's picture and the same people bubbles; the chat laid
           out like Slack; a client's change request is one line pointing to the card (change requests live there).
       Pictures are Slack profile photos the inbox answer carries (production-comments/pictures.mjs); without one, the
       person's initials. "No reply needed" and the card's "Mark unread" are kept in this browser for now (the server
       side of both is build step 2 in the audit). The styles are in 020 under html.sv-unread2. */

    const SVU_LOCAL_KEY = 'sv-unread-v2-local';
    const SVU_PICS_KEY = 'sv-unread-v2-pictures';
    const SVU_AUTO_ROLES = new Set(['system', 'automatic', 'auto', 'bot']);
    const SVU_CAPTION_RECORD = /^Changed the caption to:\r?\n\r?\n[\s\S]*\r?\n\r?\nIt was(?: empty\.|:\r?\n\r?\n)/;
    const SVU_COMPS = ['video', 'graphic', 'caption', 'title'];
    const SVU_RANK = { change: 4, comment: 3, kasper: 2, staff: 1 };
    // var, not let: 326 can call into this file (svuAfterMsgPaint) before this line has run on a slow load, and a var
    // reads as undefined (off) there instead of throwing.
    var _svuOn = false;
    let _svuLocal = null;

    // Asked on every draw by 190 and 326. A changed answer (the switch read, the sign-in, phone or desktop) also
    // switches the page's look and listeners, once, right after this draw.
    var _svuSyncQueued = false;
    // A draw made while this file is still loading (326 can draw Messages first on a slow device) answers no: this
    // file's own state does not exist yet; its first sync, below, redraws.
    function svuActive() {
        try {
            const want = !_msgIsPhone() && svUnreadBadgesOn();
            if (want !== _svuOn && !_svuSyncQueued) {
                _svuSyncQueued = true;
                setTimeout(() => { _svuSyncQueued = false; try { _svuSync(); } catch (e) {} }, 0);
            }
            return want;
        } catch (e) {
            return false;
        }
    }

    // Round 7 (owner, 2026-10-24): a send never shows the words "Sending…" or "Saving…". With the switch on, the shared
    // spinner (040 svSpinHtml) stands in their place; otherwise the words, escaped, as before.
    function svuSpinOr(words, label) {
        try { if (svuActive()) return svSpinHtml(label || 'Sending'); } catch (e) {}
        return _calEsc(words);
    }

    /* ---------- this browser's "No reply needed" and "Mark unread" ---------- */
    function _svuLocalGet() {
        if (_svuLocal) return _svuLocal;
        let v = null;
        try { v = JSON.parse(localStorage.getItem(SVU_LOCAL_KEY) || 'null'); } catch (e) { v = null; }
        _svuLocal = {
            noReply: new Set(v && Array.isArray(v.noReply) ? v.noReply.filter(x => typeof x === 'string') : []),
            unread: new Set(v && Array.isArray(v.unread) ? v.unread.filter(x => typeof x === 'string') : []),
        };
        return _svuLocal;
    }
    function _svuLocalSave() {
        const l = _svuLocalGet();
        try { localStorage.setItem(SVU_LOCAL_KEY, JSON.stringify({ noReply: Array.from(l.noReply).slice(-500), unread: Array.from(l.unread).slice(-200) })); } catch (e) {}
    }

    /* ---------- the rules ---------- */
    const _svuRole = m => String(m && m.role || '').toLowerCase();
    const _svuIsClient = m => _svuRole(m) === 'client';
    const _svuIsAuto = m => SVU_AUTO_ROLES.has(_svuRole(m)) || (_svuIsClient(m) && SVU_CAPTION_RECORD.test(String(m && m.body || '')));
    function _svuIsMine(m) {
        try {
            const id = String(m && m.author_member_id || '');
            if (id) return id === _msgMyId();
            if (_svuIsClient(m)) return false;
            return String(m && m.author || '').trim().toLowerCase() === String(_msgMe() || '').trim().toLowerCase();
        } catch (e) { return false; }
    }
    const _svuIsTweak = m => !!m && m.is_tweak !== false;
    const _svuLabel = c => (COMP_LABELS && COMP_LABELS[c]) || c;

    // Every note on a card, with its thread root and part, oldest first.
    function _svuNotesOf(post) {
        const out = [];
        for (const comp of SVU_COMPS) {
            let list = [];
            try { list = _calCommentsForView(post, comp) || []; } catch (e) { list = []; }
            const byId = new Map(list.map(m => [m && m.id, m]));
            for (const m of list) {
                if (!m || m.deleted || m.hidden) continue;
                const root = m.parent_id ? (byId.get(m.root_id || m.parent_id) || byId.get(m.parent_id) || m) : m;
                out.push({ m, root, comp });
            }
        }
        return out.sort((a, b) => String(a.m.created_at).localeCompare(String(b.m.created_at)));
    }
    function _svuKindOf(n) {
        if (_svuIsClient(n.m)) return _svuIsTweak(n.root) && !n.root.parent_id && _svuIsClient(n.root) ? 'change' : 'comment';
        return _svuRole(n.m) === 'kasper' ? 'kasper' : 'staff';
    }
    // One card for the signed-in person. `seen` is when they last opened its Notes in this browser.
    function _svuStateOf(post, seenOverride) {
        const l = _svuLocalGet();
        const seen = seenOverride != null ? seenOverride : (l.unread.has(post.id) ? '' : (_notesGetSeen(post.id) || ''));
        const notes = _svuNotesOf(post);
        const s = { change: 0, comment: 0, staff: 0, kasper: 0, open: 0, waiting: 0, items: [], newIds: new Set(), waitingIds: new Set(), openIds: new Set(), notes };
        for (const n of notes) {
            if (_svuIsMine(n.m) || _svuIsAuto(n.m)) continue;
            if (String(n.m.created_at) > seen) { const k = _svuKindOf(n); s[k]++; s.newIds.add(n.m.id); s.items.push({ kind: k, n }); }
        }
        for (const r of notes.filter(n => n.m === n.root)) {
            if (_svuIsAuto(r.m)) continue;
            if (_svuIsTweak(r.m) && !r.m.done) { s.openIds.add(r.m.id); if (!s.newIds.has(r.m.id)) s.open++; }
            if (_svuIsClient(r.m) && !_svuIsTweak(r.m) && !r.m.done && !l.noReply.has(r.m.id)) {
                const answered = notes.some(n => n.root === r.m && n.m !== r.m && !_svuIsClient(n.m) && !_svuIsAuto(n.m));
                if (!answered) { s.waitingIds.add(r.m.id); if (!s.newIds.has(r.m.id)) { s.waiting++; s.items.push({ kind: 'waiting', n: r }); } }
            }
        }
        s.items.sort((a, b) => String(b.n.m.created_at).localeCompare(String(a.n.m.created_at)));
        return s;
    }

    /* ---------- pictures ---------- */
    function _svuPictures() {
        const live = _msgState.pictures;
        if (live && typeof live === 'object') return live;
        try {
            const saved = JSON.parse(sessionStorage.getItem(SVU_PICS_KEY) || 'null');
            if (saved && saved.member === _msgMyId() && saved.pictures && typeof saved.pictures === 'object') return saved.pictures;
        } catch (e) {}
        return {};
    }
    // The inbox answer brought pictures (326): keep them for this tab and redraw.
    function svuPicturesArrived(pictures) {
        if (!pictures || typeof pictures !== 'object') return;
        try { sessionStorage.setItem(SVU_PICS_KEY, JSON.stringify({ member: _msgMyId(), pictures })); } catch (e) {}
        if (_svuOn) svuRefresh();
    }
    const _svuSafeUrl = u => typeof u === 'string' && /^https:\/\/[^\s"'<>]{1,580}$/.test(u) ? u : '';
    function _svuPictureOf(m, slug) {
        const p = _svuPictures();
        if (_svuIsClient(m)) return _svuSafeUrl(p.clients && p.clients[slug]);
        const id = String(m && m.author_member_id || '');
        if (id && p.members && p.members[id]) return _svuSafeUrl(p.members[id]);
        const name = String(m && m.author || '').trim().toLowerCase();
        const names = p.names || {};
        return _svuSafeUrl(names[name] || names[name.split(/\s+/)[0]] || (_svuRole(m) === 'kasper' ? names.kasper : ''));
    }
    const _svuHue = name => { let h = 0; for (const ch of String(name)) h = (h * 31 + ch.charCodeAt(0)) % 360; return h; };
    function _svuAvatar(m, cls, slug) {
        const url = _svuPictureOf(m, slug);
        if (url) return `<img class="${cls}" src="${_calEscAttr(url)}" alt="" loading="lazy" referrerpolicy="no-referrer">`;
        const name = _svuIsClient(m) ? (_svuClientName(slug) || 'Client') : String(m && m.author || 'Team');
        const letters = name.trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0).toUpperCase()).join('') || '?';
        const h = _svuIsClient(m) ? 172 : (_svuRole(m) === 'kasper' ? 262 : _svuHue(name));
        return `<span class="${cls} svu-initial" style="background:hsl(${h},52%,46%)" aria-hidden="true">${_calEsc(letters)}</span>`;
    }
    function _svuClientName(slug) {
        try { const c = _msgState.conversations.find(x => x.client_slug === slug); if (c) return _msgClientName(c); } catch (e) {}
        return '';
    }
    const _svuPostSlug = post => String(post && post.client || calState.client || '');

    /* ---------- words ---------- */
    const _svuPlural = (n, one, many) => n + ' ' + (n === 1 ? one : many);
    const SVU_SAY = {
        open: n => _svuPlural(n, 'change request not done yet', 'change requests not done yet'),
        comment: n => _svuPlural(n, 'new comment from a client', 'new comments from clients'),
        staff: n => _svuPlural(n, 'new message from the team', 'new messages from the team'),
        kasper: n => _svuPlural(n, 'new message from Kasper', 'new messages from Kasper'),
    };
    const SVU_ICO = {
        change: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 2.5l3 3L6 13H3v-3z"/></svg>',
        comment: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M2.5 3.5h11v8H7l-3 2.5V11.5H2.5z"/></svg>',
        waiting: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4L2.5 7.5 6 11 M2.5 7.5H10a3.5 3.5 0 0 1 3.5 3.5v1"/></svg>',
        staff: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="5.3" r="2.5"/><path stroke-linecap="round" d="M3.2 13.2c.35-2.35 2.1-3.7 4.8-3.7s4.45 1.35 4.8 3.7"/></svg>',
        kasper: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M1 8s2.5-4.5 7-4.5S15 8 15 8s-2.5 4.5-7 4.5S1 8 1 8z"/><circle cx="8" cy="8" r="2.2"/></svg>',
    };
    SVU_ICO.open = SVU_ICO.change;
    /* Round 6 (owner, 2026-10-24): as little visual noise as possible. People are shown by first name, times are
       always relative (the day line or a hover carries the date), and every coloured number says in a hover what
       it counts. */
    function _svuFirst(m) {
        if (_svuRole(m) === 'kasper') return 'Kasper';
        let name = '';
        try { name = _svuIsClient(m) ? String(m && m.author || '') : String(_calNoteAuthorName(m) || ''); } catch (e) { name = String(m && m.author || ''); }
        name = name.trim();
        return name ? name.split(/\s+/)[0] : (_svuIsClient(m) ? 'Client' : 'Team');
    }
    function _svuAgo(iso) {
        const t = Date.parse(iso || '');
        if (!isFinite(t)) return '';
        const mins = Math.round((Date.now() - t) / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        const hrs = Math.round(mins / 60);
        if (hrs < 24) return hrs + 'h ago';
        const days = Math.round(hrs / 24);
        if (days < 14) return days + 'd ago';
        if (days < 60) return Math.round(days / 7) + 'w ago';
        if (days < 365) return Math.round(days / 30) + 'mo ago';
        return Math.round(days / 365) + 'y ago';
    }
    // Day lines (round 6 E, as Slack): Today, Yesterday, the weekday within a week, then "Thu 22 Oct" (the year only
    // when it is not this year).
    function _svuDayLabel(iso) {
        const t = new Date(String(iso || ''));
        if (isNaN(t)) return '';
        const day = d => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
        const diff = Math.round((day(new Date()) - day(t)) / 86400000);
        if (diff === 0) return 'Today';
        if (diff === 1) return 'Yesterday';
        if (diff > 1 && diff < 7) return t.toLocaleDateString('en-GB', { weekday: 'long' });
        return t.toLocaleDateString('en-GB', Object.assign({ weekday: 'short', day: 'numeric', month: 'short' }, t.getFullYear() === new Date().getFullYear() ? {} : { year: 'numeric' }));
    }
    const _svuFullDate = iso => { const t = Date.parse(iso || ''); return isFinite(t) ? new Date(t).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''; };
    const SVU_NUM_SAY = {
        change: n => _svuPlural(n, 'new change request', 'new change requests'),
        comment: n => _svuPlural(n, 'new comment', 'new comments'),
        staff: n => _svuPlural(n, 'new message from the team', 'new messages from the team'),
        kasper: n => _svuPlural(n, 'new message from Kasper', 'new messages from Kasper'),
        waiting: n => _svuPlural(n, 'comment waiting for your answer', 'comments waiting for your answer'),
        open: n => _svuPlural(n, 'change request not done yet', 'change requests not done yet'),
    };
    const SVU_LOCK_ICO = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>';

    /* ---------- the badge: one bubble per person ---------- */
    function _svuPeopleOf(post, s) {
        const by = new Map();
        const get = m => { const k = _svuIsClient(m) ? 'client' : String(m.author_member_id || m.author || 'Team'); if (!by.has(k)) by.set(k, { m, nNew: 0, kind: '', nOut: 0, outKind: '', last: '' }); return by.get(k); };
        for (const it of s.items) {
            if (it.kind === 'waiting') continue;
            const g = get(it.n.m); g.nNew++; if (!g.kind || SVU_RANK[it.kind] > SVU_RANK[g.kind]) g.kind = it.kind;
            if (String(it.n.m.created_at) > g.last) g.last = String(it.n.m.created_at);
        }
        for (const n of s.notes) {
            if (n.m !== n.root || s.newIds.has(n.m.id)) continue;
            const out = s.waitingIds.has(n.m.id) ? 'waiting' : (s.openIds.has(n.m.id) ? 'open' : '');
            if (!out) continue;
            const g = get(n.m); g.nOut++; if (!g.outKind || out === 'open') g.outKind = out;
            if (String(n.m.created_at) > g.last) g.last = String(n.m.created_at);
        }
        const rank = g => Math.max(SVU_RANK[g.kind] || 0, g.outKind === 'open' ? 4 : g.outKind === 'waiting' ? 3 : 0);
        return [...by.values()].sort((x, y) => (y.nNew > 0) - (x.nNew > 0) || rank(y) - rank(x) || y.last.localeCompare(x.last));
    }
    // `titled`: each bubble says in a hover what it counts (the Messages list; a card has its own hover box).
    function _svuBubblesHtml(people, max, slug, titled) {
        const shown = people.slice(0, max), rest = people.length - shown.length;
        return shown.map(g => {
            const said = [g.nNew ? SVU_NUM_SAY[g.kind](g.nNew) : '', g.nOut ? SVU_NUM_SAY[g.outKind](g.nOut) : ''].filter(Boolean).join(', ');
            const title = _calEscAttr(_svuFirst(g.m) + ': ' + said);
            return `<span class="svu-bub"${titled ? ` title="${title}"` : ''} aria-label="${title}">${_svuAvatar(g.m, 'svu-bub-av', slug)}${g.nNew ? `<b class="svu-num svu-n-${g.kind}">${g.nNew}</b>` : ''}${g.nOut ? `<b class="svu-num svu-o-${g.outKind}">${g.nOut}</b>` : ''}</span>`;
        }).join('')
            + (rest ? `<span class="svu-bub-more"${titled ? ` title="${_calEscAttr(_svuPlural(rest, 'more person', 'more people'))}"` : ''}>+${rest}</span>` : '');
    }

    /* ---------- Calendar card: the Notes button (190 hands over here) ---------- */
    const SVU_NOTES_ICO = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h11v8H7l-3 2.5V11.5H2.5z"/></svg>';
    function svuNotesBtnHtml(post, pid) {
        const s = _svuStateOf(post);
        const any = s.change + s.comment + s.staff + s.kasper > 0;
        const strip = _svuBubblesHtml(_svuPeopleOf(post, s), 3, _svuPostSlug(post));
        const q = _jsAttrArg(pid);
        // Round 7: the whole row (the Notes button, the gap and the bubbles) is one click target that opens Notes; the
        // button inside keeps the keyboard, and its click reaches this row's handler.
        return `<span class="cal-foot-tweaks svu-foot" data-comments-wrap="${_calEscAttr(pid)}" onclick="openCalComments(${q})" onpointerenter="svuHoverCard(${q}, this)" onpointerleave="svuHideHover()"><button type="button" class="cal-comments-btn svu-notes${any ? ' svu-has-new' : ''}" data-comments-btn="${_calEscAttr(pid)}" onpointerenter="svCardNotesIntent(${q},120)" onfocus="svCardNotesIntent(${q},0)" onpointerdown="svCardNotesIntent(${q},0)" aria-label="Notes">${SVU_NOTES_ICO}<span class="cal-comments-label">Notes</span></button>${strip ? `<span class="svu-strips">${strip}</span>` : ''}</span>`;
    }

    /* ---------- the hover ---------- */
    let _svuHoverEl = null;
    function svuHoverCard(pid, anchor) {
        const post = calState.posts.find(p => p.id === pid);
        svuHideHover();
        if (!post || !anchor || !_svuOn) return;
        const s = _svuStateOf(post);
        // Everything a bubble counts: what is new and what still needs you (a change not done), newest first.
        const rows = s.items.map(it => it.n);
        for (const n of s.notes) if (n.m === n.root && s.openIds.has(n.m.id) && !s.newIds.has(n.m.id)) rows.push(n);
        rows.sort((a, b) => String(b.m.created_at).localeCompare(String(a.m.created_at)));
        if (!rows.length) return;
        const slug = _svuPostSlug(post);
        // Round 6: picture, first name, one line of the note. The bubble's colour already says what kind it is.
        const lines = rows.slice(0, 5).map(n => `<div class="svu-pv-row"><span class="svu-pv-ico">${_svuAvatar(n.m, 'svu-pv-av', slug)}</span><span class="svu-pv-who">${_calEsc(_svuFirst(n.m))}</span><span class="svu-pv-text">${_calEsc(n.m.body || '')}</span></div>`).join('');
        const more = rows.length > 5 ? `<div class="svu-pv-more">+${rows.length - 5} more</div>` : '';
        _svuHoverEl = document.createElement('div');
        _svuHoverEl.className = 'svu-pv';
        _svuHoverEl.setAttribute('role', 'tooltip');
        _svuHoverEl.innerHTML = lines + more;
        document.body.appendChild(_svuHoverEl);
        const r = anchor.getBoundingClientRect();
        const w = Math.min(380, innerWidth - 24);
        _svuHoverEl.style.width = w + 'px';
        _svuHoverEl.style.left = Math.max(12, Math.min(r.left, innerWidth - w - 12)) + 'px';
        const h = _svuHoverEl.offsetHeight;
        _svuHoverEl.style.top = (r.top - h - 6 > 8 ? r.top - h - 6 : r.bottom + 6) + 'px';
    }
    function svuHideHover() { if (_svuHoverEl) { _svuHoverEl.remove(); _svuHoverEl = null; } }

    /* ---------- Notes on a card ---------- */
    let _svuNotesSnap = null;   // what was new just before Notes opened (opening marks it seen)
    // 190 calls this as Notes opens, before it marks the card seen.
    function svuNotesOpening(pid) {
        if (!_svuOn) { _svuNotesSnap = null; return; }
        const l = _svuLocalGet();
        _svuNotesSnap = { pid, seen: l.unread.has(pid) ? '' : (_notesGetSeen(pid) || '') };
        if (l.unread.delete(pid)) _svuLocalSave();
        svuHideHover();
    }
    // Writes markup only when it differs from what this code last wrote there. Comparing with innerHTML would never
    // settle (the browser re-serialises <path/> as <path></path>), and every write wakes the observer below.
    function _svuSetHtml(el, html) {
        if (el.__svuHtml === html) return;
        el.__svuHtml = html;
        el.innerHTML = html;
    }
    function _svuDecorateNotes() {
        const modal = document.getElementById('calCommentsModal');
        if (!modal || !_svuNotesSnap) return;
        const post = calState.posts.find(p => p.id === _svuNotesSnap.pid);
        const feed = modal.querySelector('.cal-comments-feed');
        if (!post || !feed) return;
        const live = _svuStateOf(post, _svuNotesSnap.seen);
        const notes = live.notes;
        const slug = _svuPostSlug(post);
        const l = _svuLocalGet();
        // Round 6: no "Needs you" box (the tags on each note carry it); "Mark unread" is one quiet word in the head.
        const oldBar = modal.querySelector('.svu-need');
        if (oldBar) oldBar.remove();
        const head = modal.querySelector('.cal-comments-head');
        if (head && !head.querySelector('.svu-head-unread')) {
            const close = head.querySelector('.cal-comments-close');
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'svu-head-unread';
            btn.textContent = 'Mark unread';
            const pid = post.id;
            btn.addEventListener('click', () => svuMarkUnread(pid));
            if (close) close.before(btn); else head.appendChild(btn);
        }
        modal.querySelectorAll('.cal-cm-row[data-cm-row]').forEach(row => {
            const id = row.getAttribute('data-cm-row');
            const n = notes.find(x => x.m.id === id);
            if (!n) return;
            const k = _svuIsAuto(n.m) ? 'auto' : _svuKindOf(n);
            if (row.getAttribute('data-svu-kind') !== k) row.setAttribute('data-svu-kind', k);
            const av = row.querySelector('.cal-cm-avatar');
            if (av && !av.querySelector('.svu-slack-av')) av.innerHTML = _svuAvatar(n.m, 'svu-slack-av', slug);
            const au = row.querySelector('.cal-cm-author');
            if (au && !au.hasAttribute('data-svu-full')) {
                const full = au.textContent.trim();
                au.setAttribute('data-svu-full', full);
                au.title = full;
                au.textContent = full.split(/\s+/)[0] || full;
            }
            const tweak = row.querySelector('.cal-cm-type-tag.is-tweak');
            if (tweak && !tweak.hasAttribute('data-svu')) {
                const round = Number((tweak.textContent.match(/#(\d+)/) || [])[1] || 0);
                tweak.setAttribute('data-svu', '1');
                tweak.textContent = 'Change request' + (round > 1 ? ' ' + round : '');
            }
            const team = row.querySelector('.cal-cm-head-line .cal-cm-to-tag.is-team');
            if (team) team.outerHTML = `<span class="svu-lock" title="Team only: the client never sees this" aria-label="Team only">${SVU_LOCK_ICO}</span>`;
            const tm = row.querySelector('.cal-cm-time');
            if (tm && !tm.hasAttribute('data-svu-ago')) { tm.setAttribute('data-svu-ago', '1'); tm.textContent = _svuAgo(n.m.created_at); tm.title = _svuFullDate(n.m.created_at); }
            const tags = [];
            // "Waiting for your answer" already says it needs you, so it stands alone (round 6 E).
            if (live.waitingIds.has(id)) tags.push('<span class="svu-tag svu-t-waiting">Waiting for your answer</span>');
            else if (live.newIds.has(id)) tags.push(`<span class="svu-tag svu-t-${k}">New</span>`);
            // Round 7: no "Not done": a change request still listed is not done; its colour says what it is.
            if (l.noReply.has(id)) tags.push('<span class="svu-tag svu-t-plain">No reply needed</span>');
            if (_svuIsAuto(n.m)) tags.push('<span class="svu-tag svu-t-plain">Automatic record</span>');
            const html = tags.join('');
            const line = row.querySelector('.cal-cm-head-line');
            let holder = row.querySelector('.svu-tags');
            if (!holder && line) { holder = document.createElement('span'); holder.className = 'svu-tags'; line.insertBefore(holder, line.querySelector('.cal-cm-time')); }
            if (holder) _svuSetHtml(holder, html);
            // Round 6: one set of actions, the hover toolbar (Reply, Mark done, Delete); "No reply needed" joins it on a
            // comment waiting for an answer.
            const bar = row.querySelector('.cal-cm-actions');
            // Round 7: only a comment can be answered. A change request (and a reply under one) has no Reply; its
            // replies already written still show. Mark done and Delete stay.
            const reply = bar && _svuIsTweak(n.root) && bar.querySelector('.cal-cm-action[onclick^="_calBeginReply"]');
            if (reply) reply.remove();
            const nr = bar && bar.querySelector('.svu-noreply');
            if (bar && live.waitingIds.has(id) && !nr) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'cal-cm-action svu-noreply';
                btn.textContent = 'No reply needed';
                btn.addEventListener('click', () => svuNoReply(id));
                const first = bar.querySelector('.cal-cm-action');
                if (first) first.after(btn); else bar.prepend(btn);
            } else if (nr && !live.waitingIds.has(id)) nr.remove();
            if (bar && !bar.querySelector('button')) bar.remove();
            // Round 7: the toolbar shows at the bottom right of the note (_svuFitBars). The header keeps room only for
            // the part's name pinned in its top right corner, so a long header wraps before it.
            const headLine = row.querySelector('.cal-cm-head-line');
            const part = headLine && headLine.querySelector('.cal-cm-comp-label');
            const room = part ? Math.ceil(part.scrollWidth) + 16 + 'px' : '';
            if (headLine && headLine.style.paddingRight !== room) headLine.style.paddingRight = room;
        });
        _svuFitBars(modal, '.cal-cm-row[data-cm-row]', '.cal-cm-actions', '.cal-cm-body-col');
    }
    /* Round 7 (owner, 2026-10-24): the hover toolbar sits at the bottom right of a note or message. Where the last line
       of its words runs under the toolbar, the note gets the toolbar's height of room at the bottom (svu-bar-room), so
       the toolbar never covers a word; elsewhere it sits beside the last line and adds no space. All reads first, then
       all writes. The room does not change the line's width, so this settles in one pass. */
    function _svuLastLineRight(col, skip) {
        let bottom = -1, right = 0;
        const walk = document.createTreeWalker(col, NodeFilter.SHOW_TEXT);
        const range = document.createRange();
        for (let t = walk.nextNode(); t; t = walk.nextNode()) {
            if (!t.nodeValue.trim() || (skip && t.parentElement && t.parentElement.closest(skip))) continue;
            range.selectNodeContents(t);
            for (const r of range.getClientRects()) {
                if (!r.width || !r.height) continue;
                if (r.bottom > bottom + 4) { bottom = r.bottom; right = r.right; }
                else if (r.bottom > bottom - 4) right = Math.max(right, r.right);
            }
        }
        return right;
    }
    function _svuFitBars(root, rowSel, barSel, colSel) {
        if (!root) return;
        const want = [];
        root.querySelectorAll(rowSel).forEach(row => {
            const bar = row.querySelector(barSel), col = row.querySelector(colSel);
            if (!bar || !col) { if (row.classList.contains('svu-bar-room')) want.push([row, false]); return; }
            const right = _svuLastLineRight(col, '.cal-cm-head-line, .msg-b-meta, ' + barSel);
            want.push([row, right + 12 > bar.getBoundingClientRect().left]);
        });
        want.forEach(([row, on]) => { if (row.classList.contains('svu-bar-room') !== on) row.classList.toggle('svu-bar-room', on); });
    }
    let _svuFitQueued = false;
    window.addEventListener('resize', () => {
        if (!_svuOn || _svuFitQueued) return;
        _svuFitQueued = true;
        requestAnimationFrame(() => {
            _svuFitQueued = false;
            try {
                _svuFitBars(document.getElementById('calCommentsModal'), '.cal-cm-row[data-cm-row]', '.cal-cm-actions', '.cal-cm-body-col');
                _svuFitBars(document.getElementById('msgPage'), '.msg-b[data-msg-id]', '.svu-msg-acts', '.msg-b');
            } catch (e) {}
        });
    });
    /* ---------- Messages (326 hands over here) ---------- */
    const _svuIsChangeMsg = (m, byId) => { const root = byId.get(m.root_id) || m; return _svuIsClient(m) && _svuIsTweak(root) && root.is_tweak === true && _svuIsClient(root); };
    // New = from the first unread message the server named, minus your own, automatic records and change requests.
    function _svuConvState(c) {
        const l = _svuLocalGet();
        const s = { comment: 0, staff: 0, kasper: 0, waiting: 0, newIds: new Set(), waitingIds: new Set(), newTotal: 0 };
        const msgs = Array.isArray(c.messages) ? c.messages : null;
        if (!msgs) {
            // The cached list carries no messages yet: the server's own count, as a client comment.
            const n = l.unread.has(c.post_id) ? Math.max(1, Number(c.unread) || 0) : (Number(c.unread) || 0);
            s.comment = n; s.newTotal = n;
            return s;
        }
        const byId = new Map(msgs.map(m => [m.id, m]));
        const marked = l.unread.has(c.post_id);
        const start = marked ? 0 : (Number(c.unread) > 0 && c.first_unread_id ? msgs.findIndex(m => m.id === c.first_unread_id) : -1);
        // The reviewer view (scope "all") never counts a client message as new: the server's countsAsNew (inbox.mjs).
        const reviewer = _msgState.scope === 'all';
        msgs.forEach((m, i) => {
            if (start < 0 || i < start || _svuIsMine(m) || _svuIsAuto(m) || _svuIsChangeMsg(m, byId)) return;
            if (reviewer && _svuIsClient(m)) return;
            const k = _svuIsClient(m) ? 'comment' : _svuRole(m) === 'kasper' ? 'kasper' : 'staff';
            s[k]++; s.newIds.add(m.id);
        });
        for (const r of msgs.filter(m => m.root_id === m.id)) {
            if (!_svuIsClient(r) || r.is_tweak === true || l.noReply.has(r.id) || _svuIsAuto(r)) continue;
            if (!msgs.some(m => m.root_id === r.id && m !== r && !_svuIsClient(m))) { s.waitingIds.add(r.id); if (!s.newIds.has(r.id)) s.waiting++; }
        }
        s.newTotal = s.comment + s.staff + s.kasper;
        return s;
    }
    function _svuConvBubbles(c, s) {
        const by = new Map();
        for (const m of Array.isArray(c.messages) ? c.messages : []) {
            if (!s.newIds.has(m.id) && !s.waitingIds.has(m.id)) continue;
            const k = _svuIsClient(m) ? 'client' : String(m.author_member_id || m.author || 'Team');
            if (!by.has(k)) by.set(k, { m, nNew: 0, kind: '', nOut: 0, outKind: '', last: '' });
            const g = by.get(k);
            if (s.newIds.has(m.id)) { g.nNew++; const kk = _svuIsClient(m) ? 'comment' : _svuRole(m) === 'kasper' ? 'kasper' : 'staff'; if (!g.kind || SVU_RANK[kk] > SVU_RANK[g.kind]) g.kind = kk; }
            else { g.nOut++; g.outKind = 'waiting'; }
            if (String(m.created_at) > g.last) g.last = String(m.created_at);
        }
        if (!by.size && s.newTotal) by.set('client', { m: { role: c.last_role || 'client', author: c.last_author, author_member_id: c.last_author_member_id }, nNew: s.newTotal, kind: 'comment', nOut: 0, outKind: '', last: '' });
        return _svuBubblesHtml([...by.values()].sort((x, y) => (y.nNew > 0) - (x.nNew > 0) || y.last.localeCompare(x.last)), 2, c.client_slug, true);
    }
    function svuMsgListHtml() {
        const f = _msgState.filter;
        const keep = c => { const s = _svuConvState(c); return f === 'all' || c.post_id === _msgState.openId || (f === 'answer' ? s.waitingIds.size > 0 : s.newTotal > 0); };
        const list = _msgState.conversations.filter(keep);
        if (!list.length) return `<div class="msg-list-empty">${f === 'answer' ? 'Nothing is waiting for your answer' : f === 'new' ? 'Nothing new' : 'No conversations yet'}</div>`;
        return list.map(c => {
            const s = _svuConvState(c);
            const msgs = Array.isArray(c.messages) ? c.messages : [];
            const byId = new Map(msgs.map(m => [m.id, m]));
            const last = msgs.filter(m => !_svuIsAuto(m) && !_svuIsChangeMsg(m, byId)).slice(-1)[0]
                || { author: c.last_author, author_member_id: c.last_author_member_id, role: c.last_role, body: c.last_body, created_at: c.last_at };
            const who = _svuIsMine(last) ? 'You' : _svuFirst(last);
            return `<button type="button" class="msg-conv svu-conv${c.post_id === _msgState.openId ? ' is-active' : ''}${s.newTotal ? ' is-unread' : ''}" data-msg-conv="${_calEscAttr(c.post_id)}" onclick="_msgOpen(${_jsAttrArg(c.post_id)})">
                ${_svuAvatar({ role: 'client' }, 'svu-conv-av', c.client_slug)}
                <span class="svu-conv-main">
                    <span class="svu-conv-top"><span class="svu-conv-title">${_calEsc(c.title || 'Untitled post')}</span><span class="svu-conv-time">${_calEsc(_svuAgo(last.created_at || c.last_at))}</span></span>
                    <span class="svu-conv-last">${_calEsc(_msgClientName(c))} · ${_calEsc(who + ': ' + (last.body || ''))}</span>
                </span>
                <span class="svu-conv-badge">${_svuConvBubbles(c, s)}</span>
            </button>`;
        }).join('');
    }
    function svuUnreadConversations() { return _msgState.conversations.filter(c => _svuConvState(c).newTotal > 0).length; }
    function svuPaintCounts() {
        let newConvs = 0, waitConvs = 0; const k = { comment: 0, staff: 0, kasper: 0 };
        for (const c of _msgState.conversations) { const s = _svuConvState(c); if (s.newTotal) newConvs++; if (s.waitingIds.size) waitConvs++; k.comment += s.comment; k.staff += s.staff; k.kasper += s.kasper; }
        const kind = k.comment ? 'comment' : k.staff ? 'staff' : k.kasper ? 'kasper' : 'waiting';
        const n = newConvs || waitConvs;
        document.querySelectorAll('[data-kasper-count="replies"]').forEach(el => { el.textContent = String(newConvs); el.classList.toggle('is-unread', newConvs > 0); });
        document.querySelectorAll('[data-msg-count]').forEach(el => {
            el.textContent = String(n);
            el.hidden = n === 0;
            el.className = 'msg-unread svu-count svu-count-' + (newConvs ? kind : 'waiting');
        });
        _svuCounts = { newConvs, waitConvs, k };
    }
    let _svuCounts = { newConvs: 0, waitConvs: 0, k: {} };
    // After every Messages repaint (326): the tabs, the Slack-like chat rows and the change-request line.
    function svuAfterMsgPaint() {
        if (!_svuOn) return;
        document.querySelectorAll('[data-msg-root]').forEach(root => {
            const filters = root.querySelector('.msg-filters');
            if (filters && !filters.querySelector('[data-svu-answer]')) {
                const waitConvs = _msgState.conversations.filter(c => _svuConvState(c).waitingIds.size > 0).length;
                const newConvs = svuUnreadConversations();
                filters.innerHTML = [['new', 'New', newConvs], ['answer', 'To answer', waitConvs], ['all', 'All', 0]].map(([k, t, n]) =>
                    `<button type="button" data-svu-${k}="1" class="${_msgState.filter === k ? 'is-active' : ''}" aria-pressed="${_msgState.filter === k}" onclick="_msgSetFilter('${k}')">${t}${n ? ` <span>${n}</span>` : ''}</button>`).join('');
            }
            const c = _msgState.conversations.find(x => x.post_id === _msgState.openId);
            if (!c || !Array.isArray(c.messages)) return;
            const l = _svuLocalGet();
            // Read here: a card's "Mark unread" (kept in this browser) no longer holds it in New.
            if (l.unread.delete(c.post_id)) { _svuLocalSave(); setTimeout(svuRefresh, 0); }
            const s = _svuConvState(c);
            const byId = new Map(c.messages.map(m => [m.id, m]));
            // Round 6 E: header actions as words ("Mark unread" as on the card), day lines as Slack names them, and the
            // reply caption by first name.
            root.querySelectorAll('.msg-chat-actions .msg-act').forEach(a => { if (/unread/i.test(a.textContent)) a.textContent = 'Mark unread'; });
            root.querySelectorAll('.msg-day:not([data-svu])').forEach(d => {
                let next = d.nextElementSibling;
                while (next && !next.matches('.msg-b[data-msg-id]')) next = next.nextElementSibling;
                const m = next && byId.get(next.getAttribute('data-msg-id'));
                d.setAttribute('data-svu', '1');
                if (m) { const label = _svuDayLabel(m.created_at); if (label) { d.title = d.textContent; d.textContent = label; } }
            });
            const cap = root.querySelector('.msg-reply-cap b');
            if (cap && !cap.hasAttribute('data-svu')) { cap.setAttribute('data-svu', '1'); cap.textContent = cap.textContent.trim().split(/\s+/)[0]; }
            root.querySelectorAll('.msg-b[data-msg-id]').forEach(b => {
                if (b.hasAttribute('data-svu')) return;
                b.setAttribute('data-svu', '1');
                const m = byId.get(b.getAttribute('data-msg-id'));
                if (!m) return;
                if (_svuIsChangeMsg(m, byId)) {
                    if (m.root_id === m.id) b.outerHTML = `<div class="svu-change-line" title="Change requests are handled on the card">${_svuAvatar(m, 'svu-line-av', c.client_slug)}<span><b>${_calEsc(_svuFirst(m))}</b> asked for a change on the ${_calEsc(String(_svuLabel(m.component || 'video')).toLowerCase())}</span><span class="svu-time">${_calEsc(_svuAgo(m.created_at))}</span><button type="button" class="svu-text-btn" onclick="_msgOpenCard()">Open card</button></div>`;
                    else b.remove();
                    return;
                }
                const k = _svuIsAuto(m) ? 'auto' : _svuIsMine(m) ? 'me' : _svuIsClient(m) ? 'comment' : _svuRole(m) === 'kasper' ? 'kasper' : 'staff';
                b.setAttribute('data-svu-kind', k);
                if (!b.querySelector('.svu-slack-av')) b.insertAdjacentHTML('afterbegin', _svuAvatar(m, 'svu-slack-av', c.client_slug));
                const meta = b.querySelector('.msg-b-meta');
                if (meta) {
                    // Round 6: first name, no role word, a lock for "Team only", "Change request" in quiet words, the
                    // part at the right, and a relative time (the day line above carries the date).
                    const name = meta.querySelector('b');
                    if (name && !_svuIsMine(m)) { name.title = name.textContent; name.textContent = _svuFirst(m); }
                    const role = name && name.nextElementSibling;
                    if (role && role.tagName === 'SPAN' && !role.className && ['Client', 'SMM', 'Reviewer'].includes(role.textContent.trim())) role.remove();
                    const team = meta.querySelector('.cal-cm-to-tag.is-team');
                    if (team) team.outerHTML = `<span class="svu-lock" title="Team only: the client never sees this" aria-label="Team only">${SVU_LOCK_ICO}</span>`;
                    const tweak = meta.querySelector('.cal-cm-type-tag.is-tweak');
                    if (tweak) tweak.outerHTML = '<span class="svu-kind-change">Change request</span>';
                    const time = [...meta.children].filter(x => x.tagName === 'SPAN' && !x.className).pop();
                    if (time) { time.className = 'svu-time'; time.textContent = _svuAgo(m.created_at); time.title = _svuFullDate(m.created_at); }
                    const part = meta.querySelector('.cal-cm-comp-label');
                    if (part) meta.appendChild(part);
                }
                const tags = [];
                if (s.waitingIds.has(m.id)) tags.push('<span class="svu-tag svu-t-waiting">Waiting for your answer</span>');
                if (l.noReply.has(m.id)) tags.push('<span class="svu-tag svu-t-plain">No reply needed</span>');
                if (_svuIsAuto(m)) tags.push('<span class="svu-tag svu-t-plain">Automatic record</span>');
                if (meta && tags.length) { const part = meta.querySelector('.cal-cm-comp-label'); if (part) part.insertAdjacentHTML('beforebegin', tags.join('')); else meta.insertAdjacentHTML('beforeend', tags.join('')); }
                // Round 6: Reply (and No reply needed on a comment waiting for you) show on hover, as plain words.
                // Round 6 E, as Slack: a message right after one by the same person in the same thread, within five
                // minutes and with no day line or divider between, drops the repeated picture and name. A message that still
                // needs your answer keeps its header, for its tag.
                const prev = b.previousElementSibling;
                const pm = prev && prev.matches('.msg-b[data-msg-id]') && byId.get(prev.getAttribute('data-msg-id'));
                const who = x => String(x.author_member_id || '') + '|' + String(x.author || '') + '|' + String(x.role || '');
                const sameThread = pm && (pm.root_id === m.root_id || (pm.root_id === pm.id && m.root_id === m.id));
                if (pm && sameThread && who(pm) === who(m) && Date.parse(m.created_at) - Date.parse(pm.created_at) < 5 * 60000 && !s.waitingIds.has(m.id)) b.classList.add('svu-cont');
                // Round 7 (spacing audit): a message's attachments show under its words, as in Notes (326 drew none).
                const files = Array.isArray(m.attachments) ? m.attachments.filter(x => x && /^https?:\/\//i.test(String(x.url || ''))) : [];
                const text = b.querySelector('.msg-b-text');
                if (files.length && text && !b.querySelector('.svu-msg-files')) text.insertAdjacentHTML('afterend', '<div class="prod-comment-attachments svu-msg-files">'
                    + files.map(x => `<a class="prod-comment-attachment" href="${_calEscAttr(x.url)}" target="_blank" rel="noopener noreferrer">${_calEsc(x.name || 'Attachment')}</a>`).join('') + '</div>');
                // Round 7: no Reply on a change request or in its thread (only comments are answered); bottom right.
                const tweakThread = (byId.get(m.root_id) || m).is_tweak === true;   // as 326 tags "Change request"
                const acts = (tweakThread ? '' : `<button type="button" onclick="_msgSetReplyTo(${_jsAttrArg(m.root_id)});document.getElementById('msgReplyBox')&&document.getElementById('msgReplyBox').focus()">Reply</button>`)
                    + (s.waitingIds.has(m.id) ? `<button type="button" onclick="svuNoReply(${_jsAttrArg(m.id)})">No reply needed</button>` : '');
                if (acts) b.insertAdjacentHTML('beforeend', `<div class="svu-msg-acts">${acts}</div>`);
            });
            _svuFitBars(root, '.msg-b[data-msg-id]', '.svu-msg-acts', '.msg-b');
        });
    }

    /* ---------- the Messages button's hover ---------- */
    let _svuBtnTip = null;
    function _svuShowButtonTip() {
        _svuHideButtonTip();
        const btn = document.getElementById('navMessages');
        if (!btn || !_svuOn) return;
        const c = _svuCounts;
        const line = (k, text) => `<div class="svu-pv-row svu-k-${k} svu-tip-row"><span class="svu-pv-ico">${SVU_ICO[k]}</span><span class="svu-tip-text">${text}</span></div>`;
        _svuBtnTip = document.createElement('div');
        _svuBtnTip.className = 'svu-pv svu-btn-tip';
        _svuBtnTip.innerHTML = `<div class="svu-tip-head">${c.newConvs ? _svuPlural(c.newConvs, 'conversation has', 'conversations have') + ' something new' : 'Nothing new'}</div>`
            + (c.k.comment ? line('comment', SVU_SAY.comment(c.k.comment)) : '') + (c.k.staff ? line('staff', SVU_SAY.staff(c.k.staff)) : '') + (c.k.kasper ? line('kasper', SVU_SAY.kasper(c.k.kasper)) : '')
            + (c.waitConvs ? line('waiting', _svuPlural(c.waitConvs, 'client is', 'clients are') + ' waiting for your answer') : '')
            + '<div class="svu-pv-foot">Change requests are on the cards, not here.</div>';
        document.body.appendChild(_svuBtnTip);
        const r = btn.getBoundingClientRect();
        const w = Math.min(330, innerWidth - 24);
        _svuBtnTip.style.width = w + 'px';
        _svuBtnTip.style.left = Math.max(12, Math.min(r.right - w, innerWidth - w - 12)) + 'px';
        _svuBtnTip.style.top = (r.bottom + 6) + 'px';
    }
    function _svuHideButtonTip() { if (_svuBtnTip) { _svuBtnTip.remove(); _svuBtnTip = null; } }

    /* ---------- actions ---------- */
    function svuNoReply(id) { const l = _svuLocalGet(); l.noReply.add(String(id)); _svuLocalSave(); svuRefresh(); }
    function svuMarkUnread(pid) { const l = _svuLocalGet(); l.unread.add(String(pid)); _svuLocalSave(); svuRefresh(); try { showToast('Marked unread'); } catch (e) {} }
    function svuRefresh() {
        try { (calState.posts || []).forEach(p => _calRefreshCommentsBtn(p.id)); } catch (e) {}
        try { _svuDecorateNotes(); } catch (e) {}
        if (!_msgState.unavailable) { try { svuPaintCounts(); _msgPaint(); } catch (e) {} }
    }

    /* ---------- switching on and off ---------- */
    let _svuObserver = null;
    function _svuSync() {
        let phone = false;
        try { phone = _msgIsPhone(); } catch (e) { phone = false; }
