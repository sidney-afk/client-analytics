                if (s.waitingIds.has(m.id)) b.insertAdjacentHTML('beforeend', `<div class="svu-row-acts"><button type="button" class="svu-btn svu-primary" onclick="_msgSetReplyTo(${_jsAttrArg(m.root_id)});document.getElementById('msgReplyBox')&&document.getElementById('msgReplyBox').focus()">Reply</button><button type="button" class="svu-text-btn" onclick="svuNoReply(${_jsAttrArg(m.id)})">No reply needed</button></div>`);
            });
        });
    }

    /* ---------- the Messages button's hover ---------- */
    let _svuBtnTip = null;
    function _svuShowButtonTip() {
        _svuHideButtonTip();
