        if (!btn || !_svuOn) return;
        const c = _svuCounts;
        const line = (k, text) => `<div class="svu-pv-row svu-k-${k} svu-tip-row"><span class="svu-pv-ico">${SVU_ICO[k]}</span><span class="svu-tip-text">${text}</span></div>`;
        _svuBtnTip = document.createElement('div');
        _svuBtnTip.className = 'svu-pv svu-btn-tip';
        _svuBtnTip.innerHTML = `<div class="svu-tip-head">${c.newConvs ? _svuPlural(c.newConvs, 'conversation has', 'conversations have') + ' something new' : 'Nothing new'}</div>`
            + (c.k.comment ? line('comment', SVU_SAY.comment(c.k.comment)) : '') + (c.k.staff ? line('staff', SVU_SAY.staff(c.k.staff)) : '') + (c.k.kasper ? line('kasper', SVU_SAY.kasper(c.k.kasper)) : '')
            + (c.waitConvs ? line('waiting', _svuPlural(c.waitConvs, 'client is', 'clients are') + ' waiting for your answer') : '')
            + '<div class="svu-pv-foot">Change requests are on the cards, not here.</div>';
        document.body.appendChild(_svuBtnTip);
        const r = btn.getBoundingClientRect();
        const w = Math.min(330, innerWidth - 24);
        _svuBtnTip.style.width = w + 'px';
        _svuBtnTip.style.left = Math.max(12, Math.min(r.right - w, innerWidth - w - 12)) + 'px';
        _svuBtnTip.style.top = (r.bottom + 6) + 'px';
    }
    function _svuHideButtonTip() { if (_svuBtnTip) { _svuBtnTip.remove(); _svuBtnTip = null; } }

    /* ---------- actions ---------- */
    function svuNoReply(id) { const l = _svuLocalGet(); l.noReply.add(String(id)); _svuLocalSave(); svuRefresh(); }
    function svuMarkUnread(pid) { const l = _svuLocalGet(); l.unread.add(String(pid)); _svuLocalSave(); svuRefresh(); try { showToast('Marked unread'); } catch (e) {} }
    function svuRefresh() {
        try { (calState.posts || []).forEach(p => _calRefreshCommentsBtn(p.id)); } catch (e) {}
        try { _svuDecorateNotes(); } catch (e) {}
        if (!_msgState.unavailable) { try { svuPaintCounts(); _msgPaint(); } catch (e) {} }
    }

    /* ---------- switching on and off ---------- */
    let _svuObserver = null;
    function _svuSync() {
        let phone = false;
        try { phone = _msgIsPhone(); } catch (e) { phone = false; }
        const want = !phone && svUnreadBadgesOn();
        if (want === _svuOn) return;
        _svuOn = want;
        document.documentElement.classList.toggle('sv-unread2', want);
        const nb = document.getElementById('navMessages');
        if (want) {
            if (!_svuObserver && typeof MutationObserver !== 'undefined') {
                let queued = false;
                _svuObserver = new MutationObserver(() => {
                    if (queued) return;
                    queued = true;
