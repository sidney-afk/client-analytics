            if (nb && !nb.__svu) { nb.__svu = true; nb.addEventListener('pointerenter', _svuShowButtonTip); nb.addEventListener('pointerleave', _svuHideButtonTip); }
            // The pictures and the Messages counts come with the inbox answer.
            // A list read before the switch was (no pictures) is read again, now asking for them.
