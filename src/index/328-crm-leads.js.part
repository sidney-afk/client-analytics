t:600;color:var(--text-primary)}.crm-tile-foot{display:flex;align-items:center;gap:12px;margin-top:auto}.crm-menu-group{margin:0 0 26px}.crm-menu-group .crm-group-title{padding:0;margin:0 0 10px;font-size:1rem}.crm-menu-group .crm-seq-sub{display:block;width:auto;padding:4px 0 8px;border:0;cursor:default}.crm-search{position:relative}.crm-results{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:30;max-height:min(70vh,560px);overflow:auto;padding:6px;border:1px solid var(--crm-hair);border-radius:14px;background:var(--white);box-shadow:var(--shadow-lg)}.crm-results[hidden]{display:none}.crm-result{display:flex;flex-direction:column;gap:3px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:transparent;font:inherit;text-align:left;color:var(--text-primary);cursor:pointer}.crm-result+.crm-result{margin-top:2px}.crm-result:hover,.crm-result:focus-visible{background:var(--surface-hover);outline:none}.crm-result-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.crm-result-name{font-size:0.86rem;font-weight:700}.crm-result-stage{font-size:0.7rem;font-weight:600;color:var(--text-secondary);white-space:nowrap}.crm-result-meta{display:flex;gap:12px;font-size:0.74rem;min-width:0}.crm-result-niche{color:var(--text-muted)}.crm-result-contact,.crm-result-step{font-size:0.72rem;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crm-results-none,.crm-results-more{margin:0;padding:10px 12px;font-size:0.76rem;color:var(--text-secondary)}.crm-results-skel{display:flex;flex-direction:column;gap:10px;padding:10px}.crm-results-skel .sv-skeleton{display:block;height:14px;border-radius:6px}.crm-cols{grid-template-columns:minmax(0,1.25fr) minmax(0,.8fr) minmax(0,1.3fr) minmax(0,.8fr) minmax(0,1.5fr) 150px;gap:0;padding:0 0 0 28px;align-items:stretch}.crm-lead{grid-template-columns:minmax(0,1.25fr) minmax(0,.8fr) minmax(0,1.3fr) minmax(0,.8fr) minmax(0,1.5fr) 150px;gap:0;border-radius:0;padding:0 0 0 28px;align-items:stretch}.crm-lead>*{padding:9px 12px;min-width:0;border-left:1px solid color-mix(in srgb,var(--text-primary) 6%,transparent)}.crm-lead>:first-child{border-left:0;padding-left:0}.crm-col{position:relative;display:flex;align-items:center;min-width:0;padding:0 4px;border-left:1px solid color-mix(in srgb,var(--text-primary) 6%,transparent)}.crm-col:first-child{border-left:0;padding-left:0}.crm-col-btn,.crm-col-label{display:block;width:100%;min-height:34px;border:0;border-radius:6px;background:transparent;padding:6px 8px;font:inherit;font-size:0.66rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text-muted);text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.crm-col-label{cursor:default}.crm-col:first-child .crm-col-btn{padding-left:0}.crm-col-btn:hover{background:var(--surface-hover);color:var(--text-primary)}.crm-col-btn.is-on{color:var(--text-primary)}.crm-col-btn:focus-visible{outline:2px solid var(--focus-ring)}.crm-col-menu{position:absolute;top:calc(100% + 4px);left:0;z-index:20;min-width:220px;max-height:340px;overflow:auto;padding:6px;border:1px solid var(--crm-hair);border-radius:12px;background:var(--white);box-shadow:var(--shadow-lg)}.crm-col-opt{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:34px;border:0;border-radius:8px;background:transparent;padding:6px 10px;font:inherit;font-size:0.78rem;text-align:left;color:var(--text-primary);cursor:pointer;text-transform:none;letter-spacing:0}.crm-col-opt:hover,.crm-col-opt:focus-visible{background:var(--surface-hover);outline:none}.crm-col-opt.is-on{font-weight:700}.crm-col-n{color:var(--text-muted);font-size:0.7rem;font-variant-numeric:tabular-nums}.crm-stage-body>.crm-lead:nth-child(even){background:color-mix(in srgb,var(--text-primary) 2.5%,transparent)}.crm-stage-body>.crm-lead:hover{background:var(--surface-hover)}.crm-lead-stage{font-weight:600;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.crm-lead .crm-due{text-align:right;padding-right:12px}.crm-col-label{display:flex;align-items:center}.crm-col-due .crm-col-btn{text-align:right;padding-right:12px}.crm-temp+.crm-temp{margin-top:10px}'
            + '@media (max-width:720px){'
