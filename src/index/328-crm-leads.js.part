        document.head.appendChild(style);
    }


    /* Search: every word has to appear somewhere in the person's name,
       contact details, niche or where they came from. */
    function _crmSearchText(p) {
        return [p.display_name, p.email, p.phone, p.instagram_handle, p.niche, _crmSourceName(p.source_id), _crmLabel(CRM_LEAD_TYPES, p.lead_type)]
            .filter(Boolean).join(' ').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }
    function _crmSearchHit(p, q) {
        const hay = _crmSearchText(p);
        const digits = hay.replace(/[^0-9]/g, '');
        return q.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().split(/\s+/).filter(Boolean)
            .every(w => hay.includes(w.replace(/^@/, '')) || (/^[0-9+()\-. ]{4,}$/.test(w) && digits.includes(w.replace(/[^0-9]/g, ''))));
    }
    function _crmSearchHtml() {
        return '<div class="search-bar-wrap crm-search" id="crmSearchWrap"><div class="search-bar-pill"><input class="search-bar-input" id="crmSearch" type="search" placeholder="Search people" aria-label="Search people by name, email, phone, handle or niche" autocomplete="off" data-1p-ignore data-lpignore="true" spellcheck="false" value="' + _calEscAttr(_crmState.search) + '" oninput="_crmSetSearch(this.value)">'
            + '<button class="search-bar-icon" type="button" tabindex="-1" aria-hidden="true" onclick="document.getElementById(\'crmSearch\')?.focus()">' + CRM_ICON_SEARCH + '</button></div><div class="crm-results" id="crmResults" role="listbox" aria-label="People found" hidden></div></div>';
    }
    function _crmPaintResults() {
        const el = document.getElementById('crmResults');
        if (!el) return;
        const q = _crmState.search.trim();
        if (!q) { el.hidden = true; el.innerHTML = ''; return; }
        el.hidden = false;
        if (!_crmState.loaded) { el.innerHTML = '<div class="crm-results-skel" aria-hidden="true"><span class="sv-skeleton"></span><span class="sv-skeleton"></span></div>'; return; }
        const hits = _crmState.people.filter(p => _crmSearchHit(p, q));
        if (!hits.length) { el.innerHTML = '<p class="crm-results-none">Nobody matches \u201c' + _calEsc(q) + '\u201d.</p>'; return; }
        el.innerHTML = hits.slice(0, 8).map(p => {
            const contact = [p.email, p.phone, p.instagram_handle ? '@' + p.instagram_handle : ''].filter(Boolean).join(' \u00b7 ');
            return '<button type="button" class="crm-result" role="option" onclick="_crmOpenPersonById(' + _jsAttrArg(p.id) + ')">'
                + '<span class="crm-result-top"><span class="crm-result-name">' + _calEsc(_crmName(p)) + '</span><span class="crm-result-stage" data-crm-stage-tone="' + _calEscAttr(p.stage) + '">' + _calEsc(_crmLabel(CRM_STAGES, p.stage)) + '</span></span>'
                + '<span class="crm-result-meta">' + _crmFromHtml(p) + (p.niche ? '<span class="crm-result-niche">' + _calEsc(p.niche) + '</span>' : '') + '</span>'
                + (contact ? '<span class="crm-result-contact">' + _calEsc(contact) + '</span>' : '')
                + (p.next_step ? '<span class="crm-result-step">Next: ' + _calEsc(p.next_step) + (p.next_step_due ? ', ' + _calEsc(_crmDue(p.next_step_due)) : '') + '</span>' : '')
                + '</button>';
        }).join('') + (hits.length > 8 ? '<p class="crm-results-more">' + (hits.length - 8) + ' more. Keep typing to narrow it down.</p>' : '');
    }
    function _crmSetSearch(v) {
        _crmState.search = String(v || '');
        _crmPaintResults();
        if (!_crmState.search.trim() && _crmState.resultsLayer) { _crmState.resultsLayer = false; svLayerRelease('crm-results', { focus: false }); }
        if (_crmState.search.trim() && !_crmState.resultsLayer) {
            _crmState.resultsLayer = true;
            svLayerOpen({ key: 'crm-results', region: '#crmSearchWrap', opener: document.getElementById('crmSearch'), isOpen: () => !!_crmState.search.trim(), close: () => { _crmState.resultsLayer = false; _crmClearSearch(); } });
        }
    }
    function _crmClearSearch() {
        _crmState.search = '';
        const n = document.getElementById('crmSearch'); if (n) n.value = '';
        _crmPaintResults();
    }

    /* Same person twice: two entries with the same full name. Email, phone
       and Instagram are already unique, so the name is what is left. */
    function _crmNameKey(v) { return String(v || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); }
    function _crmSamePerson(p) {
        const k = _crmNameKey(p.display_name);
        if (k.length < 4 || k.indexOf(' ') < 0) return [];
        return (_crmState.people || []).filter(o => o.id !== p.id && _crmNameKey(o.display_name) === k);
    }
    function _crmSamePersonHtml(p) {
        const others = _crmSamePerson(p);
        if (!others.length) return '';
        return others.map(o => '<div class="crm-same"><span>Also in Leads as <button type="button" class="crm-link" onclick="_crmOpenPersonById(' + _jsAttrArg(o.id) + ')">' + _calEsc(_crmName(o)) + '</button> <span class="crm-muted">' + _calEsc([_crmLabel(CRM_LEAD_TYPES, o.lead_type), _crmSourceName(o.source_id)].filter(Boolean).join(' · ')) + '</span></span>'
            + '<button type="button" class="crm-btn crm-btn-soft" title="Keeps this person and moves the other one’s history, contact details and tags here"' + (_crmState.merging ? ' disabled' : '') + ' onclick="_crmMerge(' + _jsAttrArg(p.id) + ',' + _jsAttrArg(o.id) + ')">' + (_crmState.mergeArm === o.id ? 'Yes, merge' : 'Merge') + '</button></div>').join('');
    }
    async function _crmMerge(keep, drop) {
        if (_crmState.merging) return;
        // First tap asks, second tap merges (no browser pop-up).
        if (_crmState.mergeArm !== drop) {
            _crmState.mergeArm = drop;
            _crmPaintPanel(); _crmPaintReport();
            setTimeout(() => { if (_crmState.mergeArm === drop) { _crmState.mergeArm = ''; _crmPaintPanel(); _crmPaintReport(); } }, 5000);
            return;
        }
        _crmState.mergeArm = '';
        _crmState.merging = drop;
        _crmPaintPanel(); _crmPaintReport();
        try {
            await _crmCall('merge', { keep, drop });
            _crmState.people = (_crmState.people || []).filter(x => x.id !== drop);
            if (_crmState.dupes) _crmState.dupes = _crmState.dupes.map(g => g.filter(x => x.id !== drop)).filter(g => g.length > 1);
            showToast('Merged');
            if (_crmState.openId === drop) _crmOpenPerson(keep);
            else if (_crmState.openId === keep) _crmRefreshTimeline(keep);
            _crmLoad(true);
        } catch (e) {
            showToast(_crmErrorText(e));
        } finally {
            _crmState.merging = '';
            _crmPaintPanel(); _crmPaintReport();
        }
    }

    /* Report: where people came from, and how far each source got them. */
    async function _crmLoadReport(background) {
        if (_crmState.reportLoading) return;
        _crmState.reportLoading = true;
        const gen = _crmState.gen;
        if (!background) { _crmState.reportError = ''; _crmPaintReport(); }
        try {
            const [r, d] = await Promise.all([_crmCall('report', {}), _crmCall('duplicates', {}).catch(() => null)]);
            if (gen !== _crmState.gen) return;
            _crmState.report = { rows: Array.isArray(r.rows) ? r.rows : [], sources: Array.isArray(r.sources) ? r.sources : [] };
            if (d && Array.isArray(d.groups)) _crmState.dupes = d.groups;
            _crmState.reportError = '';
        } catch (e) {
            if (gen === _crmState.gen) _crmState.reportError = _crmErrorText(e);
        } finally {
            _crmState.reportLoading = false;
            if (gen === _crmState.gen) _crmPaintReport();
        }
    }
    function _crmReportSource(row) {
        if (!row.source_id) return 'No source';
        const src = ((_crmState.report && _crmState.report.sources) || []).find(x => x.id === row.source_id);
        if (!src) return 'Unknown source';
        return CRM_SOURCE_NAMES[String(src.name).trim().toLowerCase()] || String(src.name).replace(/^dream 100\s*[-–·:]\s*/i, 'Dream 100: ');
    }
    function _crmPct(n, of) { return of ? Math.round(n * 100 / of) + '%' : ''; }
    function _crmPaintReport() {
        const el = document.getElementById('crmReport');
        if (!el) return;
        if (!_crmState.report && _crmLoadingOr(el, true, _crmState.reportError, '_crmLoadReport(false)', 'report')) return;
        const rows = _crmState.report.rows;
        const tot = rows.reduce((a, r) => ({ people: a.people + r.people, booked: a.booked + r.booked, showed: a.showed + r.showed, won: a.won + r.won }), { people: 0, booked: 0, showed: 0, won: 0 });
        const cell = (n, of, what) => '<td class="crm-num"' + (n && of ? ' title="' + _calEscAttr(_crmPct(n, of) + ' of the people from here ' + what) + '"' : '') + '>' + (n ? n : '') + '</td>';
        const dupes = (_crmState.dupes || []).filter(g => g.length > 1);
        el.innerHTML = '<header class="crm-view-head"><h2>Report</h2><p class="crm-sub">Where people came from, and how many got to a call and signed.</p></header>'
            + '<table class="crm-report"><thead><tr><th scope="col">Where they came from</th><th scope="col" class="crm-num">People</th><th scope="col" class="crm-num" title="Booked a call at some point">Booked</th><th scope="col" class="crm-num" title="Had at least one call">Showed up</th><th scope="col" class="crm-num">Signed</th></tr></thead><tbody>'
            + rows.map(r => '<tr><th scope="row">' + _calEsc(_crmReportSource(r)) + '</th><td class="crm-num">' + r.people + '</td>' + cell(r.booked, r.people, 'booked a call') + cell(r.showed, r.people, 'had a call') + cell(r.won, r.people, 'signed') + '</tr>').join('')
            + '</tbody><tfoot><tr><th scope="row">All</th><td class="crm-num">' + tot.people + '</td>' + cell(tot.booked, tot.people, 'booked a call') + cell(tot.showed, tot.people, 'had a call') + cell(tot.won, tot.people, 'signed') + '</tr></tfoot></table>'
            + (dupes.length ? '<section class="crm-group"><h3 class="crm-group-title">Same person twice?</h3><ul class="crm-rows">'
                + dupes.map(g => '<li class="crm-row crm-dup"><span class="crm-dup-names">' + g.map(o => '<button type="button" class="crm-link" onclick="_crmOpenPersonById(' + _jsAttrArg(o.id) + ')">' + _calEsc(_crmName(o)) + '</button> <span class="crm-muted">' + _calEsc(_crmSourceName(o.source_id) || _crmLabel(CRM_LEAD_TYPES, o.lead_type)) + '</span>').join('<span class="crm-dotsep" aria-hidden="true">+</span>') + '</span>'
                + '<button type="button" class="crm-btn crm-btn-soft"' + (_crmState.merging ? ' disabled' : '') + ' title="Keeps the first one and moves the other’s history, contact details and tags into it" onclick="_crmMerge(' + _jsAttrArg(g[0].id) + ',' + _jsAttrArg(g[1].id) + ')">' + (_crmState.mergeArm === g[1].id ? 'Yes, merge' : 'Merge') + '</button></li>').join('') + '</ul></section>' : '');
    }
    function _crmMount(el) { _crmRenderPage(el); _crmWire(el); }
    window._crmMountPage = _crmMount;
    // A reload on /leads can reach navTo('leads') before this file has run: fill the empty shell now.
    {
        const lateShell = document.getElementById('crmPage');
        if (lateShell && !lateShell.firstChild) _crmMount(lateShell);
    }

    // ---- window exports (generated by `node scripts/check-modules.js --write-window-exports`; do not edit) ----
    Object.assign(window, {
        _crmAddNote, _crmApproveStep, _crmClearCols, _crmClosePanel, _crmCloseStepEditor, _crmColClick,
        _crmColPick, _crmEditPanel, _crmEditStep, _crmEnrol, _crmEnrolmentOp, _crmFoldGroup, _crmGo, _crmLoad,
        _crmMarkCall, _crmMerge, _crmOpenNote, _crmOpenPersonById, _crmReadMessage, _crmSavePanel,
        _crmSaveStep, _crmSetReason, _crmSetSearch, _crmSignIn, _crmStepCount, _crmToggleDue,
