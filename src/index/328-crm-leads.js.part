            + '.crm-report{width:100%;border-collapse:collapse;font-size:0.8rem;margin:4px 0 28px}.crm-report th,.crm-report td{padding:9px 8px;text-align:left;border-bottom:1px solid var(--border);font-weight:400}.crm-report thead th{position:sticky;top:60px;background:var(--bg);color:var(--text-secondary);font-size:0.72rem;font-weight:600}.crm-report tbody th{color:var(--text-primary);font-weight:500}.crm-report .crm-num{text-align:right;font-variant-numeric:tabular-nums;width:96px}.crm-report tfoot th,.crm-report tfoot td{font-weight:700;border-bottom:0}'
            + '.crm-lead{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1.35fr) minmax(0,.8fr) minmax(0,1.6fr) 96px;align-items:baseline;gap:12px;padding:8px 8px 8px 28px;border-radius:8px;cursor:pointer;font-size:0.78rem;line-height:1.35}.crm-lead-from{display:flex;align-items:baseline;gap:6px;min-width:0;overflow:hidden;white-space:nowrap}.crm-from-type{font-weight:600;color:var(--crm-tone,var(--text-secondary));flex-shrink:0}.crm-from-src{color:var(--text-muted);overflow:hidden;text-overflow:ellipsis}.crm-lead-from[data-crm-type="dream100"]{--crm-tone:var(--brief-look-ink)}.crm-lead-from[data-crm-type="ad_lead"]{--crm-tone:var(--brief-asks-ink)}.crm-lead-from[data-crm-type="past_call"]{--crm-tone:var(--brief-edit-ink)}.crm-lead-from[data-crm-type="email"]{--crm-tone:var(--brief-music-ink)}.crm-lead-from[data-crm-type="referral"]{--crm-tone:var(--brief-look-ink)}.crm-lead-owner{color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crm-lead-owner.is-empty{color:var(--text-muted)}'
