import { svLayerOpen, svLayerRelease } from './041-core-layers.js';
import { showToast } from './040-shared-briefs.js';
import {
  CAL_SUPABASE_URL, _svDateHtml, _svSelectHtml, _svSyncDateControl, _syncviewOfferStaffSignIn, _syncviewStaffCan,
  _syncviewStaffIdentityForHeaders
} from './100-onboarding-staff-controls.js';
import { _syncviewEfHeaders, _writeUiRecordFailure } from './120-calendar-flags-write-repair.js';
import { _calEsc, _calEscAttr, _jsAttrArg } from './131-core-html.js';
import { _svLoadingSkeletonHtml } from './133-core-loading-skeletons.js';
    /* ── Leads (CRM step 1) ─────────────────────────────────────────────────
       Model and plan: docs/features/CRM_LEADS.md. The page lives at /leads
       (route "leads", 092 navTo) and is linked from Kasper > More > Pipeline
       & Admin. Every read and write goes through the crm-leads Edge Function
       with the staff key; the tables have no browser access at all.

       Layout: a side menu (Today, Pipeline, then one entry per sequence)
       and one view at a time. Today lists only what needs someone (calls to
       mark Showed / No-show, next steps due, automatic sends in the next 24
       hours), with no empty groups. Pipeline stacks the stages down the page,
       each lead one flat line; drag a line onto a stage to change it. Every
       automation that messages a lead is a sequence with its own screen: our
       drafted ones (edit, approve, on/off) and the n8n ones (read-only, the
       exact wording from crm_n8n_sequences). A person panel shows the facts,
       what happened (each automatic email or text links to its wording),
       notes and sequences. Nothing on this page sends a message.

       Identity: a sign-out or a change of staff member calls
       _crmPurgeSensitiveState (100 purge) and _crmOnIdentity (100 chrome), so
       cached people, notes and drafts are dropped, in-flight reads are
       ignored (generation token) and the page re-renders for the new person.

       A refused write is reported with _writeUiRecordFailure (surface
       "leads"), and the person sees what happened and what to do. A save
       that lost a race (409) takes the newer copy and says so; nothing is
       retried behind the person's back. */
    const CRM_EF_URL = CAL_SUPABASE_URL + '/functions/v1/crm-leads';
    const CRM_STAGES = [
        ['to_contact', 'To contact'], ['contacted', 'Contacted'], ['replied', 'Replied'],
        ['call1_booked', 'Call 1 booked'], ['no_show', 'No-show'], ['call1_done', 'Call 1 done'],
        ['call2_done', 'Call 2 done'], ['nurture', 'Gone quiet'], ['won', 'Won'], ['lost', 'Lost']
    ];
    const CRM_LEAD_TYPES = [['dream100', 'Dream 100'], ['ad_lead', 'Ad lead'], ['past_call', 'Past call'], ['email', 'Email list'], ['referral', 'Referral']];
    const CRM_LOST_REASONS = [['price', 'Price'], ['trust', 'Trust'], ['timing', 'Timing'], ['budget', 'Budget'], ['no_show', 'No-show']];
    const CRM_TYPE_HINTS = { dream100: 'Someone we picked to reach out to', ad_lead: 'Filled in the form on an ad', past_call: 'Had a call with Kasper before', email: 'On our email list', referral: 'Came to us by word of mouth' };
    const CRM_TABS = [['today', 'Today'], ['pipeline', 'Leads'], ['report', 'Report']];
    const CRM_PAGE_NAMES = { today: 'Today', pipeline: 'Leads', report: 'Report', sequences: 'Automations', seq: 'Automations' };
    const CRM_CHANNELS = { sms: 'Text', email: 'Email', 'email+sms': 'Email and text', 'sms+email': 'Text and email', telegram: 'Telegram', meta_event: 'Meta event', none: 'None' };
    const CRM_AUDIENCES = { all: '', lost_price: 'If lost on price', lost_trust: 'If lost on trust', lost_other: 'Any other reason' };
    const CRM_HOLD_REASONS = {
        sequence_off: 'Sequence is off', not_approved: 'Step not approved', paused: 'Paused', quiet_hours: 'Waits for 8am their time',
        no_phone: 'No phone number', no_email: 'No email', text_too_long: 'Text too long', bad_channel: 'Unknown channel'
    };
    /* Per-person grant for a non-admin (docs/features/CRM_LEADS.md): add the
       member's display name here AND the same { role, actor } pair to
       LEADS_MEMBER_GRANTS in supabase/functions/_shared/crm-leads-core.mjs.
       This list only decides whether the link shows; the function decides
       access. */
    const CRM_LEADS_MEMBER_GRANTS = [];
    /* Members shown the Leads link by roster id (an id, not a name, so it can
       sit in this public file); the server twin is LEADS_MEMBER_GRANT_HASHES. */
    const CRM_LEADS_MEMBER_IDS = ['9eab9c80-666a-4fcf-8af7-a671469af2f0'];
    const CRM_ICON_VIEW = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4.5h11M4.5 8h7M6.5 11.5h3"/></svg>';
    const CRM_ICON_SEARCH = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>';
    const CRM_ICON_X = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>';
    const _crmState = {
        tab: 'home', seqKey: '', col: { stage: '', src: '', niche: '', due: '' }, sort: '', colMenu: '', tempFold: {}, loading: false, loaded: false, error: '', people: [], sources: [], truncated: false,
        filters: { lead_type: '', niche: '', owner: '', source_id: '', due_this_week: false },
        openId: '', person: null, events: [], source: null, personLoading: false, personError: '', saving: false,
        dragId: '', drafts: {}, gen: 0, editing: false,
        today: null, todayLoading: false, todayError: '',
        seqs: null, n8n: [], seqLoading: false, seqError: '', editStep: '', stepDrafts: {}, seqBusy: '',
        enrolments: [], marking: '', search: '',
        report: null, dupes: null, reportLoading: false, reportError: '', merging: ''
    };
    let _crmStepLayer = null;
    let _crmPanelLayer = null;

    function _crmCanUse() {
        try {
            if (_syncviewStaffCan('leads')) return true;
            const id = _syncviewStaffIdentityForHeaders();
            const name = String(id && id.member && id.member.name || '').trim().toLowerCase();
            const mid = String(id && id.member && id.member.id || '').trim();
            if (mid && CRM_LEADS_MEMBER_IDS.includes(mid)) return true;
            return !!name && CRM_LEADS_MEMBER_GRANTS.some(n => String(n).trim().toLowerCase() === name);
        } catch (e) { return false; }
    }
    function _crmLabel(list, value) { const hit = list.find(x => x[0] === value); return hit ? hit[1] : (value || ''); }
    function _crmToday() {
        const d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function _crmWeek() {
        const d = new Date(); const day = (d.getDay() + 6) % 7;
        const mon = new Date(d.getFullYear(), d.getMonth(), d.getDate() - day);
        const sun = new Date(mon.getFullYear(), mon.getMonth(), mon.getDate() + 6);
        const f = x => x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0');
        return { from: f(mon), to: f(sun) };
    }
    function _crmDue(value) {
        if (!value) return '';
        const d = new Date(value + 'T12:00:00');
        if (isNaN(d.getTime())) return value;
        const t = _crmToday();
        if (value === t) return 'Today';
        return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
    }
    function _crmWhen(iso) {
        const d = new Date(iso);
        if (isNaN(d.getTime())) return '';
        return d.toLocaleString(undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
    }
    function _crmOverdue(p) { return !!(p.next_step_due && p.next_step_due < _crmToday() && p.stage !== 'won' && p.stage !== 'lost'); }

    async function _crmCall(action, payload) {
        const resp = await fetch(CRM_EF_URL, {
            method: 'POST',
            headers: _syncviewEfHeaders({ 'Content-Type': 'application/json' }, CRM_EF_URL),
            body: JSON.stringify(Object.assign({ action }, payload || {}))
        });
        const data = await resp.json().catch(() => null);
        if (!resp.ok || !data || data.ok !== true) {
            const err = new Error((data && data.error) || ('HTTP ' + resp.status));
            err.status = resp.status;
            err.code = (data && data.error) || '';
            err.current = data && data.current || null;
            throw err;
        }
        return data;
    }
    function _crmErrorText(e) {
        const s = e && e.status;
        if (s === 401) return 'Sign in again to use Leads.';
        if (s === 403) return 'Leads is open to admins. Ask an admin for access.';
        if (s === 404 && e.code === 'not_found') return 'That person is no longer in Leads.';
        if (s === 404 || s === 0 || !s) return 'Leads could not be reached. Check your connection and try again.';
        return 'Leads did not answer (' + (e.code || ('HTTP ' + s)) + '). Try again in a minute.';
    }

    // ── Data ─────────────────────────────────────────────────────────────
    async function _crmLoad(background) {
        if (_crmState.loading) return;
        _crmState.loading = true;
        _crmPaintRefresh();
        const gen = _crmState.gen;
        if (!background) { _crmState.error = ''; _crmPaintBoard(); }
        try {
            const f = _crmState.filters;
            const filters = {};
            ['lead_type', 'niche', 'owner', 'source_id'].forEach(k => { if (f[k]) filters[k] = f[k]; });
            if (f.due_this_week) filters.due_this_week = true;
            const data = await _crmCall('list', { filters });
            if (gen !== _crmState.gen) return;   // the staff identity changed while this read was out
            _crmState.people = Array.isArray(data.people) ? data.people : [];
            _crmState.sources = Array.isArray(data.sources) ? data.sources : _crmState.sources;
            _crmState.truncated = !!data.truncated;
            _crmState.loaded = true;
            _crmState.error = '';
        } catch (e) {
            if (gen === _crmState.gen) _crmState.error = _crmErrorText(e);
        } finally {
            _crmState.loading = false;
            _crmPaintRefresh();
            if (gen === _crmState.gen) { _crmPaintBoard(); _crmPaintHome(); _crmPaintResults(); }
        }
    }
    async function _crmOpenPerson(id, opts) {
        if (!id) return;
        _crmState.editing = !!(opts && opts.edit);
        _crmState.openId = id;
        _crmState.person = _crmState.people.find(p => p.id === id) || null;
        _crmState.events = []; _crmState.source = null; _crmState.personError = ''; _crmState.personLoading = true; _crmState.enrolments = [];
        _crmPaintPanel();
        const gen = _crmState.gen;
        if (!_crmState.seqs) _crmLoadSequences(true);
        try {
            const data = await _crmCall('get', { id });
            if (_crmState.openId !== id || gen !== _crmState.gen) return;
            _crmState.person = data.person; _crmState.events = data.events || []; _crmState.source = data.source || null;
            _crmState.enrolments = Array.isArray(data.enrolments) ? data.enrolments : [];
        } catch (e) {
            if (_crmState.openId !== id) return;
            _crmState.personError = _crmErrorText(e);
        } finally {
            if (_crmState.openId === id) { _crmState.personLoading = false; _crmPaintPanel(); }
        }
    }
    function _crmMergeCard(person) {
        const i = _crmState.people.findIndex(p => p.id === person.id);
        if (i < 0) return;
        const prev = _crmState.people[i];
        _crmState.people[i] = Object.assign({}, prev, {
            stage: person.stage, owner: person.owner || '', next_step: person.next_step || '',
            next_step_due: person.next_step_due || null, tags: person.tags || prev.tags, state_version: person.state_version
        });
    }
    /* One change. Returns true when it saved. On a lost race (409) the newer
       copy replaces ours, so the person sees what is really stored. */
    async function _crmSave(id, patch, note, operation) {
        const card = _crmState.people.find(p => p.id === id);
        const current = _crmState.person && _crmState.person.id === id ? _crmState.person : card;
        if (!current) return false;
        try {
            const data = await _crmCall('update', { id, expected_version: current.state_version, patch, note: note || '' });
            _crmMergeCard(data.person);
            if (_crmState.person && _crmState.person.id === id) {
                _crmState.person = data.person;
                if (!data.unchanged) _crmRefreshTimeline(id);
            }
            return true;
        } catch (e) {
            _writeUiRecordFailure('leads', operation || 'update', e, { id: String(id) });
            if (e.status === 409 && e.current) {
                _crmMergeCard(e.current);
                if (_crmState.person && _crmState.person.id === id) { _crmState.person = e.current; _crmState.resetFields = true; }
                showToast('Someone else changed this person first. Their version is showing now; make your change again if it still applies.');
            } else {
                showToast('Not saved. ' + _crmErrorText(e));
            }
            return false;
        } finally {
            _crmPaintBoard();
            _crmPaintPanel();
        }
    }

    // ── Page ─────────────────────────────────────────────────────────────
    function _crmRenderPage(el) {
        if (!el) return;
        _crmInjectStyles();
        if (!_crmCanUse()) {
            el.innerHTML = '<div class="crm-page"><div class="crm-gate"><h1>Leads</h1><p>Leads holds contact details, so it is open to admins. Sign in with an admin account to see it.</p><button type="button" class="crm-btn crm-btn-primary" onclick="_crmSignIn()">Sign in</button></div></div>';
            return;
        }
        el.innerHTML = '<div class="crm-page crm-app">'
            + '<nav class="crm-side" id="crmSide" aria-label="Leads"></nav>'
            + '<div class="crm-main"><div class="crm-top" id="crmTop"></div><div id="crmBody"></div></div></div>'
            + '<div class="crm-panel-scrim" id="crmScrim" hidden onclick="_crmClosePanel()"></div>'
            + '<aside class="crm-panel" id="crmPanel" role="dialog" aria-modal="false" aria-labelledby="crmPanelTitle" hidden></aside>';
        _crmPaintSide();
        _crmPaintTop();
        _crmPaintBody();
        if (!_crmState.loaded) _crmLoad(false); else _crmLoad(true);
        if (_crmState.tab !== 'seq' && _crmState.tab !== 'sequences') _crmLoadSequences(!!_crmState.seqs);   // home and the side menu list the automations
    }
    function _crmSignIn() { _syncviewOfferStaffSignIn('leads'); }
    /* Our drafted sequences, split by whether they can send yet. */
    function _crmSeqReady(s) { return !!s.active && s.steps.length > 0 && s.steps.every(st => st.approval_state === 'approved'); }
    function _crmSideItem(key, label, current, extra) {
        return '<button type="button" class="crm-side-item" data-crm-nav="' + _calEscAttr(key) + '"' + (current ? ' aria-current="page"' : '') + ' onclick="_crmGo(' + _jsAttrArg(key) + ')"><span class="crm-side-label">' + _calEsc(label) + '</span>' + (extra ? '<span class="crm-side-extra">' + _calEsc(extra) + '</span>' : '') + '</button>';
    }
    /* Which group an n8n sequence sits in, from its key. */
    function _crmN8nGroup(key) {
        if (/^(after_form|didnt_book|left_early)/.test(key)) return ['After the ad form', /doctors/.test(key) ? 'Doctors' : /educators/.test(key) ? 'Educators' : 'Other calls'];
        if (/^booked/.test(key)) return ['After they book', 'Booked'];
        if (/^before_call/.test(key)) return ['After they book', 'Before the call'];
        if (/^after_call/.test(key)) return ['After the call', ''];
        return ['After they sign', ''];
    }
    const CRM_SUB_ORDER = ['Doctors', 'Educators', 'Other calls', 'Booked', 'Before the call', ''];
    /* Rows of one group; rows that share a sub-group (Doctors, Booked...)
       go in their own folder, built by wrap(name, rows html, count). */
    function _crmRuns(items) {
        const runs = [];
        items.forEach(x => { const r = runs[runs.length - 1]; if (r && r.sub === x.sub) r.items.push(x); else runs.push({ sub: x.sub, items: [x] }); });
        return runs;
    }
    function _crmWithSubs(items, row, wrap) {
        return _crmRuns(items).map(r => r.sub ? wrap(r.sub, r.items.map(row).join(''), r.items.length) : r.items.map(row).join('')).join('');
    }
    /* Automation folders start closed; the one holding the open automation opens. */
    function _crmSubFolded(key) {
        const o = _crmState.treeOpen || {};
        if (key in o) return !o[key];
        const k = _crmState.tab === 'seq' ? _crmState.seqKey : '';
        return !(k && _crmSeqGroups().some(g => g.items.some(x => x.key === k && (key === g.title || key === g.title + ' / ' + x.sub))));
    }
    /* The sequences as groups: n8n ones by when they start, then ours,
       split by whether they can send yet. */
    function _crmSeqGroups() {
        const out = [];
        const add = (title, items) => { if (items.length) out.push({ title, items }); };
        const n8n = (_crmState.n8n || []).map(s => ({ key: 'n8n:' + s.key, name: s.name, desc: s.description, count: (s.messages || []).filter(m => m.live !== false).length, live: !!s.active, where: 'n8n', group: _crmN8nGroup(s.key)[0], sub: _crmN8nGroup(s.key)[1] }))
            .sort((a, b) => CRM_SUB_ORDER.indexOf(a.sub) - CRM_SUB_ORDER.indexOf(b.sub));
        const own = (_crmState.seqs || []).map(s => ({ key: 'own:' + s.id, name: s.name, desc: s.description, count: s.steps.length, live: _crmSeqReady(s), where: 'SyncView' }));
        add('After the ad form', n8n.filter(x => x.group === 'After the ad form'));
        add('After they book', n8n.filter(x => x.group === 'After they book'));
        add('After the call', n8n.filter(x => x.group === 'After the call'));
        add('After they sign', n8n.filter(x => x.group === 'After they sign'));
        add('Our follow-ups', own.filter(x => x.live));
        add('Waiting for Kasper’s OK', own.filter(x => !x.live));
        return out;
    }
    function _crmPaintSide() {
        const el = document.getElementById('crmSide');
        if (!el) return;
        const t = _crmState.tab, k = _crmState.seqKey;
        const open = true;
        const inSeq = t === 'seq' || t === 'sequences';
        const app = el.closest('.crm-app'); if (app) app.classList.toggle('has-side', inSeq);
        el.hidden = !inSeq;
        if (!inSeq) { el.innerHTML = ''; return; }
        let tree = '';
        if (open) {
            if (!_crmState.seqs) tree = _crmState.seqError ? '' : '<div class="crm-side-skel" aria-hidden="true">' + [1, 2, 3, 4].map(() => '<span class="sv-skeleton"></span>').join('') + '</div>';
            else {
                tree = '<div class="crm-tree" id="crmSeqTree">'
                    + _crmSeqGroups().map(g => {
                        const shut = _crmSubFolded(g.title);
                        return '<div class="crm-tree-g' + (shut ? ' is-folded' : '') + '"><button type="button" class="crm-tree-head" aria-expanded="' + !shut + '" onclick="_crmFoldGroup(' + _jsAttrArg(g.title) + ')">' + CRM_CHEVRON + '<span>' + _calEsc(g.title) + '</span><span class="crm-tree-n">' + g.items.length + '</span></button>'
                            + (shut ? '' : '<div class="crm-tree-body"><button type="button" class="crm-tree-line" aria-label="' + _calEscAttr('Fold ' + g.title) + '" title="Fold" onclick="_crmFoldGroup(' + _jsAttrArg(g.title) + ')"></button>'
                            + _crmWithSubs(g.items, x => _crmSideItem(x.key, x.name, t === 'seq' && k === x.key), (n, html, c) => {
                                const fk = g.title + ' / ' + n, sh = _crmSubFolded(fk);
                                return '<div class="crm-tree-g crm-tree-subg' + (sh ? ' is-folded' : '') + '"><button type="button" class="crm-tree-head" aria-expanded="' + !sh + '" onclick="_crmFoldGroup(' + _jsAttrArg(fk) + ')">' + CRM_CHEVRON + '<span>' + _calEsc(n) + '</span><span class="crm-tree-n">' + c + '</span></button>'
                                    + (sh ? '' : '<div class="crm-tree-body"><button type="button" class="crm-tree-line" aria-label="' + _calEscAttr('Fold ' + n) + '" title="Fold" onclick="_crmFoldGroup(' + _jsAttrArg(fk) + ')"></button>' + html + '</div>') + '</div>';
                            }) + '</div>') + '</div>';
                    }).join('') + '</div>';
            }
        }
        el.innerHTML = '<div class="crm-side-nav"><div class="crm-side-section"><button type="button" class="crm-side-item crm-side-parent" data-crm-nav="sequences"' + (t === 'sequences' ? ' aria-current="page"' : '') + ' onclick="_crmGo(\'sequences\')"><span class="crm-side-label">All automations</span></button>' + tree + '</div></div>';
        el.classList.toggle('in-seq', inSeq);
    }
    function _crmToggleSeqMenu() { _crmState.seqMenuOpen = _crmState.seqMenuOpen === false; _crmPaintSide(); }
    /* A sub-group of the Sequences menu folds from its title or its line. */
    function _crmFoldGroup(title) {
        const f = _crmState.treeOpen || (_crmState.treeOpen = {}); f[title] = _crmSubFolded(title);
        const a = document.activeElement, inSeqs = !!(a && a.closest && a.closest('#crmSeqs')), cls = a && a.className, how = a && a.getAttribute && a.getAttribute('onclick');
        _crmPaintSide();
        /* Keep keyboard focus on the folder button that was pressed. */
        if (how) { const box = document.getElementById(inSeqs ? 'crmSeqs' : 'crmSide'); const b = box && Array.from(box.querySelectorAll('button')).find(n => n.getAttribute('onclick') === how && n.className === cls); if (b) b.focus(); }
    }
    /* Sequences, all on one screen: each group with one line per sequence. */
    function _crmPaintSeqOverview() {
        const el = document.getElementById('crmSeqs');
        if (!el) return;
        if (!_crmState.seqs && _crmLoadingOr(el, true, _crmState.seqError, '_crmLoadSequences(false)', 'sequences')) return;
        const tile = x => '<button type="button" class="crm-tile crm-seq-tile" data-crm-nav="' + _calEscAttr(x.key) + '" onclick="_crmGo(' + _jsAttrArg(x.key) + ')"' + (x.desc ? ' title="' + _calEscAttr(x.desc) + '"' : '') + '><span class="crm-tile-name">' + _calEsc(x.name) + '</span>'
            + '<span class="crm-tile-foot">' + (x.count ? '<span class="crm-seq-count">' + x.count + (x.count === 1 ? ' message' : ' messages') + '</span>' : '') + _crmLiveDot(x.live, x.where) + '</span></button>';
        el.innerHTML = '<header class="crm-view-head"><h2 title="Every automatic email and text a lead can get, grouped by when it starts">Automations</h2></header>'
            + _crmSeqGroups().map(g => '<section class="crm-group crm-menu-group"><h3 class="crm-group-title">' + _calEsc(g.title) + '</h3>'
                + _crmRuns(g.items).map(r => (r.sub ? '<h4 class="crm-seq-sub">' + _calEsc(r.sub) + '</h4>' : '') + '<div class="crm-tiles">' + r.items.map(tile).join('') + '</div>').join('')
                + '</section>').join('');
    }
    /* Sending or not, as a dot and one word; where it runs is in the hover. */
    function _crmLiveDot(live, where) {
        return '<span class="crm-live' + (live ? ' is-on' : '') + '" title="' + _calEscAttr(where === 'n8n' ? 'Runs in n8n, changed there' : 'Runs in SyncView') + '"><i aria-hidden="true"></i>' + (live ? 'Sending' : 'Off') + '</span>';
    }
    /* One place that moves between views: "today", "pipeline", or a
       sequence as "n8n:<key>" / "own:<id>". */
    function _crmGo(key) {
        key = String(key || '');
        if (/^(n8n|own):/.test(key)) { _crmState.tab = 'seq'; _crmState.seqKey = key; }
        else if (key === 'sequences') _crmState.tab = 'sequences';
        else if (key === 'home' || CRM_TABS.some(x => x[0] === key)) _crmState.tab = key;
        else return;
        _crmState.colMenu = '';
        _crmPaintSide();
        _crmPaintTop();
        _crmPaintBody();
        if (window.scrollY > 0 && window.innerWidth > 720) window.scrollTo({ top: 0, behavior: 'instant' });
        const main = document.querySelector('.crm-main'); if (main && main.scrollIntoView && window.innerWidth <= 720) main.scrollIntoView({ block: 'start' });
    }
    function _crmSetTab(tab) { _crmGo(tab); }
    /* Every page but home: a way back home, where you are, and search. */
    function _crmPaintTop() {
        const el = document.getElementById('crmTop');
        if (!el) return;
        const t = _crmState.tab;
        if (t === 'home') { el.innerHTML = ''; el.hidden = true; return; }
        el.hidden = false;
        el.innerHTML = '<nav class="crm-crumbs" aria-label="Where you are"><button type="button" class="crm-crumb" data-crm-nav="home" onclick="_crmGo(\'home\')">Leads home</button><span class="crm-crumb-sep" aria-hidden="true">/</span>'
            + CRM_HOME_TILES.map(x => '<button type="button" class="crm-crumb' + ((x[0] === t || (x[0] === 'sequences' && t === 'seq')) ? ' is-here' : '') + '" data-crm-nav="' + x[0] + '"' + ((x[0] === t || (x[0] === 'sequences' && t === 'seq')) ? ' aria-current="page"' : '') + ' onclick="_crmGo(' + _jsAttrArg(x[0]) + ')">' + _calEsc(x[1]) + '</button>').join('')
            + '</nav>' + _crmSearchHtml();
    }
    const CRM_HOME_TILES = [['today', 'Today', 'Calls to mark and follow-ups due'], ['pipeline', 'Leads', 'Everyone we might work with'], ['report', 'Report', 'Calls and wins by where they came from'], ['sequences', 'Automations', 'Every email and text that goes out by itself']];
    function _crmHomeFact(key) {
        if (key === 'today') { const t = _crmState.today; if (!t) return ''; const n = t.calls.length + t.due.length; return n ? n + (n === 1 ? ' thing to do' : ' things to do') : 'Nothing waiting'; }
        if (key === 'pipeline') { if (!_crmState.loaded) return ''; const n = _crmState.people.length, o = _crmState.people.filter(_crmOverdue).length; return n + (n === 1 ? ' person' : ' people') + (o ? ' \u00b7 ' + o + ' overdue' : ''); }
        if (key === 'sequences') { if (!_crmState.seqs) return ''; const n = _crmSeqGroups().reduce((a, g) => a + g.items.filter(x => x.live).length, 0); return n ? n + ' sending' : ''; }
        return '';
    }
    function _crmPaintHome() {
        const el = document.getElementById('crmHome');
        if (!el) return;
        const keep = document.activeElement && document.activeElement.id === 'crmSearch';
        el.innerHTML = '<header class="crm-home-head"><h1>Leads</h1></header>' + _crmSearchHtml()
            + '<div class="crm-tiles crm-home-tiles">' + CRM_HOME_TILES.map(x => { const f = _crmHomeFact(x[0]); return '<button type="button" class="crm-tile crm-home-tile" data-crm-nav="' + x[0] + '" onclick="_crmGo(' + _jsAttrArg(x[0]) + ')"><span class="crm-tile-name">' + _calEsc(x[1]) + '</span><span class="crm-tile-desc">' + _calEsc(x[2]) + '</span>' + (f ? '<span class="crm-tile-fact">' + _calEsc(f) + '</span>' : '') + '</button>'; }).join('') + '</div>';
        if (keep) { const n = document.getElementById('crmSearch'); if (n) { n.focus({ preventScroll: true }); n.setSelectionRange(n.value.length, n.value.length); } }
    }
    function _crmPaintBody() {
        const body = document.getElementById('crmBody');
        if (!body) return;
        _crmCloseStepEditor(true);
        if (_crmState.tab === 'home') { body.innerHTML = '<div id="crmHome"></div>'; _crmPaintHome(); if (!_crmState.today) _crmLoadToday(false); return; }
        if (_crmState.tab === 'today') { body.innerHTML = '<div id="crmToday"></div>'; _crmPaintToday(); _crmLoadToday(!!_crmState.today); return; }
        if (_crmState.tab === 'seq') { body.innerHTML = '<div id="crmSeqs"></div>'; _crmPaintSequences(); _crmLoadSequences(!!_crmState.seqs); return; }
        if (_crmState.tab === 'report') { body.innerHTML = '<div id="crmReport"></div>'; _crmPaintReport(); _crmLoadReport(!!_crmState.report); return; }
        if (_crmState.tab === 'sequences') { body.innerHTML = '<div id="crmSeqs"></div>'; _crmPaintSeqOverview(); _crmLoadSequences(!!_crmState.seqs); return; }
        body.innerHTML = '<header class="crm-view-head"><h2>Leads</h2><p class="crm-sub" id="crmSummary">Everyone we might work with.</p></header><div id="crmBoard" class="crm-board-wrap"></div>';
        _crmPaintBoard();
    }
    function _crmPaintRefresh() {
        const btn = document.getElementById('crmRefresh');
        if (!btn) return;
        const busy = !!(_crmState.loading || _crmState.todayLoading || _crmState.seqLoading);
        btn.classList.toggle('is-busy', busy);
        btn.setAttribute('aria-busy', String(busy));
    }
    function _crmDistinct(key) {
        const set = new Set();
        _crmState.people.forEach(p => { if (p[key]) set.add(p[key]); });
        if (_crmState.filters[key]) set.add(_crmState.filters[key]);
        return Array.from(set).sort((a, b) => a.localeCompare(b));
    }
    function _crmPaintFilters() {
        const el = document.getElementById('crmFilters');
        if (!el) return;
        const f = _crmState.filters;
        const all = (label) => [{ value: '', label }];
        const type = _svSelectHtml('crmFType', all('All lead types').concat(CRM_LEAD_TYPES.map(t => ({ value: t[0], label: t[1] }))), f.lead_type, 'All lead types');
        const niche = _svSelectHtml('crmFNiche', all('All niches').concat(_crmDistinct('niche').map(n => ({ value: n, label: n }))), f.niche, 'All niches');
        const batch = _svSelectHtml('crmFBatch', all('Every list').concat(_crmState.sources.map(s => ({ value: s.id, label: _crmSourceName(s.id) || s.name }))), f.source_id, 'Every list');
        el.innerHTML = '<div class="crm-filter"><span class="crm-filter-label">Type</span>' + type + '</div>'
            + '<div class="crm-filter"><span class="crm-filter-label">Niche</span>' + niche + '</div>'
            + '<div class="crm-filter"><span class="crm-filter-label">Where they came from</span>' + batch + '</div>'
            + '<button type="button" class="crm-toggle" role="switch" aria-checked="' + (!!f.due_this_week) + '" onclick="_crmToggleDue()"><span class="crm-switch-track" aria-hidden="true"><span class="crm-switch-knob"></span></span>Only due this week</button>';
        // A filter that is on while the menu is shut must not be forgotten: a quiet dot on View says so.
        const on = Object.keys(f).some(k => f[k]);
        const btn = document.getElementById('crmViewBtn');
        if (btn) { btn.classList.toggle('has-filter', on); btn.setAttribute('aria-label', on ? 'View options, a filter is on' : 'View options'); }
    }
    function _crmToggleView() {
        const menu = document.getElementById('crmViewMenu');
        if (!menu) return;
        if (!menu.hidden) { _crmCloseView(true); return; }
        const btn = document.getElementById('crmViewBtn');
        menu.hidden = false;
        if (btn) btn.setAttribute('aria-expanded', 'true');
        svLayerOpen({ key: 'crm-view', region: '#crmView', opener: btn, isOpen: () => { const m = document.getElementById('crmViewMenu'); return !!m && !m.hidden; }, close: () => _crmCloseView(false, true) });
    }
    function _crmCloseView(returnFocus, fromLayer) {
        const menu = document.getElementById('crmViewMenu');
        const btn = document.getElementById('crmViewBtn');
        if (!menu || menu.hidden) return true;
        menu.hidden = true;
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (!fromLayer) svLayerRelease('crm-view', { focus: false });
        if (returnFocus && btn) btn.focus({ preventScroll: true });
        return true;
    }
    function _crmSetFilter(key, value) {
        if (!(key in _crmState.filters)) return;
        _crmState.filters[key] = String(value || '');
        _crmLoad(false);
    }
    function _crmToggleDue() {
        _crmState.filters.due_this_week = !_crmState.filters.due_this_week;
        _crmPaintFilters();
        const t = document.querySelector('#crmFilters .crm-toggle'); if (t) t.focus({ preventScroll: true });
        _crmLoad(false);
    }
    /* Due soon: today or the next two days. Only overdue (red) and due soon
       (amber) carry colour on this page. */
    function _crmSoon(p) {
        if (!p.next_step_due || p.stage === 'won' || p.stage === 'lost' || _crmOverdue(p)) return false;
        const d = new Date(); d.setDate(d.getDate() + 2);
        const lim = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        return p.next_step_due <= lim;
    }
    function _crmDueHtml(p) {
        if (!p.next_step_due) return '<span class="crm-due"></span>';
        const overdue = _crmOverdue(p);
        return '<span class="crm-due' + (overdue ? ' is-overdue' : _crmSoon(p) ? ' is-soon' : '') + '">' + (overdue ? 'Overdue · ' : '') + _calEsc(_crmDue(p.next_step_due)) + '</span>';
    }
    /* Where a lead came from, in plain words: the kind of lead and the list
       or system that brought them in. */
    const CRM_STAGE_HINTS = {
        to_contact: 'We have not reached out yet', contacted: 'We reached out, no answer yet', replied: 'They wrote back',
        call1_booked: 'First call is on the calendar', no_show: 'Missed their first call', call1_done: 'Had the first call, no second call yet',
        call2_done: 'Had the second call or got the proposal, not signed', nurture: 'Interested but not ready; we keep in touch until they are',
        won: 'Signed with us', lost: 'Said no, or not a fit'
    };
    /* What happens next when nobody typed a next step, from the stage. */
    const CRM_AUTO_STEP = {
        to_contact: 'Reach out', contacted: 'Wait for a reply', replied: 'Answer and offer a call',
        call1_booked: 'Have the call', no_show: 'Offer a new time', call1_done: 'Book the second call',
        call2_done: 'Chase the signature', nurture: 'Check in later'
    };
    const CRM_SOURCE_NAMES = { 'doctors-ad': 'Doctor ads', 'fathom past calls': 'Kasper\'s Fathom calls' };
    function _crmSourceName(id) {
        const src = (_crmState.sources || []).find(x => x.id === id);
        if (!src || !src.name) return '';
        const raw = String(src.name).trim();
        return CRM_SOURCE_NAMES[raw.toLowerCase()] || raw.replace(/^dream 100\s*[-–·:]\s*/i, '');
    }
    function _crmFromHtml(p) {
        const type = _crmLabel(CRM_LEAD_TYPES, p.lead_type);
        const src = _crmSourceName(p.source_id);
        return '<span class="crm-lead-from" data-crm-type="' + _calEscAttr(p.lead_type || '') + '"><span class="crm-from-type" title="' + _calEscAttr(CRM_TYPE_HINTS[p.lead_type] || '') + '">' + _calEsc(type) + '</span>'
            + (src ? '<span class="crm-from-src">' + _calEsc(src) + '</span>' : '') + '</span>';
    }
    function _crmLeadHtml(p) {
        const overdue = _crmOverdue(p);
        return '<div class="crm-lead' + (overdue ? ' is-overdue' : '') + '" role="listitem" draggable="true" tabindex="0" data-crm-card="' + _calEscAttr(p.id) + '" aria-label="' + _calEscAttr(_crmName(p) + ', ' + _crmLabel(CRM_STAGES, p.stage) + (overdue ? ', overdue' : '')) + '">'
            + '<span class="crm-lead-name">' + _calEsc(_crmName(p)) + '</span>'
            + '<span class="crm-lead-stage" data-crm-stage-tone="' + _calEscAttr(p.stage) + '" title="' + _calEscAttr(CRM_STAGE_HINTS[p.stage] || '') + '">' + _calEsc(_crmLabel(CRM_STAGES, p.stage)) + '</span>'
            + _crmFromHtml(p)
            + '<span class="crm-lead-niche">' + _calEsc(p.niche || '') + '</span>'
            + (p.next_step ? '<span class="crm-lead-step" title="' + _calEscAttr(p.next_step) + '">' + _calEsc(p.next_step) + '</span>'
                : '<span class="crm-lead-step is-auto" title="Suggested from the stage; set your own in the person panel">' + _calEsc(p.next_step_due ? 'Next step' : (CRM_AUTO_STEP[p.stage] || '')) + '</span>')
            + _crmDueHtml(p) + '</div>';
    }
    /* Which stage sections are folded, remembered on this browser only. */
    function _crmFolded() {
        if (!_crmState.folded) { try { _crmState.folded = JSON.parse(localStorage.getItem('sv_crm_folded') || '[]'); } catch (e) { _crmState.folded = []; } if (!Array.isArray(_crmState.folded)) _crmState.folded = []; }
        return _crmState.folded;
    }
    /* Cold: people we picked and never talked to. Warm: everyone who came to us or already met us. */
    const CRM_TEMPS = [['cold', 'Cold leads', 'People we picked to reach out to, no contact from them yet'], ['warm', 'Warm leads', 'Ad leads, past calls, the email list and referrals']];
    function _crmTemp(p) { return p.lead_type === 'dream100' ? 'cold' : 'warm'; }
    function _crmToggleTemp(t) { _crmState.tempFold[t] = !_crmState.tempFold[t]; _crmPaintBoard(); const b = document.querySelector('[data-crm-temp="' + t + '"] .crm-stage-toggle'); if (b) b.focus({ preventScroll: true }); }
    /* Column headers: Stage, Where they came from and Niche filter; Name and Due sort. */
    const CRM_COLS = [['name', 'Name', 'sort'], ['stage', 'Stage', 'filter'], ['src', 'Where they came from', 'filter'], ['niche', 'Niche', 'filter'], ['step', 'Next step', ''], ['due', 'Due', 'filter']];
    function _crmColValue(p, key) {
        if (key === 'stage') return p.stage || '';
        if (key === 'src') return p.source_id || ('type:' + (p.lead_type || ''));
        if (key === 'niche') return p.niche || '';
        if (key === 'due') return _crmOverdue(p) ? 'overdue' : _crmSoon(p) ? 'soon' : p.next_step_due ? 'later' : 'none';
        return '';
    }
    function _crmColLabel(key, v) {
        if (key === 'stage') return _crmLabel(CRM_STAGES, v);
        if (key === 'src') return v.startsWith('type:') ? _crmLabel(CRM_LEAD_TYPES, v.slice(5)) || 'Unknown' : (_crmSourceName(v) || 'Unknown');
        if (key === 'due') return { overdue: 'Overdue', soon: 'Due in the next 2 days', later: 'Due later', none: 'No date' }[v] || v;
        return v || 'None';
    }
    function _crmColChoices(key) {
        const seen = new Map();
        _crmState.people.forEach(p => { const v = _crmColValue(p, key); seen.set(v, (seen.get(v) || 0) + 1); });
        let vals = Array.from(seen.keys());
        if (key === 'stage') vals.sort((a, b) => CRM_STAGES.findIndex(x => x[0] === a) - CRM_STAGES.findIndex(x => x[0] === b));
        else if (key === 'due') vals.sort((a, b) => ['overdue', 'soon', 'later', 'none'].indexOf(a) - ['overdue', 'soon', 'later', 'none'].indexOf(b));
        else vals.sort((a, b) => _crmColLabel(key, a).localeCompare(_crmColLabel(key, b)));
        return vals.map(v => ({ v, n: seen.get(v) }));
    }
    function _crmColClick(key) {
        const c = CRM_COLS.find(x => x[0] === key);
        if (!c) return;
        if (c[2] === 'sort') { _crmState.sort = _crmState.sort === key ? key + ':desc' : _crmState.sort === key + ':desc' ? '' : key; _crmPaintBoard(); _crmFocusCol(key); return; }
        if (c[2] !== 'filter') return;
        _crmState.colMenu = _crmState.colMenu === key ? '' : key;
        _crmPaintBoard();
        if (_crmState.colMenu) {
            const menu = document.getElementById('crmColMenu');
            const first = menu && menu.querySelector('button'); if (first) first.focus({ preventScroll: true });
            svLayerOpen({ key: 'crm-col', region: '#crmColMenu', opener: document.querySelector('[data-crm-col="' + key + '"]'), isOpen: () => !!_crmState.colMenu, close: () => { _crmState.colMenu = ''; _crmPaintBoard(); } });
        } else { svLayerRelease('crm-col', { focus: false }); _crmFocusCol(key); }
    }
    function _crmFocusCol(key) { const b = document.querySelector('[data-crm-col="' + key + '"]'); if (b) b.focus({ preventScroll: true }); }
    function _crmColPick(key, v) {
        _crmState.col[key] = v;
        _crmState.colMenu = '';
        svLayerRelease('crm-col', { focus: false });
        _crmPaintBoard();
        _crmFocusCol(key);
    }
    function _crmColHeadHtml() {
        return '<div class="crm-cols" role="row">' + CRM_COLS.map(c => {
            const on = c[2] === 'filter' ? !!_crmState.col[c[0]] : c[2] === 'sort' ? _crmState.sort.split(':')[0] === c[0] : false;
            const label = c[2] === 'filter' && _crmState.col[c[0]] ? _crmColLabel(c[0], _crmState.col[c[0]]) : c[1];
            const arrow = c[2] === 'sort' && on ? (_crmState.sort.endsWith(':desc') ? ' \u2193' : ' \u2191') : '';
            const inner = c[2] ? '<button type="button" class="crm-col-btn' + (on ? ' is-on' : '') + '" data-crm-col="' + c[0] + '"' + (c[2] === 'filter' ? ' aria-haspopup="listbox" aria-expanded="' + (_crmState.colMenu === c[0]) + '"' : '') + ' title="' + _calEscAttr(c[2] === 'sort' ? 'Sort by ' + c[1].toLowerCase() : 'Filter by ' + c[1].toLowerCase()) + '" onclick="_crmColClick(' + _jsAttrArg(c[0]) + ')">' + _calEsc(label + arrow) + '</button>' : '<span class="crm-col-label">' + _calEsc(c[1]) + '</span>';
            const menu = _crmState.colMenu === c[0] ? '<div class="crm-col-menu" id="crmColMenu" role="listbox" aria-label="' + _calEscAttr('Filter by ' + c[1].toLowerCase()) + '">'
                + '<button type="button" class="crm-col-opt' + (!_crmState.col[c[0]] ? ' is-on' : '') + '" role="option" aria-selected="' + !_crmState.col[c[0]] + '" onclick="_crmColPick(' + _jsAttrArg(c[0]) + ',\'\')">Everyone</button>'
                + _crmColChoices(c[0]).map(o => '<button type="button" class="crm-col-opt' + (_crmState.col[c[0]] === o.v ? ' is-on' : '') + '" role="option" aria-selected="' + (_crmState.col[c[0]] === o.v) + '" onclick="_crmColPick(' + _jsAttrArg(c[0]) + ',' + _jsAttrArg(o.v) + ')"><span>' + _calEsc(_crmColLabel(c[0], o.v)) + '</span><span class="crm-col-n">' + o.n + '</span></button>').join('') + '</div>' : '';
            return '<span class="crm-col crm-col-' + c[0] + '" role="columnheader">' + inner + menu + '</span>';
        }).join('') + '</div>';
    }
    function _crmClearCols() { Object.keys(_crmState.col).forEach(k => { _crmState.col[k] = ''; }); _crmPaintBoard(); }
    function _crmToggleStage(stage) {
        const f = _crmFolded();
        const i = f.indexOf(stage);
        if (i >= 0) f.splice(i, 1); else f.push(stage);
        try { localStorage.setItem('sv_crm_folded', JSON.stringify(f)); } catch (e) {}
        _crmPaintBoard();
    }
    const CRM_CHEVRON = '<svg class="crm-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l4 4-4 4"/></svg>';
    function _crmPaintBoard() {
        const board = document.getElementById('crmBoard');
        const summary = document.getElementById('crmSummary');
        _crmPaintRefresh();
        if (!board) return;
        const col = _crmState.col;
        const people = _crmState.people.filter(p => Object.keys(col).every(k => !col[k] || _crmColValue(p, k) === col[k]));
        const overdue = people.filter(_crmOverdue).length;
        const filtered = Object.keys(col).some(k => col[k]);
        if (summary && _crmState.loaded) {
            summary.innerHTML = _calEsc(people.length + (people.length === 1 ? ' person' : ' people') + (overdue ? ', ' + overdue + ' overdue' : '') + (_crmState.truncated ? ' (showing the first ' + people.length + ')' : ''))
                + (filtered ? ' <button type="button" class="crm-link" onclick="_crmClearCols()">Show everyone</button>' : '');
        }
        if (_crmState.error && !_crmState.loaded) {
            board.innerHTML = '<div class="crm-empty"><p>' + _calEsc(_crmState.error) + '</p><button type="button" class="crm-btn" onclick="_crmLoad(false)">Try again</button></div>';
            return;
        }
        if (!_crmState.loaded) { board.innerHTML = _svLoadingSkeletonHtml('leads', { view: 'pipeline' }); return; }
        if (!_crmState.people.length) { board.innerHTML = '<div class="crm-empty"><p>No leads yet. Import a CSV with scripts/crm-import.js to fill this list.</p></div>'; return; }
        const restore = (() => { const a = document.activeElement; const id = a && a.getAttribute && a.getAttribute('data-crm-card'); return id || ''; })();
        const rank = st => CRM_STAGES.findIndex(x => x[0] === st);
        const [sk, sd] = _crmState.sort.split(':');
        const dir = sd === 'desc' ? -1 : 1;
        const order = (a, b) => sk === 'name' ? dir * _crmName(a).localeCompare(_crmName(b))
            : (rank(a.stage) - rank(b.stage)) || String(a.next_step_due || '9999').localeCompare(String(b.next_step_due || '9999')) || _crmName(a).localeCompare(_crmName(b));
        /* One table, split into Cold and Warm sections you can fold. */
        board.innerHTML = '<div class="crm-sheet crm-board' + (_crmState.loading ? ' is-refreshing' : '') + '" role="table" aria-label="Leads">'
            + _crmColHeadHtml()
            + (people.length ? CRM_TEMPS.map(t => {
                const rows = people.filter(p => _crmTemp(p) === t[0]).sort(order);
                if (!rows.length) return '';
                const open = !_crmState.tempFold[t[0]];
                return '<section class="crm-stage crm-temp' + (open ? '' : ' is-folded') + '" data-crm-temp="' + t[0] + '" aria-label="' + _calEscAttr(t[1] + ', ' + rows.length) + '">'
                    + '<h2 class="crm-stage-head"><button type="button" class="crm-stage-toggle" aria-expanded="' + open + '" title="' + _calEscAttr(t[2]) + '" onclick="_crmToggleTemp(' + _jsAttrArg(t[0]) + ')">'
                    + CRM_CHEVRON + '<span class="crm-stage-name">' + _calEsc(t[1]) + '</span><span class="crm-count">' + rows.length + '</span></button></h2>'
                    + (open ? '<div class="crm-stage-body" role="rowgroup">' + rows.map(_crmLeadHtml).join('') + '</div>' : '') + '</section>';
            }).join('') : '<div class="crm-empty"><p>Nobody matches these filters.</p></div>')
            + '</div>';
        if (_crmState.error) board.insertAdjacentHTML('afterbegin', '<p class="crm-stale" role="status">' + _calEsc(_crmState.error) + ' Showing the last list.</p>');
        if (restore) { const el = board.querySelector('[data-crm-card="' + CSS.escape(restore) + '"]'); if (el) el.focus({ preventScroll: true }); }
    }

    // Board events: one set of listeners on the page, delegated.
    function _crmBoardClick(ev) {
        const card = ev.target.closest && ev.target.closest('[data-crm-card]');
        if (card) _crmOpenPerson(card.getAttribute('data-crm-card'));
    }
    function _crmBoardKey(ev) {
        const card = ev.target.closest && ev.target.closest('[data-crm-card]');
        if (card && (ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); _crmOpenPerson(card.getAttribute('data-crm-card')); }
    }
    function _crmDragStart(ev) {
        const card = ev.target.closest && ev.target.closest('[data-crm-card]');
        if (!card) return;
        _crmState.dragId = card.getAttribute('data-crm-card');
        card.classList.add('dragging');
        try { ev.dataTransfer.setData('text/plain', _crmState.dragId); ev.dataTransfer.effectAllowed = 'move'; } catch (e) {}
    }
    function _crmDragEnd() {
        _crmState.dragId = '';
        document.querySelectorAll('.crm-lead.dragging, .crm-stage.drop').forEach(n => n.classList.remove('dragging', 'drop'));
    }
    function _crmDragOver(ev) {
        const col = ev.target.closest && ev.target.closest('[data-crm-stage]');
        if (!col || !_crmState.dragId) return;
        ev.preventDefault();
        document.querySelectorAll('.crm-stage.drop').forEach(n => { if (n !== col) n.classList.remove('drop'); });
        col.classList.add('drop');
    }
    async function _crmDrop(ev) {
        const col = ev.target.closest && ev.target.closest('[data-crm-stage]');
        const id = _crmState.dragId;
        _crmDragEnd();
        if (!col || !id) return;
        ev.preventDefault();
        const stage = col.getAttribute('data-crm-stage');
        const card = _crmState.people.find(p => p.id === id);
        if (!card || card.stage === stage) return;
        const before = card.stage;
        card.stage = stage;              // show the move at once
        _crmPaintBoard();
        const ok = await _crmSave(id, { stage }, '', 'status');
        if (!ok) { const c = _crmState.people.find(p => p.id === id); if (c && c.stage === stage && c.state_version === card.state_version) c.stage = before; _crmPaintBoard(); }
        else if (stage === 'lost') _crmOpenPerson(id, { edit: true });   // ask why it was lost
    }
    // The branded selects fire a bubbling change on their hidden input.
    const CRM_FILTER_INPUTS = { crmFType: 'lead_type', crmFNiche: 'niche', crmFOwner: 'owner', crmFBatch: 'source_id' };
    function _crmOnChange(ev) {
        const id = ev.target && ev.target.id;
        if (CRM_FILTER_INPUTS[id]) _crmSetFilter(CRM_FILTER_INPUTS[id], ev.target.value);
        else if (id === 'crmPStage') _crmStageChanged(ev.target.value);
    }
    function _crmWire(root) {
        if (!root || root.dataset.crmWired) return;
        root.dataset.crmWired = '1';
        root.addEventListener('click', _crmBoardClick);
        root.addEventListener('keydown', _crmBoardKey);
        root.addEventListener('dragstart', _crmDragStart);
        root.addEventListener('dragend', _crmDragEnd);
        root.addEventListener('dragover', _crmDragOver);
        root.addEventListener('drop', _crmDrop);
        root.addEventListener('change', _crmOnChange);
    }

    // ── Person panel ─────────────────────────────────────────────────────
    function _crmEventText(e) {
        const d = e.detail || {};
        if (e.kind === 'stage_changed') return 'Moved from ' + _crmLabel(CRM_STAGES, d.from) + ' to ' + _crmLabel(CRM_STAGES, d.to);
        if (e.kind === 'owner_changed') return d.to ? 'Owner set to ' + d.to : 'Owner cleared';
        if (e.kind === 'next_step_set') return d.next_step || d.due ? 'Next step: ' + (d.next_step || 'no text') + (d.due ? ', due ' + _crmDue(d.due) : '') : 'Next step cleared';
        if (e.kind === 'lost_reason_set') return d.to ? 'Why it didn\'t close: ' + _crmLabel(CRM_LOST_REASONS, d.to).toLowerCase() : 'Why it didn\'t close cleared';
        if (e.kind === 'tags_changed') return 'Tags: ' + ((d.to || []).join(', ') || 'none');
        if (e.kind === 'note') return d.text || '';
        if (e.kind === 'imported') return 'Imported from a list';
        if (e.kind === 'created') return d.event === 'form_capture' ? 'Started the form on the ad page' : 'Added';
        if (e.kind === 'message_sent') return (e.channel === 'sms' ? 'Text' : 'Email') + ' sent' + (_crmActorName(e) ? ' by ' + _crmActorName(e) : '');
        if (e.kind === 'booked') return 'Booked a call' + (d.call_at ? ' for ' + _crmWhen(d.call_at) : '');
        if (e.kind === 'call_at_set') return d.to ? 'Call set for ' + _crmWhen(d.to) : 'Call time cleared';
        if (e.kind === 'call') return d.event === 'cancelled' ? 'Cancelled the call' : d.event === 'rescheduled' ? 'Moved the call' : (d.outcome === 'no_show' ? 'Did not show for the call' : d.outcome === 'showed' ? 'Showed for the call' : 'Call');
        if (e.kind === 'reply' || e.kind === 'sms_reply') return 'Replied' + (d.text ? ': ' + d.text : '');
        return e.kind.replace(/_/g, ' ');
    }
    /* "n8n:Sales — Booking Recovery Dispatch" reads as "Booking Recovery Dispatch". */
    function _crmActorName(e) {
        const a = String(e.actor || '');
        if (!a.startsWith('n8n:')) return '';
        return a.slice(4).replace(/^(normal |ai |educators )?sales\s*[\u2014-]\s*/i, '').replace(/^n8n:recovery$/i, 'Recovery').trim() || 'n8n';
    }
    /* Which n8n sequence an automatic send came from, so its wording can be
       opened from the timeline. */
    function _crmN8nKeyFor(e) {
        if (e.kind !== 'message_sent') return '';
        const wf = String(e.actor || '').replace(/^n8n:/, '');
        const cal = String((e.detail || {}).calendar || '');
        const all = (_crmState.n8n || []).filter(x => x.workflow_name === wf || (wf === 'recovery' && /didnt_book/.test(x.key)));
        if (!all.length) return '';
        const want = /educator/.test(cal) ? 'educators' : /consult/.test(cal) ? 'consult' : /doctor/.test(cal) ? 'doctors' : '';
        const hit = all.find(x => want && x.key.indexOf(want) >= 0 && x.key.indexOf('didnt_book') >= 0) || all.find(x => want && x.key.indexOf(want) >= 0) || all[0];
        return hit.key;
    }
    function _crmReadMessage(key) {
        _crmClosePanel();
        _crmGo('n8n:' + key);
    }
    function _crmPaintPanel() {
        const panel = document.getElementById('crmPanel');
        const scrim = document.getElementById('crmScrim');
        if (!panel) return;
        if (!_crmState.openId) { panel.hidden = true; if (scrim) scrim.hidden = true; return; }
        const p = _crmState.person;
        const wasOpen = !panel.hidden;
        const typing = document.activeElement && panel.contains(document.activeElement) && /^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName) ? document.activeElement.id : '';
        const keep = {};
        ['crmPOwner', 'crmPStep', 'crmPNote'].forEach(id => { const n = document.getElementById(id); if (n && wasOpen) keep[id] = n.value; });
        if (_crmState.resetFields) { delete keep.crmPOwner; delete keep.crmPStep; _crmState.resetFields = false; }
        panel.hidden = false; if (scrim) scrim.hidden = false;
        const close = '<button type="button" class="crm-x" onclick="_crmClosePanel()" aria-label="Close">' + CRM_ICON_X + '</button>';
        if (!p) {
            panel.innerHTML = '<div class="crm-panel-head"><h2 id="crmPanelTitle" class="crm-sr">Lead</h2>' + close + '</div><div class="crm-panel-body">'
                + (_crmState.personError ? '<p class="crm-muted">' + _calEsc(_crmState.personError) + '</p>' : _svLoadingSkeletonHtml('leads', { view: 'panel' })) + '</div>';
        } else {
            const contact = [
                p.email ? '<a href="mailto:' + _calEscAttr(p.email) + '">' + _calEsc(p.email) + '</a>' : '',
                p.phone ? '<a href="tel:' + _calEscAttr(p.phone) + '">' + _calEsc(p.phone) + '</a>' : '',
                p.instagram_handle ? '<a href="https://instagram.com/' + encodeURIComponent(p.instagram_handle) + '" target="_blank" rel="noopener noreferrer">@' + _calEsc(p.instagram_handle) + '</a>' : ''
            ].filter(Boolean).join('<span class="crm-dotsep" aria-hidden="true">·</span>');
            const timeline = _crmState.personLoading && !_crmState.events.length ? _svLoadingSkeletonHtml('leads', { view: 'panel' })
                : (_crmState.events.length ? '<ol class="crm-timeline">' + _crmState.events.map(e => { const k = _crmN8nKeyFor(e); return '<li class="crm-ev crm-ev-' + _calEscAttr(e.kind) + '"><span class="crm-ev-meta">' + _calEsc(_crmWhen(e.occurred_at)) + '</span><span class="crm-ev-text">' + _calEsc(_crmEventText(e)) + '</span>' + (k ? '<button type="button" class="crm-link" onclick="_crmReadMessage(' + _jsAttrArg(k) + ')">Read the message</button>' : '') + (e.actor && !String(e.actor).startsWith('n8n:') && e.kind !== 'imported' ? '<span class="crm-ev-by">' + _calEsc(e.actor) + '</span>' : '') + '</li>'; }).join('') + '</ol>'
                    : '<p class="crm-muted">' + _calEsc(_crmState.personError || 'Nothing has happened yet.') + '</p>');
            // One plain sentence for where they are; the fields only show after Edit.
            const lastTouch = _crmLastTouch(_crmState.events);
            const facts = [['Stage', _crmLabel(CRM_STAGES, p.stage) + (p.stage !== 'won' && p.lost_reason ? ' (' + _crmLabel(CRM_LOST_REASONS, p.lost_reason).toLowerCase() + ')' : '')],
                ['Next step', p.next_step || p.next_step_due ? (p.next_step || 'Next step') + (p.next_step_due ? ', ' + (_crmOverdue(p) ? 'overdue since ' : 'due ') + _crmDue(p.next_step_due) : '') : 'None yet'],
                ['Last touch', lastTouch ? _crmDue(lastTouch.slice(0, 10)) : 'None yet']];
            const edit = _crmState.editing
                ? '<form class="crm-form" onsubmit="event.preventDefault();_crmSavePanel()">'
                + '<label class="crm-field"><span>Stage</span>' + _svSelectHtml('crmPStage', CRM_STAGES.map(s => ({ value: s[0], label: s[1] })), p.stage, 'Stage') + '</label>'
                + '<label class="crm-field" id="crmLostWrap"' + (CRM_REASON_STAGES.includes(p.stage) ? '' : ' hidden') + '><span>Why it didn\'t close</span>' + _svSelectHtml('crmPLost', [{ value: '', label: 'Not set' }].concat(CRM_LOST_REASONS.map(r => ({ value: r[0], label: r[1] }))), p.lost_reason || '', 'Not set') + '</label>'
                + '<label class="crm-field crm-field-wide"><span>Next step</span><input id="crmPStep" class="crm-input" maxlength="500" autocomplete="off" placeholder="Send the follow-up DM" value="' + _calEscAttr(keep.crmPStep != null ? keep.crmPStep : (p.next_step || '')) + '"></label>'
                + '<div class="crm-field"><span>Due</span>' + _svDateHtml('crmPDue', p.next_step_due || '', { placeholder: 'No date' }) + '</div>'
                + '<div class="crm-form-actions"><button type="button" class="crm-btn" onclick="_crmEditPanel(false)">Cancel</button><button type="submit" class="crm-btn crm-btn-primary"' + (_crmState.saving ? ' disabled' : '') + '>Save changes</button></div>'
                + '</form>'
                : '<dl class="crm-facts">' + facts.map(f => '<div><dt>' + _calEsc(f[0]) + '</dt><dd>' + _calEsc(f[1]) + '</dd></div>').join('') + '</dl>'
                + _crmReasonHtml(p)
                + '';
            panel.innerHTML = '<div class="crm-panel-head"><div><h2 id="crmPanelTitle">' + _calEsc(_crmName(p)) + '</h2>'
                + '<p class="crm-muted">' + _calEsc(_crmLabel(CRM_LEAD_TYPES, p.lead_type)) + (p.niche ? ' · ' + _calEsc(p.niche) : '') + (_crmState.source ? ' · came from ' + _calEsc(_crmSourceName(_crmState.source.id) || _crmState.source.name) : '') + '</p>'
                + (contact ? '<p class="crm-contact">' + contact + '</p>' : '') + '</div>'
                + close + '</div>'
                + '<div class="crm-panel-body">'
                + edit
                + _crmSamePersonHtml(p)
                + (_crmState.noteOpen || keep.crmPNote || _crmState.drafts[p.id]
                    ? '<div class="crm-note"><label for="crmPNote" class="crm-sr">Note</label><textarea id="crmPNote" class="crm-input" rows="3" maxlength="4000" placeholder="What happened on a call or in a message, so whoever opens them next knows">' + _calEsc(keep.crmPNote != null ? keep.crmPNote : (_crmState.drafts[p.id] || '')) + '</textarea>'
                      + '<button type="button" class="crm-btn crm-btn-primary" onclick="_crmAddNote()"' + (_crmState.saving ? ' disabled' : '') + '>Save note</button></div>'
                    : '<div class="crm-panel-actions">' + (_crmState.editing ? '' : '<button type="button" class="crm-btn crm-btn-soft crm-edit" data-crm-edit onclick="_crmEditPanel(true)" title="Change the stage, next step or due date">Edit</button>') + '<button type="button" class="crm-btn crm-btn-soft" onclick="_crmOpenNote()" title="Write down what happened on a call or in a message, so whoever opens them next knows">Add a note</button></div>')
                + '<h3 class="crm-section-title">What\u2019s happened</h3>' + timeline
                + _crmPanelSeqHtml()
                + '</div>';
            if (_crmState.editing) _svSyncDateControl('crmPDue');
        }
        if (!wasOpen) {
            _crmPanelLayer = svLayerOpen({ key: 'crm-person', region: '#crmPanel', isOpen: () => { const n = document.getElementById('crmPanel'); return !!n && !n.hidden; }, close: () => _crmClosePanel(true) });
            const first = panel.querySelector('.crm-x'); if (first) first.focus({ preventScroll: true });
        } else if (typing) { const n = document.getElementById(typing); if (n) n.focus({ preventScroll: true }); }
    }
    function _crmOpenNote() {
        _crmState.noteOpen = true; _crmPaintPanel();
        const n = document.getElementById('crmPNote'); if (n) n.focus({ preventScroll: false });
    }
    /* Kasper's "Why didn't it close": one tap on the person, for anyone who
       had a call, missed it or went quiet. Tapping the chosen one clears it. */
    function _crmReasonHtml(p) {
        if (!CRM_REASON_STAGES.includes(p.stage)) return '';
        return '<div class="crm-reason" role="group" aria-label="Why it didn\u2019t close"><span class="crm-reason-label">Why it didn\u2019t close</span><div class="crm-reason-opts">'
            + CRM_LOST_REASONS.map(r => '<button type="button" class="crm-chip-btn" aria-pressed="' + (p.lost_reason === r[0]) + '"' + (_crmState.saving ? ' disabled' : '') + ' onclick="_crmSetReason(' + _jsAttrArg(r[0]) + ')">' + _calEsc(r[1]) + '</button>').join('') + '</div></div>';
    }
    async function _crmSetReason(reason) {
        const p = _crmState.person;
        if (!p || _crmState.saving) return;
        _crmState.saving = true; _crmPaintPanel();
        const ok = await _crmSave(p.id, { lost_reason: p.lost_reason === reason ? '' : reason }, '', 'update');
        _crmState.saving = false; _crmPaintPanel();
        if (ok) showToast('Saved');
    }
    function _crmEditPanel(on) {
        if (!_crmState.person) return;
        _crmState.editing = !!on;
        if (!on) _crmState.resetFields = true;
        _crmPaintPanel();
        const n = document.getElementById(on ? 'crmPStageBtn' : 'crmPanel');
        const target = on ? n : document.querySelector('#crmPanel [data-crm-edit]');
        if (target) target.focus({ preventScroll: true });
    }
    // Kasper's "Why it didn't close": asked of anyone who had a call or went quiet, not only Lost.
    const CRM_REASON_STAGES = ['no_show', 'call1_done', 'call2_done', 'nurture', 'lost'];
    function _crmStageChanged(value) {
        const wrap = document.getElementById('crmLostWrap');
        if (wrap) wrap.hidden = !CRM_REASON_STAGES.includes(value);
    }
    /* Last time we heard from them or reached them: a message, a reply or a call. */
    function _crmLastTouch(events) {
        let best = '';
        for (const e of events || []) if (['message_sent', 'reply', 'call'].includes(e.kind) && e.occurred_at > best) best = e.occurred_at;
        return best;
    }
    function _crmClosePanel(fromLayer) {
        // Closing never loses typed text: a started note is kept for that person.
        const note = document.getElementById('crmPNote');
        if (note && _crmState.openId) _crmState.drafts[_crmState.openId] = note.value;
        _crmState.openId = ''; _crmState.person = null; _crmState.events = []; _crmState.editing = false; _crmState.noteOpen = false;
        _crmPaintPanel();
        if (!fromLayer && _crmPanelLayer) svLayerRelease(_crmPanelLayer, { focus: true });
        _crmPanelLayer = null;
        return true;
    }
    async function _crmSavePanel() {
        const p = _crmState.person;
        if (!p || _crmState.saving) return;
        const val = id => { const n = document.getElementById(id); return n ? n.value : ''; };
        const patch = { stage: val('crmPStage') || p.stage, next_step: val('crmPStep').trim(), next_step_due: val('crmPDue') || '' };
        if (CRM_REASON_STAGES.includes(patch.stage)) patch.lost_reason = val('crmPLost') || '';
        _crmState.saving = true; _crmPaintPanel();
        const ok = await _crmSave(p.id, patch, '', 'update');
        _crmState.saving = false;
        if (ok) _crmState.editing = false;   // a lost race keeps the fields open on the newer copy
        _crmPaintPanel();
        if (ok) showToast('Saved');
    }
    async function _crmAddNote() {
        const p = _crmState.person;
        const n = document.getElementById('crmPNote');
        const text = n ? n.value.trim() : '';
        if (!p || !text || _crmState.saving) return;
        _crmState.saving = true; _crmPaintPanel();
        try {
            const data = await _crmCall('note', { id: p.id, note: text });
            _crmMergeCard(data.person);
            delete _crmState.drafts[p.id];
            // The panel may show someone else by now: only touch it if it is still this person.
            if (_crmState.openId === p.id && _crmState.person && _crmState.person.id === p.id) {
                _crmState.person = data.person;
                const box = document.getElementById('crmPNote'); if (box) box.value = '';
                _crmState.noteOpen = false;
                const d = await _crmCall('get', { id: p.id }).catch(() => null);
                if (d && _crmState.openId === p.id) { _crmState.events = d.events || []; _crmState.enrolments = d.enrolments || _crmState.enrolments; }
            }
            showToast('Note added');
        } catch (e) {
            _writeUiRecordFailure('leads', 'comment', e, { id: String(p.id) });
            if (_crmState.openId !== p.id) _crmState.drafts[p.id] = text;   // kept for when they open this person again
            showToast('Note not added. ' + _crmErrorText(e) + ' Your text is still in the box.');
        } finally {
            _crmState.saving = false; _crmPaintPanel();
        }
    }

    // ── Shared helpers for Today, Sequences and Systems ──────────────────
    function _crmIsAdmin() {
        try { return document.documentElement.getAttribute('data-staff-role') === 'admin'; } catch (e) { return false; }
    }
    function _crmName(p) { return p.display_name || (p.instagram_handle ? '@' + p.instagram_handle : 'Unnamed'); }
    function _crmTime(iso) {
        const d = new Date(iso);
        if (isNaN(d.getTime())) return '';
        return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }
    function _crmStepWhen(st) {
        const day = 'Day ' + st.day_offset;
        if (st.send_hour != null) return day + ', ' + String(st.send_hour).padStart(2, '0') + ':00 their time';
        if (st.hour_offset) return day + ', ' + st.hour_offset + 'h after they join';
        return st.day_offset ? day + ', same time they joined' : 'Right away';
    }
    function _crmSeqById(id) { return (_crmState.seqs || []).find(s => s.id === id) || null; }
    async function _crmRefreshTimeline(id) {
        const gen = _crmState.gen;
        try {
            const d = await _crmCall('get', { id });
            if (_crmState.openId === id && gen === _crmState.gen) { _crmState.events = d.events || []; _crmState.enrolments = d.enrolments || []; _crmPaintPanel(); }
        } catch (e) {}
    }
    function _crmLoadingOr(el, loading, error, retry, view) {
        if (error) { el.innerHTML = '<div class="crm-empty"><p>' + _calEsc(error) + '</p><button type="button" class="crm-btn" onclick="' + retry + '">Try again</button></div>'; return true; }
        if (loading) { el.innerHTML = _svLoadingSkeletonHtml('leads', { view: view || 'pipeline' }); return true; }
        return false;
    }

    // ── Today ────────────────────────────────────────────────────────────
    async function _crmLoadToday(background) {
        if (_crmState.todayLoading) return;
        _crmState.todayLoading = true;
        _crmPaintRefresh();
        const gen = _crmState.gen;
        if (!background) { _crmState.todayError = ''; _crmPaintToday(); }
        try {
            const d = await _crmCall('today', {});
            if (gen !== _crmState.gen) return;
            _crmState.today = { due: d.due_people || [], calls: d.calls_passed || [], sends: d.sends_today || [] };
            _crmState.todayError = '';
        } catch (e) {
            if (gen === _crmState.gen && !_crmState.today) _crmState.todayError = _crmErrorText(e);
        } finally {
            _crmState.todayLoading = false;
            if (gen === _crmState.gen) { _crmPaintToday(); _crmPaintHome(); }
        }
    }
    /* Only what needs someone, most urgent first: calls to mark, next steps
       due (overdue first), then automatic sends of the next 24 hours. A
       group with nothing in it is not drawn, and no count says zero. */
    function _crmPaintToday() {
        const el = document.getElementById('crmToday');
        _crmPaintRefresh();
        if (!el) return;
        const t = _crmState.today;
        if (!t && _crmLoadingOr(el, true, _crmState.todayError, '_crmLoadToday(false)', 'today')) return;
        const calls = t.calls.map(p => {
            const busy = _crmState.marking === p.id;
            return '<li class="crm-row crm-agenda" data-crm-call="' + _calEscAttr(p.id) + '"><span class="crm-when">' + _calEsc(_crmTime(p.call_at)) + '</span><button type="button" class="crm-row-main" onclick="_crmOpenPersonById(' + _jsAttrArg(p.id) + ')" title="' + _calEscAttr('Call 1 was ' + _crmWhen(p.call_at)) + '"><span class="crm-row-name">' + _calEsc(_crmName(p)) + '</span><span class="crm-row-meta">Did they show?</span></button>'
                + '<span class="crm-row-actions is-always"><button type="button" class="crm-btn crm-btn-ok" data-crm-outcome="showed"' + (busy ? ' disabled' : '') + ' onclick="_crmMarkCall(' + _jsAttrArg(p.id) + ',\'showed\')">Showed</button>'
                + '<button type="button" class="crm-btn crm-btn-soft" data-crm-outcome="no_show"' + (busy ? ' disabled' : '') + ' onclick="_crmMarkCall(' + _jsAttrArg(p.id) + ',\'no_show\')">No-show</button></span></li>';
        }).join('');
        const due = t.due.slice().sort((a, b) => (_crmOverdue(b) - _crmOverdue(a)) || String(a.next_step_due || '').localeCompare(String(b.next_step_due || '')))
            .map(p => '<li class="crm-row crm-agenda' + (_crmOverdue(p) ? ' is-overdue' : '') + '">' + _crmDueHtml(p).replace('class="crm-due', 'class="crm-when crm-due') + '<button type="button" class="crm-row-main" onclick="_crmOpenPersonById(' + _jsAttrArg(p.id) + ')"><span class="crm-row-name">' + _calEsc(_crmName(p)) + '</span><span class="crm-row-meta">' + _calEsc(p.next_step || 'Next step') + '</span></button></li>').join('');
        const sends = t.sends.map(x => {
            const state = x.state === 'send' ? 'Ready' : x.state === 'wait' ? 'Scheduled' : (CRM_HOLD_REASONS[x.reason] || 'Held');
            return '<li class="crm-row crm-agenda"><span class="crm-when">' + _calEsc(_crmTime(x.due_at)) + '</span><button type="button" class="crm-row-main" onclick="_crmOpenPersonById(' + _jsAttrArg(x.person_id) + ')"><span class="crm-row-name">' + _calEsc(x.display_name || 'Unnamed') + '</span><span class="crm-row-meta">' + _calEsc(x.sequence + ' · ' + (CRM_CHANNELS[x.channel] || x.channel)) + '</span></button><span class="crm-tag' + (x.state === 'send' || x.state === 'wait' ? '' : ' is-held') + '">' + _calEsc(state) + '</span></li>';
        }).join('');
        const total = t.calls.length + t.due.length;
        const dateLine = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
        const head = '<header class="crm-view-head"><h2>Today</h2><p class="crm-sub" role="status">' + _calEsc(dateLine) + (total ? '' : ' · nothing needs you') + '</p></header>';
        const group = (id, title, n, rows, tip) => rows ? '<section class="crm-group crm-day" aria-labelledby="' + id + '"><h3 class="crm-group-title" id="' + id + '"' + (tip ? ' title="' + _calEscAttr(tip) + '"' : '') + '>' + _calEsc(title) + '<span class="crm-group-n">' + n + '</span></h3><ul class="crm-rows">' + rows + '</ul></section>' : '';
        el.innerHTML = head
            + group('crmTodayCalls', 'Calls to mark', t.calls.length, calls)
            + group('crmTodayDue', 'Follow up', t.due.length, due)
            + group('crmTodaySends', 'Sending automatically', t.sends.length, sends, 'Emails and texts going out in the next 24 hours');
    }
    function _crmOpenPersonById(id) { if (id) _crmOpenPerson(String(id)); }
    async function _crmMarkCall(id, outcome) {
        const t = _crmState.today;
        const p = t && t.calls.find(x => x.id === id);
        if (!p || _crmState.marking) return;
        _crmState.marking = id; _crmPaintToday();
        try {
            const d = await _crmCall('call_outcome', { id, expected_version: p.state_version, outcome });
            _crmMergeCard(d.person);
            t.calls = t.calls.filter(x => x.id !== id);
            showToast(outcome === 'showed' ? 'Marked as showed. Moved to Call 1 done.' : (d.enrolment ? 'Marked as no-show and added to the No-show sequence.' : 'Marked as no-show.'));
            _crmLoadToday(true);
        } catch (e) {
            _writeUiRecordFailure('leads', 'status', e, { id: String(id) });
            if (e.status === 409 && e.current) { p.state_version = e.current.state_version; showToast('Someone changed this person first. Check them and mark the call again.'); _crmLoadToday(true); }
            else showToast('Not marked. ' + _crmErrorText(e));
        } finally {
            _crmState.marking = ''; _crmPaintToday();
        }
    }

    // ── Sequences ────────────────────────────────────────────────────────
    async function _crmLoadSequences(background) {
        if (_crmState.seqLoading) return;
        _crmState.seqLoading = true;
        _crmPaintRefresh();
        const gen = _crmState.gen;
        if (!background) { _crmState.seqError = ''; _crmPaintSequences(); }
        try {
            const d = await _crmCall('sequences', {});
            if (gen !== _crmState.gen) return;
            _crmState.seqs = d.sequences || [];
            _crmState.n8n = Array.isArray(d.n8n) ? d.n8n : [];
            _crmState.seqError = '';
        } catch (e) {
            if (gen === _crmState.gen && !_crmState.seqs) _crmState.seqError = _crmErrorText(e);
        } finally {
            _crmState.seqLoading = false;
            if (gen === _crmState.gen) { _crmPaintHome(); if (_crmState.tab === 'sequences') _crmPaintSeqOverview(); else if (!_crmState.editStep) _crmPaintSequences(); _crmPaintSide(); _crmPaintPanel(); }
        }
    }
    /* A step reads as one plain line ("Day 2, 09:00 their time · Email ·
       approved") with its message under it. */
    /* When a step goes out, as two short lines: the day, then the hour. */
    function _crmStepDay(st) { return st.day_offset ? 'Day ' + st.day_offset : (st.hour_offset ? 'Day 0' : 'Right away'); }
    function _crmStepHour(st) {
        if (st.send_hour != null) { const h = Number(st.send_hour); return (h % 12 || 12) + (h < 12 ? 'am' : 'pm') + ' their time'; }
        if (st.hour_offset) return st.hour_offset + 'h after it starts';
        return st.day_offset ? 'Same time it started' : 'As soon as it starts';
    }
    function _crmStepLine(st) {
        const approved = st.approval_state === 'approved';
        const aud = CRM_AUDIENCES[st.audience] || '';
        return '<p class="crm-step-line"><span class="crm-step-chan">' + _calEsc(CRM_CHANNELS[st.channel] || st.channel) + '</span>'
            + (aud ? ' · ' + _calEsc(aud.toLowerCase()) : '')
            + ' · <span class="crm-step-state' + (approved ? ' is-ok' : ' is-draft') + '">' + (approved ? 'Approved' + (st.approved_by ? ' by ' + _calEsc(st.approved_by) : '') : 'Waiting for approval') + '</span>'
            + (st.version > 1 ? ' · edited (v' + st.version + ')' : '') + '</p>';
    }
    function _crmStepHtml(st, admin) {
        const editing = _crmState.editStep === st.id;
        const approved = st.approval_state === 'approved';
        if (editing) {
            const dr = _crmState.stepDrafts[st.id] || { subject: st.subject || '', template: st.template };
            return '<li class="crm-step is-editing" data-crm-step="' + _calEscAttr(st.id) + '">' + _crmStepWhenHtml(st) + '<div class="crm-step-main">' + _crmStepLine(st)
                + '<div class="crm-step-editor" id="crmStepEditor">'
                + (st.channel === 'email' ? '<label class="crm-field"><span>Subject</span><input id="crmStepSubject" class="crm-input" maxlength="200" value="' + _calEscAttr(dr.subject) + '"></label>' : '')
                + '<label class="crm-field"><span>' + (st.channel === 'sms' ? 'Text' : 'Email') + '</span><textarea id="crmStepText" class="crm-input" rows="' + (st.channel === 'sms' ? 4 : 9) + '"' + (st.channel === 'sms' ? ' maxlength="300"' : ' maxlength="4000"') + ' oninput="_crmStepCount()">' + _calEsc(dr.template) + '</textarea></label>'
                + '<p class="crm-hint"><span id="crmStepCount"></span> Placeholders: {first_name}, {niche}, {rebook_link}, {call2_link}, {case_study_link}, {testimonials_link}, {useful_link}. Saving makes a new draft that needs approving again; texts already sent keep their wording.</p>'
                + '<div class="crm-step-actions is-always"><button type="button" class="crm-btn" onclick="_crmCloseStepEditor()">Cancel</button><button type="button" class="crm-btn crm-btn-primary" onclick="_crmSaveStep()"' + (_crmState.seqBusy ? ' disabled' : '') + '>Save as draft</button></div>'
                + '</div></div></li>';
        }
        return '<li class="crm-step" data-crm-step="' + _calEscAttr(st.id) + '">' + _crmStepWhenHtml(st) + '<div class="crm-step-main">'
            + '<div class="crm-step-top">' + _crmStepLine(st)
            + '<span class="crm-step-actions">'
            + '<button type="button" class="crm-btn" onclick="_crmEditStep(' + _jsAttrArg(st.id) + ')">Edit</button>'
            + (!approved && admin ? '<button type="button" class="crm-btn crm-btn-ok" onclick="_crmApproveStep(' + _jsAttrArg(st.id) + ')"' + (_crmState.seqBusy === st.id ? ' disabled' : '') + '>Approve</button>' : '')
            + '</span></div>'
            + _crmMsgHtml(st.channel, st.subject, st.template, '') + '</div></li>';
    }
    /* A message as the lead sees it: an email card (from, subject, body) or
       a text bubble. */
    function _crmMsgHtml(channel, subject, text, from) {
        if (channel === 'sms') return '<div class="crm-bubble">' + _calEsc(text || '') + '</div>';
        return '<div class="crm-mail">' + (from ? '<p class="crm-mail-from">From ' + _calEsc(from) + '</p>' : '')
            + (subject ? '<p class="crm-mail-subject">' + _calEsc(subject) + '</p>' : '')
            + '<p class="crm-mail-body">' + _calEsc(text || '') + '</p></div>';
    }
    function _crmStepWhenHtml(st) { return '<div class="crm-step-when"><span class="crm-step-day">' + _calEsc(_crmStepDay(st)) + '</span><span class="crm-step-hour">' + _calEsc(_crmStepHour(st)) + '</span></div>'; }
    function _crmSeqFacts(items) {
        return '<div class="crm-seq-facts">' + items.filter(x => x && x[0] !== '' && x[0] != null).map(x => '<div><span class="crm-fact-num">' + _calEsc(String(x[0])) + '</span><span class="crm-fact-label">' + _calEsc(x[1]) + '</span></div>').join('') + '</div>';
    }
    /* The sequence chosen in the side menu, on its own screen. */
    function _crmPaintSequences() {
        const el = document.getElementById('crmSeqs');
        _crmPaintRefresh();
        if (!el) return;
        if (!_crmState.seqs && _crmLoadingOr(el, true, _crmState.seqError, '_crmLoadSequences(false)', 'sequences')) return;
        const key = _crmState.seqKey || '';
        if (key.startsWith('n8n:')) {
            const s = (_crmState.n8n || []).find(x => 'n8n:' + x.key === key);
            if (s) { el.innerHTML = _crmN8nSeqHtml(s); return; }
        }
        let s = key.startsWith('own:') ? _crmSeqById(key.slice(4)) : null;
        if (!s) {
            const first = (_crmState.n8n || [])[0];
            if (first) { _crmState.seqKey = 'n8n:' + first.key; _crmPaintSide(); el.innerHTML = _crmN8nSeqHtml(first); return; }
            s = (_crmState.seqs || [])[0];
            if (!s) { el.innerHTML = '<div class="crm-empty"><p>No sequences yet.</p></div>'; return; }
            _crmState.seqKey = 'own:' + s.id; _crmPaintSide();
        }
        const admin = _crmIsAdmin();
        const approved = s.steps.filter(st => st.approval_state === 'approved').length;
        const n = s.steps.length;
        const days = s.steps.reduce((m, st) => Math.max(m, Number(st.day_offset) || 0), 0);
        el.innerHTML = '<article class="crm-seq" data-crm-seq="' + _calEscAttr(s.key) + '">'
            + '<header class="crm-view-head crm-seq-head"><div><h2' + (s.description ? ' title="' + _calEscAttr(s.description) + '"' : '') + '>' + _calEsc(s.name) + '</h2></div>'
            + '<button type="button" class="crm-switch" role="switch" aria-checked="' + (!!s.active) + '" aria-label="' + _calEscAttr(s.name + ' on or off') + '" onclick="_crmToggleSequence(' + _jsAttrArg(s.id) + ')"' + (_crmState.seqBusy === s.id ? ' disabled' : '') + '><span class="crm-switch-label">' + (s.active ? 'Sending' : 'Off') + '</span><span class="crm-switch-track" aria-hidden="true"><span class="crm-switch-knob"></span></span></button></header>'
            + _crmSeqFacts([[s.people_now || '', 'in it now'], [n, n === 1 ? 'message' : 'messages'], [days ? days : '', days === 1 ? 'day' : 'days'], [n && approved < n ? (n - approved) : '', 'waiting for approval']])
            + (n ? '<ol class="crm-steps">' + s.steps.map(st => _crmStepHtml(st, admin)).join('') + '</ol>' : '<p class="crm-none">No messages yet.</p>') + '</article>';
        _crmStepCount();
    }
    /* An n8n automation: read-only, with the exact wording it sends. */
    function _crmN8nSeqHtml(s) {
        const msgs = Array.isArray(s.messages) ? s.messages : [];
        const live = msgs.filter(m => m.live !== false).length;
        return '<article class="crm-seq is-n8n" data-crm-seq="' + _calEscAttr(s.key) + '">'
            + '<header class="crm-view-head crm-seq-head"><h2' + (s.description ? ' title="' + _calEscAttr(s.description) + '"' : '') + '>' + _calEsc(s.name) + '</h2>' + _crmLiveDot(!!s.active, 'n8n') + '</header>'
            + (s.stops_when ? '<p class="crm-seq-stop"><span>Stops when</span> ' + _calEsc(s.stops_when) + '</p>' : '')
            + '<ol class="crm-steps">' + msgs.map(m => '<li class="crm-step' + (m.live === false ? ' is-off' : '') + '"><div class="crm-step-when"><span class="crm-step-day">' + _calEsc(m.label || (m.channel === 'sms' ? 'Text' : 'Email')) + '</span><span class="crm-step-hour">' + _calEsc(m.when || '') + '</span></div>'
                + '<div class="crm-step-main">' + _crmMsgHtml(m.channel, m.subject, m.text, m.sender) + '</div></li>').join('') + '</ol>'
            + '</article>';
    }
    function _crmStepCount() {
        const box = document.getElementById('crmStepText');
        const out = document.getElementById('crmStepCount');
        if (!box || !out) return;
        const st = (_crmState.seqs || []).flatMap(s => s.steps).find(x => x.id === _crmState.editStep);
        out.textContent = st && st.channel === 'sms' ? box.value.length + ' of 300 characters.' : '';
        if (st) _crmState.stepDrafts[st.id] = { template: box.value, subject: (document.getElementById('crmStepSubject') || {}).value || '' };
    }
    function _crmEditStep(id) {
        if (_crmState.editStep && _crmState.editStep !== id) _crmCloseStepEditor(true);
        _crmState.editStep = id;
        _crmPaintSequences();
        const box = document.getElementById('crmStepText');
        if (box) box.focus({ preventScroll: true });
        _crmStepLayer = svLayerOpen({ key: 'crm-step-edit', region: '#crmStepEditor', isOpen: () => !!document.getElementById('crmStepEditor'), close: () => _crmCloseStepEditor(true, true) });
    }
    /* Closing keeps what was typed (stepDrafts) until it is saved or the
       person signs out; Cancel throws the draft away. */
    function _crmCloseStepEditor(keep, fromLayer) {
        const id = _crmState.editStep;
        if (!id) return true;
        if (keep === true) _crmStepCount(); else delete _crmState.stepDrafts[id];
        _crmState.editStep = '';
        if (_crmStepLayer && !fromLayer) svLayerRelease(_crmStepLayer, { focus: false });
        _crmStepLayer = null;
        _crmPaintSequences();
        const btn = document.querySelector('[data-crm-step="' + CSS.escape(id) + '"] .crm-step-actions .crm-btn');
        if (btn && (fromLayer || keep !== true)) btn.focus({ preventScroll: true });
        return true;
    }
    function _crmReplaceStep(step) {
        (_crmState.seqs || []).forEach(s => {
            const i = s.steps.findIndex(x => x.step_key === step.step_key && x.sequence_id === step.sequence_id);
            if (i >= 0 && s.id === step.sequence_id) s.steps[i] = step;
        });
    }
    async function _crmSaveStep() {
        const id = _crmState.editStep;
        const st = (_crmState.seqs || []).flatMap(s => s.steps).find(x => x.id === id);
        if (!st || _crmState.seqBusy) return;
        _crmStepCount();
        const dr = _crmState.stepDrafts[id] || {};
        const fields = { template: String(dr.template || '').trim() };
        if (st.channel === 'email') fields.subject = String(dr.subject || '').trim();
        _crmState.seqBusy = id;
        try {
            const d = await _crmCall('step_edit', { step_id: id, fields });
            delete _crmState.stepDrafts[id];
            _crmReplaceStep(d.step);
            _crmState.seqBusy = '';
            _crmCloseStepEditor(false);
            showToast('Saved as a draft. It needs approving before it can be sent.');
        } catch (e) {
            _crmState.seqBusy = '';
            _writeUiRecordFailure('leads', 'update', e, { id: String(id) });
            const why = { text_too_long: 'Texts can be 300 characters at most.', unknown_placeholder: 'One of the {placeholders} is not one we know. Check the spelling.', template_required: 'The message is empty.', bad_subject: 'The email needs a subject.' }[e.code];
            if (e.status === 409 && e.current) { _crmReplaceStep(e.current); showToast('Someone edited this step first. Their version is showing; your text is kept in the box.'); _crmState.editStep = e.current.id; _crmState.stepDrafts[e.current.id] = dr; _crmPaintSequences(); }
            else showToast('Not saved. ' + (why || _crmErrorText(e)));
        }
    }
    async function _crmApproveStep(id) {
        if (_crmState.seqBusy) return;
        _crmState.seqBusy = id; _crmPaintSequences();
        try {
            const d = await _crmCall('step_approve', { step_id: id });
            _crmReplaceStep(d.step);
            showToast('Approved');
        } catch (e) {
            _writeUiRecordFailure('leads', 'status', e, { id: String(id) });
            showToast(e.status === 403 ? 'Only an admin can approve a step.' : e.status === 409 ? 'This step changed since you opened it. Read the new version first.' : 'Not approved. ' + _crmErrorText(e));
            if (e.status === 409) _crmLoadSequences(true);
        } finally {
            _crmState.seqBusy = ''; _crmPaintSequences();
        }
    }
    async function _crmToggleSequence(id) {
        const s = _crmSeqById(id);
        if (!s || _crmState.seqBusy) return;
        const next = !s.active;
        _crmState.seqBusy = id; _crmPaintSequences();
        try {
            const d = await _crmCall('sequence_toggle', { sequence_id: id, active: next });
            s.active = !!d.sequence.active;
            const approved = s.steps.filter(st => st.approval_state === 'approved').length;
            showToast(s.active ? (approved ? s.name + ' is on. Approved steps can go out once sending is set up.' : s.name + ' is on, but no step is approved yet, so nothing can go out.') : s.name + ' is off. Nothing from it will be sent.');
        } catch (e) {
            _writeUiRecordFailure('leads', 'status', e, { id: String(id) });
            showToast('Not changed. ' + _crmErrorText(e));
        } finally {
            _crmState.seqBusy = ''; _crmPaintSequences();
            const sw = document.querySelector('[data-crm-seq="' + CSS.escape(s.key) + '"] .crm-switch'); if (sw) sw.focus({ preventScroll: true });
        }
    }

    // ── Person panel: sequences ──────────────────────────────────────────
    function _crmNextStepKey(en) {
        const s = _crmSeqById(en.sequence_id);
        const p = _crmState.person || {};
        if (!s) return '';
        const done = new Set([...(en.sent_step_keys || []), ...(en.skipped_step_keys || [])]);
        const fits = st => st.audience === 'all' || (st.audience === 'lost_price' && p.lost_reason === 'price') || (st.audience === 'lost_trust' && p.lost_reason === 'trust') || (st.audience === 'lost_other' && p.lost_reason !== 'price' && p.lost_reason !== 'trust');
        const next = s.steps.filter(st => fits(st) && !done.has(st.step_key)).sort((a, b) => a.position - b.position)[0];
        return next ? next.step_key : '';
    }
    function _crmPanelSeqHtml() {
        const ens = _crmState.enrolments || [];
        const active = ens.filter(e => e.status === 'active');
        const rows = active.map(en => {
            const s = _crmSeqById(en.sequence_id);
            const next = _crmNextStepKey(en);
            return '<li class="crm-row crm-enrol"><div class="crm-row-main is-static"><span class="crm-row-name">' + _calEsc(s ? s.name : 'Sequence') + '</span><span class="crm-row-meta">' + (en.paused ? 'Paused' : 'Running') + ', ' + (en.sent_step_keys || []).length + ' sent</span></div>'
                + '<span class="crm-row-actions">'
                + '<button type="button" class="crm-btn" onclick="_crmEnrolmentOp(' + _jsAttrArg(en.id) + ',' + _jsAttrArg(en.paused ? 'resume' : 'pause') + ')">' + (en.paused ? 'Resume' : 'Pause') + '</button>'
                + (next ? '<button type="button" class="crm-btn" onclick="_crmEnrolmentOp(' + _jsAttrArg(en.id) + ',\'skip\',' + _jsAttrArg(next) + ')">Skip next</button>' : '')
                + '<button type="button" class="crm-btn" onclick="_crmEnrolmentOp(' + _jsAttrArg(en.id) + ',\'stop\')">Stop</button></span></li>';
        }).join('');
        const inIds = new Set(active.map(e => e.sequence_id));
        const options = (_crmState.seqs || []).filter(s => !inIds.has(s.id)).map(s => ({ value: s.id, label: s.name }));
        const add = options.length ? '<div class="crm-enrol-add">' + _svSelectHtml('crmPEnrolSeq', [{ value: '', label: 'Choose a sequence' }].concat(options), '', 'Choose a sequence') + '<button type="button" class="crm-btn crm-btn-soft" onclick="_crmEnrol()">Add</button></div>' : '';
        return '<h3 class="crm-section-title">Automations</h3>' + (rows ? '<ul class="crm-rows crm-enrols">' + rows + '</ul>' : '<p class="crm-muted crm-gap">Not in an automation.</p>') + add;
    }
    async function _crmEnrol() {
        const p = _crmState.person;
        const n = document.getElementById('crmPEnrolSeq');
        const seq = n ? n.value : '';
        if (!p || !seq) { showToast('Choose a sequence first.'); return; }
        try {
            await _crmCall('enrol', { person_id: p.id, sequence_id: seq });
            showToast('Added to ' + ((_crmSeqById(seq) || {}).name || 'the sequence') + '.');
        } catch (e) {
            _writeUiRecordFailure('leads', 'update', e, { id: String(p.id) });
            showToast(e.status === 409 ? 'They are already in that sequence.' : 'Not added. ' + _crmErrorText(e));
        }
        _crmRefreshTimeline(p.id);
    }
    async function _crmEnrolmentOp(enrolmentId, op, stepKey) {
        const p = _crmState.person;
        if (!p) return;
        try {
            await _crmCall('enrolment', { enrolment_id: enrolmentId, op, step_key: stepKey || undefined });
            showToast({ pause: 'Paused', resume: 'Resumed', skip: 'Skipped the next step', stop: 'Stopped' }[op] || 'Done');
        } catch (e) {
            _writeUiRecordFailure('leads', 'update', e, { id: String(p.id) });
            showToast(e.status === 409 ? 'That sequence has already finished or stopped.' : 'Not changed. ' + _crmErrorText(e));
        }
        _crmRefreshTimeline(p.id);
    }

    // ── Staff identity changes ───────────────────────────────────────────
    /* Called by _syncviewStaffPurgeSensitiveState (100) on sign-out or a
       change of staff member: drop everything this page holds about people,
       and make every read still in flight land nowhere. */
    function _crmPurgeSensitiveState() {
        _crmState.gen++;
        if (_crmState.openId) { _crmState.openId = ''; _crmState.person = null; _crmPaintPanel(); if (_crmPanelLayer) { try { svLayerRelease(_crmPanelLayer, { focus: false }); } catch (e) {} _crmPanelLayer = null; } }
        if (_crmStepLayer) { try { svLayerRelease(_crmStepLayer, { focus: false }); } catch (e) {} _crmStepLayer = null; }
        Object.assign(_crmState, {
            loading: false, loaded: false, error: '', people: [], sources: [], truncated: false, events: [], source: null,
            personLoading: false, personError: '', saving: false, dragId: '', drafts: {}, enrolments: [], editing: false,
            today: null, todayLoading: false, todayError: '', seqs: null, seqLoading: false, seqError: '', editStep: '', stepDrafts: {}, seqBusy: '',
            n8n: [], marking: ''
        });
        _crmState.filters = { lead_type: '', niche: '', owner: '', source_id: '', due_this_week: false };
        const host = document.getElementById('crmPage');
        if (host) host.innerHTML = '';
    }
    /* Called by _syncviewStaffRefreshChrome (100): re-render a mounted page
       for whoever is signed in now (the gate for a non-admin). */
    function _crmOnIdentity() {
        const host = document.getElementById('crmPage');
        if (!host || !host.isConnected) return;
        const allowed = _crmCanUse();
        const showingGate = !!host.querySelector('.crm-gate');
        if (!allowed && !showingGate) { _crmPurgeSensitiveState(); _crmRenderPage(host); }
        else if (allowed && (showingGate || !host.firstChild)) _crmRenderPage(host);
    }
    window._crmPurgeSensitiveState = _crmPurgeSensitiveState;
    window._crmOnIdentity = _crmOnIdentity;
    // Retry buttons name these through _crmLoadingOr's string argument.
    Object.assign(window, { _crmLoadToday, _crmLoadSequences });

    /* Calm, like the Workload "wl-calm" pages: one soft surface per section
       (never nested), 1px hairlines, flat rows with a hover fill, borderless
       buttons except one primary per view, colour only for overdue (red) and
       due soon (amber). */
    function _crmInjectStyles() {
        if (document.getElementById('crmStyles')) return;
        const style = document.createElement('style');
        style.id = 'crmStyles';
        style.textContent = ''
            + '.crm-page{--crm-hair:var(--border-light);--crm-red:var(--wl-overdue-label);--crm-amber:var(--wl-tweaks-label);max-width:1280px;margin:0 auto;padding:4px 0 48px;color:var(--text-primary);min-width:0}'
            + '.crm-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px}.crm-head-text{min-width:0}'
            + '.crm-head h1,.crm-gate h1{margin:0;font-size:1.05rem;font-weight:700;letter-spacing:-0.01em;color:var(--text-primary)}'
            + '.crm-sub{margin:3px 0 0;color:var(--text-muted);font-size:0.74rem}'
            + '.crm-head-actions{display:flex;align-items:center;gap:2px;flex-shrink:0}'
            + '.crm-gate{max-width:440px;margin:60px auto;text-align:center}.crm-gate p{color:var(--text-secondary);font-size:0.8rem;line-height:1.5}'
            /* Buttons: transparent, no border; one primary per view. */
            + '.crm-btn,.crm-icon-btn,.crm-view-btn,.crm-toggle{min-height:36px;border:0;border-radius:8px;padding:6px 10px;background:transparent;color:var(--text-secondary);font:inherit;font-size:0.74rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px}'
            + '.crm-btn:hover,.crm-icon-btn:hover,.crm-view-btn:hover,.crm-view-btn[aria-expanded="true"],.crm-toggle:hover{background:var(--surface-hover);color:var(--text-primary)}'
            + '.crm-btn:disabled{color:var(--disabled-fg);cursor:wait;background:transparent}'
            + '.crm-btn:focus-visible,.crm-icon-btn:focus-visible,.crm-view-btn:focus-visible,.crm-toggle:focus-visible,.crm-tab:focus-visible,.crm-lead:focus-visible,.crm-x:focus-visible,.crm-row-main:focus-visible,.crm-switch:focus-visible{outline:2px solid var(--focus-ring);outline-offset:1px}'
            + '.crm-btn-primary{background:var(--toast-bg);color:var(--toast-color)}.crm-btn-primary:hover{background:var(--toast-bg);color:var(--toast-color);opacity:.88}.crm-btn-soft{background:var(--surface-subtle);color:var(--text-primary)}.crm-btn-ok{background:var(--surface-subtle);color:var(--brief-music-ink)}'
            + '.crm-btn-primary:disabled{background:var(--surface-subtle);color:var(--disabled-fg)}'
            + '.crm-icon-btn{width:34px;height:34px;padding:0}.crm-icon-btn svg,.crm-view-btn svg{width:15px;height:15px;flex-shrink:0}'
            + '.crm-icon-btn.is-busy svg{animation:crm-spin var(--sv-spin-dur) linear infinite}@keyframes crm-spin{to{transform:rotate(360deg)}}'
            /* View menu (the four filters and the due toggle). */
            + '.crm-view{position:relative;display:inline-flex}.crm-view[hidden]{display:none}'
