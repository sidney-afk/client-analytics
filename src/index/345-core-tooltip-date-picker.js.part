            const el = ensureTipEl();
            el.textContent = text;
            el.dataset.labelExplainer = target.hasAttribute('data-sv-explain') ? 'true' : 'false';
            document.body.appendChild(el);
            if (target.hasAttribute('data-sv-explain')) {
                savedDescribedBy = target.getAttribute('aria-describedby');
                const ids = String(savedDescribedBy || '').split(/\s+/).filter(Boolean);
                if (!ids.includes(TIP_ID)) ids.push(TIP_ID);
