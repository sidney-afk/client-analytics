            dpDisconnectObserver.observe(document.body, { childList: true, subtree: true });
        }

        function onPopupClick(e) {
            const t = e.target.closest('[data-dp-day], [data-dp-nav], [data-dp-act]');
            if (!t) return;
            if (t.hasAttribute('data-dp-day')) {
