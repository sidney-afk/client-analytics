        }, true);

        // Keyboard and touch users receive the same supplemental explanation
        // when a focusable help trigger gains focus. Essential validation copy
        // remains visible in the form; these tips only remove repetitive noise.
        document.addEventListener('focusin', function (e) {
            const bearer = findBearer(e.target);
            if (bearer) show(bearer);
        }, true);
        document.addEventListener('focusout', function (e) {
            if (!activeTarget) return;
            const next = e.relatedTarget;
            if (next && activeTarget.contains(next)) return;
            hide();
        }, true);

        // Explainable labels opt into touch pinning. The pointer-down snapshot
        // lets a second tap toggle the current explanation without making the
        // first tap disappear after focusin. Preventing the label's default
        // click keeps a help tap from opening or changing its form control.
        document.addEventListener('pointerdown', function (e) {
            const bearer = findBearer(e.target);
            lastPointerType = String(e.pointerType || (isNoHoverDevice() ? 'touch' : 'mouse'));
            if (lastPointerType === 'touch' && bearer && bearer.hasAttribute('data-sv-explain')) {
                touchTapStartedActive = bearer === touchPinnedTarget
                    && bearer === activeTarget && !!(tipEl && tipEl.parentNode);
                if (bearer !== activeTarget) hide();
                return;
            }
            touchTapStartedActive = false;
            hide();
        }, true);
        document.addEventListener('click', function (e) {
            const touchClick = lastPointerType === 'touch'
                || (!lastPointerType && isNoHoverDevice());
            lastPointerType = '';
            if (!touchClick) return;
            const bearer = findBearer(e.target);
            if (!bearer || !bearer.hasAttribute('data-sv-explain')) return;
            e.preventDefault();
            if (touchTapStartedActive) {
                touchTapStartedActive = false;
                hide();
                return;
            }
            touchTapStartedActive = false;
            if (document.activeElement !== bearer) {
                try { bearer.focus({ preventScroll: true }); } catch (_) { bearer.focus(); }
            }
            if (bearer !== activeTarget) show(bearer);
            else if (tipEl && tipEl.parentNode) position(tipEl, bearer);
            touchPinnedTarget = bearer;
        }, true);

        function viewportChange() {
            // Focusing an off-screen help control can itself scroll the page.
            // Keep keyboard help attached to its focused trigger; ordinary
            // hover tips still dismiss as soon as their viewport moves.
            const focusInside = activeTarget && (document.activeElement === activeTarget
                || activeTarget.contains(document.activeElement));
            if (focusInside && tipEl && tipEl.parentNode) position(tipEl, activeTarget);
            else hide();
        }

        // Any click / keyboard escape should drop the tip immediately.
        // Viewport changes preserve only a keyboard-focused explanation.
        document.addEventListener('mousedown', function (e) {
            if (activeTarget && activeTarget.hasAttribute('data-sv-explain')
                && activeTarget.contains(e.target) && lastPointerType === 'touch') return;
