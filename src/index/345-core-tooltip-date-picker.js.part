import { wlWorkloadTodayISO } from './068-core-workload-dates.js';
import { _svSyncDateControl } from './100-onboarding-staff-controls.js';
    /* ──────────────────────────────────────────────────────────────────
       Global styled tooltip — replaces every browser-native title popup
       with the dark pill used for the Collaborative mode "i" icon.

       Why: native tooltips are ugly, inconsistent across OSes, can't be
       styled, and have a long mystery delay. The dark pill matches the
       rest of the app's design language and renders identically on
       every machine.

       How it works:
       - On mouseover the handler walks up from e.target until it finds
         an element with `title` or `data-tip` and isn't opted out.
       - It removes the `title` attribute while the custom tip is shown
         so the browser's native popup never appears alongside it (and
         restores the title on mouseout so screen readers and any
         future hover still see the same text).
       - Positions a single shared tip element (portaled to <body>) above
         the trigger, flips below when it would go off-screen, and the
         arrow tracks the trigger horizontally so a tip near the edge
         still points at the right element.

       Opt-out is intentional and easy:
       - Add `data-no-tip` to any element (or wrap an area in it).
       - Form fields (input / textarea / select / option), SVG <title>
         elements, and contenteditable areas are skipped automatically.
       - Elements with no title/data-tip content are skipped (so empty
         tooltips never paint a stub).

       Existing custom tooltips (e.g. .cal-kebab-info-tip on the Collab
       mode icon) keep working as-is — they don't use `title` so this
       handler never targets them. */
    (function setupGlobalTooltip() {
        'use strict';
        const SHOW_DELAY_MS = 0;   // instant — matches the snappy feel of the old editor tooltip
        const TIP_CLASS = 'global-tip';
        const TIP_ID = 'globalTooltip';
        let tipEl = null;
        let activeTarget = null;
        let savedTitle = null;
        let savedDescribedBy;
        let showTimer = 0;
        let touchTapStartedActive = false;
        let touchPinnedTarget = null;
        let lastPointerType = '';

        function ensureTipEl() {
            if (tipEl) return tipEl;
            tipEl = document.createElement('div');
            tipEl.id = TIP_ID;
            tipEl.className = TIP_CLASS;
            tipEl.setAttribute('role', 'tooltip');
            return tipEl;
        }

        function getTipText(el) {
            const t = (el.getAttribute('data-tip') || el.getAttribute('title') || '');
            return t.trim();
        }

        function isOptedOut(el) {
            if (!el || el.nodeType !== 1) return true;
            if (el.hasAttribute('data-no-tip')) return true;
            // .closest is the cheap way to check ancestors too. The wrap
            // around the Collab info icon (and any other custom tooltip
            // area) sets data-no-tip so the global handler doesn't
            // double up on its hover.
            if (el.closest && el.closest('[data-no-tip]')) return true;
            // Production preview owns its artifact-style tooltip layer through
            // data-prod-tip; the global title tooltip would double-paint there.
            if (el.closest && el.closest('.prod-view, .prod-layer, .prod-tip, .prod-toast, .prod-cmd-bd')) return true;
            const tag = el.tagName;
            // Form fields: title may be used for HTML5 validation messages
            // or accessibility hints — leave them alone.
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'OPTION') return true;
            // SVG <title> is a child node read by assistive tech, never
            // an interactive trigger.
            if (tag === 'TITLE') return true;
            if (el.isContentEditable) return true;
            return false;
        }

        function findBearer(start) {
            let el = start;
            while (el && el !== document.body) {
                if (el.nodeType === 1 && !isOptedOut(el) && getTipText(el)) return el;
                el = el.parentElement;
            }
            return null;
        }

        function isNoHoverDevice() {
            return Number(navigator.maxTouchPoints || 0) > 0
                && !!(window.matchMedia && window.matchMedia('(hover: none)').matches);
        }

        function position(el, target) {
            const rect = target.getBoundingClientRect();
            // Measure with current content but no positional constraints,
            // so we know the natural width/height before clamping.
            el.style.top = '0px';
            el.style.left = '0px';
            const tipRect = el.getBoundingClientRect();
            const margin = 8;
            const edge = 6;
            const vw = window.innerWidth;
            const vh = window.innerHeight;
            let top, placement;
            // Prefer above; fall back to below when the trigger sits
            // near the top of the viewport.
            if (rect.top - tipRect.height - margin >= edge) {
                top = rect.top - tipRect.height - margin;
                placement = 'above';
            } else {
                top = Math.min(vh - tipRect.height - edge, rect.bottom + margin);
                placement = 'below';
            }
            let left = rect.left + rect.width / 2 - tipRect.width / 2;
            left = Math.max(edge, Math.min(vw - tipRect.width - edge, left));
            el.style.top = top + 'px';
            el.style.left = left + 'px';
            el.dataset.placement = placement;
            // Arrow tracks the trigger's centre so a tip clamped to the
            // edge still points at the right element instead of floating
            // adrift.
            const arrowLeft = Math.max(10, Math.min(tipRect.width - 10, rect.left + rect.width / 2 - left));
            el.style.setProperty('--arrow-left', arrowLeft + 'px');
        }

        function show(target) {
            if (!target || target === activeTarget) return;
            hide();
            const text = getTipText(target);
            if (!text) return;
            activeTarget = target;
            // Suppress the browser's native popup by temporarily peeling
            // the title attribute off. Restored on hide so a11y / future
            // hovers keep their text.
