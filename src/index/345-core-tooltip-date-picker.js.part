    /* ──────────────────────────────────────────────────────────────────
       Modern date picker — replaces the OS-rendered native popup that
       <input type="date"> opens with a styled in-app calendar. One
       shared popover, portaled to <body>, opened when the user clicks
       a .cal-date-chip and dismissed on outside click / Esc. While open,
       scroll and resize events keep it anchored to its trigger.

       It treats the existing <input type="date"> purely as the storage
       sink + change-event source: the chip's click bubbles into the
       picker (clicks on the input itself are disabled via
       pointer-events:none in CSS), and selecting a date writes
       input.value + dispatches a change event so _calOnDateChange and
       the rest of the save plumbing run unchanged. Clearing the date
       sets input.value to '' and dispatches the same event.

       Read-only date chips (.cal-fld-date-wrap.is-readonly — the client
       view when Collaborative mode is off) skip the open path entirely,
       matching the readonly attribute that used to suppress the native
       popup. */
    (function setupDatePicker() {
        'use strict';
        let dpEl = null;
        let focusedISO = null;
        let minISO = null;
        let maxISO = null;
        let dpInput = null;        // hidden <input type="date"> driving the chip
        let dpTriggerEl = null;    // the .cal-date-chip we opened from
        let cursorISO = null;      // 'YYYY-MM-01' — the month currently in view
        let selectedISO = null;    // 'YYYY-MM-DD' or null
        let dpPositionFrame = 0;
        let dpDisconnectObserver = null;

        function pad(n) { return String(n).padStart(2, '0'); }
        function todayISO() {
            const policy = dpInput && String(dpInput.dataset && dpInput.dataset.svTodayPolicy || '');
            if (policy === 'workload' && typeof wlWorkloadTodayISO === 'function') {
                return wlWorkloadTodayISO();
            }
            const pinned = dpInput && String(dpInput.dataset && dpInput.dataset.svToday || '');
            if (/^\d{4}-\d{2}-\d{2}$/.test(pinned)) return pinned;
            const d = new Date();
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
        }
        function isoOf(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
        function dateOf(iso) {
            const match = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
            return match ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), 12) : null;
        }
        function inBounds(iso) { return !!iso && (!minISO || iso >= minISO) && (!maxISO || iso <= maxISO); }
        function clampISO(iso) {
            if (minISO && iso < minISO) return minISO;
            if (maxISO && iso > maxISO) return maxISO;
            return iso;
        }
        function shiftDay(iso, delta) {
            const d = dateOf(iso);
            if (!d) return iso;
            d.setDate(d.getDate() + delta);
            return isoOf(d);
        }
        function shiftFocusedMonth(iso, delta) {
            const d = dateOf(iso);
            if (!d) return iso;
            const day = d.getDate();
            const target = new Date(d.getFullYear(), d.getMonth() + delta, 1, 12);
            const last = new Date(target.getFullYear(), target.getMonth() + 1, 0, 12).getDate();
            target.setDate(Math.min(day, last));
            return isoOf(target);
        }
        function firstOfMonth(iso) { return iso.slice(0, 7) + '-01'; }
        function shiftMonth(iso, delta) {
            const [y, m] = iso.split('-').map(Number);
            const d = new Date(y, m - 1 + delta, 1);
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-01`;
        }

        function ensureEl() {
            if (dpEl) return dpEl;
            dpEl = document.createElement('div');
            dpEl.className = 'dp-popup';
            dpEl.id = 'svDatePickerPopup';
            dpEl.setAttribute('role', 'dialog');
            dpEl.setAttribute('aria-label', 'Pick a date');
            return dpEl;
        }

        function position() {
            if (!dpEl || !dpTriggerEl) return;
            // Reset, measure, then place.
            dpEl.style.top = '0px';
            dpEl.style.left = '0px';
            const t = dpTriggerEl.getBoundingClientRect();
            const r = dpEl.getBoundingClientRect();
            const viewport = window.visualViewport;
            const viewportLeft = viewport ? viewport.offsetLeft : 0;
            const viewportTop = viewport ? viewport.offsetTop : 0;
            const viewportWidth = viewport ? viewport.width : (document.documentElement.clientWidth || window.innerWidth);
            const viewportHeight = viewport ? viewport.height : (document.documentElement.clientHeight || window.innerHeight);
            const viewportRight = viewportLeft + viewportWidth;
            const viewportBottom = viewportTop + viewportHeight;
            const margin = 6, edge = 8;
            // Prefer below the chip; flip above when there isn't room.
            let top = t.bottom + margin;
            if (top + r.height > viewportBottom - edge) {
                top = Math.max(viewportTop + edge, t.top - r.height - margin);
            }
            let left = t.left;
            if (left + r.width > viewportRight - edge) left = viewportRight - r.width - edge;
            if (left < viewportLeft + edge) left = viewportLeft + edge;
            dpEl.style.top = top + 'px';
            dpEl.style.left = left + 'px';
        }

        function render(focusDay) {
            if (!dpEl) return;
            const [y, m] = cursorISO.split('-').map(Number);
            const monthLabel = new Date(y, m - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
            // First-day-of-month dow (Sunday=0); fill 6 weeks for stable height.
            const firstDow = new Date(y, m - 1, 1).getDay();
            const days = [];
            for (let i = 0; i < 42; i++) {
                const d = new Date(y, m - 1, 1 - firstDow + i);
                days.push(d);
            }
            const today = todayISO();
            const dows = ['S','M','T','W','T','F','S'];
            const cellHtml = days.map(function (d) {
                const dIso = isoOf(d);
                const isOut = d.getMonth() !== (m - 1);
                const isToday = dIso === today;
                const isSelected = dIso === selectedISO;
                const isDisabled = !inBounds(dIso);
                const cls = ['dp-day'];
                if (isOut) cls.push('is-out');
                if (isToday) cls.push('is-today');
                if (isSelected) cls.push('is-selected');
                return `<button type="button" class="${cls.join(' ')}" data-dp-day="${dIso}" aria-label="${d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}" aria-pressed="${isSelected ? 'true' : 'false'}"${isToday ? ' aria-current="date"' : ''} tabindex="${dIso === focusedISO ? '0' : '-1'}"${isDisabled ? ' disabled' : ''}>${d.getDate()}</button>`;
            }).join('');
            dpEl.innerHTML = `
                <div class="dp-head">
                    <div class="dp-head-label">${monthLabel}</div>
                    <div class="dp-head-nav">
                        <button type="button" class="dp-nav-btn" data-dp-nav="-1" aria-label="Previous month"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4l-4 4 4 4"/></svg></button>
                        <button type="button" class="dp-nav-btn" data-dp-nav="1" aria-label="Next month"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4l4 4-4 4"/></svg></button>
                    </div>
                </div>
                <div class="dp-grid" role="group" aria-label="${monthLabel}">
                    ${dows.map(function (d) { return `<div class="dp-dow" aria-hidden="true">${d}</div>`; }).join('')}
                    ${cellHtml}
                </div>
                <div class="dp-foot">
                    <button type="button" class="dp-foot-btn" data-dp-act="clear">Clear</button>
                    <button type="button" class="dp-foot-btn is-primary" data-dp-act="today"${inBounds(today) ? '' : ' disabled'}>Today</button>
                </div>`;
            // Reposition AFTER innerHTML in case content height changed
            // (the grid is always 6 rows so this is mostly a no-op).
            position();
            if (focusDay) {
                const day = dpEl.querySelector(`[data-dp-day="${focusedISO}"]`);
                if (day) {
                    try { day.focus({ preventScroll: true }); }
                    catch (_) { day.focus(); }
                }
            }
        }

        function commit(iso) {
            if (!dpInput) return;
            if (iso && !inBounds(iso)) return;
            dpInput.value = iso || '';
            dpInput.dispatchEvent(new Event('input', { bubbles: true }));
            // bubbles:true so any delegated change listeners still fire.
            dpInput.dispatchEvent(new Event('change', { bubbles: true }));
            if (typeof _svSyncDateControl === 'function' && dpInput.id) _svSyncDateControl(dpInput.id);
        }

        function close(returnFocus) {
            const trigger = dpTriggerEl;
            if (trigger && trigger.hasAttribute('aria-expanded')) trigger.setAttribute('aria-expanded', 'false');
            if (dpPositionFrame) cancelAnimationFrame(dpPositionFrame);
            dpPositionFrame = 0;
            if (dpDisconnectObserver) dpDisconnectObserver.disconnect();
            dpDisconnectObserver = null;
            if (dpEl && dpEl.parentNode) dpEl.parentNode.removeChild(dpEl);
            dpEl = null;
            dpInput = null;
            dpTriggerEl = null;
            cursorISO = null;
            selectedISO = null;
            focusedISO = null;
            minISO = null;
            maxISO = null;
            document.removeEventListener('mousedown', outsideMouse, true);
            document.removeEventListener('keydown', keyHandler);
            window.removeEventListener('scroll', viewportChange, true);
            window.removeEventListener('resize', viewportChange);
            if (window.visualViewport) {
                window.visualViewport.removeEventListener('scroll', viewportChange);
                window.visualViewport.removeEventListener('resize', viewportChange);
            }
            if (returnFocus && trigger && document.contains(trigger)) trigger.focus();
        }
        function viewportChange() {
            if (!dpEl || !dpTriggerEl || !document.contains(dpTriggerEl)) {
                close(false);
                return;
            }
            if (dpPositionFrame) cancelAnimationFrame(dpPositionFrame);
            dpPositionFrame = requestAnimationFrame(function () {
                dpPositionFrame = 0;
                if (!dpEl || !dpTriggerEl || !document.contains(dpTriggerEl)) close(false);
                else position();
            });
        }

        function open(chip) {
            const wrap = chip && chip.closest('.cal-fld-date-wrap, [data-sv-date-picker]');
            if (!wrap || wrap.classList.contains('is-readonly') || wrap.classList.contains('is-disabled') || chip.disabled) return;
            const input = wrap.querySelector('input[type="date"]');
            if (!input || input.disabled) return;
            close(false);   // any previous one
            dpInput = input;
            dpTriggerEl = chip;
            minISO = /^\d{4}-\d{2}-\d{2}$/.test(input.min || '') ? input.min : null;
            maxISO = /^\d{4}-\d{2}-\d{2}$/.test(input.max || '') ? input.max : null;
            const startIso = clampISO((input.value || '').slice(0, 10) || todayISO());
            selectedISO = (input.value || '').slice(0, 10) || null;
            focusedISO = startIso;
            cursorISO = firstOfMonth(startIso);
            ensureEl();
            if (chip.hasAttribute('aria-expanded')) chip.setAttribute('aria-expanded', 'true');
            document.body.appendChild(dpEl);
            render(true);
            // Clicks on the popover itself shouldn't bubble to the outside
            // handler — but plain delegation handles the inner buttons.
            dpEl.addEventListener('click', onPopupClick);
            document.addEventListener('mousedown', outsideMouse, true);
            document.addEventListener('keydown', keyHandler);
            // Keep the body-portaled popover attached during mobile/ancestor
            // scrolling, and close it if a rerender removes its trigger.
            window.addEventListener('scroll', viewportChange, true);
            window.addEventListener('resize', viewportChange);
            if (window.visualViewport) {
                window.visualViewport.addEventListener('scroll', viewportChange);
                window.visualViewport.addEventListener('resize', viewportChange);
            }
            dpDisconnectObserver = new MutationObserver(function () {
