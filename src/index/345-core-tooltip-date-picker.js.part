            // the DOM by a re-render, drop the stale tip silently.
            if (activeTarget && !document.contains(activeTarget)) hide();
            const bearer = findBearer(e.target);
            if (!bearer) return;
            if (bearer.hasAttribute('data-sv-explain') && isNoHoverDevice()) return;
            if (bearer === activeTarget) return;
