            const assetRow = _prodAssetEligibleRow(rows) || rows[0];
            const descField = _prodHasOwn(batch, 'description') ? 'description' : _prodHasOwn(batch, 'desc') ? 'desc' : '';
            const desc = descField ? (batch[descField] == null ? '' : batch[descField]) : '';
