                invalid: 'Invalid',
                checking: 'Checking',
                available: 'Available',
                expired: 'Expired',
                permission_denied: 'Permission denied',
                unavailable: 'Unavailable',
                /* Browser-side only: the gateway's vocabulary has no such
                   state. It is `unavailable` whose probe never completed,
