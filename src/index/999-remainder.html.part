                const endpoint = it.kind === 'comment' ? LINEAR_ADD_COMMENT_URL : LINEAR_SET_STATUS_URL;
                let delivered = false;
                try {
                    if (!_writeUiLegacyResumeOwnerCurrent(owner)) {
                        leaseRevoked = true;
