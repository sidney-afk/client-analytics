                        break itemLoop;
                    }
                    deliveryStarted = true;
                    const resp = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    let ok = resp && resp.ok;
                    try { const json = await resp.json(); if (json && json.ok === false) ok = false; } catch (e) {}
                    if (!ok) throw new Error('http ' + (resp && resp.status));
