                    ? _calUrgentButtonHtml(escPid, '_sxrSendKasperUrgentSlack', post, '', false, 'kasper')
                    : _calUrgentButtonHtml(escPid, '_sxrSendUrgentSlack', post));
            } else if (wantKind && urgentEl) {
