                            id: String(it.id || ''),
                            state: terminal.sourceOnly
                                ? 'source_only_superseded_pending'
                                : 'team_delivery_superseded_pending',
                            comment_id: String(terminal.tombstone.source_gate
                                && terminal.tombstone.source_gate.comment_id || ''),
                            item: terminal.tombstone
