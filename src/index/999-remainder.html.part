            let post;
            const idx = sxrState.posts.findIndex(p => p.id === realId);
            const prevSnapshot = idx >= 0 ? Object.assign({}, sxrState.posts[idx]) : null;
            const wasNewRow = idx < 0;
            if (idx < 0) {
