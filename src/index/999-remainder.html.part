            _prodState.selAnchor = '';
            _prodState.focusCard = '';
            _prodState.cardSel.clear();
            _prodState.cardAnchor = '';
            _prodSetQuery({ batch: id }, true);
            _prodRender();
            _prodScrollDetailToTop();
        }
