                return mo == null ? '' : _prodIsoFromParts(+m[3], mo + 1, +m[2]);
            }
            if (m = s.match(/^(\d{1,2})\s+([a-z]{3,})\.?(?:,\s*|\s+)(\d{4})$/)) {
