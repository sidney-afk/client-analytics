        if (isRoot && role === 'client' && msg.is_tweak) _sxrApplyAutoStatus(pid, 'client_added', comp);
        if (committedBatch) _writeUiMergeCommittedBatch(_sxrPendingEdits[pid], committedBatch);
        await _sxrWatchNoteSave(pid);
